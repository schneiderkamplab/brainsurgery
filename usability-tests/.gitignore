# Generated by setup.py (symlinks into the data root) and by the builders.
/inputs
/references
/out
/docpack
# Per-run sandboxes live at <agent>/<target>/<effort>/<test>-<cond>-<repeat>/. Keep the
# small study data (prompt, plan or script, REPORT.md, run.json, grade.json,
# env-freeze.txt); ignore checkpoints, environments and copied inputs.
/*/*/*/*/out/**/*.safetensors
/*/*/*/*/out/**/*.json
!/*/*/*/*/out/**/plan.yaml
/*/*/*/*/out/**/*.pt
/*/*/*/*/out/**/*.bin
/*/*/*/*/.venv/
/*/*/*/*/inputs
/*/*/*/*/docpack/
/*/*/*/*/transcript.jsonl
/*/*/*/*/claude-stderr.txt
