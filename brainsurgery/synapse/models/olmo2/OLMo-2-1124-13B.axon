{-# CHECKPOINTS "allenai/OLMo-2-1124-13B" #-}

{-# TASK "causal_lm" #-}

{-# MAIN "olmo2" #-}

import Activations (silu)

import Attention (attention, merge_heads, reshape_heads)

import Masking (Mask, causal_mask_for_input, mask_for_input, mask_length_for_input)

import Math (mul, sqrt)

import Positions (position_ids, rope_base_factors, rope_pair_base_factors)

import Cache

import Config

import NN

import Tensor

MODEL_DIM <- 5120

VOCAB_SIZE <- 100352

NUM_LAYERS <- 40

NUM_HEADS <- 40

KVH <- 40

MODEL_HEAD_DIM <- 128

FFN <- 13824

MAX_POSITIONS <- 4096

EPS <- 1e-06

THETA <- 500000.0

ROPE_SCALE <- 1.0

ATTN_SCALE = 1.0 / sqrt MODEL_HEAD_DIM

rms :: Path -> Tensor[B,S,D] -> Tensor[B,S,D]
rms@path x = NN.rmsnorm@path x eps=EPS

olmo2_block :: Tensor[B,S,D] -> Tensor[B,1,S,R] -> Tensor[B,1,S,R] -> Tensor[B,1,S,K] -> ?CacheLayer[B,KVH,P,MAX_POSITIONS,DH] -> (Tensor[B,S,D], ?CacheLayer[B,KVH,K,MAX_POSITIONS,DH])
olmo2_block x rope_sin rope_cos mask past_kv = do
  a, new_kv <- scope@self_attn do
    q <- NN.linear@q_proj x dim=(NUM_HEADS * MODEL_HEAD_DIM) |> rms@q_norm |> reshape_heads heads=NUM_HEADS
    k <- NN.linear@k_proj x dim=(KVH * MODEL_HEAD_DIM) |> rms@k_norm |> reshape_heads heads=KVH
    v <- NN.linear@v_proj x dim=(KVH * MODEL_HEAD_DIM) |> reshape_heads heads=KVH
    q, k <- rope_pair_base_factors q k rope_sin rope_cos
    k, v, new_kv <- Cache.update past_kv k v
    k <- Tensor.repeat k repeats=(NUM_HEADS / KVH)
    v <- Tensor.repeat v repeats=(NUM_HEADS / KVH)
    a <- attention q k v mask scale=ATTN_SCALE |> merge_heads |> NN.linear@o_proj dim=MODEL_DIM
    return a, new_kv
  a <- rms@post_attention_layernorm a
  x <- x + a
  m <- scope@mlp do
    g <- NN.linear@gate_proj x dim=FFN
    u <- NN.linear@up_proj x dim=FFN
    return g |> silu |> mul u |> NN.linear@down_proj dim=MODEL_DIM
  m <- rms@post_feedforward_layernorm m
  return x + m, new_kv

olmo2 :: TokenIds[B,S] -> ?Mask[B,K,MAX_POSITIONS] -> ?Cache[B,KVH,P,MAX_POSITIONS,DH] -> ?Bool -> (Tensor[B,S,V], ?Cache[B,KVH,K,MAX_POSITIONS,DH])
olmo2 input_ids attn_mask past_kv use_cache = do
  past_length <- Cache.past_length past_kv
  attn_mask <- mask_for_input input_ids attn_mask MAX_POSITIONS
  pos_ids <- position_ids input_ids attn_mask=attn_mask past_length=past_length
  rope_sin, rope_cos <- ((rope_base_factors pos_ids MODEL_HEAD_DIM THETA scale_factor=ROPE_SCALE) :: (Tensor[B,1,S,MODEL_HEAD_DIM], Tensor[B,1,S,MODEL_HEAD_DIM]))
  key_len <- mask_length_for_input input_ids attn_mask past_length
  mask <- causal_mask_for_input input_ids key_len padding_mask=attn_mask window=MAX_POSITIONS
  work_kv <- Cache.prepare past_kv use_cache MAX_POSITIONS
  read_kv <- Cache.read past_kv work_kv
  x, work_kv <- scope@model do
    x <- NN.embedding@embed_tokens input_ids dim=MODEL_DIM
    x, work_kv <- for@layers i <- [0..NUM_LAYERS) carry (x, work_kv) do
      past_i <- Cache.index read_kv i
      x, new_i <- olmo2_block x rope_sin rope_cos mask past_i
      work_kv <- Cache.append work_kv new_i
      yield x, work_kv
    x <- rms@norm x
    return x, work_kv
  logits <- NN.linear@lm_head x dim=VOCAB_SIZE
  new_length <- past_length + S
  new_kv <- Cache.finish work_kv new_length
  new_kv <- use_cache ? new_kv : null
  return logits, new_kv
