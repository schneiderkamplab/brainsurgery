{-# CHECKPOINTS "allenai/OLMo-2-0325-32B" #-}

{-# TASK "causal_lm" #-}

{-# MAIN "olmo2" #-}

import Activations (silu)

import Attention (attention, merge_heads, reshape_heads)

import Masking (causal_mask)

import Math (mul, sqrt)

import Positions (position_ids, rope_pair_base)

import Cache

import Config

import NN

import Tensor

MODEL_DIM = 5120

VOCAB_SIZE = 100352

NUM_LAYERS = 64

NUM_HEADS = 40

KVH = 8

MODEL_HEAD_DIM = 128

FFN = 27648

MAX_POSITIONS = 4096

EPS = 1e-06

THETA = 500000.0

ROPE_SCALE = 1.0

ATTN_SCALE = 1.0 / sqrt MODEL_HEAD_DIM

rms :: Path -> Tensor[B,S,D] -> Tensor[B,S,D]
rms@path x = NN.rmsnorm@path x eps=EPS

olmo2_block :: Tensor[B,S,D] -> IdxTensor[B,S] -> ?Tensor[B,K] -> ?CacheLayer[B,KVH,P,DH] -> (Tensor[B,S,D], ?CacheLayer[B,KVH,K,DH])
olmo2_block x pos_ids attn_mask past_kv = do
  a, new_kv <- scope@self_attn do
    q <- NN.linear@q_proj x dim=(NUM_HEADS * MODEL_HEAD_DIM) |> rms@q_norm |> reshape_heads heads=NUM_HEADS
    k <- NN.linear@k_proj x dim=(KVH * MODEL_HEAD_DIM) |> rms@k_norm |> reshape_heads heads=KVH
    v <- NN.linear@v_proj x dim=(KVH * MODEL_HEAD_DIM) |> reshape_heads heads=KVH
    q, k <- rope_pair_base q k pos_ids THETA scale_factor=ROPE_SCALE
    k, v, new_kv <- Cache.update past_kv k v
    k <- Tensor.repeat k repeats=(NUM_HEADS / KVH)
    v <- Tensor.repeat v repeats=(NUM_HEADS / KVH)
    mask <- causal_mask q k window=MAX_POSITIONS padding_mask=attn_mask
    a <- attention q k v mask scale=ATTN_SCALE |> merge_heads |> NN.linear@o_proj dim=MODEL_DIM
    return a, new_kv
  a <- rms@post_attention_layernorm a
  x <- x + a
  m <- scope@mlp do
    g <- NN.linear@gate_proj x dim=FFN
    u <- NN.linear@up_proj x dim=FFN
    return g |> silu |> mul u |> NN.linear@down_proj dim=MODEL_DIM
  m <- rms@post_feedforward_layernorm m
  return x + m, new_kv

olmo2 :: TokenIds[B,S] -> ?Tensor[B,K] -> ?Cache[B,KVH,P,DH] -> ?Bool -> (Tensor[B,S,V], ?Cache[B,KVH,K,DH])
olmo2 input_ids attn_mask past_kv use_cache = do
  pos_ids <- position_ids input_ids attn_mask=attn_mask past_length=(Cache.past_length past_kv)
  x, new_kv <- scope@model do
    x <- NN.embedding@embed_tokens input_ids dim=MODEL_DIM
    new_kv <- use_cache ? Cache.init : null
    x, new_kv <- for@layers i <- [0..NUM_LAYERS) carry (x, new_kv) do
      past_i <- Cache.index past_kv i
      x, new_i <- olmo2_block x pos_ids attn_mask past_i
      new_kv <- Cache.append new_kv new_i
      yield x, new_kv
    x <- rms@norm x
    return x, new_kv
  logits <- NN.linear@lm_head x dim=VOCAB_SIZE
  return logits, new_kv
