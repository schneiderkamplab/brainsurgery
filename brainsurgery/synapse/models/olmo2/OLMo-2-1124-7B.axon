{-# CHECKPOINTS ["allenai/OLMo-2-1124-7B", "allenai/Flex-public-7B-1T"] #-}
{-# TASK "causal_lm" #-}

import Activations
import Activations (silu)
import Attention
import Attention (attention, merge_heads, reshape_heads)
import Masking
import Masking (causal_mask)
import Math
import Math (mul)
import Positions
import Positions (position_ids, rope_pair_base)
import Cache
import NN
import Tensor

rms :: Path -> Tensor[B,S,D] -> Tensor[B,S,D]
rms@path x = NN.rmsnorm@path x eps=1e-06

olmo2_block :: Tensor -> IdxTensor -> ?Tensor -> ?CacheLayer -> (Tensor, ?CacheLayer)
olmo2_block x pos_ids attn_mask past_kv = do
  a, new_kv <- scope@self_attn do
    q <- NN.linear@q_proj x dim=4096 |> rms@q_norm |> reshape_heads heads=32
    k <- NN.linear@k_proj x dim=4096 |> rms@k_norm |> reshape_heads heads=32
    v <- NN.linear@v_proj x dim=4096 |> reshape_heads heads=32
    q, k <- rope_pair_base q k pos_ids 500000.0 scale_factor=1.0
    k, v, new_kv <- Cache.update past_kv k v
    k <- Tensor.repeat k repeats=1
    v <- Tensor.repeat v repeats=1
    mask <- causal_mask q k window=4096 padding_mask=attn_mask
    a <- attention q k v mask scale=0.08838834764831843 |> merge_heads |> NN.linear@o_proj dim=4096
    return a, new_kv
  a <- rms@post_attention_layernorm a
  x <- x + a
  m <- scope@mlp do
    g <- NN.linear@gate_proj x dim=11008
    u <- NN.linear@up_proj x dim=11008
    return g |> silu |> mul u |> NN.linear@down_proj dim=4096
  m <- rms@post_feedforward_layernorm m
  return x + m, new_kv

olmo2 :: TokenIds[B,S] -> ?Tensor[B,S] -> ?Cache -> ?Bool -> (Tensor[B,S,V], ?Cache)
olmo2 input_ids attn_mask past_kv use_cache = do
  pos_ids <- position_ids input_ids attn_mask=attn_mask past_length=(Cache.past_length past_kv)
  x, new_kv <- scope@model do
    x <- NN.embedding@embed_tokens input_ids dim=4096
    new_kv <- use_cache ? Cache.init : null
    for@layers i <- [0..32) do
      past_i <- Cache.index past_kv i
      x, new_i <- olmo2_block x pos_ids attn_mask past_i
      new_kv <- Cache.append new_kv new_i
      yield x, new_kv
    x <- rms@norm x
    return x, new_kv
  logits <- NN.linear@lm_head x dim=100352
  return logits, new_kv
