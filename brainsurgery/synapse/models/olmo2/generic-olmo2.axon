{-# CHECKPOINTS ["allenai/OLMo-2-0425-1B", "allenai/OLMo-2-1124-7B", "allenai/OLMo-2-1124-13B", "allenai/OLMo-2-0325-32B", "allenai/Flex-public-7B-1T"] #-}
{-# TASK "causal_lm" #-}

import Activations (silu)
import Attention (attention, merge_heads, reshape_heads)
import Masking (causal_mask)
import Math (mul, sqrt)
import Positions (position_ids, rope_pair_base)



D = Config.int "hidden_size" default=2048
V = Config.int "vocab_size" default=100352
L = Config.int "num_hidden_layers" default=16
H = Config.int "num_attention_heads" default=16
KVH = Config.int "num_key_value_heads" default=16
HD = Config.int "head_dim" default=128
FFN = Config.int "intermediate_size" default=8192
C = Config.int "max_position_embeddings" default=4096
EPS = Config.float "rms_norm_eps" default=1e-06
THETA = Config.float "rope_theta" default=500000.0
ROPE_SCALE = Config.float "rope_scaling.factor" default=1.0
ATTN_SCALE = 1.0 / sqrt HD

rms :: @Path -> Tensor[B,S,D] -> Tensor[B,S,D]
rms@path x = NN.rmsnorm@path x eps=EPS

olmo2_block :: Tensor -> IdxTensor -> ?Tensor -> ?CacheLayer -> (Tensor, ?CacheLayer)
olmo2_block x pos_ids attn_mask past_kv = do
  a, new_kv <- scope@self_attn do
    q <- NN.linear@q_proj x dim=(H * HD) |> rms@q_norm |> reshape_heads heads=H
    k <- NN.linear@k_proj x dim=(KVH * HD) |> rms@k_norm |> reshape_heads heads=KVH
    v <- NN.linear@v_proj x dim=(KVH * HD) |> reshape_heads heads=KVH
    q, k <- rope_pair_base q k pos_ids THETA scale_factor=ROPE_SCALE
    k, v, new_kv <- Cache.update past_kv k v
    k <- Tensor.repeat k repeats=(H / KVH)
    v <- Tensor.repeat v repeats=(H / KVH)
    mask <- causal_mask q k window=C padding_mask=attn_mask
    a <- attention q k v mask scale=ATTN_SCALE |> merge_heads |> NN.linear@o_proj dim=D
    return a, new_kv
  a <- rms@post_attention_layernorm a
  x <- x + a
  m <- scope@mlp do
    g <- NN.linear@gate_proj x dim=FFN
    u <- NN.linear@up_proj x dim=FFN
    return g |> silu |> mul u |> NN.linear@down_proj dim=D
  m <- rms@post_feedforward_layernorm m
  return x + m, new_kv

olmo2 :: TokenIds[B,S] -> ?Tensor[B,S] -> ?Cache -> ?Bool -> (Tensor[B,S,V], ?Cache)
olmo2 input_ids attn_mask past_kv use_cache = do
  pos_ids <- position_ids input_ids attn_mask=attn_mask past_length=(Cache.past_length past_kv)
  x, new_kv <- scope@model do
    x <- NN.embedding@embed_tokens input_ids dim=D
    new_kv <- use_cache ? Cache.init : null
    for@layers i <- [0..L) do
      past_i <- Cache.index past_kv i
      x, new_i <- olmo2_block x pos_ids attn_mask past_i
      new_kv <- Cache.append new_kv new_i
    x <- rms@norm x
    return x, new_kv
  logits <- NN.linear@lm_head x dim=V
  return logits, new_kv
