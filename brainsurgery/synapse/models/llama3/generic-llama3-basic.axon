{-# CHECKPOINTS ["meta-llama/Meta-Llama-3-8B", "meta-llama/Meta-Llama-3-8B-Instruct", "meta-llama/Meta-Llama-3-70B", "meta-llama/Meta-Llama-3-70B-Instruct", "meta-llama/Llama-3.1-8B", "meta-llama/Llama-3.1-8B-Instruct", "meta-llama/Llama-3.1-70B", "meta-llama/Llama-3.1-70B-Instruct", "meta-llama/Llama-3.2-1B", "meta-llama/Llama-3.2-1B-Instruct", "meta-llama/Llama-3.2-3B", "meta-llama/Llama-3.2-3B-Instruct", "meta-llama/Llama-3.3-70B-Instruct"] #-}
{-# TASK "causal_lm" #-}

import Activations (silu)
import Attention (attention, merge_heads, reshape_heads)
import Masking (Mask, causal_mask_for_input, mask_for_input, mask_length_for_input)
import Math (mul, sqrt)
import Params (has_root)
import Positions (position_ids, rope_freq_scale_factors, rope_pair_base_factors)
import Cache
import Config
import NN
import Tensor



MODEL_DIM <- ((Config.dim@@hidden_size default=2048) :: Dim)

VOCAB_SIZE <- ((Config.dim@@vocab_size default=128256) :: Dim)

NUM_LAYERS <- ((Config.dim@@num_hidden_layers default=16) :: Dim)

NUM_HEADS <- ((Config.dim@@num_attention_heads default=32) :: Dim)

KVH <- ((Config.dim@@num_key_value_heads default=8) :: Dim)

MODEL_HEAD_DIM <- (Config.has_value@@head_dim ? (Config.dim@@head_dim default=64) : (MODEL_DIM / NUM_HEADS) :: Dim)

KVD <- do
  return (KVH * MODEL_HEAD_DIM :: Dim)

FFN <- ((Config.dim@@intermediate_size default=8192) :: Dim)

EPS <- (Config.float@@rms_norm_eps default=1e-05)

THETA <- (Config.float@@rope_theta default=500000.0)

MAX_POSITIONS <- ((Config.dim@@max_position_embeddings default=131072) :: Dim)

ROPE_SCALE <- (Config.float @@'rope_scaling.factor' default=1.0)

ROPE_LOW_FREQ <- (Config.float @@'rope_scaling.low_freq_factor' default=1.0)

ROPE_HIGH_FREQ <- (Config.float @@'rope_scaling.high_freq_factor' default=4.0)

ROPE_CONTEXT <- ((Config.dim @@'rope_scaling.original_max_position_embeddings' default=8192) :: Dim)

HAS_LM_HEAD <- do
  return has_root "lm_head"

rms :: Path -> Tensor[B,S,D] -> Tensor[B,S,D]
rms@path x = NN.rmsnorm@path x eps=EPS

llama3_block :: Tensor[B,S,D] -> Tensor[B,1,S,R] -> Tensor[B,1,S,R] -> Tensor[B,1,S,K] -> ?CacheLayer[B,KVH,P,MAX_POSITIONS,DH] -> (Tensor[B,S,D], ?CacheLayer[B,KVH,K,MAX_POSITIONS,DH])
llama3_block x rope_sin rope_cos keep past_kv = do
  xn <- rms@input_layernorm x
  a, new_kv <- scope@self_attn do
    q <- NN.linear@q_proj xn dim=MODEL_DIM |> reshape_heads heads=NUM_HEADS
    k <- NN.linear@k_proj xn dim=KVD |> reshape_heads heads=KVH
    v <- NN.linear@v_proj xn dim=KVD |> reshape_heads heads=KVH
    q, k <- rope_pair_base_factors q k rope_sin rope_cos
    k, v, new_kv <- Cache.update past_kv k v
    k <- Tensor.repeat k repeats=(NUM_HEADS / KVH)
    v <- Tensor.repeat v repeats=(NUM_HEADS / KVH)
    a <- attention q k v keep scale=(1.0 / sqrt (MODEL_DIM / NUM_HEADS)) |> merge_heads |> NN.linear@o_proj dim=MODEL_DIM
    return a, new_kv
  x <- x + a
  xn <- rms@post_attention_layernorm x
  m <- scope@mlp do
    g <- NN.linear@gate_proj xn dim=FFN
    u <- NN.linear@up_proj xn dim=FFN
    return g |> silu |> mul u |> NN.linear@down_proj dim=MODEL_DIM
  return x + m, new_kv

llama3 :: TokenIds[B,S] -> ?Mask[B,K,MAX_POSITIONS] -> ?Cache[B,KVH,P,MAX_POSITIONS,DH] -> ?Bool -> (Tensor[B,S,V], ?Cache[B,KVH,K,MAX_POSITIONS,DH])
llama3 input_ids attn_mask past_kv use_cache = do
  past_length <- Cache.past_length past_kv
  attn_mask <- mask_for_input input_ids attn_mask MAX_POSITIONS
  pos_ids <- position_ids input_ids attn_mask=attn_mask past_length=past_length pad_fill=1
  rope_ref <- Tensor.zeros input_ids shape=[B, 1, S, MODEL_HEAD_DIM] dtype="float32"
  rope_sin, rope_cos <- rope_freq_scale_factors rope_ref pos_ids THETA ROPE_SCALE ROPE_LOW_FREQ ROPE_HIGH_FREQ ROPE_CONTEXT
  key_len <- mask_length_for_input input_ids attn_mask past_length
  keep <- causal_mask_for_input input_ids key_len padding_mask=attn_mask window=MAX_POSITIONS
  x <- NN.embedding@@model.embed_tokens input_ids dim=MODEL_DIM
  work_kv <- Cache.prepare past_kv use_cache MAX_POSITIONS
  read_kv <- Cache.read past_kv work_kv
  x, work_kv <- for@model.layers i <- [0..NUM_LAYERS) carry (x, work_kv) do
    past_i <- Cache.index read_kv i
    x, new_i <- llama3_block x rope_sin rope_cos keep past_i
    work_kv <- Cache.append work_kv new_i
    yield x, work_kv
  x <- rms@@model.norm x
  logits <- HAS_LM_HEAD ? (NN.linear@@lm_head x dim=VOCAB_SIZE weight_path=@@lm_head.weight) : (NN.linear@@model.embed_tokens x dim=VOCAB_SIZE)
  new_length <- past_length + S
  new_kv <- Cache.finish work_kv new_length
  new_kv <- use_cache ? new_kv : null
  return logits, new_kv
