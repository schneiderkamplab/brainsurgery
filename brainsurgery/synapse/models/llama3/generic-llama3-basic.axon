import Math
{-# CHECKPOINTS ["meta-llama/Meta-Llama-3-8B", "meta-llama/Meta-Llama-3-8B-Instruct", "meta-llama/Meta-Llama-3-70B", "meta-llama/Meta-Llama-3-70B-Instruct", "meta-llama/Llama-3.1-8B", "meta-llama/Llama-3.1-8B-Instruct", "meta-llama/Llama-3.1-70B", "meta-llama/Llama-3.1-70B-Instruct", "meta-llama/Llama-3.2-1B", "meta-llama/Llama-3.2-1B-Instruct", "meta-llama/Llama-3.2-3B", "meta-llama/Llama-3.2-3B-Instruct", "meta-llama/Llama-3.3-70B-Instruct"] #-}
{-# TASK "causal_lm" #-}

import Config
import Params
import Activations silu
import Cache past_length
import Cache
import Masking (
  causal_mask_basic,
)
import Positions (
  rope_pair_freq_scale_basic,
)
import Derived (
  attention_basic,
  merge_heads_basic,
)

D = Config.int "hidden_size" default=2048
V = Config.int "vocab_size" default=128256
L = Config.int "num_hidden_layers" default=16
H = Config.int "num_attention_heads" default=32
KVH = Config.int "num_key_value_heads" default=8
HD = Config.int "head_dim" default=64
KVD = KVH * HD
FFN = Config.int "intermediate_size" default=8192
EPS = Config.float "rms_norm_eps" default=1e-05
THETA = Config.float "rope_theta" default=500000.0
C = Config.int "max_position_embeddings" default=131072
ROPE_SCALE = Config.float "rope_scaling.factor" default=1.0
ROPE_LOW_FREQ = Config.float "rope_scaling.low_freq_factor" default=1.0
ROPE_HIGH_FREQ = Config.float "rope_scaling.high_freq_factor" default=4.0
ROPE_CONTEXT = Config.int "rope_scaling.original_max_position_embeddings" default=8192
HAS_LM_HEAD = Params.has_root "lm_head"

rms :: @Path -> Tensor[B,S,D] -> Tensor[B,S,D]
rms@path x = rmsnorm@path x eps=EPS

llama3_block :: Tensor[B,S,D] -> Tensor[B,S] -> ?Tensor[B,S] -> ?CacheLayer -> (Tensor[B,S,D], ?CacheLayer)
llama3_block x pos_ids attn_mask past_kv = do
  xn <- rms@input_layernorm x
  a, new_kv <- scope@self_attn do
    q <- linear@q_proj xn dim=D |> reshape_heads heads=H
    k <- linear@k_proj xn dim=KVD |> reshape_heads heads=KVH
    v <- linear@v_proj xn dim=KVD |> reshape_heads heads=KVH
    q, k <- rope_pair_freq_scale_basic q k pos_ids THETA ROPE_SCALE ROPE_LOW_FREQ ROPE_HIGH_FREQ ROPE_CONTEXT
    k, v, new_kv <- Cache.update past_kv k v
    k <- repeat k repeats=(H / KVH)
    v <- repeat v repeats=(H / KVH)
    keep <- causal_mask_basic q k attn_mask
    a <- attention_basic q k v keep scale=(1.0 / Math.sqrt (D / H)) |> merge_heads_basic |> linear@o_proj dim=D
    return a, new_kv
  x <- x + a
  xn <- rms@post_attention_layernorm x
  m <- scope@mlp do
    g <- linear@gate_proj xn dim=FFN
    u <- linear@up_proj xn dim=FFN
    return g |> silu |> Math.mul u |> linear@down_proj dim=D
  return x + m, new_kv

llama3 :: TokenIds[B,S] -> ?Tensor[B,S] -> ?Cache -> ?Bool -> (Tensor[B,S,V], ?Cache)
llama3 input_ids attn_mask past_kv use_cache = do
  pos_ids <- position_ids input_ids attn_mask=attn_mask past_length=(past_length past_kv) pad_fill=1
  logits, new_kv <- scope@model do
    x <- embedding@embed_tokens input_ids dim=D
    new_kv <- use_cache ? Cache.init : null
    for@layers i <- [0..L) do
      past_i <- Cache.index past_kv i
      x, new_i <- llama3_block x pos_ids attn_mask past_i
      new_kv <- Cache.append new_kv new_i
    x <- rms@norm x
    logits <- HAS_LM_HEAD ? (linear@lm_head x dim=V weight_path=@@lm_head.weight) : (linear@embed_tokens x dim=V)
    return logits, new_kv
  return logits, new_kv
