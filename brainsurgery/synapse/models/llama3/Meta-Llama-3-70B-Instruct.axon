{-# CHECKPOINTS "meta-llama/Meta-Llama-3-70B-Instruct" #-}
{-# TASK "causal_lm" #-}

import Activations (silu)
import Attention (attention, merge_heads, reshape_heads)
import Masking (causal_mask)
import Math (mul)
import Positions (position_ids, rope_pair_freq_scale)



D = 8192
V = 128256
L = 80
H = 64
KVH = 8
KVD = 512
FFN = 28672
EPS = 1e-05
THETA = 500000.0
C = 8192
ROPE_SCALE = 1.0
ROPE_LOW_FREQ = 1.0
ROPE_HIGH_FREQ = 4.0
ROPE_CONTEXT = 8192
HAS_LM_HEAD = true

rms :: @Path -> Tensor[B,S,D] -> Tensor[B,S,D]
rms@path x = NN.rmsnorm@path x eps=EPS

llama3_block :: Tensor[B,S,D] -> Tensor[B,S] -> ?Tensor[B,S] -> ?CacheLayer -> (Tensor[B,S,D], ?CacheLayer)
llama3_block x pos_ids attn_mask past_kv = do
  xn <- rms@input_layernorm x
  a, new_kv <- scope@self_attn do
    q <- NN.linear@q_proj xn dim=D |> reshape_heads heads=H
    k <- NN.linear@k_proj xn dim=KVD |> reshape_heads heads=KVH
    v <- NN.linear@v_proj xn dim=KVD |> reshape_heads heads=KVH
    q, k <- rope_pair_freq_scale q k pos_ids THETA ROPE_SCALE ROPE_LOW_FREQ ROPE_HIGH_FREQ ROPE_CONTEXT
    k, v, new_kv <- Cache.update past_kv k v
    k <- Tensor.repeat k repeats=(H / KVH)
    v <- Tensor.repeat v repeats=(H / KVH)
    mask <- causal_mask q k window=C padding_mask=attn_mask
    a <- attention q k v mask |> merge_heads |> NN.linear@o_proj dim=D
    return a, new_kv
  x <- x + a
  xn <- rms@post_attention_layernorm x
  m <- scope@mlp do
    g <- NN.linear@gate_proj xn dim=FFN
    u <- NN.linear@up_proj xn dim=FFN
    return g |> silu |> mul u |> NN.linear@down_proj dim=D
  return x + m, new_kv

llama3 :: TokenIds[B,S] -> ?Tensor[B,S] -> ?Cache -> ?Bool -> (Tensor[B,S,V], ?Cache)
llama3 input_ids attn_mask past_kv use_cache = do
  pos_ids <- position_ids input_ids attn_mask=attn_mask past_length=(Cache.past_length past_kv)
  logits, new_kv <- scope@model do
    x <- NN.embedding@embed_tokens input_ids dim=D
    new_kv <- use_cache ? Cache.init : null
    for@layers i <- [0..L) do
      past_i <- Cache.index past_kv i
      x, new_i <- llama3_block x pos_ids attn_mask past_i
      new_kv <- Cache.append new_kv new_i
    x <- rms@norm x
    logits <- HAS_LM_HEAD ? (NN.linear@lm_head x dim=V weight_path=@@lm_head.weight) : (NN.linear@embed_tokens x dim=V)
    return logits, new_kv
  return logits, new_kv
