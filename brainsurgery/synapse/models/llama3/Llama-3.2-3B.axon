{-# CHECKPOINTS ["meta-llama/Llama-3.2-3B", "meta-llama/Llama-3.2-3B-Instruct"] #-}

{-# TASK "causal_lm" #-}

{-# MAIN "llama3" #-}

import Activations (silu)

import Attention (attention, merge_heads, reshape_heads)

import Masking (causal_mask)

import Math (mul, sqrt)

import Params (has_root)

import Positions (position_ids, rope_pair_freq_scale)

import Cache

import Config

import NN

import Tensor

MODEL_DIM = 3072

VOCAB_SIZE = 128256

NUM_LAYERS = 28

NUM_HEADS = 24

KVH = 8

MODEL_HEAD_DIM = 128

KVD = KVH * MODEL_HEAD_DIM

FFN = 8192

EPS = 1e-05

THETA = 500000.0

MAX_POSITIONS = 131072

ROPE_SCALE = 32.0

ROPE_LOW_FREQ = 1.0

ROPE_HIGH_FREQ = 4.0

ROPE_CONTEXT = 8192

HAS_LM_HEAD = has_root "lm_head"

rms :: Path -> Tensor[B,S,D] -> Tensor[B,S,D]
rms@path x = NN.rmsnorm@path x eps=EPS

llama3_block :: Tensor[B,S,D] -> Tensor[B,S] -> ?Tensor[B,K] -> ?CacheLayer[B,KVH,P,DH] -> (Tensor[B,S,D], ?CacheLayer[B,KVH,K,DH])
llama3_block x pos_ids attn_mask past_kv = do
  xn <- rms@input_layernorm x
  a, new_kv <- scope@self_attn do
    q <- NN.linear@q_proj xn dim=MODEL_DIM |> reshape_heads heads=NUM_HEADS
    k <- NN.linear@k_proj xn dim=KVD |> reshape_heads heads=KVH
    v <- NN.linear@v_proj xn dim=KVD |> reshape_heads heads=KVH
    q, k <- rope_pair_freq_scale q k pos_ids THETA ROPE_SCALE ROPE_LOW_FREQ ROPE_HIGH_FREQ ROPE_CONTEXT
    k, v, new_kv <- Cache.update past_kv k v
    k <- Tensor.repeat k repeats=(NUM_HEADS / KVH)
    v <- Tensor.repeat v repeats=(NUM_HEADS / KVH)
    keep <- causal_mask q k attn_mask
    a <- attention q k v keep scale=(1.0 / sqrt (MODEL_DIM / NUM_HEADS)) |> merge_heads |> NN.linear@o_proj dim=MODEL_DIM
    return a, new_kv
  x <- x + a
  xn <- rms@post_attention_layernorm x
  m <- scope@mlp do
    g <- NN.linear@gate_proj xn dim=FFN
    u <- NN.linear@up_proj xn dim=FFN
    return g |> silu |> mul u |> NN.linear@down_proj dim=MODEL_DIM
  return x + m, new_kv

llama3 :: TokenIds[B,S] -> ?Tensor[B,K] -> ?Cache[B,KVH,P,DH] -> ?Bool -> (Tensor[B,S,V], ?Cache[B,KVH,K,DH])
llama3 input_ids attn_mask past_kv use_cache = do
  pos_ids <- position_ids input_ids attn_mask=attn_mask past_length=(Cache.past_length past_kv) pad_fill=1
  logits, new_kv <- scope@model do
    x <- NN.embedding@embed_tokens input_ids dim=MODEL_DIM
    new_kv <- use_cache ? Cache.init : null
    x, new_kv <- for@layers i <- [0..NUM_LAYERS) carry (x, new_kv) do
      past_i <- Cache.index past_kv i
      x, new_i <- llama3_block x pos_ids attn_mask past_i
      new_kv <- Cache.append new_kv new_i
      yield x, new_kv
    x <- rms@norm x
    logits <- HAS_LM_HEAD ? (NN.linear@lm_head x dim=VOCAB_SIZE weight_path=@@lm_head.weight) : (NN.linear@embed_tokens x dim=VOCAB_SIZE)
    return logits, new_kv
  return logits, new_kv
