{-# CHECKPOINTS "adept/persimmon-8b-base" #-}

{-# TASK "causal_lm" #-}

{-# MAIN "persimmon" #-}

import Activations (relu2)

import Attention (attention, merge_heads)

import Cache

import Config

import Masking (Mask, causal_mask_for_input, mask_for_input, mask_length_for_input)

import Math (floor)

import NN

import Positions (position_ids, rope_base_factors, rope_pair_base_prefix_factors)

import Tensor

MODEL_DIM <- (4096 :: Dim)

FFN <- Config.dim @@intermediate_size default=(4 * MODEL_DIM)

NUM_LAYERS <- (36 :: Dim)

NUM_HEADS <- (64 :: Dim)

HEAD_DIM <- MODEL_DIM / NUM_HEADS

VOCAB_SIZE <- (262144 :: Dim)

MAX_POSITIONS <- (16384 :: Dim)

EPS <- 1e-05

THETA <- 25000.0

PARTIAL_ROTARY_FACTOR <- 0.5

ROTARY_DIM <- ((floor (HEAD_DIM * PARTIAL_ROTARY_FACTOR)) :: Dim)

QK_LAYERNORM <- true

TIE <- false

persimmon_split_qkv :: Tensor[B,S,3 * D] -> (Tensor[B,NUM_HEADS,S,HEAD_DIM], Tensor[B,NUM_HEADS,S,HEAD_DIM], Tensor[B,NUM_HEADS,S,HEAD_DIM])
persimmon_split_qkv qkv = do
  grouped <- Tensor.reshape qkv shape=[B, S, NUM_HEADS, 3, HEAD_DIM]
  q <- Tensor.slice grouped dim=3 start=0 end=1 |> Tensor.reshape shape=[B, S, NUM_HEADS, HEAD_DIM]
  k <- Tensor.slice grouped dim=3 start=1 end=2 |> Tensor.reshape shape=[B, S, NUM_HEADS, HEAD_DIM]
  v <- Tensor.slice grouped dim=3 start=2 end=3 |> Tensor.reshape shape=[B, S, NUM_HEADS, HEAD_DIM]
  q <- QK_LAYERNORM ? (NN.layernorm@q_layernorm q eps=EPS bias=true) : q
  k <- QK_LAYERNORM ? (NN.layernorm@k_layernorm k eps=EPS bias=true) : k
  q <- Tensor.permute q dims=[0, 2, 1, 3]
  k <- Tensor.permute k dims=[0, 2, 1, 3]
  v <- Tensor.permute v dims=[0, 2, 1, 3]
  return q, k, v

persimmon_block :: Tensor[B,S,D] -> Tensor[B,1,S,R] -> Tensor[B,1,S,R] -> Tensor[B,1,S,K] -> ?CacheLayer[B,NUM_HEADS,P,MAX_POSITIONS,HEAD_DIM] -> (Tensor[B,S,D], ?CacheLayer[B,NUM_HEADS,K,MAX_POSITIONS,HEAD_DIM])
persimmon_block x rope_sin rope_cos mask past_kv = do
  xn <- NN.layernorm@input_layernorm x eps=EPS bias=true
  a, new_kv <- scope@self_attn do
    qkv <- NN.linear@query_key_value xn dim=(3 * MODEL_DIM) bias=true
    q, k, v <- persimmon_split_qkv qkv
    q, k <- rope_pair_base_prefix_factors q k rope_sin rope_cos ROTARY_DIM
    k, v, new_kv <- Cache.update past_kv k v
    a <- attention q k v mask |> merge_heads |> NN.linear@dense dim=MODEL_DIM bias=true
    return a, new_kv
  x <- x + a
  xn <- NN.layernorm@post_attention_layernorm x eps=EPS bias=true
  m <- NN.linear@mlp.dense_h_to_4h xn dim=FFN bias=true |> relu2 |> NN.linear@mlp.dense_4h_to_h dim=MODEL_DIM bias=true
  return x + m, new_kv

persimmon :: TokenIds[B,S] -> ?Mask[B,K,MAX_POSITIONS] -> ?Cache[B,NUM_HEADS,P,MAX_POSITIONS,HEAD_DIM] -> ?Bool -> (Tensor[B,S,V], ?Cache[B,NUM_HEADS,K,MAX_POSITIONS,HEAD_DIM])
persimmon input_ids attn_mask past_kv use_cache = do
  past_length <- Cache.past_length past_kv
  attn_mask <- mask_for_input input_ids attn_mask MAX_POSITIONS
  pos_ids <- position_ids input_ids attn_mask=attn_mask past_length=past_length pad_fill=1
  rope_sin, rope_cos <- rope_base_factors pos_ids ROTARY_DIM THETA
  key_len <- mask_length_for_input input_ids attn_mask past_length
  mask <- causal_mask_for_input input_ids key_len padding_mask=attn_mask window=MAX_POSITIONS
  work_kv <- Cache.prepare past_kv use_cache MAX_POSITIONS
  read_kv <- Cache.read past_kv work_kv
  x, work_kv <- scope@model do
    x <- NN.embedding@embed_tokens input_ids dim=MODEL_DIM
    x, work_kv <- for@layers i <- [0..NUM_LAYERS) carry (x, work_kv) do
      past_i <- Cache.index read_kv i
      x, new_i <- persimmon_block x rope_sin rope_cos mask past_i
      work_kv <- Cache.append work_kv new_i
      yield x, work_kv
    x <- NN.layernorm@final_layernorm x eps=EPS bias=true
    return x, work_kv
  new_kv <- Cache.finish work_kv key_len
  new_kv <- use_cache ? new_kv : null
  logits <- TIE
        ? do
            tied <- scope@model do
              return NN.linear@embed_tokens x dim=VOCAB_SIZE bias=false
            return tied
        : (NN.linear@lm_head x dim=VOCAB_SIZE bias=false)
  return logits, new_kv
