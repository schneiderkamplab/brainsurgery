{-# CHECKPOINTS "microsoft/deberta-v3-xsmall" #-}
{-# TASK "masked_lm" #-}

import Activations
import Activations (gelu)
import Attention
import Attention (attention, merge_heads, reshape_heads)
import Masking
import Masking (bidirectional_mask)
import Params
import Params (has_root)
import Positions
import Positions (position_ids, relative_bias_disentangled)
import NN
import Tensor

deberta_block :: Tensor -> ?Tensor -> Tensor
deberta_block x attn_mask = do
  a <- scope@attention do
    q0 <- NN.linear@self.query_proj x dim=384 bias=true |> reshape_heads heads=6
    k <- NN.linear@self.key_proj x dim=384 bias=true |> reshape_heads heads=6
    v <- NN.linear@self.value_proj x dim=384 bias=true |> reshape_heads heads=6
    rel_bias <- relative_bias_disentangled@self q0 k position_buckets=256 max_relative_positions=512 rel_norm_eps=1e-07 weight_path=@@deberta.encoder.rel_embeddings.weight ln_weight_path=@@deberta.encoder.LayerNorm.weight ln_bias_path=@@deberta.encoder.LayerNorm.bias
    q <- q0 * 0.5773502691896257
    keep <- bidirectional_mask q0 k padding_mask=attn_mask
    return attention q k v keep rel_bias=rel_bias scale=0.125 |> merge_heads |> NN.linear@output.dense dim=384 bias=true
  x <- x + a
  x <- NN.layernorm@attention.output.LayerNorm x eps=1e-07
  m <- NN.linear@intermediate.dense x dim=1536 bias=true |> gelu
  m <- NN.linear@output.dense m dim=384 bias=true
  y <- x + m
  y <- NN.layernorm@output.LayerNorm y eps=1e-07
  return y

deberta_legacy_head :: Tensor -> Tensor
deberta_legacy_head x = do
  logits <- scope@cls.predictions do
    x <- NN.linear@transform.dense x dim=384 bias=true |> gelu
    x <- NN.layernorm@transform.LayerNorm x eps=1e-07
    return NN.linear@decoder x dim=128100 bias=true weight_path=@@deberta.embeddings.word_embeddings.weight bias_path=@@cls.predictions.bias
  return logits

deberta_modern_head :: Tensor -> Tensor
deberta_modern_head x = do
  logits <- scope@lm_predictions.lm_head do
    x <- NN.linear@dense x dim=384 bias=true |> gelu
    x <- NN.layernorm@LayerNorm x eps=1e-07
    return NN.linear@decoder x dim=128100 bias=true weight_path=@@deberta.embeddings.word_embeddings.weight bias_path=@@lm_predictions.lm_head.bias
  return logits

deberta_v2 :: TokenIds[B,S] -> ?Tensor[B,S] -> Tensor[B,S,V]
deberta_v2 input_ids attn_mask = do
  pos_ids <- position_ids input_ids
  tok_type_ids <- input_ids - input_ids
  tok <- NN.embedding@deberta.embeddings.word_embeddings input_ids dim=384
  pos <- Tensor.zeros_like tok
  has_typ <- has_root "deberta.embeddings.token_type_embeddings"
  typ <- has_typ ? NN.embedding@deberta.embeddings.token_type_embeddings tok_type_ids dim=384 : Tensor.zeros_like tok
  x <- tok + pos
  x <- x + typ
  has_proj <- has_root "deberta.embeddings.embed_proj"
  x <- has_proj ? NN.linear@deberta.embeddings.embed_proj x dim=384 bias=false : x
  x <- NN.layernorm@deberta.embeddings.LayerNorm x eps=1e-07
  for@deberta.encoder.layer i <- [0..12) do
    x <- deberta_block x attn_mask
    yield x
  modern_head <- has_root "lm_predictions.lm_head"
  legacy_head <- has_root "cls.predictions"
  logits <- modern_head ? deberta_modern_head x : (legacy_head ? deberta_legacy_head x : deberta_modern_head x)
  return logits
