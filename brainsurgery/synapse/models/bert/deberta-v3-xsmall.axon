import Math
{-# CHECKPOINTS "microsoft/deberta-v3-xsmall" #-}
{-# TASK "masked_lm" #-}

import Activations
import Activations (gelu)

D = 384
E = 384
V = 128100
L = 12
H = 6
FFN = 1536
EPS = 1e-07
POS_BUCKETS = 256
MAX_REL = 512
REL_Q_SCALE = 0.5773502691896257

deberta_block :: Tensor[B,S,D] -> ?Tensor[B,S] -> Tensor[B,S,D]
deberta_block x attn_mask = do
  a <- scope@attention do
    q0 <- linear@self.query_proj x dim=D bias=true |> reshape_heads heads=H
    k <- linear@self.key_proj x dim=D bias=true |> reshape_heads heads=H
    v <- linear@self.value_proj x dim=D bias=true |> reshape_heads heads=H
    rel_bias <- disentangled_relative_bias@self q0 k rel_embeddings="@@deberta.encoder.rel_embeddings.weight" position_buckets=POS_BUCKETS max_relative_positions=MAX_REL share_att_key=true c2p=true p2c=true query_weight="self.query_proj.weight" query_bias="self.query_proj.bias" key_weight="self.key_proj.weight" key_bias="self.key_proj.bias" apply_rel_layernorm=true rel_norm_weight="@@deberta.encoder.LayerNorm.weight" rel_norm_bias="@@deberta.encoder.LayerNorm.bias" rel_norm_eps=EPS
    q <- q0 * 0.5773502691896257
    pad_bias <- bidirectional_mask q0 k padding_mask=attn_mask
    full_bias <- Math.add rel_bias pad_bias
    return attention q k v mask=full_bias padding_mask=false causal=false |> merge_heads |> linear@output.dense dim=D bias=true
  x <- x + a
  x <- layernorm@attention.output.LayerNorm x eps=EPS
  m <- linear@intermediate.dense x dim=FFN bias=true |> gelu
  m <- linear@output.dense m dim=D bias=true
  y <- x + m
  y <- layernorm@output.LayerNorm y eps=EPS
  return y

deberta_legacy_head :: Tensor[B,S,D] -> Tensor[B,S,V]
deberta_legacy_head x = do
  logits <- scope@cls.predictions do
    x <- linear@transform.dense x dim=E bias=true |> gelu
    x <- layernorm@transform.LayerNorm x eps=EPS
    return linear@decoder x dim=V bias=true weight_path=@@deberta.embeddings.word_embeddings.weight bias_path=@@cls.predictions.bias
  return logits

deberta_modern_head :: Tensor[B,S,D] -> Tensor[B,S,V]
deberta_modern_head x = do
  logits <- scope@lm_predictions.lm_head do
    x <- linear@dense x dim=D bias=true |> gelu
    x <- layernorm@LayerNorm x eps=EPS
    return linear@decoder x dim=V bias=true weight_path=@@deberta.embeddings.word_embeddings.weight bias_path=@@lm_predictions.lm_head.bias
  return logits

deberta_v2 :: TokenIds[B,S] -> ?Tensor[B,S] -> Tensor[B,S,V]
deberta_v2 input_ids attn_mask = do
  pos_ids <- position_ids input_ids
  tok_type_ids <- zeros_like input_ids
  tok <- embedding@deberta.embeddings.word_embeddings input_ids dim=E
  pos <- zeros_like tok
  has_typ <- false
  typ <- has_typ ? embedding@deberta.embeddings.token_type_embeddings tok_type_ids dim=E : zeros_like tok
  x <- tok + pos
  x <- x + typ
  has_proj <- false
  x <- has_proj ? linear@deberta.embeddings.embed_proj x dim=D bias=false : x
  x <- layernorm@deberta.embeddings.LayerNorm x eps=EPS
  for@deberta.encoder.layer i <- [0..L) do
    x <- deberta_block x attn_mask
  modern_head <- true
  legacy_head <- false
  logits <- modern_head ? deberta_modern_head x : (legacy_head ? deberta_legacy_head x : deberta_modern_head x)
  return logits
