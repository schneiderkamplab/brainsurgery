{-# CHECKPOINTS "distilbert/distilbert-base-uncased" #-}
{-# TASK "masked_lm" #-}

import Activations
import Activations (gelu)
import Attention (reshape_heads, merge_heads)
import Compat (attention)
import Masking (causal_mask)
import Positions (position_ids)

D = 768
V = 30522
L = 6
H = 12
FFN = 3072
EPS = 1e-12

distil_block :: Tensor[B,S,D] -> ?Tensor[B,S] -> Tensor[B,S,D]
distil_block x attn_mask = do
  a <- scope@attention do
    q <- NN.linear@q_lin x dim=D bias=true |> reshape_heads heads=H
    k <- NN.linear@k_lin x dim=D bias=true |> reshape_heads heads=H
    v <- NN.linear@v_lin x dim=D bias=true |> reshape_heads heads=H
    return attention q k v mask=attn_mask padding_mask=true causal=false |> merge_heads |> NN.linear@out_lin dim=D bias=true
  x <- x + a
  x <- NN.layernorm@sa_layer_norm x eps=EPS
  m <- NN.linear@ffn.lin1 x dim=FFN bias=true |> gelu
  m <- NN.linear@ffn.lin2 m dim=D bias=true
  y <- x + m
  y <- NN.layernorm@output_layer_norm y eps=EPS
  return y

distilbert :: TokenIds[B,S] -> ?Tensor[B,S] -> Tensor[B,S,V]
distilbert input_ids attn_mask = do
  pos_ids <- position_ids input_ids
  tok <- NN.embedding@distilbert.embeddings.word_embeddings input_ids dim=D
  pos <- NN.embedding@distilbert.embeddings.position_embeddings pos_ids dim=D
  x <- tok + pos
  x <- NN.layernorm@distilbert.embeddings.LayerNorm x eps=EPS
  for@distilbert.transformer.layer i <- [0..L) do
    x <- distil_block x attn_mask
  x <- NN.linear@vocab_transform x dim=D bias=true |> gelu
  x <- NN.layernorm@vocab_layer_norm x eps=EPS
  logits <- NN.linear@vocab_projector x dim=V bias=true weight_path=@@distilbert.embeddings.word_embeddings.weight
  return logits
