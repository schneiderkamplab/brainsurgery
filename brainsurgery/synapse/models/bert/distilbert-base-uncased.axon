{-# CHECKPOINTS "distilbert/distilbert-base-uncased" #-}
{-# TASK "masked_lm" #-}

import Activations
import Activations (gelu)
import Attention
import Attention (attention, merge_heads, reshape_heads)
import Masking
import Masking (bidirectional_mask)
import Positions
import Positions (position_ids)
import NN

distil_block :: Tensor[B,S,D] -> ?Tensor[B,S] -> Tensor[B,S,D]
distil_block x attn_mask = do
  a <- scope@attention do
    q <- NN.linear@q_lin x dim=768 bias=true |> reshape_heads heads=12
    k <- NN.linear@k_lin x dim=768 bias=true |> reshape_heads heads=12
    v <- NN.linear@v_lin x dim=768 bias=true |> reshape_heads heads=12
    keep <- bidirectional_mask q k padding_mask=attn_mask
    return attention q k v keep |> merge_heads |> NN.linear@out_lin dim=768 bias=true
  x <- x + a
  x <- NN.layernorm@sa_layer_norm x eps=1e-12
  m <- NN.linear@ffn.lin1 x dim=3072 bias=true |> gelu
  m <- NN.linear@ffn.lin2 m dim=768 bias=true
  y <- x + m
  y <- NN.layernorm@output_layer_norm y eps=1e-12
  return y

distilbert :: TokenIds[B,S] -> ?Tensor[B,S] -> Tensor[B,S,V]
distilbert input_ids attn_mask = do
  pos_ids <- position_ids input_ids
  tok <- NN.embedding@distilbert.embeddings.word_embeddings input_ids dim=768
  pos <- NN.embedding@distilbert.embeddings.position_embeddings pos_ids dim=768
  x <- tok + pos
  x <- NN.layernorm@distilbert.embeddings.LayerNorm x eps=1e-12
  for@distilbert.transformer.layer i <- [0..6) do
    x <- distil_block x attn_mask
    yield x
  x <- NN.linear@vocab_transform x dim=768 bias=true |> gelu
  x <- NN.layernorm@vocab_layer_norm x eps=1e-12
  logits <- NN.linear@vocab_projector x dim=30522 bias=true weight_path=@@distilbert.embeddings.word_embeddings.weight
  return logits
