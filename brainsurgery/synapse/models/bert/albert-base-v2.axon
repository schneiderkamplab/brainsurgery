{-# CHECKPOINTS "albert/albert-base-v2" #-}
{-# TASK "masked_lm" #-}

import Activations
import Activations (gelu_new)
import Attention
import Attention (attention, merge_heads, reshape_heads)
import Masking
import Masking (bidirectional_mask)
import Positions
import Positions (position_ids)
import NN

albert_block :: Tensor[B,S,D] -> ?Tensor[B,S] -> Tensor[B,S,D]
albert_block x attn_mask = do
  a <- scope@attention do
    q <- NN.linear@query x dim=768 bias=true weight_path=@@albert.encoder.albert_layer_groups.0.albert_layers.0.attention.query.weight bias_path=@@albert.encoder.albert_layer_groups.0.albert_layers.0.attention.query.bias |> reshape_heads heads=12
    k <- NN.linear@key x dim=768 bias=true weight_path=@@albert.encoder.albert_layer_groups.0.albert_layers.0.attention.key.weight bias_path=@@albert.encoder.albert_layer_groups.0.albert_layers.0.attention.key.bias |> reshape_heads heads=12
    v <- NN.linear@value x dim=768 bias=true weight_path=@@albert.encoder.albert_layer_groups.0.albert_layers.0.attention.value.weight bias_path=@@albert.encoder.albert_layer_groups.0.albert_layers.0.attention.value.bias |> reshape_heads heads=12
    keep <- bidirectional_mask q k padding_mask=attn_mask
    return attention q k v keep |> merge_heads |> NN.linear@dense dim=768 bias=true weight_path=@@albert.encoder.albert_layer_groups.0.albert_layers.0.attention.dense.weight bias_path=@@albert.encoder.albert_layer_groups.0.albert_layers.0.attention.dense.bias
  x <- x + a
  x <- NN.layernorm@attention.LayerNorm x eps=1e-12 weight_path=@@albert.encoder.albert_layer_groups.0.albert_layers.0.attention.LayerNorm.weight bias_path=@@albert.encoder.albert_layer_groups.0.albert_layers.0.attention.LayerNorm.bias
  m <- NN.linear@ffn x dim=3072 bias=true weight_path=@@albert.encoder.albert_layer_groups.0.albert_layers.0.ffn.weight bias_path=@@albert.encoder.albert_layer_groups.0.albert_layers.0.ffn.bias |> gelu_new
  m <- NN.linear@ffn_output m dim=768 bias=true weight_path=@@albert.encoder.albert_layer_groups.0.albert_layers.0.ffn_output.weight bias_path=@@albert.encoder.albert_layer_groups.0.albert_layers.0.ffn_output.bias
  y <- x + m
  y <- NN.layernorm@full_layer_layer_norm y eps=1e-12 weight_path=@@albert.encoder.albert_layer_groups.0.albert_layers.0.full_layer_layer_norm.weight bias_path=@@albert.encoder.albert_layer_groups.0.albert_layers.0.full_layer_layer_norm.bias
  return y

albert :: TokenIds[B,S] -> ?Tensor[B,S] -> Tensor[B,S,V]
albert input_ids attn_mask = do
  pos_ids <- position_ids input_ids
  tok_type_ids <- input_ids - input_ids
  tok <- NN.embedding@albert.embeddings.word_embeddings input_ids dim=128
  pos <- NN.embedding@albert.embeddings.position_embeddings pos_ids dim=128
  typ <- NN.embedding@albert.embeddings.token_type_embeddings tok_type_ids dim=128
  x <- tok + pos
  x <- x + typ
  x <- NN.layernorm@albert.embeddings.LayerNorm x eps=1e-12
  x <- NN.linear@albert.encoder.embedding_hidden_mapping_in x dim=768 bias=true
  for i <- [0..12) do
    x <- albert_block x attn_mask
    yield x
  x <- NN.linear@predictions.dense x dim=128 bias=true |> gelu_new
  x <- NN.layernorm@predictions.LayerNorm x eps=1e-12
  logits <- NN.linear@predictions.decoder x dim=30000 bias=true weight_path=@@albert.embeddings.word_embeddings.weight bias_path=@@predictions.decoder.bias
  return logits
