{-# CHECKPOINTS "google/electra-base-generator" #-}
{-# TASK "masked_lm" #-}

import Activations
import Activations (gelu)
import Attention
import Attention (attention, merge_heads, reshape_heads)
import Masking
import Masking (bidirectional_mask)
import Positions
import Positions (position_ids)
import NN

electra_block :: Tensor[B,S,D] -> ?Tensor[B,S] -> Tensor[B,S,D]
electra_block x attn_mask = do
  a <- scope@attention do
    q <- NN.linear@self.query x dim=256 bias=true |> reshape_heads heads=4
    k <- NN.linear@self.key x dim=256 bias=true |> reshape_heads heads=4
    v <- NN.linear@self.value x dim=256 bias=true |> reshape_heads heads=4
    keep <- bidirectional_mask q k padding_mask=attn_mask
    return attention q k v keep |> merge_heads |> NN.linear@output.dense dim=256 bias=true
  x <- x + a
  x <- NN.layernorm@attention.output.LayerNorm x eps=1e-12
  m <- NN.linear@intermediate.dense x dim=1024 bias=true |> gelu
  m <- NN.linear@output.dense m dim=256 bias=true
  y <- x + m
  y <- NN.layernorm@output.LayerNorm y eps=1e-12
  return y

electra :: TokenIds[B,S] -> ?Tensor[B,S] -> Tensor[B,S,V]
electra input_ids attn_mask = do
  pos_ids <- position_ids input_ids
  tok_type_ids <- input_ids - input_ids
  tok <- NN.embedding@electra.embeddings.word_embeddings input_ids dim=768
  pos <- NN.embedding@electra.embeddings.position_embeddings pos_ids dim=768
  typ <- NN.embedding@electra.embeddings.token_type_embeddings tok_type_ids dim=768
  x <- tok + pos
  x <- x + typ
  x <- NN.layernorm@electra.embeddings.LayerNorm x eps=1e-12
  x <- NN.linear@electra.embeddings_project x dim=256 bias=true
  for@electra.encoder.layer i <- [0..12) do
    x <- electra_block x attn_mask
    yield x
  x <- NN.linear@generator_predictions.dense x dim=768 bias=true |> gelu
  x <- NN.layernorm@generator_predictions.LayerNorm x eps=1e-12
  logits <- NN.linear@generator_lm_head x dim=30522 bias=true weight_path=@@electra.embeddings.word_embeddings.weight
  return logits
