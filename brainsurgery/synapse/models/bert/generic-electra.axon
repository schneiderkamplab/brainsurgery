{-# CHECKPOINTS ["google/electra-base-generator"] #-}
{-# TASK "masked_lm" #-}

import Activations (gelu)
import Attention (attention, merge_heads, reshape_heads)
import Masking (bidirectional_mask_for_input)
import Positions (position_ids)
import Config
import NN



E   = Config.int @@embedding_size default=128
MODEL_DIM   = Config.int @@hidden_size default=256
VOCAB_SIZE   = Config.int @@vocab_size default=30522
NUM_LAYERS   = Config.int @@num_hidden_layers default=12
NUM_HEADS   = Config.int @@num_attention_heads default=4
FFN = Config.int @@intermediate_size default=1024
EPS = Config.float @@layer_norm_eps default=1e-12

electra_block :: Tensor[B,S,D] -> Tensor[B,1,S,S] -> Tensor[B,S,D]
electra_block x keep = do
  a <- scope@attention do
    q <- NN.linear@self.query x dim=MODEL_DIM bias=true |> reshape_heads heads=NUM_HEADS
    k <- NN.linear@self.key x dim=MODEL_DIM bias=true |> reshape_heads heads=NUM_HEADS
    v <- NN.linear@self.value x dim=MODEL_DIM bias=true |> reshape_heads heads=NUM_HEADS
    return attention q k v keep |> merge_heads |> NN.linear@output.dense dim=MODEL_DIM bias=true
  x <- x + a
  x <- NN.layernorm@attention.output.LayerNorm x eps=EPS
  m <- NN.linear@intermediate.dense x dim=FFN bias=true |> gelu
  m <- NN.linear@output.dense m dim=MODEL_DIM bias=true
  y <- x + m
  y <- NN.layernorm@output.LayerNorm y eps=EPS
  return y

electra :: TokenIds[B,S] -> ?Tensor[B,S] -> Tensor[B,S,V]
electra input_ids attn_mask = do
  pos_ids <- position_ids input_ids
  keep <- bidirectional_mask_for_input input_ids S padding_mask=attn_mask
  tok_type_ids <- input_ids - input_ids
  tok <- NN.embedding@electra.embeddings.word_embeddings input_ids dim=E
  pos <- NN.embedding@electra.embeddings.position_embeddings pos_ids dim=E
  typ <- NN.embedding@electra.embeddings.token_type_embeddings tok_type_ids dim=E
  x <- tok + pos
  x <- x + typ
  x <- NN.layernorm@electra.embeddings.LayerNorm x eps=EPS
  x <- (E == MODEL_DIM) ? x : NN.linear@electra.embeddings_project x dim=MODEL_DIM bias=true
  x <- for@electra.encoder.layer i <- [0..NUM_LAYERS) carry (x) do
    x <- electra_block x keep
    yield x
  x <- NN.linear@generator_predictions.dense x dim=E bias=true |> gelu
  x <- NN.layernorm@generator_predictions.LayerNorm x eps=EPS
  logits <- NN.linear@generator_lm_head x dim=VOCAB_SIZE bias=true weight_path=@@electra.embeddings.word_embeddings.weight
  return logits
