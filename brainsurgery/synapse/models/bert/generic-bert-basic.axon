import Math
{-# CHECKPOINTS ["google-bert/bert-base-uncased"] #-}
{-# TASK "masked_lm" #-}

import Config
import Activations gelu
import Masking (
  bidirectional_mask_basic,
)
import Derived (
  merge_heads_basic,
  attention_basic,
)

D   = Config.int "hidden_size" default=768
V   = Config.int "vocab_size" default=30522
L   = Config.int "num_hidden_layers" default=12
H   = Config.int "num_attention_heads" default=12
FFN = Config.int "intermediate_size" default=3072
EPS = Config.float "layer_norm_eps" default=1e-12
ATTN_SCALE = 1.0 / Math.sqrt (D / H)

bert_block :: Tensor[B,S,D] -> ?Tensor[B,S] -> Tensor[B,S,D]
bert_block x attn_mask = do
  a <- scope@attention do
    q <- linear@self.query x dim=D bias=true |> reshape_heads heads=H
    k <- linear@self.key x dim=D bias=true |> reshape_heads heads=H
    v <- linear@self.value x dim=D bias=true |> reshape_heads heads=H
    keep <- bidirectional_mask_basic q k attn_mask
    return attention_basic q k v keep scale=ATTN_SCALE |> merge_heads_basic |> linear@output.dense dim=D bias=true
  x <- x + a
  x <- layernorm@attention.output.LayerNorm x eps=EPS weight_path=@attention.output.LayerNorm.gamma bias_path=@attention.output.LayerNorm.beta
  m <- linear@intermediate.dense x dim=FFN bias=true |> gelu
  m <- linear@output.dense m dim=D bias=true
  y <- x + m
  y <- layernorm@output.LayerNorm y eps=EPS weight_path=@output.LayerNorm.gamma bias_path=@output.LayerNorm.beta
  return y

bert :: TokenIds[B,S] -> ?Tensor[B,S] -> Tensor[B,S,V]
bert input_ids attn_mask = do
  pos_ids <- position_ids input_ids attn_mask=null past_length=0 pad_fill=1
  tok_type_ids <- zeros_like input_ids
  tok <- embedding@bert.embeddings.word_embeddings input_ids dim=D
  pos <- embedding@bert.embeddings.position_embeddings pos_ids dim=D
  typ <- embedding@bert.embeddings.token_type_embeddings tok_type_ids dim=D
  x <- tok + pos
  x <- x + typ
  x <- layernorm@bert.embeddings.LayerNorm x eps=EPS weight_path=@@bert.embeddings.LayerNorm.gamma bias_path=@@bert.embeddings.LayerNorm.beta
  for@bert.encoder.layer i <- [0..L) do
    x <- bert_block x attn_mask
  logits <- scope@cls.predictions do
    x <- linear@transform.dense x dim=D bias=true |> gelu
    x <- layernorm@transform.LayerNorm x eps=EPS weight_path=@@cls.predictions.transform.LayerNorm.gamma bias_path=@@cls.predictions.transform.LayerNorm.beta
    return linear@decoder x dim=V bias=true weight_path=@@bert.embeddings.word_embeddings.weight bias_path=@@cls.predictions.bias
  return logits
