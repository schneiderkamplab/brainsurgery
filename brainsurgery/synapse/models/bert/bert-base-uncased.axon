{-# CHECKPOINTS "google-bert/bert-base-uncased" #-}
{-# TASK "masked_lm" #-}

import Activations
import Activations (gelu)
import Attention
import Attention (attention, merge_heads, reshape_heads)
import Masking
import Masking (bidirectional_mask)
import Positions
import Positions (position_ids)

bert_block :: Tensor[B,S,D] -> ?Tensor[B,S] -> Tensor[B,S,D]
bert_block x attn_mask = do
  a <- scope@attention do
    q <- NN.linear@self.query x dim=768 bias=true |> reshape_heads heads=12
    k <- NN.linear@self.key x dim=768 bias=true |> reshape_heads heads=12
    v <- NN.linear@self.value x dim=768 bias=true |> reshape_heads heads=12
    keep <- bidirectional_mask q k padding_mask=attn_mask
    return attention q k v keep |> merge_heads |> NN.linear@output.dense dim=768 bias=true
  x <- x + a
  x <- NN.layernorm@attention.output.LayerNorm x eps=1e-12 weight_path=@attention.output.LayerNorm.gamma bias_path=@attention.output.LayerNorm.beta
  m <- NN.linear@intermediate.dense x dim=3072 bias=true |> gelu
  m <- NN.linear@output.dense m dim=768 bias=true
  y <- x + m
  y <- NN.layernorm@output.LayerNorm y eps=1e-12 weight_path=@output.LayerNorm.gamma bias_path=@output.LayerNorm.beta
  return y

bert :: TokenIds[B,S] -> ?Tensor[B,S] -> Tensor[B,S,V]
bert input_ids attn_mask = do
  pos_ids <- position_ids input_ids
  tok_type_ids <- input_ids - input_ids
  tok <- NN.embedding@bert.embeddings.word_embeddings input_ids dim=768
  pos <- NN.embedding@bert.embeddings.position_embeddings pos_ids dim=768
  typ <- NN.embedding@bert.embeddings.token_type_embeddings tok_type_ids dim=768
  x <- tok + pos
  x <- x + typ
  x <- NN.layernorm@bert.embeddings.LayerNorm x eps=1e-12 weight_path=@@bert.embeddings.LayerNorm.gamma bias_path=@@bert.embeddings.LayerNorm.beta
  for@bert.encoder.layer i <- [0..12) do
    x <- bert_block x attn_mask
    yield x
  logits <- scope@cls.predictions do
    x <- NN.linear@transform.dense x dim=768 bias=true |> gelu
    x <- NN.layernorm@transform.LayerNorm x eps=1e-12 weight_path=@@cls.predictions.transform.LayerNorm.gamma bias_path=@@cls.predictions.transform.LayerNorm.beta
    return NN.linear@decoder x dim=30522 bias=true weight_path=@@bert.embeddings.word_embeddings.weight bias_path=@@cls.predictions.bias
  return logits
