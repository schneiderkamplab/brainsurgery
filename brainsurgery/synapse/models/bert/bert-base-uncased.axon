{-# CHECKPOINTS "google-bert/bert-base-uncased" #-}
{-# TASK "masked_lm" #-}

import Activations (gelu)
import Attention (attention, merge_heads, reshape_heads)
import Masking (bidirectional_mask)
import Positions (position_ids)



D = 768
V = 30522
L = 12
H = 12
FFN = 3072
EPS = 1e-12

bert_block :: Tensor[B,S,D] -> ?Tensor[B,S] -> Tensor[B,S,D]
bert_block x attn_mask = do
  a <- scope@attention do
    q <- NN.linear@self.query x dim=D bias=true |> reshape_heads heads=H
    k <- NN.linear@self.key x dim=D bias=true |> reshape_heads heads=H
    v <- NN.linear@self.value x dim=D bias=true |> reshape_heads heads=H
    keep <- bidirectional_mask q k padding_mask=attn_mask
    return attention q k v keep |> merge_heads |> NN.linear@output.dense dim=D bias=true
  x <- x + a
  x <- NN.layernorm@attention.output.LayerNorm x eps=EPS weight_path=@attention.output.LayerNorm.gamma bias_path=@attention.output.LayerNorm.beta
  m <- NN.linear@intermediate.dense x dim=FFN bias=true |> gelu
  m <- NN.linear@output.dense m dim=D bias=true
  y <- x + m
  y <- NN.layernorm@output.LayerNorm y eps=EPS weight_path=@output.LayerNorm.gamma bias_path=@output.LayerNorm.beta
  return y

bert :: TokenIds[B,S] -> ?Tensor[B,S] -> Tensor[B,S,V]
bert input_ids attn_mask = do
  pos_ids <- position_ids input_ids
  tok_type_ids <- Tensor.zeros_like input_ids
  tok <- NN.embedding@bert.embeddings.word_embeddings input_ids dim=D
  pos <- NN.embedding@bert.embeddings.position_embeddings pos_ids dim=D
  typ <- NN.embedding@bert.embeddings.token_type_embeddings tok_type_ids dim=D
  x <- tok + pos
  x <- x + typ
  x <- NN.layernorm@bert.embeddings.LayerNorm x eps=EPS weight_path=@@bert.embeddings.LayerNorm.gamma bias_path=@@bert.embeddings.LayerNorm.beta
  for@bert.encoder.layer i <- [0..L) do
    x <- bert_block x attn_mask
  logits <- scope@cls.predictions do
    x <- NN.linear@transform.dense x dim=D bias=true |> gelu
    x <- NN.layernorm@transform.LayerNorm x eps=EPS weight_path=@@cls.predictions.transform.LayerNorm.gamma bias_path=@@cls.predictions.transform.LayerNorm.beta
    return NN.linear@decoder x dim=V bias=true weight_path=@@bert.embeddings.word_embeddings.weight bias_path=@@cls.predictions.bias
  return logits
