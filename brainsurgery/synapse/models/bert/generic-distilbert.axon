{-# CHECKPOINTS ["distilbert/distilbert-base-uncased"] #-}
{-# TASK "masked_lm" #-}

import Config
import Activations gelu

D   = Config.int "dim" default=768
V   = Config.int "vocab_size" default=30522
L   = Config.int "n_layers" default=6
H   = Config.int "n_heads" default=12
FFN = Config.int "hidden_dim" default=3072
EPS = Config.float "layer_norm_eps" default=1e-12

distil_block :: Tensor[B,S,D] -> ?Tensor[B,S] -> Tensor[B,S,D]
distil_block x attn_mask = do
  a <- scope@attention do
    q <- linear@q_lin x dim=D bias=true |> reshape_heads heads=H
    k <- linear@k_lin x dim=D bias=true |> reshape_heads heads=H
    v <- linear@v_lin x dim=D bias=true |> reshape_heads heads=H
    return attention q k v mask=attn_mask padding_mask=true causal=false |> merge_heads |> linear@out_lin dim=D bias=true
  x <- x + a
  x <- layernorm@sa_layer_norm x eps=EPS
  m <- linear@ffn.lin1 x dim=FFN bias=true |> gelu
  m <- linear@ffn.lin2 m dim=D bias=true
  y <- x + m
  y <- layernorm@output_layer_norm y eps=EPS
  return y

distilbert :: TokenIds[B,S] -> ?Tensor[B,S] -> Tensor[B,S,V]
distilbert input_ids attn_mask = do
  pos_ids <- position_ids input_ids null
  tok <- embedding@distilbert.embeddings.word_embeddings input_ids dim=D
  pos <- embedding@distilbert.embeddings.position_embeddings pos_ids dim=D
  x <- tok + pos
  x <- layernorm@distilbert.embeddings.LayerNorm x eps=EPS
  for@distilbert.transformer.layer i <- [0..L) do
    x <- distil_block x attn_mask
  x <- linear@vocab_transform x dim=D bias=true |> gelu
  x <- layernorm@vocab_layer_norm x eps=EPS
  logits <- linear@vocab_projector x dim=V bias=true weight_path=@@distilbert.embeddings.word_embeddings.weight
  return logits
