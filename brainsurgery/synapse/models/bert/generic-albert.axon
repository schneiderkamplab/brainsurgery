{-# CHECKPOINTS ["albert/albert-base-v2"] #-}
{-# TASK "masked_lm" #-}

import Config
import Activations gelu_new

E   = Config.int "embedding_size" default=128
D   = Config.int "hidden_size" default=768
V   = Config.int "vocab_size" default=30000
L   = Config.int "num_hidden_layers" default=12
H   = Config.int "num_attention_heads" default=12
FFN = Config.int "intermediate_size" default=3072
EPS = Config.float "layer_norm_eps" default=1e-12

albert_block :: Tensor[B,S,D] -> ?Tensor[B,S] -> Tensor[B,S,D]
albert_block x attn_mask = do
  a <- scope@attention do
    q <- linear@query x dim=D bias=true weight_path=@@albert.encoder.albert_layer_groups.0.albert_layers.0.attention.query.weight bias_path=@@albert.encoder.albert_layer_groups.0.albert_layers.0.attention.query.bias |> reshape_heads heads=H
    k <- linear@key x dim=D bias=true weight_path=@@albert.encoder.albert_layer_groups.0.albert_layers.0.attention.key.weight bias_path=@@albert.encoder.albert_layer_groups.0.albert_layers.0.attention.key.bias |> reshape_heads heads=H
    v <- linear@value x dim=D bias=true weight_path=@@albert.encoder.albert_layer_groups.0.albert_layers.0.attention.value.weight bias_path=@@albert.encoder.albert_layer_groups.0.albert_layers.0.attention.value.bias |> reshape_heads heads=H
    return attention q k v mask=attn_mask padding_mask=true causal=false |> merge_heads |> linear@dense dim=D bias=true weight_path=@@albert.encoder.albert_layer_groups.0.albert_layers.0.attention.dense.weight bias_path=@@albert.encoder.albert_layer_groups.0.albert_layers.0.attention.dense.bias
  x <- x + a
  x <- layernorm@attention.LayerNorm x eps=EPS weight_path=@@albert.encoder.albert_layer_groups.0.albert_layers.0.attention.LayerNorm.weight bias_path=@@albert.encoder.albert_layer_groups.0.albert_layers.0.attention.LayerNorm.bias
  m <- linear@ffn x dim=FFN bias=true weight_path=@@albert.encoder.albert_layer_groups.0.albert_layers.0.ffn.weight bias_path=@@albert.encoder.albert_layer_groups.0.albert_layers.0.ffn.bias |> gelu_new
  m <- linear@ffn_output m dim=D bias=true weight_path=@@albert.encoder.albert_layer_groups.0.albert_layers.0.ffn_output.weight bias_path=@@albert.encoder.albert_layer_groups.0.albert_layers.0.ffn_output.bias
  y <- x + m
  y <- layernorm@full_layer_layer_norm y eps=EPS weight_path=@@albert.encoder.albert_layer_groups.0.albert_layers.0.full_layer_layer_norm.weight bias_path=@@albert.encoder.albert_layer_groups.0.albert_layers.0.full_layer_layer_norm.bias
  return y

albert :: TokenIds[B,S] -> ?Tensor[B,S] -> Tensor[B,S,V]
albert input_ids attn_mask = do
  pos_ids <- position_ids input_ids
  tok_type_ids <- zeros_like input_ids
  tok <- embedding@albert.embeddings.word_embeddings input_ids dim=E
  pos <- embedding@albert.embeddings.position_embeddings pos_ids dim=E
  typ <- embedding@albert.embeddings.token_type_embeddings tok_type_ids dim=E
  x <- tok + pos
  x <- x + typ
  x <- layernorm@albert.embeddings.LayerNorm x eps=EPS
  x <- linear@albert.encoder.embedding_hidden_mapping_in x dim=D bias=true
  for i <- [0..L) do
    x <- albert_block x attn_mask
  x <- linear@predictions.dense x dim=E bias=true |> gelu_new
  x <- layernorm@predictions.LayerNorm x eps=EPS
  logits <- linear@predictions.decoder x dim=V bias=true weight_path=@@albert.embeddings.word_embeddings.weight bias_path=@@predictions.decoder.bias
  return logits
