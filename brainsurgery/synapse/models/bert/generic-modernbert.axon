{-# CHECKPOINTS ["answerdotai/ModernBERT-base"] #-}
{-# TASK "masked_lm" #-}

import Config
import Activations gelu

D          = Config.int "hidden_size" default=768
V          = Config.int "vocab_size" default=50368
L          = Config.int "num_hidden_layers" default=22
H          = Config.int "num_attention_heads" default=12
FFN        = Config.int "intermediate_size" default=1152
EPS        = Config.float "norm_eps" default=1e-05
FULL_EVERY = Config.int "global_attn_every_n_layers" default=3
LOCAL_ATTN = Config.int "local_attention" default=128
LOCAL_WIN  = LOCAL_ATTN / 2
THETA_FULL = Config.float "rope_theta" root="rope_parameters.full_attention" default=160000.0
THETA_LOCAL = Config.float "rope_theta" root="rope_parameters.sliding_attention" default=10000.0

modernbert_layer :: Tensor[B,S,D] -> Int -> Tensor[B,S] -> ?Tensor[B,S] -> Tensor[B,S,D]
modernbert_layer x i pos_ids attn_mask = do
  xn <- (i == 0) ? x : layernorm@attn_norm x eps=EPS bias=false
  a <- scope@attn do
    qkv <- linear@Wqkv xn dim=3*D bias=false
    q, k, v <- chunk qkv parts=3
    q <- reshape_heads q heads=H
    k <- reshape_heads k heads=H
    v <- reshape_heads v heads=H
    full <- (FULL_EVERY <= 0) or ((i % FULL_EVERY) == 0)
    theta <- full ? THETA_FULL : THETA_LOCAL
    q, k <- rope_pair q k position_ids=pos_ids theta=theta
    mask <- if full then bidirectional_mask q k padding_mask=attn_mask else bidirectional_mask q k window=LOCAL_WIN padding_mask=attn_mask
    return attention q k v mask=mask causal=false eager=true |> merge_heads |> linear@Wo dim=D bias=false
  x <- x + a
  xn <- layernorm@mlp_norm x eps=EPS bias=false
  m <- scope@mlp do
    wi <- linear@Wi xn dim=2*FFN bias=false
    u, g <- chunk wi parts=2
    return gelu u |> mul g |> linear@Wo dim=D bias=false
  return x + m

modernbert :: TokenIds[B,S] -> ?Tensor[B,S] -> Tensor[B,S,V]
modernbert input_ids attn_mask = do
  pos_ids <- position_ids input_ids attn_mask
  x <- embedding@model.embeddings.tok_embeddings input_ids dim=D
  x <- layernorm@model.embeddings.norm x eps=EPS bias=false
  for@model.layers i <- [0..L) do
    x <- modernbert_layer x i pos_ids attn_mask
  x <- layernorm@model.final_norm x eps=EPS bias=false
  x <- linear@head.dense x dim=D bias=false |> gelu
  x <- layernorm@head.norm x eps=EPS bias=false
  logits <- linear@decoder x dim=V bias=true weight_path=@@model.embeddings.tok_embeddings.weight
  return logits
