{-# CHECKPOINTS ["answerdotai/ModernBERT-base"] #-}
{-# TASK "masked_lm" #-}

import Activations (gelu)
import Attention (attention, merge_heads, reshape_heads)
import Masking (bidirectional_mask)
import Math (mul)
import Positions (position_ids, rope_pair_base)



D          = Config.int@hidden_size default=768
V          = Config.int@vocab_size default=50368
L          = Config.int@num_hidden_layers default=22
H          = Config.int@num_attention_heads default=12
FFN        = Config.int@intermediate_size default=1152
EPS        = Config.float@norm_eps default=1e-05
FULL_EVERY = Config.int@global_attn_every_n_layers default=3
LOCAL_ATTN = Config.int@local_attention default=128
LOCAL_WIN  = Config.int@local_attention_window default=64
THETA_FULL = Config.float @'rope_parameters.full_attention.rope_theta' default=160000.0
THETA_LOCAL = Config.float @'rope_parameters.sliding_attention.rope_theta' default=10000.0

modernbert_layer :: Tensor[B,S,D] -> Int -> Tensor[B,S] -> ?Tensor[B,S] -> Tensor[B,S,D]
modernbert_layer x i pos_ids attn_mask = do
  xn <- (i == 0) ? x : NN.layernorm@attn_norm x eps=EPS bias=false
  a <- scope@attn do
    qkv <- NN.linear@Wqkv xn dim=3*D bias=false
    q, k, v <- Tensor.chunk qkv parts=3
    q <- reshape_heads q heads=H
    k <- reshape_heads k heads=H
    v <- reshape_heads v heads=H
    full <- (FULL_EVERY <= 0) or ((i % FULL_EVERY) == 0)
    theta <- full ? THETA_FULL : THETA_LOCAL
    q, k <- rope_pair_base q k pos_ids theta
    mask <- if full then bidirectional_mask q k padding_mask=attn_mask else bidirectional_mask q k window=LOCAL_WIN padding_mask=attn_mask
    return attention q k v mask |> merge_heads |> NN.linear@Wo dim=D bias=false
  x <- x + a
  xn <- NN.layernorm@mlp_norm x eps=EPS bias=false
  m <- scope@mlp do
    wi <- NN.linear@Wi xn dim=2*FFN bias=false
    u, g <- Tensor.chunk wi parts=2
    return gelu u |> mul g |> NN.linear@Wo dim=D bias=false
  return x + m

modernbert :: TokenIds[B,S] -> ?Tensor[B,S] -> Tensor[B,S,V]
modernbert input_ids attn_mask = do
  pos_ids <- position_ids input_ids attn_mask
  x <- NN.embedding@model.embeddings.tok_embeddings input_ids dim=D
  x <- NN.layernorm@model.embeddings.norm x eps=EPS bias=false
  x <- for@model.layers i <- [0..L) carry (x) do
    x <- modernbert_layer x i pos_ids attn_mask
    yield x
  x <- NN.layernorm@model.final_norm x eps=EPS bias=false
  x <- NN.linear@head.dense x dim=D bias=false |> gelu
  x <- NN.layernorm@head.norm x eps=EPS bias=false
  logits <- NN.linear@decoder x dim=V bias=true weight_path=@@model.embeddings.tok_embeddings.weight
  return logits
