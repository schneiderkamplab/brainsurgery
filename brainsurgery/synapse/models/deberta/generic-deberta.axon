{-# CHECKPOINTS ["microsoft/deberta-base"] #-}
{-# TASK "masked_lm" #-}

import Activations (gelu)
import Attention (attention, merge_heads)
import Math (clamp, sqrt)
import Masking (Mask, bidirectional_mask_for_input, mask_for_input)
import Params (param)
import Positions (position_ids)
import Config
import NN
import Tensor


MODEL_DIM <- Config.int @@hidden_size default=768
VOCAB_SIZE <- Config.int @@vocab_size default=50265
NUM_LAYERS <- Config.int @@num_hidden_layers default=12
NUM_HEADS <- Config.int @@num_attention_heads default=12
FFN <- Config.int @@intermediate_size default=3072
EPS <- Config.float @@layer_norm_eps default=1e-7
MAX_POS <- Config.int @@max_position_embeddings default=512
MAX_REL_CONFIG <- Config.int @@max_relative_positions default=-1
MAX_REL <- (MAX_REL_CONFIG < 1) ? MAX_POS : MAX_REL_CONFIG
POSITION_BIASED_INPUT <- Config.bool @@position_biased_input default=true
TYPE_VOCAB_SIZE <- Config.int @@type_vocab_size default=0

deberta_relative_bias :: Path -> Tensor[B,H,S,HD] -> Tensor[B,H,S,HD] -> Tensor[2 * MAX_REL,D] -> Tensor[B,H,S,S]
deberta_relative_bias@path q k rel_embeddings = do
  att_span <- (S < MAX_REL) ? S : MAX_REL
  rel <- Tensor.slice rel_embeddings dim=0 start=(MAX_REL - att_span) end=(MAX_REL + att_span)
  pos_k <- NN.linear@pos_proj rel dim=MODEL_DIM bias=false
  pos_q <- NN.linear@pos_q_proj rel dim=MODEL_DIM bias=true
  pos_k <- Tensor.reshape pos_k shape=[2 * att_span, NUM_HEADS, HD] |> Tensor.permute dims=[1, 0, 2]
  pos_q <- Tensor.reshape pos_q shape=[2 * att_span, NUM_HEADS, HD] |> Tensor.permute dims=[1, 0, 2]
  pos_k <- Tensor.unsqueeze pos_k dim=0 |> Tensor.expand shape=[B, NUM_HEADS, 2 * att_span, HD]
  pos_q <- Tensor.unsqueeze pos_q dim=0 |> Tensor.expand shape=[B, NUM_HEADS, 2 * att_span, HD]
  row_ids <- Tensor.arange q start=0 end=S |> Tensor.reshape shape=[S, 1] |> Tensor.expand shape=[S, S]
  col_ids <- Tensor.arange k start=0 end=S |> Tensor.reshape shape=[1, S] |> Tensor.expand shape=[S, S]
  rel_pos <- row_ids - col_ids
  c2p_idx <- clamp (rel_pos + att_span) min=0 max=((2 * att_span) - 1)
  c2p_idx <- Tensor.unsqueeze c2p_idx dim=0 |> Tensor.unsqueeze dim=0 |> Tensor.expand shape=[B, NUM_HEADS, S, S]
  c2p <- Tensor.matmul q (Tensor.transpose pos_k dim1=2 dim2=3) |> Tensor.gather c2p_idx dim=-1
  p2c_idx <- clamp ((0 - rel_pos) + att_span) min=0 max=((2 * att_span) - 1)
  p2c_idx <- Tensor.unsqueeze p2c_idx dim=0 |> Tensor.unsqueeze dim=0 |> Tensor.expand shape=[B, NUM_HEADS, S, S]
  p2c <- Tensor.matmul k (Tensor.transpose pos_q dim1=2 dim2=3) |> Tensor.gather p2c_idx dim=-1 |> Tensor.transpose dim1=2 dim2=3
  return (c2p + p2c) / sqrt (HD * 3)

deberta_block :: Tensor[B,S,D] -> Tensor[B,1,S,S] -> Tensor[B,S,D]
deberta_block x keep = do
  a <- scope@attention do
    qkv <- NN.linear@self.in_proj x dim=(3 * MODEL_DIM) bias=false
    qkv <- Tensor.reshape qkv shape=[B, S, NUM_HEADS, 3 * (MODEL_DIM / NUM_HEADS)] |> Tensor.permute dims=[0, 2, 1, 3]
    q, k, v <- Tensor.chunk qkv dim=-1 parts=3
    q_bias <- ((param @self.q_bias) :: Tensor[MODEL_DIM]) |> Tensor.reshape shape=[1, NUM_HEADS, 1, MODEL_DIM / NUM_HEADS]
    v_bias <- ((param @self.v_bias) :: Tensor[MODEL_DIM]) |> Tensor.reshape shape=[1, NUM_HEADS, 1, MODEL_DIM / NUM_HEADS]
    q <- q + q_bias
    v <- v + v_bias
    rel_embeddings <- ((param @@deberta.encoder.rel_embeddings.weight) :: Tensor[2 * MAX_REL,MODEL_DIM])
    rel_bias <- deberta_relative_bias@self q k rel_embeddings
    return attention q k v keep rel_bias=rel_bias scale=(1.0 / sqrt ((MODEL_DIM / NUM_HEADS) * 3)) |> merge_heads |> NN.linear@output.dense dim=MODEL_DIM bias=true
  x <- x + a
  x <- NN.layernorm@attention.output.LayerNorm x eps=EPS
  m <- NN.linear@intermediate.dense x dim=FFN bias=true |> gelu
  m <- NN.linear@output.dense m dim=MODEL_DIM bias=true
  y <- x + m
  return NN.layernorm@output.LayerNorm y eps=EPS

deberta :: TokenIds[B,S] -> ?Mask[B,S,S] -> Tensor[B,S,VOCAB_SIZE]
deberta input_ids attn_mask = do
  attn_mask <- mask_for_input input_ids attn_mask S
  pos_ids <- position_ids input_ids
  keep <- bidirectional_mask_for_input input_ids S padding_mask=attn_mask
  tok_type_ids <- input_ids - input_ids
  tok <- NN.embedding@deberta.embeddings.word_embeddings input_ids dim=MODEL_DIM
  pos <- POSITION_BIASED_INPUT ? NN.embedding@deberta.embeddings.position_embeddings pos_ids dim=MODEL_DIM : Tensor.zeros_like tok
  typ <- (TYPE_VOCAB_SIZE > 0) ? NN.embedding@deberta.embeddings.token_type_embeddings tok_type_ids dim=MODEL_DIM : Tensor.zeros_like tok
  x <- tok + pos
  x <- x + typ
  x <- NN.layernorm@deberta.embeddings.LayerNorm x eps=EPS
  embedding_mask <- Tensor.cast_like (Tensor.reshape attn_mask shape=[B, S, 1]) x
  x <- x * embedding_mask
  x <- for@deberta.encoder.layer i <- [0..NUM_LAYERS) carry (x) do
    x <- deberta_block x keep
    yield x
  logits <- scope@lm_predictions.lm_head do
    x <- NN.linear@dense x dim=MODEL_DIM bias=true |> gelu
    x <- NN.layernorm@LayerNorm x eps=EPS
    return NN.linear@decoder x dim=VOCAB_SIZE bias=true weight_path=@@deberta.embeddings.word_embeddings.weight bias_path=@@lm_predictions.lm_head.bias
  return logits
