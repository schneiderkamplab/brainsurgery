{-# CHECKPOINTS "allenai/longformer-base-4096" #-}

{-# TASK "masked_lm" #-}

{-# MAIN "longformer" #-}

import Activations (gelu)

import Attention (attention, merge_heads, reshape_heads)

import Masking (bidirectional_mask)

import Positions (position_ids)

import Config

import NN

MODEL_DIM = 768

VOCAB_SIZE = 50265

NUM_LAYERS = 12

NUM_HEADS = 12

FFN = 3072

EPS = 1e-05

PAD = 1

WIN = 256

longformer_block :: Tensor[B,S,D] -> ?Tensor[B,S] -> Tensor[B,S,D]
longformer_block x attn_mask = do
  a <- scope@attention do
    q <- NN.linear@self.query x dim=MODEL_DIM bias=true |> reshape_heads heads=NUM_HEADS
    k <- NN.linear@self.key x dim=MODEL_DIM bias=true |> reshape_heads heads=NUM_HEADS
    v <- NN.linear@self.value x dim=MODEL_DIM bias=true |> reshape_heads heads=NUM_HEADS
    mask <- bidirectional_mask q k window=WIN padding_mask=attn_mask
    return attention q k v mask |> merge_heads |> NN.linear@output.dense dim=MODEL_DIM bias=true
  x <- x + a
  x <- NN.layernorm@attention.output.LayerNorm x eps=EPS
  m <- NN.linear@intermediate.dense x dim=FFN bias=true |> gelu
  m <- NN.linear@output.dense m dim=MODEL_DIM bias=true
  y <- x + m
  y <- NN.layernorm@output.LayerNorm y eps=EPS
  return y

longformer :: TokenIds[B,S] -> ?Tensor[B,S] -> Tensor[B,S,V]
longformer input_ids attn_mask = do
  pos_base <- position_ids input_ids attn_mask=attn_mask pad_fill=-1
  pos_shift <- PAD + 1
  pos_ids <- pos_base + pos_shift
  tok_type_ids <- input_ids - input_ids
  tok <- NN.embedding@longformer.embeddings.word_embeddings input_ids dim=MODEL_DIM
  pos <- NN.embedding@longformer.embeddings.position_embeddings pos_ids dim=MODEL_DIM
  typ <- NN.embedding@longformer.embeddings.token_type_embeddings tok_type_ids dim=MODEL_DIM
  x <- tok + pos
  x <- x + typ
  x <- NN.layernorm@longformer.embeddings.LayerNorm x eps=EPS
  x <- for@longformer.encoder.layer i <- [0..NUM_LAYERS) carry (x) do
    x <- longformer_block x attn_mask
    yield x
  logits <- scope@lm_head do
    x <- NN.linear@dense x dim=MODEL_DIM bias=true |> gelu
    x <- NN.layernorm@layer_norm x eps=EPS
    return NN.linear@decoder x dim=VOCAB_SIZE bias=true weight_path=@@longformer.embeddings.word_embeddings.weight bias_path=@@lm_head.bias
  return logits
