{-# CHECKPOINTS "test/Llama4-Test" #-}

{-# TASK "causal_lm" #-}

{-# MAIN "llama4" #-}

import Activations (silu)

import Attention (attention, merge_heads, reshape_heads)

import Masking (Mask, causal_mask_for_input, mask_for_input, mask_length_for_input)

import Math (floor, log, mul, sqrt)

import MoE (grouped_swiglu_ffn_basic, sigmoid_topk_router)

import Positions (position_ids, rope_apply_base, rope_apply_freq_scale)

import Cache

import Config

import NN

import Tensor

CFG = "text_config"

MODEL_DIM = 128

VOCAB_SIZE = 201135

NUM_LAYERS = 4

NUM_HEADS = 4

KVH = 2

MODEL_HEAD_DIM = 32

KVD = KVH * MODEL_HEAD_DIM

FFN = 256

FFN_SHARED = 16384

E = 4

EPT = 2

EPS = 1e-05

THETA = 500000.0

MAX_POSITIONS = 1024

ROPE_SCALE = 16.0

ROPE_LOW_FREQ = 1.0

ROPE_HIGH_FREQ = 1.0

ROPE_CONTEXT = 256

HAS_LLAMA3_FREQ_SPLIT = ROPE_HIGH_FREQ >= ROPE_LOW_FREQ

NO_ROPE_INTERVAL = 4

ATTN_CHUNK = 8192

USE_QK_NORM = true

USE_TEMP_TUNING = true

FLOOR_SCALE = 8192.0

ATTN_TEMP_SCALE = 0.1

ATTN_SCALE = 1.0 / sqrt MODEL_HEAD_DIM

llama4_norm :: Path -> Tensor[B,S,D] -> Tensor[B,S,D]
llama4_norm@path x = NN.rmsnorm@path x eps=EPS

llama4_temp_scale :: Tensor[B,S] -> Tensor[B,1,S,1]
llama4_temp_scale pos_ids = do
  shifted <- pos_ids + 1.0
  scaled <- shifted / FLOOR_SCALE
  bucket <- floor scaled
  logged <- log (bucket + 1.0)
  gain <- (logged * ATTN_TEMP_SCALE) + 1.0
  gain3 <- Tensor.unsqueeze gain dim=1
  gain4 <- Tensor.unsqueeze gain3 dim=3
  return gain4

llama4_apply_temp_scale :: Tensor[B,H,S,D] -> Tensor[B,S] -> Tensor[B,H,S,D]
llama4_apply_temp_scale q pos_ids = q * (llama4_temp_scale pos_ids)

llama4_moe :: Tensor[B,S,D] -> Tensor[B,S,D]
llama4_moe x = do
  shared <- scope@shared_expert do
    gate <- NN.linear@gate_proj x dim=FFN_SHARED bias=false
    up <- NN.linear@up_proj x dim=FFN_SHARED bias=false
    return gate |> silu |> mul up |> NN.linear@down_proj dim=MODEL_DIM bias=false
  topk_weights, topk_indices <- sigmoid_topk_router@router x top_k=EPT
  routed <- grouped_swiglu_ffn_basic x topk_weights topk_indices E transpose=true pre_scale_input=true
  return shared + routed

llama4_rope :: Tensor[B,H,S,HD] -> Tensor[B,S] -> Tensor[B,H,S,HD]
llama4_rope x pos_ids = HAS_LLAMA3_FREQ_SPLIT ? (rope_apply_freq_scale x pos_ids THETA ROPE_SCALE ROPE_LOW_FREQ ROPE_HIGH_FREQ ROPE_CONTEXT interleaved=true) : (rope_apply_base x pos_ids theta=THETA scale_factor=ROPE_SCALE interleaved=true)

llama4_block :: Tensor[B,S,D] -> Int -> Tensor[B,S] -> Tensor[B,1,S,K] -> Tensor[B,1,S,K] -> ?CacheLayer[B,KVH,P,MAX_POSITIONS,DH] -> (Tensor[B,S,D], ?CacheLayer[B,KVH,K,MAX_POSITIONS,DH])
llama4_block x i pos_ids mask_rope mask_no_rope past_kv = do
  use_rope <- ((i + 1) % NO_ROPE_INTERVAL) != 0
  xn <- llama4_norm@input_layernorm x
  a, new_kv <- scope@self_attn do
    q <- NN.linear@q_proj xn dim=MODEL_DIM bias=false |> reshape_heads heads=NUM_HEADS
    k <- NN.linear@k_proj xn dim=KVD bias=false |> reshape_heads heads=KVH
    v <- NN.linear@v_proj xn dim=KVD bias=false |> reshape_heads heads=KVH
    q <- use_rope ? (llama4_rope q pos_ids) : q
    k <- use_rope ? (llama4_rope k pos_ids) : k
    q <- (USE_QK_NORM and use_rope) ? (NN.l2norm q eps=EPS) : q
    k <- (USE_QK_NORM and use_rope) ? (NN.l2norm k eps=EPS) : k
    q <- ((USE_TEMP_TUNING and (use_rope == false)) ? (llama4_apply_temp_scale q pos_ids) : q)
    k, v, new_kv <- Cache.update past_kv k v
    k <- Tensor.repeat k repeats=(NUM_HEADS / KVH)
    v <- Tensor.repeat v repeats=(NUM_HEADS / KVH)
    mask <- use_rope ? mask_rope : mask_no_rope
    a <- attention q k v mask scale=ATTN_SCALE |> merge_heads |> NN.linear@o_proj dim=MODEL_DIM bias=false
    return a, new_kv
  x <- x + a
  xn <- llama4_norm@post_attention_layernorm x
  m <- scope@feed_forward do
    return llama4_moe xn
  return x + m, new_kv

llama4 :: TokenIds[B,S] -> ?Mask[B,K,MAX_POSITIONS] -> ?Cache[B,KVH,P,MAX_POSITIONS,DH] -> ?Bool -> (Tensor[B,S,V], ?Cache[B,KVH,K,MAX_POSITIONS,DH])
llama4 input_ids attn_mask past_kv use_cache = do
  past_length <- Cache.past_length past_kv
  attn_mask <- mask_for_input input_ids attn_mask MAX_POSITIONS
  pos_ids <- position_ids input_ids attn_mask=attn_mask past_length=past_length
  key_len <- mask_length_for_input input_ids attn_mask past_length
  mask_rope <- causal_mask_for_input input_ids key_len padding_mask=attn_mask window=ATTN_CHUNK
  mask_no_rope <- causal_mask_for_input input_ids key_len padding_mask=attn_mask
  work_kv <- Cache.prepare past_kv use_cache MAX_POSITIONS
  read_kv <- Cache.read past_kv work_kv
  x, new_kv <- scope@language_model.model do
    x <- NN.embedding@embed_tokens input_ids dim=MODEL_DIM
    x, work_kv <- for@layers i <- [0..NUM_LAYERS) carry (x, work_kv) do
      past_i <- Cache.index read_kv i
      x, new_i <- llama4_block x i pos_ids mask_rope mask_no_rope past_i
      work_kv <- Cache.append work_kv new_i
      yield x, work_kv
    x <- llama4_norm@norm x
    return x, work_kv
  new_length <- past_length + S
  new_kv <- Cache.finish new_kv new_length
  new_kv <- use_cache ? new_kv : null
  logits <- NN.linear@language_model.lm_head x dim=VOCAB_SIZE bias=false
  return logits, new_kv
