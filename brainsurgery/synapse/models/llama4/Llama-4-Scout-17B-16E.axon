{-# CHECKPOINTS ["meta-llama/Llama-4-Scout-17B-16E", "meta-llama/Llama-4-Scout-17B-16E-Instruct"] #-}
{-# TASK "causal_lm" #-}

import Activations
import Activations (silu)
import Cache
import Cache
import MoE
import Attention (reshape_heads, merge_heads)
import Compat (attention)
import Masking (causal_mask)
import Positions (position_ids, rope_pair_base, rope_pair_freq_scale)
import Math (floor, log, mul)

D = 5120
V = 202048
L = 48
H = 40
KVH = 8
KVD = 1024
FFN_SHARED = 16384
E = 16
EPT = 1
EPS = 1e-05
THETA = 500000.0
ROPE_SCALE = 16.0
ROPE_LOW_FREQ = 1.0
ROPE_HIGH_FREQ = 1.0
ROPE_CONTEXT = 8192
HAS_LLAMA3_FREQ_SPLIT = true
NO_ROPE_INTERVAL = 4
ATTN_CHUNK = 8192
USE_QK_NORM = true
USE_TEMP_TUNING = true
FLOOR_SCALE = 8192.0
ATTN_TEMP_SCALE = 0.1
ATTN_SCALE = 0.08838834764831843

llama4_norm :: @Path -> Tensor[B,S,D] -> Tensor[B,S,D]
llama4_norm@path x = NN.rmsnorm@path x eps=EPS

llama4_temp_scale :: Tensor[B,S] -> Tensor[B,1,S,1]
llama4_temp_scale pos_ids = do
  shifted <- pos_ids + 1.0
  scaled <- shifted / FLOOR_SCALE
  bucket <- Math.floor scaled
  logged <- Math.log (bucket + 1.0)
  gain <- (logged * ATTN_TEMP_SCALE) + 1.0
  gain3 <- Tensor.unsqueeze gain dim=1
  gain4 <- Tensor.unsqueeze gain3 dim=3
  return gain4

llama4_moe :: Tensor[B,S,D] -> Tensor[B,S,D]
llama4_moe x = do
  shared <- scope@shared_expert do
    gate <- NN.linear@gate_proj x dim=FFN_SHARED bias=false
    up <- NN.linear@up_proj x dim=FFN_SHARED bias=false
    return gate |> silu |> mul up |> NN.linear@down_proj dim=D bias=false
  topk_weights, topk_indices <- MoE.sigmoid_topk_router@router x top_k=EPT
  routed <- MoE.grouped_swiglu_ffn_basic x topk_weights topk_indices E transpose=true pre_scale_input=true
  return shared + routed

llama4_block :: Tensor[B,S,D] -> Int -> Tensor[B,S] -> ?Tensor[B,S] -> ?CacheLayer -> (Tensor[B,S,D], ?CacheLayer)
llama4_block x i pos_ids attn_mask past_kv = do
  use_rope <- ((i + 1) % NO_ROPE_INTERVAL) != 0
  xn <- llama4_norm@input_layernorm x
  a, new_kv <- scope@self_attn do
    q <- NN.linear@q_proj xn dim=D bias=false |> reshape_heads heads=H
    k <- NN.linear@k_proj xn dim=KVD bias=false |> reshape_heads heads=KVH
    v <- NN.linear@v_proj xn dim=KVD bias=false |> reshape_heads heads=KVH
    q, k <- use_rope ? (HAS_LLAMA3_FREQ_SPLIT ? (rope_pair_freq_scale q k pos_ids THETA ROPE_SCALE ROPE_LOW_FREQ ROPE_HIGH_FREQ ROPE_CONTEXT interleaved=true) : (rope_pair_base q k pos_ids theta=THETA scale_factor=ROPE_SCALE interleaved=true)) : (q, k)
    q <- (USE_QK_NORM and use_rope) ? (NN.l2norm q eps=EPS) : q
    k <- (USE_QK_NORM and use_rope) ? (NN.l2norm k eps=EPS) : k
    q <- ((USE_TEMP_TUNING and (use_rope == false)) ? (q * (llama4_temp_scale pos_ids)) : q)
    k, v, new_kv <- Cache.update past_kv k v
    k <- Tensor.repeat k repeats=(H / KVH)
    v <- Tensor.repeat v repeats=(H / KVH)
    mask <- use_rope ? (causal_mask q k window=ATTN_CHUNK padding_mask=attn_mask) : (causal_mask q k padding_mask=attn_mask)
    a <- attention q k v mask=mask scale=ATTN_SCALE eager=true |> merge_heads |> NN.linear@o_proj dim=D bias=false
    return a, new_kv
  x <- x + a
  xn <- llama4_norm@post_attention_layernorm x
  m <- scope@feed_forward do
    return llama4_moe xn
  return x + m, new_kv

llama4 :: TokenIds[B,S] -> ?Tensor[B,S] -> ?Cache -> ?Bool -> (Tensor[B,S,V], ?Cache)
llama4 input_ids attn_mask past_kv use_cache = do
  pos_ids <- position_ids input_ids attn_mask=attn_mask past_length=(Cache.past_length past_kv)
  x, new_kv <- scope@language_model.model do
    x <- NN.embedding@embed_tokens input_ids dim=D
    new_kv <- use_cache ? Cache.init : null
    for@layers i <- [0..L) do
      past_i <- Cache.index past_kv i
      x, new_i <- llama4_block x i pos_ids attn_mask past_i
      new_kv <- Cache.append new_kv new_i
    x <- llama4_norm@norm x
    return x, new_kv
  logits <- NN.linear@language_model.lm_head x dim=V bias=false
  return logits, new_kv
