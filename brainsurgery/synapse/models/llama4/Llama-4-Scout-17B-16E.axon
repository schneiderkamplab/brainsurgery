{-# CHECKPOINTS ["meta-llama/Llama-4-Scout-17B-16E", "meta-llama/Llama-4-Scout-17B-16E-Instruct"] #-}
{-# TASK "causal_lm" #-}

import Activations
import Activations (silu)
import Attention
import Attention (attention, merge_heads, reshape_heads)
import Masking
import Masking (causal_mask)
import Math
import Math (floor, log, mul)
import MoE
import MoE (grouped_swiglu_ffn_basic, sigmoid_topk_router)
import Positions
import Positions (position_ids, rope_pair_freq_scale)
import Cache
import NN
import Tensor

llama4_norm :: Path -> Tensor[B,S,D] -> Tensor[B,S,D]
llama4_norm@path x = NN.rmsnorm@path x eps=1e-05

llama4_temp_scale :: Tensor[B,S] -> Tensor[B,1,S,1]
llama4_temp_scale pos_ids = do
  shifted <- pos_ids + 1.0
  scaled <- shifted / 8192.0
  bucket <- floor scaled
  logged <- log (bucket + 1.0)
  gain <- (logged * 0.1) + 1.0
  gain3 <- Tensor.unsqueeze gain dim=1
  gain4 <- Tensor.unsqueeze gain3 dim=3
  return gain4

llama4_moe :: Tensor[B,S,D] -> Tensor[B,S,D]
llama4_moe x = do
  shared <- scope@shared_expert do
    gate <- NN.linear@gate_proj x dim=16384 bias=false
    up <- NN.linear@up_proj x dim=16384 bias=false
    return gate |> silu |> mul up |> NN.linear@down_proj dim=5120 bias=false
  topk_weights, topk_indices <- sigmoid_topk_router@router x top_k=1
  routed <- grouped_swiglu_ffn_basic x topk_weights topk_indices 16 transpose=true pre_scale_input=true
  return shared + routed

llama4_block :: Tensor[B,S,D] -> Int -> Tensor[B,S] -> ?Tensor[B,S] -> ?CacheLayer -> (Tensor[B,S,D], ?CacheLayer)
llama4_block x i pos_ids attn_mask past_kv = do
  use_rope <- ((i + 1) % 4) != 0
  xn <- llama4_norm@input_layernorm x
  a, new_kv <- scope@self_attn do
    q <- NN.linear@q_proj xn dim=5120 bias=false |> reshape_heads heads=40
    k <- NN.linear@k_proj xn dim=1024 bias=false |> reshape_heads heads=8
    v <- NN.linear@v_proj xn dim=1024 bias=false |> reshape_heads heads=8
    q, k <- use_rope ? ((rope_pair_freq_scale q k pos_ids 500000.0 16.0 1.0 1.0 8192 interleaved=true)) : (q, k)
    q <- (true and use_rope) ? (NN.l2norm q eps=1e-05) : q
    k <- (true and use_rope) ? (NN.l2norm k eps=1e-05) : k
    q <- ((true and (use_rope == false)) ? (q * (llama4_temp_scale pos_ids)) : q)
    k, v, new_kv <- Cache.update past_kv k v
    k <- Tensor.repeat k repeats=5
    v <- Tensor.repeat v repeats=5
    mask <- use_rope ? (causal_mask q k window=8192 padding_mask=attn_mask) : (causal_mask q k padding_mask=attn_mask)
    a <- attention q k v mask scale=0.08838834764831843 |> merge_heads |> NN.linear@o_proj dim=5120 bias=false
    return a, new_kv
  x <- x + a
  xn <- llama4_norm@post_attention_layernorm x
  m <- scope@feed_forward do
    return llama4_moe xn
  return x + m, new_kv

llama4 :: TokenIds[B,S] -> ?Tensor[B,S] -> ?Cache -> ?Bool -> (Tensor[B,S,V], ?Cache)
llama4 input_ids attn_mask past_kv use_cache = do
  pos_ids <- position_ids input_ids attn_mask=attn_mask past_length=(Cache.past_length past_kv)
  x, new_kv <- scope@language_model.model do
    x <- NN.embedding@embed_tokens input_ids dim=5120
    new_kv <- use_cache ? Cache.init : null
    for@layers i <- [0..48) do
      past_i <- Cache.index past_kv i
      x, new_i <- llama4_block x i pos_ids attn_mask past_i
      new_kv <- Cache.append new_kv new_i
      yield x, new_kv
    x <- llama4_norm@norm x
    return x, new_kv
  logits <- NN.linear@language_model.lm_head x dim=202048 bias=false
  return logits, new_kv
