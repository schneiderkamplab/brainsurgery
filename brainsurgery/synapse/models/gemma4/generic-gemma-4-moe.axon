{-# CHECKPOINTS ["google/gemma-4-26B-A4B", "google/gemma-4-26B-A4B-it"] #-}

import Activations (gelu_pytorch_tanh, tanh)
import Attention (attention_scaled, merge_heads, reshape_heads)
import Masking (causal_mask)
import Math (mul, sqrt)
import MoE (scatter_add, select, softmax_topk_router)
import Params (has_root, param_scale)
import Positions (position_ids, rope_pair_proportional)
import Cache (CacheAny, CacheLayer)
import Config
import NN
import Tensor



CFG = "text_config"
PARAM_ROOT = (has_root "model.language_model") ? "model" : ""

MODEL_DIM = Config.int @@'{CFG}.hidden_size' default=5376
VOCAB_SIZE = Config.int @@'{CFG}.vocab_size' default=262144
NUM_LAYERS = Config.int @@'{CFG}.num_hidden_layers' default=60
NUM_HEADS = Config.int @@'{CFG}.num_attention_heads' default=32
KVH = Config.int @@'{CFG}.num_key_value_heads' default=16
GKVH = Config.int @@'{CFG}.num_global_key_value_heads' default=KVH
MODEL_HEAD_DIM = Config.int @@'{CFG}.head_dim' default=256
GHD = Config.int @@'{CFG}.global_head_dim' default=MODEL_HEAD_DIM
FFN = Config.int @@'{CFG}.intermediate_size' default=21504
MOE_FFN = Config.int @@'{CFG}.moe_intermediate_size' default=1408
PLI = Config.int @@'{CFG}.hidden_size_per_layer_input' default=0
WIN_LOCAL = Config.int @@'{CFG}.sliding_window' default=1024
WIN_FULL = Config.int @@'{CFG}.max_position_embeddings' default=262144
EPS = Config.float @@'{CFG}.rms_norm_eps' default=1e-06
THETA_LOCAL = Config.float @@'{CFG}.rope_parameters.sliding_attention.rope_theta' default=10000.0
THETA_FULL = Config.float @@'{CFG}.rope_parameters.full_attention.rope_theta' default=1000000.0
ROPE_SCALE_FULL = Config.float @@'{CFG}.rope_parameters.full_attention.factor' default=1.0
ROTARY_PARTIAL_FULL = Config.float @@'{CFG}.rope_parameters.full_attention.partial_rotary_factor' default=0.25
ROPE_PERIOD = Config.int @@'{CFG}.sliding_window_pattern' default=(USE_DOUBLE_WIDE_MLP ? 5 : 6)
ATTN_K_EQ_V = Config.bool @@'{CFG}.attention_k_eq_v' default=false
LOGIT_SOFTCAP = Config.float @@'{CFG}.final_logit_softcapping' default=30.0
HAS_PLI = PLI > 0
PER_LAYER_INPUT_SCALE = 0.7071067811865476
NUM_KV_SHARED = Config.int @@'{CFG}.num_kv_shared_layers' default=0
USE_DOUBLE_WIDE_MLP = Config.bool @@'{CFG}.use_double_wide_mlp' default=false
TOPK_EXPERTS = Config.int @@'{CFG}.top_k_experts' default=8
NUM_EXPERTS = Config.int @@'{CFG}.num_experts' default=128

rms :: Path -> Tensor[B,S,D] -> Tensor[B,S,D]
rms@path x = NN.rmsnorm@path x cast_float=true

gemma4_router :: Tensor[B,S,D] -> Int -> ?Float -> ?Float -> (Tensor[B,S,top_k], IdxTensor[B,S,top_k])
gemma4_router x top_k ?scalar_root_size=null ?rms_eps=null = do
  scalar <- (scalar_root_size == null) ? 1.0 : scalar_root_size
  eps <- (rms_eps == null) ? 1e-6 : rms_eps
  topk_weights, topk_indices <- scope@router do
    h <- NN.l2norm x eps=eps
    h <- h * (Params.param path=@scale) * scalar
    w, i <- softmax_topk_router@proj h top_k routed_scaling_factor=1.0 weight=@weight
    per_expert_scale <- Params.param path=@per_expert_scale
    b <- Tensor.size i 0
    s <- Tensor.size i 1
    e <- Tensor.size per_expert_scale 0
    per_expert_scale <- Tensor.reshape per_expert_scale shape=[1, 1, e] |> Tensor.expand shape=[b, s, e]
    w <- w * (Tensor.gather per_expert_scale i -1 |> Tensor.cast_like w)
    return w, i
  return topk_weights, topk_indices

gemma4_moe_experts :: Tensor[B,S,D] -> Tensor[B,S,K] -> Tensor[B,S,K] -> Int -> Tensor[B,S,D]
gemma4_moe_experts hidden topk_weights topk_indices num_experts = do
  routed <- Tensor.zeros_like hidden
  routed <- for e <- [0..num_experts) carry (routed) do
    x_sel, token_idx, topk_pos, sel_scores <- select hidden topk_weights topk_indices e
    gate_up <- NN.linear@experts x_sel dim=(2 * MOE_FFN) expert=e weight_path=@experts.gate_up_proj
    gate, up <- Tensor.chunk gate_up parts=2
    x_upd <- gate |> gelu_pytorch_tanh |> mul up |> NN.linear@experts dim=MODEL_DIM expert=e weight_path=@experts.down_proj
    routed <- scatter_add routed token_idx x_upd sel_scores
    yield routed
  return routed

gemma4_kv_shared :: Tensor[B,S,D] -> Dim -> Dim -> Dim -> (Tensor[B,kv_heads,S,hd], Tensor[B,kv_heads,S,hd])
gemma4_kv_shared xn kv_dim kv_heads hd = do
  kv <- NN.linear@k_proj xn dim=kv_dim bias=false |> reshape_heads heads=kv_heads
  k <- NN.rmsnorm@k_norm kv dim=hd cast_float=true
  v <- NN.rmsnorm_noscale kv dim=hd cast_float=true
  return k, v

gemma4_kv_separate :: Tensor[B,S,D] -> Dim -> Dim -> Dim -> (Tensor[B,kv_heads,S,hd], Tensor[B,kv_heads,S,hd])
gemma4_kv_separate xn kv_dim kv_heads hd = do
  k <- NN.linear@k_proj xn dim=kv_dim bias=false |>
    reshape_heads heads=kv_heads |>
    NN.rmsnorm@k_norm dim=hd cast_float=true
  v <- NN.linear@v_proj xn dim=kv_dim bias=false |>
    reshape_heads heads=kv_heads |>
    NN.rmsnorm_noscale dim=hd cast_float=true
  return k, v

gemma4_moe_block :: Tensor[B,S,D] -> Int -> Tensor[B,S] -> ?Tensor[B,K] -> ?(Any, Any) -> (Tensor[B,S,D], ?(Any, Any))
gemma4_moe_block x i pos_ids attn_mask past_kv = do
  full <- ((i + 1) % ROPE_PERIOD) == 0
  use_global_kv <- full and ATTN_K_EQ_V
  kv_heads <- use_global_kv ? GKVH : KVH
  hd <- full ? GHD : MODEL_HEAD_DIM
  q_dim <- NUM_HEADS * hd
  kv_dim <- kv_heads * hd
  theta <- full ? THETA_FULL : THETA_LOCAL
  window <- full ? WIN_FULL : WIN_LOCAL

  xn <- rms@input_layernorm x
  a, new_kv <- scope@self_attn do
    q <- NN.linear@q_proj xn dim=q_dim bias=false |>
      reshape_heads heads=NUM_HEADS |>
      NN.rmsnorm@q_norm dim=hd cast_float=true
    k, v <- if use_global_kv then gemma4_kv_shared xn kv_dim kv_heads hd else gemma4_kv_separate xn kv_dim kv_heads hd
    q, k <- rope_pair_proportional q k pos_ids theta=theta scale_factor=(full ? ROPE_SCALE_FULL : 1.0) partial_rotary_factor=(full ? ROTARY_PARTIAL_FULL : 1.0)
    k, v, new_kv <- Cache.update (past_kv :: ?CacheLayer[B,kv_heads,P,hd]) k v
    k <- Tensor.repeat k repeats=(NUM_HEADS / kv_heads)
    v <- Tensor.repeat v repeats=(NUM_HEADS / kv_heads)
    mask <- causal_mask q k window=window padding_mask=attn_mask early_exit=full
    a <- attention_scaled q k v mask 1.0 |> merge_heads |> NN.linear@o_proj dim=MODEL_DIM bias=false
    return a, new_kv

  a <- rms@post_attention_layernorm a
  x <- x + a
  xn <- rms@pre_feedforward_layernorm x
  m <- scope@mlp do
    g <- NN.linear@gate_proj xn dim=FFN bias=false
    u <- NN.linear@up_proj xn dim=FFN bias=false
    return gelu_pytorch_tanh g |> mul u |> NN.linear@down_proj dim=MODEL_DIM bias=false
  h1 <- rms@post_feedforward_layernorm_1 m
  topk_weights, topk_indices <- gemma4_router x top_k=TOPK_EXPERTS scalar_root_size=(1.0 / sqrt MODEL_DIM) rms_eps=EPS
  xn2 <- rms@pre_feedforward_layernorm_2 x
  h2 <- gemma4_moe_experts xn2 topk_weights topk_indices NUM_EXPERTS
  h2 <- rms@post_feedforward_layernorm_2 h2
  h <- h1 + h2
  h <- rms@post_feedforward_layernorm h
  x <- x + h
  x <- param_scale x
  return x, new_kv

gemma4_moe :: Tensor.TokenIds[B,S] -> ?Tensor[B,K] -> ?CacheAny -> ?Bool -> (Tensor[B,S,V], ?CacheAny)
gemma4_moe input_ids attn_mask past_kv use_cache = do
  pos_ids <- position_ids input_ids attn_mask=attn_mask past_length=(Cache.past_length_any past_kv)
  logits, new_kv <- scope@model.language_model do
    emb_scale <- _sqrt (Config.float @@'{CFG}.hidden_size' default=5376.0)
    x <- NN.embedding@embed_tokens input_ids dim=MODEL_DIM scale=emb_scale
    new_kv <- use_cache ? Cache.init_any : null
    x, new_kv <- for@layers i <- [0..NUM_LAYERS) carry (x, new_kv) do
      past_i <- Cache.index_any past_kv i
      x, new_i <- gemma4_moe_block x i pos_ids attn_mask past_i
      new_kv <- Cache.append_any new_kv new_i
      yield x, new_kv
    logits <- rms@norm x |> NN.linear@embed_tokens
    logits <- logits / LOGIT_SOFTCAP
    logits <- tanh logits
    logits <- logits * LOGIT_SOFTCAP
    return logits, new_kv
  return logits, new_kv
