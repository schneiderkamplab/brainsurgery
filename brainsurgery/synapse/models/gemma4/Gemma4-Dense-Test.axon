{-# CHECKPOINTS "test/Gemma4-Dense-Test" #-}

{-# MAIN "gemma4_dense" #-}

import Activations (gelu_pytorch_tanh, tanh)

import Attention (attention_scaled, merge_heads, reshape_heads)

import Masking (causal_mask_for_input)

import Math (mul, sqrt)

import Params (has_root, param_scale)

import Positions (position_ids, rope_pair_proportional_factors, rope_proportional_factors)

import Cache (CacheAny, CacheLayer)

import Config

import NN

import Tensor

CFG = "text_config"

PARAM_ROOT = (has_root "model.language_model") ? "model" : ""

MODEL_DIM = 128

VOCAB_SIZE = 262144

NUM_LAYERS = 4

NUM_HEADS = 4

KVH = 2

GKVH = 2

MODEL_HEAD_DIM = 32

GHD = 32

FFN = 256

MOE_FFN = 64

PLI = 0

WIN_LOCAL = 64

WIN_FULL = 512

EPS = 1e-06

THETA_LOCAL = 10000.0

THETA_FULL = 1000000.0

ROPE_SCALE_FULL = 1.0

ROTARY_PARTIAL_FULL = 0.25

ROPE_PERIOD = Config.int @@'{CFG}.sliding_window_pattern' default=(USE_DOUBLE_WIDE_MLP ? 5 : 6)

ATTN_K_EQ_V = true

LOGIT_SOFTCAP = 30.0

HAS_PLI = PLI > 0

PER_LAYER_INPUT_SCALE = 0.7071067811865476

NUM_KV_SHARED = 0

USE_DOUBLE_WIDE_MLP = false

TOPK_EXPERTS = 2

NUM_EXPERTS = 4

rms :: Path -> Tensor[B,S,D] -> Tensor[B,S,D]
rms@path x = NN.rmsnorm@path x cast_float=true

gemma4_kv_shared :: Tensor[B,S,D] -> Dim -> Dim -> Dim -> (Tensor[B,kv_heads,S,hd], Tensor[B,kv_heads,S,hd])
gemma4_kv_shared xn kv_dim kv_heads hd = do
  kv <- NN.linear@k_proj xn dim=kv_dim bias=false |> reshape_heads heads=kv_heads
  k <- NN.rmsnorm@k_norm kv dim=hd cast_float=true
  v <- NN.rmsnorm_noscale kv dim=hd cast_float=true
  return k, v

gemma4_kv_separate :: Tensor[B,S,D] -> Dim -> Dim -> Dim -> (Tensor[B,kv_heads,S,hd], Tensor[B,kv_heads,S,hd])
gemma4_kv_separate xn kv_dim kv_heads hd = do
  k <- NN.linear@k_proj xn dim=kv_dim bias=false |> reshape_heads heads=kv_heads |> NN.rmsnorm@k_norm dim=hd cast_float=true
  v <- NN.linear@v_proj xn dim=kv_dim bias=false |> reshape_heads heads=kv_heads |> NN.rmsnorm_noscale dim=hd cast_float=true
  return k, v

gemma4_dense_block :: Tensor[B,S,D] -> Int -> Tensor[B,S] -> Tensor[B,1,S,K] -> Tensor[B,1,S,K] -> Tensor[B,1,S,MODEL_HEAD_DIM] -> Tensor[B,1,S,MODEL_HEAD_DIM] -> Tensor[B,1,S,GHD] -> Tensor[B,1,S,GHD] -> ?(Any, Any) -> (Tensor[B,S,D], ?(Any, Any))
gemma4_dense_block x i pos_ids mask_local mask_full rope_sin_local rope_cos_local rope_sin_full rope_cos_full past_kv = do
  full <- ((i + 1) % ROPE_PERIOD) == 0
  use_global_kv <- full and ATTN_K_EQ_V
  kv_heads <- use_global_kv ? GKVH : KVH
  hd <- full ? GHD : MODEL_HEAD_DIM
  q_dim <- NUM_HEADS * hd
  kv_dim <- kv_heads * hd
  xn <- rms@input_layernorm x
  a, new_kv <- scope@self_attn do
    q <- NN.linear@q_proj xn dim=q_dim bias=false |> reshape_heads heads=NUM_HEADS |> NN.rmsnorm@q_norm dim=hd cast_float=true
    k, v <- if use_global_kv then gemma4_kv_shared xn kv_dim kv_heads hd else gemma4_kv_separate xn kv_dim kv_heads hd
    q, k <- full ? (rope_pair_proportional_factors q k rope_sin_full rope_cos_full) : (rope_pair_proportional_factors q k rope_sin_local rope_cos_local)
    k, v, new_kv <- Cache.update (past_kv :: ?CacheLayer[B,kv_heads,P,hd]) k v
    k <- Tensor.repeat k repeats=(NUM_HEADS / kv_heads)
    v <- Tensor.repeat v repeats=(NUM_HEADS / kv_heads)
    mask <- full ? mask_full : mask_local
    a <- attention_scaled q k v mask 1.0 |> merge_heads |> NN.linear@o_proj dim=MODEL_DIM bias=false
    return a, new_kv
  a <- rms@post_attention_layernorm a
  x <- x + a
  xn <- rms@pre_feedforward_layernorm x
  m <- scope@mlp do
    g <- NN.linear@gate_proj xn dim=FFN bias=false
    u <- NN.linear@up_proj xn dim=FFN bias=false
    return gelu_pytorch_tanh g |> mul u |> NN.linear@down_proj dim=MODEL_DIM bias=false
  m <- rms@post_feedforward_layernorm m
  x <- x + m
  x <- param_scale x
  return x, new_kv

gemma4_dense :: Tensor.TokenIds[B,S] -> ?Tensor[B,K] -> ?CacheAny -> ?Bool -> (Tensor[B,S,V], ?CacheAny)
gemma4_dense input_ids attn_mask past_kv use_cache = do
  past_length <- Cache.past_length_any past_kv
  pos_ids <- position_ids input_ids attn_mask=attn_mask past_length=past_length
  key_len <- past_length + S
  mask_local <- causal_mask_for_input input_ids key_len padding_mask=attn_mask window=WIN_LOCAL
  mask_full <- causal_mask_for_input input_ids key_len padding_mask=attn_mask window=WIN_FULL
  rope_sin_local, rope_cos_local <- rope_proportional_factors pos_ids MODEL_HEAD_DIM theta=THETA_LOCAL
  rope_sin_full, rope_cos_full <- rope_proportional_factors pos_ids GHD theta=THETA_FULL scale_factor=ROPE_SCALE_FULL partial_rotary_factor=ROTARY_PARTIAL_FULL
  logits, new_kv <- scope@model.language_model do
    emb_scale <- _sqrt (128.0)
    x <- NN.embedding@embed_tokens input_ids dim=MODEL_DIM scale=emb_scale
    new_kv <- use_cache ? Cache.init_any : null
    x, new_kv <- for@layers i <- [0..NUM_LAYERS) carry (x, new_kv) do
      past_i <- Cache.index_any past_kv i
      x, new_i <- gemma4_dense_block x i pos_ids mask_local mask_full rope_sin_local rope_cos_local rope_sin_full rope_cos_full past_i
      new_kv <- Cache.append_any new_kv new_i
      yield x, new_kv
    logits <- rms@norm x |> NN.linear@embed_tokens
    logits <- logits / LOGIT_SOFTCAP
    logits <- tanh logits
    logits <- logits * LOGIT_SOFTCAP
    return logits, new_kv
  return logits, new_kv
