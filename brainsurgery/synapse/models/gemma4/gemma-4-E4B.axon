{-# CHECKPOINTS ["google/gemma-4-E4B", "google/gemma-4-E4B-it"] #-}

import Activations
import Activations (gelu_pytorch_tanh, tanh)
import Cache
import Config
import Params
import Attention
import Attention (reshape_heads, merge_heads)
import Compat
import Compat (attention)
import Masking
import Masking (causal_mask)
import Positions
import Positions (position_ids, rope_pair_proportional)
import Math
import Math (mul, sqrt)

D = 2560
L = 42
H = 8
KVH = 2
HD = 256
GHD = 512
FFN = 10240
PLI = 256
WIN_LOCAL = 512
WIN_FULL = 131072
EPS = 1e-06
THETA_LOCAL = 10000.0
THETA_FULL = 1000000.0
ROPE_SCALE_FULL = 1.0
ROTARY_PARTIAL_FULL = 0.25
ROPE_PERIOD = 6
LOGIT_SOFTCAP = 30.0
PER_LAYER_INPUT_SCALE = 0.7071067811865476
PER_LAYER_PROJ_SCALE = 0.01976423537605237
NUM_KV_SHARED = 18
USE_DOUBLE_WIDE_MLP = false

rms :: @Path -> Tensor[B,S,D] -> Tensor[B,S,D]
rms@path x = NN.rmsnorm@path x cast_float=true

gemma4_per_layer_inputs :: TokenIds[B,S] -> Tensor[B,S,D] -> ?Int -> ?Int -> ?Float -> ?Float -> ?Float -> ?Float -> Tensor[B,S,NL,PD]
gemma4_per_layer_inputs input_ids hidden ?num_layers=null ?per_layer_dim=null ?embed_scale=1.0 ?projection_scale=1.0 ?combine_scale=1.0 ?rms_eps=1e-6 = do
  model_layers <- (num_layers == null) ? 1 : num_layers
  layer_dim <- (per_layer_dim == null) ? 1 : per_layer_dim
  embed <- NN.embedding@embed_tokens_per_layer input_ids dim=(model_layers * layer_dim) scale=embed_scale
  embed <- Tensor.reshape embed shape=[B, S, model_layers, layer_dim]
  proj <- NN.linear@per_layer_model_projection hidden dim=(model_layers * layer_dim) bias=false
  proj <- proj * projection_scale
  proj <- Tensor.reshape proj shape=[B, S, model_layers, layer_dim]
  proj <- NN.rmsnorm@per_layer_projection_norm proj eps=rms_eps dim=layer_dim cast_float=true
  return (proj + embed) * combine_scale

gemma4_per_layer_input_at :: Tensor[B,S,NL,PD] -> Int -> Tensor[B,S,PD]
gemma4_per_layer_input_at x i = Tensor.slice x dim=2 start=i end=(i + 1) |> Tensor.reshape shape=[B, S, PD]

gemma4_kv :: Tensor[B,S,D] -> Int -> Int -> (Tensor, Tensor)
gemma4_kv xn kv_dim hd = do
  k <- NN.linear@k_proj xn dim=kv_dim bias=false |> reshape_heads heads=KVH |> NN.rmsnorm@k_norm dim=hd cast_float=true
  v <- NN.linear@v_proj xn dim=kv_dim bias=false |> reshape_heads heads=KVH |> NN.rmsnorm_noscale dim=hd cast_float=true
  return k, v

gemma4_apply_per_layer_input :: Tensor[B,S,D] -> Tensor -> Int -> Tensor[B,S,D]
gemma4_apply_per_layer_input x per_layer_inputs i = do
  p_i <- gemma4_per_layer_input_at per_layer_inputs i
  g <- NN.linear@per_layer_input_gate x dim=PLI bias=false
  p <- gelu_pytorch_tanh g |> mul p_i |> NN.linear@per_layer_projection dim=D bias=false
  p <- rms@post_per_layer_input_norm p
  return x + p

gemma4_shared_qk :: Tensor -> Tensor -> Tensor[B,S] -> Bool -> (Tensor, Tensor)
gemma4_shared_qk q k pos_ids full = do
  q_rot, _ <- rope_pair_proportional q q pos_ids theta=(full ? THETA_FULL : THETA_LOCAL) scale_factor=(full ? ROPE_SCALE_FULL : 1.0) partial_rotary_factor=(full ? ROTARY_PARTIAL_FULL : 1.0)
  return q_rot, k

gemma4_e_block :: Tensor[B,S,D] -> Tensor -> Int -> Tensor[B,S] -> ?Tensor[B,S] -> ?CacheLayer -> ?Tensor -> ?Tensor -> ?Tensor -> ?Tensor -> ?Bool -> (Tensor[B,S,D], ?CacheLayer, ?Tensor, ?Tensor, ?Tensor, ?Tensor)
gemma4_e_block x per_layer_inputs i pos_ids attn_mask past_kv shared_full_k shared_full_v shared_sliding_k shared_sliding_v use_cache = do
  full <- ((i + 1) % ROPE_PERIOD) == 0
  shared_layer <- i >= (L - NUM_KV_SHARED)
  hd <- full ? GHD : HD
  q_dim <- H * hd
  kv_dim <- KVH * hd
  theta <- full ? THETA_FULL : THETA_LOCAL
  window <- full ? WIN_FULL : WIN_LOCAL
  ffn_dim <- (USE_DOUBLE_WIDE_MLP and (i >= (L - NUM_KV_SHARED))) ? (FFN * 2) : FFN
  xn <- rms@input_layernorm x
  a, new_kv, shared_k, shared_v <- scope@self_attn do
    q <- NN.linear@q_proj xn dim=q_dim bias=false |> reshape_heads heads=H |> NN.rmsnorm@q_norm dim=hd cast_float=true
    k, v <- if shared_layer then (full ? (shared_full_k, shared_full_v) : (shared_sliding_k, shared_sliding_v)) else gemma4_kv xn kv_dim hd
    q, k <- shared_layer ? (gemma4_shared_qk q k pos_ids full) : (rope_pair_proportional q k pos_ids theta=theta scale_factor=(full ? ROPE_SCALE_FULL : 1.0) partial_rotary_factor=(full ? ROTARY_PARTIAL_FULL : 1.0))
    k, v, new_kv <- if shared_layer then (k, v, (k, v)) else Cache.update past_kv k v
    shared_k <- k
    shared_v <- v
    k <- Tensor.repeat k repeats=(H / KVH)
    v <- Tensor.repeat v repeats=(H / KVH)
    mask <- causal_mask q k window=window padding_mask=attn_mask early_exit=full
    a <- attention q k v mask=mask scale=1.0 |> merge_heads |> NN.linear@o_proj dim=D bias=false
    return a, new_kv, shared_k, shared_v
  a <- rms@post_attention_layernorm a
  x <- x + a
  xn <- rms@pre_feedforward_layernorm x
  m <- scope@mlp do
    g <- NN.linear@gate_proj xn dim=ffn_dim bias=false
    u <- NN.linear@up_proj xn dim=ffn_dim bias=false
    return gelu_pytorch_tanh g |> mul u |> NN.linear@down_proj dim=D bias=false
  m <- rms@post_feedforward_layernorm m
  x <- x + m
  x <- gemma4_apply_per_layer_input x per_layer_inputs i
  x <- Params.param_scale x
  shared_full_k <- ((shared_layer == false) and full) ? shared_k : shared_full_k
  shared_full_v <- ((shared_layer == false) and full) ? shared_v : shared_full_v
  shared_sliding_k <- ((shared_layer == false) and (full == false)) ? shared_k : shared_sliding_k
  shared_sliding_v <- ((shared_layer == false) and (full == false)) ? shared_v : shared_sliding_v
  return x, new_kv, shared_full_k, shared_full_v, shared_sliding_k, shared_sliding_v

gemma4_e :: TokenIds[B,S] -> ?Tensor[B,S] -> ?Cache -> ?Bool -> (Tensor[B,S,V], ?Cache)
gemma4_e input_ids attn_mask past_kv use_cache = do
  pos_ids <- position_ids input_ids past_length=(Cache.past_length past_kv)
  logits, new_kv <- scope@language_model root="model" do
    x <- NN.embedding@embed_tokens input_ids dim=D scale=(sqrt D)
    per_layer_inputs <- gemma4_per_layer_inputs input_ids x num_layers=L per_layer_dim=PLI embed_scale=(sqrt PLI) projection_scale=PER_LAYER_PROJ_SCALE combine_scale=PER_LAYER_INPUT_SCALE rms_eps=EPS
    new_kv <- use_cache ? Cache.init : null
    shared_full_k <- null
    shared_full_v <- null
    shared_sliding_k <- null
    shared_sliding_v <- null
    for@layers i <- [0..L) do
      past_i <- Cache.index past_kv i
      x, new_i, shared_full_k, shared_full_v, shared_sliding_k, shared_sliding_v <- gemma4_e_block x per_layer_inputs i pos_ids attn_mask past_i shared_full_k shared_full_v shared_sliding_k shared_sliding_v use_cache
      new_kv <- Cache.append new_kv new_i
    logits <- rms@norm x |> NN.linear@embed_tokens
    logits <- logits / LOGIT_SOFTCAP
    logits <- tanh logits
    logits <- logits * LOGIT_SOFTCAP
    return logits, new_kv
  return logits, new_kv
