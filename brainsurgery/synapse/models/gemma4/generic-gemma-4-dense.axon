{-# CHECKPOINTS ["google/gemma-4-31B", "google/gemma-4-31B-it"] #-}

import Activations (gelu_pytorch_tanh, tanh)
import Attention (attention, merge_heads, reshape_heads)
import Masking (causal_mask)
import Math (mul, sqrt)
import Params (has_root, param_scale)
import Positions (position_ids, rope_pair_proportional)



CFG = (Config.has_key "text_config") ? "text_config" : ""
PARAM_ROOT = (has_root "model.language_model") ? "model" : ""

D = Config.int "hidden_size" root=CFG default=5376
V = Config.int "vocab_size" root=CFG default=262144
L = Config.int "num_hidden_layers" root=CFG default=60
H = Config.int "num_attention_heads" root=CFG default=32
KVH = Config.int "num_key_value_heads" root=CFG default=16
HAS_GLOBAL_KVH = Config.has_value "num_global_key_value_heads" root=CFG
GKVH = HAS_GLOBAL_KVH ? (Config.int "num_global_key_value_heads" root=CFG default=4) : KVH
HD = Config.int "head_dim" root=CFG default=256
HAS_GLOBAL_HD = Config.has_value "global_head_dim" root=CFG
GHD = HAS_GLOBAL_HD ? (Config.int "global_head_dim" root=CFG default=512) : HD
FFN = Config.int "intermediate_size" root=CFG default=21504
MOE_FFN = Config.int "moe_intermediate_size" root=CFG default=1408
PLI = Config.int "hidden_size_per_layer_input" root=CFG default=0
WIN_LOCAL = Config.int "sliding_window" root=CFG default=1024
WIN_FULL = Config.int "max_position_embeddings" root=CFG default=262144
EPS = Config.float "rms_norm_eps" root=CFG default=1e-06
THETA_LOCAL = Config.float "rope_parameters.sliding_attention.rope_theta" root=CFG default=10000.0
THETA_FULL = Config.float "rope_parameters.full_attention.rope_theta" root=CFG default=1000000.0
ROPE_SCALE_FULL = Config.float "rope_parameters.full_attention.factor" root=CFG default=1.0
ROTARY_PARTIAL_FULL = Config.float "rope_parameters.full_attention.partial_rotary_factor" root=CFG default=0.25
ROPE_PERIOD = Config.int "sliding_window_pattern" root=CFG default=(USE_DOUBLE_WIDE_MLP ? 5 : 6)
ATTN_K_EQ_V = Config.bool "attention_k_eq_v" root=CFG default=false
LOGIT_SOFTCAP = Config.float "final_logit_softcapping" root=CFG default=30.0
HAS_PLI = PLI > 0
PER_LAYER_INPUT_SCALE = 0.7071067811865476
PER_LAYER_PROJ_SCALE = 1.0 / sqrt D
NUM_KV_SHARED = Config.int "num_kv_shared_layers" root=CFG default=0
USE_DOUBLE_WIDE_MLP = Config.bool "use_double_wide_mlp" root=CFG default=false
TOPK_EXPERTS = Config.int "top_k_experts" root=CFG default=8
NUM_EXPERTS = Config.int "num_experts" root=CFG default=128

rms :: @Path -> Tensor[B,S,D] -> Tensor[B,S,D]
rms@path x = NN.rmsnorm@path x cast_float=true

gemma4_kv_shared :: Tensor[B,S,D] -> Int -> Int -> Int -> (Tensor, Tensor)
gemma4_kv_shared xn kv_dim kv_heads hd = do
  kv <- NN.linear@k_proj xn dim=kv_dim bias=false |> reshape_heads heads=kv_heads
  k <- NN.rmsnorm@k_norm kv dim=hd cast_float=true
  v <- NN.rmsnorm_noscale kv dim=hd cast_float=true
  return k, v

gemma4_kv_separate :: Tensor[B,S,D] -> Int -> Int -> Int -> (Tensor, Tensor)
gemma4_kv_separate xn kv_dim kv_heads hd = do
  k <- NN.linear@k_proj xn dim=kv_dim bias=false |>
    reshape_heads heads=kv_heads |>
    NN.rmsnorm@k_norm dim=hd cast_float=true
  v <- NN.linear@v_proj xn dim=kv_dim bias=false |>
    reshape_heads heads=kv_heads |>
    NN.rmsnorm_noscale dim=hd cast_float=true
  return k, v

gemma4_dense_block :: Tensor[B,S,D] -> Int -> Tensor[B,S] -> ?Tensor[B,S] -> ?CacheLayer -> (Tensor[B,S,D], ?CacheLayer)
gemma4_dense_block x i pos_ids attn_mask past_kv = do
  full <- ((i + 1) % ROPE_PERIOD) == 0
  kv_heads <- full ? GKVH : KVH
  hd <- full ? GHD : HD
  q_dim <- H * hd
  kv_dim <- kv_heads * hd
  theta <- full ? THETA_FULL : THETA_LOCAL
  window <- full ? WIN_FULL : WIN_LOCAL

  xn <- rms@input_layernorm x
  a, new_kv <- scope@self_attn do
    q <- NN.linear@q_proj xn dim=q_dim bias=false |>
      reshape_heads heads=H |>
      NN.rmsnorm@q_norm dim=hd cast_float=true
    k, v <- if full then gemma4_kv_shared xn kv_dim kv_heads hd else gemma4_kv_separate xn kv_dim kv_heads hd
    q, k <- rope_pair_proportional q k pos_ids theta=theta scale_factor=(full ? ROPE_SCALE_FULL : 1.0) partial_rotary_factor=(full ? ROTARY_PARTIAL_FULL : 1.0)
    k, v, new_kv <- Cache.update past_kv k v
    k <- Tensor.repeat k repeats=(H / kv_heads)
    v <- Tensor.repeat v repeats=(H / kv_heads)
    mask <- causal_mask q k window=window padding_mask=attn_mask early_exit=full
    a <- attention q k v mask scale=1.0 |> merge_heads |> NN.linear@o_proj dim=D bias=false
    return a, new_kv

  a <- rms@post_attention_layernorm a
  x <- x + a
  xn <- rms@pre_feedforward_layernorm x
  m <- scope@mlp do
    g <- NN.linear@gate_proj xn dim=FFN bias=false
    u <- NN.linear@up_proj xn dim=FFN bias=false
    return gelu_pytorch_tanh g |> mul u |> NN.linear@down_proj dim=D bias=false
  m <- rms@post_feedforward_layernorm m
  x <- x + m
  x <- param_scale x
  return x, new_kv

gemma4_dense :: TokenIds[B,S] -> ?Tensor[B,S] -> ?Cache -> ?Bool -> (Tensor[B,S,V], ?Cache)
gemma4_dense input_ids attn_mask past_kv use_cache = do
  pos_ids <- position_ids input_ids past_length=(Cache.past_length past_kv)
  logits, new_kv <- scope@language_model root="model" do
    x <- NN.embedding@embed_tokens input_ids dim=D scale=(sqrt D)
    new_kv <- use_cache ? Cache.init : null
    for@layers i <- [0..L) do
      past_i <- Cache.index past_kv i
      x, new_i <- gemma4_dense_block x i pos_ids attn_mask past_i
      new_kv <- Cache.append new_kv new_i
    logits <- rms@norm x |> NN.linear@embed_tokens
    logits <- logits / LOGIT_SOFTCAP
    logits <- tanh logits
    logits <- logits * LOGIT_SOFTCAP
    return logits, new_kv
  return logits, new_kv
