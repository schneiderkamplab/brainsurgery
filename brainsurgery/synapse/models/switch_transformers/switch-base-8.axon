{-# CHECKPOINTS "google/switch-base-8" #-}

{-# TASK "seq2seq_lm" #-}

{-# MAIN "switch_transformers" #-}

import Activations (relu)

import Attention (attention, merge_heads, reshape_heads)

import Masking (Mask, bidirectional_mask_for_input, causal_mask_for_input, mask_for_input)

import Math (sqrt)

import Positions (relative_position_bias)

import Config

import NN

import Tensor

MODEL_DIM <- 768

VOCAB_SIZE <- 32128

L_ENC <- 12

L_DEC <- 12

NUM_HEADS <- 12

HEAD_DIM <- 64

FFN <- 3072

EXPERTS <- 8

EXPERT_CAPACITY <- 64

ENC_SPARSE_STEP <- 2

DEC_SPARSE_STEP <- 2

EPS <- 1e-06

NUM_BUCKETS <- 32

MAX_DISTANCE <- 128

ATTN_DIM = NUM_HEADS * HEAD_DIM

LM_SCALE = 1.0 / sqrt MODEL_DIM

switch_dense_ffn :: Path -> Tensor[B,S,D] -> Tensor[B,S,D]
switch_dense_ffn@path x = do
  return NN.linear@mlp.wi x dim=FFN bias=false |> relu |> NN.linear@mlp.wo dim=MODEL_DIM bias=false

switch_sparse_ffn :: Path -> Tensor[B,S,D] -> Tensor[B,S,D]
switch_sparse_ffn@path x = do
  router_logits <- NN.linear@mlp.router.classifier x dim=EXPERTS bias=false
  router_probs <- Tensor.softmax router_logits dim=-1 dtype="float32"
  router_weights, selected <- ((Tensor.topk router_probs k=1 dim=-1 largest=true sorted=false) :: (Tensor[B,S,1], IdxTensor[B,S,1]))
  selected_flat <- ((Tensor.reshape selected shape=[B * S]) :: IdxTensor[B * S])
  weights_flat <- ((Tensor.reshape router_weights shape=[B * S, 1]) :: Tensor[B * S,1])
  x_flat <- ((Tensor.reshape x shape=[B * S, D]) :: Tensor[B * S,D])
  out <- ((Tensor.zeros_like x_flat) :: Tensor[B * S,D])
  out <- for e <- [0..EXPERTS) carry (out) do
    selected_e <- ((Tensor.eq selected_flat e) :: Tensor[B * S])
    ordinal <- ((Tensor.cast selected_e "long" |> Tensor.cumsum dim=0) :: Tensor[B * S])
    keep <- ((Tensor.and selected_e (Tensor.le ordinal EXPERT_CAPACITY)) :: Tensor[B * S])
    expert_path <- @'mlp.experts.expert_{e}'
    wi_path <- @@'{path}.mlp.experts.expert_{e}.wi.weight'
    wo_path <- @@'{path}.mlp.experts.expert_{e}.wo.weight'
    expert <- NN.linear expert_path x_flat dim=FFN bias=false weight_path=wi_path |> relu
    expert <- NN.linear expert_path expert dim=MODEL_DIM bias=false weight_path=wo_path
    expert <- expert * weights_flat
    expert <- Tensor.where (Tensor.unsqueeze keep 1) expert (Tensor.zeros_like expert)
    yield out + expert
  return Tensor.reshape out shape=[B, S, D]

switch_transformers :: TokenIds[B,SENC] -> ?Mask[B,SENC,SENC] -> TokenIds[B,SDEC] -> ?Mask[B,SDEC,SDEC] -> Tensor[B,SDEC,V]
switch_transformers input_ids attention_mask decoder_input_ids decoder_attention_mask = do
  attention_mask <- mask_for_input input_ids attention_mask SENC
  decoder_attention_mask <- mask_for_input decoder_input_ids decoder_attention_mask SDEC
  encoder_keep <- bidirectional_mask_for_input input_ids SENC padding_mask=attention_mask
  decoder_keep <- causal_mask_for_input decoder_input_ids SDEC padding_mask=decoder_attention_mask window=1048576
  cross_keep <- bidirectional_mask_for_input decoder_input_ids SENC padding_mask=attention_mask
  enc_hidden <- NN.embedding@shared input_ids dim=MODEL_DIM
  enc_hidden <- for@encoder.block i <- [0..L_ENC) carry (enc_hidden) do
    self_attn <- scope@layer.0 do
      x_norm <- NN.rmsnorm@layer_norm enc_hidden eps=EPS
      q <- NN.linear@SelfAttention.q x_norm dim=ATTN_DIM bias=false |> reshape_heads heads=NUM_HEADS
      k <- NN.linear@SelfAttention.k x_norm dim=ATTN_DIM bias=false |> reshape_heads heads=NUM_HEADS
      v <- NN.linear@SelfAttention.v x_norm dim=ATTN_DIM bias=false |> reshape_heads heads=NUM_HEADS
      rel_bias <- (i == 0) ? relative_position_bias@@encoder.block.0.layer.0.SelfAttention.relative_attention_bias q k num_buckets=NUM_BUCKETS max_distance=MAX_DISTANCE bidirectional=true : null
      return attention q k v encoder_keep rel_bias=rel_bias scale=1.0 |> merge_heads |> NN.linear@SelfAttention.o dim=MODEL_DIM bias=false
    enc_hidden <- enc_hidden + self_attn
    x_norm <- NN.rmsnorm@layer.1.layer_norm enc_hidden eps=EPS
    sparse <- (ENC_SPARSE_STEP == 1) or ((i % ENC_SPARSE_STEP) == 1)
    ffn <- sparse ? switch_sparse_ffn@layer.1 x_norm : switch_dense_ffn@layer.1 x_norm
    enc_hidden <- enc_hidden + ffn
    yield enc_hidden
  enc_hidden <- NN.rmsnorm@encoder.final_layer_norm enc_hidden eps=EPS
  dec_hidden <- NN.embedding@shared decoder_input_ids dim=MODEL_DIM
  dec_hidden <- for@decoder.block i <- [0..L_DEC) carry (dec_hidden) do
    self_attn <- scope@layer.0 do
      x_norm <- NN.rmsnorm@layer_norm dec_hidden eps=EPS
      q <- NN.linear@SelfAttention.q x_norm dim=ATTN_DIM bias=false |> reshape_heads heads=NUM_HEADS
      k <- NN.linear@SelfAttention.k x_norm dim=ATTN_DIM bias=false |> reshape_heads heads=NUM_HEADS
      v <- NN.linear@SelfAttention.v x_norm dim=ATTN_DIM bias=false |> reshape_heads heads=NUM_HEADS
      rel_bias <- (i == 0) ? relative_position_bias@@decoder.block.0.layer.0.SelfAttention.relative_attention_bias q k num_buckets=NUM_BUCKETS max_distance=MAX_DISTANCE bidirectional=false : null
      return attention q k v decoder_keep rel_bias=rel_bias scale=1.0 |> merge_heads |> NN.linear@SelfAttention.o dim=MODEL_DIM bias=false
    dec_hidden <- dec_hidden + self_attn
    cross_attn <- scope@layer.1 do
      x_norm <- NN.rmsnorm@layer_norm dec_hidden eps=EPS
      q <- NN.linear@EncDecAttention.q x_norm dim=ATTN_DIM bias=false |> reshape_heads heads=NUM_HEADS
      k <- NN.linear@EncDecAttention.k enc_hidden dim=ATTN_DIM bias=false |> reshape_heads heads=NUM_HEADS
      v <- NN.linear@EncDecAttention.v enc_hidden dim=ATTN_DIM bias=false |> reshape_heads heads=NUM_HEADS
      return attention q k v cross_keep scale=1.0 |> merge_heads |> NN.linear@EncDecAttention.o dim=MODEL_DIM bias=false
    dec_hidden <- dec_hidden + cross_attn
    x_norm <- NN.rmsnorm@layer.2.layer_norm dec_hidden eps=EPS
    sparse <- (DEC_SPARSE_STEP == 1) or ((i % DEC_SPARSE_STEP) == 1)
    ffn <- sparse ? switch_sparse_ffn@layer.2 x_norm : switch_dense_ffn@layer.2 x_norm
    dec_hidden <- dec_hidden + ffn
    yield dec_hidden
  dec_hidden <- NN.rmsnorm@decoder.final_layer_norm dec_hidden eps=EPS
  dec_hidden <- dec_hidden * LM_SCALE
  return NN.linear@lm_head dec_hidden dim=VOCAB_SIZE bias=false
