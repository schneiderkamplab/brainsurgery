{-# CHECKPOINTS ["HuggingFaceTB/SmolLM3-3B", "HuggingFaceTB/SmolLM3-3B-Base"] #-}
{-# TASK "causal_lm" #-}

import Activations (silu)
import Attention (attention_gqa_with_additive_mask, mask_to_additive_for_input, merge_heads, reshape_heads)
import Masking (Mask, causal_mask_for_input, mask_for_input, mask_length_for_input)
import Math (mul)
import Params (has_root)
import Positions (position_ids, rope_base_factors, rope_pair_base_factors)
import Cache
import Config
import NN
import Tensor



MODEL_DIM <- Config.int @@hidden_size default=2048
VOCAB_SIZE <- Config.int @@vocab_size default=128256
NUM_LAYERS <- Config.int @@num_hidden_layers default=36
NUM_HEADS <- Config.int @@num_attention_heads default=16
KVH <- Config.int @@num_key_value_heads default=4
MODEL_HEAD_DIM <- (Config.has_key @@head_dim) ? Config.int @@head_dim default=128 : (MODEL_DIM / NUM_HEADS)
KVD = KVH * MODEL_HEAD_DIM
FFN <- Config.int @@intermediate_size default=11008
EPS <- Config.float @@rms_norm_eps default=1e-06
THETA <- Config.float @@rope_theta default=5000000.0
MAX_POSITIONS <- Config.int @@max_position_embeddings default=65536
NO_ROPE_LAYER_INTERVAL <- Config.int @@no_rope_layer_interval default=4

rms :: Path -> Tensor[B,S,D] -> Tensor[B,S,D]
rms@path x = NN.rmsnorm@path x eps=EPS

smollm3_block :: Tensor[B,S,D] -> Int -> Tensor[B,1,S,R] -> Tensor[B,1,S,R] -> Tensor[B,1,S,K] -> Tensor[B,H,S,K] -> ?CacheLayer[B,KVH,P,MAX_POSITIONS,DH] -> (Tensor[B,S,D], ?CacheLayer[B,KVH,K,MAX_POSITIONS,DH])
smollm3_block x i rope_sin rope_cos mask additive_mask past_kv = do
  xn <- rms@input_layernorm x
  a, new_kv <- scope@self_attn do
    q_raw <- NN.linear@q_proj xn dim=MODEL_DIM |> reshape_heads heads=NUM_HEADS
    k_raw <- NN.linear@k_proj xn dim=KVD |> reshape_heads heads=KVH
    v <- NN.linear@v_proj xn dim=KVD |> reshape_heads heads=KVH
    use_rope <- (NO_ROPE_LAYER_INTERVAL <= 0) or (((i + 1) % NO_ROPE_LAYER_INTERVAL) != 0)
    q_rope, k_rope <- rope_pair_base_factors q_raw k_raw rope_sin rope_cos
    q <- use_rope ? q_rope : q_raw
    k <- use_rope ? k_rope : k_raw
    k, v, new_kv <- Cache.update past_kv k v
    a <- attention_gqa_with_additive_mask q k v additive_mask mask |> merge_heads |> NN.linear@o_proj dim=MODEL_DIM
    return a, new_kv
  x <- x + a
  xn <- rms@post_attention_layernorm x
  m <- scope@mlp do
    g <- NN.linear@gate_proj xn dim=FFN
    u <- NN.linear@up_proj xn dim=FFN
    return g |> silu |> mul u |> NN.linear@down_proj dim=MODEL_DIM
  return x + m, new_kv

smollm3 :: TokenIds[B,S] -> ?Mask[B,K,MAX_POSITIONS] -> ?Cache[B,KVH,P,MAX_POSITIONS,DH] -> ?Bool -> (Tensor[B,S,V], ?Cache[B,KVH,K,MAX_POSITIONS,DH])
smollm3 input_ids attn_mask past_kv use_cache = do
  past_length <- Cache.past_length past_kv
  attn_mask <- mask_for_input input_ids attn_mask MAX_POSITIONS
  pos_ids <- position_ids input_ids attn_mask=attn_mask past_length=past_length
  key_len <- mask_length_for_input input_ids attn_mask past_length
  rope_sin, rope_cos <- rope_base_factors pos_ids MODEL_HEAD_DIM THETA
  mask <- causal_mask_for_input input_ids key_len padding_mask=attn_mask window=MAX_POSITIONS
  additive_mask <- mask_to_additive_for_input input_ids mask NUM_HEADS
  work_kv <- Cache.prepare past_kv use_cache MAX_POSITIONS
  read_kv <- Cache.read past_kv work_kv
  logits, work_kv <- scope@model do
    x <- NN.embedding@embed_tokens input_ids dim=MODEL_DIM
    x, work_kv <- for@layers i <- [0..NUM_LAYERS) carry (x, work_kv) do
      past_i <- Cache.index read_kv i
      x, new_i <- smollm3_block x i rope_sin rope_cos mask additive_mask past_i
      work_kv <- Cache.append work_kv new_i
      yield x, work_kv
    logits <- rms@norm x |> NN.linear@embed_tokens dim=VOCAB_SIZE
    return logits, work_kv
  new_length <- past_length + S
  new_kv <- Cache.finish work_kv new_length
  new_kv <- use_cache ? new_kv : null
  return logits, new_kv
