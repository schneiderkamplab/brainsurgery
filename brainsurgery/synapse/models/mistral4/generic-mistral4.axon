{-# CHECKPOINTS "mistralai/Mistral-Small-4-119B-2603" #-}
{-# TASK "causal_lm" #-}

import Config
import Params
import Activations (silu)
import Cache
import Cache
import MoE
import Attention (reshape_heads, merge_heads)
import Attention (attention_masked)
import Masking (causal_mask)
import Positions (position_ids, rope_pair_yarn)
import Math (floor, log, mul, sqrt)

CFG = (Config.has_key "text_config") ? "text_config" : ""
ROPE_CFG = (CFG == "") ? "rope_parameters" : "text_config.rope_parameters"
MODEL_ROOT = (Params.has_root "language_model.model") ? "language_model" : ""

D = Config.int "hidden_size" root=CFG default=4096
V = Config.int "vocab_size" root=CFG default=131072
L = Config.int "num_hidden_layers" root=CFG default=36
H = Config.int "num_attention_heads" root=CFG default=32
QKNOPE = Config.int "qk_nope_head_dim" root=CFG default=64
QKROPE = Config.int "qk_rope_head_dim" root=CFG default=64
QKHD = QKNOPE + QKROPE
VHD = Config.int "v_head_dim" root=CFG default=128
QLR = Config.int "q_lora_rank" root=CFG default=1024
KVR = Config.int "kv_lora_rank" root=CFG default=256
EM = Config.int "moe_intermediate_size" root=CFG default=2048
E = Config.int "n_routed_experts" root=CFG default=128
EPT = Config.int "num_experts_per_tok" root=CFG default=4
SE = Config.int "n_shared_experts" root=CFG default=1
EPS = Config.float "rms_norm_eps" root=CFG default=1e-06
THETA = Config.float "rope_theta" root=ROPE_CFG default=10000.0
ROPE_FACTOR = Config.float "factor" root=ROPE_CFG default=128.0
ROPE_CONTEXT = Config.int "original_max_position_embeddings" root=ROPE_CFG default=8192
ROPE_BETA_FAST = Config.float "beta_fast" root=ROPE_CFG default=32.0
ROPE_BETA_SLOW = Config.float "beta_slow" root=ROPE_CFG default=1.0
ROPE_MSCALE = Config.float "mscale" root=ROPE_CFG default=1.0
ROPE_MSCALE_ALL_DIM = Config.float "mscale_all_dim" root=ROPE_CFG default=1.0
Q_SCALE_BETA = Config.float "llama_4_scaling_beta" root=ROPE_CFG default=0.1
ROUTE_SCALE = Config.float "routed_scaling_factor" root=CFG default=1.0
ATTN_SCALE = 1.0 / sqrt QKHD

mistral4_norm :: @Path -> Tensor[B,S,D] -> Tensor[B,S,D]
mistral4_norm@path x = NN.rmsnorm@path x eps=EPS

mistral4_q_norm :: @Path -> Tensor[B,S,QLR] -> Tensor[B,S,QLR]
mistral4_q_norm@path x = NN.rmsnorm@path x eps=EPS

mistral4_kv_norm :: @Path -> Tensor[B,S,KVR] -> Tensor[B,S,KVR]
mistral4_kv_norm@path x = NN.rmsnorm@path x eps=EPS

mistral4_query_scale :: Tensor[B,S] -> Tensor[B,1,S,1]
mistral4_query_scale pos_ids = do
  scaled <- pos_ids / ROPE_CONTEXT
  bucket <- floor scaled
  shifted <- bucket + 1.0
  logged <- log shifted
  beta_scaled <- logged * Q_SCALE_BETA
  gain <- beta_scaled + 1.0
  gain3 <- Tensor.unsqueeze gain dim=1
  gain4 <- Tensor.unsqueeze gain3 dim=3
  return gain4

mistral4_attn :: Tensor[B,S,D] -> Tensor[B,S] -> ?Tensor[B,S] -> ?CacheLayer -> (Tensor[B,S,D], ?CacheLayer)
mistral4_attn x pos_ids attn_mask past_kv = do
  a, new_kv <- scope@self_attn do
    q_low <- NN.linear@q_a_proj x dim=QLR bias=false
    q_low <- mistral4_q_norm@q_a_layernorm q_low
    q <- NN.linear@q_b_proj q_low dim=(H * QKHD) bias=false |> reshape_heads heads=H
    q_pass, q_rot <- Tensor.split q sizes=[QKNOPE, QKROPE]

    kv_comp <- NN.linear@kv_a_proj_with_mqa x dim=(KVR + QKROPE) bias=false
    kv_latent, k_rot_base <- Tensor.split kv_comp sizes=[KVR, QKROPE]
    kv_latent <- mistral4_kv_norm@kv_a_layernorm kv_latent
    kv <- NN.linear@kv_b_proj kv_latent dim=(H * (QKNOPE + VHD)) bias=false |> reshape_heads heads=H
    k_pass, v <- Tensor.split kv sizes=[QKNOPE, VHD]

    k_rot <- reshape_heads k_rot_base heads=1 |> Tensor.repeat repeats=H
    q_rot, k_rot <- rope_pair_yarn q_rot k_rot pos_ids THETA ROPE_FACTOR ROPE_BETA_FAST ROPE_BETA_SLOW ROPE_CONTEXT mscale=ROPE_MSCALE mscale_all_dim=ROPE_MSCALE_ALL_DIM interleaved=true
    q <- Tensor.concat q_pass q_rot dim=-1
    k <- Tensor.concat k_pass k_rot dim=-1

    q_scale <- mistral4_query_scale pos_ids
    q <- q * q_scale

    k, v, new_kv <- Cache.update past_kv k v
    mask <- causal_mask q k padding_mask=attn_mask
    a <- attention_masked q k v mask=mask scale=ATTN_SCALE |> merge_heads
    a <- NN.linear@o_proj a dim=D bias=false
    return a, new_kv
  return a, new_kv

mistral4_moe :: Tensor[B,S,D] -> Tensor[B,S,D]
mistral4_moe xn = do
  shared <- scope@shared_experts do
    gate <- NN.linear@gate_proj xn dim=(EM * SE) bias=false
    up <- NN.linear@up_proj xn dim=(EM * SE) bias=false
    return gate |> silu |> mul up |> NN.linear@down_proj dim=D bias=false
  topk_weights, topk_indices <- MoE.softmax_topk_router@gate xn top_k=EPT norm_topk_prob=true routed_scaling_factor=ROUTE_SCALE
  routed <- MoE.grouped_swiglu_ffn_basic xn topk_weights topk_indices E
  return shared + routed

mistral4_block :: Tensor[B,S,D] -> Tensor[B,S] -> ?Tensor[B,S] -> ?CacheLayer -> (Tensor[B,S,D], ?CacheLayer)
mistral4_block x pos_ids attn_mask past_kv = do
  xn <- mistral4_norm@input_layernorm x
  a, new_kv <- mistral4_attn xn pos_ids attn_mask past_kv
  x <- x + a
  xn <- mistral4_norm@post_attention_layernorm x
  m <- scope@mlp do
    return mistral4_moe xn
  return x + m, new_kv

mistral4 :: TokenIds[B,S] -> ?Tensor[B,S] -> ?Cache -> ?Bool -> (Tensor[B,S,V], ?Cache)
mistral4 input_ids attn_mask past_kv use_cache = do
  pos_ids <- position_ids input_ids attn_mask=attn_mask past_length=(Cache.past_length past_kv)
  x, new_kv <- scope@model root=MODEL_ROOT do
    x <- NN.embedding@embed_tokens input_ids dim=D
    new_kv <- use_cache ? Cache.init : null
    for@layers i <- [0..L) do
      past_i <- Cache.index past_kv i
      x, new_i <- mistral4_block x pos_ids attn_mask past_i
      new_kv <- Cache.append new_kv new_i
    x <- mistral4_norm@norm x
    return x, new_kv
  logits <- scope@language_model do
    logits <- NN.linear@lm_head x dim=V bias=false
    return logits
  return logits, new_kv
