{-# CHECKPOINTS "mistralai/Mistral-Small-4-119B-2603" #-}
{-# TASK "causal_lm" #-}

import Activations
import Activations (silu)
import Attention
import Attention (attention, merge_heads, reshape_heads)
import Masking
import Masking (causal_mask)
import Math
import Math (floor, log, mul)
import MoE
import MoE (grouped_swiglu_ffn_basic, softmax_topk_router)
import Positions
import Positions (position_ids, rope_pair_yarn)
import Cache
import NN
import Tensor

mistral4_norm :: Path -> Tensor[B,S,D] -> Tensor[B,S,D]
mistral4_norm@path x = NN.rmsnorm@path x eps=1e-06

mistral4_q_norm :: Path -> Tensor[B,S,QLR] -> Tensor[B,S,QLR]
mistral4_q_norm@path x = NN.rmsnorm@path x eps=1e-06

mistral4_kv_norm :: Path -> Tensor[B,S,KVR] -> Tensor[B,S,KVR]
mistral4_kv_norm@path x = NN.rmsnorm@path x eps=1e-06

mistral4_query_scale :: Tensor[B,S] -> Tensor[B,1,S,1]
mistral4_query_scale pos_ids = do
  scaled <- pos_ids / 8192
  bucket <- floor scaled
  shifted <- bucket + 1.0
  logged <- log shifted
  beta_scaled <- logged * 0.1
  gain <- beta_scaled + 1.0
  gain3 <- Tensor.unsqueeze gain dim=1
  gain4 <- Tensor.unsqueeze gain3 dim=3
  return gain4

mistral4_attn :: Tensor[B,S,D] -> Tensor[B,S] -> ?Tensor[B,S] -> ?CacheLayer -> (Tensor[B,S,D], ?CacheLayer)
mistral4_attn x pos_ids attn_mask past_kv = do
  a, new_kv <- scope@self_attn do
    q_low <- NN.linear@q_a_proj x dim=1024 bias=false
    q_low <- mistral4_q_norm@q_a_layernorm q_low
    q <- NN.linear@q_b_proj q_low dim=4096 bias=false |> reshape_heads heads=32
    q_pass, q_rot <- Tensor.split q sizes=[64, 64]
    kv_comp <- NN.linear@kv_a_proj_with_mqa x dim=320 bias=false
    kv_latent, k_rot_base <- Tensor.split kv_comp sizes=[256, 64]
    kv_latent <- mistral4_kv_norm@kv_a_layernorm kv_latent
    kv <- NN.linear@kv_b_proj kv_latent dim=6144 bias=false |> reshape_heads heads=32
    k_pass, v <- Tensor.split kv sizes=[64, 128]
    k_rot <- reshape_heads k_rot_base heads=1 |> Tensor.repeat repeats=32
    q_rot, k_rot <- rope_pair_yarn q_rot k_rot pos_ids 10000.0 128.0 32.0 1.0 8192 mscale=1.0 mscale_all_dim=1.0 interleaved=true
    q <- Tensor.concat q_pass q_rot dim=-1
    k <- Tensor.concat k_pass k_rot dim=-1
    q_scale <- mistral4_query_scale pos_ids
    q <- q * q_scale
    k, v, new_kv <- Cache.update past_kv k v
    mask <- causal_mask q k padding_mask=attn_mask
    a <- attention q k v mask scale=0.08838834764831843 |> merge_heads
    a <- NN.linear@o_proj a dim=4096 bias=false
    return a, new_kv
  return a, new_kv

mistral4_moe :: Tensor[B,S,D] -> Tensor[B,S,D]
mistral4_moe xn = do
  shared <- scope@shared_experts do
    gate <- NN.linear@gate_proj xn dim=2048 bias=false
    up <- NN.linear@up_proj xn dim=2048 bias=false
    return gate |> silu |> mul up |> NN.linear@down_proj dim=4096 bias=false
  topk_weights, topk_indices <- softmax_topk_router@gate xn top_k=4 routed_scaling_factor=1.0
  routed <- grouped_swiglu_ffn_basic xn topk_weights topk_indices 128
  return shared + routed

mistral4_block :: Tensor[B,S,D] -> Tensor[B,S] -> ?Tensor[B,S] -> ?CacheLayer -> (Tensor[B,S,D], ?CacheLayer)
mistral4_block x pos_ids attn_mask past_kv = do
  xn <- mistral4_norm@input_layernorm x
  a, new_kv <- mistral4_attn xn pos_ids attn_mask past_kv
  x <- x + a
  xn <- mistral4_norm@post_attention_layernorm x
  m <- scope@mlp do
    return mistral4_moe xn
  return x + m, new_kv

mistral4 :: TokenIds[B,S] -> ?Tensor[B,S] -> ?Cache -> ?Bool -> (Tensor[B,S,V], ?Cache)
mistral4 input_ids attn_mask past_kv use_cache = do
  pos_ids <- position_ids input_ids attn_mask=attn_mask past_length=(Cache.past_length past_kv)
  x, new_kv <- scope@language_model.model do
    x <- NN.embedding@embed_tokens input_ids dim=4096
    new_kv <- use_cache ? Cache.init : null
    for@layers i <- [0..36) do
      past_i <- Cache.index past_kv i
      x, new_i <- mistral4_block x pos_ids attn_mask past_i
      new_kv <- Cache.append new_kv new_i
      yield x, new_kv
    x <- mistral4_norm@norm x
    return x, new_kv
  logits <- scope@language_model do
    logits <- NN.linear@lm_head x dim=131072 bias=false
    return logits
  return logits, new_kv
