{-# CHECKPOINTS "mistralai/Mistral-Small-4-119B-2603" #-}
{-# TASK "causal_lm" #-}

import Activations
import Activations (silu)
import Cache
import Cache (past_length)
import MoE

PARAM_ROOT = "language_model"
D = 4096
V = 131072
L = 36
H = 32
QKNOPE = 64
QKROPE = 64
QKHD = 128
VHD = 128
QLR = 1024
KVR = 256
EM = 2048
E = 128
EPT = 4
SE = 1
EPS = 1e-06
THETA = 10000.0
ROPE_FACTOR = 128.0
ROPE_CONTEXT = 8192
ROPE_BETA_FAST = 32.0
ROPE_BETA_SLOW = 1.0
ROPE_MSCALE = 1.0
ROPE_MSCALE_ALL_DIM = 1.0
Q_SCALE_BETA = 0.1
ROUTE_SCALE = 1.0
ATTN_SCALE = 0.08838834764831843

mistral4_norm :: @Path -> Tensor[B,S,D] -> Tensor[B,S,D]
mistral4_norm@path x = rmsnorm@path x eps=EPS

mistral4_q_norm :: @Path -> Tensor[B,S,QLR] -> Tensor[B,S,QLR]
mistral4_q_norm@path x = rmsnorm@path x eps=EPS

mistral4_kv_norm :: @Path -> Tensor[B,S,KVR] -> Tensor[B,S,KVR]
mistral4_kv_norm@path x = rmsnorm@path x eps=EPS

mistral4_query_scale :: Tensor[B,S] -> Tensor[B,1,S,1]
mistral4_query_scale pos_ids = do
  scaled <- pos_ids / ROPE_CONTEXT
  bucket <- floor scaled
  shifted <- bucket + 1.0
  logged <- log shifted
  beta_scaled <- logged * Q_SCALE_BETA
  gain <- beta_scaled + 1.0
  gain3 <- unsqueeze gain dim=1
  gain4 <- unsqueeze gain3 dim=3
  return gain4

mistral4_attn :: Tensor[B,S,D] -> Tensor[B,S] -> ?Tensor[B,S] -> ?CacheLayer -> (Tensor[B,S,D], ?CacheLayer)
mistral4_attn x pos_ids attn_mask past_kv = do
  a, new_kv <- scope@self_attn do
    q_low <- linear@q_a_proj x dim=QLR bias=false
    q_low <- mistral4_q_norm@q_a_layernorm q_low
    q <- linear@q_b_proj q_low dim=(H * QKHD) bias=false |> reshape_heads heads=H
    q_pass, q_rot <- split q sizes=[QKNOPE, QKROPE]
    kv_comp <- linear@kv_a_proj_with_mqa x dim=(KVR + QKROPE) bias=false
    kv_latent, k_rot_base <- split kv_comp sizes=[KVR, QKROPE]
    kv_latent <- mistral4_kv_norm@kv_a_layernorm kv_latent
    kv <- linear@kv_b_proj kv_latent dim=(H * (QKNOPE + VHD)) bias=false |> reshape_heads heads=H
    k_pass, v <- split kv sizes=[QKNOPE, VHD]
    k_rot <- reshape_heads k_rot_base heads=1 |> repeat repeats=H
    q_rot, k_rot <- rope_pair q_rot k_rot position_ids=pos_ids theta=THETA interleaved=true scale_factor=ROPE_FACTOR beta_fast=ROPE_BETA_FAST beta_slow=ROPE_BETA_SLOW original_context=ROPE_CONTEXT mscale=ROPE_MSCALE mscale_all_dim=ROPE_MSCALE_ALL_DIM
    q <- concat q_pass q_rot dim=-1
    k <- concat k_pass k_rot dim=-1
    q_scale <- mistral4_query_scale pos_ids
    q <- q * q_scale
    k, v, new_kv <- Cache.update past_kv k v
    mask <- causal_mask q k padding_mask=attn_mask
    a <- attention q k v mask=mask scale=ATTN_SCALE eager=true |> merge_heads
    a <- linear@o_proj a dim=D bias=false
    return a, new_kv
  return a, new_kv

mistral4_moe :: Tensor[B,S,D] -> Tensor[B,S,D]
mistral4_moe xn = do
  shared <- scope@shared_experts do
    gate <- linear@gate_proj xn dim=(EM * SE) bias=false
    up <- linear@up_proj xn dim=(EM * SE) bias=false
    return gate |> silu |> mul up |> linear@down_proj dim=D bias=false
  topk_weights, topk_indices <- softmax_topk_router@gate xn top_k=EPT norm_topk_prob=true routed_scaling_factor=ROUTE_SCALE
  routed <- MoE.grouped_swiglu_ffn_basic xn topk_weights topk_indices E
  return shared + routed

mistral4_block :: Tensor[B,S,D] -> Tensor[B,S] -> ?Tensor[B,S] -> ?CacheLayer -> (Tensor[B,S,D], ?CacheLayer)
mistral4_block x pos_ids attn_mask past_kv = do
  xn <- mistral4_norm@input_layernorm x
  a, new_kv <- mistral4_attn xn pos_ids attn_mask past_kv
  x <- x + a
  xn <- mistral4_norm@post_attention_layernorm x
  m <- scope@mlp do
    return mistral4_moe xn
  return x + m, new_kv

mistral4 :: TokenIds[B,S] -> ?Tensor[B,S] -> ?Cache -> ?Bool -> (Tensor[B,S,V], ?Cache)
mistral4 input_ids attn_mask past_kv use_cache = do
  pos_ids <- position_ids input_ids attn_mask=attn_mask past_length=(past_length past_kv)
  x, new_kv <- scope@model root=PARAM_ROOT do
    x <- embedding@embed_tokens input_ids dim=D
    new_kv <- use_cache ? Cache.init : null
    for@layers i <- [0..L) do
      past_i <- Cache.index past_kv i
      x, new_i <- mistral4_block x pos_ids attn_mask past_i
      new_kv <- Cache.append new_kv new_i
    x <- mistral4_norm@norm x
    return x, new_kv
  logits <- scope@language_model do
    logits <- linear@lm_head x dim=V bias=false
    return logits
  return logits, new_kv
