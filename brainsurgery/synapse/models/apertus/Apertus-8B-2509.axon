{-# CHECKPOINTS ["swiss-ai/Apertus-8B-2509", "swiss-ai/Apertus-8B-Instruct-2509"] #-}
{-# TASK "causal_lm" #-}

import Activations
import Activations (xielu)
import Cache
import Cache
import Attention (reshape_heads, merge_heads)
import Compat (attention)
import Masking (causal_mask)
import Positions (position_ids, rope_pair_freq_scale)

D = 4096
V = 131072
L = 32
H = 32
KVH = 8
HD = 128
QD = 4096
KVD = 1024
FFN = 21504
EPS = 1e-05
THETA = 12000000.0
C = 65536
ROPE_SCALE = 8.0
ROPE_LOW_FREQ = 1.0
ROPE_HIGH_FREQ = 4.0
ROPE_CONTEXT = 8192

rms :: @Path -> Tensor[B,S,D] -> Tensor[B,S,D]
rms@path x = NN.rmsnorm@path x eps=EPS dim=D cast_float=true

apertus_block :: Tensor[B,S,D] -> Tensor[B,S] -> ?Tensor[B,S] -> ?CacheLayer -> (Tensor[B,S,D], ?CacheLayer)
apertus_block x pos_ids attn_mask past_kv = do
  xn <- rms@attention_layernorm x
  a, new_kv <- scope@self_attn do
    q <- NN.linear@q_proj xn dim=QD bias=false |> reshape_heads heads=H |> NN.rmsnorm@q_norm eps=EPS dim=HD cast_float=true
    k <- NN.linear@k_proj xn dim=KVD bias=false |> reshape_heads heads=KVH |> NN.rmsnorm@k_norm eps=EPS dim=HD cast_float=true
    v <- NN.linear@v_proj xn dim=KVD bias=false |> reshape_heads heads=KVH
    q, k <- rope_pair_freq_scale q k pos_ids THETA ROPE_SCALE ROPE_LOW_FREQ ROPE_HIGH_FREQ ROPE_CONTEXT
    k, v, new_kv <- Cache.update past_kv k v
    k <- Tensor.repeat k repeats=(H / KVH)
    v <- Tensor.repeat v repeats=(H / KVH)
    mask <- causal_mask q k window=C padding_mask=attn_mask
    a <- attention q k v mask=mask eager=true |> merge_heads |> NN.linear@o_proj dim=D bias=false
    return a, new_kv
  x <- x + a
  xn <- rms@feedforward_layernorm x
  m <- scope@mlp do
    return NN.linear@up_proj xn dim=FFN bias=false |> xielu@act_fn |> NN.linear@down_proj dim=D bias=false
  return x + m, new_kv

apertus :: TokenIds[B,S] -> ?Tensor[B,S] -> ?Cache -> ?Bool -> (Tensor[B,S,V], ?Cache)
apertus input_ids attn_mask past_kv use_cache = do
  pos_ids <- position_ids input_ids attn_mask=attn_mask past_length=(Cache.past_length past_kv)
  x, new_kv <- scope@model do
    x <- NN.embedding@embed_tokens input_ids dim=D
    new_kv <- use_cache ? Cache.init : null
    for@layers i <- [0..L) do
      past_i <- Cache.index past_kv i
      x, new_i <- apertus_block x pos_ids attn_mask past_i
      new_kv <- Cache.append new_kv new_i
    x <- rms@norm x
    return x, new_kv
  logits <- NN.linear@lm_head x dim=V bias=false
  return logits, new_kv
