{-# CHECKPOINTS ["google/gemma-2-9b", "google/gemma-2-9b-it"] #-}
{-# TASK "causal_lm" #-}

import Activations
import Activations (gelu_pytorch_tanh, tanh)
import Attention
import Attention (attention, merge_heads, reshape_heads)
import Masking
import Masking (causal_mask)
import Math
import Math (mul, sqrt)
import Params
import Params (has_root)
import Positions
import Positions (position_ids, rope_pair_base)

HAS_LM_HEAD = has_root "lm_head"

rms :: Path -> Tensor[B,S,D] -> Tensor[B,S,D]
rms@path x = NN.rmsnorm@path x eps=1e-06 cast_float=true unit_offset=true

gemma2_block :: Tensor[B,S,D] -> Int -> Tensor[B,S] -> ?Tensor[B,S] -> ?CacheLayer -> (Tensor[B,S,D], ?CacheLayer)
gemma2_block x i pos_ids attn_mask past_kv = do
  xn <- rms@input_layernorm x
  a, new_kv <- scope@self_attn do
    q <- NN.linear@q_proj xn dim=3584 |> reshape_heads heads=16
    k <- NN.linear@k_proj xn dim=2048 |> reshape_heads heads=8
    v <- NN.linear@v_proj xn dim=2048 |> reshape_heads heads=8
    q, k <- rope_pair_base q k pos_ids 10000.0
    k, v, new_kv <- Cache.update past_kv k v
    k <- Tensor.repeat k repeats=2
    v <- Tensor.repeat v repeats=2
    window <- (i % 2) == 0 ? 4096 : 8192
    mask <- causal_mask q k window=window padding_mask=attn_mask
    a <- (attention q k v mask scale=0.0625)
    a <- a |> merge_heads |> NN.linear@o_proj dim=3584
    return a, new_kv
  a <- rms@post_attention_layernorm a
  x <- x + a
  xn <- rms@pre_feedforward_layernorm x
  m <- scope@mlp do
    g <- NN.linear@gate_proj xn dim=14336
    u <- NN.linear@up_proj xn dim=14336
    return gelu_pytorch_tanh g |> mul u |> NN.linear@down_proj dim=3584
  m <- rms@post_feedforward_layernorm m
  return x + m, new_kv

gemma2 :: TokenIds[B,S] -> ?Tensor[B,S] -> ?Cache -> ?Bool -> (Tensor[B,S,V], ?Cache)
gemma2 input_ids attn_mask past_kv use_cache = do
  pos_ids <- position_ids input_ids past_length=(Cache.past_length past_kv)
  logits, new_kv <- scope@model do
    x <- NN.embedding@embed_tokens input_ids dim=3584 scale=59.86651818838306
    new_kv <- use_cache ? Cache.init : null
    for@layers i <- [0..42) do
      past_i <- Cache.index past_kv i
      x, new_i <- gemma2_block x i pos_ids attn_mask past_i
      new_kv <- Cache.append new_kv new_i
      yield x, new_kv
    x <- rms@norm x
    logits <- HAS_LM_HEAD ? (NN.linear@lm_head x dim=256000 weight_path=@@lm_head.weight) : (NN.linear@embed_tokens x dim=256000)
    logits <- logits / 30.0
    logits <- tanh logits
    logits <- logits * 30.0
    return logits, new_kv
  return logits, new_kv
