{-# CHECKPOINTS ["google/gemma-2-2b", "google/gemma-2-2b-it", "google/gemma-2-9b", "google/gemma-2-9b-it", "google/gemma-2-27b", "google/gemma-2-27b-it"] #-}
{-# TASK "causal_lm" #-}

import Activations (gelu_pytorch_tanh, tanh)
import Attention (attention, attention_softcap, merge_heads, reshape_heads)
import Masking (causal_mask)
import Math (mul, sqrt)
import Params (has_root)
import Positions (position_ids, rope_pair_base)
import Cache (Cache, CacheLayer)
import Config
import NN
import Tensor



MODEL_DIM = Config.int @@hidden_size default=2304
VOCAB_SIZE = Config.int @@vocab_size default=256000
NUM_LAYERS = Config.int @@num_hidden_layers default=26
NUM_HEADS = Config.int @@num_attention_heads default=8
KVH = Config.int @@num_key_value_heads default=4
HAS_HEAD_DIM = Config.has_value @@head_dim
MODEL_HEAD_DIM = HAS_HEAD_DIM ? (Config.int @@head_dim default=256) : (MODEL_DIM / NUM_HEADS)
QD = NUM_HEADS * MODEL_HEAD_DIM
KVD = KVH * MODEL_HEAD_DIM
FFN = Config.int @@intermediate_size default=9216
EPS = Config.float @@rms_norm_eps default=1e-06
THETA = Config.float @@rope_theta default=10000.0
HAS_SLIDING_WINDOW = Config.has_value @@sliding_window
C_LOCAL = HAS_SLIDING_WINDOW ? (Config.int @@sliding_window default=4096) : (Config.int @@max_position_embeddings default=8192)
C_FULL = Config.int @@max_position_embeddings default=8192
ATTN_LOGIT_SOFTCAP = Config.float @@attn_logit_softcapping default=50.0
LOGIT_SOFTCAP = Config.float @@final_logit_softcapping default=30.0
ATTN_IMPL = Config.str @@_attn_implementation default=""
ATTN_EAGER = ATTN_IMPL == "eager"
HAS_LM_HEAD = has_root "lm_head"

rms :: Path -> Tensor[B,S,D] -> Tensor[B,S,D]
rms@path x = NN.rmsnorm@path x eps=EPS cast_float=true unit_offset=true

gemma2_block :: Tensor[B,S,D] -> Int -> Tensor[B,S] -> ?Tensor[B,K] -> ?CacheLayer[B,KVH,P,MODEL_HEAD_DIM] -> (Tensor[B,S,D], ?CacheLayer[B,KVH,K,MODEL_HEAD_DIM])
gemma2_block x i pos_ids attn_mask past_kv = do
  xn <- rms@input_layernorm x
  a, new_kv <- scope@self_attn do
    q <- NN.linear@q_proj xn dim=QD |> reshape_heads heads=NUM_HEADS
    k <- NN.linear@k_proj xn dim=KVD |> reshape_heads heads=KVH
    v <- NN.linear@v_proj xn dim=KVD |> reshape_heads heads=KVH
    q, k <- rope_pair_base q k pos_ids THETA
    k, v, new_kv <- Cache.update past_kv k v
    k <- Tensor.repeat k repeats=(NUM_HEADS / KVH)
    v <- Tensor.repeat v repeats=(NUM_HEADS / KVH)
    window <- (i % 2) == 0 ? C_LOCAL : C_FULL
    attn_scale <- 1.0 / (_sqrt (Config.float @@query_pre_attn_scalar default=256.0))
    mask <- causal_mask q k window=window padding_mask=attn_mask
    a <- ATTN_EAGER
      ? (attention_softcap q k v mask ATTN_LOGIT_SOFTCAP attn_scale)
      : (attention q k v mask scale=attn_scale)
    a <- a |> merge_heads |> NN.linear@o_proj dim=MODEL_DIM
    return a, new_kv
  a <- rms@post_attention_layernorm a
  x <- x + a
  xn <- rms@pre_feedforward_layernorm x
  m <- scope@mlp do
    g <- NN.linear@gate_proj xn dim=FFN
    u <- NN.linear@up_proj xn dim=FFN
    return gelu_pytorch_tanh g |> mul u |> NN.linear@down_proj dim=MODEL_DIM
  m <- rms@post_feedforward_layernorm m
  return x + m, new_kv

gemma2 :: Tensor.TokenIds[B,S] -> ?Tensor[B,K] -> ?Cache[B,KVH,P,MODEL_HEAD_DIM] -> ?Bool -> (Tensor[B,S,V], ?Cache[B,KVH,K,MODEL_HEAD_DIM])
gemma2 input_ids attn_mask past_kv use_cache = do
  pos_ids <- position_ids input_ids attn_mask=attn_mask past_length=(Cache.past_length past_kv)
  logits, new_kv <- scope@model do
    emb_scale <- _sqrt (Config.float @@hidden_size default=2304.0)
    x <- NN.embedding@embed_tokens input_ids dim=MODEL_DIM scale=emb_scale
    new_kv <- use_cache ? Cache.init : null
    x, new_kv <- for@layers i <- [0..NUM_LAYERS) carry (x, new_kv) do
      past_i <- Cache.index past_kv i
      x, new_i <- gemma2_block x i pos_ids attn_mask past_i
      new_kv <- Cache.append new_kv new_i
      yield x, new_kv
    x <- rms@norm x
    logits <- HAS_LM_HEAD ? (NN.linear@lm_head x dim=VOCAB_SIZE weight_path=@@lm_head.weight) : (NN.linear@embed_tokens x dim=VOCAB_SIZE)
    logits <- logits / LOGIT_SOFTCAP
    logits <- tanh logits
    logits <- logits * LOGIT_SOFTCAP
    return logits, new_kv
  return logits, new_kv
