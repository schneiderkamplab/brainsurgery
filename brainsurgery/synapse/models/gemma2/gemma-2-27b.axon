{-# CHECKPOINTS ["google/gemma-2-27b", "google/gemma-2-27b-it"] #-}
{-# TASK "causal_lm" #-}

import Activations
import Activations (gelu_pytorch_tanh, tanh)
import Cache
import Cache (past_length)

D = 4608
V = 256000
L = 46
H = 32
KVH = 16
KVD = 2048
FFN = 36864
EPS = 1e-06
THETA = 10000.0
C_LOCAL = 4096
C_FULL = 8192
ATTN_SCALE = 0.08333333333333333
ATTN_LOGIT_SOFTCAP = 50.0
LOGIT_SOFTCAP = 30.0
EMB_SCALE = 67.88225099390856
HAS_LM_HEAD = false

rms :: @Path -> Tensor[B,S,D] -> Tensor[B,S,D]
rms@path x = rmsnorm@path x eps=EPS cast_float=true unit_offset=true

gemma2_block :: Tensor[B,S,D] -> Int -> Tensor[B,S] -> ?Tensor[B,S] -> ?CacheLayer -> (Tensor[B,S,D], ?CacheLayer)
gemma2_block x i pos_ids attn_mask past_kv = do
  xn <- rms@input_layernorm x
  a, new_kv <- scope@self_attn do
    q <- linear@q_proj xn dim=D |> reshape_heads heads=H
    k <- linear@k_proj xn dim=KVD |> reshape_heads heads=KVH
    v <- linear@v_proj xn dim=KVD |> reshape_heads heads=KVH
    q, k <- rope_pair q k position_ids=pos_ids theta=THETA
    k, v, new_kv <- Cache.update past_kv k v
    k <- repeat k (H / KVH)
    v <- repeat v (H / KVH)
    window <- (i % 2) == 0 ? C_LOCAL : C_FULL
    mask <- causal_mask q k window=window padding_mask=attn_mask
    a <- true ? (attention q k v mask=mask scale=ATTN_SCALE softcap=ATTN_LOGIT_SOFTCAP eager=true) : (attention q k v mask=mask scale=ATTN_SCALE eager=false)
    a <- a |> merge_heads |> linear@o_proj dim=D
    return a, new_kv
  a <- rms@post_attention_layernorm a
  x <- x + a
  xn <- rms@pre_feedforward_layernorm x
  m <- scope@mlp do
    g <- linear@gate_proj xn dim=FFN
    u <- linear@up_proj xn dim=FFN
    return gelu_pytorch_tanh g |> mul u |> linear@down_proj dim=D
  m <- rms@post_feedforward_layernorm m
  return x + m, new_kv

gemma2 :: TokenIds[B,S] -> ?Tensor[B,S] -> ?Cache -> ?Bool -> (Tensor[B,S,V], ?Cache)
gemma2 input_ids attn_mask past_kv use_cache = do
  pos_ids <- position_ids input_ids null past_length=(past_length past_kv)
  logits, new_kv <- scope@model do
    x <- embedding@embed_tokens input_ids dim=D scale=EMB_SCALE
    new_kv <- use_cache ? Cache.init : null
    for@layers i <- [0..L) do
      past_i <- Cache.index past_kv i
      x, new_i <- gemma2_block x i pos_ids attn_mask past_i
      new_kv <- Cache.append new_kv new_i
    x <- rms@norm x
    logits <- HAS_LM_HEAD ? (linear@lm_head x dim=V weight="@@lm_head.weight") : (linear@embed_tokens x dim=V)
    logits <- logits / LOGIT_SOFTCAP
    logits <- tanh logits
    logits <- logits * LOGIT_SOFTCAP
    return logits, new_kv
  return logits, new_kv
