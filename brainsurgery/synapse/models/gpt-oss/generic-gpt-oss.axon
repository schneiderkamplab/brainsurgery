{-# CHECKPOINTS ["openai/gpt-oss-20b", "openai/gpt-oss-120b", "test/GPT-OSS-Test"] #-}
{-# TASK "causal_lm" #-}

import Attention (attention, merge_heads, reshape_heads)
import Activations (sigmoid, silu)
import Masking (causal_mask)
import Math (clamp, sqrt)
import Params (param)
import Positions (position_ids, rope_pair_hf_yarn)
import Cache
import Config
import NN
import Tensor



-- GPT-OSS-20B architecture and YaRN constants.
MODEL_DIM   = Config.int@@hidden_size default=2880                        -- residual hidden size
VOCAB_SIZE   = Config.int@@vocab_size default=201088                       -- tokenizer vocabulary size
NUM_LAYERS   = Config.int@@num_hidden_layers default=24                    -- decoder depth
NUM_HEADS   = Config.int@@num_attention_heads default=64                  -- query head count
KVH = Config.int@@num_key_value_heads default=8                   -- key/value head count
MODEL_HEAD_DIM  = Config.int@@head_dim default=64                             -- per-head hidden size
QD  = NUM_HEADS * MODEL_HEAD_DIM                                                       -- query projection width
KVD = KVH * MODEL_HEAD_DIM                                                     -- key/value projection width
E   = Config.int@@num_local_experts default=32                    -- total local experts
EPT = Config.int@@num_experts_per_tok default=4                   -- routed experts per token
MAX_POSITIONS   = Config.int@@max_position_embeddings default=131072          -- max context length
SW  = Config.int@@sliding_window default=128                      -- short-window attention size
EPS = Config.float@@rms_norm_eps default=1e-05                    -- RMSNorm epsilon
THETA = Config.float@@rope_theta default=150000.0                 -- base RoPE theta
ROPE_SCALE = Config.float @@'rope_scaling.factor' default=32.0 -- YaRN scaling factor
ROPE_LOW_FREQ = Config.float @@'rope_scaling.beta_slow' default=1.0 -- YaRN slow beta
ROPE_HIGH_FREQ = Config.float @@'rope_scaling.beta_fast' default=32.0 -- YaRN fast beta
ROPE_CONTEXT = Config.int @@'rope_scaling.original_max_position_embeddings' default=4096 -- YaRN train context
ROPE_ATTN_FACTOR = Config.float @@'rope_scaling.attention_factor' default=1.3465735902799727 -- YaRN attention factor
ATTN_SCALE = 1.0 / sqrt MODEL_HEAD_DIM                                          -- qk scaling
SWIGLU_LIMIT = Config.float@@swiglu_limit default=7.0             -- SwiGLU clamp threshold
SWIGLU_ALPHA = Config.float@@swiglu_alpha default=1.702           -- SwiGLU slope

rms :: Path -> Tensor[B,S,D] -> Tensor[B,S,D]
rms@path x = NN.rmsnorm@path x eps=EPS cast_float=true

grouped_ffn_gated :: Tensor[B,T,K,W] -> Float -> Float -> Tensor[B,T,K,H]
grouped_ffn_gated gate_up alpha limit = do
  b <- Tensor.size gate_up 0
  t <- Tensor.size gate_up 1
  k <- Tensor.size gate_up 2
  w <- Tensor.size gate_up -1
  h <- w / 2
  pair <- Tensor.reshape gate_up shape=[b, t, k, h, 2]
  gate <- Tensor.slice pair dim=-1 start=0 end=1 |> Tensor.reshape shape=[b, t, k, h]
  up <- Tensor.slice pair dim=-1 start=1 end=2 |> Tensor.reshape shape=[b, t, k, h]
  gate <- clamp gate max=limit
  up <- clamp up min=(0.0 - limit) max=limit
  return (up + 1.0) * (gate * sigmoid (gate * alpha))

grouped_ffn :: Tensor[B,T,D] -> Tensor[B,T,K] -> IdxTensor[B,T,K] -> ?Path -> ?Path -> ?Path -> ?Path -> ?Float -> ?Float -> ?Bool -> ?Bool -> ?Bool -> Tensor[B,T,D]
grouped_ffn hidden topk_scores topk_indices ?gate_up_weight=@experts.gate_up_proj.weight ?gate_up_bias=@experts.gate_up_proj.bias ?out_weight=@experts.down_proj.weight ?out_bias=@experts.down_proj.bias ?alpha=1.702 ?limit=7.0 ?has_bias=true ?has_gate=true ?transpose=true = do
  alpha <- (alpha == null) ? 1.702 : alpha
  limit <- (limit == null) ? 7.0 : limit
  has_bias <- (has_bias == null) ? true : has_bias
  has_gate <- (has_gate == null) ? true : has_gate
  transpose <- (transpose == null) ? true : transpose
  x_sel <- Tensor.unsqueeze hidden 2 |> Tensor.expand shape=[B, T, K, D]
  scale <- Tensor.unsqueeze topk_scores -1
  gate_up <- NN.expert_linear@w1 x_sel topk_indices dim=null bias=has_bias transpose=transpose weight_path=gate_up_weight bias_path=gate_up_bias
  ff <- has_gate ? (grouped_ffn_gated gate_up alpha limit) : (gate_up |> silu)
  x_upd <- NN.expert_linear@w2 ff topk_indices dim=null bias=has_bias transpose=transpose weight_path=out_weight bias_path=out_bias
  return Tensor.sum (x_upd * scale) dim=2 keepdim=false

gpt_oss_block :: Tensor[B,S,D] -> Int -> Tensor[B,S] -> ?Tensor[B,K] -> ?CacheLayer[B,KVH,P,DH] -> (Tensor[B,S,D], ?CacheLayer[B,KVH,K,DH])
gpt_oss_block x i pos_ids attn_mask past_kv = do
  xn <- rms@input_layernorm x
  a, new_kv <- scope@self_attn do
    q <- NN.linear@q_proj xn dim=QD bias=true |> reshape_heads heads=NUM_HEADS
    k <- NN.linear@k_proj xn dim=KVD bias=true |> reshape_heads heads=KVH
    v <- NN.linear@v_proj xn dim=KVD bias=true |> reshape_heads heads=KVH
    q, k <- rope_pair_hf_yarn q k pos_ids THETA ROPE_SCALE ROPE_LOW_FREQ ROPE_HIGH_FREQ ROPE_CONTEXT attention_factor=ROPE_ATTN_FACTOR truncate=false
    k_ctx, v_ctx, new_kv <- Cache.update past_kv k v
    k_ctx <- Tensor.repeat k_ctx repeats=(NUM_HEADS / KVH)
    v_ctx <- Tensor.repeat v_ctx repeats=(NUM_HEADS / KVH)
    window <- ((i % 2) == 1) ? MAX_POSITIONS : SW
    mask <- causal_mask q k_ctx window=window padding_mask=attn_mask
    sink <- param path=@sinks
    sink_base <- Tensor.reshape sink shape=[1, NUM_HEADS, 1, 1]
    sink_ref <- Tensor.slice q dim=-1 start=0 end=1
    sink_logits <- (sink_ref * 0.0) + sink_base
    a <- attention q k_ctx v_ctx mask scale=ATTN_SCALE sink_logits=sink_logits |> merge_heads
    a <- NN.linear@o_proj a dim=MODEL_DIM bias=true
    return a, new_kv
  x <- x + a

  xn <- rms@post_attention_layernorm x
  m <- scope@mlp do
    router_topk, topk_indices <- NN.linear@router xn dim=E bias=true |>
      Tensor.topk k=EPT dim=-1
    topk_scores <- Tensor.softmax router_topk dim=-1
    return grouped_ffn xn topk_scores topk_indices

  return x + m, new_kv

gpt_oss_20b :: TokenIds[B,S] -> ?Tensor[B,K] -> ?Cache[B,KVH,P,DH] -> ?Bool -> (Tensor[B,S,V], ?Cache[B,KVH,K,DH])
gpt_oss_20b input_ids attn_mask past_kv use_cache = do
  pos_ids <- position_ids input_ids attn_mask=attn_mask past_length=(Cache.past_length past_kv)
  x, new_kv <- scope@model do
    x <- NN.embedding@embed_tokens input_ids dim=MODEL_DIM
    new_kv <- use_cache ? Cache.init : null
    x, new_kv <- for@layers i <- [0..NUM_LAYERS) carry (x, new_kv) do
      past_i <- Cache.index past_kv i
      x, new_i <- gpt_oss_block x i pos_ids attn_mask past_i
      new_kv <- Cache.append new_kv new_i
      yield x, new_kv
    x <- rms@norm x
    return x, new_kv

  logits <- NN.linear@lm_head x dim=VOCAB_SIZE
  return logits, new_kv
