{-# CHECKPOINTS "openai/gpt-oss-120b" #-}
{-# TASK "causal_lm" #-}

import Activations
import Activations (sigmoid)
import Cache
import Cache
import MoE
import Attention (attention_with_sinks, reshape_heads, merge_heads)
import Masking (causal_mask)
import Positions (position_ids, rope_pair_hf_yarn)
import Params

D = 2880
V = 201088
L = 36
H = 64
KVH = 8
QD = 4096
KVD = 512
E = 128
EPT = 4
C = 131072
SW = 128
EPS = 1e-05
THETA = 150000.0
ROPE_SCALE = 32.0
ROPE_LOW_FREQ = 1.0
ROPE_HIGH_FREQ = 32.0
ROPE_CONTEXT = 4096
ROPE_ATTN_FACTOR = 1.3465735902799727
ATTN_SCALE = 0.125
SWIGLU_LIMIT = 7.0
SWIGLU_ALPHA = 1.702

rms :: @Path -> Tensor[B,S,D] -> Tensor[B,S,D]
rms@path x = NN.rmsnorm@path x eps=EPS cast_float=true

gpt_oss_block :: Tensor[B,S,D] -> Int -> Tensor[B,S] -> ?Tensor[B,S] -> ?CacheLayer -> (Tensor[B,S,D], ?CacheLayer)
gpt_oss_block x i pos_ids attn_mask past_kv = do
  xn <- rms@input_layernorm x
  a, new_kv <- scope@self_attn do
    q <- NN.linear@q_proj xn dim=QD bias=true |> reshape_heads heads=H
    k <- NN.linear@k_proj xn dim=KVD bias=true |> reshape_heads heads=KVH
    v <- NN.linear@v_proj xn dim=KVD bias=true |> reshape_heads heads=KVH
    q, k <- rope_pair_hf_yarn q k pos_ids THETA ROPE_SCALE ROPE_LOW_FREQ ROPE_HIGH_FREQ ROPE_CONTEXT attention_factor=ROPE_ATTN_FACTOR truncate=false
    k_ctx, v_ctx, new_kv <- Cache.update past_kv k v
    k_ctx <- Tensor.repeat k_ctx repeats=(H / KVH)
    v_ctx <- Tensor.repeat v_ctx repeats=(H / KVH)
    window <- ((i % 2) == 1) ? C : SW
    mask <- causal_mask q k_ctx window=window padding_mask=attn_mask
    sink <- Params.param path=@sinks
    a <- attention_with_sinks q k_ctx v_ctx mask sink scale=ATTN_SCALE |> merge_heads
    a <- NN.linear@o_proj a dim=D bias=true
    return a, new_kv
  x <- x + a
  xn <- rms@post_attention_layernorm x
  m <- scope@mlp do
    router_topk, topk_indices <- NN.linear@router xn dim=E bias=true |> Tensor.topk k=EPT dim=-1
    topk_scores <- Tensor.softmax router_topk dim=-1
    return MoE.grouped_ffn xn topk_scores topk_indices
  return x + m, new_kv

gpt_oss_20b :: TokenIds[B,S] -> ?Tensor[B,S] -> ?Cache -> ?Bool -> (Tensor[B,S,V], ?Cache)
gpt_oss_20b input_ids attn_mask past_kv use_cache = do
  pos_ids <- position_ids input_ids attn_mask=attn_mask past_length=(Cache.past_length past_kv)
  x, new_kv <- scope@model do
    x <- NN.embedding@embed_tokens input_ids dim=D
    new_kv <- use_cache ? Cache.init : null
    for@layers i <- [0..L) do
      past_i <- Cache.index past_kv i
      x, new_i <- gpt_oss_block x i pos_ids attn_mask past_i
      new_kv <- Cache.append new_kv new_i
    x <- rms@norm x
    return x, new_kv
  logits <- NN.linear@lm_head x dim=V
  return logits, new_kv
