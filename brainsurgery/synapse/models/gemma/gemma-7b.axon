{-# CHECKPOINTS ["google/gemma-7b", "google/gemma-7b-it"] #-}
{-# TASK "causal_lm" #-}

import Activations
import Activations (gelu)
import Attention
import Attention (attention, merge_heads, reshape_heads)
import Masking
import Masking (causal_mask)
import Math
import Math (mul)
import Params
import Params (has_root)
import Positions
import Positions (position_ids, rope_pair_base)
import Cache
import NN
import Tensor

HAS_LM_HEAD = has_root "lm_head"

rms :: Path -> Tensor[B,S,D] -> Tensor[B,S,D]
rms@path x = NN.rmsnorm@path x eps=1e-06 cast_float=true unit_offset=true

gemma_block :: Tensor[B,S,D] -> Tensor[B,S] -> ?Tensor[B,S] -> ?CacheLayer -> (Tensor[B,S,D], ?CacheLayer)
gemma_block x pos_ids attn_mask past_kv = do
  xn <- rms@input_layernorm x
  a, new_kv <- scope@self_attn do
    q <- NN.linear@q_proj xn dim=3072 |> reshape_heads heads=16
    k <- NN.linear@k_proj xn dim=4096 |> reshape_heads heads=16
    v <- NN.linear@v_proj xn dim=4096 |> reshape_heads heads=16
    q, k <- rope_pair_base q k pos_ids 10000.0
    k, v, new_kv <- Cache.update past_kv k v
    k <- Tensor.repeat k repeats=1
    v <- Tensor.repeat v repeats=1
    mask <- causal_mask q k window=8192 padding_mask=attn_mask
    a <- attention q k v mask |> merge_heads |> NN.linear@o_proj dim=3072
    return a, new_kv
  x <- x + a
  xn <- rms@post_attention_layernorm x
  m <- scope@mlp do
    g <- NN.linear@gate_proj xn dim=24576
    u <- NN.linear@up_proj xn dim=24576
    return gelu g |> mul u |> NN.linear@down_proj dim=3072
  return x + m, new_kv

gemma :: TokenIds[B,S] -> ?Tensor[B,S] -> ?Cache -> ?Bool -> (Tensor[B,S,V], ?Cache)
gemma input_ids attn_mask past_kv use_cache = do
  pos_ids <- position_ids input_ids past_length=(Cache.past_length past_kv)
  logits, new_kv <- scope@model do
    x <- NN.embedding@embed_tokens input_ids dim=3072 scale=55.42562584220407
    new_kv <- use_cache ? Cache.init : null
    for@layers i <- [0..28) do
      past_i <- Cache.index past_kv i
      x, new_i <- gemma_block x pos_ids attn_mask past_i
      new_kv <- Cache.append new_kv new_i
      yield x, new_kv
    x <- rms@norm x
    logits <- HAS_LM_HEAD ? (NN.linear@lm_head x dim=256000 weight_path=@@lm_head.weight) : (NN.linear@embed_tokens x dim=256000)
    return logits, new_kv
  return logits, new_kv
