{-# CHECKPOINTS ["google/gemma-2b", "google/gemma-2b-it", "google/gemma-7b", "google/gemma-7b-it"] #-}
{-# TASK "causal_lm" #-}

import Activations (gelu)
import Attention (attention, merge_heads, reshape_heads)
import Masking (causal_mask_for_input)
import Math (mul, sqrt)
import Params (has_root)
import Positions (position_ids, rope_base_factors, rope_pair_base_factors)
import Cache (Cache, CacheLayer)
import Config
import NN
import Tensor



MODEL_DIM = Config.int @@hidden_size default=3072
VOCAB_SIZE = Config.int @@vocab_size default=256000
NUM_LAYERS = Config.int @@num_hidden_layers default=28
NUM_HEADS = Config.int @@num_attention_heads default=16
KVH = Config.int @@num_key_value_heads default=16
HAS_HEAD_DIM = Config.has_value @@head_dim
MODEL_HEAD_DIM = HAS_HEAD_DIM ? (Config.int @@head_dim default=256) : (MODEL_DIM / NUM_HEADS)
QD = NUM_HEADS * MODEL_HEAD_DIM
KVD = KVH * MODEL_HEAD_DIM
FFN = Config.int @@intermediate_size default=24576
EPS = Config.float @@rms_norm_eps default=1e-06
THETA = Config.float @@rope_theta default=10000.0
MAX_POSITIONS = Config.int @@max_position_embeddings default=8192
HAS_LM_HEAD = has_root "lm_head"

rms :: Path -> Tensor[B,S,D] -> Tensor[B,S,D]
rms@path x = NN.rmsnorm@path x eps=EPS cast_float=true unit_offset=true

gemma_block :: Tensor[B,S,D] -> Tensor[B,1,S,MODEL_HEAD_DIM] -> Tensor[B,1,S,MODEL_HEAD_DIM] -> Tensor[B,1,S,K] -> ?CacheLayer[B,H,P,DH] -> (Tensor[B,S,D], ?CacheLayer[B,H,K,DH])
gemma_block x rope_sin rope_cos mask past_kv = do
  xn <- rms@input_layernorm x
  a, new_kv <- scope@self_attn do
    q <- NN.linear@q_proj xn dim=QD |> reshape_heads heads=NUM_HEADS
    k <- NN.linear@k_proj xn dim=KVD |> reshape_heads heads=KVH
    v <- NN.linear@v_proj xn dim=KVD |> reshape_heads heads=KVH
    q, k <- rope_pair_base_factors q k rope_sin rope_cos
    k, v, new_kv <- Cache.update past_kv k v
    k <- Tensor.repeat k repeats=(NUM_HEADS / KVH)
    v <- Tensor.repeat v repeats=(NUM_HEADS / KVH)
    a <- attention q k v mask |> merge_heads |> NN.linear@o_proj dim=MODEL_DIM
    return a, new_kv
  x <- x + a
  xn <- rms@post_attention_layernorm x
  m <- scope@mlp do
    g <- NN.linear@gate_proj xn dim=FFN
    u <- NN.linear@up_proj xn dim=FFN
    return gelu g |> mul u |> NN.linear@down_proj dim=MODEL_DIM
  return x + m, new_kv

gemma :: Tensor.TokenIds[B,S] -> ?Tensor[B,K] -> ?Cache[B,H,P,DH] -> ?Bool -> (Tensor[B,S,V], ?Cache[B,H,K,DH])
gemma input_ids attn_mask past_kv use_cache = do
  past_length <- Cache.past_length past_kv
  pos_ids <- position_ids input_ids attn_mask=attn_mask past_length=past_length
  rope_sin, rope_cos <- ((rope_base_factors pos_ids MODEL_HEAD_DIM THETA) :: (Tensor[B,1,S,MODEL_HEAD_DIM], Tensor[B,1,S,MODEL_HEAD_DIM]))
  key_len <- past_length + S
  mask <- causal_mask_for_input input_ids key_len padding_mask=attn_mask window=MAX_POSITIONS
  logits, new_kv <- scope@model do
    emb_scale <- _sqrt (Config.float @@hidden_size default=3072.0)
    x <- NN.embedding@embed_tokens input_ids dim=MODEL_DIM scale=emb_scale
    new_kv <- use_cache ? Cache.init : null
    x, new_kv <- for@layers i <- [0..NUM_LAYERS) carry (x, new_kv) do
      past_i <- Cache.index past_kv i
      x, new_i <- gemma_block x rope_sin rope_cos mask past_i
      new_kv <- Cache.append new_kv new_i
      yield x, new_kv
    x <- rms@norm x
    logits <- HAS_LM_HEAD ? (NN.linear@lm_head x dim=VOCAB_SIZE weight_path=@@lm_head.weight) : (NN.linear@embed_tokens x dim=VOCAB_SIZE)
    return logits, new_kv
  return logits, new_kv
