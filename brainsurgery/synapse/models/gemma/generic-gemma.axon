{-# CHECKPOINTS ["google/gemma-2b", "google/gemma-2b-it", "google/gemma-7b", "google/gemma-7b-it"] #-}
{-# TASK "causal_lm" #-}

import Activations (gelu)
import Attention (attention, merge_heads, reshape_heads)
import Masking (causal_mask)
import Math (mul, sqrt)
import Params (has_root)
import Positions (position_ids, rope_pair_base)



D = Config.int@hidden_size default=3072
V = Config.int@vocab_size default=256000
L = Config.int@num_hidden_layers default=28
H = Config.int@num_attention_heads default=16
KVH = Config.int@num_key_value_heads default=16
HAS_HEAD_DIM = Config.has_value@head_dim
HD = HAS_HEAD_DIM ? (Config.int@head_dim default=256) : (D / H)
KVD = KVH * HD
FFN = Config.int@intermediate_size default=24576
EPS = Config.float@rms_norm_eps default=1e-06
THETA = Config.float@rope_theta default=10000.0
C = Config.int@max_position_embeddings default=8192
EMB_SCALE = sqrt D
HAS_LM_HEAD = has_root "lm_head"

rms :: Path -> Tensor[B,S,D] -> Tensor[B,S,D]
rms@path x = NN.rmsnorm@path x eps=EPS cast_float=true unit_offset=true

gemma_block :: Tensor[B,S,D] -> Tensor[B,S] -> ?Tensor[B,S] -> ?CacheLayer -> (Tensor[B,S,D], ?CacheLayer)
gemma_block x pos_ids attn_mask past_kv = do
  xn <- rms@input_layernorm x
  a, new_kv <- scope@self_attn do
    q <- NN.linear@q_proj xn dim=D |> reshape_heads heads=H
    k <- NN.linear@k_proj xn dim=KVD |> reshape_heads heads=KVH
    v <- NN.linear@v_proj xn dim=KVD |> reshape_heads heads=KVH
    q, k <- rope_pair_base q k pos_ids THETA
    k, v, new_kv <- Cache.update past_kv k v
    k <- Tensor.repeat k repeats=(H / KVH)
    v <- Tensor.repeat v repeats=(H / KVH)
    mask <- causal_mask q k window=C padding_mask=attn_mask
    a <- attention q k v mask |> merge_heads |> NN.linear@o_proj dim=D
    return a, new_kv
  x <- x + a
  xn <- rms@post_attention_layernorm x
  m <- scope@mlp do
    g <- NN.linear@gate_proj xn dim=FFN
    u <- NN.linear@up_proj xn dim=FFN
    return gelu g |> mul u |> NN.linear@down_proj dim=D
  return x + m, new_kv

gemma :: TokenIds[B,S] -> ?Tensor[B,S] -> ?Cache -> ?Bool -> (Tensor[B,S,V], ?Cache)
gemma input_ids attn_mask past_kv use_cache = do
  pos_ids <- position_ids input_ids past_length=(Cache.past_length past_kv)
  logits, new_kv <- scope@model do
    x <- NN.embedding@embed_tokens input_ids dim=D scale=EMB_SCALE
    new_kv <- use_cache ? Cache.init : null
    x, new_kv <- for@layers i <- [0..L) carry (x, new_kv) do
      past_i <- Cache.index past_kv i
      x, new_i <- gemma_block x pos_ids attn_mask past_i
      new_kv <- Cache.append new_kv new_i
      yield x, new_kv
    x <- rms@norm x
    logits <- HAS_LM_HEAD ? (NN.linear@lm_head x dim=V weight_path=@@lm_head.weight) : (NN.linear@embed_tokens x dim=V)
    return logits, new_kv
  return logits, new_kv
