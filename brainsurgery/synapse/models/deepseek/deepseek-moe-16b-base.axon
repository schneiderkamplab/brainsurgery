{-# CHECKPOINTS ["deepseek-ai/deepseek-moe-16b-base", "deepseek-ai/deepseek-moe-16b-chat"] #-}
{-# TASK "causal_lm" #-}
{-# PADDING_SIDE "right" #-}

import Activations
import Activations (silu)
import Attention
import Attention (attention, merge_heads, reshape_heads)
import Masking
import Masking (causal_mask)
import Math
import Math (mul)
import MoE
import MoE (scatter_add, select)
import Positions
import Positions (position_ids, rope_pair_base)
import Cache
import NN
import Tensor

rms :: Path -> Tensor[B,S,D] -> Tensor[B,S,D]
rms@path x = NN.rmsnorm@path x eps=1e-06 cast_float=true

deepseek_v1_attn :: Tensor[B,S,D] -> Tensor[B,S] -> ?Tensor[B,S] -> ?CacheLayer -> (Tensor[B,S,D], ?CacheLayer)
deepseek_v1_attn x pos_ids attn_mask past_kv = do
  a, new_kv <- scope@self_attn do
    q <- NN.linear@q_proj x dim=2048 bias=false |> reshape_heads heads=16
    k <- NN.linear@k_proj x dim=2048 bias=false |> reshape_heads heads=16
    v <- NN.linear@v_proj x dim=2048 bias=false |> reshape_heads heads=16
    q, k <- rope_pair_base q k pos_ids theta=10000.0 interleaved=false
    k_all, v_all, new_kv <- Cache.update past_kv k v
    k_all <- Tensor.repeat k_all repeats=1
    v_all <- Tensor.repeat v_all repeats=1
    mask <- causal_mask q k_all padding_mask=attn_mask early_exit=true
    a <- attention q k_all v_all mask |> merge_heads
    a <- NN.linear@o_proj a dim=2048 bias=false
    return a, new_kv
  return a, new_kv

deepseek_v1_dense_block :: Tensor[B,S,D] -> Tensor[B,S] -> ?Tensor[B,S] -> ?CacheLayer -> (Tensor[B,S,D], ?CacheLayer)
deepseek_v1_dense_block x pos_ids attn_mask past_kv = do
  xn <- rms@input_layernorm x
  a, new_kv <- deepseek_v1_attn xn pos_ids attn_mask past_kv
  x <- x + a
  xn <- rms@post_attention_layernorm x
  m <- scope@mlp do
    gate <- NN.linear@gate_proj xn dim=10944 bias=false
    up <- NN.linear@up_proj xn dim=10944 bias=false
    return gate |> silu |> mul up |> NN.linear@down_proj dim=2048 bias=false
  return x + m, new_kv

deepseek_v1_moe_block :: Tensor[B,S,D] -> Tensor[B,S] -> ?Tensor[B,S] -> ?CacheLayer -> (Tensor[B,S,D], ?CacheLayer)
deepseek_v1_moe_block x pos_ids attn_mask past_kv = do
  xn <- rms@input_layernorm x
  a, new_kv <- deepseek_v1_attn xn pos_ids attn_mask past_kv
  x <- x + a
  xn <- rms@post_attention_layernorm x
  m <- scope@mlp do
    shared <- scope@shared_experts do
      gate <- NN.linear@gate_proj xn dim=2816 bias=false
      up <- NN.linear@up_proj xn dim=2816 bias=false
      return gate |> silu |> mul up |> NN.linear@down_proj dim=2048 bias=false
    topk_scores, topk_indices <- NN.linear@gate xn dim=64 bias=false |> Tensor.softmax dim=-1 dtype="float32" |> Tensor.topk k=6 dim=-1 sorted=false
    routed <- Tensor.zeros_like xn
    for@experts e <- [0..64) do
      x_sel, token_idx, topk_pos, sel_scores <- select xn topk_scores topk_indices e
      gate <- NN.linear@gate_proj x_sel dim=1408 bias=false
      up <- NN.linear@up_proj x_sel dim=1408 bias=false
      x_upd <- gate |> silu |> mul up |> NN.linear@down_proj dim=2048 bias=false
      routed <- scatter_add routed token_idx x_upd sel_scores
      yield routed
    return shared + routed
  return x + m, new_kv

deepseek_v1 :: TokenIds[B,S] -> ?Tensor[B,S] -> ?Cache -> ?Bool -> (Tensor[B,S,V], ?Cache)
deepseek_v1 input_ids attn_mask past_kv use_cache = do
  pos_ids <- position_ids input_ids past_length=(Cache.past_length past_kv)
  x, new_kv <- scope@model do
    x <- NN.embedding@embed_tokens input_ids dim=2048
    new_kv <- use_cache ? Cache.init : null
    for@layers i <- [0..1) do
      past_i <- Cache.index past_kv i
      x, new_i <- deepseek_v1_dense_block x pos_ids attn_mask past_i
      new_kv <- Cache.append new_kv new_i
      yield x, new_kv
    for@layers i <- [1..28) do
      past_i <- Cache.index past_kv i
      x, new_i <- deepseek_v1_moe_block x pos_ids attn_mask past_i
      new_kv <- Cache.append new_kv new_i
      yield x, new_kv
    x <- rms@norm x
    return x, new_kv
  logits <- NN.linear@lm_head x dim=102400 bias=false
  return logits, new_kv
