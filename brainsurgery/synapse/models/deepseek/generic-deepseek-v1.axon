{-# CHECKPOINTS ["deepseek-ai/deepseek-moe-16b-base", "deepseek-ai/deepseek-moe-16b-chat"] #-}
{-# TASK "causal_lm" #-}
{-# padding_side "right" #-}

import Config
import Activations silu
import Cache past_length
import Cache
import MoE

D     = Config.int "hidden_size" default=2048
V     = Config.int "vocab_size" default=102400
L     = Config.int "num_hidden_layers" default=28
H     = Config.int "num_attention_heads" default=16
KVH   = Config.int "num_key_value_heads" default=16
HD    = D / H
FFN   = Config.int "intermediate_size" default=10944
E     = Config.int "n_routed_experts" default=64
EPT   = Config.int "num_experts_per_tok" default=6
EM    = Config.int "moe_intermediate_size" default=1408
SE    = Config.int "n_shared_experts" default=2
EPS   = Config.float "rms_norm_eps" default=1e-06
THETA = Config.float "rope_theta" default=10000.0
C     = Config.int "max_position_embeddings" default=4096
FIRST_DENSE = Config.int "first_k_dense_replace" default=1

rms :: @Path -> Tensor[B,S,D] -> Tensor[B,S,D]
rms@path x = rmsnorm@path x eps=EPS cast_float=true

deepseek_v1_attn :: Tensor[B,S,D] -> Tensor[B,S] -> ?Tensor[B,S] -> ?CacheLayer -> (Tensor[B,S,D], ?CacheLayer)
deepseek_v1_attn x pos_ids attn_mask past_kv = do
  a, new_kv <- scope@self_attn do
    q <- linear@q_proj x dim=D bias=false |> reshape_heads heads=H
    k <- linear@k_proj x dim=(KVH * HD) bias=false |> reshape_heads heads=KVH
    v <- linear@v_proj x dim=(KVH * HD) bias=false |> reshape_heads heads=KVH
    q, k <- rope_pair q k position_ids=pos_ids theta=THETA interleaved=false truncate=false
    k_all, v_all, new_kv <- Cache.update past_kv k v
    k_all <- repeat k_all (H / KVH)
    v_all <- repeat v_all (H / KVH)
    mask <- causal_mask q k_all padding_mask=attn_mask early_exit=true
    a <- attention q k_all v_all mask=mask eager=false |> merge_heads
    a <- linear@o_proj a dim=D bias=false
    return a, new_kv
  return a, new_kv

deepseek_v1_dense_block :: Tensor[B,S,D] -> Tensor[B,S] -> ?Tensor[B,S] -> ?CacheLayer -> (Tensor[B,S,D], ?CacheLayer)
deepseek_v1_dense_block x pos_ids attn_mask past_kv = do
  xn <- rms@input_layernorm x
  a, new_kv <- deepseek_v1_attn xn pos_ids attn_mask past_kv
  x <- x + a
  xn <- rms@post_attention_layernorm x
  m <- scope@mlp do
    gate <- linear@gate_proj xn dim=FFN bias=false
    up <- linear@up_proj xn dim=FFN bias=false
    return gate |> silu |> mul up |> linear@down_proj dim=D bias=false
  return x + m, new_kv

deepseek_v1_moe_block :: Tensor[B,S,D] -> Tensor[B,S] -> ?Tensor[B,S] -> ?CacheLayer -> (Tensor[B,S,D], ?CacheLayer)
deepseek_v1_moe_block x pos_ids attn_mask past_kv = do
  xn <- rms@input_layernorm x
  a, new_kv <- deepseek_v1_attn xn pos_ids attn_mask past_kv
  x <- x + a
  xn <- rms@post_attention_layernorm x
  m <- scope@mlp do
    shared <- scope@shared_experts do
      gate <- linear@gate_proj xn dim=(EM * SE) bias=false
      up <- linear@up_proj xn dim=(EM * SE) bias=false
      return gate |> silu |> mul up |> linear@down_proj dim=D bias=false
    topk_scores, topk_indices <- linear@gate xn dim=E bias=false |>
      softmax dim=-1 dtype=float32 |> topk k=EPT dim=-1 sorted=false
    routed <- zeros_like xn
    for@experts e <- [0..E) do
      x_sel, token_idx, topk_pos, sel_scores <- MoE.select xn topk_scores topk_indices e
      gate <- _linear@gate_proj x_sel dim=EM bias=false
      up <- _linear@up_proj x_sel dim=EM bias=false
      x_upd <- gate |> silu |> mul up |> _linear@down_proj dim=D bias=false
      routed <- MoE.scatter_add routed token_idx x_upd sel_scores
    return shared + routed
  return x + m, new_kv

deepseek_v1 :: TokenIds[B,S] -> ?Tensor[B,S] -> ?Cache -> ?Bool -> (Tensor[B,S,V], ?Cache)
deepseek_v1 input_ids attn_mask past_kv use_cache = do
  pos_ids <- position_ids input_ids attn_mask past_length=(past_length past_kv) use_attention_mask=false
  x, new_kv <- scope@model do
    x <- embedding@embed_tokens input_ids dim=D
    new_kv <- use_cache ? Cache.init : null
    for@layers i <- [0..FIRST_DENSE) do
      past_i <- Cache.index past_kv i
      x, new_i <- deepseek_v1_dense_block x pos_ids attn_mask past_i
      new_kv <- Cache.append new_kv new_i
    for@layers i <- [FIRST_DENSE..L) do
      past_i <- Cache.index past_kv i
      x, new_i <- deepseek_v1_moe_block x pos_ids attn_mask past_i
      new_kv <- Cache.append new_kv new_i
    x <- rms@norm x
    return x, new_kv
  logits <- linear@lm_head x dim=V bias=false
  return logits, new_kv
