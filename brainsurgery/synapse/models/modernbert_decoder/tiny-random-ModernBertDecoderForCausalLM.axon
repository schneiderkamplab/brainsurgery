{-# CHECKPOINTS "onnx-internal-testing/tiny-random-ModernBertDecoderForCausalLM" #-}

{-# TASK "causal_lm" #-}

{-# MAIN "modernbert_decoder" #-}

import Activations (gelu)

import Attention (attention, merge_heads, reshape_heads)

import Cache

import Config

import List

import Masking (Mask, causal_mask_for_input, mask_for_input, mask_length_for_input)

import Math (mul)

import NN

import Positions (position_ids, rope_base_factors, rope_pair_base_factors)

import Tensor

MODEL_DIM <- (32 :: Dim)

FFN <- (32 :: Dim)

NUM_LAYERS <- (2 :: Dim)

NUM_HEADS <- (4 :: Dim)

HEAD_DIM <- MODEL_DIM / NUM_HEADS

VOCAB_SIZE <- (50368 :: Dim)

MAX_POSITIONS <- (7999 :: Dim)

SLIDING_WINDOW <- (64 :: Dim)

GLOBAL_THETA <- 160000.0

LOCAL_THETA <- 160000.0

EPS <- 1e-05

ATTENTION_BIAS <- false

MLP_BIAS <- false

NORM_BIAS <- false

DECODER_BIAS <- true

LAYER_TYPES <- ((["full_attention", "sliding_attention"]) :: List[String])

modernbert_decoder_block :: Tensor[B,S,D] -> Tensor[B,1,S,R] -> Tensor[B,1,S,R] -> Tensor[B,1,S,R] -> Tensor[B,1,S,R] -> Tensor[B,1,S,K] -> Tensor[B,1,S,K] -> Bool -> Bool -> ?CacheLayer[B,NUM_HEADS,P,MAX_POSITIONS,DH] -> (Tensor[B,S,D], ?CacheLayer[B,NUM_HEADS,K,MAX_POSITIONS,DH])
modernbert_decoder_block x global_sin global_cos local_sin local_cos full_mask local_mask first sliding past_kv = do
  residual <- x
  xn <- first ? x : (NN.layernorm@attn_norm x eps=EPS bias=NORM_BIAS)
  a, new_kv <- scope@attn do
    q <- NN.linear@q_proj xn dim=MODEL_DIM bias=ATTENTION_BIAS |> reshape_heads heads=NUM_HEADS
    k <- NN.linear@k_proj xn dim=MODEL_DIM bias=ATTENTION_BIAS |> reshape_heads heads=NUM_HEADS
    v <- NN.linear@v_proj xn dim=MODEL_DIM bias=ATTENTION_BIAS |> reshape_heads heads=NUM_HEADS
    q, k <- sliding ? (rope_pair_base_factors q k local_sin local_cos) : (rope_pair_base_factors q k global_sin global_cos)
    k, v, new_kv <- Cache.update past_kv k v
    mask <- sliding ? local_mask : full_mask
    a <- attention q k v mask
    return merge_heads a |> NN.linear@Wo dim=MODEL_DIM bias=ATTENTION_BIAS, new_kv
  x <- residual + a
  residual <- x
  xn <- NN.layernorm@mlp_norm x eps=EPS bias=NORM_BIAS
  pair <- NN.linear@mlp.Wi xn dim=(2 * FFN) bias=MLP_BIAS
  act, gate <- Tensor.split pair sizes=[FFN, FFN]
  m <- act |> gelu |> mul gate |> NN.linear@mlp.Wo dim=MODEL_DIM bias=MLP_BIAS
  return residual + m, new_kv

modernbert_decoder :: TokenIds[B,S] -> ?Mask[B,K,MAX_POSITIONS] -> ?Cache[B,NUM_HEADS,P,MAX_POSITIONS,DH] -> ?Bool -> (Tensor[B,S,V], ?Cache[B,NUM_HEADS,K,MAX_POSITIONS,DH])
modernbert_decoder input_ids attn_mask past_kv use_cache = do
  past_length <- Cache.past_length past_kv
  attn_mask <- mask_for_input input_ids attn_mask MAX_POSITIONS
  pos_ids <- position_ids input_ids past_length=past_length
  global_sin, global_cos <- rope_base_factors pos_ids HEAD_DIM GLOBAL_THETA
  local_sin, local_cos <- rope_base_factors pos_ids HEAD_DIM LOCAL_THETA
  key_len <- mask_length_for_input input_ids attn_mask past_length
  full_mask <- causal_mask_for_input input_ids key_len padding_mask=attn_mask window=MAX_POSITIONS
  local_mask <- causal_mask_for_input input_ids key_len padding_mask=attn_mask window=SLIDING_WINDOW
  work_kv <- Cache.prepare past_kv use_cache MAX_POSITIONS
  read_kv <- Cache.read past_kv work_kv
  x <- scope@model do
    x <- NN.embedding@embeddings.tok_embeddings input_ids dim=MODEL_DIM
    x <- NN.layernorm@embeddings.norm x eps=EPS bias=NORM_BIAS
    x, work_kv <- for@layers i <- [0..NUM_LAYERS) carry (x, work_kv) do
      layer_type <- ((List.index LAYER_TYPES i) :: String)
      sliding <- layer_type == "sliding_attention"
      past_i <- Cache.index read_kv i
      x, new_i <- modernbert_decoder_block x global_sin global_cos local_sin local_cos full_mask local_mask (i == 0) sliding past_i
      work_kv <- Cache.append work_kv new_i
      yield x, work_kv
    return NN.layernorm@final_norm x eps=EPS bias=NORM_BIAS
  new_kv <- Cache.finish work_kv key_len
  new_kv <- use_cache ? new_kv : null
  x <- NN.linear@lm_head.dense x dim=MODEL_DIM bias=false |> gelu |> NN.layernorm@lm_head.norm eps=EPS bias=NORM_BIAS
  logits <- NN.linear@@decoder x dim=VOCAB_SIZE bias=DECODER_BIAS weight_path=@@model.embeddings.tok_embeddings.weight bias_path=@@decoder.bias
  return logits, new_kv
