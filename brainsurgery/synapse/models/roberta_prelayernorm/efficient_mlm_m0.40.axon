{-# CHECKPOINTS "andreasmadsen/efficient_mlm_m0.40" #-}

{-# TASK "masked_lm" #-}

{-# MAIN "roberta_prelayernorm" #-}

import Activations (gelu)

import Attention (attention, merge_heads, reshape_heads)

import Masking (Mask, bidirectional_mask_for_input, mask_for_input)

import Positions (position_ids)

import Config

import NN

MODEL_DIM <- 1024

VOCAB_SIZE <- 50265

NUM_LAYERS <- 24

NUM_HEADS <- 16

FFN <- 4096

EPS <- 1e-05

PAD <- 1

roberta_prelayernorm_block :: Tensor[B,S,D] -> Tensor[B,1,S,S] -> Tensor[B,S,D]
roberta_prelayernorm_block x keep = do
  xn <- NN.layernorm@attention.LayerNorm x eps=EPS
  a <- scope@attention do
    q <- NN.linear@self.query xn dim=MODEL_DIM bias=true |> reshape_heads heads=NUM_HEADS
    k <- NN.linear@self.key xn dim=MODEL_DIM bias=true |> reshape_heads heads=NUM_HEADS
    v <- NN.linear@self.value xn dim=MODEL_DIM bias=true |> reshape_heads heads=NUM_HEADS
    return attention q k v keep |> merge_heads |> NN.linear@output.dense dim=MODEL_DIM bias=true
  x <- x + a
  xn <- NN.layernorm@intermediate.LayerNorm x eps=EPS
  m <- NN.linear@intermediate.dense xn dim=FFN bias=true |> gelu
  m <- NN.linear@output.dense m dim=MODEL_DIM bias=true
  return x + m

roberta_prelayernorm :: TokenIds[B,S] -> ?Mask[B,S,S] -> Tensor[B,S,V]
roberta_prelayernorm input_ids attn_mask = do
  attn_mask <- mask_for_input input_ids attn_mask S
  pos_base <- position_ids input_ids attn_mask=attn_mask pad_fill=-1
  pos_ids <- pos_base + PAD + 1
  keep <- bidirectional_mask_for_input input_ids S padding_mask=attn_mask
  tok_type_ids <- input_ids - input_ids
  tok <- NN.embedding@roberta_prelayernorm.embeddings.word_embeddings input_ids dim=MODEL_DIM
  pos <- NN.embedding@roberta_prelayernorm.embeddings.position_embeddings pos_ids dim=MODEL_DIM
  typ <- NN.embedding@roberta_prelayernorm.embeddings.token_type_embeddings tok_type_ids dim=MODEL_DIM
  x <- tok + pos
  x <- x + typ
  x <- NN.layernorm@roberta_prelayernorm.embeddings.LayerNorm x eps=EPS
  x <- for@roberta_prelayernorm.encoder.layer i <- [0..NUM_LAYERS) carry (x) do
    x <- roberta_prelayernorm_block x keep
    yield x
  x <- NN.layernorm@roberta_prelayernorm.LayerNorm x eps=EPS
  logits <- scope@lm_head do
    x <- NN.linear@dense x dim=MODEL_DIM bias=true |> gelu
    x <- NN.layernorm@layer_norm x eps=EPS
    return NN.linear@decoder x dim=VOCAB_SIZE bias=true weight_path=@@roberta_prelayernorm.embeddings.word_embeddings.weight bias_path=@@lm_head.bias
  return logits
