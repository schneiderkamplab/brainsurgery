{-# CHECKPOINTS "test/SolarOpen-Test" #-}

{-# TASK "causal_lm" #-}

{-# MAIN "solar_open" #-}

import Activations (silu)

import Attention (attention, merge_heads, reshape_heads)

import Cache

import Config

import Masking (Mask, causal_mask_for_input, mask_for_input, mask_length_for_input)

import Math (mul)

import MoE (grouped_sigmoid_router, grouped_swiglu_ffn_separate)

import NN

import Positions (position_ids, rope_pair_base_factors, rope_yarn_factors_for_position_ids)

import Tensor

MODEL_DIM <- (128 :: Dim)

MOE_FFN <- (64 :: Dim)

NUM_LAYERS <- (4 :: Dim)

NUM_HEADS <- (4 :: Dim)

KV_HEADS <- (2 :: Dim)

HEAD_DIM <- Config.dim @@head_dim default=(MODEL_DIM / NUM_HEADS)

QD <- NUM_HEADS * HEAD_DIM

KVD <- KV_HEADS * HEAD_DIM

VOCAB_SIZE <- (65536 :: Dim)

MAX_POSITIONS <- (1024 :: Dim)

EPS <- 1e-05

THETA <- 1000000.0

ROPE_FACTOR <- 2.0

ROPE_BETA_FAST <- 32.0

ROPE_BETA_SLOW <- 1.0

ROPE_CONTEXT <- (256 :: Dim)

ROPE_MSCALE <- 1.0

ROPE_MSCALE_ALL_DIM <- 0.0

ATTENTION_BIAS <- false

NUM_EXPERTS <- (4 :: Dim)

TOP_K <- (2 :: Dim)

NUM_GROUPS <- (1 :: Dim)

TOPK_GROUPS <- (1 :: Dim)

NORM_TOPK <- true

ROUTE_SCALE <- 1.0

SHARED_EXPERTS <- (1 :: Dim)

TIE <- false

solar_open_moe :: Tensor[B,S,D] -> Tensor[B,S,D]
solar_open_moe x = do
  scores, indices <- grouped_sigmoid_router@gate x NUM_EXPERTS TOP_K n_group=NUM_GROUPS topk_group=TOPK_GROUPS norm_topk_prob=NORM_TOPK routed_scaling_factor=ROUTE_SCALE
  routed <- grouped_swiglu_ffn_separate x scores indices NUM_EXPERTS MOE_FFN gate_weight=@experts.gate_proj.weight up_weight=@experts.up_proj.weight out_weight=@experts.down_proj.weight
  shared <- scope@shared_experts do
    gate <- NN.linear@gate_proj x dim=(MOE_FFN * SHARED_EXPERTS) bias=false |> silu
    up <- NN.linear@up_proj x dim=(MOE_FFN * SHARED_EXPERTS) bias=false
    return gate |> mul up |> NN.linear@down_proj dim=MODEL_DIM bias=false
  return routed + shared

solar_open_block :: Tensor[B,S,D] -> Tensor[B,1,S,R] -> Tensor[B,1,S,R] -> Tensor[B,1,S,K] -> ?CacheLayer[B,KV_HEADS,P,MAX_POSITIONS,HEAD_DIM] -> (Tensor[B,S,D], ?CacheLayer[B,KV_HEADS,K,MAX_POSITIONS,HEAD_DIM])
solar_open_block x rope_sin rope_cos mask past_kv = do
  xn <- NN.rmsnorm@input_layernorm x eps=EPS cast_float=true
  a, new_kv <- scope@self_attn do
    q <- NN.linear@q_proj xn dim=QD bias=ATTENTION_BIAS |> reshape_heads heads=NUM_HEADS
    k <- NN.linear@k_proj xn dim=KVD bias=ATTENTION_BIAS |> reshape_heads heads=KV_HEADS
    v <- NN.linear@v_proj xn dim=KVD bias=ATTENTION_BIAS |> reshape_heads heads=KV_HEADS
    q, k <- rope_pair_base_factors q k rope_sin rope_cos
    k, v, new_kv <- Cache.update past_kv k v
    k <- Tensor.repeat k repeats=(NUM_HEADS / KV_HEADS)
    v <- Tensor.repeat v repeats=(NUM_HEADS / KV_HEADS)
    a <- attention q k v mask |> merge_heads |> NN.linear@o_proj dim=MODEL_DIM bias=false
    return a, new_kv
  x <- x + a
  xn <- NN.rmsnorm@post_attention_layernorm x eps=EPS cast_float=true
  m <- scope@mlp do
    return solar_open_moe xn
  return x + m, new_kv

solar_open :: TokenIds[B,S] -> ?Mask[B,K,MAX_POSITIONS] -> ?Cache[B,KV_HEADS,P,MAX_POSITIONS,HEAD_DIM] -> ?Bool -> (Tensor[B,S,V], ?Cache[B,KV_HEADS,K,MAX_POSITIONS,HEAD_DIM])
solar_open input_ids attn_mask past_kv use_cache = do
  past_length <- Cache.past_length past_kv
  attn_mask <- mask_for_input input_ids attn_mask MAX_POSITIONS
  pos_ids <- position_ids input_ids attn_mask=attn_mask past_length=past_length pad_fill=1
  rope_sin, rope_cos <- rope_yarn_factors_for_position_ids pos_ids HEAD_DIM THETA ROPE_FACTOR ROPE_BETA_FAST ROPE_BETA_SLOW ROPE_CONTEXT mscale=ROPE_MSCALE mscale_all_dim=ROPE_MSCALE_ALL_DIM
  key_len <- mask_length_for_input input_ids attn_mask past_length
  mask <- causal_mask_for_input input_ids key_len padding_mask=attn_mask window=MAX_POSITIONS
  work_kv <- Cache.prepare past_kv use_cache MAX_POSITIONS
  read_kv <- Cache.read past_kv work_kv
  x, work_kv <- scope@model do
    x <- NN.embedding@embed_tokens input_ids dim=MODEL_DIM
    x, work_kv <- for@layers i <- [0..NUM_LAYERS) carry (x, work_kv) do
      past_i <- Cache.index read_kv i
      x, new_i <- solar_open_block x rope_sin rope_cos mask past_i
      work_kv <- Cache.append work_kv new_i
      yield x, work_kv
    x <- NN.rmsnorm@norm x eps=EPS cast_float=true
    return x, work_kv
  new_kv <- Cache.finish work_kv key_len
  new_kv <- use_cache ? new_kv : null
  logits <- TIE ? (NN.linear@model.embed_tokens x dim=VOCAB_SIZE bias=false) : (NN.linear@@lm_head x dim=VOCAB_SIZE bias=false)
  return logits, new_kv
