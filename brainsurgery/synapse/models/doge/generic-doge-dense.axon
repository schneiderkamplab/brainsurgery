{-# CHECKPOINTS ["SmallDoge/Doge-20M", "SmallDoge/Doge-60M", "SmallDoge/Doge-320M"] #-}
{-# TASK "causal_lm" #-}
{-# MAIN "small_doge" #-}

import Activations (silu)
import Attention (attention, merge_heads, reshape_heads)
import Cache
import Config
import Masking (Mask, causal_mask_for_input, mask_for_input, mask_length_for_input)
import Math (exp, log, mul)
import NN
import Params (param)
import Positions (position_ids, rope_base_factors, rope_pair_base_factors)
import Tensor

MODEL_DIM <- Config.dim @@hidden_size default=256
FFN <- Config.dim @@intermediate_size default=512
NUM_LAYERS <- Config.dim @@num_hidden_layers default=8
NUM_HEADS <- Config.dim @@num_attention_heads default=2
KV_HEADS <- Config.dim @@num_key_value_heads default=1
HEAD_DIM <- Config.dim @@head_dim default=(MODEL_DIM / NUM_HEADS)
QD <- NUM_HEADS * HEAD_DIM
KVD <- KV_HEADS * HEAD_DIM
VOCAB_SIZE <- Config.dim @@vocab_size default=32768
MAX_POSITIONS <- Config.dim @@max_position_embeddings default=2048
KEEP_WINDOW <- Config.dim @@keep_window_size default=MAX_POSITIONS
EPS <- Config.float @@rms_norm_eps default=1e-6
THETA <- Config.float @@rope_theta default=10000.0
ATTENTION_BIAS <- Config.bool @@attention_bias default=false
MLP_BIAS <- Config.bool @@mlp_bias default=false
TIE <- Config.bool @@tie_word_embeddings default=true

small_doge_dynamic_bias :: Tensor[B,KVH,K,HD] -> Dim -> Tensor[B,heads,1,K]
small_doge_dynamic_bias value heads = do
  flat <- Tensor.permute value dims=[0, 2, 1, 3]
  flat <- Tensor.reshape flat shape=[B, K, KVH * HD]
  dt <- NN.linear@dt_proj flat dim=KVH bias=ATTENTION_BIAS
  dt <- log ((exp dt) + 1.0)
  a <- ((param @A) :: Tensor[KVH])
  bias <- exp (dt * a)
  bias <- Tensor.permute bias dims=[0, 2, 1]
  bias <- Tensor.unsqueeze bias dim=2
  return Tensor.repeat bias repeats=(heads / KVH)

small_doge_block :: Tensor[B,S,D] -> Tensor[B,1,S,R] -> Tensor[B,1,S,R] -> Tensor[B,1,S,K] -> ?CacheLayer[B,KV_HEADS,P,MAX_POSITIONS,DH] -> (Tensor[B,S,D], ?CacheLayer[B,KV_HEADS,K,MAX_POSITIONS,DH])
small_doge_block x rope_sin rope_cos mask past_kv = do
  residual <- x
  xn <- NN.rmsnorm@input_layernorm x eps=EPS cast_float=true
  a, new_kv <- scope@self_attn do
    q <- NN.linear@q_proj xn dim=QD bias=ATTENTION_BIAS |> reshape_heads heads=NUM_HEADS
    k <- NN.linear@k_proj xn dim=KVD bias=ATTENTION_BIAS |> reshape_heads heads=KV_HEADS
    v <- NN.linear@v_proj xn dim=KVD bias=ATTENTION_BIAS |> reshape_heads heads=KV_HEADS
    q <- NN.rmsnorm@q_norm q eps=EPS dim=HEAD_DIM cast_float=true
    k <- NN.rmsnorm@k_norm k eps=EPS dim=HEAD_DIM cast_float=true
    q, k <- rope_pair_base_factors q k rope_sin rope_cos
    k, v, new_kv <- Cache.update past_kv k v
    dynamic_bias <- ((small_doge_dynamic_bias v NUM_HEADS) :: Tensor[B,NUM_HEADS,1,K])
    k <- Tensor.repeat k repeats=(NUM_HEADS / KV_HEADS)
    v <- Tensor.repeat v repeats=(NUM_HEADS / KV_HEADS)
    a <- attention q k v mask rel_bias=dynamic_bias
    return merge_heads a |> NN.linear@o_proj dim=MODEL_DIM bias=ATTENTION_BIAS, new_kv
  input_scale <- ((param @input_residual) :: Tensor[MODEL_DIM])
  x <- (residual * input_scale) + a
  residual <- x
  xn <- NN.rmsnorm@post_attention_layernorm x eps=EPS cast_float=true
  m <- scope@mlp do
    gate <- NN.linear@gate_proj xn dim=FFN bias=MLP_BIAS |> silu
    up <- NN.linear@up_proj xn dim=FFN bias=MLP_BIAS
    return gate |> mul up |> NN.linear@down_proj dim=MODEL_DIM bias=MLP_BIAS
  output_scale <- ((param @post_attention_residual) :: Tensor[MODEL_DIM])
  return (residual * output_scale) + m, new_kv

small_doge :: TokenIds[B,S] -> ?Mask[B,K,MAX_POSITIONS] -> ?Cache[B,KV_HEADS,P,MAX_POSITIONS,DH] -> ?Bool -> (Tensor[B,S,V], ?Cache[B,KV_HEADS,K,MAX_POSITIONS,DH])
small_doge input_ids attn_mask past_kv use_cache = do
  past_length <- Cache.past_length past_kv
  attn_mask <- mask_for_input input_ids attn_mask MAX_POSITIONS
  pos_ids <- position_ids input_ids past_length=past_length
  rope_sin, rope_cos <- rope_base_factors pos_ids HEAD_DIM THETA
  key_len <- mask_length_for_input input_ids attn_mask past_length
  mask <- causal_mask_for_input input_ids key_len padding_mask=attn_mask window=MAX_POSITIONS
  work_kv <- Cache.prepare past_kv use_cache MAX_POSITIONS
  read_kv <- Cache.read past_kv work_kv
  x <- scope@model do
    x <- NN.embedding@embed_tokens input_ids dim=MODEL_DIM
    x, work_kv <- for@layers i <- [0..NUM_LAYERS) carry (x, work_kv) do
      past_i <- Cache.index read_kv i
      x, new_i <- small_doge_block x rope_sin rope_cos mask past_i
      work_kv <- Cache.append work_kv new_i
      yield x, work_kv
    return NN.rmsnorm@norm x eps=EPS cast_float=true
  new_kv <- Cache.finish work_kv key_len
  new_kv <- use_cache ? new_kv : null
  logits <- TIE ? (NN.linear@model.embed_tokens x dim=VOCAB_SIZE bias=false) : (NN.linear@lm_head x dim=VOCAB_SIZE bias=false)
  return logits, new_kv
