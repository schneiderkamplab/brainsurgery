{-# CHECKPOINTS "allenai/led-base-16384" #-}

{-# TASK "seq2seq_lm" #-}

{-# MAIN "led" #-}

import Activations (gelu)

import Attention (attention, merge_heads, reshape_heads)

import List

import Masking (Mask, bidirectional_mask_for_input, causal_mask_for_input, mask_for_input)

import Config

import NN

import Tensor

MODEL_DIM <- 768

VOCAB_SIZE <- 50265

L_ENC <- 6

L_DEC <- 6

H_ENC <- 12

H_DEC <- 12

FFN_ENC <- 3072

FFN_DEC <- 3072

EPS <- 1e-05

ATTN_WINDOWS <- (([1024, 1024, 1024, 1024, 1024, 1024]) :: List[Int])

LOCAL_RADIUS = (List.index ATTN_WINDOWS 0) / 2

led_encoder_layer :: Tensor[B,S,D] -> Tensor[B,1,S,S] -> Tensor[B,1,S,S] -> Tensor[B,S] -> Tensor[B,S,D]
led_encoder_layer x local_keep full_keep global_tokens = do
  q <- NN.linear@self_attn.longformer_self_attn.query x dim=MODEL_DIM bias=true |> reshape_heads heads=H_ENC
  k <- NN.linear@self_attn.longformer_self_attn.key x dim=MODEL_DIM bias=true |> reshape_heads heads=H_ENC
  v <- NN.linear@self_attn.longformer_self_attn.value x dim=MODEL_DIM bias=true |> reshape_heads heads=H_ENC
  global_keys <- Tensor.reshape global_tokens shape=[B, 1, 1, S]
  global_keys <- Tensor.expand global_keys shape=[B, 1, S, S]
  ordinary_keep <- local_keep or global_keys
  ordinary <- attention q k v ordinary_keep |> merge_heads
  q_global <- NN.linear@self_attn.longformer_self_attn.query_global x dim=MODEL_DIM bias=true |> reshape_heads heads=H_ENC
  k_global <- NN.linear@self_attn.longformer_self_attn.key_global x dim=MODEL_DIM bias=true |> reshape_heads heads=H_ENC
  v_global <- NN.linear@self_attn.longformer_self_attn.value_global x dim=MODEL_DIM bias=true |> reshape_heads heads=H_ENC
  global_out <- attention q_global k_global v_global full_keep |> merge_heads
  global_queries <- Tensor.reshape global_tokens shape=[B, S, 1]
  a <- Tensor.where global_queries global_out ordinary
  a <- NN.linear@self_attn.output a dim=MODEL_DIM bias=true
  x <- NN.layernorm@self_attn_layer_norm (x + a) eps=EPS
  m <- NN.linear@fc1 x dim=FFN_ENC bias=true |> gelu
  m <- NN.linear@fc2 m dim=MODEL_DIM bias=true
  return NN.layernorm@final_layer_norm (x + m) eps=EPS

led_decoder_layer :: Tensor[B,SDEC,D] -> Tensor[B,SENC,D] -> Tensor[B,1,SDEC,SDEC] -> Tensor[B,1,SDEC,SENC] -> Tensor[B,SDEC,D]
led_decoder_layer x enc_hidden decoder_keep cross_keep = do
  a <- scope@self_attn do
    q <- NN.linear@q_proj x dim=MODEL_DIM bias=true |> reshape_heads heads=H_DEC
    k <- NN.linear@k_proj x dim=MODEL_DIM bias=true |> reshape_heads heads=H_DEC
    v <- NN.linear@v_proj x dim=MODEL_DIM bias=true |> reshape_heads heads=H_DEC
    return attention q k v decoder_keep |> merge_heads |> NN.linear@out_proj dim=MODEL_DIM bias=true
  x <- NN.layernorm@self_attn_layer_norm (x + a) eps=EPS
  a <- scope@encoder_attn do
    q <- NN.linear@q_proj x dim=MODEL_DIM bias=true |> reshape_heads heads=H_DEC
    k <- NN.linear@k_proj enc_hidden dim=MODEL_DIM bias=true |> reshape_heads heads=H_DEC
    v <- NN.linear@v_proj enc_hidden dim=MODEL_DIM bias=true |> reshape_heads heads=H_DEC
    return attention q k v cross_keep |> merge_heads |> NN.linear@out_proj dim=MODEL_DIM bias=true
  x <- NN.layernorm@encoder_attn_layer_norm (x + a) eps=EPS
  m <- NN.linear@fc1 x dim=FFN_DEC bias=true |> gelu
  m <- NN.linear@fc2 m dim=MODEL_DIM bias=true
  return NN.layernorm@final_layer_norm (x + m) eps=EPS

led :: TokenIds[B,SENC] -> ?Mask[B,SENC,SENC] -> ?Tensor[B,SENC] -> TokenIds[B,SDEC] -> ?Mask[B,SDEC,SDEC] -> Tensor[B,SDEC,V]
led input_ids attention_mask global_attention_mask decoder_input_ids decoder_attention_mask = do
  attention_mask <- mask_for_input input_ids attention_mask SENC
  decoder_attention_mask <- mask_for_input decoder_input_ids decoder_attention_mask SDEC
  global_attention_mask <- (global_attention_mask == null) ? Tensor.zeros_like input_ids : global_attention_mask
  global_tokens <- Tensor.cast global_attention_mask "bool"
  encoder_keep <- bidirectional_mask_for_input input_ids SENC padding_mask=attention_mask window=LOCAL_RADIUS
  encoder_full_keep <- bidirectional_mask_for_input input_ids SENC padding_mask=attention_mask
  decoder_keep <- causal_mask_for_input decoder_input_ids SDEC padding_mask=decoder_attention_mask window=1048576
  cross_keep <- bidirectional_mask_for_input decoder_input_ids SENC padding_mask=attention_mask
  enc_pos_ids <- Tensor.arange input_ids start=0 end=SENC |> Tensor.reshape shape=[1, SENC] |> Tensor.expand shape=[B, SENC]
  enc_hidden <- NN.embedding@led.shared input_ids dim=MODEL_DIM
  enc_hidden <- enc_hidden + NN.embedding@led.encoder.embed_positions enc_pos_ids dim=MODEL_DIM
  enc_hidden <- NN.layernorm@led.encoder.layernorm_embedding enc_hidden eps=EPS
  enc_hidden <- for@led.encoder.layers i <- [0..L_ENC) carry (enc_hidden) do
    enc_hidden <- led_encoder_layer enc_hidden encoder_keep encoder_full_keep global_tokens
    yield enc_hidden
  dec_pos_ids <- Tensor.arange decoder_input_ids start=0 end=SDEC |> Tensor.reshape shape=[1, SDEC] |> Tensor.expand shape=[B, SDEC]
  dec_hidden <- NN.embedding@led.shared decoder_input_ids dim=MODEL_DIM
  dec_hidden <- dec_hidden + NN.embedding@led.decoder.embed_positions dec_pos_ids dim=MODEL_DIM
  dec_hidden <- NN.layernorm@led.decoder.layernorm_embedding dec_hidden eps=EPS
  dec_hidden <- for@led.decoder.layers i <- [0..L_DEC) carry (dec_hidden) do
    dec_hidden <- led_decoder_layer dec_hidden enc_hidden decoder_keep cross_keep
    yield dec_hidden
  return NN.linear@lm_head dec_hidden dim=VOCAB_SIZE bias=false
