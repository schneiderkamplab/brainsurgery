{-# CHECKPOINTS "google/mobilebert-uncased" #-}

{-# TASK "masked_lm" #-}

{-# MAIN "mobilebert" #-}

import Activations (relu)

import Attention (attention, merge_heads, reshape_heads)

import Masking (Mask, bidirectional_mask_for_input, mask_for_input)

import Params (param)

import Positions (position_ids)

import Config

import NN

import Tensor

MODEL_DIM <- 512

EMBED_DIM <- 128

BOTTLENECK_DIM <- 128

VOCAB_SIZE <- 30522

NUM_LAYERS <- 24

NUM_HEADS <- 4

FFN <- 512

NUM_FFNS <- 4

EPS <- 1e-12

no_norm :: Path -> Tensor[..S] -> Tensor[..S]
no_norm@path x = (x * (param @weight)) + (param @bias)

mobilebert_ffn :: Tensor[B,S,BOTTLENECK_DIM] -> Tensor[B,S,BOTTLENECK_DIM]
mobilebert_ffn x = do
  m <- NN.linear@intermediate.dense x dim=FFN bias=true |> relu
  m <- NN.linear@output.dense m dim=BOTTLENECK_DIM bias=true
  return no_norm@output.LayerNorm (x + m)

mobilebert_block :: Tensor[B,S,MODEL_DIM] -> Tensor[B,1,S,S] -> Tensor[B,S,MODEL_DIM]
mobilebert_block x keep = do
  layer_input <- NN.linear@bottleneck.input.dense x dim=BOTTLENECK_DIM bias=true
  layer_input <- no_norm@bottleneck.input.LayerNorm layer_input
  shared <- NN.linear@bottleneck.attention.dense x dim=BOTTLENECK_DIM bias=true
  shared <- no_norm@bottleneck.attention.LayerNorm shared
  a <- scope@attention do
    q <- NN.linear@self.query shared dim=BOTTLENECK_DIM bias=true |> reshape_heads heads=NUM_HEADS
    k <- NN.linear@self.key shared dim=BOTTLENECK_DIM bias=true |> reshape_heads heads=NUM_HEADS
    v <- NN.linear@self.value x dim=BOTTLENECK_DIM bias=true |> reshape_heads heads=NUM_HEADS
    return attention q k v keep |> merge_heads |> NN.linear@output.dense dim=BOTTLENECK_DIM bias=true
  a <- no_norm@attention.output.LayerNorm (a + layer_input)
  a <- for@ffn j <- [0..NUM_FFNS - 1) carry (a) do
    a <- mobilebert_ffn a
    yield a
  m <- NN.linear@intermediate.dense a dim=FFN bias=true |> relu
  m <- NN.linear@output.dense m dim=BOTTLENECK_DIM bias=true
  m <- no_norm@output.LayerNorm (a + m)
  y <- NN.linear@output.bottleneck.dense m dim=MODEL_DIM bias=true
  return no_norm@output.bottleneck.LayerNorm (x + y)

mobilebert :: TokenIds[B,S] -> ?Mask[B,S,S] -> Tensor[B,S,VOCAB_SIZE]
mobilebert input_ids attn_mask = do
  attn_mask <- mask_for_input input_ids attn_mask S
  keep <- bidirectional_mask_for_input input_ids S padding_mask=attn_mask
  pos_ids <- position_ids input_ids
  tok_type_ids <- input_ids - input_ids
  tok <- NN.embedding@mobilebert.embeddings.word_embeddings input_ids dim=EMBED_DIM
  zero <- Tensor.slice tok dim=1 start=0 end=1 |> Tensor.zeros_like
  prev <- Tensor.slice tok dim=1 start=1 end=S |> Tensor.concat zero dim=1
  next <- Tensor.slice tok dim=1 start=0 end=(S - 1)
  next <- Tensor.concat zero next dim=1
  tok <- Tensor.concat prev tok dim=-1 |> Tensor.concat next dim=-1
  tok <- NN.linear@mobilebert.embeddings.embedding_transformation tok dim=MODEL_DIM bias=true
  pos <- NN.embedding@mobilebert.embeddings.position_embeddings pos_ids dim=MODEL_DIM
  typ <- NN.embedding@mobilebert.embeddings.token_type_embeddings tok_type_ids dim=MODEL_DIM
  x <- tok + pos + typ
  x <- no_norm@mobilebert.embeddings.LayerNorm x
  x <- for@mobilebert.encoder.layer i <- [0..NUM_LAYERS) carry (x) do
    x <- mobilebert_block x keep
    yield x
  x <- NN.linear@cls.predictions.transform.dense x dim=MODEL_DIM bias=true |> relu
  x <- NN.layernorm@cls.predictions.transform.LayerNorm x eps=EPS
  x_embed <- Tensor.slice x dim=-1 start=0 end=EMBED_DIM
  x_dense <- Tensor.slice x dim=-1 start=EMBED_DIM end=MODEL_DIM
  logits_embed <- NN.linear@cls.predictions.decoder x_embed dim=VOCAB_SIZE bias=true weight_path=@@mobilebert.embeddings.word_embeddings.weight bias_path=@@cls.predictions.decoder.bias
  logits_dense <- NN.linear@cls.predictions.dense x_dense dim=VOCAB_SIZE bias=false transpose=true
  return logits_embed + logits_dense
