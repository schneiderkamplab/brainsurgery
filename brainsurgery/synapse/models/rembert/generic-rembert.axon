{-# CHECKPOINTS ["ibraheemmoosa/xlmindic-rembert-uniscript", "ibraheemmoosa/xlmindic-rembert-multiscript", "test/RemBERT-Test"] #-}
{-# TASK "masked_lm" #-}

import Activations (gelu)
import Attention (attention, merge_heads, reshape_heads)
import Masking (Mask, bidirectional_mask_for_input, mask_for_input)
import Positions (position_ids)
import Config
import NN



MODEL_DIM <- Config.int @@hidden_size default=1152
INPUT_DIM <- Config.int @@input_embedding_size default=256
OUTPUT_DIM <- Config.int @@output_embedding_size default=1664
VOCAB_SIZE <- Config.int @@vocab_size default=250300
NUM_LAYERS <- Config.int @@num_hidden_layers default=32
NUM_HEADS <- Config.int @@num_attention_heads default=18
FFN <- Config.int @@intermediate_size default=4608
EPS <- Config.float @@layer_norm_eps default=1e-12

rembert_block :: Tensor[B,S,D] -> Tensor[B,1,S,S] -> Tensor[B,S,D]
rembert_block x keep = do
  a <- scope@attention do
    q <- NN.linear@self.query x dim=MODEL_DIM bias=true |> reshape_heads heads=NUM_HEADS
    k <- NN.linear@self.key x dim=MODEL_DIM bias=true |> reshape_heads heads=NUM_HEADS
    v <- NN.linear@self.value x dim=MODEL_DIM bias=true |> reshape_heads heads=NUM_HEADS
    return attention q k v keep |> merge_heads |> NN.linear@output.dense dim=MODEL_DIM bias=true
  x <- x + a
  x <- NN.layernorm@attention.output.LayerNorm x eps=EPS
  m <- NN.linear@intermediate.dense x dim=FFN bias=true |> gelu
  m <- NN.linear@output.dense m dim=MODEL_DIM bias=true
  y <- x + m
  y <- NN.layernorm@output.LayerNorm y eps=EPS
  return y

rembert :: TokenIds[B,S] -> ?Mask[B,S,S] -> Tensor[B,S,V]
rembert input_ids attn_mask = do
  attn_mask <- mask_for_input input_ids attn_mask S
  pos_ids <- position_ids input_ids
  keep <- bidirectional_mask_for_input input_ids S padding_mask=attn_mask
  tok_type_ids <- input_ids - input_ids
  tok <- NN.embedding@rembert.embeddings.word_embeddings input_ids dim=INPUT_DIM
  pos <- NN.embedding@rembert.embeddings.position_embeddings pos_ids dim=INPUT_DIM
  typ <- NN.embedding@rembert.embeddings.token_type_embeddings tok_type_ids dim=INPUT_DIM
  x <- tok + pos
  x <- x + typ
  x <- NN.layernorm@rembert.embeddings.LayerNorm x eps=EPS
  x <- NN.linear@rembert.encoder.embedding_hidden_mapping_in x dim=MODEL_DIM bias=true
  x <- for@rembert.encoder.layer i <- [0..NUM_LAYERS) carry (x) do
    x <- rembert_block x keep
    yield x
  logits <- scope@cls.predictions do
    x <- NN.linear@dense x dim=OUTPUT_DIM bias=true |> gelu
    x <- NN.layernorm@LayerNorm x eps=EPS
    return NN.linear@decoder x dim=VOCAB_SIZE bias=true
  return logits
