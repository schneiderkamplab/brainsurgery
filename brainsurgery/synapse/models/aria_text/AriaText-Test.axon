{-# CHECKPOINTS "test/AriaText-Test" #-}

{-# TASK "causal_lm" #-}

{-# MAIN "aria_text" #-}

import Activations (silu)

import Attention (attention, merge_heads, reshape_heads)

import Cache

import Config

import Masking (Mask, causal_mask_for_input, mask_for_input, mask_length_for_input)

import Math (mul)

import MoE (grouped_swiglu_ffn_basic)

import NN

import Positions (position_ids, rope_base_factors, rope_pair_base_factors)

import Tensor

MODEL_DIM <- (4096 :: Dim)

FFN <- (4096 :: Dim)

NUM_LAYERS <- (32 :: Dim)

NUM_HEADS <- (32 :: Dim)

KV_HEADS <- Config.dim @@num_key_value_heads default=NUM_HEADS

HEAD_DIM <- Config.dim @@head_dim default=(MODEL_DIM / NUM_HEADS)

QD <- NUM_HEADS * HEAD_DIM

KVD <- KV_HEADS * HEAD_DIM

VOCAB_SIZE <- (32000 :: Dim)

MAX_POSITIONS <- (2048 :: Dim)

EPS <- 1e-06

THETA <- 10000.0

NUM_EXPERTS <- (8 :: Dim)

TOP_K <- (2 :: Dim)

SHARED_EXPERTS <- (2 :: Dim)

ATTENTION_BIAS <- false

MLP_BIAS <- false

TIE <- false

aria_text_moe :: Tensor[B,S,D] -> Tensor[B,S,D]
aria_text_moe x = do
  logits <- NN.linear@router x dim=NUM_EXPERTS bias=false
  selected_logits, indices <- Tensor.topk logits k=TOP_K dim=-1 largest=true sorted=true
  scores <- Tensor.softmax selected_logits dim=-1 dtype="float32" |> Tensor.cast_like x
  routed <- grouped_swiglu_ffn_basic x scores indices NUM_EXPERTS gate_up_weight=@experts.fc1.weight out_weight=@experts.fc2.weight transpose=true
  shared <- scope@shared_experts do
    gate <- NN.linear@gate_proj x dim=(FFN * SHARED_EXPERTS) bias=MLP_BIAS |> silu
    up <- NN.linear@up_proj x dim=(FFN * SHARED_EXPERTS) bias=MLP_BIAS
    return gate |> mul up |> NN.linear@down_proj dim=MODEL_DIM bias=MLP_BIAS
  return routed + shared

aria_text_block :: Tensor[B,S,D] -> Tensor[B,1,S,R] -> Tensor[B,1,S,R] -> Tensor[B,1,S,K] -> ?CacheLayer[B,KV_HEADS,P,MAX_POSITIONS,HEAD_DIM] -> (Tensor[B,S,D], ?CacheLayer[B,KV_HEADS,K,MAX_POSITIONS,HEAD_DIM])
aria_text_block x rope_sin rope_cos mask past_kv = do
  xn <- NN.rmsnorm@input_layernorm x eps=EPS cast_float=true
  a, new_kv <- scope@self_attn do
    q <- NN.linear@q_proj xn dim=QD bias=ATTENTION_BIAS |> reshape_heads heads=NUM_HEADS
    k <- NN.linear@k_proj xn dim=KVD bias=ATTENTION_BIAS |> reshape_heads heads=KV_HEADS
    v <- NN.linear@v_proj xn dim=KVD bias=ATTENTION_BIAS |> reshape_heads heads=KV_HEADS
    q, k <- rope_pair_base_factors q k rope_sin rope_cos
    k, v, new_kv <- Cache.update past_kv k v
    k <- Tensor.repeat k repeats=(NUM_HEADS / KV_HEADS)
    v <- Tensor.repeat v repeats=(NUM_HEADS / KV_HEADS)
    a <- attention q k v mask |> merge_heads |> NN.linear@o_proj dim=MODEL_DIM bias=ATTENTION_BIAS
    return a, new_kv
  x <- x + a
  xn <- NN.rmsnorm@post_attention_layernorm x eps=EPS cast_float=true
  m <- scope@mlp do
    return aria_text_moe xn
  return x + m, new_kv

aria_text :: TokenIds[B,S] -> ?Mask[B,K,MAX_POSITIONS] -> ?Cache[B,KV_HEADS,P,MAX_POSITIONS,HEAD_DIM] -> ?Bool -> (Tensor[B,S,V], ?Cache[B,KV_HEADS,K,MAX_POSITIONS,HEAD_DIM])
aria_text input_ids attn_mask past_kv use_cache = do
  past_length <- Cache.past_length past_kv
  attn_mask <- mask_for_input input_ids attn_mask MAX_POSITIONS
  pos_ids <- position_ids input_ids attn_mask=attn_mask past_length=past_length pad_fill=1
  rope_sin, rope_cos <- rope_base_factors pos_ids HEAD_DIM THETA
  key_len <- mask_length_for_input input_ids attn_mask past_length
  mask <- causal_mask_for_input input_ids key_len padding_mask=attn_mask window=MAX_POSITIONS
  work_kv <- Cache.prepare past_kv use_cache MAX_POSITIONS
  read_kv <- Cache.read past_kv work_kv
  x, work_kv <- scope@model do
    x <- NN.embedding@embed_tokens input_ids dim=MODEL_DIM
    x, work_kv <- for@layers i <- [0..NUM_LAYERS) carry (x, work_kv) do
      past_i <- Cache.index read_kv i
      x, new_i <- aria_text_block x rope_sin rope_cos mask past_i
      work_kv <- Cache.append work_kv new_i
      yield x, work_kv
    x <- NN.rmsnorm@norm x eps=EPS cast_float=true
    return x, work_kv
  new_kv <- Cache.finish work_kv key_len
  new_kv <- use_cache ? new_kv : null
  logits <- TIE ? (NN.linear@model.embed_tokens x dim=VOCAB_SIZE bias=false) : (NN.linear@@lm_head x dim=VOCAB_SIZE bias=false)
  return logits, new_kv
