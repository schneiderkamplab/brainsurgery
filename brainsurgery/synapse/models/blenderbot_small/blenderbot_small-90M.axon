{-# CHECKPOINTS "facebook/blenderbot_small-90M" #-}

{-# TASK "seq2seq_lm" #-}

{-# MAIN "blenderbot_small" #-}

import Activations (gelu)

import Attention (attention, merge_heads, reshape_heads)

import Masking (Mask, bidirectional_mask_for_input, causal_mask_for_input, mask_for_input)

import Math (sqrt)

import Config

import NN

import Tensor

MODEL_DIM <- 512

VOCAB_SIZE <- 54944

L_ENC <- 8

L_DEC <- 8

H_ENC <- 16

H_DEC <- 16

FFN_ENC <- 2048

FFN_DEC <- 2048

EPS <- 1e-05

EMB_SCALE = sqrt MODEL_DIM

blenderbot_small_encoder_layer :: Tensor[B,S,D] -> Tensor[B,1,S,S] -> Tensor[B,S,D]
blenderbot_small_encoder_layer x keep = do
  a <- scope@self_attn do
    q <- NN.linear@q_proj x dim=MODEL_DIM bias=true |> reshape_heads heads=H_ENC
    k <- NN.linear@k_proj x dim=MODEL_DIM bias=true |> reshape_heads heads=H_ENC
    v <- NN.linear@v_proj x dim=MODEL_DIM bias=true |> reshape_heads heads=H_ENC
    return attention q k v keep |> merge_heads |> NN.linear@out_proj dim=MODEL_DIM bias=true
  x <- NN.layernorm@self_attn_layer_norm (x + a) eps=EPS
  m <- NN.linear@fc1 x dim=FFN_ENC bias=true |> gelu |> NN.linear@fc2 dim=MODEL_DIM bias=true
  return NN.layernorm@final_layer_norm (x + m) eps=EPS

blenderbot_small_decoder_layer :: Tensor[B,SDEC,D] -> Tensor[B,SENC,D] -> Tensor[B,1,SDEC,SDEC] -> Tensor[B,1,SDEC,SENC] -> Tensor[B,SDEC,D]
blenderbot_small_decoder_layer x enc_hidden decoder_keep cross_keep = do
  a <- scope@self_attn do
    q <- NN.linear@q_proj x dim=MODEL_DIM bias=true |> reshape_heads heads=H_DEC
    k <- NN.linear@k_proj x dim=MODEL_DIM bias=true |> reshape_heads heads=H_DEC
    v <- NN.linear@v_proj x dim=MODEL_DIM bias=true |> reshape_heads heads=H_DEC
    return attention q k v decoder_keep |> merge_heads |> NN.linear@out_proj dim=MODEL_DIM bias=true
  x <- NN.layernorm@self_attn_layer_norm (x + a) eps=EPS
  a <- scope@encoder_attn do
    q <- NN.linear@q_proj x dim=MODEL_DIM bias=true |> reshape_heads heads=H_DEC
    k <- NN.linear@k_proj enc_hidden dim=MODEL_DIM bias=true |> reshape_heads heads=H_DEC
    v <- NN.linear@v_proj enc_hidden dim=MODEL_DIM bias=true |> reshape_heads heads=H_DEC
    return attention q k v cross_keep |> merge_heads |> NN.linear@out_proj dim=MODEL_DIM bias=true
  x <- NN.layernorm@encoder_attn_layer_norm (x + a) eps=EPS
  m <- NN.linear@fc1 x dim=FFN_DEC bias=true |> gelu |> NN.linear@fc2 dim=MODEL_DIM bias=true
  return NN.layernorm@final_layer_norm (x + m) eps=EPS

blenderbot_small :: TokenIds[B,SENC] -> ?Mask[B,SENC,SENC] -> TokenIds[B,SDEC] -> ?Mask[B,SDEC,SDEC] -> Tensor[B,SDEC,V]
blenderbot_small input_ids attention_mask decoder_input_ids decoder_attention_mask = do
  attention_mask <- mask_for_input input_ids attention_mask SENC
  decoder_attention_mask <- mask_for_input decoder_input_ids decoder_attention_mask SDEC
  encoder_keep <- bidirectional_mask_for_input input_ids SENC padding_mask=attention_mask
  decoder_keep <- causal_mask_for_input decoder_input_ids SDEC padding_mask=decoder_attention_mask window=1048576
  cross_keep <- bidirectional_mask_for_input decoder_input_ids SENC padding_mask=attention_mask
  enc_pos_ids <- Tensor.arange input_ids 0 SENC |> Tensor.reshape shape=[1, SENC] |> Tensor.expand shape=[B, SENC]
  enc_tok <- NN.embedding@model.shared input_ids dim=MODEL_DIM scale=EMB_SCALE
  enc_hidden <- NN.layernorm@model.encoder.layernorm_embedding (enc_tok + NN.embedding@model.encoder.embed_positions enc_pos_ids dim=MODEL_DIM) eps=EPS
  enc_hidden <- for@model.encoder.layers i <- [0..L_ENC) carry (enc_hidden) do
    enc_hidden <- blenderbot_small_encoder_layer enc_hidden encoder_keep
    yield enc_hidden
  dec_pos_ids <- Tensor.arange decoder_input_ids 0 SDEC |> Tensor.reshape shape=[1, SDEC] |> Tensor.expand shape=[B, SDEC]
  dec_tok <- NN.embedding@model.shared decoder_input_ids dim=MODEL_DIM
  dec_tok <- NN.layernorm@model.decoder.layernorm_embedding dec_tok eps=EPS
  dec_hidden <- dec_tok + NN.embedding@model.decoder.embed_positions dec_pos_ids dim=MODEL_DIM
  dec_hidden <- for@model.decoder.layers i <- [0..L_DEC) carry (dec_hidden) do
    dec_hidden <- blenderbot_small_decoder_layer dec_hidden enc_hidden decoder_keep cross_keep
    yield dec_hidden
  return NN.linear@lm_head dec_hidden dim=VOCAB_SIZE bias=true bias_path=@@final_logits_bias
