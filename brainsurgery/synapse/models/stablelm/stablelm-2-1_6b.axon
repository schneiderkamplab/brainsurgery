{-# CHECKPOINTS "stabilityai/stablelm-2-1_6b" #-}

{-# TASK "causal_lm" #-}

{-# MAIN "stablelm" #-}

import Activations (silu)

import Attention (attention, merge_heads, reshape_heads)

import Cache

import Config

import Masking (Mask, causal_mask_for_input, mask_for_input, mask_length_for_input)

import Math (floor, mul)

import NN

import Positions (position_ids, rope_base_factors, rope_pair_base_prefix_factors)

import Tensor

MODEL_DIM <- (2048 :: Dim)

VOCAB_SIZE <- (100352 :: Dim)

NUM_LAYERS <- (24 :: Dim)

NUM_HEADS <- (32 :: Dim)

KV_HEADS <- Config.dim @@num_key_value_heads default=NUM_HEADS

FFN <- (5632 :: Dim)

MAX_POSITIONS <- (4096 :: Dim)

EPS <- 1e-05

THETA <- 10000.0

PARTIAL_ROTARY_FACTOR <- 0.25

ROTARY_DIM <- ((floor (HEAD_DIM * PARTIAL_ROTARY_FACTOR)) :: Dim)

QK_LAYERNORM <- false

QKV_BIAS <- true

PARALLEL_RESIDUAL <- false

HEAD_DIM = MODEL_DIM / NUM_HEADS

QD = NUM_HEADS * HEAD_DIM

KVD = KV_HEADS * HEAD_DIM

stablelm_mlp :: Tensor[B,S,D] -> Tensor[B,S,D]
stablelm_mlp x = do
  gate <- NN.linear@mlp.gate_proj x dim=FFN bias=false |> silu
  up <- NN.linear@mlp.up_proj x dim=FFN bias=false
  return gate |> mul up |> NN.linear@mlp.down_proj dim=MODEL_DIM bias=false

stablelm_parallel :: Tensor[B,S,D] -> Tensor[B,S,D] -> Tensor[B,S,D] -> Tensor[B,S,D]
stablelm_parallel residual a xn = residual + a + stablelm_mlp xn

stablelm_sequential :: Tensor[B,S,D] -> Tensor[B,S,D] -> Tensor[B,S,D]
stablelm_sequential residual a = do
  x <- residual + a
  xn <- NN.layernorm@post_attention_layernorm x eps=EPS
  return x + stablelm_mlp xn

stablelm_block :: Tensor[B,S,D] -> Tensor[B,1,S,R] -> Tensor[B,1,S,R] -> Tensor[B,1,S,K] -> ?CacheLayer[B,KV_HEADS,P,MAX_POSITIONS,DH] -> (Tensor[B,S,D], ?CacheLayer[B,KV_HEADS,K,MAX_POSITIONS,DH])
stablelm_block x rope_sin rope_cos mask past_kv = do
  residual <- x
  xn <- NN.layernorm@input_layernorm x eps=EPS
  q <- NN.linear@self_attn.q_proj xn dim=QD bias=QKV_BIAS |> reshape_heads heads=NUM_HEADS
  k <- NN.linear@self_attn.k_proj xn dim=KVD bias=QKV_BIAS |> reshape_heads heads=KV_HEADS
  v <- NN.linear@self_attn.v_proj xn dim=KVD bias=QKV_BIAS |> reshape_heads heads=KV_HEADS
  q <- QK_LAYERNORM ? (NN.layernorm@self_attn.q_layernorm q eps=EPS) : q
  k <- QK_LAYERNORM ? (NN.layernorm@self_attn.k_layernorm k eps=EPS) : k
  q, k <- rope_pair_base_prefix_factors q k rope_sin rope_cos ROTARY_DIM
  k, v, new_kv <- Cache.update past_kv k v
  k_full <- Tensor.repeat k repeats=(NUM_HEADS / KV_HEADS)
  v_full <- Tensor.repeat v repeats=(NUM_HEADS / KV_HEADS)
  a <- attention q k_full v_full mask |> merge_heads |> NN.linear@self_attn.o_proj dim=MODEL_DIM bias=false
  x <- PARALLEL_RESIDUAL ? (stablelm_parallel residual a xn) : (stablelm_sequential residual a)
  return x, new_kv

stablelm :: TokenIds[B,S] -> ?Mask[B,K,MAX_POSITIONS] -> ?Cache[B,KV_HEADS,P,MAX_POSITIONS,DH] -> ?Bool -> (Tensor[B,S,V], ?Cache[B,KV_HEADS,K,MAX_POSITIONS,DH])
stablelm input_ids attn_mask past_kv use_cache = do
  past_length <- Cache.past_length past_kv
  attn_mask <- mask_for_input input_ids attn_mask MAX_POSITIONS
  pos_ids <- position_ids input_ids past_length=past_length
  rope_sin, rope_cos <- rope_base_factors pos_ids ROTARY_DIM THETA
  key_len <- mask_length_for_input input_ids attn_mask past_length
  mask <- causal_mask_for_input input_ids key_len padding_mask=attn_mask window=MAX_POSITIONS
  work_kv <- Cache.prepare past_kv use_cache MAX_POSITIONS
  read_kv <- Cache.read past_kv work_kv
  x <- NN.embedding@model.embed_tokens input_ids dim=MODEL_DIM
  x, work_kv <- for@model.layers i <- [0..NUM_LAYERS) carry (x, work_kv) do
    past_i <- Cache.index read_kv i
    x, new_i <- stablelm_block x rope_sin rope_cos mask past_i
    work_kv <- Cache.append work_kv new_i
    yield x, work_kv
  x <- NN.layernorm@model.norm x eps=EPS
  new_kv <- Cache.finish work_kv key_len
  new_kv <- use_cache ? new_kv : null
  logits <- NN.linear@lm_head x dim=VOCAB_SIZE bias=false
  return logits, new_kv
