{-# CHECKPOINTS "microsoft/Phi-3-medium-4k-instruct" #-}
{-# TASK "causal_lm" #-}

import Activations
import Activations (silu)
import Attention
import Attention (attention, merge_heads, reshape_heads)
import Masking
import Masking (causal_mask)
import Math
import Math (mul)
import Positions
import Positions (position_ids, rope_pair_base)
import Cache
import NN
import Tensor

phi3minimedium_norm :: Path -> Tensor -> Tensor
phi3minimedium_norm@path x = NN.rmsnorm@path x eps=1e-05

phi3minimedium_block :: Tensor -> IdxTensor -> ?Tensor -> ?CacheLayer -> (Tensor, ?CacheLayer)
phi3minimedium_block x pos_ids attn_mask past_kv = do
  xn <- phi3minimedium_norm@input_layernorm x
  a, new_kv <- scope@self_attn do
    qkv <- NN.linear@qkv_proj xn dim=7680 bias=false
    q, k, v <- Tensor.split qkv sizes=[5120, 1280, 1280]
    q <- reshape_heads q heads=40
    k <- reshape_heads k heads=10
    v <- reshape_heads v heads=10
    q, k <- (rope_pair_base q k pos_ids theta=10000.0)
    k, v, new_kv <- Cache.update past_kv k v
    k <- Tensor.repeat k repeats=4
    v <- Tensor.repeat v repeats=4
    mask <- causal_mask q k window=2047 padding_mask=attn_mask
    a <- attention q k v mask |> merge_heads |> NN.linear@o_proj dim=5120 bias=false
    return a, new_kv
  x <- x + a
  xn <- phi3minimedium_norm@post_attention_layernorm x
  m <- scope@mlp do
    gate_up <- NN.linear@gate_up_proj xn dim=35840
    g, u <- Tensor.split gate_up sizes=[17920, 17920]
    return g |> silu |> mul u |> NN.linear@down_proj dim=5120
  return x + m, new_kv

phi3minimedium :: TokenIds[B,S] -> ?Tensor[B,S] -> ?Cache -> ?Bool -> (Tensor[B,S,V], ?Cache)
phi3minimedium input_ids attn_mask past_kv use_cache = do
  pos_ids <- position_ids input_ids attn_mask=attn_mask past_length=(Cache.past_length past_kv)
  x, new_kv <- scope@model do
    x <- NN.embedding@embed_tokens input_ids dim=5120
    new_kv <- use_cache ? Cache.init : null
    for@layers i <- [0..40) do
      past_i <- Cache.index past_kv i
      x, new_i <- phi3minimedium_block x pos_ids attn_mask past_i
      new_kv <- Cache.append new_kv new_i
      yield x, new_kv
    x <- phi3minimedium_norm@norm x
    return x, new_kv
  logits <- (NN.linear@lm_head x dim=32064)
  return logits, new_kv
