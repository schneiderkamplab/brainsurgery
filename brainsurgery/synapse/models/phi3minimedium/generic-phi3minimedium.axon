import Math
{-# CHECKPOINTS ["microsoft/Phi-3-mini-4k-instruct", "microsoft/Phi-3-mini-128k-instruct", "microsoft/Phi-3-medium-4k-instruct", "microsoft/Phi-3-medium-128k-instruct"] #-}
{-# TASK "causal_lm" #-}

import Config
import Params
import Activations silu
import Cache
import Cache past_length

CFG = (Config.has "text_config") ? "text_config" : ""
PARAM_ROOT = (Params.has_root "language_model") ? "language_model" : ""

D = Config.int "hidden_size" root=CFG default=3072
V = Config.int "vocab_size" root=CFG default=32064
L = Config.int "num_hidden_layers" root=CFG default=32
H = Config.int "num_attention_heads" root=CFG default=32
KVH = Config.int "num_key_value_heads" root=CFG default=32
HD = (Config.has "head_dim" root=CFG) ? (Config.int "head_dim" root=CFG default=128) : ((D == 5120) ? 128 : 96)
QD = H * HD
KVD = KVH * HD
FFN = Config.int "intermediate_size" root=CFG default=8192
EPS = Config.float "rms_norm_eps" root=CFG default=1e-05
THETA = Config.float "rope_theta" root=CFG default=10000.0
ROPE_MODE = Config.str "type" root="rope_scaling" default=(Config.str "rope_type" root="rope_scaling" default="default")
ROPE_ORIGINAL_CONTEXT = Config.int "original_max_position_embeddings" root="rope_scaling" default=(Config.int "original_max_position_embeddings" root=CFG default=4096)
ROPE_MAX_CONTEXT = Config.int "max_position_embeddings" root=CFG default=4096
ROPE_LONG_FACTOR = Config.value "long_factor" root="rope_scaling" default=[]
ROPE_SHORT_FACTOR = Config.value "short_factor" root="rope_scaling" default=[]
HAS_LONGROPE = Config.has "long_factor" root="rope_scaling"
ROPE_ATTENTION_FACTOR = (ROPE_MAX_CONTEXT > ROPE_ORIGINAL_CONTEXT) ? 1.1902380714238083 : 1.0
WINDOW_LOCAL = Config.int "sliding_window" root=CFG default=2047
HAS_LM_HEAD = Params.has_root "lm_head"

phi3minimedium_norm :: @Path -> Tensor -> Tensor
phi3minimedium_norm@path x = rmsnorm@path x eps=EPS

phi3minimedium_block :: Tensor -> IdxTensor -> ?Tensor -> ?CacheLayer -> (Tensor, ?CacheLayer)
phi3minimedium_block x pos_ids attn_mask past_kv = do
  xn <- phi3minimedium_norm@input_layernorm x
  a, new_kv <- scope@self_attn do
    qkv <- linear@qkv_proj xn dim=(QD + KVD + KVD) bias=false
    q, k, v <- split qkv sizes=[QD, KVD, KVD]
    q <- reshape_heads q heads=H
    k <- reshape_heads k heads=KVH
    v <- reshape_heads v heads=KVH
    q, k <- HAS_LONGROPE ? (rope_pair_longrope q k pos_ids THETA ROPE_ORIGINAL_CONTEXT ROPE_MAX_CONTEXT ROPE_LONG_FACTOR ROPE_SHORT_FACTOR attention_factor=ROPE_ATTENTION_FACTOR) : (rope_pair_base q k pos_ids theta=THETA)
    k, v, new_kv <- Cache.update past_kv k v
    k <- repeat k repeats=(H / KVH)
    v <- repeat v repeats=(H / KVH)
    mask <- causal_mask q k window=WINDOW_LOCAL padding_mask=attn_mask
    a <- attention q k v mask=mask eager=true |> merge_heads |> linear@o_proj dim=D bias=false
    return a, new_kv
  x <- x + a
  xn <- phi3minimedium_norm@post_attention_layernorm x
  m <- scope@mlp do
    gate_up <- linear@gate_up_proj xn dim=(2 * FFN)
    g, u <- split gate_up sizes=[FFN, FFN]
    return g |> silu |> Math.mul u |> linear@down_proj dim=D
  return x + m, new_kv

phi3minimedium :: TokenIds[B,S] -> ?Tensor[B,S] -> ?Cache -> ?Bool -> (Tensor[B,S,V], ?Cache)
phi3minimedium input_ids attn_mask past_kv use_cache = do
  pos_ids <- position_ids input_ids attn_mask=attn_mask past_length=(past_length past_kv)
  x, new_kv <- scope@model root=PARAM_ROOT do
    x <- embedding@embed_tokens input_ids dim=D
    new_kv <- use_cache ? Cache.init : null
    for@layers i <- [0..L) do
      past_i <- Cache.index past_kv i
      x, new_i <- phi3minimedium_block x pos_ids attn_mask past_i
      new_kv <- Cache.append new_kv new_i
    x <- phi3minimedium_norm@norm x
    return x, new_kv
  logits <- HAS_LM_HEAD ? (linear@lm_head x dim=V) : (linear@model.embed_tokens x dim=V)
  return logits, new_kv
