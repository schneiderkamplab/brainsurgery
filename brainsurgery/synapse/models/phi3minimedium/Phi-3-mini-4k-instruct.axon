{-# CHECKPOINTS "microsoft/Phi-3-mini-4k-instruct" #-}

{-# TASK "causal_lm" #-}

{-# MAIN "phi3minimedium" #-}

import Activations (silu)

import Attention (attention, merge_heads, reshape_heads)

import Masking (Mask, causal_mask_for_input, mask_for_input, mask_length_for_input)

import Math (mul)

import Params (has_root)

import Positions (position_ids, rope_pair_base, rope_pair_longrope)

import Cache

import Config

import NN

import Tensor

MODEL_DIM <- 3072

VOCAB_SIZE <- 32064

NUM_LAYERS <- 32

NUM_HEADS <- 32

KVH <- 32

MODEL_HEAD_DIM <- (false) ? (128) : ((MODEL_DIM == 5120) ? 128 : 96)

FFN <- 8192

EPS <- 1e-05

THETA <- 10000.0

ROPE_MODE <- "default"

ROPE_ORIGINAL_CONTEXT <- 4096

ROPE_MAX_CONTEXT <- 4096

ROPE_LONG_FACTOR <- []

ROPE_SHORT_FACTOR <- []

HAS_LONGROPE <- false

WINDOW_LOCAL <- 2047

QD = NUM_HEADS * MODEL_HEAD_DIM

KVD = KVH * MODEL_HEAD_DIM

ROPE_ATTENTION_FACTOR = (ROPE_MAX_CONTEXT > ROPE_ORIGINAL_CONTEXT) ? 1.1902380714238083 : 1.0

HAS_LM_HEAD = has_root "lm_head"

phi3minimedium_norm :: Path -> Tensor[B,S,D] -> Tensor[B,S,D]
phi3minimedium_norm@path x = NN.rmsnorm@path x eps=EPS

phi3minimedium_block :: Tensor[B,S,D] -> IdxTensor[B,S] -> Tensor[B,1,S,K] -> ?CacheLayer[B,KVH,P,ROPE_MAX_CONTEXT,DH] -> (Tensor[B,S,D], ?CacheLayer[B,KVH,K,ROPE_MAX_CONTEXT,DH])
phi3minimedium_block x pos_ids mask past_kv = do
  xn <- phi3minimedium_norm@input_layernorm x
  a, new_kv <- scope@self_attn do
    qkv <- NN.linear@qkv_proj xn dim=(QD + KVD + KVD) bias=false
    q, k, v <- Tensor.split qkv sizes=[QD, KVD, KVD]
    q <- reshape_heads q heads=NUM_HEADS
    k <- reshape_heads k heads=KVH
    v <- reshape_heads v heads=KVH
    q, k <- HAS_LONGROPE ? (rope_pair_longrope q k pos_ids THETA ROPE_ORIGINAL_CONTEXT ROPE_MAX_CONTEXT ROPE_LONG_FACTOR ROPE_SHORT_FACTOR attention_factor=ROPE_ATTENTION_FACTOR) : (rope_pair_base q k pos_ids theta=THETA)
    k, v, new_kv <- Cache.update past_kv k v
    k <- Tensor.repeat k repeats=(NUM_HEADS / KVH)
    v <- Tensor.repeat v repeats=(NUM_HEADS / KVH)
    a <- attention q k v mask |> merge_heads |> NN.linear@o_proj dim=MODEL_DIM bias=false
    return a, new_kv
  x <- x + a
  xn <- phi3minimedium_norm@post_attention_layernorm x
  m <- scope@mlp do
    gate_up <- NN.linear@gate_up_proj xn dim=(2 * FFN)
    g, u <- Tensor.split gate_up sizes=[FFN, FFN]
    return g |> silu |> mul u |> NN.linear@down_proj dim=MODEL_DIM
  return x + m, new_kv

phi3minimedium :: TokenIds[B,S] -> ?Mask[B,K,ROPE_MAX_CONTEXT] -> ?Cache[B,KVH,P,ROPE_MAX_CONTEXT,DH] -> ?Bool -> (Tensor[B,S,V], ?Cache[B,KVH,K,ROPE_MAX_CONTEXT,DH])
phi3minimedium input_ids attn_mask past_kv use_cache = do
  past_length <- Cache.past_length past_kv
  attn_mask <- mask_for_input input_ids attn_mask ROPE_MAX_CONTEXT
  pos_ids <- position_ids input_ids attn_mask=attn_mask past_length=past_length
  key_len <- mask_length_for_input input_ids attn_mask past_length
  mask <- causal_mask_for_input input_ids key_len padding_mask=attn_mask window=WINDOW_LOCAL
  work_kv <- Cache.prepare past_kv use_cache ROPE_MAX_CONTEXT
  read_kv <- Cache.read past_kv work_kv
  x, work_kv <- scope@model do
    x <- NN.embedding@embed_tokens input_ids dim=MODEL_DIM
    x, work_kv <- for@layers i <- [0..NUM_LAYERS) carry (x, work_kv) do
      past_i <- Cache.index read_kv i
      x, new_i <- phi3minimedium_block x pos_ids mask past_i
      work_kv <- Cache.append work_kv new_i
      yield x, work_kv
    x <- phi3minimedium_norm@norm x
    return x, work_kv
  logits <- HAS_LM_HEAD ? (NN.linear@lm_head x dim=VOCAB_SIZE) : (NN.linear@model.embed_tokens x dim=VOCAB_SIZE)
  new_length <- past_length + S
  new_kv <- Cache.finish work_kv new_length
  new_kv <- use_cache ? new_kv : null
  return logits, new_kv
