{-# CHECKPOINTS "microsoft/Phi-3-mini-128k-instruct" #-}
{-# TASK "causal_lm" #-}

import Activations
import Activations (silu)
import Attention
import Attention (attention, merge_heads, reshape_heads)
import Masking
import Masking (causal_mask)
import Math
import Math (mul)
import Positions
import Positions (position_ids, rope_pair_longrope)
import Cache
import NN
import Tensor

phi3minimedium_norm :: Path -> Tensor -> Tensor
phi3minimedium_norm@path x = NN.rmsnorm@path x eps=1e-05

phi3minimedium_block :: Tensor -> IdxTensor -> ?Tensor -> ?CacheLayer -> (Tensor, ?CacheLayer)
phi3minimedium_block x pos_ids attn_mask past_kv = do
  xn <- phi3minimedium_norm@input_layernorm x
  a, new_kv <- scope@self_attn do
    qkv <- NN.linear@qkv_proj xn dim=9216 bias=false
    q, k, v <- Tensor.split qkv sizes=[3072, 3072, 3072]
    q <- reshape_heads q heads=32
    k <- reshape_heads k heads=32
    v <- reshape_heads v heads=32
    q, k <- (rope_pair_longrope q k pos_ids 10000.0 4096 131072 [1.0700000524520874, 1.1200000047683716, 1.149999976158142, 1.4199999570846558, 1.5699999332427979, 1.7999999523162842, 2.129999876022339, 2.129999876022339, 3.009999990463257, 5.910000324249268, 6.950000286102295, 9.070000648498535, 9.930000305175781, 10.710000038146973, 11.130000114440918, 14.609999656677246, 15.409998893737793, 19.809999465942383, 37.279998779296875, 38.279998779296875, 38.599998474121094, 40.12000274658203, 46.20000457763672, 50.940006256103516, 53.66000747680664, 54.9373893737793, 56.89738845825195, 57.28738784790039, 59.98738479614258, 60.86738586425781, 60.887386322021484, 61.71739196777344, 62.91739273071289, 62.957393646240234, 63.41739273071289, 63.8173942565918, 63.83739471435547, 63.897396087646484, 63.93739700317383, 64.06739807128906, 64.11434936523438, 64.12435150146484, 64.15435028076172, 64.19435119628906, 64.24435424804688, 64.57435607910156, 64.69000244140625, 64.76000213623047] [1.1, 1.1, 1.1, 1.3000000000000003, 1.3500000000000003, 1.3500000000000003, 1.4000000000000004, 1.5500000000000005, 2.000000000000001, 2.000000000000001, 2.000000000000001, 2.000000000000001, 2.000000000000001, 2.000000000000001, 2.000000000000001, 2.000000000000001, 2.000000000000001, 2.000000000000001, 2.000000000000001, 2.000000000000001, 2.000000000000001, 2.000000000000001, 2.000000000000001, 2.000000000000001, 2.000000000000001, 2.0500000000000007, 2.0500000000000007, 2.0500000000000007, 2.0500000000000007, 2.0500000000000007, 2.0500000000000007, 2.1000000000000005, 2.1000000000000005, 2.1500000000000004, 2.25, 2.25, 2.25, 2.25, 2.25, 2.3999999999999995, 2.4499999999999993, 2.499999999999999, 2.6999999999999984, 2.6999999999999984, 2.7499999999999982, 2.799999999999998, 2.8999999999999977, 3.049999999999997] attention_factor=1.1902380714238083)
    k, v, new_kv <- Cache.update past_kv k v
    k <- Tensor.repeat k repeats=1
    v <- Tensor.repeat v repeats=1
    mask <- causal_mask q k window=262144 padding_mask=attn_mask
    a <- attention q k v mask |> merge_heads |> NN.linear@o_proj dim=3072 bias=false
    return a, new_kv
  x <- x + a
  xn <- phi3minimedium_norm@post_attention_layernorm x
  m <- scope@mlp do
    gate_up <- NN.linear@gate_up_proj xn dim=16384
    g, u <- Tensor.split gate_up sizes=[8192, 8192]
    return g |> silu |> mul u |> NN.linear@down_proj dim=3072
  return x + m, new_kv

phi3minimedium :: TokenIds[B,S] -> ?Tensor[B,S] -> ?Cache -> ?Bool -> (Tensor[B,S,V], ?Cache)
phi3minimedium input_ids attn_mask past_kv use_cache = do
  pos_ids <- position_ids input_ids attn_mask=attn_mask past_length=(Cache.past_length past_kv)
  x, new_kv <- scope@model do
    x <- NN.embedding@embed_tokens input_ids dim=3072
    new_kv <- use_cache ? Cache.init : null
    for@layers i <- [0..32) do
      past_i <- Cache.index past_kv i
      x, new_i <- phi3minimedium_block x pos_ids attn_mask past_i
      new_kv <- Cache.append new_kv new_i
      yield x, new_kv
    x <- phi3minimedium_norm@norm x
    return x, new_kv
  logits <- (NN.linear@lm_head x dim=32064)
  return logits, new_kv
