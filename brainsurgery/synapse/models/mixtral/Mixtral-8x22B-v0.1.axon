{-# CHECKPOINTS "mistralai/Mixtral-8x22B-v0.1" #-}
{-# TASK "causal_lm" #-}

import Activations
import Activations (silu)
import Cache
import Cache
import MoE
import Attention (reshape_heads, merge_heads)
import Attention (attention_masked)
import Masking (causal_mask)
import Positions (position_ids, rope_pair_base)
import Math (mul)

D = 6144
V = 32000
L = 56
H = 48
KVH = 8
KVD = 1024
FFN = 16384
E = 8
EPT = 2
EPS = 1e-05
THETA = 1000000.0
C = 65536

rms :: @Path -> Tensor[B,S,D] -> Tensor[B,S,D]
rms@path x = NN.rmsnorm@path x eps=EPS

mixtral_expert_ffn :: Tensor[N,D] -> Tensor[N,D]
mixtral_expert_ffn x = do
  gate <- NN.linear@w1 x dim=FFN
  up <- NN.linear@w3 x dim=FFN
  return gate |> silu |> mul up |> NN.linear@w2 dim=D bias=false

mixtral_block :: Tensor[B,S,D] -> Tensor[B,S] -> ?Tensor[B,S] -> ?CacheLayer -> (Tensor[B,S,D], ?CacheLayer)
mixtral_block x pos_ids attn_mask past_kv = do
  xn <- rms@input_layernorm x
  a, new_kv <- scope@self_attn do
    q <- NN.linear@q_proj xn dim=D |> reshape_heads heads=H
    k <- NN.linear@k_proj xn dim=KVD |> reshape_heads heads=KVH
    v <- NN.linear@v_proj xn dim=KVD |> reshape_heads heads=KVH
    q, k <- rope_pair_base q k pos_ids THETA
    k, v, new_kv <- Cache.update past_kv k v
    k <- Tensor.repeat k repeats=(H / KVH)
    v <- Tensor.repeat v repeats=(H / KVH)
    mask <- causal_mask q k window=C padding_mask=attn_mask
    a <- attention_masked q k v mask=mask |> merge_heads |> NN.linear@o_proj dim=D
    return a, new_kv
  x <- x + a
  xn <- rms@post_attention_layernorm x
  m <- scope@block_sparse_moe do
    topk_scores, topk_indices <- MoE.softmax_topk_router@gate xn top_k=EPT norm_topk_prob=true weight=@gate.weight
    m <- xn * 0.0
    for@experts e <- [0..E) do
      x_sel, token_idx, topk_pos, sel_scores <- MoE.select xn topk_scores topk_indices e
      x_upd <- mixtral_expert_ffn x_sel
      m <- MoE.scatter_add m token_idx x_upd sel_scores
    return m
  return x + m, new_kv

mixtral :: TokenIds[B,S] -> ?Tensor[B,S] -> ?Cache -> ?Bool -> (Tensor[B,S,V], ?Cache)
mixtral input_ids attn_mask past_kv use_cache = do
  pos_ids <- position_ids input_ids attn_mask=attn_mask past_length=(Cache.past_length past_kv)
  x, new_kv <- scope@model do
    x <- NN.embedding@embed_tokens input_ids dim=D
    new_kv <- use_cache ? Cache.init : null
    for@layers i <- [0..L) do
      past_i <- Cache.index past_kv i
      x, new_i <- mixtral_block x pos_ids attn_mask past_i
      new_kv <- Cache.append new_kv new_i
    x <- rms@norm x
    return x, new_kv
  logits <- NN.linear@lm_head x dim=V bias=false
  return logits, new_kv
