{-# CHECKPOINTS "mistralai/Mixtral-8x22B-v0.1" #-}
{-# TASK "causal_lm" #-}

import Activations
import Activations (silu)
import Attention
import Attention (attention, merge_heads, reshape_heads)
import Masking
import Masking (causal_mask)
import Math
import Math (mul)
import MoE
import MoE (scatter_add, select, softmax_topk_router)
import Positions
import Positions (position_ids, rope_pair_base)
import Cache
import NN
import Tensor

rms :: Path -> Tensor[B,S,D] -> Tensor[B,S,D]
rms@path x = NN.rmsnorm@path x eps=1e-05

mixtral_expert_ffn :: Tensor[N,D] -> Tensor[N,D]
mixtral_expert_ffn x = do
  gate <- NN.linear@w1 x dim=16384
  up <- NN.linear@w3 x dim=16384
  return gate |> silu |> mul up |> NN.linear@w2 dim=6144 bias=false

mixtral_block :: Tensor[B,S,D] -> Tensor[B,S] -> ?Tensor[B,S] -> ?CacheLayer -> (Tensor[B,S,D], ?CacheLayer)
mixtral_block x pos_ids attn_mask past_kv = do
  xn <- rms@input_layernorm x
  a, new_kv <- scope@self_attn do
    q <- NN.linear@q_proj xn dim=6144 |> reshape_heads heads=48
    k <- NN.linear@k_proj xn dim=1024 |> reshape_heads heads=8
    v <- NN.linear@v_proj xn dim=1024 |> reshape_heads heads=8
    q, k <- rope_pair_base q k pos_ids 1000000.0
    k, v, new_kv <- Cache.update past_kv k v
    k <- Tensor.repeat k repeats=6
    v <- Tensor.repeat v repeats=6
    mask <- causal_mask q k window=65536 padding_mask=attn_mask
    a <- attention q k v mask |> merge_heads |> NN.linear@o_proj dim=6144
    return a, new_kv
  x <- x + a
  xn <- rms@post_attention_layernorm x
  m <- scope@block_sparse_moe do
    topk_scores, topk_indices <- softmax_topk_router@gate xn top_k=2 weight=@gate.weight
    m <- xn * 0.0
    for@experts e <- [0..8) do
      x_sel, token_idx, topk_pos, sel_scores <- select xn topk_scores topk_indices e
      x_upd <- mixtral_expert_ffn x_sel
      m <- scatter_add m token_idx x_upd sel_scores
      yield m
    return m
  return x + m, new_kv

mixtral :: TokenIds[B,S] -> ?Tensor[B,S] -> ?Cache -> ?Bool -> (Tensor[B,S,V], ?Cache)
mixtral input_ids attn_mask past_kv use_cache = do
  pos_ids <- position_ids input_ids attn_mask=attn_mask past_length=(Cache.past_length past_kv)
  x, new_kv <- scope@model do
    x <- NN.embedding@embed_tokens input_ids dim=6144
    new_kv <- use_cache ? Cache.init : null
    for@layers i <- [0..56) do
      past_i <- Cache.index past_kv i
      x, new_i <- mixtral_block x pos_ids attn_mask past_i
      new_kv <- Cache.append new_kv new_i
      yield x, new_kv
    x <- rms@norm x
    return x, new_kv
  logits <- NN.linear@lm_head x dim=32000 bias=false
  return logits, new_kv
