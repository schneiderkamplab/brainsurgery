{-# CHECKPOINTS "mistralai/Mixtral-8x22B-Instruct-v0.1" #-}

{-# TASK "causal_lm" #-}

{-# MAIN "mixtral" #-}

import Activations (silu)

import Attention (attention, merge_heads, reshape_heads)

import Masking (causal_mask)

import Math (mul)

import MoE (scatter_add, select, softmax_topk_router)

import Positions (position_ids, rope_pair_base)

import Cache

import Config

import NN

import Tensor

MODEL_DIM = 6144

VOCAB_SIZE = 32768

NUM_LAYERS = 56

NUM_HEADS = 48

KVH = 8

HAS_HEAD_DIM = false

MODEL_HEAD_DIM = HAS_HEAD_DIM ? (128) : (MODEL_DIM / NUM_HEADS)

KVD = KVH * MODEL_HEAD_DIM

FFN = 16384

E = 8

EPT = 2

EPS = 1e-05

THETA = 1000000.0

MAXPOS = 65536

HAS_SLIDING_WINDOW = false

MAX_POSITIONS = HAS_SLIDING_WINDOW ? (Config.int@sliding_window default=32768) : MAXPOS

rms :: Path -> Tensor[B,S,D] -> Tensor[B,S,D]
rms@path x = NN.rmsnorm@path x eps=EPS

mixtral_expert_ffn :: Tensor[N,MODEL_DIM] -> Tensor[N,MODEL_DIM]
mixtral_expert_ffn x = do
  gate <- NN.linear@w1 x dim=FFN
  up <- NN.linear@w3 x dim=FFN
  return gate |> silu |> mul up |> NN.linear@w2 dim=MODEL_DIM bias=false

mixtral_block :: Tensor[B,S,MODEL_DIM] -> Tensor[B,S] -> ?Tensor[B,K] -> ?CacheLayer[B,KVH,P,DH] -> (Tensor[B,S,MODEL_DIM], ?CacheLayer[B,KVH,K,DH])
mixtral_block x pos_ids attn_mask past_kv = do
  xn <- rms@input_layernorm x
  a, new_kv <- scope@self_attn do
    q <- NN.linear@q_proj xn dim=MODEL_DIM |> reshape_heads heads=NUM_HEADS
    k <- NN.linear@k_proj xn dim=KVD |> reshape_heads heads=KVH
    v <- NN.linear@v_proj xn dim=KVD |> reshape_heads heads=KVH
    q, k <- rope_pair_base q k pos_ids THETA
    k, v, new_kv <- Cache.update past_kv k v
    k <- Tensor.repeat k repeats=(NUM_HEADS / KVH)
    v <- Tensor.repeat v repeats=(NUM_HEADS / KVH)
    mask <- causal_mask q k window=MAX_POSITIONS padding_mask=attn_mask
    a <- attention q k v mask |> merge_heads |> NN.linear@o_proj dim=MODEL_DIM
    return a, new_kv
  x <- x + a
  xn <- rms@post_attention_layernorm x
  m <- scope@block_sparse_moe do
    topk_scores, topk_indices <- softmax_topk_router@gate xn top_k=EPT weight=@gate.weight
    m <- xn * 0.0
    m <- for@experts e <- [0..E) carry (m) do
      x_sel, token_idx, topk_pos, sel_scores <- select xn topk_scores topk_indices e
      x_upd <- mixtral_expert_ffn x_sel
      m <- scatter_add m token_idx x_upd sel_scores
      yield m
    return m
  return x + m, new_kv

mixtral :: TokenIds[B,S] -> ?Tensor[B,K] -> ?Cache[B,KVH,P,DH] -> ?Bool -> (Tensor[B,S,V], ?Cache[B,KVH,K,DH])
mixtral input_ids attn_mask past_kv use_cache = do
  pos_ids <- position_ids input_ids attn_mask=attn_mask past_length=(Cache.past_length past_kv)
  x, new_kv <- scope@model do
    x <- NN.embedding@embed_tokens input_ids dim=MODEL_DIM
    new_kv <- use_cache ? Cache.init : null
    x, new_kv <- for@layers i <- [0..NUM_LAYERS) carry (x, new_kv) do
      past_i <- Cache.index past_kv i
      x, new_i <- mixtral_block x pos_ids attn_mask past_i
      new_kv <- Cache.append new_kv new_i
      yield x, new_kv
    x <- rms@norm x
    return x, new_kv
  logits <- NN.linear@lm_head x dim=VOCAB_SIZE bias=false
  return logits, new_kv
