{-# CHECKPOINTS ["google/t5gemma-9b-9b-prefixlm", "google/t5gemma-9b-9b-prefixlm-it"] #-}

{-# TASK "seq2seq_lm" #-}

{-# MAIN "t5gemma" #-}

import Activations (gelu_pytorch_tanh, sigmoid)

import Attention (attention_gqa_with_additive_mask, mask_to_additive_for_input, merge_heads, reshape_heads)

import Masking (bidirectional_mask_for_input, causal_mask_for_input)

import Math (mul, sqrt)

import Positions (position_ids, rope_base_factors, rope_pair_base_factors)

import Config

import NN

import Tensor

D_ENC = 3584

D_DEC = 3584

VOCAB_SIZE = 256000

L_ENC = 42

L_DEC = 42

H_ENC = 16

KVH_ENC = 8

HD_ENC = 256

QD_ENC = H_ENC * HD_ENC

KVD_ENC = KVH_ENC * HD_ENC

H_DEC = 16

KVH_DEC = 8

HD_DEC = 256

QD_DEC = H_DEC * HD_DEC

KVD_DEC = KVH_DEC * HD_DEC

FFN_ENC = 14336

FFN_DEC = 14336

EPS_ENC = 1e-06

EPS_DEC = 1e-06

THETA_ENC = 10000.0

THETA_DEC = 10000.0

WIN_SLIDE_ENC = 4096

WIN_SLIDE_DEC = 4096

WIN_FULL_ENC = 8192

WIN_FULL_DEC = 8192

ROPE_PERIOD_ENC = 2

ROPE_PERIOD_DEC = 2

ATTN_SCALE_ENC = 1.0 / sqrt (256.0)

ATTN_SCALE_DEC = 1.0 / sqrt (256.0)

EMB_SCALE_ENC = sqrt D_ENC

EMB_SCALE_DEC = sqrt D_DEC

LOGIT_SOFTCAP = 30.0

t5gemma_encoder_block :: Tensor[B,S,D_ENC] -> Int -> Tensor[B,1,S,S] -> Tensor[B,1,S,S] -> Tensor[B,H_ENC,S,S] -> Tensor[B,H_ENC,S,S] -> Tensor[B,1,S,HD_ENC] -> Tensor[B,1,S,HD_ENC] -> Tensor[B,S,D_ENC]
t5gemma_encoder_block x i mask_slide mask_full additive_mask_slide additive_mask_full rope_sin rope_cos = do
  xn <- NN.rmsnorm@pre_self_attn_layernorm x eps=EPS_ENC cast_float=true unit_offset=true
  a <- scope@self_attn do
    q <- NN.linear@q_proj xn dim=QD_ENC bias=false |> reshape_heads heads=H_ENC
    k <- NN.linear@k_proj xn dim=KVD_ENC bias=false |> reshape_heads heads=KVH_ENC
    v <- NN.linear@v_proj xn dim=KVD_ENC bias=false |> reshape_heads heads=KVH_ENC
    full_attn <- ((i + 1) % ROPE_PERIOD_ENC) == 0
    q, k <- rope_pair_base_factors q k rope_sin rope_cos
    mask <- full_attn ? mask_full : mask_slide
    additive_mask <- full_attn ? additive_mask_full : additive_mask_slide
    return attention_gqa_with_additive_mask q k v additive_mask mask scale=ATTN_SCALE_ENC |> merge_heads |> NN.linear@o_proj dim=D_ENC bias=false
  a <- NN.rmsnorm@post_self_attn_layernorm a eps=EPS_ENC cast_float=true unit_offset=true
  x <- x + a
  xn <- NN.rmsnorm@pre_feedforward_layernorm x eps=EPS_ENC cast_float=true unit_offset=true
  m <- scope@mlp do
    g <- NN.linear@gate_proj xn dim=FFN_ENC bias=false |> gelu_pytorch_tanh
    u <- NN.linear@up_proj xn dim=FFN_ENC bias=false
    return g |> mul u |> NN.linear@down_proj dim=D_ENC bias=false
  m <- NN.rmsnorm@post_feedforward_layernorm m eps=EPS_ENC cast_float=true unit_offset=true
  return x + m

t5gemma_decoder_block :: Tensor[B,SDEC,D_DEC] -> Tensor[B,SENC,D_ENC] -> Int -> Tensor[B,1,SDEC,SDEC] -> Tensor[B,1,SDEC,SDEC] -> Tensor[B,1,SDEC,SENC] -> Tensor[B,H_DEC,SDEC,SDEC] -> Tensor[B,H_DEC,SDEC,SDEC] -> Tensor[B,H_DEC,SDEC,SENC] -> Tensor[B,1,SDEC,HD_DEC] -> Tensor[B,1,SDEC,HD_DEC] -> Tensor[B,SDEC,D_DEC]
t5gemma_decoder_block x enc_hidden i self_mask_slide self_mask_full cross_mask self_additive_mask_slide self_additive_mask_full cross_additive_mask rope_sin rope_cos = do
  xn <- NN.rmsnorm@pre_self_attn_layernorm x eps=EPS_DEC cast_float=true unit_offset=true
  a <- scope@self_attn do
    q <- NN.linear@q_proj xn dim=QD_DEC bias=false |> reshape_heads heads=H_DEC
    k <- NN.linear@k_proj xn dim=KVD_DEC bias=false |> reshape_heads heads=KVH_DEC
    v <- NN.linear@v_proj xn dim=KVD_DEC bias=false |> reshape_heads heads=KVH_DEC
    full_attn <- ((i + 1) % ROPE_PERIOD_DEC) == 0
    q, k <- rope_pair_base_factors q k rope_sin rope_cos
    mask <- full_attn ? self_mask_full : self_mask_slide
    additive_mask <- full_attn ? self_additive_mask_full : self_additive_mask_slide
    return attention_gqa_with_additive_mask q k v additive_mask mask scale=ATTN_SCALE_DEC |> merge_heads |> NN.linear@o_proj dim=D_DEC bias=false
  a <- NN.rmsnorm@post_self_attn_layernorm a eps=EPS_DEC cast_float=true unit_offset=true
  x <- x + a
  xn <- NN.rmsnorm@pre_cross_attn_layernorm x eps=EPS_DEC cast_float=true unit_offset=true
  a <- scope@cross_attn do
    q <- NN.linear@q_proj xn dim=QD_DEC bias=false |> reshape_heads heads=H_DEC
    k <- NN.linear@k_proj enc_hidden dim=KVD_DEC bias=false |> reshape_heads heads=KVH_DEC
    v <- NN.linear@v_proj enc_hidden dim=KVD_DEC bias=false |> reshape_heads heads=KVH_DEC
    mask <- cross_mask
    return attention_gqa_with_additive_mask q k v cross_additive_mask mask scale=ATTN_SCALE_DEC |> merge_heads |> NN.linear@o_proj dim=D_DEC bias=false
  a <- NN.rmsnorm@post_cross_attn_layernorm a eps=EPS_DEC cast_float=true unit_offset=true
  x <- x + a
  xn <- NN.rmsnorm@pre_feedforward_layernorm x eps=EPS_DEC cast_float=true unit_offset=true
  m <- scope@mlp do
    g <- NN.linear@gate_proj xn dim=FFN_DEC bias=false |> gelu_pytorch_tanh
    u <- NN.linear@up_proj xn dim=FFN_DEC bias=false
    return g |> mul u |> NN.linear@down_proj dim=D_DEC bias=false
  m <- NN.rmsnorm@post_feedforward_layernorm m eps=EPS_DEC cast_float=true unit_offset=true
  return x + m

t5gemma :: TokenIds[B,SENC] -> ?Tensor[B,SENC] -> TokenIds[B,SDEC] -> ?Tensor[B,SDEC] -> Tensor[B,SDEC,V]
t5gemma input_ids attention_mask decoder_input_ids decoder_attention_mask = do
  enc_pos_ids <- position_ids input_ids
  enc_mask_slide <- bidirectional_mask_for_input input_ids SENC padding_mask=attention_mask window=WIN_SLIDE_ENC
  enc_mask_full <- bidirectional_mask_for_input input_ids SENC padding_mask=attention_mask window=WIN_FULL_ENC
  enc_additive_mask_slide <- mask_to_additive_for_input input_ids enc_mask_slide H_ENC
  enc_additive_mask_full <- mask_to_additive_for_input input_ids enc_mask_full H_ENC
  enc_rope_sin, enc_rope_cos <- rope_base_factors enc_pos_ids HD_ENC THETA_ENC
  enc_hidden <- NN.embedding@model.encoder.embed_tokens input_ids dim=D_ENC scale=EMB_SCALE_ENC
  enc_hidden <- for@model.encoder.layers i <- [0..L_ENC) carry (enc_hidden) do
    enc_hidden <- t5gemma_encoder_block enc_hidden i enc_mask_slide enc_mask_full enc_additive_mask_slide enc_additive_mask_full enc_rope_sin enc_rope_cos
    yield enc_hidden
  enc_hidden <- NN.rmsnorm@model.encoder.norm enc_hidden eps=EPS_ENC cast_float=true unit_offset=true
  dec_pos_ids <- position_ids decoder_input_ids
  dec_self_mask_slide <- causal_mask_for_input decoder_input_ids SDEC padding_mask=decoder_attention_mask window=WIN_SLIDE_DEC
  dec_self_mask_full <- causal_mask_for_input decoder_input_ids SDEC padding_mask=decoder_attention_mask window=WIN_FULL_DEC
  cross_mask <- bidirectional_mask_for_input decoder_input_ids SENC padding_mask=attention_mask
  dec_self_additive_mask_slide <- mask_to_additive_for_input decoder_input_ids dec_self_mask_slide H_DEC
  dec_self_additive_mask_full <- mask_to_additive_for_input decoder_input_ids dec_self_mask_full H_DEC
  cross_additive_mask <- mask_to_additive_for_input decoder_input_ids cross_mask H_DEC
  dec_rope_sin, dec_rope_cos <- rope_base_factors dec_pos_ids HD_DEC THETA_DEC
  dec_hidden <- NN.embedding@model.decoder.embed_tokens decoder_input_ids dim=D_DEC scale=EMB_SCALE_DEC
  dec_hidden <- for@model.decoder.layers i <- [0..L_DEC) carry (dec_hidden) do
    dec_hidden <- t5gemma_decoder_block dec_hidden enc_hidden i dec_self_mask_slide dec_self_mask_full cross_mask dec_self_additive_mask_slide dec_self_additive_mask_full cross_additive_mask dec_rope_sin dec_rope_cos
    yield dec_hidden
  dec_hidden <- NN.rmsnorm@model.decoder.norm dec_hidden eps=EPS_DEC cast_float=true unit_offset=true
  logits <- NN.linear@model.decoder.embed_tokens dec_hidden dim=VOCAB_SIZE bias=false
  logits <- logits / LOGIT_SOFTCAP
  logits <- logits * 2.0 |> sigmoid
  logits <- (logits * 2.0) - 1.0
  return logits * LOGIT_SOFTCAP
