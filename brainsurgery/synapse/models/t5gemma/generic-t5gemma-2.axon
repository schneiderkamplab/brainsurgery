{-# CHECKPOINTS ["google/t5gemma-2-270m-270m", "google/t5gemma-2-1b-1b", "google/t5gemma-2-4b-4b"] #-}
{-# TASK "seq2seq_lm" #-}
{-# PADDING_SIDE "right" #-}

import Activations (gelu_pytorch_tanh)
import Config
import Attention (reshape_heads, merge_heads)
import Attention (attention_masked)
import Masking (causal_mask, bidirectional_mask)
import Positions (position_ids, rope_pair_base)
import Math (mul, sqrt)

D = Config.int "hidden_size" root="decoder" default=640
V = Config.int "vocab_size" default=262144
L_ENC = Config.int "num_hidden_layers" root="encoder.text_config" default=18
L_DEC = Config.int "num_hidden_layers" root="decoder" default=18
H = Config.int "num_attention_heads" root="decoder" default=4
KVH = Config.int "num_key_value_heads" root="decoder" default=1
HD = Config.int "head_dim" root="decoder" default=256
QD = H * HD
KVD = KVH * HD
FFN_ENC = Config.int "intermediate_size" root="encoder.text_config" default=2048
FFN_DEC = Config.int "intermediate_size" root="decoder" default=2048
EPS = Config.float "rms_norm_eps" root="decoder" default=1e-06
ROPE_PERIOD_ENC = Config.int "_sliding_window_pattern" root="encoder.text_config" default=6
ROPE_PERIOD_DEC = Config.int "_sliding_window_pattern" root="decoder" default=6
WIN_SLIDE_ENC = Config.int "sliding_window" root="encoder.text_config" default=512
WIN_SLIDE_DEC = Config.int "sliding_window" root="decoder" default=512
WIN_FULL_ENC = Config.int "max_position_embeddings" root="encoder.text_config" default=32768
WIN_FULL_DEC = Config.int "max_position_embeddings" root="decoder" default=32768
THETA_SLIDE_ENC = Config.float "rope_parameters.sliding_attention.rope_theta" root="encoder.text_config" default=10000.0
THETA_FULL_ENC = Config.float "rope_parameters.full_attention.rope_theta" root="encoder.text_config" default=1000000.0
THETA_SLIDE_DEC = Config.float "rope_parameters.sliding_attention.rope_theta" root="decoder" default=10000.0
THETA_FULL_DEC = Config.float "rope_parameters.full_attention.rope_theta" root="decoder" default=1000000.0
ROPE_SCALE_FULL_ENC = Config.float "rope_parameters.full_attention.factor" root="encoder.text_config" default=8.0
ROPE_SCALE_FULL_DEC = Config.float "rope_parameters.full_attention.factor" root="decoder" default=8.0
ATTN_SCALE = 1.0 / sqrt (Config.float "query_pre_attn_scalar" root="decoder" default=256.0)
EMB_SCALE_FAMILY = D == 640 ? 25.25 : (D == 1152 ? 34.0 : (D == 2560 ? 50.5 : sqrt D))
EMB_SCALE_ENC_OVERRIDE = Config.float "embed_scale_encoder" default=-1.0
EMB_SCALE_ENC = (EMB_SCALE_ENC_OVERRIDE > 0.0) ? EMB_SCALE_ENC_OVERRIDE : EMB_SCALE_FAMILY
EMB_SCALE_DEC_OVERRIDE = Config.float "embed_scale_decoder" default=-1.0
EMB_SCALE_DEC = (EMB_SCALE_DEC_OVERRIDE > 0.0) ? EMB_SCALE_DEC_OVERRIDE : sqrt D

t5gemma2_encoder_block :: Tensor[B,S,D] -> Int -> Tensor[B,S] -> ?Tensor[B,S] -> Tensor[B,S,D]
t5gemma2_encoder_block x i pos_ids attention_mask = do
  xn <- NN.rmsnorm@pre_self_attn_layernorm x eps=EPS cast_float=true unit_offset=true
  a <- scope@self_attn do
    q <- NN.linear@q_proj xn dim=QD bias=false |> reshape_heads heads=H |> NN.rmsnorm@q_norm eps=EPS dim=HD cast_float=true unit_offset=true
    k <- NN.linear@k_proj xn dim=KVD bias=false |> reshape_heads heads=KVH |> NN.rmsnorm@k_norm eps=EPS dim=HD cast_float=true unit_offset=true
    v <- NN.linear@v_proj xn dim=KVD bias=false |> reshape_heads heads=KVH

    full_attn <- ((i + 1) % ROPE_PERIOD_ENC) == 0
    theta <- full_attn ? THETA_FULL_ENC : THETA_SLIDE_ENC
    rope_scale <- full_attn ? ROPE_SCALE_FULL_ENC : 1.0
    q, k <- rope_pair_base q k pos_ids theta scale_factor=rope_scale

    k <- Tensor.repeat k repeats=(H / KVH)
    v <- Tensor.repeat v repeats=(H / KVH)
    window <- full_attn ? WIN_FULL_ENC : WIN_SLIDE_ENC
    mask <- bidirectional_mask q k window=window padding_mask=attention_mask
    return attention_masked q k v mask=mask causal=false scale=ATTN_SCALE eager=true |> merge_heads |> NN.linear@o_proj dim=D bias=false
  a <- NN.rmsnorm@post_self_attn_layernorm a eps=EPS cast_float=true unit_offset=true
  x <- x + a

  xn <- NN.rmsnorm@pre_feedforward_layernorm x eps=EPS cast_float=true unit_offset=true
  m <- scope@mlp do
    g <- NN.linear@gate_proj xn dim=FFN_ENC bias=false |> gelu_pytorch_tanh
    u <- NN.linear@up_proj xn dim=FFN_ENC bias=false
    return g |> mul u |> NN.linear@down_proj dim=D bias=false
  m <- NN.rmsnorm@post_feedforward_layernorm m eps=EPS cast_float=true unit_offset=true
  return x + m

t5gemma2_decoder_block :: Tensor[B,SDEC,D] -> Tensor[B,SENC,D] -> Int -> Tensor[B,SDEC] -> ?Tensor[B,SENC] -> ?Tensor[B,SDEC] -> Tensor[B,SDEC,D]
t5gemma2_decoder_block x enc_hidden i pos_ids encoder_attention_mask decoder_attention_mask = do
  xn <- NN.rmsnorm@pre_self_attn_layernorm x eps=EPS cast_float=true unit_offset=true
  a <- scope@self_attn do
    q <- NN.linear@q_proj xn dim=QD bias=false |> reshape_heads heads=H |> NN.rmsnorm@q_norm eps=EPS dim=HD cast_float=true unit_offset=true
    k_self <- NN.linear@k_proj xn dim=KVD bias=false |> reshape_heads heads=KVH |> NN.rmsnorm@k_norm eps=EPS dim=HD cast_float=true unit_offset=true
    v_self <- NN.linear@v_proj xn dim=KVD bias=false |> reshape_heads heads=KVH

    full_attn <- ((i + 1) % ROPE_PERIOD_DEC) == 0
    theta <- full_attn ? THETA_FULL_DEC : THETA_SLIDE_DEC
    rope_scale <- full_attn ? ROPE_SCALE_FULL_DEC : 1.0
    q, k_self <- rope_pair_base q k_self pos_ids theta scale_factor=rope_scale

    k_cross <- NN.linear@k_proj enc_hidden dim=KVD bias=false |> reshape_heads heads=KVH |> NN.rmsnorm@k_norm eps=EPS dim=HD cast_float=true unit_offset=true
    v_cross <- NN.linear@v_proj enc_hidden dim=KVD bias=false |> reshape_heads heads=KVH

    k_merged <- Tensor.concat k_self k_cross dim=2
    v_merged <- Tensor.concat v_self v_cross dim=2

    k_merged <- Tensor.repeat k_merged repeats=(H / KVH)
    v_merged <- Tensor.repeat v_merged repeats=(H / KVH)

    self_window <- full_attn ? WIN_FULL_DEC : WIN_SLIDE_DEC
    self_mask <- causal_mask q k_self window=self_window padding_mask=decoder_attention_mask
    cross_mask <- bidirectional_mask q k_cross padding_mask=encoder_attention_mask
    merged_mask <- Tensor.concat self_mask cross_mask dim=-1

    return attention_masked q k_merged v_merged mask=merged_mask causal=false scale=ATTN_SCALE eager=true |> merge_heads |> NN.linear@o_proj dim=D bias=false
  a <- NN.rmsnorm@post_self_attn_layernorm a eps=EPS cast_float=true unit_offset=true
  x <- x + a

  xn <- NN.rmsnorm@pre_feedforward_layernorm x eps=EPS cast_float=true unit_offset=true
  m <- scope@mlp do
    g <- NN.linear@gate_proj xn dim=FFN_DEC bias=false |> gelu_pytorch_tanh
    u <- NN.linear@up_proj xn dim=FFN_DEC bias=false
    return g |> mul u |> NN.linear@down_proj dim=D bias=false
  m <- NN.rmsnorm@post_feedforward_layernorm m eps=EPS cast_float=true unit_offset=true
  return x + m

t5gemma2 :: TokenIds[B,SENC] -> ?Tensor[B,SENC] -> TokenIds[B,SDEC] -> ?Tensor[B,SDEC] -> Tensor[B,SDEC,V]
t5gemma2 input_ids attention_mask decoder_input_ids decoder_attention_mask = do
  enc_pos_ids <- position_ids input_ids attention_mask
  enc_hidden <- NN.embedding@model.encoder.embed_tokens input_ids dim=D scale=EMB_SCALE_ENC
  for@model.encoder.layers i <- [0..L_ENC) do
    enc_hidden <- t5gemma2_encoder_block enc_hidden i enc_pos_ids attention_mask
  enc_hidden <- NN.rmsnorm@model.encoder.norm enc_hidden eps=EPS cast_float=true unit_offset=true

  dec_pos_ids <- position_ids decoder_input_ids decoder_attention_mask
  dec_hidden <- NN.embedding@model.encoder.embed_tokens decoder_input_ids dim=D scale=EMB_SCALE_DEC
  for@model.decoder.layers i <- [0..L_DEC) do
    dec_hidden <- t5gemma2_decoder_block dec_hidden enc_hidden i dec_pos_ids attention_mask decoder_attention_mask
  dec_hidden <- NN.rmsnorm@model.decoder.norm dec_hidden eps=EPS cast_float=true unit_offset=true

  logits <- NN.linear@model.encoder.embed_tokens dec_hidden dim=V bias=false
  return logits
