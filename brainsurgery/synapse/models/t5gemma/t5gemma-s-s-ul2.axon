{-# CHECKPOINTS ["google/t5gemma-s-s-ul2", "google/t5gemma-s-s-ul2-it"] #-}
{-# TASK "seq2seq_lm" #-}

import Activations
import Activations (gelu_pytorch_tanh, sigmoid)
import Attention
import Attention (attention, merge_heads, reshape_heads)
import Masking
import Masking (bidirectional_mask, causal_mask)
import Math
import Math (mul, sqrt)
import Positions
import Positions (position_ids, rope_pair_base)

t5gemma_encoder_block :: Tensor[B,S,D] -> Int -> Tensor[B,S] -> ?Tensor[B,S] -> Tensor[B,S,D]
t5gemma_encoder_block x i pos_ids attention_mask = do
  xn <- NN.rmsnorm@pre_self_attn_layernorm x eps=1e-06 cast_float=true unit_offset=true
  a <- scope@self_attn do
    q <- NN.linear@q_proj xn dim=512 bias=false |> reshape_heads heads=8
    k <- NN.linear@k_proj xn dim=512 bias=false |> reshape_heads heads=8
    v <- NN.linear@v_proj xn dim=512 bias=false |> reshape_heads heads=8
    q, k <- rope_pair_base q k pos_ids 10000.0
    k <- Tensor.repeat k repeats=1
    v <- Tensor.repeat v repeats=1
    full_attn <- ((i + 1) % 2) == 0
    window <- full_attn ? 8192 : 4096
    mask <- bidirectional_mask q k window=window padding_mask=attention_mask
    return attention q k v mask scale=0.125 |> merge_heads |> NN.linear@o_proj dim=512 bias=false
  a <- NN.rmsnorm@post_self_attn_layernorm a eps=1e-06 cast_float=true unit_offset=true
  x <- x + a
  xn <- NN.rmsnorm@pre_feedforward_layernorm x eps=1e-06 cast_float=true unit_offset=true
  m <- scope@mlp do
    g <- NN.linear@gate_proj xn dim=1024 bias=false |> gelu_pytorch_tanh
    u <- NN.linear@up_proj xn dim=1024 bias=false
    return g |> mul u |> NN.linear@down_proj dim=512 bias=false
  m <- NN.rmsnorm@post_feedforward_layernorm m eps=1e-06 cast_float=true unit_offset=true
  return x + m

t5gemma_decoder_block :: Tensor[B,SDEC,D] -> Tensor[B,SENC,D] -> Int -> Tensor[B,SDEC] -> ?Tensor[B,SENC] -> ?Tensor[B,SDEC] -> Tensor[B,SDEC,D]
t5gemma_decoder_block x enc_hidden i pos_ids encoder_attention_mask decoder_attention_mask = do
  xn <- NN.rmsnorm@pre_self_attn_layernorm x eps=1e-06 cast_float=true unit_offset=true
  a <- scope@self_attn do
    q <- NN.linear@q_proj xn dim=512 bias=false |> reshape_heads heads=8
    k <- NN.linear@k_proj xn dim=512 bias=false |> reshape_heads heads=8
    v <- NN.linear@v_proj xn dim=512 bias=false |> reshape_heads heads=8
    q, k <- rope_pair_base q k pos_ids 10000.0
    k <- Tensor.repeat k repeats=1
    v <- Tensor.repeat v repeats=1
    full_attn <- ((i + 1) % 2) == 0
    window <- full_attn ? 8192 : 4096
    mask <- causal_mask q k window=window padding_mask=decoder_attention_mask
    return attention q k v mask scale=0.125 |> merge_heads |> NN.linear@o_proj dim=512 bias=false
  a <- NN.rmsnorm@post_self_attn_layernorm a eps=1e-06 cast_float=true unit_offset=true
  x <- x + a
  xn <- NN.rmsnorm@pre_cross_attn_layernorm x eps=1e-06 cast_float=true unit_offset=true
  a <- scope@cross_attn do
    q <- NN.linear@q_proj xn dim=512 bias=false |> reshape_heads heads=8
    k <- NN.linear@k_proj enc_hidden dim=512 bias=false |> reshape_heads heads=8
    v <- NN.linear@v_proj enc_hidden dim=512 bias=false |> reshape_heads heads=8
    k <- Tensor.repeat k repeats=1
    v <- Tensor.repeat v repeats=1
    mask <- bidirectional_mask q k padding_mask=encoder_attention_mask
    return attention q k v mask scale=0.125 |> merge_heads |> NN.linear@o_proj dim=512 bias=false
  a <- NN.rmsnorm@post_cross_attn_layernorm a eps=1e-06 cast_float=true unit_offset=true
  x <- x + a
  xn <- NN.rmsnorm@pre_feedforward_layernorm x eps=1e-06 cast_float=true unit_offset=true
  m <- scope@mlp do
    g <- NN.linear@gate_proj xn dim=1024 bias=false |> gelu_pytorch_tanh
    u <- NN.linear@up_proj xn dim=1024 bias=false
    return g |> mul u |> NN.linear@down_proj dim=512 bias=false
  m <- NN.rmsnorm@post_feedforward_layernorm m eps=1e-06 cast_float=true unit_offset=true
  return x + m

t5gemma :: TokenIds[B,SENC] -> ?Tensor[B,SENC] -> TokenIds[B,SDEC] -> ?Tensor[B,SDEC] -> Tensor[B,SDEC,V]
t5gemma input_ids attention_mask decoder_input_ids decoder_attention_mask = do
  enc_pos_ids <- position_ids input_ids
  enc_hidden <- NN.embedding@model.encoder.embed_tokens input_ids dim=512 scale=22.627416997969522
  for@model.encoder.layers i <- [0..8) do
    enc_hidden <- t5gemma_encoder_block enc_hidden i enc_pos_ids attention_mask
    yield enc_hidden
  enc_hidden <- NN.rmsnorm@model.encoder.norm enc_hidden eps=1e-06 cast_float=true unit_offset=true
  dec_pos_ids <- position_ids decoder_input_ids
  dec_hidden <- NN.embedding@model.decoder.embed_tokens decoder_input_ids dim=512 scale=22.627416997969522
  for@model.decoder.layers i <- [0..8) do
    dec_hidden <- t5gemma_decoder_block dec_hidden enc_hidden i dec_pos_ids attention_mask decoder_attention_mask
    yield dec_hidden
  dec_hidden <- NN.rmsnorm@model.decoder.norm dec_hidden eps=1e-06 cast_float=true unit_offset=true
  logits <- NN.linear@model.decoder.embed_tokens dec_hidden dim=256000 bias=false
  logits <- logits / 30.0
  logits <- logits * 2.0 |> sigmoid
  logits <- (logits * 2.0) - 1.0
  return logits * 30.0
