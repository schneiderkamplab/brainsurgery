{-# CHECKPOINTS ["google/t5gemma-s-s-ul2", "google/t5gemma-s-s-ul2-it"] #-}
{-# TASK "seq2seq_lm" #-}

import Activations
import Activations (gelu_pytorch_tanh, sigmoid)

D = 512
V = 256000
L_ENC = 8
L_DEC = 8
H = 8
KVH = 8
QD = 512
KVD = 512
FFN_ENC = 1024
FFN_DEC = 1024
EPS = 1e-06
THETA = 10000.0
WIN_SLIDE_ENC = 4096
WIN_SLIDE_DEC = 4096
WIN_FULL_ENC = 8192
WIN_FULL_DEC = 8192
ROPE_PERIOD_ENC = 2
ROPE_PERIOD_DEC = 2
ATTN_SCALE = 0.125
EMB_SCALE = 22.627416997969522
LOGIT_SOFTCAP = 30.0

t5gemma_encoder_block :: Tensor[B,S,D] -> Int -> Tensor[B,S] -> ?Tensor[B,S] -> Tensor[B,S,D]
t5gemma_encoder_block x i pos_ids attention_mask = do
  xn <- rmsnorm@pre_self_attn_layernorm x eps=EPS cast_float=true unit_offset=true
  a <- scope@self_attn do
    q <- linear@q_proj xn dim=QD bias=false |> reshape_heads heads=H
    k <- linear@k_proj xn dim=KVD bias=false |> reshape_heads heads=KVH
    v <- linear@v_proj xn dim=KVD bias=false |> reshape_heads heads=KVH
    q, k <- rope_pair q k position_ids=pos_ids theta=THETA
    k <- repeat k repeats=(H / KVH)
    v <- repeat v repeats=(H / KVH)
    full_attn <- ((i + 1) % ROPE_PERIOD_ENC) == 0
    window <- full_attn ? WIN_FULL_ENC : WIN_SLIDE_ENC
    mask <- bidirectional_mask q k window=window padding_mask=attention_mask
    return attention q k v mask=mask causal=false scale=ATTN_SCALE |> merge_heads |> linear@o_proj dim=D bias=false
  a <- rmsnorm@post_self_attn_layernorm a eps=EPS cast_float=true unit_offset=true
  x <- x + a
  xn <- rmsnorm@pre_feedforward_layernorm x eps=EPS cast_float=true unit_offset=true
  m <- scope@mlp do
    g <- linear@gate_proj xn dim=FFN_ENC bias=false |> gelu_pytorch_tanh
    u <- linear@up_proj xn dim=FFN_ENC bias=false
    return g |> mul u |> linear@down_proj dim=D bias=false
  m <- rmsnorm@post_feedforward_layernorm m eps=EPS cast_float=true unit_offset=true
  return x + m

t5gemma_decoder_block :: Tensor[B,SDEC,D] -> Tensor[B,SENC,D] -> Int -> Tensor[B,SDEC] -> ?Tensor[B,SENC] -> ?Tensor[B,SDEC] -> Tensor[B,SDEC,D]
t5gemma_decoder_block x enc_hidden i pos_ids encoder_attention_mask decoder_attention_mask = do
  xn <- rmsnorm@pre_self_attn_layernorm x eps=EPS cast_float=true unit_offset=true
  a <- scope@self_attn do
    q <- linear@q_proj xn dim=QD bias=false |> reshape_heads heads=H
    k <- linear@k_proj xn dim=KVD bias=false |> reshape_heads heads=KVH
    v <- linear@v_proj xn dim=KVD bias=false |> reshape_heads heads=KVH
    q, k <- rope_pair q k position_ids=pos_ids theta=THETA
    k <- repeat k repeats=(H / KVH)
    v <- repeat v repeats=(H / KVH)
    full_attn <- ((i + 1) % ROPE_PERIOD_DEC) == 0
    window <- full_attn ? WIN_FULL_DEC : WIN_SLIDE_DEC
    mask <- causal_mask q k window=window padding_mask=decoder_attention_mask
    return attention q k v mask=mask causal=false scale=ATTN_SCALE |> merge_heads |> linear@o_proj dim=D bias=false
  a <- rmsnorm@post_self_attn_layernorm a eps=EPS cast_float=true unit_offset=true
  x <- x + a
  xn <- rmsnorm@pre_cross_attn_layernorm x eps=EPS cast_float=true unit_offset=true
  a <- scope@cross_attn do
    q <- linear@q_proj xn dim=QD bias=false |> reshape_heads heads=H
    k <- linear@k_proj enc_hidden dim=KVD bias=false |> reshape_heads heads=KVH
    v <- linear@v_proj enc_hidden dim=KVD bias=false |> reshape_heads heads=KVH
    k <- repeat k repeats=(H / KVH)
    v <- repeat v repeats=(H / KVH)
    mask <- bidirectional_mask q k padding_mask=encoder_attention_mask
    return attention q k v mask=mask causal=false scale=ATTN_SCALE |> merge_heads |> linear@o_proj dim=D bias=false
  a <- rmsnorm@post_cross_attn_layernorm a eps=EPS cast_float=true unit_offset=true
  x <- x + a
  xn <- rmsnorm@pre_feedforward_layernorm x eps=EPS cast_float=true unit_offset=true
  m <- scope@mlp do
    g <- linear@gate_proj xn dim=FFN_DEC bias=false |> gelu_pytorch_tanh
    u <- linear@up_proj xn dim=FFN_DEC bias=false
    return g |> mul u |> linear@down_proj dim=D bias=false
  m <- rmsnorm@post_feedforward_layernorm m eps=EPS cast_float=true unit_offset=true
  return x + m

t5gemma :: TokenIds[B,SENC] -> ?Tensor[B,SENC] -> TokenIds[B,SDEC] -> ?Tensor[B,SDEC] -> Tensor[B,SDEC,V]
t5gemma input_ids attention_mask decoder_input_ids decoder_attention_mask = do
  enc_pos_ids <- position_ids input_ids
  enc_hidden <- embedding@model.encoder.embed_tokens input_ids dim=D scale=EMB_SCALE
  for@model.encoder.layers i <- [0..L_ENC) do
    enc_hidden <- t5gemma_encoder_block enc_hidden i enc_pos_ids attention_mask
  enc_hidden <- rmsnorm@model.encoder.norm enc_hidden eps=EPS cast_float=true unit_offset=true
  dec_pos_ids <- position_ids decoder_input_ids
  dec_hidden <- embedding@model.decoder.embed_tokens decoder_input_ids dim=D scale=EMB_SCALE
  for@model.decoder.layers i <- [0..L_DEC) do
    dec_hidden <- t5gemma_decoder_block dec_hidden enc_hidden i dec_pos_ids attention_mask decoder_attention_mask
  dec_hidden <- rmsnorm@model.decoder.norm dec_hidden eps=EPS cast_float=true unit_offset=true
  logits <- linear@model.decoder.embed_tokens dec_hidden dim=V bias=false
  logits <- logits / LOGIT_SOFTCAP
  logits <- logits * 2.0 |> sigmoid
  logits <- (logits * 2.0) - 1.0
  return logits * LOGIT_SOFTCAP
