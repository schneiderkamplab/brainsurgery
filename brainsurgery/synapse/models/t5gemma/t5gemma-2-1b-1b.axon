{-# CHECKPOINTS "google/t5gemma-2-1b-1b" #-}
{-# TASK "seq2seq_lm" #-}
{-# PADDING_SIDE "right" #-}

import Activations
import Activations (gelu_pytorch_tanh)
import Attention
import Attention (attention, merge_heads, reshape_heads)
import Masking
import Masking (bidirectional_mask, causal_mask)
import Math
import Math (mul)
import Positions
import Positions (position_ids, rope_pair_base)
import NN
import Tensor

t5gemma2_encoder_block :: Tensor[B,S,D] -> Int -> Tensor[B,S] -> ?Tensor[B,S] -> Tensor[B,S,D]
t5gemma2_encoder_block x i pos_ids attention_mask = do
  xn <- NN.rmsnorm@pre_self_attn_layernorm x eps=1e-06 cast_float=true unit_offset=true
  a <- scope@self_attn do
    q <- NN.linear@q_proj xn dim=1024 bias=false |> reshape_heads heads=4 |> NN.rmsnorm@q_norm eps=1e-06 dim=256 cast_float=true unit_offset=true
    k <- NN.linear@k_proj xn dim=256 bias=false |> reshape_heads heads=1 |> NN.rmsnorm@k_norm eps=1e-06 dim=256 cast_float=true unit_offset=true
    v <- NN.linear@v_proj xn dim=256 bias=false |> reshape_heads heads=1
    full_attn <- ((i + 1) % 6) == 0
    theta <- full_attn ? 1000000.0 : 10000.0
    rope_scale <- full_attn ? 8.0 : 1.0
    q, k <- rope_pair_base q k pos_ids theta scale_factor=rope_scale
    k <- Tensor.repeat k repeats=4
    v <- Tensor.repeat v repeats=4
    window <- full_attn ? 32768 : 512
    mask <- bidirectional_mask q k window=window padding_mask=attention_mask
    return attention q k v mask scale=0.0625 |> merge_heads |> NN.linear@o_proj dim=1152 bias=false
  a <- NN.rmsnorm@post_self_attn_layernorm a eps=1e-06 cast_float=true unit_offset=true
  x <- x + a
  xn <- NN.rmsnorm@pre_feedforward_layernorm x eps=1e-06 cast_float=true unit_offset=true
  m <- scope@mlp do
    g <- NN.linear@gate_proj xn dim=6912 bias=false |> gelu_pytorch_tanh
    u <- NN.linear@up_proj xn dim=6912 bias=false
    return g |> mul u |> NN.linear@down_proj dim=1152 bias=false
  m <- NN.rmsnorm@post_feedforward_layernorm m eps=1e-06 cast_float=true unit_offset=true
  return x + m

t5gemma2_decoder_block :: Tensor[B,SDEC,D] -> Tensor[B,SENC,D] -> Int -> Tensor[B,SDEC] -> ?Tensor[B,SENC] -> ?Tensor[B,SDEC] -> Tensor[B,SDEC,D]
t5gemma2_decoder_block x enc_hidden i pos_ids encoder_attention_mask decoder_attention_mask = do
  xn <- NN.rmsnorm@pre_self_attn_layernorm x eps=1e-06 cast_float=true unit_offset=true
  a <- scope@self_attn do
    q <- NN.linear@q_proj xn dim=1024 bias=false |> reshape_heads heads=4 |> NN.rmsnorm@q_norm eps=1e-06 dim=256 cast_float=true unit_offset=true
    k_self <- NN.linear@k_proj xn dim=256 bias=false |> reshape_heads heads=1 |> NN.rmsnorm@k_norm eps=1e-06 dim=256 cast_float=true unit_offset=true
    v_self <- NN.linear@v_proj xn dim=256 bias=false |> reshape_heads heads=1
    full_attn <- ((i + 1) % 6) == 0
    theta <- full_attn ? 1000000.0 : 10000.0
    rope_scale <- full_attn ? 8.0 : 1.0
    q, k_self <- rope_pair_base q k_self pos_ids theta scale_factor=rope_scale
    k_cross <- NN.linear@k_proj enc_hidden dim=256 bias=false |> reshape_heads heads=1 |> NN.rmsnorm@k_norm eps=1e-06 dim=256 cast_float=true unit_offset=true
    v_cross <- NN.linear@v_proj enc_hidden dim=256 bias=false |> reshape_heads heads=1
    k_merged <- Tensor.concat k_self k_cross dim=2
    v_merged <- Tensor.concat v_self v_cross dim=2
    k_merged <- Tensor.repeat k_merged repeats=4
    v_merged <- Tensor.repeat v_merged repeats=4
    self_window <- full_attn ? 32768 : 512
    self_mask <- causal_mask q k_self window=self_window padding_mask=decoder_attention_mask
    cross_mask <- bidirectional_mask q k_cross padding_mask=encoder_attention_mask
    merged_mask <- Tensor.concat self_mask cross_mask dim=-1
    return attention q k_merged v_merged merged_mask scale=0.0625 |> merge_heads |> NN.linear@o_proj dim=1152 bias=false
  a <- NN.rmsnorm@post_self_attn_layernorm a eps=1e-06 cast_float=true unit_offset=true
  x <- x + a
  xn <- NN.rmsnorm@pre_feedforward_layernorm x eps=1e-06 cast_float=true unit_offset=true
  m <- scope@mlp do
    g <- NN.linear@gate_proj xn dim=6912 bias=false |> gelu_pytorch_tanh
    u <- NN.linear@up_proj xn dim=6912 bias=false
    return g |> mul u |> NN.linear@down_proj dim=1152 bias=false
  m <- NN.rmsnorm@post_feedforward_layernorm m eps=1e-06 cast_float=true unit_offset=true
  return x + m

t5gemma2 :: TokenIds[B,SENC] -> ?Tensor[B,SENC] -> TokenIds[B,SDEC] -> ?Tensor[B,SDEC] -> Tensor[B,SDEC,V]
t5gemma2 input_ids attention_mask decoder_input_ids decoder_attention_mask = do
  enc_pos_ids <- position_ids input_ids attention_mask
  enc_hidden <- NN.embedding@model.encoder.embed_tokens input_ids dim=1152 scale=34.0
  for@model.encoder.layers i <- [0..26) do
    enc_hidden <- t5gemma2_encoder_block enc_hidden i enc_pos_ids attention_mask
    yield enc_hidden
  enc_hidden <- NN.rmsnorm@model.encoder.norm enc_hidden eps=1e-06 cast_float=true unit_offset=true
  dec_pos_ids <- position_ids decoder_input_ids decoder_attention_mask
  dec_hidden <- NN.embedding@model.encoder.embed_tokens decoder_input_ids dim=1152 scale=33.94112549695428
  for@model.decoder.layers i <- [0..26) do
    dec_hidden <- t5gemma2_decoder_block dec_hidden enc_hidden i dec_pos_ids attention_mask decoder_attention_mask
    yield dec_hidden
  dec_hidden <- NN.rmsnorm@model.decoder.norm dec_hidden eps=1e-06 cast_float=true unit_offset=true
  logits <- NN.linear@model.encoder.embed_tokens dec_hidden dim=262144 bias=false
  return logits
