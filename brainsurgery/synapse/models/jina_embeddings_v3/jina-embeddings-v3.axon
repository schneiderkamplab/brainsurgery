{-# CHECKPOINTS "jinaai/jina-embeddings-v3" #-}

{-# TASK "masked_lm" #-}

{-# MAIN "jina_embeddings_v3" #-}

import Activations (gelu)

import Attention (attention, merge_heads, reshape_heads)

import Masking (Mask, bidirectional_mask_for_input, mask_for_input)

import Positions (position_ids, rope_pair_base)

import Config

import NN

MODEL_DIM <- 1024

VOCAB_SIZE <- 250002

NUM_LAYERS <- 24

NUM_HEADS <- 16

FFN <- 4096

EPS <- 1e-05

ROPE_THETA <- 20000.0

jina_embeddings_v3_block :: Tensor[B,S,D] -> Tensor[B,S] -> Tensor[B,1,S,S] -> Tensor[B,S,D]
jina_embeddings_v3_block x pos_ids keep = do
  a <- scope@self_attn do
    q <- NN.linear@q_proj x dim=MODEL_DIM bias=true |> reshape_heads heads=NUM_HEADS
    k <- NN.linear@k_proj x dim=MODEL_DIM bias=true |> reshape_heads heads=NUM_HEADS
    v <- NN.linear@v_proj x dim=MODEL_DIM bias=true |> reshape_heads heads=NUM_HEADS
    q, k <- rope_pair_base q k pos_ids theta=ROPE_THETA interleaved=false
    return attention q k v keep |> merge_heads |> NN.linear@o_proj dim=MODEL_DIM bias=true
  x <- x + a
  x <- NN.layernorm@post_attention_layernorm x eps=EPS
  m <- NN.linear@mlp.fc1 x dim=FFN bias=true |> gelu
  m <- NN.linear@mlp.fc2 m dim=MODEL_DIM bias=true
  y <- x + m
  return NN.layernorm@post_mlp_layernorm y eps=EPS

jina_embeddings_v3 :: TokenIds[B,S] -> ?Mask[B,S,S] -> Tensor[B,S,VOCAB_SIZE]
jina_embeddings_v3 input_ids attn_mask = do
  attn_mask <- mask_for_input input_ids attn_mask S
  pos_ids <- position_ids input_ids
  keep <- bidirectional_mask_for_input input_ids S padding_mask=attn_mask
  tok_type_ids <- input_ids - input_ids
  tok <- NN.embedding@roberta.embeddings.word_embeddings input_ids dim=MODEL_DIM
  typ <- NN.embedding@roberta.embeddings.token_type_embeddings tok_type_ids dim=MODEL_DIM
  x <- tok + typ
  x <- NN.layernorm@roberta.embeddings.LayerNorm x eps=EPS
  x <- for@roberta.layers i <- [0..NUM_LAYERS) carry (x) do
    x <- jina_embeddings_v3_block x pos_ids keep
    yield x
  logits <- scope@lm_head do
    x <- NN.linear@dense x dim=MODEL_DIM bias=true |> gelu
    x <- NN.layernorm@layer_norm x eps=EPS
    return NN.linear@decoder x dim=VOCAB_SIZE bias=true weight_path=@@roberta.embeddings.word_embeddings.weight bias_path=@@lm_head.bias
  return logits
