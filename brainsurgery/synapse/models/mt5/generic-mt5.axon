{-# CHECKPOINTS ["google/mt5-small", "google/mt5-base", "google/mt5-large", "google/mt5-xl", "google/mt5-xxl"] #-}
{-# TASK "seq2seq_lm" #-}

import Activations (gelu_new)
import Config
import Attention (attention, reshape_heads, merge_heads)
import Masking (causal_mask, bidirectional_mask)
import Compat (t5_relative_position_bias)
import Math (mul)

D = Config.int "d_model" default=512
V = Config.int "vocab_size" default=250112
L_ENC = Config.int "num_layers" default=8
L_DEC_OVERRIDE = Config.int "num_decoder_layers" default=-1
L_DEC = (L_DEC_OVERRIDE > 0) ? L_DEC_OVERRIDE : L_ENC
H = Config.int "num_heads" default=6
FFN = Config.int "d_ff" default=1024
EPS = Config.float "layer_norm_epsilon" default=1e-06
NUM_BUCKETS = Config.int "relative_attention_num_buckets" default=32
MAX_DISTANCE = Config.int "relative_attention_max_distance" default=128

mt5_encoder_block :: Tensor[B,S,D] -> ?Tensor[B,S] -> Tensor[B,S,D]
mt5_encoder_block x attention_mask = do
  self_attn <- scope@layer.0 do
    x_norm <- NN.rmsnorm@layer_norm x eps=EPS cast_float=true
    q <- NN.linear@SelfAttention.q x_norm dim=D bias=false |> reshape_heads heads=H
    k <- NN.linear@SelfAttention.k x_norm dim=D bias=false |> reshape_heads heads=H
    v <- NN.linear@SelfAttention.v x_norm dim=D bias=false |> reshape_heads heads=H
    rel_bias <- t5_relative_position_bias@@encoder.block.0.layer.0.SelfAttention.relative_attention_bias q k num_buckets=NUM_BUCKETS max_distance=MAX_DISTANCE bidirectional=true
    keep <- bidirectional_mask q k padding_mask=attention_mask
    return attention q k v keep rel_bias=rel_bias scale=1.0 |> merge_heads |> NN.linear@SelfAttention.o dim=D bias=false
  x <- x + self_attn
  ffn <- scope@layer.1 do
    x_norm <- NN.rmsnorm@layer_norm x eps=EPS cast_float=true
    g <- NN.linear@DenseReluDense.wi_0 x_norm dim=FFN bias=false |> gelu_new
    u <- NN.linear@DenseReluDense.wi_1 x_norm dim=FFN bias=false
    x_ffn <- g |> mul u
    return NN.linear@DenseReluDense.wo x_ffn dim=D bias=false
  y <- x + ffn
  return y

mt5_decoder_block :: Tensor[B,SDEC,D] -> Tensor[B,SENC,D] -> ?Tensor[B,SENC] -> ?Tensor[B,SDEC] -> Tensor[B,SDEC,D]
mt5_decoder_block x enc_hidden encoder_attention_mask decoder_attention_mask = do
  self_attn <- scope@layer.0 do
    x_norm <- NN.rmsnorm@layer_norm x eps=EPS cast_float=true
    q <- NN.linear@SelfAttention.q x_norm dim=D bias=false |> reshape_heads heads=H
    k <- NN.linear@SelfAttention.k x_norm dim=D bias=false |> reshape_heads heads=H
    v <- NN.linear@SelfAttention.v x_norm dim=D bias=false |> reshape_heads heads=H
    rel_bias <- t5_relative_position_bias@@decoder.block.0.layer.0.SelfAttention.relative_attention_bias q k num_buckets=NUM_BUCKETS max_distance=MAX_DISTANCE bidirectional=false
    keep <- causal_mask q k window=1048576 padding_mask=decoder_attention_mask
    return attention q k v keep rel_bias=rel_bias scale=1.0 |> merge_heads |> NN.linear@SelfAttention.o dim=D bias=false
  x <- x + self_attn
  cross_attn <- scope@layer.1 do
    x_norm <- NN.rmsnorm@layer_norm x eps=EPS cast_float=true
    q <- NN.linear@EncDecAttention.q x_norm dim=D bias=false |> reshape_heads heads=H
    k <- NN.linear@EncDecAttention.k enc_hidden dim=D bias=false |> reshape_heads heads=H
    v <- NN.linear@EncDecAttention.v enc_hidden dim=D bias=false |> reshape_heads heads=H
    keep <- bidirectional_mask q k padding_mask=encoder_attention_mask
    return attention q k v keep scale=1.0 |> merge_heads |> NN.linear@EncDecAttention.o dim=D bias=false
  x <- x + cross_attn
  ffn <- scope@layer.2 do
    x_norm <- NN.rmsnorm@layer_norm x eps=EPS cast_float=true
    g <- NN.linear@DenseReluDense.wi_0 x_norm dim=FFN bias=false |> gelu_new
    u <- NN.linear@DenseReluDense.wi_1 x_norm dim=FFN bias=false
    x_ffn <- g |> mul u
    return NN.linear@DenseReluDense.wo x_ffn dim=D bias=false
  y <- x + ffn
  return y

mt5 :: TokenIds[B,SENC] -> ?Tensor[B,SENC] -> TokenIds[B,SDEC] -> ?Tensor[B,SDEC] -> Tensor[B,SDEC,V]
mt5 input_ids attention_mask decoder_input_ids decoder_attention_mask = do
  enc_hidden <- NN.embedding@shared input_ids dim=D
  for@encoder.block i <- [0..L_ENC) do
    self_attn <- scope@layer.0 do
      x_norm <- NN.rmsnorm@layer_norm enc_hidden eps=EPS cast_float=true
      q <- NN.linear@SelfAttention.q x_norm dim=D bias=false |> reshape_heads heads=H
      k <- NN.linear@SelfAttention.k x_norm dim=D bias=false |> reshape_heads heads=H
      v <- NN.linear@SelfAttention.v x_norm dim=D bias=false |> reshape_heads heads=H
      rel_bias <- t5_relative_position_bias@@encoder.block.0.layer.0.SelfAttention.relative_attention_bias q k num_buckets=NUM_BUCKETS max_distance=MAX_DISTANCE bidirectional=true
      keep <- bidirectional_mask q k padding_mask=attention_mask
      return attention q k v keep rel_bias=rel_bias scale=1.0 |> merge_heads |> NN.linear@SelfAttention.o dim=D bias=false
    enc_hidden <- enc_hidden + self_attn
    ffn <- scope@layer.1 do
      x_norm <- NN.rmsnorm@layer_norm enc_hidden eps=EPS cast_float=true
      g <- NN.linear@DenseReluDense.wi_0 x_norm dim=FFN bias=false |> gelu_new
      u <- NN.linear@DenseReluDense.wi_1 x_norm dim=FFN bias=false
      x_ffn <- g |> mul u
      return NN.linear@DenseReluDense.wo x_ffn dim=D bias=false
    enc_hidden <- enc_hidden + ffn
  enc_hidden <- NN.rmsnorm@encoder.final_layer_norm enc_hidden eps=EPS

  dec_hidden <- NN.embedding@shared decoder_input_ids dim=D
  for@decoder.block i <- [0..L_DEC) do
    self_attn <- scope@layer.0 do
      x_norm <- NN.rmsnorm@layer_norm dec_hidden eps=EPS cast_float=true
      q <- NN.linear@SelfAttention.q x_norm dim=D bias=false |> reshape_heads heads=H
      k <- NN.linear@SelfAttention.k x_norm dim=D bias=false |> reshape_heads heads=H
      v <- NN.linear@SelfAttention.v x_norm dim=D bias=false |> reshape_heads heads=H
      rel_bias <- t5_relative_position_bias@@decoder.block.0.layer.0.SelfAttention.relative_attention_bias q k num_buckets=NUM_BUCKETS max_distance=MAX_DISTANCE bidirectional=false
      keep <- causal_mask q k window=1048576 padding_mask=decoder_attention_mask
      return attention q k v keep rel_bias=rel_bias scale=1.0 |> merge_heads |> NN.linear@SelfAttention.o dim=D bias=false
    dec_hidden <- dec_hidden + self_attn
    cross_attn <- scope@layer.1 do
      x_norm <- NN.rmsnorm@layer_norm dec_hidden eps=EPS cast_float=true
      q <- NN.linear@EncDecAttention.q x_norm dim=D bias=false |> reshape_heads heads=H
      k <- NN.linear@EncDecAttention.k enc_hidden dim=D bias=false |> reshape_heads heads=H
      v <- NN.linear@EncDecAttention.v enc_hidden dim=D bias=false |> reshape_heads heads=H
      keep <- bidirectional_mask q k padding_mask=attention_mask
      return attention q k v keep scale=1.0 |> merge_heads |> NN.linear@EncDecAttention.o dim=D bias=false
    dec_hidden <- dec_hidden + cross_attn
    ffn <- scope@layer.2 do
      x_norm <- NN.rmsnorm@layer_norm dec_hidden eps=EPS cast_float=true
      g <- NN.linear@DenseReluDense.wi_0 x_norm dim=FFN bias=false |> gelu_new
      u <- NN.linear@DenseReluDense.wi_1 x_norm dim=FFN bias=false
      x_ffn <- g |> mul u
      return NN.linear@DenseReluDense.wo x_ffn dim=D bias=false
    dec_hidden <- dec_hidden + ffn
  dec_hidden <- NN.rmsnorm@decoder.final_layer_norm dec_hidden eps=EPS
  logits <- NN.linear@lm_head dec_hidden dim=V bias=false
  return logits
