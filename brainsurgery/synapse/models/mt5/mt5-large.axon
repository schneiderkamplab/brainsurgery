{-# CHECKPOINTS "google/mt5-large" #-}

{-# TASK "seq2seq_lm" #-}

{-# MAIN "mt5" #-}

import Activations (gelu_new)

import Attention (attention, merge_heads, reshape_heads)

import Masking (Mask, bidirectional_mask_for_input, causal_mask_for_input, mask_for_input)

import Math (mul)

import Positions (relative_position_bias)

import Config

import NN

MODEL_DIM = 1024

VOCAB_SIZE = 250112

L_ENC = 24

L_DEC_OVERRIDE = 24

L_DEC = (L_DEC_OVERRIDE > 0) ? L_DEC_OVERRIDE : L_ENC

NUM_HEADS = 16

HEAD_DIM = 64

ATTN_DIM = NUM_HEADS * HEAD_DIM

FFN = 2816

EPS = 1e-06

NUM_BUCKETS = 32

MAX_DISTANCE = 128

mt5_encoder_block :: Tensor[B,S,D] -> Tensor[B,1,S,S] -> Tensor[B,S,D]
mt5_encoder_block x keep = do
  self_attn <- scope@layer.0 do
    x_norm <- NN.rmsnorm@layer_norm x eps=EPS cast_float=true
    q <- NN.linear@SelfAttention.q x_norm dim=ATTN_DIM bias=false |> reshape_heads heads=NUM_HEADS
    k <- NN.linear@SelfAttention.k x_norm dim=ATTN_DIM bias=false |> reshape_heads heads=NUM_HEADS
    v <- NN.linear@SelfAttention.v x_norm dim=ATTN_DIM bias=false |> reshape_heads heads=NUM_HEADS
    rel_bias <- relative_position_bias@@encoder.block.0.layer.0.SelfAttention.relative_attention_bias q k num_buckets=NUM_BUCKETS max_distance=MAX_DISTANCE bidirectional=true
    return attention q k v keep rel_bias=rel_bias scale=1.0 |> merge_heads |> NN.linear@SelfAttention.o dim=MODEL_DIM bias=false
  x <- x + self_attn
  ffn <- scope@layer.1 do
    x_norm <- NN.rmsnorm@layer_norm x eps=EPS cast_float=true
    g <- NN.linear@DenseReluDense.wi_0 x_norm dim=FFN bias=false |> gelu_new
    u <- NN.linear@DenseReluDense.wi_1 x_norm dim=FFN bias=false
    x_ffn <- g |> mul u
    return NN.linear@DenseReluDense.wo x_ffn dim=MODEL_DIM bias=false
  y <- x + ffn
  return y

mt5_decoder_block :: Tensor[B,SDEC,D] -> Tensor[B,SENC,D] -> Tensor[B,1,SDEC,SDEC] -> Tensor[B,1,SDEC,SENC] -> Tensor[B,SDEC,D]
mt5_decoder_block x enc_hidden decoder_keep cross_keep = do
  self_attn <- scope@layer.0 do
    x_norm <- NN.rmsnorm@layer_norm x eps=EPS cast_float=true
    q <- NN.linear@SelfAttention.q x_norm dim=ATTN_DIM bias=false |> reshape_heads heads=NUM_HEADS
    k <- NN.linear@SelfAttention.k x_norm dim=ATTN_DIM bias=false |> reshape_heads heads=NUM_HEADS
    v <- NN.linear@SelfAttention.v x_norm dim=ATTN_DIM bias=false |> reshape_heads heads=NUM_HEADS
    rel_bias <- relative_position_bias@@decoder.block.0.layer.0.SelfAttention.relative_attention_bias q k num_buckets=NUM_BUCKETS max_distance=MAX_DISTANCE bidirectional=false
    keep <- decoder_keep
    return attention q k v keep rel_bias=rel_bias scale=1.0 |> merge_heads |> NN.linear@SelfAttention.o dim=MODEL_DIM bias=false
  x <- x + self_attn
  cross_attn <- scope@layer.1 do
    x_norm <- NN.rmsnorm@layer_norm x eps=EPS cast_float=true
    q <- NN.linear@EncDecAttention.q x_norm dim=ATTN_DIM bias=false |> reshape_heads heads=NUM_HEADS
    k <- NN.linear@EncDecAttention.k enc_hidden dim=ATTN_DIM bias=false |> reshape_heads heads=NUM_HEADS
    v <- NN.linear@EncDecAttention.v enc_hidden dim=ATTN_DIM bias=false |> reshape_heads heads=NUM_HEADS
    keep <- cross_keep
    return attention q k v keep scale=1.0 |> merge_heads |> NN.linear@EncDecAttention.o dim=MODEL_DIM bias=false
  x <- x + cross_attn
  ffn <- scope@layer.2 do
    x_norm <- NN.rmsnorm@layer_norm x eps=EPS cast_float=true
    g <- NN.linear@DenseReluDense.wi_0 x_norm dim=FFN bias=false |> gelu_new
    u <- NN.linear@DenseReluDense.wi_1 x_norm dim=FFN bias=false
    x_ffn <- g |> mul u
    return NN.linear@DenseReluDense.wo x_ffn dim=MODEL_DIM bias=false
  y <- x + ffn
  return y

mt5 :: TokenIds[B,SENC] -> ?Mask[B,SENC,SENC] -> TokenIds[B,SDEC] -> ?Mask[B,SDEC,SDEC] -> Tensor[B,SDEC,V]
mt5 input_ids attention_mask decoder_input_ids decoder_attention_mask = do
  attention_mask <- mask_for_input input_ids attention_mask SENC
  decoder_attention_mask <- mask_for_input decoder_input_ids decoder_attention_mask SDEC
  encoder_keep <- bidirectional_mask_for_input input_ids SENC padding_mask=attention_mask
  decoder_keep <- causal_mask_for_input decoder_input_ids SDEC padding_mask=decoder_attention_mask window=1048576
  cross_keep <- bidirectional_mask_for_input decoder_input_ids SENC padding_mask=attention_mask
  enc_hidden <- NN.embedding@shared input_ids dim=MODEL_DIM
  enc_hidden <- for@encoder.block i <- [0..L_ENC) carry (enc_hidden) do
    self_attn <- scope@layer.0 do
      x_norm <- NN.rmsnorm@layer_norm enc_hidden eps=EPS cast_float=true
      q <- NN.linear@SelfAttention.q x_norm dim=ATTN_DIM bias=false |> reshape_heads heads=NUM_HEADS
      k <- NN.linear@SelfAttention.k x_norm dim=ATTN_DIM bias=false |> reshape_heads heads=NUM_HEADS
      v <- NN.linear@SelfAttention.v x_norm dim=ATTN_DIM bias=false |> reshape_heads heads=NUM_HEADS
      rel_bias <- relative_position_bias@@encoder.block.0.layer.0.SelfAttention.relative_attention_bias q k num_buckets=NUM_BUCKETS max_distance=MAX_DISTANCE bidirectional=true
      keep <- encoder_keep
      return attention q k v keep rel_bias=rel_bias scale=1.0 |> merge_heads |> NN.linear@SelfAttention.o dim=MODEL_DIM bias=false
    enc_hidden <- enc_hidden + self_attn
    ffn <- scope@layer.1 do
      x_norm <- NN.rmsnorm@layer_norm enc_hidden eps=EPS cast_float=true
      g <- NN.linear@DenseReluDense.wi_0 x_norm dim=FFN bias=false |> gelu_new
      u <- NN.linear@DenseReluDense.wi_1 x_norm dim=FFN bias=false
      x_ffn <- g |> mul u
      return NN.linear@DenseReluDense.wo x_ffn dim=MODEL_DIM bias=false
    enc_hidden <- enc_hidden + ffn
    yield enc_hidden
  enc_hidden <- NN.rmsnorm@encoder.final_layer_norm enc_hidden eps=EPS
  dec_hidden <- NN.embedding@shared decoder_input_ids dim=MODEL_DIM
  dec_hidden <- for@decoder.block i <- [0..L_DEC) carry (dec_hidden) do
    self_attn <- scope@layer.0 do
      x_norm <- NN.rmsnorm@layer_norm dec_hidden eps=EPS cast_float=true
      q <- NN.linear@SelfAttention.q x_norm dim=ATTN_DIM bias=false |> reshape_heads heads=NUM_HEADS
      k <- NN.linear@SelfAttention.k x_norm dim=ATTN_DIM bias=false |> reshape_heads heads=NUM_HEADS
      v <- NN.linear@SelfAttention.v x_norm dim=ATTN_DIM bias=false |> reshape_heads heads=NUM_HEADS
      rel_bias <- relative_position_bias@@decoder.block.0.layer.0.SelfAttention.relative_attention_bias q k num_buckets=NUM_BUCKETS max_distance=MAX_DISTANCE bidirectional=false
      keep <- decoder_keep
      return attention q k v keep rel_bias=rel_bias scale=1.0 |> merge_heads |> NN.linear@SelfAttention.o dim=MODEL_DIM bias=false
    dec_hidden <- dec_hidden + self_attn
    cross_attn <- scope@layer.1 do
      x_norm <- NN.rmsnorm@layer_norm dec_hidden eps=EPS cast_float=true
      q <- NN.linear@EncDecAttention.q x_norm dim=ATTN_DIM bias=false |> reshape_heads heads=NUM_HEADS
      k <- NN.linear@EncDecAttention.k enc_hidden dim=ATTN_DIM bias=false |> reshape_heads heads=NUM_HEADS
      v <- NN.linear@EncDecAttention.v enc_hidden dim=ATTN_DIM bias=false |> reshape_heads heads=NUM_HEADS
      keep <- cross_keep
      return attention q k v keep scale=1.0 |> merge_heads |> NN.linear@EncDecAttention.o dim=MODEL_DIM bias=false
    dec_hidden <- dec_hidden + cross_attn
    ffn <- scope@layer.2 do
      x_norm <- NN.rmsnorm@layer_norm dec_hidden eps=EPS cast_float=true
      g <- NN.linear@DenseReluDense.wi_0 x_norm dim=FFN bias=false |> gelu_new
      u <- NN.linear@DenseReluDense.wi_1 x_norm dim=FFN bias=false
      x_ffn <- g |> mul u
      return NN.linear@DenseReluDense.wo x_ffn dim=MODEL_DIM bias=false
    dec_hidden <- dec_hidden + ffn
    yield dec_hidden
  dec_hidden <- NN.rmsnorm@decoder.final_layer_norm dec_hidden eps=EPS
  logits <- NN.linear@lm_head dec_hidden dim=VOCAB_SIZE bias=false
  return logits
