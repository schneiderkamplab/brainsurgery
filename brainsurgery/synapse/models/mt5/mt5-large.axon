{-# CHECKPOINTS "google/mt5-large" #-}
{-# TASK "seq2seq_lm" #-}

import Activations
import Activations (gelu_new)
import Attention
import Attention (attention, merge_heads, reshape_heads)
import Masking
import Masking (bidirectional_mask, causal_mask)
import Math
import Math (mul)
import Positions
import Positions (relative_position_bias)

mt5_encoder_block :: Tensor[B,S,D] -> ?Tensor[B,S] -> Tensor[B,S,D]
mt5_encoder_block x attention_mask = do
  self_attn <- scope@layer.0 do
    x_norm <- NN.rmsnorm@layer_norm x eps=1e-06 cast_float=true
    q <- NN.linear@SelfAttention.q x_norm dim=1024 bias=false |> reshape_heads heads=16
    k <- NN.linear@SelfAttention.k x_norm dim=1024 bias=false |> reshape_heads heads=16
    v <- NN.linear@SelfAttention.v x_norm dim=1024 bias=false |> reshape_heads heads=16
    rel_bias <- relative_position_bias@@encoder.block.0.layer.0.SelfAttention.relative_attention_bias q k num_buckets=32 max_distance=128 bidirectional=true
    keep <- bidirectional_mask q k padding_mask=attention_mask
    return attention q k v keep rel_bias=rel_bias scale=1.0 |> merge_heads |> NN.linear@SelfAttention.o dim=1024 bias=false
  x <- x + self_attn
  ffn <- scope@layer.1 do
    x_norm <- NN.rmsnorm@layer_norm x eps=1e-06 cast_float=true
    g <- NN.linear@DenseReluDense.wi_0 x_norm dim=2816 bias=false |> gelu_new
    u <- NN.linear@DenseReluDense.wi_1 x_norm dim=2816 bias=false
    x_ffn <- g |> mul u
    return NN.linear@DenseReluDense.wo x_ffn dim=1024 bias=false
  y <- x + ffn
  return y

mt5_decoder_block :: Tensor[B,SDEC,D] -> Tensor[B,SENC,D] -> ?Tensor[B,SENC] -> ?Tensor[B,SDEC] -> Tensor[B,SDEC,D]
mt5_decoder_block x enc_hidden encoder_attention_mask decoder_attention_mask = do
  self_attn <- scope@layer.0 do
    x_norm <- NN.rmsnorm@layer_norm x eps=1e-06 cast_float=true
    q <- NN.linear@SelfAttention.q x_norm dim=1024 bias=false |> reshape_heads heads=16
    k <- NN.linear@SelfAttention.k x_norm dim=1024 bias=false |> reshape_heads heads=16
    v <- NN.linear@SelfAttention.v x_norm dim=1024 bias=false |> reshape_heads heads=16
    rel_bias <- relative_position_bias@@decoder.block.0.layer.0.SelfAttention.relative_attention_bias q k num_buckets=32 max_distance=128 bidirectional=false
    keep <- causal_mask q k window=1048576 padding_mask=decoder_attention_mask
    return attention q k v keep rel_bias=rel_bias scale=1.0 |> merge_heads |> NN.linear@SelfAttention.o dim=1024 bias=false
  x <- x + self_attn
  cross_attn <- scope@layer.1 do
    x_norm <- NN.rmsnorm@layer_norm x eps=1e-06 cast_float=true
    q <- NN.linear@EncDecAttention.q x_norm dim=1024 bias=false |> reshape_heads heads=16
    k <- NN.linear@EncDecAttention.k enc_hidden dim=1024 bias=false |> reshape_heads heads=16
    v <- NN.linear@EncDecAttention.v enc_hidden dim=1024 bias=false |> reshape_heads heads=16
    keep <- bidirectional_mask q k padding_mask=encoder_attention_mask
    return attention q k v keep scale=1.0 |> merge_heads |> NN.linear@EncDecAttention.o dim=1024 bias=false
  x <- x + cross_attn
  ffn <- scope@layer.2 do
    x_norm <- NN.rmsnorm@layer_norm x eps=1e-06 cast_float=true
    g <- NN.linear@DenseReluDense.wi_0 x_norm dim=2816 bias=false |> gelu_new
    u <- NN.linear@DenseReluDense.wi_1 x_norm dim=2816 bias=false
    x_ffn <- g |> mul u
    return NN.linear@DenseReluDense.wo x_ffn dim=1024 bias=false
  y <- x + ffn
  return y

mt5 :: TokenIds[B,SENC] -> ?Tensor[B,SENC] -> TokenIds[B,SDEC] -> ?Tensor[B,SDEC] -> Tensor[B,SDEC,V]
mt5 input_ids attention_mask decoder_input_ids decoder_attention_mask = do
  enc_hidden <- NN.embedding@shared input_ids dim=1024
  for@encoder.block i <- [0..24) do
    self_attn <- scope@layer.0 do
      x_norm <- NN.rmsnorm@layer_norm enc_hidden eps=1e-06 cast_float=true
      q <- NN.linear@SelfAttention.q x_norm dim=1024 bias=false |> reshape_heads heads=16
      k <- NN.linear@SelfAttention.k x_norm dim=1024 bias=false |> reshape_heads heads=16
      v <- NN.linear@SelfAttention.v x_norm dim=1024 bias=false |> reshape_heads heads=16
      rel_bias <- relative_position_bias@@encoder.block.0.layer.0.SelfAttention.relative_attention_bias q k num_buckets=32 max_distance=128 bidirectional=true
      keep <- bidirectional_mask q k padding_mask=attention_mask
      return attention q k v keep rel_bias=rel_bias scale=1.0 |> merge_heads |> NN.linear@SelfAttention.o dim=1024 bias=false
    enc_hidden <- enc_hidden + self_attn
    ffn <- scope@layer.1 do
      x_norm <- NN.rmsnorm@layer_norm enc_hidden eps=1e-06 cast_float=true
      g <- NN.linear@DenseReluDense.wi_0 x_norm dim=2816 bias=false |> gelu_new
      u <- NN.linear@DenseReluDense.wi_1 x_norm dim=2816 bias=false
      x_ffn <- g |> mul u
      return NN.linear@DenseReluDense.wo x_ffn dim=1024 bias=false
    enc_hidden <- enc_hidden + ffn
    yield enc_hidden
  enc_hidden <- NN.rmsnorm@encoder.final_layer_norm enc_hidden eps=1e-06
  dec_hidden <- NN.embedding@shared decoder_input_ids dim=1024
  for@decoder.block i <- [0..24) do
    self_attn <- scope@layer.0 do
      x_norm <- NN.rmsnorm@layer_norm dec_hidden eps=1e-06 cast_float=true
      q <- NN.linear@SelfAttention.q x_norm dim=1024 bias=false |> reshape_heads heads=16
      k <- NN.linear@SelfAttention.k x_norm dim=1024 bias=false |> reshape_heads heads=16
      v <- NN.linear@SelfAttention.v x_norm dim=1024 bias=false |> reshape_heads heads=16
      rel_bias <- relative_position_bias@@decoder.block.0.layer.0.SelfAttention.relative_attention_bias q k num_buckets=32 max_distance=128 bidirectional=false
      keep <- causal_mask q k window=1048576 padding_mask=decoder_attention_mask
      return attention q k v keep rel_bias=rel_bias scale=1.0 |> merge_heads |> NN.linear@SelfAttention.o dim=1024 bias=false
    dec_hidden <- dec_hidden + self_attn
    cross_attn <- scope@layer.1 do
      x_norm <- NN.rmsnorm@layer_norm dec_hidden eps=1e-06 cast_float=true
      q <- NN.linear@EncDecAttention.q x_norm dim=1024 bias=false |> reshape_heads heads=16
      k <- NN.linear@EncDecAttention.k enc_hidden dim=1024 bias=false |> reshape_heads heads=16
      v <- NN.linear@EncDecAttention.v enc_hidden dim=1024 bias=false |> reshape_heads heads=16
      keep <- bidirectional_mask q k padding_mask=attention_mask
      return attention q k v keep scale=1.0 |> merge_heads |> NN.linear@EncDecAttention.o dim=1024 bias=false
    dec_hidden <- dec_hidden + cross_attn
    ffn <- scope@layer.2 do
      x_norm <- NN.rmsnorm@layer_norm dec_hidden eps=1e-06 cast_float=true
      g <- NN.linear@DenseReluDense.wi_0 x_norm dim=2816 bias=false |> gelu_new
      u <- NN.linear@DenseReluDense.wi_1 x_norm dim=2816 bias=false
      x_ffn <- g |> mul u
      return NN.linear@DenseReluDense.wo x_ffn dim=1024 bias=false
    dec_hidden <- dec_hidden + ffn
    yield dec_hidden
  dec_hidden <- NN.rmsnorm@decoder.final_layer_norm dec_hidden eps=1e-06
  logits <- NN.linear@lm_head dec_hidden dim=250112 bias=false
  return logits
