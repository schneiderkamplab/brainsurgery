{-# CHECKPOINTS ["microsoft/Phi-3-small-8k-instruct", "microsoft/Phi-3-small-128k-instruct"] #-}
{-# TASK "causal_lm" #-}

import Activations (gegelu)
import Attention (attention, merge_heads, split_qkv_grouped)
import Masking (blocksparse_mask, causal_mask)
import Params (has_root)
import Positions (position_ids, rope_pair_base, rope_pair_longrope)
import Cache
import Config
import NN
import Tensor



HAS_TEXT_CONFIG = Config.has_key @@text_config
CFG = HAS_TEXT_CONFIG ? "text_config" : ""

MODEL_DIM = HAS_TEXT_CONFIG ? (Config.int @@'text_config.hidden_size' default=4096) : (Config.int @@hidden_size default=4096)
VOCAB_SIZE = HAS_TEXT_CONFIG ? (Config.int @@'text_config.vocab_size' default=100352) : (Config.int @@vocab_size default=100352)
NUM_LAYERS = HAS_TEXT_CONFIG ? (Config.int @@'text_config.num_hidden_layers' default=32) : (Config.int @@num_hidden_layers default=32)
NUM_HEADS = HAS_TEXT_CONFIG ? (Config.int @@'text_config.num_attention_heads' default=32) : (Config.int @@num_attention_heads default=32)
KVH = HAS_TEXT_CONFIG ? (Config.int @@'text_config.num_key_value_heads' default=8) : (Config.int @@num_key_value_heads default=8)
MODEL_HEAD_DIM = HAS_TEXT_CONFIG
  ? ((Config.has_key @@'text_config.head_dim') ? (Config.int @@'text_config.head_dim' default=128) : 128)
  : ((Config.has_key @@head_dim) ? (Config.int @@head_dim default=128) : 128)
QD = NUM_HEADS * MODEL_HEAD_DIM
KVD = KVH * MODEL_HEAD_DIM
FFN = HAS_TEXT_CONFIG ? (Config.int @@'text_config.ff_intermediate_size' default=14336) : (Config.int @@ff_intermediate_size default=14336)
EPS = HAS_TEXT_CONFIG ? (Config.float @@'text_config.layer_norm_epsilon' default=1e-05) : (Config.float @@layer_norm_epsilon default=1e-05)
THETA = HAS_TEXT_CONFIG ? (Config.float @@'text_config.rope_embedding_base' default=1000000.0) : (Config.float @@rope_embedding_base default=1000000.0)
ROPE_MODE = Config.str @@'rope_scaling.type' default=(Config.str @@'rope_scaling.rope_type' default="default")
ROPE_ORIGINAL_CONTEXT = Config.int @@'rope_scaling.original_max_position_embeddings' default=(HAS_TEXT_CONFIG ? (Config.int @@'text_config.original_max_position_embeddings' default=8192) : (Config.int @@original_max_position_embeddings default=8192))
ROPE_MAX_CONTEXT = HAS_TEXT_CONFIG ? (Config.int @@'text_config.max_position_embeddings' default=8192) : (Config.int @@max_position_embeddings default=8192)
ROPE_LONG_FACTOR = Config.list @@'rope_scaling.long_factor' default=[]
ROPE_SHORT_FACTOR = Config.list @@'rope_scaling.short_factor' default=[]
ROPE_LONG_MSCALE = Config.float @@'rope_scaling.long_mscale' default=-1.0
ROPE_SHORT_MSCALE = Config.float @@'rope_scaling.short_mscale' default=-1.0
HAS_LONGROPE = Config.has_key @@'rope_scaling.long_factor'
GEGELU_LIMIT = HAS_TEXT_CONFIG ? (Config.float @@'text_config.gegelu_limit' default=20.0) : (Config.float @@gegelu_limit default=20.0)
MUP_ATTN_MULT = HAS_TEXT_CONFIG ? (Config.float @@'text_config.mup_attn_multiplier' default=1.0) : (Config.float @@mup_attn_multiplier default=1.0)
MUP_EMBED_MULT = HAS_TEXT_CONFIG ? (Config.float @@'text_config.mup_embedding_multiplier' default=10.0) : (Config.float @@mup_embedding_multiplier default=10.0)
MUP_WIDTH_MULT = HAS_TEXT_CONFIG ? (Config.float @@'text_config.mup_width_multiplier' default=8.0) : (Config.float @@mup_width_multiplier default=8.0)
ATTN_SCALE = MUP_ATTN_MULT / MODEL_HEAD_DIM
BS_LOCAL_BLOCKS = HAS_TEXT_CONFIG ? (Config.int @@'text_config.blocksparse_num_local_blocks' default=16) : (Config.int @@blocksparse_num_local_blocks default=16)
BS_BLOCK_SIZE = HAS_TEXT_CONFIG ? (Config.int @@'text_config.blocksparse_block_size' default=64) : (Config.int @@blocksparse_block_size default=64)
BS_VERT_STRIDE = HAS_TEXT_CONFIG ? (Config.int @@'text_config.blocksparse_vert_stride' default=8) : (Config.int @@blocksparse_vert_stride default=8)
BS_HOMO_HEAD = HAS_TEXT_CONFIG ? (Config.bool @@'text_config.blocksparse_homo_head_pattern' default=false) : (Config.bool @@blocksparse_homo_head_pattern default=false)
WINDOW_LOCAL = BS_LOCAL_BLOCKS * BS_BLOCK_SIZE
WINDOW_GLOBAL = HAS_TEXT_CONFIG ? (Config.int @@'text_config.max_position_embeddings' default=8192) : (Config.int @@max_position_embeddings default=8192)
DENSE_EVERY = HAS_TEXT_CONFIG ? (Config.int @@'text_config.dense_attention_every_n_layers' default=2) : (Config.int @@dense_attention_every_n_layers default=2)
HAS_LM_HEAD = has_root "lm_head"

phi3small_norm :: Path -> Tensor[B,S,D] -> Tensor[B,S,D]
phi3small_norm@path x = NN.layernorm@path x eps=EPS

phi3small_block :: Tensor[B,S,D] -> Int -> IdxTensor[B,S] -> ?Tensor[B,K] -> ?CacheLayer[B,KVH,P,DH] -> (Tensor[B,S,D], ?CacheLayer[B,KVH,K,DH])
phi3small_block x i pos_ids attn_mask past_kv = do
  xn <- phi3small_norm@input_layernorm x
  a, new_kv <- scope@self_attn do
    qkv <- NN.linear@query_key_value xn dim=(QD + KVD + KVD) bias=true
    q, k, v <- split_qkv_grouped qkv heads=NUM_HEADS kv_heads=KVH
    q, k <- HAS_LONGROPE ? (rope_pair_longrope q k pos_ids THETA ROPE_ORIGINAL_CONTEXT ROPE_MAX_CONTEXT ROPE_LONG_FACTOR ROPE_SHORT_FACTOR long_mscale=ROPE_LONG_MSCALE short_mscale=ROPE_SHORT_MSCALE) : (rope_pair_base q k pos_ids theta=THETA)
    k, v, new_kv <- Cache.update past_kv k v
    k <- Tensor.repeat k repeats=(NUM_HEADS / KVH)
    v <- Tensor.repeat v repeats=(NUM_HEADS / KVH)
    dense <- (DENSE_EVERY > 0) ? (((i + 1) % DENSE_EVERY) == 0) : false
    a <- dense
      ? do
        keep <- causal_mask q k window=WINDOW_GLOBAL padding_mask=attn_mask
        return attention q k v keep=keep scale=ATTN_SCALE |> merge_heads |> NN.linear@dense dim=MODEL_DIM bias=true
      : do
        add_mask <- blocksparse_mask q k padding_mask=attn_mask block_size=BS_BLOCK_SIZE local_blocks=BS_LOCAL_BLOCKS vert_stride=BS_VERT_STRIDE homo_head=false
        keep <- Tensor.eq add_mask 0.0
        return attention q k v keep=keep rel_bias=add_mask scale=ATTN_SCALE |> merge_heads |> NN.linear@dense dim=MODEL_DIM bias=true
    return a, new_kv
  x <- x + a
  xn <- phi3small_norm@post_attention_layernorm x
  m <- scope@mlp do
    u <- NN.linear@up_proj xn dim=(2 * FFN) bias=true
    return u |> gegelu limit=GEGELU_LIMIT |> NN.linear@down_proj dim=MODEL_DIM bias=true
  return x + m, new_kv

phi3small :: TokenIds[B,S] -> ?Tensor[B,K] -> ?Cache[B,KVH,P,DH] -> ?Bool -> (Tensor[B,S,V], ?Cache[B,KVH,K,DH])
phi3small input_ids attn_mask past_kv use_cache = do
  pos_ids <- position_ids input_ids past_length=(Cache.past_length past_kv)
  x, new_kv <- scope@model do
    x <- NN.embedding@embed_tokens input_ids dim=MODEL_DIM
    x <- (MUP_EMBED_MULT > 0.0) ? (x * MUP_EMBED_MULT) : x
    new_kv <- use_cache ? Cache.init : null
    x, new_kv <- for@layers i <- [0..NUM_LAYERS) carry (x, new_kv) do
      past_i <- Cache.index past_kv i
      x, new_i <- phi3small_block x i pos_ids attn_mask past_i
      new_kv <- Cache.append new_kv new_i
      yield x, new_kv
    x <- phi3small_norm@final_layernorm x
    return x, new_kv
  logits <- HAS_LM_HEAD ? (NN.linear@lm_head x dim=VOCAB_SIZE) : (NN.linear@model.embed_tokens x dim=VOCAB_SIZE)
  logits <- (MUP_WIDTH_MULT > 0.0) ? (logits / MUP_WIDTH_MULT) : logits
  return logits, new_kv
