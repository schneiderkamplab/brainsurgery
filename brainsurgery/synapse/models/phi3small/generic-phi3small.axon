{-# CHECKPOINTS ["microsoft/Phi-3-small-8k-instruct", "microsoft/Phi-3-small-128k-instruct"] #-}
{-# TASK "causal_lm" #-}

import Config
import Params
import Activations gegelu_limit
import Cache
import Cache past_length

CFG = (Config.has "text_config") ? "text_config" : ""
PARAM_ROOT = (Params.has_root "language_model") ? "language_model" : ""

D = Config.int "hidden_size" root=CFG default=4096
V = Config.int "vocab_size" root=CFG default=100352
L = Config.int "num_hidden_layers" root=CFG default=32
H = Config.int "num_attention_heads" root=CFG default=32
KVH = Config.int "num_key_value_heads" root=CFG default=8
HD = (Config.has "head_dim" root=CFG) ? (Config.int "head_dim" root=CFG default=128) : 128
QD = H * HD
KVD = KVH * HD
FFN = Config.int "ff_intermediate_size" root=CFG default=14336
EPS = Config.float "layer_norm_epsilon" root=CFG default=1e-05
THETA = Config.float "rope_embedding_base" root=CFG default=1000000.0
ROPE_MODE = Config.str "type" root="rope_scaling" default=(Config.str "rope_type" root="rope_scaling" default="default")
ROPE_ORIGINAL_CONTEXT = Config.int "original_max_position_embeddings" root="rope_scaling" default=(Config.int "original_max_position_embeddings" root=CFG default=8192)
ROPE_MAX_CONTEXT = Config.int "max_position_embeddings" root=CFG default=8192
ROPE_LONG_FACTOR = Config.value "long_factor" root="rope_scaling" default=[]
ROPE_SHORT_FACTOR = Config.value "short_factor" root="rope_scaling" default=[]
ROPE_LONG_MSCALE = Config.float "long_mscale" root="rope_scaling" default=-1.0
ROPE_SHORT_MSCALE = Config.float "short_mscale" root="rope_scaling" default=-1.0
HAS_LONGROPE = Config.has "long_factor" root="rope_scaling"
GEGELU_LIMIT = Config.float "gegelu_limit" root=CFG default=20.0
MUP_ATTN_MULT = Config.float "mup_attn_multiplier" root=CFG default=1.0
MUP_EMBED_MULT = Config.float "mup_embedding_multiplier" root=CFG default=10.0
MUP_WIDTH_MULT = Config.float "mup_width_multiplier" root=CFG default=8.0
ATTN_SCALE = MUP_ATTN_MULT / HD
BS_LOCAL_BLOCKS = Config.int "blocksparse_num_local_blocks" root=CFG default=16
BS_BLOCK_SIZE = Config.int "blocksparse_block_size" root=CFG default=64
BS_VERT_STRIDE = Config.int "blocksparse_vert_stride" root=CFG default=8
BS_HOMO_HEAD = (Config.value "blocksparse_homo_head_pattern" root=CFG default=false) == true
WINDOW_LOCAL = BS_LOCAL_BLOCKS * BS_BLOCK_SIZE
WINDOW_GLOBAL = Config.int "max_position_embeddings" root=CFG default=8192
DENSE_EVERY = Config.int "dense_attention_every_n_layers" root=CFG default=2
HAS_LM_HEAD = Params.has_root "lm_head"

phi3small_norm :: @Path -> Tensor -> Tensor
phi3small_norm@path x = layernorm@path x eps=EPS

phi3small_block :: Tensor -> Int -> IdxTensor -> ?Tensor -> ?CacheLayer -> (Tensor, ?CacheLayer)
phi3small_block x i pos_ids attn_mask past_kv = do
  xn <- phi3small_norm@input_layernorm x
  a, new_kv <- scope@self_attn do
    qkv <- linear@query_key_value xn dim=(QD + KVD + KVD) bias=true
    q, k, v <- split_qkv_grouped qkv heads=H kv_heads=KVH
    q, k <- HAS_LONGROPE ? (rope_pair q k position_ids=pos_ids theta=THETA rope_mode="longrope" original_context=ROPE_ORIGINAL_CONTEXT max_context=ROPE_MAX_CONTEXT long_factor=ROPE_LONG_FACTOR short_factor=ROPE_SHORT_FACTOR long_mscale=ROPE_LONG_MSCALE short_mscale=ROPE_SHORT_MSCALE inv_freq_dtype="bfloat16") : (rope_pair q k position_ids=pos_ids theta=THETA inv_freq_dtype="bfloat16")
    k, v, new_kv <- Cache.update past_kv k v
    k <- repeat k repeats=(H / KVH)
    v <- repeat v repeats=(H / KVH)
    dense <- (DENSE_EVERY > 0) and (((i + 1) % DENSE_EVERY) == 0)
    mask <- dense ? (causal_mask q k window=WINDOW_GLOBAL padding_mask=attn_mask) : (blocksparse_mask q k padding_mask=attn_mask block_size=BS_BLOCK_SIZE local_blocks=BS_LOCAL_BLOCKS vert_stride=BS_VERT_STRIDE homo_head=false)
    a <- attention q k v mask=mask scale=ATTN_SCALE eager=true |> merge_heads |> linear@dense dim=D bias=true
    return a, new_kv
  x <- x + a
  xn <- phi3small_norm@post_attention_layernorm x
  m <- scope@mlp do
    u <- linear@up_proj xn dim=(2 * FFN) bias=true
    return u |> gegelu_limit limit=GEGELU_LIMIT |> linear@down_proj dim=D bias=true
  return x + m, new_kv

phi3small :: TokenIds[B,S] -> ?Tensor[B,S] -> ?Cache -> ?Bool -> (Tensor[B,S,V], ?Cache)
phi3small input_ids attn_mask past_kv use_cache = do
  pos_ids <- position_ids input_ids null past_length=(past_length past_kv)
  x, new_kv <- scope@model root=PARAM_ROOT do
    x <- embedding@embed_tokens input_ids dim=D
    x <- (MUP_EMBED_MULT > 0.0) ? (x * MUP_EMBED_MULT) : x
    new_kv <- use_cache ? Cache.init : null
    for@layers i <- [0..L) do
      past_i <- Cache.index past_kv i
      x, new_i <- phi3small_block x i pos_ids attn_mask past_i
      new_kv <- Cache.append new_kv new_i
    x <- phi3small_norm@final_layernorm x
    return x, new_kv
  logits <- HAS_LM_HEAD ? (linear@lm_head x dim=V) : (linear@model.embed_tokens x dim=V)
  logits <- (MUP_WIDTH_MULT > 0.0) ? (logits / MUP_WIDTH_MULT) : logits
  return logits, new_kv
