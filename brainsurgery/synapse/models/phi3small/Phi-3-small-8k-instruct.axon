{-# CHECKPOINTS "microsoft/Phi-3-small-8k-instruct" #-}
{-# TASK "causal_lm" #-}

import Activations
import Activations (gegelu)
import Attention
import Attention (attention, merge_heads, split_qkv_grouped)
import Masking
import Masking (blocksparse_mask, causal_mask)
import Positions
import Positions (position_ids, rope_pair_base)
import Cache
import NN
import Tensor

phi3small_norm :: Path -> Tensor[B,S,D] -> Tensor[B,S,D]
phi3small_norm@path x = NN.layernorm@path x eps=1e-05

phi3small_block :: Tensor[B,S,D] -> Int -> IdxTensor[B,S] -> ?Tensor[B,K] -> ?CacheLayer[B,8,P,128] -> (Tensor[B,S,D], ?CacheLayer[B,8,K,128])
phi3small_block x i pos_ids attn_mask past_kv = do
  xn <- phi3small_norm@input_layernorm x
  a, new_kv <- scope@self_attn do
    qkv <- NN.linear@query_key_value xn dim=6144 bias=true
    q, k, v <- split_qkv_grouped qkv heads=32 kv_heads=8
    q, k <- (rope_pair_base q k pos_ids theta=1000000.0)
    k, v, new_kv <- Cache.update past_kv k v
    k <- Tensor.repeat k repeats=4
    v <- Tensor.repeat v repeats=4
    dense <- (((i + 1) % 2) == 0)
    a <- dense ? (do
        keep <- causal_mask q k window=8192 padding_mask=attn_mask
        return attention q k v keep=keep scale=0.0078125 |> merge_heads |> NN.linear@dense dim=4096 bias=true
    ) : (do
        add_mask <- blocksparse_mask q k padding_mask=attn_mask block_size=64 local_blocks=16 vert_stride=8 homo_head=false
        keep <- Tensor.eq add_mask 0.0
        return attention q k v keep=keep rel_bias=add_mask scale=0.0078125 |> merge_heads |> NN.linear@dense dim=4096 bias=true
    )
    return a, new_kv
  x <- x + a
  xn <- phi3small_norm@post_attention_layernorm x
  m <- scope@mlp do
    u <- NN.linear@up_proj xn dim=28672 bias=true
    return u |> gegelu limit=20.0 |> NN.linear@down_proj dim=4096 bias=true
  return x + m, new_kv

phi3small :: TokenIds[B,S] -> ?Tensor[B,K] -> ?Cache[B,8,P,128] -> ?Bool -> (Tensor[B,S,V], ?Cache[B,8,K,128])
phi3small input_ids attn_mask past_kv use_cache = do
  pos_ids <- position_ids input_ids past_length=(Cache.past_length past_kv)
  x, new_kv <- scope@model do
    x <- NN.embedding@embed_tokens input_ids dim=4096
    x <- (x * 10.0)
    new_kv <- use_cache ? Cache.init : null
    for@layers i <- [0..32) do
      past_i <- Cache.index past_kv i
      x, new_i <- phi3small_block x i pos_ids attn_mask past_i
      new_kv <- Cache.append new_kv new_i
      yield x, new_kv
    x <- phi3small_norm@final_layernorm x
    return x, new_kv
  logits <- (NN.linear@model.embed_tokens x dim=100352)
  logits <- (logits / 8.0)
  return logits, new_kv
