{-# CHECKPOINTS "microsoft/Phi-3-small-128k-instruct" #-}

{-# TASK "causal_lm" #-}

{-# MAIN "phi3small" #-}

import Activations (gegelu)

import Attention (attention, merge_heads, split_qkv_grouped)

import Masking (blocksparse_mask, causal_mask_for_input)

import Params (has_root)

import Positions (position_ids, rope_pair_base, rope_pair_longrope)

import Cache

import Config

import NN

import Tensor

HAS_TEXT_CONFIG = false

CFG = HAS_TEXT_CONFIG ? "text_config" : ""

MODEL_DIM = HAS_TEXT_CONFIG ? (4096) : (4096)

VOCAB_SIZE = HAS_TEXT_CONFIG ? (100352) : (100352)

NUM_LAYERS = HAS_TEXT_CONFIG ? (32) : (32)

NUM_HEADS = HAS_TEXT_CONFIG ? (32) : (32)

KVH = HAS_TEXT_CONFIG ? (8) : (8)

MODEL_HEAD_DIM = HAS_TEXT_CONFIG ? ((false) ? (128) : 128) : ((false) ? (128) : 128)

QD = NUM_HEADS * MODEL_HEAD_DIM

KVD = KVH * MODEL_HEAD_DIM

FFN = HAS_TEXT_CONFIG ? (14336) : (14336)

EPS = HAS_TEXT_CONFIG ? (1e-05) : (1e-05)

THETA = HAS_TEXT_CONFIG ? (1000000.0) : (1000000.0)

ROPE_MODE = "su"

ROPE_ORIGINAL_CONTEXT = 8192

ROPE_MAX_CONTEXT = HAS_TEXT_CONFIG ? (8192) : (131072)

ROPE_LONG_FACTOR = [1.0, 1.01, 1.01, 1.02, 1.04, 1.04, 1.04, 1.05, 1.05, 1.06, 1.07, 1.08, 1.08, 1.08, 1.08, 1.08, 1.08, 1.08, 1.09, 1.09, 1.2, 2.31, 3.76, 9.38, 10.1, 10.8, 18.1, 25.2, 25.3, 26.1, 26.6, 30.2, 33.0, 41.5, 44.4, 44.8, 50.2, 51.9, 59.3, 62.7, 66.1, 66.3, 85.8, 89.3, 90.0, 99.9, 107.0, 110.0, 111.0, 117.0, 118.0, 121.0, 122.0, 127.0, 127.0, 128.0, 128.0, 128.0, 128.0, 128.0, 128.0, 129.0, 129.0, 129.0]

ROPE_SHORT_FACTOR = [1.02, 1.02, 1.05, 1.05, 1.06, 1.08, 1.08, 1.08, 1.08, 1.12, 1.1800000000000002, 1.1900000000000002, 1.1900000000000002, 1.2100000000000002, 1.2300000000000002, 1.2400000000000002, 1.2400000000000002, 1.2500000000000002, 1.3000000000000003, 1.3100000000000003, 1.4600000000000004, 1.5100000000000005, 1.7000000000000006, 1.9300000000000008, 2.080000000000001, 2.4399999999999933, 3.2199999999999767, 3.4499999999999718, 3.579999999999969, 4.669999999999946, 4.779999999999943, 5.999999999999917, 6.009999999999917, 6.4199999999999084, 6.619999999999904, 7.189999999999892, 7.3099999999998895, 7.339999999999889, 7.479999999999886, 9.749999999999837, 10.919999999999812, 11.219999999999805, 11.749999999999794, 11.979999999999789, 13.239999999999762, 13.579999999999755, 13.669999999999753, 13.82999999999975, 14.009999999999746, 14.679999999999731, 14.889999999999727, 15.769999999999708, 15.769999999999708, 15.819999999999707, 15.839999999999707, 15.919999999999705, 16.029999999999703, 16.12999999999972, 16.44999999999977, 16.44999999999977, 16.77999999999982, 16.83999999999983, 16.83999999999983, 16.889999999999837]

ROPE_LONG_MSCALE = 1.1902380714238083

ROPE_SHORT_MSCALE = 1.0

HAS_LONGROPE = true

GEGELU_LIMIT = HAS_TEXT_CONFIG ? (20.0) : (20.0)

MUP_ATTN_MULT = HAS_TEXT_CONFIG ? (1.0) : (1.0)

MUP_EMBED_MULT = HAS_TEXT_CONFIG ? (10.0) : (10.0)

MUP_WIDTH_MULT = HAS_TEXT_CONFIG ? (8.0) : (8.0)

ATTN_SCALE = MUP_ATTN_MULT / MODEL_HEAD_DIM

BS_LOCAL_BLOCKS = HAS_TEXT_CONFIG ? (16) : (16)

BS_BLOCK_SIZE = HAS_TEXT_CONFIG ? (64) : (64)

BS_VERT_STRIDE = HAS_TEXT_CONFIG ? (8) : (8)

BS_HOMO_HEAD = HAS_TEXT_CONFIG ? (false) : (false)

WINDOW_LOCAL = BS_LOCAL_BLOCKS * BS_BLOCK_SIZE

WINDOW_GLOBAL = HAS_TEXT_CONFIG ? (8192) : (131072)

DENSE_EVERY = HAS_TEXT_CONFIG ? (2) : (2)

HAS_LM_HEAD = has_root "lm_head"

phi3small_norm :: Path -> Tensor[B,S,D] -> Tensor[B,S,D]
phi3small_norm@path x = NN.layernorm@path x eps=EPS

phi3small_block :: Tensor[B,S,D] -> Int -> IdxTensor[B,S] -> Tensor[B,1,S,K] -> ?Tensor[B,K] -> ?CacheLayer[B,KVH,P,DH] -> (Tensor[B,S,D], ?CacheLayer[B,KVH,K,DH])
phi3small_block x i pos_ids dense_mask attn_mask past_kv = do
  xn <- phi3small_norm@input_layernorm x
  a, new_kv <- scope@self_attn do
    qkv <- NN.linear@query_key_value xn dim=(QD + KVD + KVD) bias=true
    q, k, v <- split_qkv_grouped qkv heads=NUM_HEADS kv_heads=KVH
    q, k <- HAS_LONGROPE ? (rope_pair_longrope q k pos_ids THETA ROPE_ORIGINAL_CONTEXT ROPE_MAX_CONTEXT ROPE_LONG_FACTOR ROPE_SHORT_FACTOR long_mscale=ROPE_LONG_MSCALE short_mscale=ROPE_SHORT_MSCALE) : (rope_pair_base q k pos_ids theta=THETA)
    k, v, new_kv <- Cache.update past_kv k v
    k <- Tensor.repeat k repeats=(NUM_HEADS / KVH)
    v <- Tensor.repeat v repeats=(NUM_HEADS / KVH)
    dense <- (DENSE_EVERY > 0) ? (((i + 1) % DENSE_EVERY) == 0) : false
    a <- dense
            ? do
                return attention q k v keep=dense_mask scale=ATTN_SCALE |> merge_heads |> NN.linear@dense dim=MODEL_DIM bias=true
            : do
                add_mask <- blocksparse_mask q k padding_mask=attn_mask block_size=BS_BLOCK_SIZE local_blocks=BS_LOCAL_BLOCKS vert_stride=BS_VERT_STRIDE homo_head=false
                keep <- Tensor.eq add_mask 0.0
                return attention q k v keep=keep rel_bias=add_mask scale=ATTN_SCALE |> merge_heads |> NN.linear@dense dim=MODEL_DIM bias=true
    return a, new_kv
  x <- x + a
  xn <- phi3small_norm@post_attention_layernorm x
  m <- scope@mlp do
    u <- NN.linear@up_proj xn dim=(2 * FFN) bias=true
    return u |> gegelu limit=GEGELU_LIMIT |> NN.linear@down_proj dim=MODEL_DIM bias=true
  return x + m, new_kv

phi3small :: TokenIds[B,S] -> ?Tensor[B,K] -> ?Cache[B,KVH,P,DH] -> ?Bool -> (Tensor[B,S,V], ?Cache[B,KVH,K,DH])
phi3small input_ids attn_mask past_kv use_cache = do
  past_length <- Cache.past_length past_kv
  pos_ids <- position_ids input_ids past_length=past_length
  key_len <- past_length + S
  dense_mask <- causal_mask_for_input input_ids key_len padding_mask=attn_mask window=WINDOW_GLOBAL
  x, new_kv <- scope@model do
    x <- NN.embedding@embed_tokens input_ids dim=MODEL_DIM
    x <- (MUP_EMBED_MULT > 0.0) ? (x * MUP_EMBED_MULT) : x
    new_kv <- use_cache ? Cache.init : null
    x, new_kv <- for@layers i <- [0..NUM_LAYERS) carry (x, new_kv) do
      past_i <- Cache.index past_kv i
      x, new_i <- phi3small_block x i pos_ids dense_mask attn_mask past_i
      new_kv <- Cache.append new_kv new_i
      yield x, new_kv
    x <- phi3small_norm@final_layernorm x
    return x, new_kv
  logits <- HAS_LM_HEAD ? (NN.linear@lm_head x dim=VOCAB_SIZE) : (NN.linear@model.embed_tokens x dim=VOCAB_SIZE)
  logits <- (MUP_WIDTH_MULT > 0.0) ? (logits / MUP_WIDTH_MULT) : logits
  return logits, new_kv
