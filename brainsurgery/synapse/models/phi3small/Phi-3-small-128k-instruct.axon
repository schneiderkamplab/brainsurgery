{-# CHECKPOINTS "microsoft/Phi-3-small-128k-instruct" #-}
{-# TASK "causal_lm" #-}

import Activations
import Activations (gegelu)
import Attention
import Attention (attention, merge_heads, split_qkv_grouped)
import Masking
import Masking (blocksparse_mask, causal_mask)
import Positions
import Positions (position_ids, rope_pair_longrope)
import Cache
import NN
import Tensor

phi3small_norm :: Path -> Tensor -> Tensor
phi3small_norm@path x = NN.layernorm@path x eps=1e-05

phi3small_block :: Tensor -> Int -> IdxTensor -> ?Tensor -> ?CacheLayer -> (Tensor, ?CacheLayer)
phi3small_block x i pos_ids attn_mask past_kv = do
  xn <- phi3small_norm@input_layernorm x
  a, new_kv <- scope@self_attn do
    qkv <- NN.linear@query_key_value xn dim=6144 bias=true
    q, k, v <- split_qkv_grouped qkv heads=32 kv_heads=8
    q, k <- (rope_pair_longrope q k pos_ids 1000000.0 8192 131072 [1.0, 1.01, 1.01, 1.02, 1.04, 1.04, 1.04, 1.05, 1.05, 1.06, 1.07, 1.08, 1.08, 1.08, 1.08, 1.08, 1.08, 1.08, 1.09, 1.09, 1.2, 2.31, 3.76, 9.38, 10.1, 10.8, 18.1, 25.2, 25.3, 26.1, 26.6, 30.2, 33.0, 41.5, 44.4, 44.8, 50.2, 51.9, 59.3, 62.7, 66.1, 66.3, 85.8, 89.3, 90.0, 99.9, 107.0, 110.0, 111.0, 117.0, 118.0, 121.0, 122.0, 127.0, 127.0, 128.0, 128.0, 128.0, 128.0, 128.0, 128.0, 129.0, 129.0, 129.0] [1.02, 1.02, 1.05, 1.05, 1.06, 1.08, 1.08, 1.08, 1.08, 1.12, 1.1800000000000002, 1.1900000000000002, 1.1900000000000002, 1.2100000000000002, 1.2300000000000002, 1.2400000000000002, 1.2400000000000002, 1.2500000000000002, 1.3000000000000003, 1.3100000000000003, 1.4600000000000004, 1.5100000000000005, 1.7000000000000006, 1.9300000000000008, 2.080000000000001, 2.4399999999999933, 3.2199999999999767, 3.4499999999999718, 3.579999999999969, 4.669999999999946, 4.779999999999943, 5.999999999999917, 6.009999999999917, 6.4199999999999084, 6.619999999999904, 7.189999999999892, 7.3099999999998895, 7.339999999999889, 7.479999999999886, 9.749999999999837, 10.919999999999812, 11.219999999999805, 11.749999999999794, 11.979999999999789, 13.239999999999762, 13.579999999999755, 13.669999999999753, 13.82999999999975, 14.009999999999746, 14.679999999999731, 14.889999999999727, 15.769999999999708, 15.769999999999708, 15.819999999999707, 15.839999999999707, 15.919999999999705, 16.029999999999703, 16.12999999999972, 16.44999999999977, 16.44999999999977, 16.77999999999982, 16.83999999999983, 16.83999999999983, 16.889999999999837] long_mscale=1.1902380714238083 short_mscale=1.0)
    k, v, new_kv <- Cache.update past_kv k v
    k <- Tensor.repeat k repeats=4
    v <- Tensor.repeat v repeats=4
    dense <- (((i + 1) % 2) == 0)
    a <- dense ? (do
        keep <- causal_mask q k window=131072 padding_mask=attn_mask
        return attention q k v keep=keep scale=0.0078125 |> merge_heads |> NN.linear@dense dim=4096 bias=true
    ) : (do
        add_mask <- blocksparse_mask q k padding_mask=attn_mask block_size=64 local_blocks=16 vert_stride=8 homo_head=false
        keep <- Tensor.eq add_mask 0.0
        return attention q k v keep=keep rel_bias=add_mask scale=0.0078125 |> merge_heads |> NN.linear@dense dim=4096 bias=true
    )
    return a, new_kv
  x <- x + a
  xn <- phi3small_norm@post_attention_layernorm x
  m <- scope@mlp do
    u <- NN.linear@up_proj xn dim=28672 bias=true
    return u |> gegelu limit=20.0 |> NN.linear@down_proj dim=4096 bias=true
  return x + m, new_kv

phi3small :: TokenIds[B,S] -> ?Tensor[B,S] -> ?Cache -> ?Bool -> (Tensor[B,S,V], ?Cache)
phi3small input_ids attn_mask past_kv use_cache = do
  pos_ids <- position_ids input_ids past_length=(Cache.past_length past_kv)
  x, new_kv <- scope@model do
    x <- NN.embedding@embed_tokens input_ids dim=4096
    x <- (x * 10.0)
    new_kv <- use_cache ? Cache.init : null
    for@layers i <- [0..32) do
      past_i <- Cache.index past_kv i
      x, new_i <- phi3small_block x i pos_ids attn_mask past_i
      new_kv <- Cache.append new_kv new_i
      yield x, new_kv
    x <- phi3small_norm@final_layernorm x
    return x, new_kv
  logits <- (NN.linear@model.embed_tokens x dim=100352)
  logits <- (logits / 8.0)
  return logits, new_kv
