{-# CHECKPOINTS "microsoft/Phi-3-small-128k-instruct" #-}
{-# TASK "causal_lm" #-}

import Activations
import Activations (gegelu_limit)
import Cache
import Cache (past_length)

PARAM_ROOT = ""
D = 4096
V = 100352
L = 32
H = 32
KVH = 8
QD = 4096
KVD = 1024
FFN = 14336
EPS = 1e-05
THETA = 1000000.0
ROPE_ORIGINAL_CONTEXT = 8192
ROPE_MAX_CONTEXT = 131072
ROPE_LONG_FACTOR = [1.0, 1.01, 1.01, 1.02, 1.04, 1.04, 1.04, 1.05, 1.05, 1.06, 1.07, 1.08, 1.08, 1.08, 1.08, 1.08, 1.08, 1.08, 1.09, 1.09, 1.2, 2.31, 3.76, 9.38, 10.1, 10.8, 18.1, 25.2, 25.3, 26.1, 26.6, 30.2, 33.0, 41.5, 44.4, 44.8, 50.2, 51.9, 59.3, 62.7, 66.1, 66.3, 85.8, 89.3, 90.0, 99.9, 107.0, 110.0, 111.0, 117.0, 118.0, 121.0, 122.0, 127.0, 127.0, 128.0, 128.0, 128.0, 128.0, 128.0, 128.0, 129.0, 129.0, 129.0]
ROPE_SHORT_FACTOR = [1.02, 1.02, 1.05, 1.05, 1.06, 1.08, 1.08, 1.08, 1.08, 1.12, 1.1800000000000002, 1.1900000000000002, 1.1900000000000002, 1.2100000000000002, 1.2300000000000002, 1.2400000000000002, 1.2400000000000002, 1.2500000000000002, 1.3000000000000003, 1.3100000000000003, 1.4600000000000004, 1.5100000000000005, 1.7000000000000006, 1.9300000000000008, 2.080000000000001, 2.4399999999999933, 3.2199999999999767, 3.4499999999999718, 3.579999999999969, 4.669999999999946, 4.779999999999943, 5.999999999999917, 6.009999999999917, 6.4199999999999084, 6.619999999999904, 7.189999999999892, 7.3099999999998895, 7.339999999999889, 7.479999999999886, 9.749999999999837, 10.919999999999812, 11.219999999999805, 11.749999999999794, 11.979999999999789, 13.239999999999762, 13.579999999999755, 13.669999999999753, 13.82999999999975, 14.009999999999746, 14.679999999999731, 14.889999999999727, 15.769999999999708, 15.769999999999708, 15.819999999999707, 15.839999999999707, 15.919999999999705, 16.029999999999703, 16.12999999999972, 16.44999999999977, 16.44999999999977, 16.77999999999982, 16.83999999999983, 16.83999999999983, 16.889999999999837]
ROPE_LONG_MSCALE = 1.1902380714238083
ROPE_SHORT_MSCALE = 1.0
HAS_LONGROPE = true
GEGELU_LIMIT = 20.0
MUP_EMBED_MULT = 10.0
MUP_WIDTH_MULT = 8.0
ATTN_SCALE = 0.0078125
BS_LOCAL_BLOCKS = 16
BS_BLOCK_SIZE = 64
BS_VERT_STRIDE = 8
WINDOW_GLOBAL = 131072
DENSE_EVERY = 2
HAS_LM_HEAD = false

phi3small_norm :: @Path -> Tensor -> Tensor
phi3small_norm@path x = layernorm@path x eps=EPS

phi3small_block :: Tensor -> Int -> IdxTensor -> ?Tensor -> ?CacheLayer -> (Tensor, ?CacheLayer)
phi3small_block x i pos_ids attn_mask past_kv = do
  xn <- phi3small_norm@input_layernorm x
  a, new_kv <- scope@self_attn do
    qkv <- linear@query_key_value xn dim=(QD + KVD + KVD) bias=true
    q, k, v <- split_qkv_grouped qkv heads=H kv_heads=KVH
    q, k <- HAS_LONGROPE ? (rope_pair_longrope q k pos_ids THETA ROPE_ORIGINAL_CONTEXT ROPE_MAX_CONTEXT ROPE_LONG_FACTOR ROPE_SHORT_FACTOR long_mscale=ROPE_LONG_MSCALE short_mscale=ROPE_SHORT_MSCALE) : (rope_pair_base q k pos_ids theta=THETA)
    k, v, new_kv <- Cache.update past_kv k v
    k <- repeat k repeats=(H / KVH)
    v <- repeat v repeats=(H / KVH)
    dense <- (DENSE_EVERY > 0) and (((i + 1) % DENSE_EVERY) == 0)
    mask <- dense ? (causal_mask q k window=WINDOW_GLOBAL padding_mask=attn_mask) : (blocksparse_mask q k padding_mask=attn_mask block_size=BS_BLOCK_SIZE local_blocks=BS_LOCAL_BLOCKS vert_stride=BS_VERT_STRIDE homo_head=false)
    a <- attention q k v mask=mask scale=ATTN_SCALE eager=true |> merge_heads |> linear@dense dim=D bias=true
    return a, new_kv
  x <- x + a
  xn <- phi3small_norm@post_attention_layernorm x
  m <- scope@mlp do
    u <- linear@up_proj xn dim=(2 * FFN) bias=true
    return u |> gegelu_limit limit=GEGELU_LIMIT |> linear@down_proj dim=D bias=true
  return x + m, new_kv

phi3small :: TokenIds[B,S] -> ?Tensor[B,S] -> ?Cache -> ?Bool -> (Tensor[B,S,V], ?Cache)
phi3small input_ids attn_mask past_kv use_cache = do
  pos_ids <- position_ids input_ids past_length=(past_length past_kv)
  x, new_kv <- scope@model root=PARAM_ROOT do
    x <- embedding@embed_tokens input_ids dim=D
    x <- (MUP_EMBED_MULT > 0.0) ? (x * MUP_EMBED_MULT) : x
    new_kv <- use_cache ? Cache.init : null
    for@layers i <- [0..L) do
      past_i <- Cache.index past_kv i
      x, new_i <- phi3small_block x i pos_ids attn_mask past_i
      new_kv <- Cache.append new_kv new_i
    x <- phi3small_norm@final_layernorm x
    return x, new_kv
  logits <- HAS_LM_HEAD ? (linear@lm_head x dim=V) : (linear@model.embed_tokens x dim=V)
  logits <- (MUP_WIDTH_MULT > 0.0) ? (logits / MUP_WIDTH_MULT) : logits
  return logits, new_kv
