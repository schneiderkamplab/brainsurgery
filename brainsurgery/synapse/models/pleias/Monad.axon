{-# CHECKPOINTS "PleIAs/Monad" #-}
{-# TASK "causal_lm" #-}

import Activations
import Activations (silu)
import Attention
import Attention (attention, merge_heads, reshape_heads)
import Masking
import Masking (causal_mask)
import Math
import Math (mul)
import Positions
import Positions (position_ids, rope_pair_base)

pleias_rms :: Path -> Tensor[B,S,D] -> Tensor[B,S,D]
pleias_rms@path x = NN.rmsnorm@path x eps=1e-05

pleias_block :: Tensor[B,S,D] -> Tensor[B,S] -> ?Tensor[B,S] -> ?CacheLayer -> (Tensor[B,S,D], ?CacheLayer)
pleias_block x pos_ids attn_mask past_kv = do
  xn <- pleias_rms@input_layernorm x
  a, new_kv <- scope@self_attn do
    q <- NN.linear@q_proj xn dim=256 |> reshape_heads heads=4
    k <- NN.linear@k_proj xn dim=256 |> reshape_heads heads=4
    v <- NN.linear@v_proj xn dim=256 |> reshape_heads heads=4
    q, k <- rope_pair_base q k pos_ids 10000.0
    k, v, new_kv <- Cache.update past_kv k v
    k <- Tensor.repeat k repeats=1
    v <- Tensor.repeat v repeats=1
    mask <- causal_mask q k window=2048 padding_mask=attn_mask
    a <- attention q k v mask |> merge_heads |> NN.linear@o_proj dim=256
    return a, new_kv
  x <- x + a
  xn <- pleias_rms@post_attention_layernorm x
  m <- scope@mlp do
    g <- NN.linear@gate_proj xn dim=768
    u <- NN.linear@up_proj xn dim=768
    return g |> silu |> mul u |> NN.linear@down_proj dim=256
  return x + m, new_kv

pleias :: TokenIds[B,S] -> ?Tensor[B,S] -> ?Cache -> ?Bool -> (Tensor[B,S,V], ?Cache)
pleias input_ids attn_mask past_kv use_cache = do
  pos_ids <- position_ids input_ids attn_mask=attn_mask past_length=(Cache.past_length past_kv)
  logits, new_kv <- scope@model do
    x <- NN.embedding@embed_tokens input_ids dim=256
    new_kv <- use_cache ? Cache.init : null
    for@layers i <- [0..64) do
      past_i <- Cache.index past_kv i
      x, new_i <- pleias_block x pos_ids attn_mask past_i
      new_kv <- Cache.append new_kv new_i
      yield x, new_kv
    logits <- pleias_rms@norm x |> NN.linear@embed_tokens dim=8192
    return logits, new_kv
  return logits, new_kv
