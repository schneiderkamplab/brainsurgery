{-# CHECKPOINTS "PleIAs/Pleias-RAG-350M" #-}

{-# TASK "causal_lm" #-}

{-# MAIN "pleias" #-}

import Activations (silu)

import Attention (attention_gqa_with_additive_mask, mask_to_additive_for_input, merge_heads, reshape_heads)

import Masking (Mask, causal_mask_for_input, mask_for_input, mask_length_for_input)

import Math (mul)

import Positions (position_ids, rope_base_factors, rope_pair_base_factors)

import Cache

import Config

import NN

import Tensor

MODEL_DIM <- ((1024 :: Dim) :: Dim)

VOCAB_SIZE <- ((65536 :: Dim) :: Dim)

NUM_LAYERS <- ((26 :: Dim) :: Dim)

NUM_HEADS <- ((16 :: Dim) :: Dim)

KVH <- ((8 :: Dim) :: Dim)

HAS_HEAD_DIM <- false

MODEL_HEAD_DIM <- (HAS_HEAD_DIM ? (64 :: Dim) : ((MODEL_DIM / NUM_HEADS) :: Dim))

KVD <- ((KVH * MODEL_HEAD_DIM) :: Dim)

FFN <- ((2560 :: Dim) :: Dim)

EPS <- 1e-05

THETA <- 10000.0

MAX_POSITIONS <- ((4096 :: Dim) :: Dim)

pleias_rms :: Path -> Tensor[B,S,D] -> Tensor[B,S,D]
pleias_rms@path x = NN.rmsnorm@path x eps=EPS

pleias_block :: Tensor[B,S,D] -> Tensor[B,1,S,R] -> Tensor[B,1,S,R] -> Tensor[B,1,S,K] -> Tensor[B,H,S,K] -> ?CacheLayer[B,KVH,P,MAX_POSITIONS,DH] -> (Tensor[B,S,D], ?CacheLayer[B,KVH,K,MAX_POSITIONS,DH])
pleias_block x rope_sin rope_cos mask additive_mask past_kv = do
  xn <- pleias_rms@input_layernorm x
  a, new_kv <- scope@self_attn do
    q <- NN.linear@q_proj xn dim=MODEL_DIM |> reshape_heads heads=NUM_HEADS
    k <- NN.linear@k_proj xn dim=KVD |> reshape_heads heads=KVH
    v <- NN.linear@v_proj xn dim=KVD |> reshape_heads heads=KVH
    q, k <- rope_pair_base_factors q k rope_sin rope_cos
    k, v, new_kv <- ((Cache.update past_kv k v) :: (Tensor[B,KVH,K,DH], Tensor[B,KVH,K,DH], ?CacheLayer[B,KVH,K,MAX_POSITIONS,DH]))
    a <- attention_gqa_with_additive_mask q k v additive_mask mask |> merge_heads |> NN.linear@o_proj dim=MODEL_DIM
    return a, new_kv
  x <- x + a
  xn <- pleias_rms@post_attention_layernorm x
  m <- scope@mlp do
    g <- NN.linear@gate_proj xn dim=FFN
    u <- NN.linear@up_proj xn dim=FFN
    return g |> silu |> mul u |> NN.linear@down_proj dim=MODEL_DIM
  return x + m, new_kv

pleias :: TokenIds[B,S] -> ?Mask[B,K,MAX_POSITIONS] -> ?Cache[B,KVH,P,MAX_POSITIONS,DH] -> ?Bool -> (Tensor[B,S,V], ?Cache[B,KVH,K,MAX_POSITIONS,DH])
pleias input_ids attn_mask past_kv use_cache = do
  past_length <- Cache.past_length past_kv
  attn_mask <- mask_for_input input_ids attn_mask MAX_POSITIONS
  pos_ids <- position_ids input_ids attn_mask=attn_mask past_length=past_length
  rope_sin, rope_cos <- ((rope_base_factors pos_ids MODEL_HEAD_DIM THETA) :: (Tensor[B,1,S,MODEL_HEAD_DIM], Tensor[B,1,S,MODEL_HEAD_DIM]))
  key_len <- mask_length_for_input input_ids attn_mask past_length
  mask <- causal_mask_for_input input_ids key_len padding_mask=attn_mask window=MAX_POSITIONS
  additive_mask <- mask_to_additive_for_input input_ids mask NUM_HEADS
  logits, new_kv <- scope@model do
    x <- NN.embedding@embed_tokens input_ids dim=MODEL_DIM
    work_kv <- ((Cache.prepare past_kv use_cache MAX_POSITIONS) :: ?Cache[B,KVH,K,MAX_POSITIONS,DH])
    read_kv <- ((Cache.read past_kv work_kv) :: ?Cache[B,KVH,P,MAX_POSITIONS,DH])
    x, work_kv <- for@layers i <- [0..NUM_LAYERS) carry (x, work_kv) do
      past_i <- Cache.index read_kv i
      x, new_i <- pleias_block x rope_sin rope_cos mask additive_mask past_i
      work_kv <- Cache.append work_kv new_i
      yield x, work_kv
    work_kv <- Cache.finish work_kv key_len
    new_kv <- use_cache ? work_kv : null
    logits <- pleias_rms@norm x |> NN.linear@embed_tokens dim=VOCAB_SIZE
    return logits, new_kv
  return logits, new_kv
