import Math
{-# CHECKPOINTS "PleIAs/OCRonos" #-}
{-# TASK "causal_lm" #-}

import Activations
import Activations (silu)
import Cache
import Cache (past_length)

D = 4096
V = 128256
L = 32
H = 32
KVH = 8
KVD = 1024
FFN = 14336
EPS = 1e-05
THETA = 500000.0
C = 8192

ocronos_rms :: @Path -> Tensor[B,S,D] -> Tensor[B,S,D]
ocronos_rms@path x = rmsnorm@path x eps=EPS

ocronos_block :: Tensor[B,S,D] -> Tensor[B,S] -> ?Tensor[B,S] -> ?CacheLayer -> (Tensor[B,S,D], ?CacheLayer)
ocronos_block x pos_ids attn_mask past_kv = do
  xn <- ocronos_rms@input_layernorm x
  a, new_kv <- scope@self_attn do
    q <- linear@q_proj xn dim=D |> reshape_heads heads=H
    k <- linear@k_proj xn dim=KVD |> reshape_heads heads=KVH
    v <- linear@v_proj xn dim=KVD |> reshape_heads heads=KVH
    q, k <- rope_pair_base q k pos_ids THETA
    k, v, new_kv <- Cache.update past_kv k v
    k <- repeat k repeats=(H / KVH)
    v <- repeat v repeats=(H / KVH)
    mask <- causal_mask q k window=C padding_mask=attn_mask
    a <- attention q k v mask=mask |> merge_heads |> linear@o_proj dim=D
    return a, new_kv
  x <- x + a
  xn <- ocronos_rms@post_attention_layernorm x
  m <- scope@mlp do
    g <- linear@gate_proj xn dim=FFN
    u <- linear@up_proj xn dim=FFN
    return g |> silu |> Math.mul u |> linear@down_proj dim=D
  return x + m, new_kv

ocronos :: TokenIds[B,S] -> ?Tensor[B,S] -> ?Cache -> ?Bool -> (Tensor[B,S,V], ?Cache)
ocronos input_ids attn_mask past_kv use_cache = do
  pos_ids <- position_ids input_ids attn_mask=attn_mask past_length=(past_length past_kv)
  x, new_kv <- scope@model do
    x <- embedding@embed_tokens input_ids dim=D
    new_kv <- use_cache ? Cache.init : null
    for@layers i <- [0..L) do
      past_i <- Cache.index past_kv i
      x, new_i <- ocronos_block x pos_ids attn_mask past_i
      new_kv <- Cache.append new_kv new_i
    x <- ocronos_rms@norm x
    return x, new_kv
  logits <- linear@lm_head x dim=V
  return logits, new_kv
