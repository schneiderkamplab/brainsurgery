{-# CHECKPOINTS "PleIAs/OCRonos" #-}
{-# TASK "causal_lm" #-}

import Activations (silu)
import Attention (attention, merge_heads, reshape_heads)
import Masking (causal_mask)
import Math (mul)
import Positions (position_ids, rope_pair_base)



D = Config.int "hidden_size" default=4096
V = Config.int "vocab_size" default=128256
L = Config.int "num_hidden_layers" default=32
H = Config.int "num_attention_heads" default=32
KVH = Config.int "num_key_value_heads" default=8
HAS_HEAD_DIM = Config.has_value "head_dim"
HD = HAS_HEAD_DIM ? (Config.int "head_dim" default=128) : (D / H)
KVD = KVH * HD
FFN = Config.int "intermediate_size" default=14336
EPS = Config.float "rms_norm_eps" default=1e-05
THETA = Config.float "rope_theta" default=500000.0
C = Config.int "max_position_embeddings" default=8192

ocronos_rms :: @Path -> Tensor[B,S,D] -> Tensor[B,S,D]
ocronos_rms@path x = NN.rmsnorm@path x eps=EPS

ocronos_block :: Tensor[B,S,D] -> Tensor[B,S] -> ?Tensor[B,S] -> ?CacheLayer -> (Tensor[B,S,D], ?CacheLayer)
ocronos_block x pos_ids attn_mask past_kv = do
  xn <- ocronos_rms@input_layernorm x
  a, new_kv <- scope@self_attn do
    q <- NN.linear@q_proj xn dim=D |> reshape_heads heads=H
    k <- NN.linear@k_proj xn dim=KVD |> reshape_heads heads=KVH
    v <- NN.linear@v_proj xn dim=KVD |> reshape_heads heads=KVH
    q, k <- rope_pair_base q k pos_ids THETA
    k, v, new_kv <- Cache.update past_kv k v
    k <- Tensor.repeat k repeats=(H / KVH)
    v <- Tensor.repeat v repeats=(H / KVH)
    mask <- causal_mask q k window=C padding_mask=attn_mask
    a <- attention q k v mask |> merge_heads |> NN.linear@o_proj dim=D
    return a, new_kv
  x <- x + a
  xn <- ocronos_rms@post_attention_layernorm x
  m <- scope@mlp do
    g <- NN.linear@gate_proj xn dim=FFN
    u <- NN.linear@up_proj xn dim=FFN
    return g |> silu |> mul u |> NN.linear@down_proj dim=D
  return x + m, new_kv

ocronos :: TokenIds[B,S] -> ?Tensor[B,S] -> ?Cache -> ?Bool -> (Tensor[B,S,V], ?Cache)
ocronos input_ids attn_mask past_kv use_cache = do
  pos_ids <- position_ids input_ids attn_mask=attn_mask past_length=(Cache.past_length past_kv)
  x, new_kv <- scope@model do
    x <- NN.embedding@embed_tokens input_ids dim=D
    new_kv <- use_cache ? Cache.init : null
    for@layers i <- [0..L) do
      past_i <- Cache.index past_kv i
      x, new_i <- ocronos_block x pos_ids attn_mask past_i
      new_kv <- Cache.append new_kv new_i
    x <- ocronos_rms@norm x
    return x, new_kv
  logits <- NN.linear@lm_head x dim=V
  return logits, new_kv
