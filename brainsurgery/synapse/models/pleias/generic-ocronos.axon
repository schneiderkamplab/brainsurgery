{-# CHECKPOINTS ["PleIAs/OCRonos", "test/OCRonos-Test"] #-}
{-# TASK "causal_lm" #-}

import Activations (silu)
import Attention (attention_gqa_with_additive_mask, mask_to_additive_for_input, merge_heads, reshape_heads)
import Masking (causal_mask_for_input)
import Math (mul)
import Positions (position_ids, rope_base_factors, rope_pair_base_factors)
import Cache
import Config
import NN
import Tensor



MODEL_DIM = Config.int@@hidden_size default=4096
VOCAB_SIZE = Config.int@@vocab_size default=128256
NUM_LAYERS = Config.int@@num_hidden_layers default=32
NUM_HEADS = Config.int@@num_attention_heads default=32
KVH = Config.int@@num_key_value_heads default=8
HAS_HEAD_DIM = Config.has_value@@head_dim
MODEL_HEAD_DIM = HAS_HEAD_DIM ? (Config.int@@head_dim default=128) : (MODEL_DIM / NUM_HEADS)
KVD = KVH * MODEL_HEAD_DIM
FFN = Config.int@@intermediate_size default=14336
EPS = Config.float@@rms_norm_eps default=1e-05
THETA = Config.float@@rope_theta default=500000.0
MAX_POSITIONS = Config.int@@max_position_embeddings default=8192

ocronos_rms :: Path -> Tensor[B,S,D] -> Tensor[B,S,D]
ocronos_rms@path x = NN.rmsnorm@path x eps=EPS

ocronos_block :: Tensor[B,S,D] -> Tensor[B,1,S,R] -> Tensor[B,1,S,R] -> Tensor[B,1,S,K] -> Tensor[B,H,S,K] -> ?CacheLayer[B,KVH,P,DH] -> (Tensor[B,S,D], ?CacheLayer[B,KVH,K,DH])
ocronos_block x rope_sin rope_cos mask additive_mask past_kv = do
  xn <- ocronos_rms@input_layernorm x
  a, new_kv <- scope@self_attn do
    q <- NN.linear@q_proj xn dim=MODEL_DIM |> reshape_heads heads=NUM_HEADS
    k <- NN.linear@k_proj xn dim=KVD |> reshape_heads heads=KVH
    v <- NN.linear@v_proj xn dim=KVD |> reshape_heads heads=KVH
    q, k <- rope_pair_base_factors q k rope_sin rope_cos
    k, v, new_kv <- Cache.update past_kv k v
    a <- attention_gqa_with_additive_mask q k v additive_mask mask |> merge_heads |> NN.linear@o_proj dim=MODEL_DIM
    return a, new_kv
  x <- x + a
  xn <- ocronos_rms@post_attention_layernorm x
  m <- scope@mlp do
    g <- NN.linear@gate_proj xn dim=FFN
    u <- NN.linear@up_proj xn dim=FFN
    return g |> silu |> mul u |> NN.linear@down_proj dim=MODEL_DIM
  return x + m, new_kv

ocronos :: TokenIds[B,S] -> ?Tensor[B,K] -> ?Cache[B,KVH,P,DH] -> ?Bool -> (Tensor[B,S,V], ?Cache[B,KVH,K,DH])
ocronos input_ids attn_mask past_kv use_cache = do
  past_length <- Cache.past_length past_kv
  pos_ids <- position_ids input_ids attn_mask=attn_mask past_length=past_length
  rope_sin, rope_cos <- ((rope_base_factors pos_ids MODEL_HEAD_DIM THETA) :: (Tensor[B,1,S,MODEL_HEAD_DIM], Tensor[B,1,S,MODEL_HEAD_DIM]))
  key_len <- past_length + S
  mask <- causal_mask_for_input input_ids key_len padding_mask=attn_mask window=MAX_POSITIONS
  additive_mask <- mask_to_additive_for_input input_ids mask NUM_HEADS
  x, new_kv <- scope@model do
    x <- NN.embedding@embed_tokens input_ids dim=MODEL_DIM
    new_kv <- use_cache ? Cache.init : null
    x, new_kv <- for@layers i <- [0..NUM_LAYERS) carry (x, new_kv) do
      past_i <- Cache.index past_kv i
      x, new_i <- ocronos_block x rope_sin rope_cos mask additive_mask past_i
      new_kv <- Cache.append new_kv new_i
      yield x, new_kv
    x <- ocronos_rms@norm x
    return x, new_kv
  logits <- NN.linear@lm_head x dim=VOCAB_SIZE
  return logits, new_kv
