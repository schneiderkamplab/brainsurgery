{-# CHECKPOINTS "ibm-research/PowerMoE-3b" #-}
{-# TASK "causal_lm" #-}

import Activations
import Activations (silu)
import Attention
import Attention (attention, merge_heads, reshape_heads)
import Masking
import Masking (causal_mask)
import Math
import Math (mul)
import MoE
import MoE (scatter_add, select)
import Positions
import Positions (position_ids, rope_pair_base)
import Cache
import NN
import Tensor

granitemoe_norm :: Path -> Tensor[B,S,D] -> Tensor[B,S,D]
granitemoe_norm@path x = NN.rmsnorm@path x eps=1e-06

granitemoe_moe :: Tensor[B,S,D] -> Tensor[B,S,EPT] -> Tensor[B,S,EPT] -> Tensor[B,S,D]
granitemoe_moe hidden topk_scores topk_indices = do
  routed <- hidden * 0.0
  for e <- [0..40) do
    x_sel, token_idx, topk_pos, sel_scores <- select hidden topk_scores topk_indices e
    gate_up <- NN.linear@w1 x_sel dim=null bias=false transpose=false expert=e weight_path=@input_linear.weight
    gate, up <- Tensor.chunk gate_up parts=2
    x_upd <- gate |> silu |> mul up |> NN.linear@w2 dim=null bias=false transpose=false expert=e weight_path=@output_linear.weight
    routed <- scatter_add routed token_idx x_upd sel_scores
    yield routed
  return routed

granitemoe_block :: Tensor[B,S,D] -> IdxTensor[B,S] -> ?Tensor[B,S] -> ?CacheLayer -> (Tensor[B,S,D], ?CacheLayer)
granitemoe_block x pos_ids attn_mask past_kv = do
  xn <- granitemoe_norm@input_layernorm x
  a, new_kv <- scope@self_attn do
    q <- NN.linear@q_proj xn dim=1536 bias=false |> reshape_heads heads=24
    k <- NN.linear@k_proj xn dim=512 bias=false |> reshape_heads heads=8
    v <- NN.linear@v_proj xn dim=512 bias=false |> reshape_heads heads=8
    q, k <- rope_pair_base q k pos_ids 10000.0
    k, v, new_kv <- Cache.update past_kv k v
    k <- Tensor.repeat k repeats=3
    v <- Tensor.repeat v repeats=3
    mask <- causal_mask q k padding_mask=attn_mask
    a <- attention q k v mask scale=0.015625 |> merge_heads |> NN.linear@o_proj dim=1536 bias=false
    return a, new_kv
  x <- x + (a * 0.22)
  xn <- granitemoe_norm@post_attention_layernorm x
  m <- scope@block_sparse_moe do
    logits <- NN.linear@router.layer xn dim=40 bias=false
    topk_logits, topk_indices <- Tensor.topk logits 8 -1 true false
    topk_scores <- Tensor.softmax topk_logits -1 "float32"
    return granitemoe_moe xn topk_scores topk_indices
  return x + (m * 0.22), new_kv

granitemoe :: TokenIds[B,S] -> ?Tensor[B,S] -> ?Cache -> ?Bool -> (Tensor[B,S,V], ?Cache)
granitemoe input_ids attn_mask past_kv use_cache = do
  pos_ids <- position_ids input_ids attn_mask=attn_mask past_length=(Cache.past_length past_kv)
  x, new_kv <- scope@model do
    x <- NN.embedding@embed_tokens input_ids dim=1536
    x <- x * 12.0
    new_kv <- use_cache ? Cache.init : null
    for@layers i <- [0..32) do
      past_i <- Cache.index past_kv i
      x, new_i <- granitemoe_block x pos_ids attn_mask past_i
      new_kv <- Cache.append new_kv new_i
      yield x, new_kv
    x <- granitemoe_norm@norm x
    return x, new_kv
  logits <- NN.linear@lm_head x dim=49152 bias=false
  logits <- logits / 6.0
  return logits, new_kv
