{-# CHECKPOINTS ["EleutherAI/gpt-j-6b", "test/GPT-J-Test"] #-}
{-# TASK "causal_lm" #-}

import Activations (gelu_new)
import Attention (attention, merge_heads, reshape_heads)
import Masking (causal_mask_for_input)
import Params (has_root)
import Positions (position_ids, rope_base_factors, rope_pair_base_prefix_factors)
import Cache
import Config
import NN



MODEL_DIM <- (Config.dim@@n_embd default=4096)

VOCAB_SIZE <- (Config.dim@@vocab_size default=50400)

NUM_LAYERS <- (Config.dim@@n_layer default=28)

NUM_HEADS <- (Config.dim@@n_head default=16)

MODEL_HEAD_DIM <- do
  return MODEL_DIM / NUM_HEADS

FFN <- do
  return 4 * MODEL_DIM

EPS <- (Config.float@@layer_norm_epsilon default=1e-05)

MAX_POSITIONS <- (Config.dim@@n_positions default=2048)

ROTARY_DIM <- (Config.dim@@rotary_dim default=64)

THETA <- (Config.float@@rotary_emb_base default=10000.0)

HAS_LM_HEAD <- do
  return has_root "lm_head"

HAS_LM_HEAD_BIAS <- do
  return has_root "lm_head.bias"

gptj_block :: Tensor[B,S,D] -> Tensor[B,1,S,R] -> Tensor[B,1,S,R] -> Tensor[B,1,S,K] -> ?CacheLayer[B,NUM_HEADS,P,DH] -> (Tensor[B,S,D], ?CacheLayer[B,NUM_HEADS,K,DH])
gptj_block x rope_sin rope_cos mask past_kv = do
  xn <- NN.layernorm@ln_1 x eps=EPS
  a, new_kv <- scope@attn do
    q <- NN.linear@q_proj xn dim=MODEL_DIM bias=false |> reshape_heads heads=NUM_HEADS
    k <- NN.linear@k_proj xn dim=MODEL_DIM bias=false |> reshape_heads heads=NUM_HEADS
    v <- NN.linear@v_proj xn dim=MODEL_DIM bias=false |> reshape_heads heads=NUM_HEADS
    q, k <- rope_pair_base_prefix_factors q k rope_sin rope_cos ROTARY_DIM interleaved=true
    k, v, new_kv <- Cache.update past_kv k v
    a <- attention q k v mask |> merge_heads |> NN.linear@out_proj dim=MODEL_DIM bias=false
    return a, new_kv
  m <- scope@mlp do
    return NN.linear@fc_in xn dim=FFN bias=true |> gelu_new |> NN.linear@fc_out dim=MODEL_DIM bias=true
  x <- x + a + m
  return x, new_kv

gpt_j :: TokenIds[B,S] -> ?Tensor[B,K] -> ?Cache[B,NUM_HEADS,P,DH] -> ?Bool -> (Tensor[B,S,V], ?Cache[B,NUM_HEADS,K,DH])
gpt_j input_ids attn_mask past_kv use_cache = do
  past_length <- Cache.past_length past_kv
  pos_ids <- position_ids input_ids past_length=past_length
  rope_sin, rope_cos <- rope_base_factors pos_ids ROTARY_DIM THETA interleaved=true
  key_len <- past_length + S
  mask <- causal_mask_for_input input_ids key_len padding_mask=attn_mask window=MAX_POSITIONS
  x <- NN.embedding@@transformer.wte input_ids dim=MODEL_DIM
  new_kv <- use_cache ? Cache.init : null
  x, new_kv <- for@transformer.h i <- [0..NUM_LAYERS) carry (x, new_kv) do
    past_i <- Cache.index past_kv i
    x, new_i <- gptj_block x rope_sin rope_cos mask past_i
    new_kv <- Cache.append new_kv new_i
    yield x, new_kv
  x <- NN.layernorm@@transformer.ln_f x eps=EPS
  logits <- HAS_LM_HEAD
    ? NN.linear@lm_head x dim=VOCAB_SIZE bias=HAS_LM_HEAD_BIAS
    : NN.linear@@transformer.wte x dim=VOCAB_SIZE bias=false
  return logits, new_kv
