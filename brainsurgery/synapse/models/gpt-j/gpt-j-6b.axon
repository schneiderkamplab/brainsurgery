{-# CHECKPOINTS "EleutherAI/gpt-j-6b" #-}
{-# TASK "causal_lm" #-}

import Activations (gelu_new)
import Attention (attention, merge_heads, reshape_heads)
import Masking (causal_mask)
import Params (has_root)
import Positions (position_ids, rope_pair_base)



D = 4096
V = 50400
L = 28
H = 16
FFN = 16384
EPS = 1e-05
C = 2048
ROTARY_FACTOR = 0.25
THETA = 10000.0
HAS_LM_HEAD = true
HAS_LM_HEAD_BIAS = has_root "lm_head.bias"

gptj_block :: Tensor[B,S,D] -> Tensor[B,S] -> ?Tensor[B,S] -> ?CacheLayer -> (Tensor[B,S,D], ?CacheLayer)
gptj_block x pos_ids attn_mask past_kv = do
  xn <- NN.layernorm@ln_1 x eps=EPS
  a, new_kv <- scope@attn do
    q <- NN.linear@q_proj xn dim=D bias=false |> reshape_heads heads=H
    k <- NN.linear@k_proj xn dim=D bias=false |> reshape_heads heads=H
    v <- NN.linear@v_proj xn dim=D bias=false |> reshape_heads heads=H
    q, k <- rope_pair_base q k pos_ids theta=THETA partial_rotary_factor=ROTARY_FACTOR interleaved=true
    k, v, new_kv <- Cache.update past_kv k v
    mask <- causal_mask q k window=C padding_mask=attn_mask
    a <- attention q k v mask |> merge_heads |> NN.linear@out_proj dim=D bias=false
    return a, new_kv
  m <- scope@mlp do
    return NN.linear@fc_in xn dim=FFN bias=true |> gelu_new |> NN.linear@fc_out dim=D bias=true
  x <- x + a + m
  return x, new_kv

gpt_j :: TokenIds[B,S] -> ?Tensor[B,S] -> ?Cache -> ?Bool -> (Tensor[B,S,V], ?Cache)
gpt_j input_ids attn_mask past_kv use_cache = do
  pos_ids <- position_ids input_ids past_length=(Cache.past_length past_kv)
  x, new_kv <- scope@transformer do
    x <- NN.embedding@wte input_ids dim=D
    new_kv <- use_cache ? Cache.init : null
    for@h i <- [0..L) do
      past_i <- Cache.index past_kv i
      x, new_i <- gptj_block x pos_ids attn_mask past_i
      new_kv <- Cache.append new_kv new_i
    x <- NN.layernorm@ln_f x eps=EPS
    return x, new_kv
  logits <- HAS_LM_HEAD ? NN.linear@lm_head x dim=V bias=HAS_LM_HEAD_BIAS : NN.linear@transformer.wte x dim=V bias=false
  return logits, new_kv
