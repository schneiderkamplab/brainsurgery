{-# CHECKPOINTS "openai-community/gpt2-medium" #-}

{-# TASK "causal_lm" #-}

{-# MAIN "gpt2" #-}

import Activations (gelu_new)

import Attention (attention, merge_heads, reshape_heads)

import Masking (causal_mask)

import Positions (position_ids)

import Config

import NN

import Tensor

CONTEXT_SIZE = 1024

MODEL_DIM = 1024

NUM_LAYERS = 24

NUM_HEADS = 16

VOCAB_SIZE = 50257

gpt2_block :: Tensor[B,S,D] -> ?Tensor[B,S] -> Tensor[B,S,D]
gpt2_block x attn_mask = do
  x1 <- NN.layernorm@ln_1 x
  a <- scope@attn do
    q_lin, k_lin, v_lin <- Tensor.chunk (NN.linear@c_attn x1 dim=(3 * MODEL_DIM) bias=true transpose=true) parts=3
    q <- reshape_heads q_lin heads=NUM_HEADS
    k <- reshape_heads k_lin heads=NUM_HEADS
    v <- reshape_heads v_lin heads=NUM_HEADS
    mask <- causal_mask q k window=CONTEXT_SIZE padding_mask=attn_mask
    return attention q k v mask |> merge_heads |> NN.linear@c_proj dim=MODEL_DIM bias=true transpose=true
  x <- x + a
  x3 <- NN.layernorm@ln_2 x
  m <- scope@mlp do
    return NN.linear@c_fc x3 dim=(4 * MODEL_DIM) bias=true transpose=true |> gelu_new |> NN.linear@c_proj dim=MODEL_DIM bias=true transpose=true
  return x + m

gpt2 :: TokenIds[B,S] -> ?Tensor[B,S] -> Tensor[B,S,V]
gpt2 input_ids attn_mask = do
  tok <- NN.embedding@wte input_ids dim=MODEL_DIM
  pos <- position_ids input_ids attn_mask=attn_mask pad_fill=1 |> NN.embedding@wpe
  x <- tok + pos
  x <- for@h i <- [0..NUM_LAYERS) carry (x) do
    x <- gpt2_block x attn_mask
    yield x
  logits <- NN.layernorm@ln_f x |> NN.linear@wte
  return logits
