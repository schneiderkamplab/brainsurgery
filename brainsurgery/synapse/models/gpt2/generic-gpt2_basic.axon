{-# CHECKPOINTS ["openai-community/gpt2", "openai-community/gpt2-medium", "openai-community/gpt2-large", "openai-community/gpt2-xl"] #-}
{-# TASK "causal_lm" #-}

import Config
import Activations gelu_new
import Cache past_length

T   = Config.int "n_positions" default=1024
D   = Config.int "n_embd" default=768
L   = Config.int "n_layer" default=12
H   = Config.int "n_head" default=12
V   = Config.int "vocab_size" default=52057
PAD_FILL = 1

reshape_head_basic :: Tensor[B,S,D] -> Int -> Tensor
reshape_head_basic x heads = do
  x4 <- reshape x shape=[B, S, heads, (D / heads)]
  return permute x4 dims=[0, 2, 1, 3]

merge_heads_basic :: Tensor[B,H,S,HD] -> Int -> Tensor
merge_heads_basic x heads = do
  x4 <- permute x dims=[0, 2, 1, 3]
  return reshape x4 shape=[B, S, (heads * HD)]

position_ids_basic_masked :: TokenIds[B,S] -> Tensor[B,SM] -> Int -> Tensor[B,S]
position_ids_basic_masked x attn_mask pad_fill = do
  m1 <- cast attn_mask dtype="long"
  pos1 <- cumsum m1 dim=-1
  pos2 <- pos1 - 1
  pad <- eq attn_mask 0
  pos3 <- masked_fill pos2 pad value=pad_fill
  return slice pos3 dim=-1 start=(SM - S) end=SM

position_ids_basic :: TokenIds[B,S] -> Tensor[B,SM] -> Int -> Int -> Tensor[B,S]
position_ids_basic x attn_mask past_length pad_fill = position_ids_basic_masked x attn_mask pad_fill

gpt2_block :: Tensor[B,S,D] -> Tensor[B,SM] -> ?CacheLayer -> (Tensor[B,S,D], ?CacheLayer)
gpt2_block x attn_mask past_kv = do
  x1 <- layernorm@ln_1 x
  a, new_kv <- scope@attn do
    q_lin, k_lin, v_lin <- linear@c_attn x1 dim=(3 * D) bias=true transpose=true |> split parts=3
    q <- reshape_head_basic q_lin H
    k <- reshape_head_basic k_lin H
    v <- reshape_head_basic v_lin H
    k, v, new_kv <- Cache.update past_kv k v
    mask <- causal_mask q k window=T padding_mask=attn_mask
    a <- attention q k v mask=mask |> merge_heads_basic H |> linear@c_proj dim=D bias=true transpose=true
    return a, new_kv
  x <- x + a
  x3 <- layernorm@ln_2 x
  m <- scope@mlp do
    return linear@c_fc x3 dim=(4 * D) bias=true transpose=true |> gelu_new fp32_accum=true |> linear@c_proj dim=D bias=true transpose=true
  return x + m, new_kv

gpt2 :: TokenIds[B,S] -> Tensor[B,SM] -> ?Cache -> ?Bool -> (Tensor[B,S,V], ?Cache)
gpt2 input_ids attn_mask past_kv use_cache = do
  tok <- embedding@wte input_ids dim=D
  pos <- position_ids_basic input_ids attn_mask (past_length past_kv) PAD_FILL |> embedding@wpe
  x <- tok + pos
  new_kv <- use_cache ? Cache.init : null
  for@h i <- [0..L) do
    past_i <- Cache.index past_kv i
    x, new_i <- gpt2_block x attn_mask past_i
    new_kv <- Cache.append new_kv new_i
  logits <- layernorm@ln_f x |> linear@wte
  return logits, new_kv
