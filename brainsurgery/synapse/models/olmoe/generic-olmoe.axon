{-# CHECKPOINTS "allenai/OLMoE-1B-7B-0924" #-}
{-# TASK "causal_lm" #-}

import Activations (silu)
import Attention (attention, merge_heads, reshape_heads)
import Masking (causal_mask)
import Math (mul, sqrt)
import MoE (scatter_add, select)
import Positions (position_ids, rope_pair_base)



D    = Config.int@hidden_size default=2048               -- hidden dimension
V    = Config.int@vocab_size default=50304               -- vocabulary size
L    = Config.int@num_hidden_layers default=16           -- number of decoder layers
H    = Config.int@num_attention_heads default=16         -- number of attention heads
HD   = D / H                                                -- per-head dimension
E    = Config.int@num_experts default=64                 -- number of experts
EPT  = Config.int@num_experts_per_tok default=8          -- experts selected per token (top-k)
C    = Config.int@max_position_embeddings default=4096   -- context window / max sequence length
EPS  = 1e-05                                                -- RMSNorm epsilon
THETA = Config.float@rope_theta default=10000.0          -- rope theta
ATTN_SCALE = 1.0 / sqrt HD                                  -- attention scale (1 / sqrt(HD))

rms :: Path -> Tensor[B,S,D] -> Tensor[B,S,D]
rms@path x = NN.rmsnorm@path x eps=EPS

expert_ffn :: Tensor[N,D] -> Tensor[N,D]
expert_ffn x = do
  gate <- NN.linear@gate_proj x
  up <- NN.linear@up_proj x
  return gate |> silu |> mul up |> NN.linear@down_proj

olmoe_decoder_block :: Tensor[B,S,D] -> Tensor[B,S] -> ?Tensor[B,S] -> ?CacheLayer -> (Tensor[B,S,D], ?CacheLayer)
olmoe_decoder_block x pos_ids attn_mask past_kv = do
  x_norm <- rms@input_layernorm x
  a, new_kv <- scope@self_attn do
    q <- x_norm |> NN.linear@q_proj dim=D |> rms@q_norm |> reshape_heads heads=H
    k <- x_norm |> NN.linear@k_proj dim=D |> rms@k_norm |> reshape_heads heads=H
    v <- x_norm |> NN.linear@v_proj dim=D |> reshape_heads heads=H
    q, k <- rope_pair_base q k pos_ids THETA
    k, v, new_kv <- Cache.update past_kv k v
    mask <- causal_mask q k window=C padding_mask=attn_mask
    a <- attention q k v mask scale=ATTN_SCALE |> merge_heads
    a <- NN.linear@o_proj a dim=D
    return a, new_kv
  x <- x + a
  xn <- rms@post_attention_layernorm x
  m <- scope@mlp do
    topk_scores, topk_indices <- NN.linear@gate xn dim=E |>
      Tensor.softmax dim=-1 dtype="float32" |> Tensor.topk k=EPT dim=-1
    m <- Tensor.zeros_like xn
    m <- for@experts e <- [0..E) carry (m) do
      x_sel, token_idx, topk_pos, sel_scores <- select xn topk_scores topk_indices e
      x_upd <- expert_ffn x_sel
      m <- scatter_add m token_idx x_upd sel_scores
      yield m
    return m
  return x + m, new_kv

olmoe :: TokenIds[B,S] -> ?Tensor[B,S] -> ?Cache -> ?Bool -> (Tensor[B,S,V], ?Cache)
olmoe input_ids attn_mask past_kv use_cache = do
  pos_ids <- position_ids input_ids attn_mask=attn_mask past_length=(Cache.past_length past_kv)
  x, new_kv <- scope@model do
    x <- NN.embedding@embed_tokens input_ids dim=D
    new_kv <- use_cache ? Cache.init : null
    x, new_kv <- for@layers i <- [0..L) carry (x, new_kv) do
      past_i <- Cache.index past_kv i
      x, new_i <- olmoe_decoder_block x pos_ids attn_mask past_i
      new_kv <- Cache.append new_kv new_i
      yield x, new_kv
    x <- rms@norm x
    return x, new_kv
  logits <- NN.linear@lm_head x
  return logits, new_kv
