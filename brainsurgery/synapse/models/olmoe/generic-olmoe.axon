{-# CHECKPOINTS ["allenai/OLMoE-1B-7B-0924", "test/OLMoE-Test"] #-}
{-# TASK "causal_lm" #-}

import Attention (attention, merge_heads, reshape_heads)
import Masking (causal_mask)
import Math (sqrt)
import MoE (grouped_swiglu_ffn_basic)
import Positions (position_ids, rope_base_factors, rope_pair_base_factors)
import Cache
import Config
import NN
import Tensor



MODEL_DIM <- Config.int@@hidden_size default=2048               -- hidden dimension
VOCAB_SIZE <- Config.int@@vocab_size default=50304               -- vocabulary size
NUM_LAYERS <- Config.int@@num_hidden_layers default=16           -- number of decoder layers
NUM_HEADS <- Config.int@@num_attention_heads default=16         -- number of attention heads
MODEL_HEAD_DIM   = MODEL_DIM / NUM_HEADS                                                -- per-head dimension
E <- Config.int@@num_experts default=64                 -- number of experts
EPT <- Config.int@@num_experts_per_tok default=8          -- experts selected per token (top-k)
MAX_POSITIONS <- Config.int@@max_position_embeddings default=4096   -- context window / max sequence length
EPS  = 1e-05                                                -- RMSNorm epsilon
THETA <- Config.float@@rope_theta default=10000.0          -- rope theta
ATTN_SCALE = 1.0 / sqrt MODEL_HEAD_DIM                                  -- attention scale (1 / sqrt(MODEL_HEAD_DIM))

rms :: Path -> Tensor[B,S,D] -> Tensor[B,S,D]
rms@path x = NN.rmsnorm@path x eps=EPS

olmoe_decoder_block :: Tensor[B,S,D] -> Tensor[B,1,S,R] -> Tensor[B,1,S,R] -> ?Tensor[B,K] -> ?CacheLayer[B,NUM_HEADS,P,DH] -> (Tensor[B,S,D], ?CacheLayer[B,NUM_HEADS,K,DH])
olmoe_decoder_block x rope_sin rope_cos attn_mask past_kv = do
  x_norm <- rms@input_layernorm x
  a, new_kv <- scope@self_attn do
    q <- x_norm |> NN.linear@q_proj dim=MODEL_DIM |> rms@q_norm |> reshape_heads heads=NUM_HEADS
    k <- x_norm |> NN.linear@k_proj dim=MODEL_DIM |> rms@k_norm |> reshape_heads heads=NUM_HEADS
    v <- x_norm |> NN.linear@v_proj dim=MODEL_DIM |> reshape_heads heads=NUM_HEADS
    q, k <- rope_pair_base_factors q k rope_sin rope_cos
    k, v, new_kv <- Cache.update past_kv k v
    mask <- causal_mask q k window=MAX_POSITIONS padding_mask=attn_mask
    a <- attention q k v mask scale=ATTN_SCALE |> merge_heads
    a <- NN.linear@o_proj a dim=MODEL_DIM
    return a, new_kv
  x <- x + a
  xn <- rms@post_attention_layernorm x
  m <- scope@mlp do
    topk_scores, topk_indices <- NN.linear@gate xn dim=E |>
      Tensor.softmax dim=-1 dtype="float32" |> Tensor.topk k=EPT dim=-1
    m <- grouped_swiglu_ffn_basic xn topk_scores topk_indices E gate_up_weight=@experts.gate_up_proj.weight out_weight=@experts.down_proj.weight
    return m
  return x + m, new_kv

olmoe :: TokenIds[B,S] -> ?Tensor[B,K] -> ?Cache[B,NUM_HEADS,P,DH] -> ?Bool -> (Tensor[B,S,V], ?Cache[B,NUM_HEADS,K,DH])
olmoe input_ids attn_mask past_kv use_cache = do
  pos_ids <- position_ids input_ids attn_mask=attn_mask past_length=(Cache.past_length past_kv)
  rope_sin, rope_cos <- rope_base_factors pos_ids MODEL_HEAD_DIM THETA
  x, new_kv <- scope@model do
    x <- NN.embedding@embed_tokens input_ids dim=MODEL_DIM
    new_kv <- use_cache ? Cache.init : null
    x, new_kv <- for@layers i <- [0..NUM_LAYERS) carry (x, new_kv) do
      past_i <- Cache.index past_kv i
      x, new_i <- olmoe_decoder_block x rope_sin rope_cos attn_mask past_i
      new_kv <- Cache.append new_kv new_i
      yield x, new_kv
    x <- rms@norm x
    return x, new_kv
  logits <- NN.linear@lm_head x
  return logits, new_kv
