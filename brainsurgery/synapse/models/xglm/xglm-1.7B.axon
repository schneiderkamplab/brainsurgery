{-# CHECKPOINTS "facebook/xglm-1.7B" #-}
{-# TASK "causal_lm" #-}

import Activations
import Activations (gelu, relu)
import Attention
import Attention (attention, merge_heads, reshape_heads)
import Masking
import Masking (causal_mask)
import Math
import Math (sqrt)
import Params
import Params (has_root)
import Positions
import Positions (position_ids, sinusoidal_positions)

HAS_POS = has_root "model.embed_positions.weight"

xglm_act :: Tensor -> Tensor
xglm_act x = (gelu x)

xglm_block :: Tensor[B,S,D] -> ?Tensor[B,S] -> ?CacheLayer -> (Tensor[B,S,D], ?CacheLayer)
xglm_block x attn_mask past_kv = do
  xn <- NN.layernorm@self_attn_layer_norm x eps=1e-05
  a, new_kv <- scope@self_attn do
    q <- NN.linear@q_proj xn dim=2048 bias=true |> reshape_heads heads=16
    k <- NN.linear@k_proj xn dim=2048 bias=true |> reshape_heads heads=16
    v <- NN.linear@v_proj xn dim=2048 bias=true |> reshape_heads heads=16
    k, v, new_kv <- Cache.update past_kv k v
    mask <- causal_mask q k window=2048 padding_mask=attn_mask
    a <- attention q k v mask scale=0.08838834764831843 |> merge_heads |> NN.linear@out_proj dim=2048 bias=true
    return a, new_kv
  x <- x + a
  xn2 <- NN.layernorm@final_layer_norm x eps=1e-05
  m <- NN.linear@fc1 xn2 dim=8192 bias=true |> xglm_act |> NN.linear@fc2 dim=2048 bias=true
  x <- x + m
  return x, new_kv

xglm :: TokenIds[B,S] -> ?Tensor[B,S] -> ?Cache -> ?Bool -> (Tensor[B,S,V], ?Cache)
xglm input_ids attn_mask past_kv use_cache = do
  pos_ids <- position_ids input_ids attn_mask=attn_mask past_length=(Cache.past_length past_kv) pad_fill=-1
  pos_ids_rope <- pos_ids + 2
  x, new_kv <- scope@model do
    tok <- NN.embedding@embed_tokens input_ids dim=2048
    x <- tok * 45.254833995939045
    pos <- HAS_POS ? (NN.embedding@embed_positions pos_ids_rope dim=2048) : (sinusoidal_positions x pos_ids_rope theta=10000.0 offset=0 padding_idx=null)
    x <- x + pos
    new_kv <- use_cache ? Cache.init : null
    for@layers i <- [0..24) do
      past_i <- Cache.index past_kv i
      x, new_i <- xglm_block x attn_mask past_i
      new_kv <- Cache.append new_kv new_i
      yield x, new_kv
    x <- NN.layernorm@layer_norm x eps=1e-05
    return x, new_kv
  logits <- NN.linear@lm_head x dim=256008 bias=false
  return logits, new_kv
