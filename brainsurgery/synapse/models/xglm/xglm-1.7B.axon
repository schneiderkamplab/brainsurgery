{-# CHECKPOINTS "facebook/xglm-1.7B" #-}

{-# TASK "causal_lm" #-}

{-# MAIN "xglm" #-}

import Activations (gelu, relu)

import Attention (attention, merge_heads, reshape_heads)

import Masking (Mask, causal_mask_for_input, mask_for_input, mask_length_for_input)

import Math (sqrt)

import Params (has_root)

import Positions (position_ids, sinusoidal_positions)

import Cache

import Config

import NN

MODEL_DIM <- (2048 :: Dim)

VOCAB_SIZE <- (256008 :: Dim)

NUM_LAYERS <- (24 :: Dim)

NUM_HEADS <- (16 :: Dim)

MODEL_HEAD_DIM <- do
  return MODEL_DIM / NUM_HEADS

FFN <- (8192 :: Dim)

EPS <- (1e-05)

MAX_POSITIONS <- (2048 :: Dim)

ACT <- ("gelu")

SCALE_EMB <- (true)

EMB_SCALE <- do
  return SCALE_EMB ? (sqrt MODEL_DIM) : 1.0

ATTN_SCALE <- do
  return 1.0 / sqrt MODEL_HEAD_DIM

HAS_POS <- do
  return has_root "model.embed_positions.weight"

xglm_act :: Tensor[..S] -> Tensor[..S]
xglm_act x = (ACT == "relu") ? (relu x) : (gelu x)

xglm_block :: Tensor[B,S,D] -> Tensor[B,1,S,K] -> ?CacheLayer[B,H,P,MAX_POSITIONS,DH] -> (Tensor[B,S,D], ?CacheLayer[B,H,K,MAX_POSITIONS,DH])
xglm_block x mask past_kv = do
  xn <- NN.layernorm@self_attn_layer_norm x eps=EPS
  a, new_kv <- scope@self_attn do
    q <- NN.linear@q_proj xn dim=MODEL_DIM bias=true |> reshape_heads heads=NUM_HEADS
    k <- NN.linear@k_proj xn dim=MODEL_DIM bias=true |> reshape_heads heads=NUM_HEADS
    v <- NN.linear@v_proj xn dim=MODEL_DIM bias=true |> reshape_heads heads=NUM_HEADS
    k, v, new_kv <- Cache.update past_kv k v
    a <- attention q k v mask scale=ATTN_SCALE |> merge_heads |> NN.linear@out_proj dim=MODEL_DIM bias=true
    return a, new_kv
  x <- x + a
  xn2 <- NN.layernorm@final_layer_norm x eps=EPS
  m <- NN.linear@fc1 xn2 dim=FFN bias=true |> xglm_act |> NN.linear@fc2 dim=MODEL_DIM bias=true
  x <- x + m
  return x, new_kv

xglm :: TokenIds[B,S] -> ?Mask[B,K,MAX_POSITIONS] -> ?Cache[B,H,P,MAX_POSITIONS,DH] -> ?Bool -> (Tensor[B,S,V], ?Cache[B,H,K,MAX_POSITIONS,DH])
xglm input_ids attn_mask past_kv use_cache = do
  past_length <- Cache.past_length past_kv
  attn_mask <- mask_for_input input_ids attn_mask MAX_POSITIONS
  pos_ids <- position_ids input_ids attn_mask=attn_mask past_length=past_length pad_fill=(-1)
  pos_ids_rope <- pos_ids + 2
  key_len <- mask_length_for_input input_ids attn_mask past_length
  mask <- causal_mask_for_input input_ids key_len padding_mask=attn_mask window=MAX_POSITIONS
  tok <- NN.embedding@@model.embed_tokens input_ids dim=MODEL_DIM
  x <- tok * EMB_SCALE
  pos <- HAS_POS ? (NN.embedding@@model.embed_positions pos_ids_rope dim=MODEL_DIM) : (sinusoidal_positions x pos_ids_rope theta=10000.0 offset=0 padding_idx=null)
  x <- x + pos
  work_kv <- Cache.prepare past_kv use_cache MAX_POSITIONS
  read_kv <- Cache.read past_kv work_kv
  x, work_kv <- for@model.layers i <- [0..NUM_LAYERS) carry (x, work_kv) do
    past_i <- Cache.index read_kv i
    x, new_i <- xglm_block x mask past_i
    work_kv <- Cache.append work_kv new_i
    yield x, work_kv
  new_length <- past_length + S
  new_kv <- Cache.finish work_kv new_length
  new_kv <- use_cache ? new_kv : null
  x <- NN.layernorm@@model.layer_norm x eps=EPS
  logits <- NN.linear@lm_head x dim=VOCAB_SIZE bias=false
  return logits, new_kv
