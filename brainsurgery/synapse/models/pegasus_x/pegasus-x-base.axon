{-# CHECKPOINTS "google/pegasus-x-base" #-}

{-# TASK "seq2seq_lm" #-}

{-# MAIN "pegasus_x" #-}

import Activations (relu)

import Attention (attention, merge_heads, reshape_heads)

import Masking (Mask, bidirectional_mask, bidirectional_mask_for_input, causal_mask_for_input, mask_for_input)

import Math (sqrt)

import Positions (sinusoidal_positions)

import Config

import NN

import Tensor

MODEL_DIM <- 768

VOCAB_SIZE <- 96103

L_ENC <- 12

L_DEC <- 12

H_ENC <- 12

H_DEC <- 12

FFN_ENC <- 3072

FFN_DEC <- 3072

EPS <- 1e-05

BLOCK <- 512

GLOBAL_TOKENS <- 128

STAGGER <- true

EMB_SCALE = sqrt MODEL_DIM

pegasus_x_encoder_layer :: Tensor[B,S,MODEL_DIM] -> Tensor[B,GLOBAL_TOKENS,MODEL_DIM] -> Tensor[B,S] -> Int -> (Tensor[B,S,MODEL_DIM], Tensor[B,GLOBAL_TOKENS,MODEL_DIM])
pegasus_x_encoder_layer x global_x padding_mask layer_idx = do
  local_norm <- NN.layernorm@self_attn_layer_norm x eps=EPS
  global_norm <- NN.layernorm@global_self_attn_layer_norm global_x eps=EPS
  local_q <- NN.linear@self_attn.q_proj local_norm dim=MODEL_DIM bias=false |> reshape_heads heads=H_ENC
  local_k <- NN.linear@self_attn.k_proj local_norm dim=MODEL_DIM bias=false |> reshape_heads heads=H_ENC
  local_v <- NN.linear@self_attn.v_proj local_norm dim=MODEL_DIM bias=false |> reshape_heads heads=H_ENC
  global_q <- NN.linear@self_attn.q_proj global_norm dim=MODEL_DIM bias=false |> reshape_heads heads=H_ENC
  global_k <- NN.linear@self_attn.k_proj global_norm dim=MODEL_DIM bias=false |> reshape_heads heads=H_ENC
  global_v <- NN.linear@self_attn.v_proj global_norm dim=MODEL_DIM bias=false |> reshape_heads heads=H_ENC
  all_k <- Tensor.concat global_k local_k dim=-2
  all_v <- Tensor.concat global_v local_v dim=-2
  positions <- Tensor.arange x 0 S
  shift <- (STAGGER and ((layer_idx % 2) == 1)) ? (BLOCK / 2) : 0
  blocks <- Tensor.cast ((positions + shift) / BLOCK) "long"
  query_blocks <- Tensor.reshape blocks shape=[S, 1]
  key_blocks <- Tensor.reshape blocks shape=[1, S]
  local_block_keep <- Tensor.eq query_blocks key_blocks
  local_block_keep <- Tensor.reshape local_block_keep shape=[1, 1, S, S] |> Tensor.expand shape=[B, 1, S, S]
  local_padding_keep <- bidirectional_mask local_q local_k padding_mask=padding_mask
  local_block_keep <- local_block_keep and local_padding_keep
  global_columns <- Tensor.eq (Tensor.reshape positions shape=[S, 1]) (Tensor.reshape positions shape=[S, 1])
  global_columns <- Tensor.expand global_columns shape=[S, GLOBAL_TOKENS] |> Tensor.reshape shape=[1, 1, S, GLOBAL_TOKENS] |> Tensor.expand shape=[B, 1, S, GLOBAL_TOKENS]
  local_keep <- Tensor.concat global_columns local_block_keep dim=-1
  local_a <- attention local_q all_k all_v local_keep |> merge_heads |> NN.linear@self_attn.out_proj dim=MODEL_DIM bias=false
  global_ids <- Tensor.arange global_x 0 GLOBAL_TOKENS |> Tensor.reshape shape=[1, GLOBAL_TOKENS] |> Tensor.expand shape=[B, GLOBAL_TOKENS]
  global_padding <- Tensor.eq global_ids global_ids
  all_padding <- Tensor.concat global_padding padding_mask dim=-1
  global_keep <- bidirectional_mask global_q all_k padding_mask=all_padding
  global_a <- attention global_q all_k all_v global_keep |> merge_heads |> NN.linear@self_attn.out_proj dim=MODEL_DIM bias=false
  x <- x + local_a
  global_x <- global_x + global_a
  local_norm <- NN.layernorm@final_layer_norm x eps=EPS
  local_m <- NN.linear@fc1 local_norm dim=FFN_ENC bias=true |> relu |> NN.linear@fc2 dim=MODEL_DIM bias=true
  global_norm <- NN.layernorm@final_layer_norm global_x eps=EPS
  global_m <- NN.linear@fc1 global_norm dim=FFN_ENC bias=true |> relu |> NN.linear@fc2 dim=MODEL_DIM bias=true
  return x + local_m, global_x + global_m

pegasus_x_decoder_layer :: Tensor[B,SDEC,D] -> Tensor[B,SENC,D] -> Tensor[B,1,SDEC,SDEC] -> Tensor[B,1,SDEC,SENC] -> Tensor[B,SDEC,D]
pegasus_x_decoder_layer x enc_hidden decoder_keep cross_keep = do
  x_norm <- NN.layernorm@self_attn_layer_norm x eps=EPS
  a <- scope@self_attn do
    q <- NN.linear@q_proj x_norm dim=MODEL_DIM bias=false |> reshape_heads heads=H_DEC
    k <- NN.linear@k_proj x_norm dim=MODEL_DIM bias=false |> reshape_heads heads=H_DEC
    v <- NN.linear@v_proj x_norm dim=MODEL_DIM bias=false |> reshape_heads heads=H_DEC
    return attention q k v decoder_keep |> merge_heads |> NN.linear@out_proj dim=MODEL_DIM bias=false
  x <- x + a
  x_norm <- NN.layernorm@encoder_attn_layer_norm x eps=EPS
  a <- scope@encoder_attn do
    q <- NN.linear@q_proj x_norm dim=MODEL_DIM bias=false |> reshape_heads heads=H_DEC
    k <- NN.linear@k_proj enc_hidden dim=MODEL_DIM bias=false |> reshape_heads heads=H_DEC
    v <- NN.linear@v_proj enc_hidden dim=MODEL_DIM bias=false |> reshape_heads heads=H_DEC
    return attention q k v cross_keep |> merge_heads |> NN.linear@out_proj dim=MODEL_DIM bias=false
  x <- x + a
  x_norm <- NN.layernorm@final_layer_norm x eps=EPS
  m <- NN.linear@fc1 x_norm dim=FFN_DEC bias=true |> relu |> NN.linear@fc2 dim=MODEL_DIM bias=true
  return x + m

pegasus_x :: TokenIds[B,SENC] -> ?Mask[B,SENC,SENC] -> TokenIds[B,SDEC] -> ?Mask[B,SDEC,SDEC] -> Tensor[B,SDEC,V]
pegasus_x input_ids attention_mask decoder_input_ids decoder_attention_mask = do
  attention_mask <- mask_for_input input_ids attention_mask SENC
  decoder_attention_mask <- mask_for_input decoder_input_ids decoder_attention_mask SDEC
  decoder_keep <- causal_mask_for_input decoder_input_ids SDEC padding_mask=decoder_attention_mask window=128
  cross_keep <- bidirectional_mask_for_input decoder_input_ids SENC padding_mask=attention_mask
  enc_pos_ids <- Tensor.arange input_ids 0 SENC |> Tensor.reshape shape=[1, SENC] |> Tensor.expand shape=[B, SENC]
  enc_hidden <- NN.embedding@model.shared input_ids dim=MODEL_DIM scale=EMB_SCALE
  enc_hidden <- enc_hidden + sinusoidal_positions enc_hidden enc_pos_ids offset=0 mode="legacy"
  global_ids <- Tensor.arange enc_hidden 0 GLOBAL_TOKENS |> Tensor.reshape shape=[1, GLOBAL_TOKENS] |> Tensor.expand shape=[B, GLOBAL_TOKENS]
  global_hidden <- NN.embedding@model.encoder.embed_global global_ids dim=MODEL_DIM
  enc_hidden, global_hidden <- for@model.encoder.layers i <- [0..L_ENC) carry (enc_hidden, global_hidden) do
    enc_hidden, global_hidden <- pegasus_x_encoder_layer enc_hidden global_hidden attention_mask i
    yield enc_hidden, global_hidden
  enc_hidden <- NN.layernorm@model.encoder.layer_norm enc_hidden eps=EPS
  dec_pos_ids <- Tensor.arange decoder_input_ids 0 SDEC |> Tensor.reshape shape=[1, SDEC] |> Tensor.expand shape=[B, SDEC]
  dec_hidden <- NN.embedding@model.shared decoder_input_ids dim=MODEL_DIM scale=EMB_SCALE
  dec_hidden <- dec_hidden + sinusoidal_positions dec_hidden dec_pos_ids offset=0 mode="legacy"
  dec_hidden <- for@model.decoder.layers i <- [0..L_DEC) carry (dec_hidden) do
    dec_hidden <- pegasus_x_decoder_layer dec_hidden enc_hidden decoder_keep cross_keep
    yield dec_hidden
  dec_hidden <- NN.layernorm@model.decoder.layer_norm dec_hidden eps=EPS
  return NN.linear@model.shared dec_hidden dim=VOCAB_SIZE bias=false
