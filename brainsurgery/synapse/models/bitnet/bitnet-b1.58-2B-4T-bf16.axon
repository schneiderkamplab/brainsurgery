{-# CHECKPOINTS "microsoft/bitnet-b1.58-2B-4T-bf16" #-}

{-# TASK "causal_lm" #-}

{-# MAIN "bitnet" #-}

import Activations (relu2)

import Attention (attention, merge_heads, reshape_heads)

import Cache

import Config

import Masking (Mask, causal_mask_for_input, mask_for_input, mask_length_for_input)

import Math (clamp, mul, round)

import NN

import Params

import Positions (position_ids, rope_base_factors, rope_pair_base_factors)

import Tensor

MODEL_DIM <- (2560 :: Dim)

FFN <- (6912 :: Dim)

NUM_LAYERS <- (30 :: Dim)

NUM_HEADS <- (20 :: Dim)

KV_HEADS <- (5 :: Dim)

HEAD_DIM <- Config.dim @@head_dim default=(MODEL_DIM / NUM_HEADS)

QD <- NUM_HEADS * HEAD_DIM

KVD <- KV_HEADS * HEAD_DIM

VOCAB_SIZE <- (128256 :: Dim)

MAX_POSITIONS <- (4096 :: Dim)

EPS <- 1e-05

THETA <- 500000.0

bitnet_abs :: Tensor[..S] -> Tensor[..S]
bitnet_abs x = Tensor.where (Tensor.le x 0.0) (0.0 - x) x

bitnet_activation_quant :: Tensor[..S,D] -> Tensor[..S,D]
bitnet_activation_quant x = do
  row_max, _ <- Tensor.topk (bitnet_abs x) 1 dim=-1 largest=true sorted=false
  scale <- 127.0 / (clamp row_max min=1e-5)
  quantized <- round (x * scale) |> clamp min=-128.0 max=127.0
  return quantized / scale

bitnet_weight_quant :: Tensor[O,I] -> Tensor[O,I]
bitnet_weight_quant weight = do
  flat <- bitnet_abs weight |> Tensor.reshape shape=[O * I]
  mean <- (Tensor.sum flat dim=-1) / (O * I)
  scale <- 1.0 / (clamp mean min=1e-5)
  quantized <- round (weight * scale) |> clamp min=-1.0 max=1.0
  return quantized / scale

bitnet_linear :: Path -> Tensor[..S,Din] -> Dim -> Tensor[..S,dim]
bitnet_linear@path x dim = do
  weight <- ((Params.param@weight) :: Tensor[dim,Din])
  x <- bitnet_activation_quant x
  weight <- bitnet_weight_quant weight
  return Tensor.matmul x (Tensor.transpose weight dim1=0 dim2=1)

bitnet_norm :: Path -> Tensor[..S,D] -> Tensor[..S,D]
bitnet_norm@path x = NN.rmsnorm@path x eps=EPS cast_float=true

bitnet_block :: Tensor[B,S,D] -> Tensor[B,1,S,R] -> Tensor[B,1,S,R] -> Tensor[B,1,S,K] -> ?CacheLayer[B,KV_HEADS,P,MAX_POSITIONS,HEAD_DIM] -> (Tensor[B,S,D], ?CacheLayer[B,KV_HEADS,K,MAX_POSITIONS,HEAD_DIM])
bitnet_block x rope_sin rope_cos mask past_kv = do
  xn <- bitnet_norm@input_layernorm x
  a, new_kv <- scope@self_attn do
    q <- bitnet_linear@q_proj xn QD |> reshape_heads heads=NUM_HEADS
    k <- bitnet_linear@k_proj xn KVD |> reshape_heads heads=KV_HEADS
    v <- bitnet_linear@v_proj xn KVD |> reshape_heads heads=KV_HEADS
    q, k <- rope_pair_base_factors q k rope_sin rope_cos
    k, v, new_kv <- Cache.update past_kv k v
    k <- Tensor.repeat k repeats=(NUM_HEADS / KV_HEADS)
    v <- Tensor.repeat v repeats=(NUM_HEADS / KV_HEADS)
    a <- attention q k v mask fp32_compute=true |> merge_heads
    a <- bitnet_norm@attn_sub_norm a
    return bitnet_linear@o_proj a MODEL_DIM, new_kv
  x <- x + a
  xn <- bitnet_norm@post_attention_layernorm x
  m <- scope@mlp do
    gate <- bitnet_linear@gate_proj xn FFN |> relu2
    up <- bitnet_linear@up_proj xn FFN
    hidden <- bitnet_norm@ffn_sub_norm (mul gate up)
    return bitnet_linear@down_proj hidden MODEL_DIM
  return x + m, new_kv

bitnet :: TokenIds[B,S] -> ?Mask[B,K,MAX_POSITIONS] -> ?Cache[B,KV_HEADS,P,MAX_POSITIONS,HEAD_DIM] -> ?Bool -> (Tensor[B,S,V], ?Cache[B,KV_HEADS,K,MAX_POSITIONS,HEAD_DIM])
bitnet input_ids attn_mask past_kv use_cache = do
  past_length <- Cache.past_length past_kv
  attn_mask <- mask_for_input input_ids attn_mask MAX_POSITIONS
  pos_ids <- position_ids input_ids attn_mask=attn_mask past_length=past_length
  rope_sin, rope_cos <- rope_base_factors pos_ids HEAD_DIM THETA
  key_len <- mask_length_for_input input_ids attn_mask past_length
  mask <- causal_mask_for_input input_ids key_len padding_mask=attn_mask window=MAX_POSITIONS
  work_kv <- Cache.prepare past_kv use_cache MAX_POSITIONS
  read_kv <- Cache.read past_kv work_kv
  x <- NN.embedding@@model.embed_tokens input_ids dim=MODEL_DIM
  x, work_kv <- for@model.layers i <- [0..NUM_LAYERS) carry (x, work_kv) do
    past_i <- Cache.index read_kv i
    x, new_i <- bitnet_block x rope_sin rope_cos mask past_i
    work_kv <- Cache.append work_kv new_i
    yield x, work_kv
  x <- bitnet_norm@@model.norm x
  logits <- NN.linear@@model.embed_tokens x dim=VOCAB_SIZE bias=false
  new_kv <- Cache.finish work_kv (past_length + S)
  new_kv <- use_cache ? new_kv : null
  return logits, new_kv
