{-# CHECKPOINTS ["test/Gemma3n-Text-Test", "google/gemma-3n-E2B", "google/gemma-3n-E2B-it", "google/gemma-3n-E4B", "google/gemma-3n-E4B-it"] #-}
{-# TASK "causal_lm" #-}

import Activations (gelu_pytorch_tanh, relu, tanh)
import Attention (attention, merge_heads, reshape_heads)
import Config
import Masking (Mask, causal_mask_for_input, mask_for_input)
import Math (mul, pow, sqrt)
import NN
import Params (has_root, param)
import Positions (position_ids, rope_base_factors, rope_pair_base_factors)
import Tensor

MODEL_DIM <- Config.dim @@hidden_size default=2048
VOCAB_SIZE <- Config.dim @@vocab_size default=262400
LAYER_VOCAB <- Config.dim @@vocab_size_per_layer_input default=262144
NUM_LAYERS <- Config.dim @@num_hidden_layers default=35
NUM_HEADS <- Config.dim @@num_attention_heads default=8
KV_HEADS <- Config.dim @@num_key_value_heads default=2
HEAD_DIM <- Config.dim @@head_dim default=256
PER_LAYER_DIM <- Config.dim @@hidden_size_per_layer_input default=256
ALTUP_INPUTS <- Config.dim @@altup_num_inputs default=4
KV_SHARED <- Config.dim @@num_kv_shared_layers default=15
SHARED_START = NUM_LAYERS - KV_SHARED
LAUREL_RANK <- Config.dim @@laurel_rank default=64
EPS <- Config.float @@rms_norm_eps default=1e-6
MAX_POSITIONS <- Config.dim @@max_position_embeddings default=32768
SLIDING_WINDOW <- Config.dim @@sliding_window default=512
THETA_LOCAL <- Config.float @@'rope_parameters.sliding_attention.rope_theta' default=10000.0
THETA_FULL <- Config.float @@'rope_parameters.full_attention.rope_theta' default=1000000.0
LOGIT_CAP <- Config.float @@final_logit_softcapping default=30.0
EMBED_SCALE = sqrt MODEL_DIM
LAYER_EMBED_SCALE = sqrt PER_LAYER_DIM
MODEL_PROJECTION_SCALE = 1.0 / sqrt MODEL_DIM
LAYER_INPUT_SCALE = 1.0 / sqrt 2.0
ATTN_LAUREL_SCALE = 1.0 / sqrt 2.0
GAUSSIAN_95 = 1.6448536269514722
HAS_LM_HEAD = has_root "lm_head"

gemma3n_rms :: Path -> Tensor[..S] -> Tensor[..S]
gemma3n_rms path x = NN.rmsnorm path x eps=EPS cast_float=true scale_path=@@'{path}.weight'

gemma3n_rms_unscaled :: Tensor[..S,D] -> Tensor[..S,D]
gemma3n_rms_unscaled x = NN.rmsnorm_noscale x eps=EPS cast_float=true

gemma3n_match_magnitude :: Tensor[B,S,D] -> Tensor[B,S,D] -> Tensor[B,S,D]
gemma3n_match_magnitude x target = do
  target_mag <- Tensor.sum (target * target) dim=-1 keepdim=true
  target_mag <- pow (target_mag / D) 0.5
  x_mag <- Tensor.sum (x * x) dim=-1 keepdim=true
  x_mag <- x_mag / D
  x_mag <- Tensor.where (x_mag < 1e-5) 1e-5 x_mag |> pow 0.5
  return x * target_mag / x_mag

gemma3n_altup_modalities :: Path -> Tensor[B,S,D] -> Tensor[B,S,ALTUP_INPUTS]
gemma3n_altup_modalities path x = do
  routed <- gemma3n_rms @@'{path}.router_norm' x
  routed <- routed * (1.0 / MODEL_DIM)
  routed <- NN.linear path routed dim=ALTUP_INPUTS bias=false weight_path=@@'{path}.modality_router.weight'
  return routed |> Tensor.cast dtype="float32" |> tanh |> Tensor.cast_like x

gemma3n_altup_predict :: Path -> Tensor[ALTUP_INPUTS,B,S,D] -> Tensor[ALTUP_INPUTS,B,S,D]
gemma3n_altup_predict path streams = do
  active <- Tensor.slice streams dim=0 start=0 end=1 |> Tensor.reshape shape=[B,S,D]
  modalities <- gemma3n_altup_modalities path active
  coefs <- NN.linear path modalities dim=(ALTUP_INPUTS * ALTUP_INPUTS) bias=false weight_path=@@'{path}.prediction_coefs.weight'
  coefs <- Tensor.reshape coefs shape=[B,S,ALTUP_INPUTS,ALTUP_INPUTS] |> Tensor.permute dims=[0,1,3,2]
  streams_last <- Tensor.permute streams dims=[1,2,3,0]
  predicted <- Tensor.matmul streams_last coefs |> Tensor.permute dims=[3,0,1,2]
  return predicted + streams

gemma3n_altup_correct :: Path -> Tensor[ALTUP_INPUTS,B,S,D] -> Tensor[B,S,D] -> Tensor[ALTUP_INPUTS,B,S,D]
gemma3n_altup_correct path predictions activated = do
  active_prediction <- Tensor.slice predictions dim=0 start=0 end=1 |> Tensor.reshape shape=[B,S,D]
  innovation <- activated - active_prediction
  innovation <- Tensor.unsqueeze innovation dim=0 |> Tensor.expand shape=[ALTUP_INPUTS,B,S,D]
  modalities <- gemma3n_altup_modalities path activated
  coefs <- NN.linear path modalities dim=ALTUP_INPUTS bias=false weight_path=@@'{path}.correction_coefs.weight'
  coefs <- (coefs + 1.0) |> Tensor.permute dims=[2,0,1] |> Tensor.unsqueeze dim=-1
  return predictions + (innovation * coefs)

gemma3n_laurel :: Path -> Tensor[B,S,D] -> Tensor[B,S,D]
gemma3n_laurel path x = do
  y <- NN.linear path x dim=LAUREL_RANK bias=false weight_path=@@'{path}.linear_left.weight'
  y <- NN.linear path y dim=MODEL_DIM bias=false weight_path=@@'{path}.linear_right.weight'
  y <- gemma3n_rms @@'{path}.post_laurel_norm' y
  return x + y

gemma3n_mlp :: Path -> Tensor[B,S,D] -> Bool -> Tensor[B,S,D]
gemma3n_mlp path x sparse = do
  gate_weight <- param path=@@'{path}.gate_proj.weight'
  ffn <- Tensor.size gate_weight 0
  gate <- NN.linear path x dim=ffn bias=false weight_path=@@'{path}.gate_proj.weight'
  gate <- sparse ? (do
    mean <- Tensor.sum gate dim=-1 keepdim=true
    mean <- mean / ffn
    centered <- gate - mean
    variance <- Tensor.sum (centered * centered) dim=-1 keepdim=true
    std <- pow (variance / ffn) 0.5
    return relu (gate - (mean + std * GAUSSIAN_95))
  ) : gate
  up <- NN.linear path x dim=ffn bias=false weight_path=@@'{path}.up_proj.weight'
  hidden <- gate |> gelu_pytorch_tanh |> mul up
  return NN.linear path hidden dim=MODEL_DIM bias=false weight_path=@@'{path}.down_proj.weight'

gemma3n_project_kv :: Path -> Tensor[B,S,D] -> Tensor[B,1,S,HEAD_DIM] -> Tensor[B,1,S,HEAD_DIM] -> (Tensor[B,KV_HEADS,S,HEAD_DIM], Tensor[B,KV_HEADS,S,HEAD_DIM])
gemma3n_project_kv path x rope_sin rope_cos = do
  k <- NN.linear path x dim=(KV_HEADS * HEAD_DIM) bias=false weight_path=@@'{path}.k_proj.weight'
  k <- Tensor.reshape k shape=[B,S,KV_HEADS,HEAD_DIM]
  k <- gemma3n_rms @@'{path}.k_norm' k |> Tensor.permute dims=[0,2,1,3]
  _, k <- rope_pair_base_factors k k rope_sin rope_cos
  v <- NN.linear path x dim=(KV_HEADS * HEAD_DIM) bias=false weight_path=@@'{path}.v_proj.weight'
  v <- Tensor.reshape v shape=[B,S,KV_HEADS,HEAD_DIM]
  v <- gemma3n_rms_unscaled v |> Tensor.permute dims=[0,2,1,3]
  return k, v

gemma3n_attention :: Path -> Tensor[B,S,D] -> Tensor[B,KV_HEADS,S,HEAD_DIM] -> Tensor[B,KV_HEADS,S,HEAD_DIM] -> Bool -> Tensor[B,1,S,HEAD_DIM] -> Tensor[B,1,S,HEAD_DIM] -> Tensor[B,1,S,S] -> (Tensor[B,S,D], Tensor[B,KV_HEADS,S,HEAD_DIM], Tensor[B,KV_HEADS,S,HEAD_DIM])
gemma3n_attention path x shared_k shared_v use_shared rope_sin rope_cos mask = do
  q <- NN.linear path x dim=(NUM_HEADS * HEAD_DIM) bias=false weight_path=@@'{path}.q_proj.weight'
  q <- Tensor.reshape q shape=[B,S,NUM_HEADS,HEAD_DIM]
  q <- gemma3n_rms @@'{path}.q_norm' q |> Tensor.permute dims=[0,2,1,3]
  q, _ <- rope_pair_base_factors q q rope_sin rope_cos
  k, v <- use_shared ? (shared_k, shared_v) : (gemma3n_project_kv path x rope_sin rope_cos)
  k_rep <- Tensor.repeat k repeats=(NUM_HEADS / KV_HEADS)
  v_rep <- Tensor.repeat v repeats=(NUM_HEADS / KV_HEADS)
  out <- attention q k_rep v_rep mask scale=1.0 |> merge_heads
  out <- NN.linear path out dim=MODEL_DIM bias=false weight_path=@@'{path}.o_proj.weight'
  return out, k, v

gemma3n_layer :: Path -> Tensor[ALTUP_INPUTS,B,S,D] -> Tensor[B,S,PER_LAYER_DIM] -> Tensor[B,KV_HEADS,S,HEAD_DIM] -> Tensor[B,KV_HEADS,S,HEAD_DIM] -> Bool -> Tensor[B,1,S,HEAD_DIM] -> Tensor[B,1,S,HEAD_DIM] -> Tensor[B,1,S,S] -> Bool -> (Tensor[ALTUP_INPUTS,B,S,D], Tensor[B,KV_HEADS,S,HEAD_DIM], Tensor[B,KV_HEADS,S,HEAD_DIM])
gemma3n_layer path streams per_layer_input shared_k shared_v use_shared rope_sin rope_cos mask sparse = do
  predictions <- gemma3n_altup_predict @@'{path}.altup' streams
  active <- Tensor.slice predictions dim=0 start=0 end=1 |> Tensor.reshape shape=[B,S,D]
  active_norm <- gemma3n_rms @@'{path}.input_layernorm' active
  laurel <- gemma3n_laurel @@'{path}.laurel' active_norm
  attn, k, v <- gemma3n_attention @@'{path}.self_attn' active_norm shared_k shared_v use_shared rope_sin rope_cos mask
  attn <- gemma3n_rms @@'{path}.post_attention_layernorm' attn
  attn_laurel <- (active + attn + laurel) * ATTN_LAUREL_SCALE
  ff_in <- gemma3n_rms @@'{path}.pre_feedforward_layernorm' attn_laurel
  ff <- gemma3n_mlp @@'{path}.mlp' ff_in sparse
  ff <- gemma3n_rms @@'{path}.post_feedforward_layernorm' ff
  activated <- attn_laurel + ff
  corrected <- gemma3n_altup_correct @@'{path}.altup' predictions activated
  first <- Tensor.slice corrected dim=0 start=0 end=1 |> Tensor.reshape shape=[B,S,D]
  scale <- param path=@@'{path}.altup.correct_output_scale'
  first <- first * scale
  first <- NN.linear path first dim=PER_LAYER_DIM bias=false weight_path=@@'{path}.per_layer_input_gate.weight'
  first <- gelu_pytorch_tanh first |> mul per_layer_input
  first <- NN.linear path first dim=MODEL_DIM bias=false weight_path=@@'{path}.per_layer_projection.weight'
  first <- gemma3n_rms @@'{path}.post_per_layer_input_norm' first
  active_zero <- Tensor.zeros first shape=[1,B,S,D]
  rest_delta <- Tensor.unsqueeze first dim=0 |> Tensor.expand shape=[ALTUP_INPUTS - 1,B,S,D]
  delta <- Tensor.concat active_zero rest_delta dim=0
  return corrected + delta, k, v

gemma3n_text :: TokenIds[B,S] -> ?Mask[B,S,MAX_POSITIONS] -> ?Any -> ?Bool -> (Tensor[B,S,VOCAB_SIZE], ?Any)
gemma3n_text input_ids attn_mask past_kv use_cache = do
  attn_mask <- mask_for_input input_ids attn_mask MAX_POSITIONS
  pos_ids <- position_ids input_ids attn_mask=attn_mask past_length=0
  local_mask <- causal_mask_for_input input_ids S padding_mask=attn_mask window=SLIDING_WINDOW
  full_mask <- causal_mask_for_input input_ids S padding_mask=attn_mask window=MAX_POSITIONS
  local_sin, local_cos <- rope_base_factors pos_ids HEAD_DIM theta=THETA_LOCAL interleaved=false
  full_sin, full_cos <- rope_base_factors pos_ids HEAD_DIM theta=THETA_FULL interleaved=false

  x <- NN.embedding@@model.embed_tokens input_ids dim=MODEL_DIM
  x <- x * EMBED_SCALE
  layer_embed <- NN.embedding@@model.embed_tokens_per_layer input_ids dim=(NUM_LAYERS * PER_LAYER_DIM)
  layer_embed <- layer_embed * LAYER_EMBED_SCALE
  layer_embed <- Tensor.reshape layer_embed shape=[B,S,NUM_LAYERS,PER_LAYER_DIM]
  layer_projected <- NN.linear@@model.per_layer_model_projection x dim=(NUM_LAYERS * PER_LAYER_DIM) bias=false
  layer_projected <- layer_projected * MODEL_PROJECTION_SCALE
  layer_projected <- Tensor.reshape layer_projected shape=[B,S,NUM_LAYERS,PER_LAYER_DIM]
  layer_projected <- gemma3n_rms @@model.per_layer_projection_norm layer_projected
  per_layer <- (layer_embed + layer_projected) * LAYER_INPUT_SCALE

  target <- x
  streams <- Tensor.zeros x shape=[ALTUP_INPUTS,B,S,MODEL_DIM]
  streams <- Tensor.assign_slice streams (Tensor.unsqueeze x dim=0) dim=0 start=0 end=1
  streams <- for a <- [0..ALTUP_INPUTS - 1) carry (streams) do
    projected <- NN.linear @@'model.altup_projections.{a}' x dim=MODEL_DIM bias=false
    projected <- gemma3n_match_magnitude projected target
    streams <- Tensor.assign_slice streams (Tensor.unsqueeze projected dim=0) dim=0 start=(a + 1) end=(a + 2)
    yield streams

  local_k <- Tensor.zeros x shape=[B,KV_HEADS,S,HEAD_DIM]
  local_v <- Tensor.zeros x shape=[B,KV_HEADS,S,HEAD_DIM]
  full_k <- Tensor.zeros x shape=[B,KV_HEADS,S,HEAD_DIM]
  full_v <- Tensor.zeros x shape=[B,KV_HEADS,S,HEAD_DIM]
  streams, local_k, local_v, full_k, full_v <- for i <- [0..NUM_LAYERS) carry (streams, local_k, local_v, full_k, full_v) do
    full <- ((i + 1) % 5) == 0
    shared <- i >= SHARED_START
    source_k <- full ? full_k : local_k
    source_v <- full ? full_v : local_v
    rope_sin <- full ? full_sin : local_sin
    rope_cos <- full ? full_cos : local_cos
    mask <- full ? full_mask : local_mask
    layer_input <- Tensor.slice per_layer dim=2 start=i end=(i + 1) |> Tensor.reshape shape=[B,S,PER_LAYER_DIM]
    sparse <- (NUM_LAYERS > 10) and (i < 10)
    streams, k, v <- gemma3n_layer @@'model.layers.{i}' streams layer_input source_k source_v shared rope_sin rope_cos mask sparse
    local_k <- ((full == false) and (shared == false)) ? k : local_k
    local_v <- ((full == false) and (shared == false)) ? v : local_v
    full_k <- (full and (shared == false)) ? k : full_k
    full_v <- (full and (shared == false)) ? v : full_v
    yield streams, local_k, local_v, full_k, full_v

  active <- Tensor.slice streams dim=0 start=0 end=1 |> Tensor.reshape shape=[B,S,MODEL_DIM]
  total <- active
  total <- for a <- [0..ALTUP_INPUTS - 1) carry (total) do
    stream <- Tensor.slice streams dim=0 start=(a + 1) end=(a + 2) |> Tensor.reshape shape=[B,S,MODEL_DIM]
    projected <- NN.linear @@'model.altup_unembed_projections.{a}' stream dim=MODEL_DIM bias=false
    projected <- gemma3n_match_magnitude projected active
    yield total + projected
  x <- gemma3n_rms @@model.norm (total / ALTUP_INPUTS)
  logits <- HAS_LM_HEAD ? (NN.linear@@lm_head x dim=VOCAB_SIZE bias=false) : (NN.linear@@model.embed_tokens x dim=VOCAB_SIZE bias=false)
  logits <- tanh (logits / LOGIT_CAP) * LOGIT_CAP
  return logits, null
