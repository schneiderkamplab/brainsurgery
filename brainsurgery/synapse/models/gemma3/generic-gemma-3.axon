{-# CHECKPOINTS ["google/gemma-3-270m", "google/gemma-3-270m-it", "google/gemma-3-1b-pt", "google/gemma-3-1b-it", "google/gemma-3-4b-pt", "google/gemma-3-4b-it", "google/gemma-3-12b-pt", "google/gemma-3-12b-it", "google/gemma-3-27b-pt", "google/gemma-3-27b-it"] #-}

import Activations (gelu_pytorch_tanh)
import Attention (attention, merge_heads, reshape_heads)
import Masking (causal_mask)
import Math (mul, sqrt)
import Params has_root
import Positions (position_ids, rope_pair_base)
import Cache
import Config
import NN
import Tensor



-- `CFG` selects where textual model settings live in config.json:
-- - Gemma 3 text-only configs: root keys (CFG = "")
-- - Gemma 3 multimodal-ish layouts: under `text_config` (CFG = "text_config")
CFG = (Config.has_key@text_config) ? "text_config" : ""

-- Parameter root for checkpoint key lookup.
-- Some checkpoints namespace everything under `language_model.*`.
-- Gemma 3 uses either `_sliding_window_pattern` or `sliding_window_pattern`
-- depending on checkpoint/config exporter version.
ROPE_PERIOD_KEY = (Config.has_key @'{CFG}._sliding_window_pattern') ? "_sliding_window_pattern" : "sliding_window_pattern"

MODEL_DIM = Config.int @'{CFG}.hidden_size' default=640
VOCAB_SIZE = Config.int @'{CFG}.vocab_size' default=262208
NUM_LAYERS = Config.int @'{CFG}.num_hidden_layers' default=18
NUM_HEADS = Config.int @'{CFG}.num_attention_heads' default=8
KVH = Config.int @'{CFG}.num_key_value_heads' default=4
MODEL_HEAD_DIM = Config.int @'{CFG}.head_dim' default=256
FFN = Config.int @'{CFG}.intermediate_size' default=2048
ROPE_PERIOD = Config.int @'{CFG}.{ROPE_PERIOD_KEY}' default=6
THETA_BASE = Config.float @'{CFG}.rope_local_base_freq' default=10000.0
THETA_LONG = Config.float @'{CFG}.rope_theta' default=1000000.0
ROPE_LONG_SCALE = Config.float @'{CFG}.rope_scaling.factor' default=1.0
WIN_LOCAL = Config.int @'{CFG}.sliding_window' default=512
WIN_LONG = Config.int @'{CFG}.max_position_embeddings' default=131072
ATTN_SCALE = 1.0 / sqrt (Config.float @'{CFG}.query_pre_attn_scalar' default=256.0)
EMB_SCALE = sqrt MODEL_DIM
HAS_MODEL_LM_MODEL = has_root "model.language_model.model"
HAS_LM_MODEL = has_root "language_model.model"
PARAM_ROOT = HAS_MODEL_LM_MODEL ? "model.language_model" : (HAS_LM_MODEL ? "language_model" : "")

gemma3_block :: Tensor -> Int -> IdxTensor -> ?Tensor -> ?CacheLayer -> (Tensor, ?CacheLayer)
gemma3_block x i pos_ids attn_mask past_kv = do
  xn <- NN.rmsnorm@input_layernorm x cast_float=true unit_offset=true
  a, new_kv <- scope@self_attn do
    q <- NN.linear@q_proj xn dim=(NUM_HEADS * MODEL_HEAD_DIM) |> reshape_heads heads=NUM_HEADS |> NN.rmsnorm@q_norm cast_float=true unit_offset=true
    k <- NN.linear@k_proj xn dim=(KVH * MODEL_HEAD_DIM) |> reshape_heads heads=KVH |> NN.rmsnorm@k_norm cast_float=true unit_offset=true
    v <- NN.linear@v_proj xn dim=(KVH * MODEL_HEAD_DIM) |> reshape_heads heads=KVH
    long <- ((i + 1) % ROPE_PERIOD) == 0
    theta <- long ? THETA_LONG : THETA_BASE
    rope_scale <- long ? ROPE_LONG_SCALE : 1.0
    q, k <- rope_pair_base q k pos_ids theta scale_factor=rope_scale
    k, v, new_kv <- Cache.update past_kv k v
    k <- Tensor.repeat k repeats=(NUM_HEADS / KVH)
    v <- Tensor.repeat v repeats=(NUM_HEADS / KVH)
    window <- ((i + 1) % ROPE_PERIOD) == 0 ? WIN_LONG : WIN_LOCAL
    mask <- causal_mask q k window=window padding_mask=attn_mask
    a <- attention q k v mask scale=ATTN_SCALE |> merge_heads |> NN.linear@o_proj dim=MODEL_DIM
    return a, new_kv
  a <- NN.rmsnorm@post_attention_layernorm a cast_float=true unit_offset=true
  x <- x + a
  xn <- NN.rmsnorm@pre_feedforward_layernorm x cast_float=true unit_offset=true
  m <- scope@mlp do
    g <- NN.linear@gate_proj xn dim=FFN
    u <- NN.linear@up_proj xn dim=FFN
    return gelu_pytorch_tanh g |> mul u |> NN.linear@down_proj dim=MODEL_DIM
  m <- NN.rmsnorm@post_feedforward_layernorm m cast_float=true unit_offset=true
  return x + m, new_kv

gemma3 :: TokenIds[B,S] -> ?Tensor[B,S] -> ?Cache -> ?Bool -> (Tensor[B,S,V], ?Cache)
gemma3 input_ids attn_mask past_kv use_cache = do
  pos_ids <- position_ids input_ids attn_mask=attn_mask past_length=(Cache.past_length past_kv)
  logits, new_kv <- scope@'{PARAM_ROOT}.model' do
    x <- NN.embedding@embed_tokens input_ids dim=MODEL_DIM scale=EMB_SCALE
    new_kv <- use_cache ? Cache.init : null
    x, new_kv <- for@layers i <- [0..NUM_LAYERS) carry (x, new_kv) do
      past_i <- Cache.index past_kv i
      x, new_i <- gemma3_block x i pos_ids attn_mask past_i
      new_kv <- Cache.append new_kv new_i
      yield x, new_kv
    logits <- NN.rmsnorm@norm x cast_float=true unit_offset=true |> NN.linear@embed_tokens
    return logits, new_kv
  return logits, new_kv
