{-# CHECKPOINTS ["google/gemma-3-270m", "google/gemma-3-270m-it", "google/gemma-3-1b-pt", "google/gemma-3-1b-it", "google/gemma-3-4b-pt", "google/gemma-3-4b-it", "google/gemma-3-12b-pt", "google/gemma-3-12b-it", "google/gemma-3-27b-pt", "google/gemma-3-27b-it"] #-}

import Activations (gelu_pytorch_tanh)
import Cache
import Cache
import Config
import Params
import Attention (reshape_heads, merge_heads)
import Attention (attention_masked)
import Masking (causal_mask)
import Positions (position_ids, rope_pair_base)
import Math (mul, sqrt)

-- `CFG` selects where textual model settings live in config.json:
-- - Gemma 3 text-only configs: root keys (CFG = "")
-- - Gemma 3 multimodal-ish layouts: under `text_config` (CFG = "text_config")
CFG = (Config.has_key "text_config") ? "text_config" : ""

-- Parameter root for checkpoint key lookup.
-- Some checkpoints namespace everything under `language_model.*`.
PARAM_ROOT = (Params.has_root "language_model") ? "language_model" : ""

-- Gemma 3 uses either `_sliding_window_pattern` or `sliding_window_pattern`
-- depending on checkpoint/config exporter version.
ROPE_PERIOD_KEY = (Config.has_key "_sliding_window_pattern" root=CFG) ? "_sliding_window_pattern" : "sliding_window_pattern"

D = Config.int "hidden_size" root=CFG default=640
V = Config.int "vocab_size" root=CFG default=262208
L = Config.int "num_hidden_layers" root=CFG default=18
H = Config.int "num_attention_heads" root=CFG default=8
KVH = Config.int "num_key_value_heads" root=CFG default=4
HD = Config.int "head_dim" root=CFG default=256
FFN = Config.int "intermediate_size" root=CFG default=2048
ROPE_PERIOD = Config.int ROPE_PERIOD_KEY root=CFG default=6
THETA_BASE = Config.float "rope_local_base_freq" root=CFG default=10000.0
THETA_LONG = Config.float "rope_theta" root=CFG default=1000000.0
ROPE_LONG_SCALE = Config.float "rope_scaling.factor" root=CFG default=1.0
WIN_LOCAL = Config.int "sliding_window" root=CFG default=512
WIN_LONG = Config.int "max_position_embeddings" root=CFG default=131072
ATTN_SCALE = 1.0 / sqrt (Config.float "query_pre_attn_scalar" root=CFG default=256.0)
EMB_SCALE = sqrt D

gemma3_block :: Tensor -> Int -> IdxTensor -> ?Tensor -> ?CacheLayer -> (Tensor, ?CacheLayer)
gemma3_block x i pos_ids attn_mask past_kv = do
  xn <- NN.rmsnorm@input_layernorm x cast_float=true unit_offset=true
  a, new_kv <- scope@self_attn do
    q <- NN.linear@q_proj xn dim=(H * HD) |> reshape_heads heads=H |> NN.rmsnorm@q_norm cast_float=true unit_offset=true
    k <- NN.linear@k_proj xn dim=(KVH * HD) |> reshape_heads heads=KVH |> NN.rmsnorm@k_norm cast_float=true unit_offset=true
    v <- NN.linear@v_proj xn dim=(KVH * HD) |> reshape_heads heads=KVH
    long <- ((i + 1) % ROPE_PERIOD) == 0
    theta <- long ? THETA_LONG : THETA_BASE
    rope_scale <- long ? ROPE_LONG_SCALE : 1.0
    q, k <- rope_pair_base q k pos_ids theta scale_factor=rope_scale
    k, v, new_kv <- Cache.update past_kv k v
    k <- Tensor.repeat k repeats=(H / KVH)
    v <- Tensor.repeat v repeats=(H / KVH)
    window <- ((i + 1) % ROPE_PERIOD) == 0 ? WIN_LONG : WIN_LOCAL
    mask <- causal_mask q k window=window padding_mask=attn_mask
    a <- attention_masked q k v mask=mask scale=ATTN_SCALE |> merge_heads |> NN.linear@o_proj dim=D
    return a, new_kv
  a <- NN.rmsnorm@post_attention_layernorm a cast_float=true unit_offset=true
  x <- x + a
  xn <- NN.rmsnorm@pre_feedforward_layernorm x cast_float=true unit_offset=true
  m <- scope@mlp do
    g <- NN.linear@gate_proj xn dim=FFN
    u <- NN.linear@up_proj xn dim=FFN
    return gelu_pytorch_tanh g |> mul u |> NN.linear@down_proj dim=D
  m <- NN.rmsnorm@post_feedforward_layernorm m cast_float=true unit_offset=true
  return x + m, new_kv

gemma3 :: TokenIds[B,S] -> ?Tensor[B,S] -> ?Cache -> ?Bool -> (Tensor[B,S,V], ?Cache)
gemma3 input_ids attn_mask past_kv use_cache = do
  pos_ids <- position_ids input_ids attn_mask=attn_mask past_length=(Cache.past_length past_kv)
  logits, new_kv <- scope@model root=PARAM_ROOT do
    x <- NN.embedding@embed_tokens input_ids dim=D scale=EMB_SCALE
    new_kv <- use_cache ? Cache.init : null
    for@layers i <- [0..L) do
      past_i <- Cache.index past_kv i
      x, new_i <- gemma3_block x i pos_ids attn_mask past_i
      new_kv <- Cache.append new_kv new_i
    logits <- NN.rmsnorm@norm x cast_float=true unit_offset=true |> NN.linear@embed_tokens
    return logits, new_kv
  return logits, new_kv
