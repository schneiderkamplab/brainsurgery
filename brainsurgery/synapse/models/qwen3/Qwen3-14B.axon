{-# CHECKPOINTS "Qwen/Qwen3-14B" #-}
{-# TASK "causal_lm" #-}

import Activations
import Activations (silu)
import Attention
import Attention (attention, merge_heads, reshape_heads)
import Masking
import Masking (causal_mask)
import Math
import Math (mul)
import Positions
import Positions (position_ids, rope_pair_base)
import Cache
import NN
import Tensor

rms :: Path -> Tensor[B,S,D] -> Tensor[B,S,D]
rms@path x = NN.rmsnorm@path x eps=1e-06 cast_float=true

head_rms :: Path -> Tensor[B,H,S,HD] -> Tensor[B,H,S,HD]
head_rms@path x = NN.rmsnorm@path x eps=1e-06 cast_float=true

output_tied :: Tensor[B,S,D] -> Tensor[B,S,V]
output_tied x = do
  logits <- scope@model do
    return NN.linear@embed_tokens x dim=151936
  return logits

output_untied :: Tensor[B,S,D] -> Tensor[B,S,V]
output_untied x = NN.linear@lm_head x dim=151936

qwen3_block :: Tensor[B,S,D] -> Tensor[B,S] -> ?Tensor[B,S] -> ?CacheLayer -> (Tensor[B,S,D], ?CacheLayer)
qwen3_block x pos_ids attn_mask past_kv = do
  xn <- rms@input_layernorm x
  a, new_kv <- scope@self_attn do
    q <- NN.linear@q_proj xn dim=5120 bias=false |> reshape_heads heads=40 |> head_rms@q_norm
    k <- NN.linear@k_proj xn dim=1024 bias=false |> reshape_heads heads=8 |> head_rms@k_norm
    v <- NN.linear@v_proj xn dim=1024 bias=false |> reshape_heads heads=8
    q, k <- rope_pair_base q k pos_ids 1000000.0
    k, v, new_kv <- Cache.update past_kv k v
    k <- Tensor.repeat k repeats=5
    v <- Tensor.repeat v repeats=5
    mask <- causal_mask q k window=40960 padding_mask=attn_mask
    a <- attention q k v mask |> merge_heads |> NN.linear@o_proj dim=5120 bias=false
    return a, new_kv
  x <- x + a
  xn <- rms@post_attention_layernorm x
  m <- scope@mlp do
    g <- NN.linear@gate_proj xn dim=17408
    u <- NN.linear@up_proj xn dim=17408
    return g |> silu |> mul u |> NN.linear@down_proj dim=5120
  return x + m, new_kv

qwen3 :: TokenIds[B,S] -> ?Tensor[B,S] -> ?Cache -> ?Bool -> (Tensor[B,S,V], ?Cache)
qwen3 input_ids attn_mask past_kv use_cache = do
  pos_ids <- position_ids input_ids attn_mask=attn_mask past_length=(Cache.past_length past_kv)
  x, new_kv <- scope@model do
    x <- NN.embedding@embed_tokens input_ids dim=5120
    new_kv <- use_cache ? Cache.init : null
    for@layers i <- [0..40) do
      past_i <- Cache.index past_kv i
      x, new_i <- qwen3_block x pos_ids attn_mask past_i
      new_kv <- Cache.append new_kv new_i
      yield x, new_kv
    x <- rms@norm x
    return x, new_kv
  logits <- output_untied x
  return logits, new_kv
