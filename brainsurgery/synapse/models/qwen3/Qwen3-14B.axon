{-# CHECKPOINTS "Qwen/Qwen3-14B" #-}
{-# TASK "causal_lm" #-}

import Activations
import Activations (silu)
import Cache
import Cache
import Attention (reshape_heads, merge_heads)
import Compat (attention)
import Masking (causal_mask)
import Positions (position_ids, rope_pair_base)
import Math (mul)

D = 5120
V = 151936
L = 40
H = 40
KVH = 8
KVD = 1024
QD = 5120
FFN = 17408
EPS = 1e-06
THETA = 1000000.0
C = 40960
TIE = false

rms :: @Path -> Tensor[B,S,D] -> Tensor[B,S,D]
rms@path x = NN.rmsnorm@path x eps=EPS cast_float=true

head_rms :: @Path -> Tensor[B,H,S,HD] -> Tensor[B,H,S,HD]
head_rms@path x = NN.rmsnorm@path x eps=EPS cast_float=true

output_tied :: Tensor[B,S,D] -> Tensor[B,S,V]
output_tied x = do
  logits <- scope@model do
    return NN.linear@embed_tokens x dim=V
  return logits

output_untied :: Tensor[B,S,D] -> Tensor[B,S,V]
output_untied x = NN.linear@lm_head x dim=V

qwen3_block :: Tensor[B,S,D] -> Tensor[B,S] -> ?Tensor[B,S] -> ?CacheLayer -> (Tensor[B,S,D], ?CacheLayer)
qwen3_block x pos_ids attn_mask past_kv = do
  xn <- rms@input_layernorm x
  a, new_kv <- scope@self_attn do
    q <- NN.linear@q_proj xn dim=QD bias=false |> reshape_heads heads=H |> head_rms@q_norm
    k <- NN.linear@k_proj xn dim=KVD bias=false |> reshape_heads heads=KVH |> head_rms@k_norm
    v <- NN.linear@v_proj xn dim=KVD bias=false |> reshape_heads heads=KVH
    q, k <- rope_pair_base q k pos_ids THETA
    k, v, new_kv <- Cache.update past_kv k v
    k <- Tensor.repeat k repeats=(H / KVH)
    v <- Tensor.repeat v repeats=(H / KVH)
    mask <- causal_mask q k window=C padding_mask=attn_mask
    a <- attention q k v mask=mask |> merge_heads |> NN.linear@o_proj dim=D bias=false
    return a, new_kv
  x <- x + a
  xn <- rms@post_attention_layernorm x
  m <- scope@mlp do
    g <- NN.linear@gate_proj xn dim=FFN
    u <- NN.linear@up_proj xn dim=FFN
    return g |> silu |> mul u |> NN.linear@down_proj dim=D
  return x + m, new_kv

qwen3 :: TokenIds[B,S] -> ?Tensor[B,S] -> ?Cache -> ?Bool -> (Tensor[B,S,V], ?Cache)
qwen3 input_ids attn_mask past_kv use_cache = do
  pos_ids <- position_ids input_ids attn_mask=attn_mask past_length=(Cache.past_length past_kv)
  x, new_kv <- scope@model do
    x <- NN.embedding@embed_tokens input_ids dim=D
    new_kv <- use_cache ? Cache.init : null
    for@layers i <- [0..L) do
      past_i <- Cache.index past_kv i
      x, new_i <- qwen3_block x pos_ids attn_mask past_i
      new_kv <- Cache.append new_kv new_i
    x <- rms@norm x
    return x, new_kv
  logits <- TIE ? output_tied x : output_untied x
  return logits, new_kv
