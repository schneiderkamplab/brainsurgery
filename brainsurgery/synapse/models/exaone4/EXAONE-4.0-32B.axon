{-# CHECKPOINTS "LGAI-EXAONE/EXAONE-4.0-32B" #-}
{-# TASK "causal_lm" #-}

import Activations
import Activations (silu)
import Attention
import Attention (attention, merge_heads, reshape_heads)
import Masking
import Masking (causal_mask)
import Math
import Math (mul)
import Params
import Params (has_root)
import Positions
import Positions (position_ids, rope_pair_freq_scale)

HAS_LM_HEAD = has_root "lm_head"

exaone4_rms :: Path -> Tensor -> Tensor
exaone4_rms@path x = NN.rmsnorm@path x eps=1e-05

exaone4_block :: Int -> Tensor[B,S,D] -> Tensor[B,S] -> ?Tensor[B,S] -> ?CacheLayer -> (Tensor[B,S,D], ?CacheLayer)
exaone4_block i x pos_ids attn_mask past_kv = do
  apply_rope <- (((i + 1) % 4) != 0)
  sliding <- (((i + 1) % 4) != 0)
  a, new_kv <- scope@self_attn do
    q <- NN.linear@q_proj x dim=5120 bias=false |> reshape_heads heads=40 |> exaone4_rms@q_norm
    k <- NN.linear@k_proj x dim=1024 bias=false |> reshape_heads heads=8 |> exaone4_rms@k_norm
    v <- NN.linear@v_proj x dim=1024 bias=false |> reshape_heads heads=8
    q, k <- apply_rope ? (rope_pair_freq_scale q k pos_ids 1000000.0 16.0 1.0 4.0 8192) : (q, k)
    k, v, new_kv <- Cache.update past_kv k v
    k <- Tensor.repeat k repeats=5
    v <- Tensor.repeat v repeats=5
    window <- sliding ? 4096 : 131072
    mask <- causal_mask q k window=window padding_mask=attn_mask
    a <- attention q k v mask |> merge_heads |> NN.linear@o_proj dim=5120 bias=false
    return a, new_kv
  a <- exaone4_rms@post_attention_layernorm a
  x <- x + a
  m <- scope@mlp do
    g <- NN.linear@gate_proj x dim=27392 bias=false
    u <- NN.linear@up_proj x dim=27392 bias=false
    return g |> silu |> mul u |> NN.linear@down_proj dim=5120 bias=false
  m <- exaone4_rms@post_feedforward_layernorm m
  return x + m, new_kv

exaone4 :: TokenIds[B,S] -> ?Tensor[B,S] -> ?Cache -> ?Bool -> (Tensor[B,S,V], ?Cache)
exaone4 input_ids attn_mask past_kv use_cache = do
  pos_ids <- position_ids input_ids past_length=(Cache.past_length past_kv)
  x, new_kv <- scope@model do
    x <- NN.embedding@embed_tokens input_ids dim=5120
    new_kv <- use_cache ? Cache.init : null
    for@layers i <- [0..64) do
      past_i <- Cache.index past_kv i
      x, new_i <- exaone4_block i x pos_ids attn_mask past_i
      new_kv <- Cache.append new_kv new_i
      yield x, new_kv
    x <- exaone4_rms@norm x
    return x, new_kv
  logits <- HAS_LM_HEAD ? (NN.linear@lm_head x dim=102400) : (NN.linear@model.embed_tokens x dim=102400)
  return logits, new_kv
