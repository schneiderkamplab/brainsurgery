{-# CHECKPOINTS "LGAI-EXAONE/EXAONE-4.0-32B" #-}

{-# TASK "causal_lm" #-}

{-# MAIN "exaone4" #-}

import Activations (silu)

import Attention (attention, merge_heads, reshape_heads)

import Masking (causal_mask)

import Math (mul)

import Params (has_root)

import Positions (position_ids, rope_pair_freq_scale)

import Cache

import Config

import NN

import Tensor

MODEL_DIM = 5120

VOCAB_SIZE = 102400

NUM_LAYERS = 64

NUM_HEADS = 40

KVH = 8

MODEL_HEAD_DIM = 128

KVD = KVH * MODEL_HEAD_DIM

FFN = 27392

EPS = 1e-05

THETA = 1000000.0

ROPE_SCALE = 16.0

ROPE_LOW_FREQ = 1.0

ROPE_HIGH_FREQ = 4.0

ROPE_CONTEXT = 8192

MAX_POSITIONS = 131072

IS_32B = MODEL_DIM == 5120

HAS_LLLG = IS_32B

HAS_LM_HEAD = has_root "lm_head"

exaone4_rms :: Path -> Tensor[..S] -> Tensor[..S]
exaone4_rms@path x = NN.rmsnorm@path x eps=EPS

exaone4_block :: Int -> Tensor[B,S,D] -> Tensor[B,S] -> ?Tensor[B,K] -> ?CacheLayer[B,KVH,P,DH] -> (Tensor[B,S,D], ?CacheLayer[B,KVH,K,DH])
exaone4_block i x pos_ids attn_mask past_kv = do
  apply_rope <- HAS_LLLG ? (((i + 1) % 4) != 0) : true
  sliding <- HAS_LLLG ? (((i + 1) % 4) != 0) : false
  a, new_kv <- scope@self_attn do
    q <- NN.linear@q_proj x dim=MODEL_DIM bias=false |> reshape_heads heads=NUM_HEADS |> exaone4_rms@q_norm
    k <- NN.linear@k_proj x dim=KVD bias=false |> reshape_heads heads=KVH |> exaone4_rms@k_norm
    v <- NN.linear@v_proj x dim=KVD bias=false |> reshape_heads heads=KVH
    q, k <- apply_rope ? (rope_pair_freq_scale q k pos_ids THETA ROPE_SCALE ROPE_LOW_FREQ ROPE_HIGH_FREQ ROPE_CONTEXT) : (q, k)
    k, v, new_kv <- Cache.update past_kv k v
    k <- Tensor.repeat k repeats=(NUM_HEADS / KVH)
    v <- Tensor.repeat v repeats=(NUM_HEADS / KVH)
    window <- sliding ? 4096 : MAX_POSITIONS
    mask <- causal_mask q k window=window padding_mask=attn_mask
    a <- attention q k v mask |> merge_heads |> NN.linear@o_proj dim=MODEL_DIM bias=false
    return a, new_kv
  a <- exaone4_rms@post_attention_layernorm a
  x <- x + a
  m <- scope@mlp do
    g <- NN.linear@gate_proj x dim=FFN bias=false
    u <- NN.linear@up_proj x dim=FFN bias=false
    return g |> silu |> mul u |> NN.linear@down_proj dim=MODEL_DIM bias=false
  m <- exaone4_rms@post_feedforward_layernorm m
  return x + m, new_kv

exaone4 :: TokenIds[B,S] -> ?Tensor[B,K] -> ?Cache[B,KVH,P,DH] -> ?Bool -> (Tensor[B,S,V], ?Cache[B,KVH,K,DH])
exaone4 input_ids attn_mask past_kv use_cache = do
  pos_ids <- position_ids input_ids past_length=(Cache.past_length past_kv)
  x, new_kv <- scope@model do
    x <- NN.embedding@embed_tokens input_ids dim=MODEL_DIM
    new_kv <- use_cache ? Cache.init : null
    x, new_kv <- for@layers i <- [0..NUM_LAYERS) carry (x, new_kv) do
      past_i <- Cache.index past_kv i
      x, new_i <- exaone4_block i x pos_ids attn_mask past_i
      new_kv <- Cache.append new_kv new_i
      yield x, new_kv
    x <- exaone4_rms@norm x
    return x, new_kv
  logits <- HAS_LM_HEAD ? (NN.linear@lm_head x dim=VOCAB_SIZE) : (NN.linear@model.embed_tokens x dim=VOCAB_SIZE)
  return logits, new_kv
