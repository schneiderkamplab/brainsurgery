{-# CHECKPOINTS ["LGAI-EXAONE/EXAONE-4.0-1.2B", "LGAI-EXAONE/EXAONE-4.0-32B"] #-}
{-# TASK "causal_lm" #-}

import Config
import Params
import Activations silu
import Cache
import Cache past_length

D = Config.int "hidden_size" default=2048
V = Config.int "vocab_size" default=102400
L = Config.int "num_hidden_layers" default=30
H = Config.int "num_attention_heads" default=32
KVH = Config.int "num_key_value_heads" default=8
HD = Config.int "head_dim" default=64
KVD = KVH * HD
FFN = Config.int "intermediate_size" default=4096
EPS = Config.float "rms_norm_eps" default=1e-05
THETA = Config.float "rope_theta" root="rope_parameters" default=(Config.float "rope_theta" default=10000.0)
ROPE_SCALE = Config.float "rope_scaling.factor" default=(Config.float "factor" root="rope_parameters" default=1.0)
ROPE_LOW_FREQ = Config.float "rope_scaling.low_freq_factor" default=(Config.float "low_freq_factor" root="rope_parameters" default=1.0)
ROPE_HIGH_FREQ = Config.float "rope_scaling.high_freq_factor" default=(Config.float "high_freq_factor" root="rope_parameters" default=1.0)
ROPE_CONTEXT = Config.int "rope_scaling.original_max_position_embeddings" default=(Config.int "original_max_position_embeddings" root="rope_parameters" default=8192)
C = Config.int "max_position_embeddings" default=65536
IS_32B = D == 5120
HAS_LLLG = IS_32B
HAS_LM_HEAD = Params.has_root "lm_head"

exaone4_rms :: @Path -> Tensor -> Tensor
exaone4_rms@path x = rmsnorm@path x eps=EPS

exaone4_block :: Int -> Tensor[B,S,D] -> Tensor[B,S] -> ?Tensor[B,S] -> ?CacheLayer -> (Tensor[B,S,D], ?CacheLayer)
exaone4_block i x pos_ids attn_mask past_kv = do
  apply_rope <- HAS_LLLG ? (((i + 1) % 4) != 0) : true
  sliding <- HAS_LLLG ? (((i + 1) % 4) != 0) : false
  a, new_kv <- scope@self_attn do
    q <- linear@q_proj x dim=D bias=false |> reshape_heads heads=H |> exaone4_rms@q_norm
    k <- linear@k_proj x dim=KVD bias=false |> reshape_heads heads=KVH |> exaone4_rms@k_norm
    v <- linear@v_proj x dim=KVD bias=false |> reshape_heads heads=KVH
    q, k <- apply_rope ? (rope_pair_freq_scale q k pos_ids THETA ROPE_SCALE ROPE_LOW_FREQ ROPE_HIGH_FREQ ROPE_CONTEXT) : (q, k)
    k, v, new_kv <- Cache.update past_kv k v
    k <- repeat k repeats=(H / KVH)
    v <- repeat v repeats=(H / KVH)
    window <- sliding ? 4096 : C
    mask <- causal_mask q k window=window padding_mask=attn_mask
    a <- attention q k v mask=mask eager=true |> merge_heads |> linear@o_proj dim=D bias=false
    return a, new_kv
  a <- exaone4_rms@post_attention_layernorm a
  x <- x + a
  m <- scope@mlp do
    g <- linear@gate_proj x dim=FFN bias=false
    u <- linear@up_proj x dim=FFN bias=false
    return g |> silu |> mul u |> linear@down_proj dim=D bias=false
  m <- exaone4_rms@post_feedforward_layernorm m
  return x + m, new_kv

exaone4 :: TokenIds[B,S] -> ?Tensor[B,S] -> ?Cache -> ?Bool -> (Tensor[B,S,V], ?Cache)
exaone4 input_ids attn_mask past_kv use_cache = do
  pos_ids <- position_ids input_ids past_length=(past_length past_kv)
  x, new_kv <- scope@model do
    x <- embedding@embed_tokens input_ids dim=D
    new_kv <- use_cache ? Cache.init : null
    for@layers i <- [0..L) do
      past_i <- Cache.index past_kv i
      x, new_i <- exaone4_block i x pos_ids attn_mask past_i
      new_kv <- Cache.append new_kv new_i
    x <- exaone4_rms@norm x
    return x, new_kv
  logits <- HAS_LM_HEAD ? (linear@lm_head x dim=V) : (linear@model.embed_tokens x dim=V)
  return logits, new_kv
