{-# CHECKPOINTS ["LGAI-EXAONE/EXAONE-4.0-1.2B", "LGAI-EXAONE/EXAONE-4.0-32B"] #-}
{-# TASK "causal_lm" #-}

import Activations (silu)
import Attention (attention, merge_heads)
import Masking (Mask, causal_mask_for_input, mask_for_input, mask_length_for_input)
import Math (mul)
import Params (has_root)
import Positions (position_ids, rope_freq_scale_factors_for_position_ids, rope_pair_base_factors)
import Cache
import Config
import NN
import Tensor



MODEL_DIM <- Config.int @@hidden_size default=2048
VOCAB_SIZE <- Config.int @@vocab_size default=102400
NUM_LAYERS <- Config.int @@num_hidden_layers default=30
NUM_HEADS <- Config.int @@num_attention_heads default=32
KVH <- Config.int @@num_key_value_heads default=8
MODEL_HEAD_DIM <- Config.int @@head_dim default=64
KVD = KVH * MODEL_HEAD_DIM
FFN <- Config.int @@intermediate_size default=4096
EPS <- Config.float @@rms_norm_eps default=1e-05
THETA <- Config.float @@'rope_parameters.rope_theta' default=(Config.float @@rope_theta default=10000.0)
ROPE_SCALE <- Config.float @@'rope_scaling.factor' default=(Config.float @@'rope_parameters.factor' default=1.0)
ROPE_LOW_FREQ <- Config.float @@'rope_scaling.low_freq_factor' default=(Config.float @@'rope_parameters.low_freq_factor' default=1.0)
ROPE_HIGH_FREQ <- Config.float @@'rope_scaling.high_freq_factor' default=(Config.float @@'rope_parameters.high_freq_factor' default=1.0)
ROPE_CONTEXT <- Config.int @@'rope_scaling.original_max_position_embeddings' default=(Config.int @@'rope_parameters.original_max_position_embeddings' default=8192)
MAX_POSITIONS <- Config.int @@max_position_embeddings default=65536
IS_32B = MODEL_DIM == 5120
HAS_LLLG = IS_32B
HAS_LM_HEAD = has_root "lm_head"

exaone4_rms :: Path -> Tensor[..S] -> Tensor[..S]
exaone4_rms@path x = NN.rmsnorm@path x eps=EPS

exaone4_block :: Int -> Tensor[B,S,D] -> Tensor[B,1,S,R] -> Tensor[B,1,S,R] -> Tensor[B,1,S,K] -> Tensor[B,1,S,K] -> ?CacheLayer[B,KVH,P,MAX_POSITIONS,DH] -> (Tensor[B,S,D], ?CacheLayer[B,KVH,K,MAX_POSITIONS,DH])
exaone4_block i x rope_sin rope_cos mask_slide mask_full past_kv = do
  apply_rope <- HAS_LLLG ? (((i + 1) % 4) != 0) : true
  sliding <- HAS_LLLG ? (((i + 1) % 4) != 0) : false
  a, new_kv <- scope@self_attn do
    q <- NN.linear@q_proj x dim=MODEL_DIM bias=false
    q <- q |> Tensor.reshape shape=[B, S, NUM_HEADS, MODEL_HEAD_DIM] |> Tensor.permute dims=[0, 2, 1, 3] |> exaone4_rms@q_norm
    k <- NN.linear@k_proj x dim=KVD bias=false
    k <- k |> Tensor.reshape shape=[B, S, KVH, MODEL_HEAD_DIM] |> Tensor.permute dims=[0, 2, 1, 3] |> exaone4_rms@k_norm
    v <- NN.linear@v_proj x dim=KVD bias=false
    v <- v |> Tensor.reshape shape=[B, S, KVH, MODEL_HEAD_DIM] |> Tensor.permute dims=[0, 2, 1, 3]
    q, k <- apply_rope ? (rope_pair_base_factors q k rope_sin rope_cos) : (q, k)
    k, v, new_kv <- Cache.update past_kv k v
    k <- Tensor.repeat k repeats=(NUM_HEADS / KVH)
    v <- Tensor.repeat v repeats=(NUM_HEADS / KVH)
    mask <- sliding ? mask_slide : mask_full
    a <- attention q k v mask |> merge_heads |> NN.linear@o_proj dim=MODEL_DIM bias=false
    return a, new_kv
  a <- exaone4_rms@post_attention_layernorm a
  x <- x + a
  m <- scope@mlp do
    g <- NN.linear@gate_proj x dim=FFN bias=false
    u <- NN.linear@up_proj x dim=FFN bias=false
    return g |> silu |> mul u |> NN.linear@down_proj dim=MODEL_DIM bias=false
  m <- exaone4_rms@post_feedforward_layernorm m
  return x + m, new_kv

exaone4 :: TokenIds[B,S] -> ?Mask[B,K,MAX_POSITIONS] -> ?Cache[B,KVH,P,MAX_POSITIONS,DH] -> ?Bool -> (Tensor[B,S,V], ?Cache[B,KVH,K,MAX_POSITIONS,DH])
exaone4 input_ids attn_mask past_kv use_cache = do
  past_length <- Cache.past_length past_kv
  attn_mask <- mask_for_input input_ids attn_mask MAX_POSITIONS
  pos_ids <- position_ids input_ids past_length=past_length
  rope_sin, rope_cos <- ((rope_freq_scale_factors_for_position_ids pos_ids MODEL_HEAD_DIM THETA ROPE_SCALE ROPE_LOW_FREQ ROPE_HIGH_FREQ ROPE_CONTEXT) :: (Tensor[B,1,S,MODEL_HEAD_DIM], Tensor[B,1,S,MODEL_HEAD_DIM]))
  key_len <- mask_length_for_input input_ids attn_mask past_length
  mask_slide <- causal_mask_for_input input_ids key_len padding_mask=attn_mask window=4096
  mask_full <- causal_mask_for_input input_ids key_len padding_mask=attn_mask window=MAX_POSITIONS
  work_kv <- Cache.prepare past_kv use_cache MAX_POSITIONS
  read_kv <- Cache.read past_kv work_kv
  x, work_kv <- scope@model do
    x <- NN.embedding@embed_tokens input_ids dim=MODEL_DIM
    x, work_kv <- for@layers i <- [0..NUM_LAYERS) carry (x, work_kv) do
      past_i <- Cache.index read_kv i
      x, new_i <- exaone4_block i x rope_sin rope_cos mask_slide mask_full past_i
      work_kv <- Cache.append work_kv new_i
      yield x, work_kv
    x <- exaone4_rms@norm x
    return x, work_kv
  logits <- HAS_LM_HEAD ? (NN.linear@lm_head x dim=VOCAB_SIZE) : (NN.linear@model.embed_tokens x dim=VOCAB_SIZE)
  new_length <- past_length + S
  new_kv <- Cache.finish work_kv new_length
  new_kv <- use_cache ? new_kv : null
  return logits, new_kv
