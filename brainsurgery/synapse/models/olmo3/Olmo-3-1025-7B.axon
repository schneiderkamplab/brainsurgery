{-# CHECKPOINTS ["allenai/Olmo-3-1025-7B", "allenai/Olmo-3-7B-Instruct", "allenai/Olmo-3-7B-Think"] #-}
{-# TASK "causal_lm" #-}

import Activations
import Activations (silu)
import Cache
import Cache
import Attention (reshape_heads, merge_heads)
import Attention (attention_masked)
import Masking (causal_mask)
import Positions (position_ids, rope_pair_yarn)
import Math (mul)

D = 4096
V = 100278
L = 32
H = 32
KVH = 32
HD = 128
FFN = 11008
EPS = 1e-06
THETA = 500000.0
C = 65536
SW = 4096
FULL_ATTN_PERIOD = 4
ROPE_SCALE = 8.0
ROPE_BETA_FAST = 32.0
ROPE_BETA_SLOW = 1.0
ROPE_CONTEXT = 8192
ATTN_SCALE = 0.08838834764831843

olmo3_block :: Tensor[B,S,D] -> Int -> Tensor[B,S] -> ?Tensor[B,S] -> ?CacheLayer -> (Tensor[B,S,D], ?CacheLayer)
olmo3_block x i pos_ids attn_mask past_kv = do
  a, new_kv <- scope@self_attn do
    q <- NN.linear@q_proj x dim=(H * HD) |> NN.rmsnorm@q_norm eps=EPS cast_float=true |> reshape_heads heads=H
    k <- NN.linear@k_proj x dim=(KVH * HD) |> NN.rmsnorm@k_norm eps=EPS cast_float=true |> reshape_heads heads=KVH
    v <- NN.linear@v_proj x dim=(KVH * HD) |> reshape_heads heads=KVH
    q, k <- rope_pair_yarn q k pos_ids THETA ROPE_SCALE ROPE_BETA_FAST ROPE_BETA_SLOW ROPE_CONTEXT
    k, v, new_kv <- Cache.update past_kv k v
    k <- Tensor.repeat k repeats=(H / KVH)
    v <- Tensor.repeat v repeats=(H / KVH)
    window <- ((i + 1) % FULL_ATTN_PERIOD) == 0 ? C : SW
    mask <- causal_mask q k window=window padding_mask=attn_mask
    a <- attention_masked q k v mask=mask scale=ATTN_SCALE |> merge_heads |> NN.linear@o_proj dim=D
    return a, new_kv
  a <- NN.rmsnorm@post_attention_layernorm a eps=EPS cast_float=true
  x <- x + a
  m <- scope@mlp do
    g <- NN.linear@gate_proj x dim=FFN
    u <- NN.linear@up_proj x dim=FFN
    return g |> silu |> mul u |> NN.linear@down_proj dim=D
  m <- NN.rmsnorm@post_feedforward_layernorm m eps=EPS cast_float=true
  return x + m, new_kv

olmo3 :: TokenIds[B,S] -> ?Tensor[B,S] -> ?Cache -> ?Bool -> (Tensor[B,S,V], ?Cache)
olmo3 input_ids attn_mask past_kv use_cache = do
  pos_ids <- position_ids input_ids attn_mask=attn_mask past_length=(Cache.past_length past_kv)
  x, new_kv <- scope@model do
    x <- NN.embedding@embed_tokens input_ids dim=D
    new_kv <- use_cache ? Cache.init : null
    for@layers i <- [0..L) do
      past_i <- Cache.index past_kv i
      x, new_i <- olmo3_block x i pos_ids attn_mask past_i
      new_kv <- Cache.append new_kv new_i
    x <- NN.rmsnorm@norm x eps=EPS cast_float=true
    return x, new_kv
  logits <- NN.linear@lm_head x dim=V
  return logits, new_kv
