{-# CHECKPOINTS "allenai/Olmo-3-1125-32B" #-}
{-# TASK "causal_lm" #-}

import Activations
import Activations (silu)
import Attention
import Attention (attention, merge_heads, reshape_heads)
import Masking
import Masking (causal_mask)
import Math
import Math (mul)
import Positions
import Positions (position_ids, rope_pair_yarn)
import Cache
import NN
import Tensor

olmo3_block :: Tensor[B,S,D] -> Int -> Tensor[B,S] -> ?Tensor[B,S] -> ?CacheLayer -> (Tensor[B,S,D], ?CacheLayer)
olmo3_block x i pos_ids attn_mask past_kv = do
  a, new_kv <- scope@self_attn do
    q <- NN.linear@q_proj x dim=5120 |> NN.rmsnorm@q_norm eps=1e-06 cast_float=true |> reshape_heads heads=40
    k <- NN.linear@k_proj x dim=1024 |> NN.rmsnorm@k_norm eps=1e-06 cast_float=true |> reshape_heads heads=8
    v <- NN.linear@v_proj x dim=1024 |> reshape_heads heads=8
    q, k <- rope_pair_yarn q k pos_ids 500000.0 8.0 32.0 1.0 8192
    k, v, new_kv <- Cache.update past_kv k v
    k <- Tensor.repeat k repeats=5
    v <- Tensor.repeat v repeats=5
    window <- ((i + 1) % 4) == 0 ? 65536 : 4096
    mask <- causal_mask q k window=window padding_mask=attn_mask
    a <- attention q k v mask scale=0.08838834764831843 |> merge_heads |> NN.linear@o_proj dim=5120
    return a, new_kv
  a <- NN.rmsnorm@post_attention_layernorm a eps=1e-06 cast_float=true
  x <- x + a
  m <- scope@mlp do
    g <- NN.linear@gate_proj x dim=27648
    u <- NN.linear@up_proj x dim=27648
    return g |> silu |> mul u |> NN.linear@down_proj dim=5120
  m <- NN.rmsnorm@post_feedforward_layernorm m eps=1e-06 cast_float=true
  return x + m, new_kv

olmo3 :: TokenIds[B,S] -> ?Tensor[B,S] -> ?Cache -> ?Bool -> (Tensor[B,S,V], ?Cache)
olmo3 input_ids attn_mask past_kv use_cache = do
  pos_ids <- position_ids input_ids attn_mask=attn_mask past_length=(Cache.past_length past_kv)
  x, new_kv <- scope@model do
    x <- NN.embedding@embed_tokens input_ids dim=5120
    new_kv <- use_cache ? Cache.init : null
    for@layers i <- [0..64) do
      past_i <- Cache.index past_kv i
      x, new_i <- olmo3_block x i pos_ids attn_mask past_i
      new_kv <- Cache.append new_kv new_i
      yield x, new_kv
    x <- NN.rmsnorm@norm x eps=1e-06 cast_float=true
    return x, new_kv
  logits <- NN.linear@lm_head x dim=100278
  return logits, new_kv
