{-# CHECKPOINTS "allenai/Olmo-3-1125-32B" #-}

{-# TASK "causal_lm" #-}

{-# MAIN "olmo3" #-}

import Activations (silu)

import Attention (attention, merge_heads, reshape_heads)

import Masking (causal_mask)

import Math (mul, sqrt)

import Positions (position_ids, rope_pair_yarn)

import Cache

import Config

import NN

import Tensor

MODEL_DIM = 5120

VOCAB_SIZE = 100278

NUM_LAYERS = 64

NUM_HEADS = 40

KVH = 8

MODEL_HEAD_DIM = 128

FFN = 27648

EPS = 1e-06

THETA = 500000.0

MAX_POSITIONS = 65536

SW = 4096

FULL_ATTN_PERIOD = 4

ROPE_SCALE = 8.0

ROPE_BETA_FAST = 32.0

ROPE_BETA_SLOW = 1.0

ROPE_CONTEXT = 8192

ATTN_SCALE = 1.0 / sqrt MODEL_HEAD_DIM

olmo3_block :: Tensor[B,S,D] -> Int -> Tensor[B,S] -> ?Tensor[B,K] -> ?CacheLayer[B,KVH,P,DH] -> (Tensor[B,S,D], ?CacheLayer[B,KVH,K,DH])
olmo3_block x i pos_ids attn_mask past_kv = do
  a, new_kv <- scope@self_attn do
    q <- NN.linear@q_proj x dim=(NUM_HEADS * MODEL_HEAD_DIM) |> NN.rmsnorm@q_norm eps=EPS cast_float=true |> reshape_heads heads=NUM_HEADS
    k <- NN.linear@k_proj x dim=(KVH * MODEL_HEAD_DIM) |> NN.rmsnorm@k_norm eps=EPS cast_float=true |> reshape_heads heads=KVH
    v <- NN.linear@v_proj x dim=(KVH * MODEL_HEAD_DIM) |> reshape_heads heads=KVH
    q, k <- rope_pair_yarn q k pos_ids THETA ROPE_SCALE ROPE_BETA_FAST ROPE_BETA_SLOW ROPE_CONTEXT
    k, v, new_kv <- Cache.update past_kv k v
    k <- Tensor.repeat k repeats=(NUM_HEADS / KVH)
    v <- Tensor.repeat v repeats=(NUM_HEADS / KVH)
    window <- ((i + 1) % FULL_ATTN_PERIOD) == 0 ? MAX_POSITIONS : SW
    mask <- causal_mask q k window=window padding_mask=attn_mask
    a <- attention q k v mask scale=ATTN_SCALE |> merge_heads |> NN.linear@o_proj dim=MODEL_DIM
    return a, new_kv
  a <- NN.rmsnorm@post_attention_layernorm a eps=EPS cast_float=true
  x <- x + a
  m <- scope@mlp do
    g <- NN.linear@gate_proj x dim=FFN
    u <- NN.linear@up_proj x dim=FFN
    return g |> silu |> mul u |> NN.linear@down_proj dim=MODEL_DIM
  m <- NN.rmsnorm@post_feedforward_layernorm m eps=EPS cast_float=true
  return x + m, new_kv

olmo3 :: TokenIds[B,S] -> ?Tensor[B,K] -> ?Cache[B,KVH,P,DH] -> ?Bool -> (Tensor[B,S,V], ?Cache[B,KVH,K,DH])
olmo3 input_ids attn_mask past_kv use_cache = do
  pos_ids <- position_ids input_ids attn_mask=attn_mask past_length=(Cache.past_length past_kv)
  x, new_kv <- scope@model do
    x <- NN.embedding@embed_tokens input_ids dim=MODEL_DIM
    new_kv <- use_cache ? Cache.init : null
    x, new_kv <- for@layers i <- [0..NUM_LAYERS) carry (x, new_kv) do
      past_i <- Cache.index past_kv i
      x, new_i <- olmo3_block x i pos_ids attn_mask past_i
      new_kv <- Cache.append new_kv new_i
      yield x, new_kv
    x <- NN.rmsnorm@norm x eps=EPS cast_float=true
    return x, new_kv
  logits <- NN.linear@lm_head x dim=VOCAB_SIZE
  return logits, new_kv
