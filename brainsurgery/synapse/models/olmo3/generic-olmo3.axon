{-# CHECKPOINTS ["allenai/Olmo-3-1025-7B", "allenai/Olmo-3-7B-Instruct", "allenai/Olmo-3-7B-Think", "allenai/Olmo-3-1125-32B"] #-}
{-# TASK "causal_lm" #-}

import Config
import Activations silu
import Cache
import Cache past_length

D = Config.int "hidden_size" default=4096
V = Config.int "vocab_size" default=100278
L = Config.int "num_hidden_layers" default=32
H = Config.int "num_attention_heads" default=32
KVH = Config.int "num_key_value_heads" default=32
HD = Config.int "head_dim" default=128
FFN = Config.int "intermediate_size" default=11008
EPS = Config.float "rms_norm_eps" default=1e-06
THETA = Config.float "rope_theta" default=500000.0
C = Config.int "max_position_embeddings" default=65536
SW = Config.int "sliding_window" default=4096
FULL_ATTN_PERIOD = 4
ROPE_SCALE = Config.float "rope_scaling.factor" default=8.0
ROPE_BETA_FAST = Config.float "rope_scaling.beta_fast" default=32.0
ROPE_BETA_SLOW = Config.float "rope_scaling.beta_slow" default=1.0
ROPE_CONTEXT = Config.int "rope_scaling.original_max_position_embeddings" default=8192
ATTN_SCALE = 1.0 / sqrt HD

olmo3_block :: Tensor[B,S,D] -> Int -> Tensor[B,S] -> ?Tensor[B,S] -> ?CacheLayer -> (Tensor[B,S,D], ?CacheLayer)
olmo3_block x i pos_ids attn_mask past_kv = do
  a, new_kv <- scope@self_attn do
    q <- linear@q_proj x dim=(H * HD) |> rmsnorm@q_norm eps=EPS cast_float=true |> reshape_heads heads=H
    k <- linear@k_proj x dim=(KVH * HD) |> rmsnorm@k_norm eps=EPS cast_float=true |> reshape_heads heads=KVH
    v <- linear@v_proj x dim=(KVH * HD) |> reshape_heads heads=KVH
    q, k <- rope_pair q k position_ids=pos_ids theta=THETA scale_factor=ROPE_SCALE beta_fast=ROPE_BETA_FAST beta_slow=ROPE_BETA_SLOW original_context=ROPE_CONTEXT
    k, v, new_kv <- Cache.update past_kv k v
    k <- repeat k repeats=(H / KVH)
    v <- repeat v repeats=(H / KVH)
    window <- ((i + 1) % FULL_ATTN_PERIOD) == 0 ? C : SW
    mask <- causal_mask q k window=window padding_mask=attn_mask
    a <- attention q k v mask=mask scale=ATTN_SCALE |> merge_heads |> linear@o_proj dim=D
    return a, new_kv
  a <- rmsnorm@post_attention_layernorm a eps=EPS cast_float=true
  x <- x + a
  m <- scope@mlp do
    g <- linear@gate_proj x dim=FFN
    u <- linear@up_proj x dim=FFN
    return g |> silu |> mul u |> linear@down_proj dim=D
  m <- rmsnorm@post_feedforward_layernorm m eps=EPS cast_float=true
  return x + m, new_kv

olmo3 :: TokenIds[B,S] -> ?Tensor[B,S] -> ?Cache -> ?Bool -> (Tensor[B,S,V], ?Cache)
olmo3 input_ids attn_mask past_kv use_cache = do
  pos_ids <- position_ids input_ids attn_mask=attn_mask past_length=(past_length past_kv)
  x, new_kv <- scope@model do
    x <- embedding@embed_tokens input_ids dim=D
    new_kv <- use_cache ? Cache.init : null
    for@layers i <- [0..L) do
      past_i <- Cache.index past_kv i
      x, new_i <- olmo3_block x i pos_ids attn_mask past_i
      new_kv <- Cache.append new_kv new_i
    x <- rmsnorm@norm x eps=EPS cast_float=true
    return x, new_kv
  logits <- linear@lm_head x dim=V
  return logits, new_kv
