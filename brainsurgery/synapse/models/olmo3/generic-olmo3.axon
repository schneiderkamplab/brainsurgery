{-# CHECKPOINTS ["allenai/Olmo-3-1025-7B", "allenai/Olmo-3-7B-Instruct", "allenai/Olmo-3-7B-Think", "allenai/Olmo-3-1125-32B", "test/Olmo3-Test"] #-}
{-# TASK "causal_lm" #-}

import Activations (silu)
import Attention (attention, merge_heads)
import Masking (Mask, causal_mask_for_input, mask_for_input, mask_length_for_input)
import Math (mul, sqrt)
import Positions (position_ids, rope_pair_yarn)
import Cache
import Config
import NN
import Tensor



MODEL_DIM <- Config.int @@hidden_size default=4096
VOCAB_SIZE <- Config.int @@vocab_size default=100278
NUM_LAYERS <- Config.int @@num_hidden_layers default=32
NUM_HEADS <- Config.int @@num_attention_heads default=32
KVH <- Config.int @@num_key_value_heads default=32
MODEL_HEAD_DIM <- Config.int @@head_dim default=(MODEL_DIM / NUM_HEADS)
FFN <- Config.int @@intermediate_size default=11008
EPS <- Config.float @@rms_norm_eps default=1e-06
THETA <- Config.float @@rope_theta default=500000.0
MAX_POSITIONS <- Config.int @@max_position_embeddings default=65536
SW <- Config.int @@sliding_window default=4096
FULL_ATTN_PERIOD = 4
ROPE_SCALE <- Config.float @@'rope_scaling.factor' default=(Config.float @@'rope_parameters.factor' default=8.0)
ROPE_BETA_FAST <- Config.float @@'rope_scaling.beta_fast' default=(Config.float @@'rope_parameters.beta_fast' default=32.0)
ROPE_BETA_SLOW <- Config.float @@'rope_scaling.beta_slow' default=(Config.float @@'rope_parameters.beta_slow' default=1.0)
ROPE_CONTEXT <- Config.int @@'rope_scaling.original_max_position_embeddings' default=(Config.int @@'rope_parameters.original_max_position_embeddings' default=8192)
ATTN_SCALE = 1.0 / sqrt MODEL_HEAD_DIM

olmo3_block :: Tensor[B,S,D] -> Int -> Tensor[B,S] -> Tensor[B,1,S,K] -> Tensor[B,1,S,K] -> ?CacheLayer[B,KVH,P,MAX_POSITIONS,DH] -> (Tensor[B,S,D], ?CacheLayer[B,KVH,K,MAX_POSITIONS,DH])
olmo3_block x i pos_ids mask_slide mask_full past_kv = do
  a, new_kv <- scope@self_attn do
    q <- NN.linear@q_proj x dim=(NUM_HEADS * MODEL_HEAD_DIM) |> NN.rmsnorm@q_norm eps=EPS cast_float=true
    q <- q |> Tensor.reshape shape=[B, S, NUM_HEADS, MODEL_HEAD_DIM] |> Tensor.permute dims=[0, 2, 1, 3]
    k <- NN.linear@k_proj x dim=(KVH * MODEL_HEAD_DIM) |> NN.rmsnorm@k_norm eps=EPS cast_float=true
    k <- k |> Tensor.reshape shape=[B, S, KVH, MODEL_HEAD_DIM] |> Tensor.permute dims=[0, 2, 1, 3]
    v <- NN.linear@v_proj x dim=(KVH * MODEL_HEAD_DIM)
    v <- v |> Tensor.reshape shape=[B, S, KVH, MODEL_HEAD_DIM] |> Tensor.permute dims=[0, 2, 1, 3]
    q, k <- rope_pair_yarn q k pos_ids THETA ROPE_SCALE ROPE_BETA_FAST ROPE_BETA_SLOW ROPE_CONTEXT
    k, v, new_kv <- Cache.update past_kv k v
    k <- Tensor.repeat k repeats=(NUM_HEADS / KVH)
    v <- Tensor.repeat v repeats=(NUM_HEADS / KVH)
    full <- ((i + 1) % FULL_ATTN_PERIOD) == 0
    mask <- full ? mask_full : mask_slide
    a <- attention q k v mask scale=ATTN_SCALE |> merge_heads |> NN.linear@o_proj dim=MODEL_DIM
    return a, new_kv
  a <- NN.rmsnorm@post_attention_layernorm a eps=EPS cast_float=true
  x <- x + a
  m <- scope@mlp do
    g <- NN.linear@gate_proj x dim=FFN
    u <- NN.linear@up_proj x dim=FFN
    return g |> silu |> mul u |> NN.linear@down_proj dim=MODEL_DIM
  m <- NN.rmsnorm@post_feedforward_layernorm m eps=EPS cast_float=true
  return x + m, new_kv

olmo3 :: TokenIds[B,S] -> ?Mask[B,K,MAX_POSITIONS] -> ?Cache[B,KVH,P,MAX_POSITIONS,DH] -> ?Bool -> (Tensor[B,S,V], ?Cache[B,KVH,K,MAX_POSITIONS,DH])
olmo3 input_ids attn_mask past_kv use_cache = do
  past_length <- Cache.past_length past_kv
  attn_mask <- mask_for_input input_ids attn_mask MAX_POSITIONS
  pos_ids <- position_ids input_ids attn_mask=attn_mask past_length=past_length
  key_len <- mask_length_for_input input_ids attn_mask past_length
  mask_slide <- causal_mask_for_input input_ids key_len padding_mask=attn_mask window=SW
  mask_full <- causal_mask_for_input input_ids key_len padding_mask=attn_mask window=MAX_POSITIONS
  work_kv <- Cache.prepare past_kv use_cache MAX_POSITIONS
  read_kv <- Cache.read past_kv work_kv
  x, new_kv <- scope@model do
    x <- NN.embedding@embed_tokens input_ids dim=MODEL_DIM
    x, work_kv <- for@layers i <- [0..NUM_LAYERS) carry (x, work_kv) do
      past_i <- Cache.index read_kv i
      x, new_i <- olmo3_block x i pos_ids mask_slide mask_full past_i
      work_kv <- Cache.append work_kv new_i
      yield x, work_kv
    x <- NN.rmsnorm@norm x eps=EPS cast_float=true
    return x, work_kv
  new_length <- past_length + S
  new_kv <- Cache.finish new_kv new_length
  new_kv <- use_cache ? new_kv : null
  logits <- NN.linear@lm_head x dim=VOCAB_SIZE
  return logits, new_kv
