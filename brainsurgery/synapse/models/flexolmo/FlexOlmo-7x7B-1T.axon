{-# CHECKPOINTS "allenai/FlexOlmo-7x7B-1T" #-}

{-# TASK "causal_lm" #-}

{-# MAIN "flexolmo" #-}

import Activations (silu)

import Attention (attention, merge_heads, reshape_heads)

import Masking (causal_mask)

import Math (mul, sqrt)

import MoE (scatter_add, select)

import Positions (position_ids, rope_pair_base)

import Cache

import Config

import NN

import Tensor

MODEL_DIM = 4096

VOCAB_SIZE = 100352

NUM_LAYERS = 32

NUM_HEADS = 32

MODEL_HEAD_DIM = MODEL_DIM / NUM_HEADS

E = 7

EPT = 7

MAX_POSITIONS = 4096

FFN = 11008

EPS = 1e-06

THETA = 500000.0

ATTN_SCALE = 1.0 / sqrt MODEL_HEAD_DIM

rms :: Path -> Tensor[B,S,D] -> Tensor[B,S,D]
rms@path x = NN.rmsnorm@path x eps=EPS

expert_ffn :: Tensor[N,D] -> Tensor[N,D]
expert_ffn x = do
  gate <- NN.linear@gate_proj x dim=FFN
  up <- NN.linear@up_proj x dim=FFN
  return gate |> silu |> mul up |> NN.linear@down_proj dim=MODEL_DIM

flexolmo_decoder_block :: Tensor[B,S,D] -> Tensor[B,S] -> ?Tensor[B,K] -> ?CacheLayer[B,NUM_HEADS,P,DH] -> (Tensor[B,S,D], ?CacheLayer[B,NUM_HEADS,K,DH])
flexolmo_decoder_block x pos_ids attn_mask past_kv = do
  a, new_kv <- scope@self_attn do
    q <- x |> NN.linear@q_proj dim=MODEL_DIM |> rms@q_norm |> reshape_heads heads=NUM_HEADS
    k <- x |> NN.linear@k_proj dim=MODEL_DIM |> rms@k_norm |> reshape_heads heads=NUM_HEADS
    v <- x |> NN.linear@v_proj dim=MODEL_DIM |> reshape_heads heads=NUM_HEADS
    q, k <- rope_pair_base q k pos_ids THETA
    k, v, new_kv <- Cache.update past_kv k v
    mask <- causal_mask q k window=MAX_POSITIONS padding_mask=attn_mask
    a <- attention q k v mask scale=ATTN_SCALE |> merge_heads
    a <- NN.linear@o_proj a dim=MODEL_DIM
    return a, new_kv
  a_norm <- rms@post_attention_layernorm a
  x <- x + a_norm
  m <- scope@mlp do
    topk_scores, topk_indices <- NN.linear@gate x dim=E |> Tensor.softmax dim=-1 dtype="float32" |> Tensor.topk k=EPT dim=-1
    m <- x * 0.0
    m <- for@experts e <- [0..E) carry (m) do
      x_sel, token_idx, topk_pos, sel_scores <- select x topk_scores topk_indices e
      x_upd <- expert_ffn x_sel
      m <- scatter_add m token_idx x_upd sel_scores
      yield m
    return m
  m_norm <- rms@post_feedforward_layernorm m
  return x + m_norm, new_kv

flexolmo :: TokenIds[B,S] -> ?Tensor[B,K] -> ?Cache[B,NUM_HEADS,P,DH] -> ?Bool -> (Tensor[B,S,V], ?Cache[B,NUM_HEADS,K,DH])
flexolmo input_ids attn_mask past_kv use_cache = do
  pos_ids <- position_ids input_ids attn_mask=attn_mask past_length=(Cache.past_length past_kv)
  x, new_kv <- scope@model do
    x <- NN.embedding@embed_tokens input_ids dim=MODEL_DIM
    new_kv <- use_cache ? Cache.init : null
    x, new_kv <- for@layers i <- [0..NUM_LAYERS) carry (x, new_kv) do
      past_i <- Cache.index past_kv i
      x, new_i <- flexolmo_decoder_block x pos_ids attn_mask past_i
      new_kv <- Cache.append new_kv new_i
      yield x, new_kv
    x <- rms@norm x
    return x, new_kv
  logits <- NN.linear@lm_head x
  return logits, new_kv
