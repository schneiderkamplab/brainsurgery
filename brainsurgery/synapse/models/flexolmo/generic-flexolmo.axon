{-# CHECKPOINTS ["allenai/Flex-math-2x7B-1T", "allenai/Flex-news-2x7B-1T", "allenai/Flex-pes2o-2x7B-1T", "allenai/Flex-code-2x7B-1T", "allenai/Flex-creative-2x7B-1T", "allenai/Flex-reddit-2x7B-1T", "danish-foundation-models/dfm-moe-open-v0-8x7b-pt", "allenai/FlexOlmo-7x7B-1T"] #-}
{-# TASK "causal_lm" #-}

import Activations (silu)
import Attention (attention, merge_heads, reshape_heads)
import Masking (causal_mask)
import Math (mul, sqrt)
import MoE (scatter_add, select)
import Positions (position_ids, rope_pair_base)



-- FlexOlmo architecture constants.
D    = Config.int@hidden_size default=4096                       -- residual hidden size
V    = Config.int@vocab_size default=100352                      -- tokenizer vocabulary size
L    = Config.int@num_hidden_layers default=32                   -- number of decoder layers
H    = Config.int@num_attention_heads default=32                 -- attention head count
HD   = D / H                                                        -- per-head dimension
E    = Config.int@num_experts default=2                          -- routed experts
EPT  = Config.int@num_experts_per_tok default=2                  -- top-k experts per token
C    = Config.int@max_position_embeddings default=4096           -- causal window
FFN  = Config.int@intermediate_size default=11008                -- expert FFN width
EPS  = Config.float@rms_norm_eps default=1e-06                   -- RMSNorm epsilon
THETA = Config.float@rope_theta default=500000.0                 -- RoPE theta
ATTN_SCALE = 1.0 / sqrt HD                                         -- qk scaling

rms :: Path -> Tensor[B,S,D] -> Tensor[B,S,D]
rms@path x = NN.rmsnorm@path x eps=EPS

expert_ffn :: Tensor[N,D] -> Tensor[N,D]
expert_ffn x = do
  gate <- NN.linear@gate_proj x dim=FFN
  up <- NN.linear@up_proj x dim=FFN
  return gate |> silu |> mul up |> NN.linear@down_proj dim=D

flexolmo_decoder_block :: Tensor[B,S,D] -> Tensor[B,S] -> ?Tensor[B,S] -> ?CacheLayer -> (Tensor[B,S,D], ?CacheLayer)
flexolmo_decoder_block x pos_ids attn_mask past_kv = do
  a, new_kv <- scope@self_attn do
    q <- x |> NN.linear@q_proj dim=D |> rms@q_norm |> reshape_heads heads=H
    k <- x |> NN.linear@k_proj dim=D |> rms@k_norm |> reshape_heads heads=H
    v <- x |> NN.linear@v_proj dim=D |> reshape_heads heads=H
    q, k <- rope_pair_base q k pos_ids THETA
    k, v, new_kv <- Cache.update past_kv k v
    mask <- causal_mask q k window=C padding_mask=attn_mask
    a <- attention q k v mask scale=ATTN_SCALE |> merge_heads
    a <- NN.linear@o_proj a dim=D
    return a, new_kv
  a_norm <- rms@post_attention_layernorm a
  x <- x + a_norm
  m <- scope@mlp do
    topk_scores, topk_indices <- NN.linear@gate x dim=E |>
      Tensor.softmax dim=-1 dtype="float32" |> Tensor.topk k=EPT dim=-1
    m <- x * 0.0
    m <- for@experts e <- [0..E) carry (m) do
      x_sel, token_idx, topk_pos, sel_scores <- select x topk_scores topk_indices e
      x_upd <- expert_ffn x_sel
      m <- scatter_add m token_idx x_upd sel_scores
      yield m
    return m
  m_norm <- rms@post_feedforward_layernorm m
  return x + m_norm, new_kv

flexolmo :: TokenIds[B,S] -> ?Tensor[B,S] -> ?Cache -> ?Bool -> (Tensor[B,S,V], ?Cache)
flexolmo input_ids attn_mask past_kv use_cache = do
  pos_ids <- position_ids input_ids attn_mask=attn_mask past_length=(Cache.past_length past_kv)
  x, new_kv <- scope@model do
    x <- NN.embedding@embed_tokens input_ids dim=D
    new_kv <- use_cache ? Cache.init : null
    x, new_kv <- for@layers i <- [0..L) carry (x, new_kv) do
      past_i <- Cache.index past_kv i
      x, new_i <- flexolmo_decoder_block x pos_ids attn_mask past_i
      new_kv <- Cache.append new_kv new_i
      yield x, new_kv
    x <- rms@norm x
    return x, new_kv
  logits <- NN.linear@lm_head x
  return logits, new_kv
