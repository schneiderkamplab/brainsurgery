{-# CHECKPOINTS "sapientinc/HRM-Text-1B" #-}

{-# TASK "causal_lm" #-}

{-# MAIN "hrm_text" #-}

import Activations (sigmoid, silu)

import Attention (attention_with_additive_mask, mask_to_additive_for_input, merge_heads)

import Masking (causal_mask_for_input)

import Math (mul)

import Params (param)

import Positions (position_ids, rope_base_factors, rope_pair_base_factors)

import Cache

import Config

import NN

import Tensor

MODEL_DIM <- ((1536 :: Dim) :: Dim)

VOCAB_SIZE <- ((65536 :: Dim) :: Dim)

HAS_STACK_LAYERS <- false

NUM_LAYERS <- (HAS_STACK_LAYERS ? (16 :: Dim) : ((16 :: Dim) :: Dim))

NUM_LAYERS_I <- (HAS_STACK_LAYERS ? (16) : ((16) :: Int))

NUM_HEADS <- ((12 :: Dim) :: Dim)

HAS_HEAD_DIM <- true

MODEL_HEAD_DIM <- (HAS_HEAD_DIM ? (128 :: Dim) : ((MODEL_DIM / NUM_HEADS) :: Dim))

QD <- ((NUM_HEADS * MODEL_HEAD_DIM) :: Dim)

GQKV_DIM <- ((4 * QD) :: Dim)

FFN <- ((4096 :: Dim) :: Dim)

GATE_UP_DIM <- ((2 * FFN) :: Dim)

H_CYCLES <- ((2) :: Int)

L_CYCLES <- ((3) :: Int)

CACHE_SLOTS <- ((128 :: Dim) :: Dim)

EPS <- (1e-06)

THETA <- (10000.0)

MAX_POSITIONS <- ((4096 :: Dim) :: Dim)

HAS_EMBED_SCALE <- true

INIT_RANGE <- (0.025515518153991442)

EMBED_SCALE <- (HAS_EMBED_SCALE ? (39.191835884530846) : ((1.0 / INIT_RANGE) :: Float))

hrm_rms :: Tensor[B,S,D] -> Tensor[B,S,D]
hrm_rms x = NN.rmsnorm_noscale x eps=EPS cast_float=true

hrm_block :: Tensor[B,S,D] -> Tensor[B,1,S,R] -> Tensor[B,1,S,R] -> Tensor[B,NUM_HEADS,S,K] -> Tensor[B,1,S,K] -> ?StaticCacheLayer[B,NUM_HEADS,C,DH] -> (Tensor[B,S,D], ?StaticCacheLayer[B,NUM_HEADS,C,DH])
hrm_block x rope_sin rope_cos additive_mask mask past_kv = do
  xn <- hrm_rms x
  a, new_kv <- scope@attn do
    gqkv <- NN.linear@gqkv_proj xn dim=GQKV_DIM bias=false
    gate_lin, q_lin, k_lin, v_lin <- Tensor.split gqkv sizes=[QD, QD, QD, QD]
    q <- Tensor.reshape q_lin shape=[B, S, NUM_HEADS, MODEL_HEAD_DIM] |> Tensor.permute dims=[0, 2, 1, 3]
    k <- Tensor.reshape k_lin shape=[B, S, NUM_HEADS, MODEL_HEAD_DIM] |> Tensor.permute dims=[0, 2, 1, 3]
    v <- Tensor.reshape v_lin shape=[B, S, NUM_HEADS, MODEL_HEAD_DIM] |> Tensor.permute dims=[0, 2, 1, 3]
    gate <- Tensor.reshape gate_lin shape=[B, S, NUM_HEADS, MODEL_HEAD_DIM] |> Tensor.permute dims=[0, 2, 1, 3]
    q, k <- rope_pair_base_factors q k rope_sin rope_cos
    k, v, new_kv <- Cache.static_update past_kv k v
    a <- attention_with_additive_mask q k v additive_mask mask
    a <- sigmoid gate |> mul a
    a <- merge_heads a |> NN.linear@o_proj dim=MODEL_DIM
    return a, new_kv
  x <- x + a
  xn <- hrm_rms x
  m <- scope@mlp do
    gate_up <- NN.linear@gate_up_proj xn dim=GATE_UP_DIM bias=false
    gate, up <- Tensor.split gate_up sizes=[FFN, FFN]
    return gate |> silu |> mul up |> NN.linear@down_proj dim=MODEL_DIM bias=false
  return x + m, new_kv

hrm_stack :: Path -> Tensor[B,S,D] -> Tensor[B,1,S,R] -> Tensor[B,1,S,R] -> Tensor[B,NUM_HEADS,S,K] -> Tensor[B,1,S,K] -> ?StaticCache[B,NUM_HEADS,CACHE_SLOTS,MAX_POSITIONS,MODEL_HEAD_DIM] -> Dim -> Int -> (Tensor[B,S,D], ?StaticCache[B,NUM_HEADS,CACHE_SLOTS,MAX_POSITIONS,MODEL_HEAD_DIM])
hrm_stack@path x rope_sin rope_cos additive_mask mask new_kv past_length cycle_offset = do
  x, new_kv <- for@layers i <- [0..NUM_LAYERS_I) carry (x, new_kv) do
    slot <- cycle_offset + i
    past_i <- Cache.static_index_at new_kv slot past_length
    x, new_i <- hrm_block x rope_sin rope_cos additive_mask mask past_i
    new_kv <- Cache.static_put new_kv slot new_i
    yield x, new_kv
  x <- hrm_rms x
  return x, new_kv

hrm_l_cycles :: Tensor[B,S,D] -> Tensor[B,S,D] -> Tensor[B,1,S,R] -> Tensor[B,1,S,R] -> Tensor[B,NUM_HEADS,S,K] -> Tensor[B,1,S,K] -> ?StaticCache[B,NUM_HEADS,CACHE_SLOTS,MAX_POSITIONS,MODEL_HEAD_DIM] -> Dim -> Int -> (Tensor[B,S,D], ?StaticCache[B,NUM_HEADS,CACHE_SLOTS,MAX_POSITIONS,MODEL_HEAD_DIM], Int)
hrm_l_cycles z_l z_h rope_sin rope_cos additive_mask mask new_kv past_length slot_offset = do
  z_l, new_kv, slot_offset <- for i <- [0..L_CYCLES) carry (z_l, new_kv, slot_offset) do
    x_l <- z_l + z_h
    z_l, new_kv <- hrm_stack@model.L_module x_l rope_sin rope_cos additive_mask mask new_kv past_length slot_offset
    slot_offset <- slot_offset + NUM_LAYERS_I
    yield z_l, new_kv, slot_offset
  return z_l, new_kv, slot_offset

hrm_text :: TokenIds[B,S] -> ?Tensor[B,K] -> ?StaticCache[B,NUM_HEADS,CACHE_SLOTS,MAX_POSITIONS,MODEL_HEAD_DIM] -> ?Bool -> (Tensor[B,S,V], ?StaticCache[B,NUM_HEADS,CACHE_SLOTS,MAX_POSITIONS,MODEL_HEAD_DIM])
hrm_text input_ids attn_mask past_kv use_cache = do
  past_length <- Cache.static_past_length past_kv
  pos_ids <- position_ids input_ids attn_mask=attn_mask past_length=past_length
  rope_sin, rope_cos <- rope_base_factors pos_ids MODEL_HEAD_DIM THETA
  key_len <- past_length + S
  mask <- causal_mask_for_input input_ids key_len padding_mask=attn_mask window=MAX_POSITIONS
  additive_mask <- mask_to_additive_for_input input_ids mask NUM_HEADS
  x <- NN.embedding@@model.embed_tokens input_ids dim=MODEL_DIM scale=EMBED_SCALE
  z0 <- ((param @@model.z_L_init) :: Tensor[MODEL_DIM])
  z_l <- Tensor.reshape z0 shape=[1, 1, MODEL_DIM] |> Tensor.expand shape=[B, S, MODEL_DIM] |> Tensor.cast_like x
  z_h <- x
  new_kv <- ((use_cache ? ((past_kv == null) ? (Cache.static_init_like x B CACHE_SLOTS NUM_HEADS MAX_POSITIONS MODEL_HEAD_DIM) : past_kv) : null) :: ?StaticCache[B,NUM_HEADS,CACHE_SLOTS,MAX_POSITIONS,MODEL_HEAD_DIM])
  slot_offset <- 0
  z_h, z_l, new_kv, slot_offset <- for i <- [0..H_CYCLES) carry (z_h, z_l, new_kv, slot_offset) do
    z_l, new_kv, slot_offset <- hrm_l_cycles z_l z_h rope_sin rope_cos additive_mask mask new_kv past_length slot_offset
    x_h <- z_h + z_l
    z_h, new_kv <- hrm_stack@model.H_module x_h rope_sin rope_cos additive_mask mask new_kv past_length slot_offset
    slot_offset <- slot_offset + NUM_LAYERS_I
    yield z_h, z_l, new_kv, slot_offset
  new_length <- past_length + S
  new_kv <- Cache.static_commit new_kv new_length
  logits <- NN.linear@@lm_head z_h dim=VOCAB_SIZE bias=false
  return logits, new_kv
