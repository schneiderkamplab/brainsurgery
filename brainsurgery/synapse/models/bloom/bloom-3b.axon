{-# CHECKPOINTS "bigscience/bloom-3b" #-}
{-# TASK "causal_lm" #-}

import Params
import Activations (gelu_new)
import Cache
import Tensor
import Attention (mask_to_additive, merge_heads)
import Compat (attention, split_qkv_heads)
import Positions (linear_position_bias)
import Masking (causal_mask)

D = 2560
V = 250880
L = 30
H = 32
FFN = 10240
EPS = 1e-05
MAX_CTX = 2048
POST_LN_RESID = false
HAS_LM_HEAD = Params.has_root "lm_head"

bloom_block :: Tensor[B,S,D] -> Tensor[B,S] -> ?CacheLayer -> (Tensor[B,S,D], ?CacheLayer)
bloom_block x attn_mask past_kv = do
  xn <- NN.layernorm@input_layernorm x eps=EPS
  attn_res <- POST_LN_RESID ? xn : x
  a, new_kv <- scope@self_attention do
    qkv <- NN.linear@query_key_value xn dim=(3 * D) bias=true
    q, k, v <- split_qkv_heads qkv heads=H layout=interleaved
    k, v, new_kv <- Cache.update past_kv k v
    keep <- causal_mask q k window=MAX_CTX padding_mask=attn_mask
    pos_bias <- linear_position_bias attn_mask heads=H
    scores_ref <- Tensor.matmul q (Tensor.transpose k dim1=2 dim2=3)
    causal_bias <- mask_to_additive scores_ref keep
    mask <- causal_bias + pos_bias
    a <- attention q k v mask=mask |> merge_heads |> NN.linear@dense dim=D bias=true
    return a, new_kv
  x <- attn_res + a
  xn <- NN.layernorm@post_attention_layernorm x eps=EPS
  mlp_res <- POST_LN_RESID ? xn : x
  m <- scope@mlp do
    h <- NN.linear@dense_h_to_4h xn dim=FFN bias=true |> gelu_new
    return NN.linear@dense_4h_to_h h dim=D bias=true
  return mlp_res + m, new_kv

bloom :: TokenIds[B,S] -> Tensor[B,S] -> ?Cache -> ?Bool -> (Tensor[B,S,V], ?Cache)
bloom input_ids attn_mask past_kv use_cache = do
  tok <- NN.embedding@word_embeddings input_ids dim=D
  x <- NN.layernorm@word_embeddings_layernorm tok eps=EPS
  new_kv <- use_cache ? Cache.init : null
  for@h i <- [0..L) do
    past_i <- Cache.index past_kv i
    x, new_i <- bloom_block x attn_mask past_i
    new_kv <- Cache.append new_kv new_i
  x <- NN.layernorm@ln_f x eps=EPS
  logits <- HAS_LM_HEAD ? (NN.linear@lm_head x dim=V) : (NN.linear@word_embeddings x dim=V)
  return logits, new_kv
