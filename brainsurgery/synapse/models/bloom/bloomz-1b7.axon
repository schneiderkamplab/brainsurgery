{-# CHECKPOINTS "bigscience/bloomz-1b7" #-}

{-# TASK "causal_lm" #-}

{-# MAIN "bloom" #-}

import Activations (gelu_new)

import Attention (attention, merge_heads, split_qkv_heads)

import Masking (causal_mask)

import Math (sqrt)

import Params (has_root)

import Positions (linear_position_bias)

import Tensor (size)

import Cache

import Config

import NN

MODEL_DIM = (true) ? (2048) : (1024)

VOCAB_SIZE = 250880

NUM_LAYERS = 24

NUM_HEADS = 16

FFN = 4 * MODEL_DIM

EPS = 1e-05

MAX_CTX = 4096

POST_LN_RESID = false

HAS_LM_HEAD = has_root "lm_head"

bloom_block :: Tensor[B,S,D] -> Tensor[B,K] -> ?CacheLayer[B,H,P,DH] -> (Tensor[B,S,D], ?CacheLayer[B,H,K,DH])
bloom_block x attn_mask past_kv = do
  xn <- NN.layernorm@input_layernorm x eps=EPS
  attn_res <- POST_LN_RESID ? xn : x
  a, new_kv <- scope@self_attention do
    qkv <- NN.linear@query_key_value xn dim=(3 * MODEL_DIM) bias=true
    q, k, v <- split_qkv_heads qkv heads=NUM_HEADS layout="interleaved"
    k, v, new_kv <- Cache.update past_kv k v
    keep <- causal_mask q k window=MAX_CTX padding_mask=attn_mask
    pos_bias <- linear_position_bias attn_mask heads=NUM_HEADS
    head_dim <- size q 3
    scale <- 1.0 / sqrt head_dim
    a <- attention q k v keep rel_bias=pos_bias scale=scale |> merge_heads |> NN.linear@dense dim=MODEL_DIM bias=true
    return a, new_kv
  x <- attn_res + a
  xn <- NN.layernorm@post_attention_layernorm x eps=EPS
  mlp_res <- POST_LN_RESID ? xn : x
  m <- scope@mlp do
    h <- NN.linear@dense_h_to_4h xn dim=FFN bias=true |> gelu_new
    return NN.linear@dense_4h_to_h h dim=MODEL_DIM bias=true
  return mlp_res + m, new_kv

bloom :: TokenIds[B,S] -> Tensor[B,K] -> ?Cache[B,H,P,DH] -> ?Bool -> (Tensor[B,S,V], ?Cache[B,H,K,DH])
bloom input_ids attn_mask past_kv use_cache = do
  tok <- NN.embedding@word_embeddings input_ids dim=MODEL_DIM
  x <- NN.layernorm@word_embeddings_layernorm tok eps=EPS
  new_kv <- use_cache ? Cache.init : null
  x, new_kv <- for@h i <- [0..NUM_LAYERS) carry (x, new_kv) do
    past_i <- Cache.index past_kv i
    x, new_i <- bloom_block x attn_mask past_i
    new_kv <- Cache.append new_kv new_i
    yield x, new_kv
  x <- NN.layernorm@ln_f x eps=EPS
  logits <- HAS_LM_HEAD ? (NN.linear@lm_head x dim=VOCAB_SIZE) : (NN.linear@word_embeddings x dim=VOCAB_SIZE)
  return logits, new_kv
