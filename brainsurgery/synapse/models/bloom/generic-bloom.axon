{-# CHECKPOINTS ["bigscience/bloom-560m", "bigscience/bloom-1b1", "bigscience/bloom-1b7", "bigscience/bloom-3b", "bigscience/bloom-7b1", "bigscience/bloom", "bigscience/bloomz-560m", "bigscience/bloomz-1b1", "bigscience/bloomz-1b7", "bigscience/bloomz-3b", "bigscience/bloomz-7b1"] #-}
{-# TASK "causal_lm" #-}

import Config
import Params
import Activations gelu_new
import Cache

D = Config.int "hidden_size" default=1024
V = Config.int "vocab_size" default=250880
L = Config.int "n_layer" default=24
H = Config.int "n_head" default=16
FFN = 4 * D
EPS = Config.float "layer_norm_epsilon" default=1e-05
MAX_CTX = Config.int "seq_length" default=2048
POST_LN_RESID = Config.bool "apply_residual_connection_post_layernorm" default=false
HAS_LM_HEAD = Params.has_root "lm_head"

bloom_block :: Tensor[B,S,D] -> Tensor[B,S] -> ?CacheLayer -> (Tensor[B,S,D], ?CacheLayer)
bloom_block x attn_mask past_kv = do
  xn <- layernorm@input_layernorm x eps=EPS
  attn_res <- POST_LN_RESID ? xn : x
  a, new_kv <- scope@self_attention do
    qkv <- linear@query_key_value xn dim=(3 * D) bias=true
    q, k, v <- split_qkv_heads qkv heads=H layout=interleaved
    k, v, new_kv <- Cache.update past_kv k v
    causal <- causal_mask q k window=MAX_CTX padding_mask=attn_mask
    pos_bias <- linear_position_bias attn_mask heads=H
    mask <- causal + pos_bias
    a <- attention q k v mask=mask |> merge_heads |> linear@dense dim=D bias=true
    return a, new_kv
  x <- attn_res + a
  xn <- layernorm@post_attention_layernorm x eps=EPS
  mlp_res <- POST_LN_RESID ? xn : x
  m <- scope@mlp do
    h <- linear@dense_h_to_4h xn dim=FFN bias=true |> gelu_new
    return linear@dense_4h_to_h h dim=D bias=true
  return mlp_res + m, new_kv

bloom :: TokenIds[B,S] -> Tensor[B,S] -> ?Cache -> ?Bool -> (Tensor[B,S,V], ?Cache)
bloom input_ids attn_mask past_kv use_cache = do
  tok <- embedding@word_embeddings input_ids dim=D
  x <- layernorm@word_embeddings_layernorm tok eps=EPS
  new_kv <- use_cache ? Cache.init : null
  for@h i <- [0..L) do
    past_i <- Cache.index past_kv i
    x, new_i <- bloom_block x attn_mask past_i
    new_kv <- Cache.append new_kv new_i
  x <- layernorm@ln_f x eps=EPS
  logits <- HAS_LM_HEAD ? (linear@lm_head x dim=V) : (linear@word_embeddings x dim=V)
  return logits, new_kv
