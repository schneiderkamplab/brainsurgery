{-# CHECKPOINTS ["test/GLM-MoE-DSA-Test", "zai-org/GLM-5", "zai-org/GLM-5.1", "zai-org/GLM-5.2"] #-}
{-# TASK "causal_lm" #-}

import Activations (relu, silu)
import Attention (attention, merge_heads, reshape_heads)
import Cache
import Config
import List
import Masking (Mask, causal_mask_for_input, mask_for_input)
import Math (mul, sqrt)
import MoE (grouped_sigmoid_router, grouped_swiglu_ffn_separate)
import NN
import Positions (position_ids, rope_base_factors, rope_pair_base_factors)
import Tensor

type DsaLayerCache[B,H,T,C,DK,DV,ID] = (CacheLayerKV[B,H,T,C,DK,DV], ?Tensor[B,T,ID])
type DsaCache[B,H,T,C,DK,DV,ID] = (List[DsaLayerCache[B,H,T,C,DK,DV,ID]], Dim)

MODEL_DIM <- Config.dim @@hidden_size default=6144
VOCAB_SIZE <- Config.dim @@vocab_size default=154880
NUM_LAYERS <- Config.dim @@num_hidden_layers default=78
NUM_HEADS <- Config.dim @@num_attention_heads default=64
Q_LORA <- Config.dim @@q_lora_rank default=2048
KV_LORA <- Config.dim @@kv_lora_rank default=512
QK_ROPE <- Config.dim @@qk_rope_head_dim default=64
QK_NOPE <- Config.dim @@qk_nope_head_dim default=192
V_HEAD <- Config.dim @@v_head_dim default=256
QK_HEAD = QK_NOPE + QK_ROPE
FFN <- Config.dim @@intermediate_size default=12288
MOE_FFN <- Config.dim @@moe_intermediate_size default=2048
NUM_EXPERTS <- Config.dim @@n_routed_experts default=256
TOP_K <- Config.dim @@num_experts_per_tok default=8
NUM_GROUPS <- Config.dim @@n_group default=1
TOPK_GROUPS <- Config.dim @@topk_group default=1
NORM_TOPK <- Config.bool @@norm_topk_prob default=true
ROUTED_SCALE <- Config.float @@routed_scaling_factor default=2.5
SHARED_EXPERTS <- Config.dim @@n_shared_experts default=1
INDEX_HEADS <- Config.dim @@index_n_heads default=32
INDEX_HEAD_DIM <- Config.dim @@index_head_dim default=128
INDEX_TOPK <- Config.dim @@index_topk default=2048
INDEX_TYPES <- ((Config.list @@indexer_types default=["full"]) :: List[String])
MLP_TYPES <- ((Config.list @@mlp_layer_types default=["dense"]) :: List[String])
EPS <- Config.float @@rms_norm_eps default=1e-5
THETA <- Config.float @@'rope_parameters.rope_theta' default=10000.0
MAX_POSITIONS <- Config.dim @@max_position_embeddings default=202752
ATTN_BIAS <- Config.bool @@attention_bias default=false
ATTN_SCALE = 1.0 / sqrt QK_HEAD
INDEX_SCALE = 1.0 / sqrt INDEX_HEAD_DIM
INDEX_WEIGHT_SCALE = 1.0 / sqrt INDEX_HEADS

rms :: Path -> Tensor[..S] -> Tensor[..S]
rms@path x = NN.rmsnorm@path x eps=EPS cast_float=true

dense_mlp :: Tensor[B,S,D] -> Tensor[B,S,D]
dense_mlp x = do
  gate <- NN.linear@gate_proj x dim=FFN bias=false
  up <- NN.linear@up_proj x dim=FFN bias=false
  return gate |> silu |> mul up |> NN.linear@down_proj dim=MODEL_DIM bias=false

sparse_mlp :: Tensor[B,S,D] -> Tensor[B,S,D]
sparse_mlp x = do
  shared <- scope@shared_experts do
    gate <- NN.linear@gate_proj x dim=(MOE_FFN * SHARED_EXPERTS) bias=false
    up <- NN.linear@up_proj x dim=(MOE_FFN * SHARED_EXPERTS) bias=false
    return gate |> silu |> mul up |> NN.linear@down_proj dim=MODEL_DIM bias=false
  weights, indices <- grouped_sigmoid_router@gate x NUM_EXPERTS TOP_K n_group=NUM_GROUPS topk_group=TOPK_GROUPS norm_topk_prob=NORM_TOPK routed_scaling_factor=ROUTED_SCALE
  routed <- grouped_swiglu_ffn_separate x weights indices NUM_EXPERTS MOE_FFN gate_weight=@experts.gate_proj.weight up_weight=@experts.up_proj.weight out_weight=@experts.down_proj.weight
  return shared + routed

dsa_indices :: Tensor[B,S,D] -> Tensor[B,S,Q_LORA] -> Tensor[B,1,S,QK_ROPE] -> Tensor[B,1,S,QK_ROPE] -> Tensor[B,1,S,K] -> ?Tensor[B,P,INDEX_HEAD_DIM] -> (IdxTensor[B,S,INDEX_TOPK], Tensor[B,K,INDEX_HEAD_DIM])
dsa_indices hidden q_resid rope_sin rope_cos causal_mask past_index_k = do
  indices, index_k <- scope@indexer do
    q <- NN.linear@wq_b q_resid dim=(INDEX_HEADS * INDEX_HEAD_DIM) bias=false
    q <- reshape_heads q heads=INDEX_HEADS
    q_pe, q_nope <- Tensor.split q sizes=[QK_ROPE, INDEX_HEAD_DIM - QK_ROPE]

    k <- NN.linear@wk hidden dim=INDEX_HEAD_DIM bias=false
    k <- NN.layernorm@k_norm k eps=1e-6 dim=INDEX_HEAD_DIM bias=true
    k <- reshape_heads k heads=1
    k_pe, k_nope <- Tensor.split k sizes=[QK_ROPE, INDEX_HEAD_DIM - QK_ROPE]
    q_pe, k_pe <- rope_pair_base_factors q_pe k_pe rope_sin rope_cos interleaved=false
    q <- Tensor.concat q_pe q_nope dim=-1 |> Tensor.cast dtype="float32"
    k <- Tensor.concat k_pe k_nope dim=-1 |> Tensor.reshape shape=[B,S,INDEX_HEAD_DIM]
    index_k <- (past_index_k == null)
      ? k
      : Tensor.concat (past_index_k :: Tensor[B,P,INDEX_HEAD_DIM]) k dim=1
    k <- Tensor.reshape index_k shape=[B,1,K,INDEX_HEAD_DIM] |> Tensor.repeat repeats=INDEX_HEADS |> Tensor.cast dtype="float32"

    kt <- Tensor.transpose k 2 3
    scores <- Tensor.matmul q kt |> relu
    scores <- scores * INDEX_SCALE
    weights <- NN.linear@weights_proj hidden dim=INDEX_HEADS bias=false
    weights <- weights * INDEX_WEIGHT_SCALE
    weights <- Tensor.reshape weights shape=[B,S,INDEX_HEADS,1]
    weights <- Tensor.permute weights dims=[0,2,1,3] |> Tensor.cast dtype="float32"
    weighted <- scores * weights
    index_scores <- Tensor.sum weighted dim=1 keepdim=false
    base_mask <- Tensor.reshape causal_mask shape=[B,S,K]
    index_scores <- Tensor.where base_mask index_scores (Tensor.min_like index_scores)
    _, indices <- Tensor.topk index_scores k=INDEX_TOPK dim=-1 largest=true sorted=false
    return indices, index_k
  return indices, index_k

dsa_attention :: Tensor[B,S,D] -> Tensor[B,1,S,QK_ROPE] -> Tensor[B,1,S,QK_ROPE] -> Tensor[B,1,S,K] -> Bool -> IdxTensor[B,S,INDEX_TOPK] -> ?DsaLayerCache[B,NUM_HEADS,P,MAX_POSITIONS,QK_HEAD,V_HEAD,INDEX_HEAD_DIM] -> (Tensor[B,S,D], IdxTensor[B,S,INDEX_TOPK], DsaLayerCache[B,NUM_HEADS,K,MAX_POSITIONS,QK_HEAD,V_HEAD,INDEX_HEAD_DIM])
dsa_attention hidden rope_sin rope_cos causal_mask compute_indices previous_indices past = do
  past_attn, past_index_k <- (past == null)
    ? (((null :: ?CacheLayerKV[B,NUM_HEADS,P,MAX_POSITIONS,QK_HEAD,V_HEAD]), (null :: ?Tensor[B,P,INDEX_HEAD_DIM])) :: (?CacheLayerKV[B,NUM_HEADS,P,MAX_POSITIONS,QK_HEAD,V_HEAD], ?Tensor[B,P,INDEX_HEAD_DIM]))
    : (past :: DsaLayerCache[B,NUM_HEADS,P,MAX_POSITIONS,QK_HEAD,V_HEAD,INDEX_HEAD_DIM])
  out, indices, new_layer <- scope@self_attn do
    q_resid <- NN.linear@q_a_proj hidden dim=Q_LORA bias=ATTN_BIAS
    q_resid <- rms@q_a_layernorm q_resid
    q <- NN.linear@q_b_proj q_resid dim=(NUM_HEADS * QK_HEAD) bias=false
    q <- reshape_heads q heads=NUM_HEADS
    q_nope, q_pe <- Tensor.split q sizes=[QK_NOPE, QK_ROPE]

    compressed <- NN.linear@kv_a_proj_with_mqa hidden dim=(KV_LORA + QK_ROPE) bias=ATTN_BIAS
    kv_latent, k_pe <- Tensor.split compressed sizes=[KV_LORA, QK_ROPE]
    kv_latent <- rms@kv_a_layernorm kv_latent
    kv <- NN.linear@kv_b_proj kv_latent dim=(NUM_HEADS * (QK_NOPE + V_HEAD)) bias=false
    kv <- Tensor.reshape kv shape=[B,S,NUM_HEADS,QK_NOPE + V_HEAD]
    kv <- Tensor.permute kv dims=[0,2,1,3]
    k_nope, v <- Tensor.split kv sizes=[QK_NOPE, V_HEAD]
    k_pe <- reshape_heads k_pe heads=1
    q_pe, k_pe <- rope_pair_base_factors q_pe k_pe rope_sin rope_cos interleaved=false
    k_pe <- Tensor.repeat k_pe repeats=NUM_HEADS
    q <- Tensor.concat q_nope q_pe dim=-1
    k <- Tensor.concat k_nope k_pe dim=-1
    k, v, new_attn <- Cache.update_kv past_attn k v

    indices, new_index_k <- compute_indices
      ? dsa_indices hidden q_resid rope_sin rope_cos causal_mask past_index_k
      : (previous_indices, past_index_k)
    index_base <- Tensor.reshape causal_mask shape=[B,S,K] |> Tensor.zeros_like
    index_mask <- Tensor.scatter index_base indices true dim=-1
    index_mask <- Tensor.reshape index_mask shape=[B,1,S,K]
    combined_mask <- Tensor.and causal_mask index_mask
    out <- attention q k v combined_mask scale=ATTN_SCALE
    out <- merge_heads out |> NN.linear@o_proj dim=MODEL_DIM bias=ATTN_BIAS
    return out, indices, ((new_attn, new_index_k) :: DsaLayerCache[B,NUM_HEADS,K,MAX_POSITIONS,QK_HEAD,V_HEAD,INDEX_HEAD_DIM])
  return out, indices, new_layer

dsa_block :: Tensor[B,S,D] -> Tensor[B,1,S,QK_ROPE] -> Tensor[B,1,S,QK_ROPE] -> Tensor[B,1,S,K] -> Bool -> Bool -> IdxTensor[B,S,INDEX_TOPK] -> ?DsaLayerCache[B,NUM_HEADS,P,MAX_POSITIONS,QK_HEAD,V_HEAD,INDEX_HEAD_DIM] -> (Tensor[B,S,D], IdxTensor[B,S,INDEX_TOPK], DsaLayerCache[B,NUM_HEADS,K,MAX_POSITIONS,QK_HEAD,V_HEAD,INDEX_HEAD_DIM])
dsa_block x rope_sin rope_cos causal_mask compute_indices sparse previous_indices past = do
  xn <- rms@input_layernorm x
  a, indices, new_layer <- dsa_attention xn rope_sin rope_cos causal_mask compute_indices previous_indices past
  x <- x + a
  xn <- rms@post_attention_layernorm x
  m <- scope@mlp do
    m <- sparse ? (sparse_mlp xn) : (dense_mlp xn)
    return m
  return x + m, indices, new_layer

glm_moe_dsa :: TokenIds[B,S] -> ?Mask[B,K,MAX_POSITIONS] -> ?DsaCache[B,NUM_HEADS,P,MAX_POSITIONS,QK_HEAD,V_HEAD,INDEX_HEAD_DIM] -> ?Bool -> (Tensor[B,S,VOCAB_SIZE], ?DsaCache[B,NUM_HEADS,K,MAX_POSITIONS,QK_HEAD,V_HEAD,INDEX_HEAD_DIM])
glm_moe_dsa input_ids attn_mask past_kv use_cache = do
  past_layers, past_length <- (past_kv == null)
    ? ((List.init :: List[DsaLayerCache[B,NUM_HEADS,P,MAX_POSITIONS,QK_HEAD,V_HEAD,INDEX_HEAD_DIM]]), (0 :: Int))
    : (past_kv :: DsaCache[B,NUM_HEADS,P,MAX_POSITIONS,QK_HEAD,V_HEAD,INDEX_HEAD_DIM])
  attn_mask <- mask_for_input input_ids attn_mask MAX_POSITIONS
  pos_ids <- position_ids input_ids attn_mask=attn_mask past_length=past_length
  key_length <- past_length + S
  causal_mask <- causal_mask_for_input input_ids key_length padding_mask=attn_mask window=MAX_POSITIONS
  rope_sin, rope_cos <- rope_base_factors pos_ids QK_ROPE theta=THETA interleaved=false
  work_kv <- List.init
  x, work_kv <- scope@model do
    x <- NN.embedding@embed_tokens input_ids dim=MODEL_DIM
    seed <- Tensor.reshape input_ids shape=[B,S,1] |> Tensor.expand shape=[B,S,INDEX_TOPK]
    _, seed_indices <- Tensor.topk seed k=INDEX_TOPK dim=-1 largest=true sorted=false
    indices <- seed_indices
    x, indices, work_kv <- for@layers i <- [0..NUM_LAYERS) carry (x, indices, work_kv) do
      index_kind <- List.index INDEX_TYPES i
      mlp_kind <- List.index MLP_TYPES i
      compute_indices <- (i == 0) or (index_kind != "shared")
      past_i <- (past_kv == null)
        ? (null :: ?DsaLayerCache[B,NUM_HEADS,P,MAX_POSITIONS,QK_HEAD,V_HEAD,INDEX_HEAD_DIM])
        : ((List.index past_layers i) :: DsaLayerCache[B,NUM_HEADS,P,MAX_POSITIONS,QK_HEAD,V_HEAD,INDEX_HEAD_DIM])
      x, indices, new_layer <- dsa_block x rope_sin rope_cos causal_mask compute_indices (mlp_kind == "sparse") indices past_i
      work_kv <- List.append work_kv new_layer
      yield x, indices, work_kv
    return rms@norm x, work_kv
  logits <- NN.linear@lm_head x dim=VOCAB_SIZE bias=false
  new_cache <- use_cache ? ((work_kv, key_length) :: DsaCache[B,NUM_HEADS,K,MAX_POSITIONS,QK_HEAD,V_HEAD,INDEX_HEAD_DIM]) : null
  return logits, new_cache
