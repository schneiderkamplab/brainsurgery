{-# CHECKPOINTS "junnyu/roformer_chinese_small" #-}

{-# TASK "masked_lm" #-}

{-# MAIN "roformer" #-}

import Activations (gelu)

import Attention (attention, merge_heads, reshape_heads)

import Masking (Mask, bidirectional_mask_for_input, mask_for_input)

import Positions (position_ids, rope_pair_base)

import Config

import NN

MODEL_DIM <- 384

VOCAB_SIZE <- 50000

NUM_LAYERS <- 6

NUM_HEADS <- 6

FFN <- 1536

EPS <- 1e-12

roformer_block :: Tensor[B,S,D] -> Tensor[B,S] -> Tensor[B,1,S,S] -> Tensor[B,S,D]
roformer_block x pos_ids keep = do
  a <- scope@attention do
    q <- NN.linear@self.query x dim=MODEL_DIM bias=true |> reshape_heads heads=NUM_HEADS
    k <- NN.linear@self.key x dim=MODEL_DIM bias=true |> reshape_heads heads=NUM_HEADS
    v <- NN.linear@self.value x dim=MODEL_DIM bias=true |> reshape_heads heads=NUM_HEADS
    q, k <- rope_pair_base q k pos_ids theta=10000.0 interleaved=true
    return attention q k v keep |> merge_heads |> NN.linear@output.dense dim=MODEL_DIM bias=true
  x <- x + a
  x <- NN.layernorm@attention.output.LayerNorm x eps=EPS
  m <- NN.linear@intermediate.dense x dim=FFN bias=true |> gelu
  m <- NN.linear@output.dense m dim=MODEL_DIM bias=true
  y <- x + m
  y <- NN.layernorm@output.LayerNorm y eps=EPS
  return y

roformer :: TokenIds[B,S] -> ?Mask[B,S,S] -> Tensor[B,S,V]
roformer input_ids attn_mask = do
  attn_mask <- mask_for_input input_ids attn_mask S
  pos_ids <- position_ids input_ids
  keep <- bidirectional_mask_for_input input_ids S padding_mask=attn_mask
  tok_type_ids <- input_ids - input_ids
  tok <- NN.embedding@roformer.embeddings.word_embeddings input_ids dim=MODEL_DIM
  typ <- NN.embedding@roformer.embeddings.token_type_embeddings tok_type_ids dim=MODEL_DIM
  x <- tok + typ
  x <- NN.layernorm@roformer.embeddings.LayerNorm x eps=EPS
  x <- for@roformer.encoder.layer i <- [0..NUM_LAYERS) carry (x) do
    x <- roformer_block x pos_ids keep
    yield x
  logits <- scope@cls.predictions do
    x <- NN.linear@transform.dense x dim=MODEL_DIM bias=true |> gelu
    x <- NN.layernorm@transform.LayerNorm x eps=EPS
    return NN.linear@decoder x dim=VOCAB_SIZE bias=true weight_path=@@roformer.embeddings.word_embeddings.weight bias_path=@@cls.predictions.bias
  return logits
