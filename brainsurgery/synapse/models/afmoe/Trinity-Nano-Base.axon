{-# CHECKPOINTS "arcee-ai/Trinity-Nano-Base" #-}

{-# TASK "causal_lm" #-}

{-# MAIN "afmoe" #-}

import Activations (sigmoid, silu)

import Attention (attention, merge_heads, reshape_heads)

import Cache

import Config

import List

import Masking (Mask, causal_mask_for_input, mask_for_input, mask_length_for_input)

import Math (mul)

import MoE (grouped_swiglu_ffn_separate)

import NN

import Params (param)

import Positions (position_ids, rope_base_factors, rope_pair_base_factors)

import Tensor

MODEL_DIM <- (1024 :: Dim)

FFN <- (3072 :: Dim)

MOE_FFN <- (256 :: Dim)

NUM_LAYERS <- (56 :: Dim)

NUM_DENSE <- (2 :: Dim)

NUM_HEADS <- (8 :: Dim)

KV_HEADS <- (2 :: Dim)

HEAD_DIM <- Config.dim @@head_dim default=(MODEL_DIM / NUM_HEADS)

QD <- NUM_HEADS * HEAD_DIM

KVD <- KV_HEADS * HEAD_DIM

VOCAB_SIZE <- (200192 :: Dim)

MAX_POSITIONS <- (131072 :: Dim)

SLIDING_WINDOW <- (2048 :: Dim)

EPS <- 1e-05

THETA <- 10000.0

ATTENTION_BIAS <- false

NUM_EXPERTS <- (128 :: Dim)

TOP_K <- (8 :: Dim)

NUM_SHARED <- (1 :: Dim)

ROUTE_SCALE <- 2.826

TIE <- false

LAYER_TYPES <- ((["sliding_attention", "sliding_attention", "sliding_attention", "full_attention", "sliding_attention", "sliding_attention", "sliding_attention", "full_attention", "sliding_attention", "sliding_attention", "sliding_attention", "full_attention", "sliding_attention", "sliding_attention", "sliding_attention", "full_attention", "sliding_attention", "sliding_attention", "sliding_attention", "full_attention", "sliding_attention", "sliding_attention", "sliding_attention", "full_attention", "sliding_attention", "sliding_attention", "sliding_attention", "full_attention", "sliding_attention", "sliding_attention", "sliding_attention", "full_attention", "sliding_attention", "sliding_attention", "sliding_attention", "full_attention", "sliding_attention", "sliding_attention", "sliding_attention", "full_attention", "sliding_attention", "sliding_attention", "sliding_attention", "full_attention", "sliding_attention", "sliding_attention", "sliding_attention", "full_attention", "sliding_attention", "sliding_attention", "sliding_attention", "full_attention", "sliding_attention", "sliding_attention", "sliding_attention", "full_attention"]) :: List[String])

afmoe_dense :: Path -> Tensor[B,S,D] -> Dim -> Tensor[B,S,D]
afmoe_dense@path x ffn = do
  gate <- NN.linear@gate_proj x dim=ffn bias=false |> silu
  up <- NN.linear@up_proj x dim=ffn bias=false
  return gate |> mul up |> NN.linear@down_proj dim=MODEL_DIM bias=false

afmoe_sparse :: Tensor[B,S,D] -> Tensor[B,S,D]
afmoe_sparse x = do
  logits <- NN.linear@router.gate x dim=NUM_EXPERTS bias=false
  scores <- logits |> sigmoid
  choice <- scores + (param @expert_bias)
  _, indices <- Tensor.topk choice k=TOP_K dim=-1 largest=true sorted=true
  scores <- Tensor.gather scores indices dim=-1
  scores <- (scores / (Tensor.sum scores dim=-1 keepdim=true)) * ROUTE_SCALE
  scores <- Tensor.cast_like scores x
  routed <- grouped_swiglu_ffn_separate x scores indices NUM_EXPERTS MOE_FFN gate_weight=@experts.gate_proj.weight up_weight=@experts.up_proj.weight out_weight=@experts.down_proj.weight
  shared <- afmoe_dense@shared_experts x ffn=(MOE_FFN * NUM_SHARED)
  return routed + shared

afmoe_block :: Tensor[B,S,D] -> Int -> Tensor[B,1,S,R] -> Tensor[B,1,S,R] -> Tensor[B,1,S,K] -> Tensor[B,1,S,K] -> ?CacheLayer[B,KV_HEADS,P,MAX_POSITIONS,HEAD_DIM] -> (Tensor[B,S,D], ?CacheLayer[B,KV_HEADS,K,MAX_POSITIONS,HEAD_DIM])
afmoe_block x layer rope_sin rope_cos sliding_mask full_mask past_kv = do
  layer_type <- List.index LAYER_TYPES layer
  sliding <- layer_type == "sliding_attention"
  sparse <- layer >= NUM_DENSE
  mask <- sliding ? sliding_mask : full_mask
  xn <- NN.rmsnorm@input_layernorm x eps=EPS cast_float=true
  a, new_kv <- scope@self_attn do
    q <- NN.linear@q_proj xn dim=QD bias=ATTENTION_BIAS |> reshape_heads heads=NUM_HEADS
    k <- NN.linear@k_proj xn dim=KVD bias=ATTENTION_BIAS |> reshape_heads heads=KV_HEADS
    v <- NN.linear@v_proj xn dim=KVD bias=ATTENTION_BIAS |> reshape_heads heads=KV_HEADS
    gate <- NN.linear@gate_proj xn dim=QD bias=false
    q <- NN.rmsnorm@q_norm q eps=EPS dim=HEAD_DIM cast_float=true
    k <- NN.rmsnorm@k_norm k eps=EPS dim=HEAD_DIM cast_float=true
    q, k <- sliding ? (rope_pair_base_factors q k rope_sin rope_cos) : (q, k)
    k, v, new_kv <- Cache.update past_kv k v
    k <- Tensor.repeat k repeats=(NUM_HEADS / KV_HEADS)
    v <- Tensor.repeat v repeats=(NUM_HEADS / KV_HEADS)
    a <- attention q k v mask |> merge_heads
    a <- a * (gate |> sigmoid)
    a <- NN.linear@o_proj a dim=MODEL_DIM bias=ATTENTION_BIAS
    return a, new_kv
  a <- NN.rmsnorm@post_attention_layernorm a eps=EPS cast_float=true
  x <- x + a
  xn <- NN.rmsnorm@pre_mlp_layernorm x eps=EPS cast_float=true
  m <- scope@mlp do
    return sparse
            ? (afmoe_sparse xn)
            : do
                gate <- NN.linear@gate_proj xn dim=FFN bias=false |> silu
                up <- NN.linear@up_proj xn dim=FFN bias=false
                return gate |> mul up |> NN.linear@down_proj dim=MODEL_DIM bias=false
  m <- NN.rmsnorm@post_mlp_layernorm m eps=EPS cast_float=true
  return x + m, new_kv

afmoe :: TokenIds[B,S] -> ?Mask[B,K,MAX_POSITIONS] -> ?Cache[B,KV_HEADS,P,MAX_POSITIONS,HEAD_DIM] -> ?Bool -> (Tensor[B,S,V], ?Cache[B,KV_HEADS,K,MAX_POSITIONS,HEAD_DIM])
afmoe input_ids attn_mask past_kv use_cache = do
  past_length <- Cache.past_length past_kv
  attn_mask <- mask_for_input input_ids attn_mask MAX_POSITIONS
  pos_ids <- position_ids input_ids attn_mask=attn_mask past_length=past_length pad_fill=1
  rope_sin, rope_cos <- rope_base_factors pos_ids HEAD_DIM THETA
  key_len <- mask_length_for_input input_ids attn_mask past_length
  sliding_mask <- causal_mask_for_input input_ids key_len padding_mask=attn_mask window=SLIDING_WINDOW
  full_mask <- causal_mask_for_input input_ids key_len padding_mask=attn_mask window=MAX_POSITIONS
  work_kv <- Cache.prepare past_kv use_cache MAX_POSITIONS
  read_kv <- Cache.read past_kv work_kv
  x, work_kv <- scope@model do
    x <- NN.embedding@embed_tokens input_ids dim=MODEL_DIM
    x, work_kv <- for@layers i <- [0..NUM_LAYERS) carry (x, work_kv) do
      past_i <- Cache.index read_kv i
      x, new_i <- afmoe_block x i rope_sin rope_cos sliding_mask full_mask past_i
      work_kv <- Cache.append work_kv new_i
      yield x, work_kv
    x <- NN.rmsnorm@norm x eps=EPS cast_float=true
    return x, work_kv
  new_kv <- Cache.finish work_kv key_len
  new_kv <- use_cache ? new_kv : null
  logits <- TIE ? (NN.linear@model.embed_tokens x dim=VOCAB_SIZE bias=false) : (NN.linear@@lm_head x dim=VOCAB_SIZE bias=false)
  return logits, new_kv
