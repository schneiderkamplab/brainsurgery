{-# CHECKPOINTS "facebook/opt-6.7b" #-}
{-# TASK "causal_lm" #-}

import Activations
import Activations (relu)
import Attention
import Attention (attention, merge_heads, reshape_heads)
import Masking
import Masking (causal_mask)
import Params
import Params (has_root)
import Positions
import Positions (position_ids)
import Cache
import NN

HAS_LM_HEAD = has_root "lm_head"
HAS_DECODER_ROOT = has_root "decoder.embed_tokens"

opt_ln :: Path -> Tensor -> Tensor
opt_ln@path x = NN.layernorm@path x eps=1e-05

opt_act :: Tensor -> Tensor
opt_act x = (relu x)

opt_block :: Tensor[B,S,D] -> ?Tensor[B,S] -> ?CacheLayer -> (Tensor[B,S,D], ?CacheLayer)
opt_block x attn_mask past_kv = do
  xn <- (opt_ln@self_attn_layer_norm x)
  a, new_kv <- scope@self_attn do
    q <- NN.linear@q_proj xn dim=4096 bias=true |> reshape_heads heads=32
    q <- q * 0.08838834764831843
    k <- NN.linear@k_proj xn dim=4096 bias=true |> reshape_heads heads=32
    v <- NN.linear@v_proj xn dim=4096 bias=true |> reshape_heads heads=32
    k, v, new_kv <- Cache.update past_kv k v
    mask <- causal_mask q k window=2048 padding_mask=attn_mask
    a <- attention q k v mask scale=1.0 |> merge_heads |> NN.linear@out_proj dim=4096 bias=true
    return a, new_kv
  x <- x + a
  x <- x
  xn2 <- (opt_ln@final_layer_norm x)
  h <- NN.linear@fc1 xn2 dim=16384 bias=true
  m <- opt_act h |> NN.linear@fc2 dim=4096 bias=true
  x <- x + m
  x <- x
  return x, new_kv

opt_decode_model :: TokenIds[B,S] -> Tensor[B,S] -> ?Tensor[B,S] -> ?Cache -> ?Bool -> (Tensor[B,S,D], ?Cache)
opt_decode_model input_ids pos_ids attn_mask past_kv use_cache = do
  x, new_kv <- scope@model.decoder do
    tok <- NN.embedding@embed_tokens input_ids dim=4096
    pos <- NN.embedding@embed_positions pos_ids dim=4096
    x <- tok + pos
    new_kv <- use_cache ? Cache.init : null
    for@layers i <- [0..32) do
      past_i <- Cache.index past_kv i
      x, new_i <- opt_block x attn_mask past_i
      new_kv <- Cache.append new_kv new_i
      yield x, new_kv
    x <- (opt_ln@final_layer_norm x)
    return x, new_kv
  return x, new_kv

opt_decode_decoder :: TokenIds[B,S] -> Tensor[B,S] -> ?Tensor[B,S] -> ?Cache -> ?Bool -> (Tensor[B,S,D], ?Cache)
opt_decode_decoder input_ids pos_ids attn_mask past_kv use_cache = do
  x, new_kv <- scope@decoder do
    tok <- NN.embedding@embed_tokens input_ids dim=4096
    pos <- NN.embedding@embed_positions pos_ids dim=4096
    x <- tok + pos
    new_kv <- use_cache ? Cache.init : null
    for@layers i <- [0..32) do
      past_i <- Cache.index past_kv i
      x, new_i <- opt_block x attn_mask past_i
      new_kv <- Cache.append new_kv new_i
      yield x, new_kv
    x <- (opt_ln@final_layer_norm x)
    return x, new_kv
  return x, new_kv

opt :: TokenIds[B,S] -> ?Tensor[B,S] -> ?Cache -> ?Bool -> (Tensor[B,S,V], ?Cache)
opt input_ids attn_mask past_kv use_cache = do
  pos_ids <- position_ids input_ids attn_mask=attn_mask past_length=(Cache.past_length past_kv) pad_fill=-1
  pos_ids <- pos_ids + 2
  x, new_kv <- HAS_DECODER_ROOT ? (opt_decode_decoder input_ids pos_ids attn_mask past_kv use_cache) : (opt_decode_model input_ids pos_ids attn_mask past_kv use_cache)
  logits <- HAS_LM_HEAD ? (NN.linear@lm_head x dim=50272 bias=false) : (HAS_DECODER_ROOT ? (NN.linear@decoder.embed_tokens x dim=50272) : (NN.linear@model.decoder.embed_tokens x dim=50272))
  return logits, new_kv
