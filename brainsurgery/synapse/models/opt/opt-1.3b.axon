{-# CHECKPOINTS "facebook/opt-1.3b" #-}
{-# TASK "causal_lm" #-}

import Activations
import Activations (relu)
import Cache
import Cache
import Attention (reshape_heads, merge_heads)
import Compat (attention)
import Masking (causal_mask)
import Positions (position_ids)

D = 2048
V = 50272
L = 24
H = 32
FFN = 8192
EPS = 1e-05
C = 2048
DO_PRE_LN = true
ACT = "relu"
ATTN_SCALE = 0.125
HAS_LM_HEAD = true
HAS_DECODER_ROOT = false

opt_ln :: @Path -> Tensor -> Tensor
opt_ln@path x = NN.layernorm@path x eps=EPS

opt_act :: Tensor -> Tensor
opt_act x = (ACT == "relu") ? (relu x) : (relu x)

opt_block :: Tensor[B,S,D] -> ?Tensor[B,S] -> ?CacheLayer -> (Tensor[B,S,D], ?CacheLayer)
opt_block x attn_mask past_kv = do
  xn <- DO_PRE_LN ? (opt_ln@self_attn_layer_norm x) : x
  a, new_kv <- scope@self_attn do
    q <- NN.linear@q_proj xn dim=D bias=true |> reshape_heads heads=H
    q <- q * ATTN_SCALE
    k <- NN.linear@k_proj xn dim=D bias=true |> reshape_heads heads=H
    v <- NN.linear@v_proj xn dim=D bias=true |> reshape_heads heads=H
    k, v, new_kv <- Cache.update past_kv k v
    mask <- causal_mask q k window=C padding_mask=attn_mask
    a <- attention q k v mask=mask scale=1.0 eager=true |> merge_heads |> NN.linear@out_proj dim=D bias=true
    return a, new_kv
  x <- x + a
  x <- DO_PRE_LN ? x : (opt_ln@self_attn_layer_norm x)
  xn2 <- DO_PRE_LN ? (opt_ln@final_layer_norm x) : x
  h <- NN.linear@fc1 xn2 dim=FFN bias=true
  m <- opt_act h |> NN.linear@fc2 dim=D bias=true
  x <- x + m
  x <- DO_PRE_LN ? x : (opt_ln@final_layer_norm x)
  return x, new_kv

opt_decode_model :: TokenIds[B,S] -> Tensor[B,S] -> ?Tensor[B,S] -> ?Cache -> ?Bool -> (Tensor[B,S,D], ?Cache)
opt_decode_model input_ids pos_ids attn_mask past_kv use_cache = do
  x, new_kv <- scope@model.decoder do
    tok <- NN.embedding@embed_tokens input_ids dim=D
    pos <- NN.embedding@embed_positions pos_ids dim=D
    x <- tok + pos
    new_kv <- use_cache ? Cache.init : null
    for@layers i <- [0..L) do
      past_i <- Cache.index past_kv i
      x, new_i <- opt_block x attn_mask past_i
      new_kv <- Cache.append new_kv new_i
    x <- DO_PRE_LN ? (opt_ln@final_layer_norm x) : x
    return x, new_kv
  return x, new_kv

opt_decode_decoder :: TokenIds[B,S] -> Tensor[B,S] -> ?Tensor[B,S] -> ?Cache -> ?Bool -> (Tensor[B,S,D], ?Cache)
opt_decode_decoder input_ids pos_ids attn_mask past_kv use_cache = do
  x, new_kv <- scope@decoder do
    tok <- NN.embedding@embed_tokens input_ids dim=D
    pos <- NN.embedding@embed_positions pos_ids dim=D
    x <- tok + pos
    new_kv <- use_cache ? Cache.init : null
    for@layers i <- [0..L) do
      past_i <- Cache.index past_kv i
      x, new_i <- opt_block x attn_mask past_i
      new_kv <- Cache.append new_kv new_i
    x <- DO_PRE_LN ? (opt_ln@final_layer_norm x) : x
    return x, new_kv
  return x, new_kv

opt :: TokenIds[B,S] -> ?Tensor[B,S] -> ?Cache -> ?Bool -> (Tensor[B,S,V], ?Cache)
opt input_ids attn_mask past_kv use_cache = do
  pos_ids <- position_ids input_ids attn_mask=attn_mask past_length=(Cache.past_length past_kv) pad_fill=-1
  pos_ids <- pos_ids + 2
  x, new_kv <- HAS_DECODER_ROOT ? (opt_decode_decoder input_ids pos_ids attn_mask past_kv use_cache) : (opt_decode_model input_ids pos_ids attn_mask past_kv use_cache)
  logits <- HAS_LM_HEAD ? (NN.linear@lm_head x dim=V bias=false) : (HAS_DECODER_ROOT ? (NN.linear@decoder.embed_tokens x dim=V) : (NN.linear@model.decoder.embed_tokens x dim=V))
  return logits, new_kv
