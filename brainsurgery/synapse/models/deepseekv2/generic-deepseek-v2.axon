import Math
{-# CHECKPOINTS ["deepseek-ai/DeepSeek-V2-Lite", "deepseek-ai/DeepSeek-V2-Lite-Chat", "deepseek-ai/DeepSeek-Coder-V2-Lite-Base", "deepseek-ai/DeepSeek-Coder-V2-Lite-Instruct"] #-}
{-# TASK "causal_lm" #-}

import Config
import Activations silu
import Cache past_length
import Cache
import MoE

D     = Config.int "hidden_size" default=2048
V     = Config.int "vocab_size" default=102400
L     = Config.int "num_hidden_layers" default=27
H     = Config.int "num_attention_heads" default=16
QKNOPE = Config.int "qk_nope_head_dim" default=128
QKROPE = Config.int "qk_rope_head_dim" default=64
VHD   = Config.int "v_head_dim" default=128
QHD   = Config.int "q_head_dim" default=192
KVR   = Config.int "kv_lora_rank" default=512
KVPROJ = Config.int "kv_proj_dim" default=4096
FFN   = Config.int "intermediate_size" default=10944
E     = Config.int "n_routed_experts" default=64
EPT   = Config.int "num_experts_per_tok" default=6
EM    = Config.int "moe_intermediate_size" default=1408
SE    = Config.int "n_shared_experts" default=2
EPS   = Config.float "rms_norm_eps" default=1e-06
THETA = Config.float "rope_theta" default=10000.0
C     = Config.int "max_position_embeddings" default=163840
FIRST_DENSE = Config.int "first_k_dense_replace" default=1
ROPE_SCALE = Config.float "factor" root="rope_scaling" default=40.0
ROPE_BETA_FAST = Config.float "beta_fast" root="rope_scaling" default=32.0
ROPE_BETA_SLOW = Config.float "beta_slow" root="rope_scaling" default=1.0
ROPE_MSCALE = Config.float "mscale" root="rope_scaling" default=0.707
ROPE_MSCALE_ALL_DIM = Config.float "mscale_all_dim" root="rope_scaling" default=0.707
ROPE_CONTEXT = Config.int "original_max_position_embeddings" root="rope_scaling" default=4096
ATTN_SCALE = 1.0 / Math.sqrt (Config.int "q_head_dim" default=192)

rms :: @Path -> Tensor[B,S,D] -> Tensor[B,S,D]
rms@path x = rmsnorm@path x eps=EPS cast_float=true

deepseek_v2_attn :: Tensor[B,S,D] -> Tensor[B,S] -> ?Tensor[B,S] -> ?CacheLayer -> (Tensor[B,S,D], ?CacheLayer)
deepseek_v2_attn x pos_ids attn_mask past_kv = do
  a, new_kv <- scope@self_attn do
    q <- linear@q_proj x dim=(H * QHD) bias=false |> reshape_heads heads=H
    q_nope, q_pe <- split q sizes=[QKNOPE, QKROPE]

    kv_comp <- linear@kv_a_proj_with_mqa x dim=(KVR + QKROPE) bias=false
    kv_latent, k_pe_base <- split kv_comp sizes=[KVR, QKROPE]
    kv_latent <- rms@kv_a_layernorm kv_latent
    kv <- linear@kv_b_proj kv_latent dim=KVPROJ bias=false |> reshape_heads heads=H
    k_nope, v <- split kv sizes=[QKNOPE, VHD]

    k_pe <- reshape_heads k_pe_base heads=1 |> repeat repeats=H
    q_pe, k_pe <- rope_pair_yarn q_pe k_pe pos_ids THETA ROPE_SCALE ROPE_BETA_FAST ROPE_BETA_SLOW ROPE_CONTEXT mscale=ROPE_MSCALE mscale_all_dim=ROPE_MSCALE_ALL_DIM interleaved=true
    q_full <- concat q_nope q_pe dim=-1
    k_full <- concat k_nope k_pe dim=-1

    k_all, v_all, new_kv <- Cache.update past_kv k_full v
    mask <- causal_mask q_full k_all window=C padding_mask=attn_mask
    a <- attention q_full k_all v_all mask=mask scale=ATTN_SCALE eager=true |> merge_heads
    a <- linear@o_proj a dim=D bias=false
    return a, new_kv
  return a, new_kv

deepseek_v2_dense_block :: Tensor[B,S,D] -> Tensor[B,S] -> ?Tensor[B,S] -> ?CacheLayer -> (Tensor[B,S,D], ?CacheLayer)
deepseek_v2_dense_block x pos_ids attn_mask past_kv = do
  xn <- rms@input_layernorm x
  a, new_kv <- deepseek_v2_attn xn pos_ids attn_mask past_kv
  x <- x + a
  xn <- rms@post_attention_layernorm x
  m <- scope@mlp do
    gate <- linear@gate_proj xn dim=FFN bias=false
    up <- linear@up_proj xn dim=FFN bias=false
    return gate |> silu |> Math.mul up |> linear@down_proj dim=D bias=false
  return x + m, new_kv

deepseek_v2_moe_block :: Tensor[B,S,D] -> Tensor[B,S] -> ?Tensor[B,S] -> ?CacheLayer -> (Tensor[B,S,D], ?CacheLayer)
deepseek_v2_moe_block x pos_ids attn_mask past_kv = do
  xn <- rms@input_layernorm x
  a, new_kv <- deepseek_v2_attn xn pos_ids attn_mask past_kv
  x <- x + a
  xn <- rms@post_attention_layernorm x
  m <- scope@mlp do
    shared <- scope@shared_experts do
      gate <- linear@gate_proj xn dim=(EM * SE) bias=false
      up <- linear@up_proj xn dim=(EM * SE) bias=false
      return gate |> silu |> Math.mul up |> linear@down_proj dim=D bias=false
    topk_scores, topk_indices <- linear@gate xn dim=E bias=false |>
      softmax dim=-1 dtype="float32" |> topk k=EPT dim=-1 sorted=false
    routed <- zeros_like xn
    for@experts e <- [0..E) do
      x_sel, token_idx, topk_pos, sel_scores <- MoE.select xn topk_scores topk_indices e
      gate <- linear@gate_proj x_sel dim=EM bias=false
      up <- linear@up_proj x_sel dim=EM bias=false
      x_upd <- gate |> silu |> Math.mul up |> linear@down_proj dim=D bias=false
      routed <- MoE.scatter_add routed token_idx x_upd sel_scores
    return shared + routed
  return x + m, new_kv

deepseek_v2_lite :: TokenIds[B,S] -> ?Tensor[B,S] -> ?Cache -> ?Bool -> (Tensor[B,S,V], ?Cache)
deepseek_v2_lite input_ids attn_mask past_kv use_cache = do
  pos_ids <- position_ids input_ids attn_mask=attn_mask past_length=(past_length past_kv)
  x, new_kv <- scope@model do
    x <- embedding@embed_tokens input_ids dim=D
    new_kv <- use_cache ? Cache.init : null
    for@layers i <- [0..FIRST_DENSE) do
      past_i <- Cache.index past_kv i
      x, new_i <- deepseek_v2_dense_block x pos_ids attn_mask past_i
      new_kv <- Cache.append new_kv new_i
    for@layers i <- [FIRST_DENSE..L) do
      past_i <- Cache.index past_kv i
      x, new_i <- deepseek_v2_moe_block x pos_ids attn_mask past_i
      new_kv <- Cache.append new_kv new_i
    x <- rms@norm x
    return x, new_kv
  logits <- linear@lm_head x dim=V bias=false
  return logits, new_kv
