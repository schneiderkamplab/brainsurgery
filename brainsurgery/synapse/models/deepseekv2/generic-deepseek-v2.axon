{-# CHECKPOINTS ["deepseek-ai/DeepSeek-V2-Lite", "deepseek-ai/DeepSeek-V2-Lite-Chat", "deepseek-ai/DeepSeek-Coder-V2-Lite-Base", "deepseek-ai/DeepSeek-Coder-V2-Lite-Instruct"] #-}
{-# TASK "causal_lm" #-}

import Activations (silu)
import Attention (attention, merge_heads, reshape_heads)
import Masking (causal_mask)
import Math (mul, sqrt)
import MoE (scatter_add, select)
import Positions (position_ids, rope_pair_yarn)
import Cache
import Config
import NN
import Tensor



MODEL_DIM     = Config.int @@hidden_size default=2048
VOCAB_SIZE     = Config.int @@vocab_size default=102400
NUM_LAYERS     = Config.int @@num_hidden_layers default=27
NUM_HEADS     = Config.int @@num_attention_heads default=16
QKNOPE = Config.int @@qk_nope_head_dim default=128
QKROPE = Config.int @@qk_rope_head_dim default=64
VHD   = Config.int @@v_head_dim default=128
QHD   = Config.int @@q_head_dim default=192
KVR   = Config.int @@kv_lora_rank default=512
KVPROJ = Config.int @@kv_proj_dim default=4096
FFN   = Config.int @@intermediate_size default=10944
E     = Config.int @@n_routed_experts default=64
EPT   = Config.int @@num_experts_per_tok default=6
EM    = Config.int @@moe_intermediate_size default=1408
SE    = Config.int @@n_shared_experts default=2
EPS   = Config.float @@rms_norm_eps default=1e-06
THETA = Config.float @@rope_theta default=10000.0
MAX_POSITIONS     = Config.int @@max_position_embeddings default=163840
FIRST_DENSE = Config.int @@first_k_dense_replace default=1
ROPE_SCALE = Config.float @@'rope_scaling.factor' default=40.0
ROPE_BETA_FAST = Config.float @@'rope_scaling.beta_fast' default=32.0
ROPE_BETA_SLOW = Config.float @@'rope_scaling.beta_slow' default=1.0
ROPE_MSCALE = Config.float @@'rope_scaling.mscale' default=0.707
ROPE_MSCALE_ALL_DIM = Config.float @@'rope_scaling.mscale_all_dim' default=0.707
ROPE_CONTEXT = Config.int @@'rope_scaling.original_max_position_embeddings' default=4096
ATTN_SCALE = 1.0 / sqrt (Config.int @@q_head_dim default=192)

rms :: Path -> Tensor[B,S,D] -> Tensor[B,S,D]
rms@path x = NN.rmsnorm@path x eps=EPS cast_float=true

deepseek_v2_attn :: Tensor[B,S,D] -> Tensor[B,S] -> ?Tensor[B,K] -> ?CacheLayerKV[B,NUM_HEADS,P,QHD,VHD] -> (Tensor[B,S,D], ?CacheLayerKV[B,NUM_HEADS,K,QHD,VHD])
deepseek_v2_attn x pos_ids attn_mask past_kv = do
  a, new_kv <- scope@self_attn do
    q <- NN.linear@q_proj x dim=(NUM_HEADS * QHD) bias=false |> reshape_heads heads=NUM_HEADS
    q_nope, q_pe <- Tensor.split q sizes=[QKNOPE, QKROPE]

    kv_comp <- NN.linear@kv_a_proj_with_mqa x dim=(KVR + QKROPE) bias=false
    kv_latent, k_pe_base <- Tensor.split kv_comp sizes=[KVR, QKROPE]
    kv_latent <- rms@kv_a_layernorm kv_latent
    kv <- NN.linear@kv_b_proj kv_latent dim=KVPROJ bias=false |> reshape_heads heads=NUM_HEADS
    k_nope, v <- Tensor.split kv sizes=[QKNOPE, VHD]

    k_pe <- reshape_heads k_pe_base heads=1 |> Tensor.repeat repeats=NUM_HEADS
    q_pe, k_pe <- rope_pair_yarn q_pe k_pe pos_ids THETA ROPE_SCALE ROPE_BETA_FAST ROPE_BETA_SLOW ROPE_CONTEXT mscale=ROPE_MSCALE mscale_all_dim=ROPE_MSCALE_ALL_DIM interleaved=true
    q_full <- Tensor.concat q_nope q_pe dim=-1
    k_full <- Tensor.concat k_nope k_pe dim=-1

    k_all, v_all, new_kv <- Cache.update_kv past_kv k_full v
    mask <- causal_mask q_full k_all window=MAX_POSITIONS padding_mask=attn_mask
    a <- attention q_full k_all v_all mask scale=ATTN_SCALE |> merge_heads
    a <- NN.linear@o_proj a dim=MODEL_DIM bias=false
    return a, new_kv
  return a, new_kv

deepseek_v2_dense_block :: Tensor[B,S,D] -> Tensor[B,S] -> ?Tensor[B,K] -> ?CacheLayerKV[B,NUM_HEADS,P,QHD,VHD] -> (Tensor[B,S,D], ?CacheLayerKV[B,NUM_HEADS,K,QHD,VHD])
deepseek_v2_dense_block x pos_ids attn_mask past_kv = do
  xn <- rms@input_layernorm x
  a, new_kv <- deepseek_v2_attn xn pos_ids attn_mask past_kv
  x <- x + a
  xn <- rms@post_attention_layernorm x
  m <- scope@mlp do
    gate <- NN.linear@gate_proj xn dim=FFN bias=false
    up <- NN.linear@up_proj xn dim=FFN bias=false
    return gate |> silu |> mul up |> NN.linear@down_proj dim=MODEL_DIM bias=false
  return x + m, new_kv

deepseek_v2_moe_block :: Tensor[B,S,D] -> Tensor[B,S] -> ?Tensor[B,K] -> ?CacheLayerKV[B,NUM_HEADS,P,QHD,VHD] -> (Tensor[B,S,D], ?CacheLayerKV[B,NUM_HEADS,K,QHD,VHD])
deepseek_v2_moe_block x pos_ids attn_mask past_kv = do
  xn <- rms@input_layernorm x
  a, new_kv <- deepseek_v2_attn xn pos_ids attn_mask past_kv
  x <- x + a
  xn <- rms@post_attention_layernorm x
  m <- scope@mlp do
    shared <- scope@shared_experts do
      gate <- NN.linear@gate_proj xn dim=(EM * SE) bias=false
      up <- NN.linear@up_proj xn dim=(EM * SE) bias=false
      return gate |> silu |> mul up |> NN.linear@down_proj dim=MODEL_DIM bias=false
    topk_scores, topk_indices <- NN.linear@gate xn dim=E bias=false |>
      Tensor.softmax dim=-1 dtype="float32" |> Tensor.topk k=EPT dim=-1 sorted=false
    routed <- Tensor.zeros_like xn
    routed <- for@experts e <- [0..E) carry (routed) do
      x_sel, token_idx, topk_pos, sel_scores <- select xn topk_scores topk_indices e
      gate <- NN.linear@gate_proj x_sel dim=EM bias=false
      up <- NN.linear@up_proj x_sel dim=EM bias=false
      x_upd <- gate |> silu |> mul up |> NN.linear@down_proj dim=MODEL_DIM bias=false
      routed <- scatter_add routed token_idx x_upd sel_scores
      yield routed
    return shared + routed
  return x + m, new_kv

deepseek_v2_lite :: TokenIds[B,S] -> ?Tensor[B,K] -> ?CacheKV[B,NUM_HEADS,P,QHD,VHD] -> ?Bool -> (Tensor[B,S,V], ?CacheKV[B,NUM_HEADS,K,QHD,VHD])
deepseek_v2_lite input_ids attn_mask past_kv use_cache = do
  pos_ids <- position_ids input_ids attn_mask=attn_mask past_length=(Cache.past_length_kv past_kv)
  x, new_kv <- scope@model do
    x <- NN.embedding@embed_tokens input_ids dim=MODEL_DIM
    new_kv <- use_cache ? Cache.init_kv : null
    x, new_kv <- for@layers i <- [0..FIRST_DENSE) carry (x, new_kv) do
      past_i <- Cache.index_kv past_kv i
      x, new_i <- deepseek_v2_dense_block x pos_ids attn_mask past_i
      new_kv <- Cache.append_kv new_kv new_i
      yield x, new_kv
    x, new_kv <- for@layers i <- [FIRST_DENSE..NUM_LAYERS) carry (x, new_kv) do
      past_i <- Cache.index_kv past_kv i
      x, new_i <- deepseek_v2_moe_block x pos_ids attn_mask past_i
      new_kv <- Cache.append_kv new_kv new_i
      yield x, new_kv
    x <- rms@norm x
    return x, new_kv
  logits <- NN.linear@lm_head x dim=VOCAB_SIZE bias=false
  return logits, new_kv
