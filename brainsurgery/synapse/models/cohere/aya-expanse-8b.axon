{-# CHECKPOINTS "CohereLabs/aya-expanse-8b" #-}
{-# TASK "causal_lm" #-}

import Activations
import Activations (silu)
import Attention
import Attention (attention, merge_heads, reshape_heads)
import Masking
import Masking (causal_mask)
import Math
import Math (mul, sqrt)
import Params
import Params (has_root)
import Positions
import Positions (position_ids, rope_pair_base)
import Cache
import NN
import Tensor

HAS_LM_HEAD = has_root "lm_head"

cohere_ln :: Path -> Tensor[B,S,D] -> Tensor[B,S,D]
cohere_ln@path x = NN.layernorm@path x eps=1e-05 bias=false

cohere_block :: Tensor[B,S,D] -> Tensor[B,S] -> ?Tensor[B,K] -> ?CacheLayer[B,8,P,128] -> (Tensor[B,S,D], ?CacheLayer[B,8,K,128])
cohere_block x pos_ids attn_mask past_kv = do
  xn <- cohere_ln@input_layernorm x
  a, new_kv <- scope@self_attn do
    q <- NN.linear@q_proj xn dim=4096 bias=false |> reshape_heads heads=32
    k <- NN.linear@k_proj xn dim=1024 bias=false |> reshape_heads heads=8
    v <- NN.linear@v_proj xn dim=1024 bias=false |> reshape_heads heads=8
    q, k <- rope_pair_base q k pos_ids theta=10000.0 interleaved=true
    k, v, new_kv <- Cache.update past_kv k v
    k <- Tensor.repeat k repeats=4
    v <- Tensor.repeat v repeats=4
    mask <- causal_mask q k window=8192 padding_mask=attn_mask
    a <- attention q k v mask |> merge_heads |> NN.linear@o_proj dim=4096 bias=false
    return a, new_kv
  m <- scope@mlp do
    g <- NN.linear@gate_proj xn dim=14336 bias=false
    u <- NN.linear@up_proj xn dim=14336 bias=false
    return g |> silu |> mul u |> NN.linear@down_proj dim=4096 bias=false
  return x + a + m, new_kv

cohere :: TokenIds[B,S] -> ?Tensor[B,K] -> ?Cache[B,8,P,128] -> ?Bool -> (Tensor[B,S,V], ?Cache[B,8,K,128])
cohere input_ids attn_mask past_kv use_cache = do
  pos_ids <- position_ids input_ids past_length=(Cache.past_length past_kv)
  x, new_kv <- scope@model do
    x <- NN.embedding@embed_tokens input_ids dim=4096
    new_kv <- use_cache ? Cache.init : null
    for@layers i <- [0..32) do
      past_i <- Cache.index past_kv i
      x, new_i <- cohere_block x pos_ids attn_mask past_i
      new_kv <- Cache.append new_kv new_i
      yield x, new_kv
    x <- cohere_ln@norm x
    return x, new_kv
  logits <- HAS_LM_HEAD ? (NN.linear@lm_head x dim=256000) : (NN.linear@model.embed_tokens x dim=256000)
  logits <- logits * 0.125
  return logits, new_kv
