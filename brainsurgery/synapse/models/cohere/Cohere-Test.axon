{-# CHECKPOINTS "test/Cohere-Test" #-}

{-# TASK "causal_lm" #-}

{-# MAIN "cohere" #-}

import Activations (silu)

import Attention (attention, merge_heads, reshape_heads)

import Masking (Mask, causal_mask_for_input, mask_for_input, mask_length_for_input)

import Math (mul, sqrt)

import Params (has_root)

import Positions (position_ids, rope_base_factors, rope_pair_base_factors)

import Cache

import Config

import NN

import Tensor

MODEL_DIM = 128

VOCAB_SIZE = 255029

NUM_LAYERS = 4

NUM_HEADS = 4

KVH = 2

HAS_HEAD_DIM = false

MODEL_HEAD_DIM = HAS_HEAD_DIM ? (128) : (MODEL_DIM / NUM_HEADS)

QD = NUM_HEADS * MODEL_HEAD_DIM

KVD = KVH * MODEL_HEAD_DIM

FFN = 256

EPS = 1e-05

THETA = 10000.0

MAX_POSITIONS = 512

LOGIT_SCALE = 0.125

ATTN_SCALE = 1.0 / sqrt MODEL_HEAD_DIM

HAS_LM_HEAD = has_root "lm_head"

cohere_ln :: Path -> Tensor[B,S,D] -> Tensor[B,S,D]
cohere_ln@path x = NN.layernorm@path x eps=EPS bias=false

cohere_block :: Tensor[B,S,D] -> Tensor[B,1,S,R] -> Tensor[B,1,S,R] -> Tensor[B,1,S,K] -> ?CacheLayer[B,KVH,P,MAX_POSITIONS,DH] -> (Tensor[B,S,D], ?CacheLayer[B,KVH,K,MAX_POSITIONS,DH])
cohere_block x rope_sin rope_cos mask past_kv = do
  xn <- cohere_ln@input_layernorm x
  a, new_kv <- scope@self_attn do
    q <- NN.linear@q_proj xn dim=(NUM_HEADS * MODEL_HEAD_DIM) bias=false |> reshape_heads heads=NUM_HEADS
    k <- NN.linear@k_proj xn dim=(KVH * MODEL_HEAD_DIM) bias=false |> reshape_heads heads=KVH
    v <- NN.linear@v_proj xn dim=(KVH * MODEL_HEAD_DIM) bias=false |> reshape_heads heads=KVH
    q, k <- rope_pair_base_factors q k rope_sin rope_cos interleaved=true
    k, v, new_kv <- Cache.update past_kv k v
    k <- Tensor.repeat k repeats=(NUM_HEADS / KVH)
    v <- Tensor.repeat v repeats=(NUM_HEADS / KVH)
    a <- attention q k v mask |> merge_heads |> NN.linear@o_proj dim=MODEL_DIM bias=false
    return a, new_kv
  m <- scope@mlp do
    g <- NN.linear@gate_proj xn dim=FFN bias=false
    u <- NN.linear@up_proj xn dim=FFN bias=false
    return g |> silu |> mul u |> NN.linear@down_proj dim=MODEL_DIM bias=false
  return x + a + m, new_kv

cohere :: TokenIds[B,S] -> ?Mask[B,K,MAX_POSITIONS] -> ?Cache[B,KVH,P,MAX_POSITIONS,DH] -> ?Bool -> (Tensor[B,S,V], ?Cache[B,KVH,K,MAX_POSITIONS,DH])
cohere input_ids attn_mask past_kv use_cache = do
  past_length <- Cache.past_length past_kv
  attn_mask <- mask_for_input input_ids attn_mask MAX_POSITIONS
  pos_ids <- position_ids input_ids past_length=past_length
  rope_sin, rope_cos <- rope_base_factors pos_ids MODEL_HEAD_DIM theta=THETA interleaved=true
  key_len <- mask_length_for_input input_ids attn_mask past_length
  mask <- causal_mask_for_input input_ids key_len padding_mask=attn_mask window=MAX_POSITIONS
  work_kv <- Cache.prepare past_kv use_cache MAX_POSITIONS
  read_kv <- Cache.read past_kv work_kv
  x, new_kv <- scope@model do
    x <- NN.embedding@embed_tokens input_ids dim=MODEL_DIM
    x, work_kv <- for@layers i <- [0..NUM_LAYERS) carry (x, work_kv) do
      past_i <- Cache.index read_kv i
      x, new_i <- cohere_block x rope_sin rope_cos mask past_i
      work_kv <- Cache.append work_kv new_i
      yield x, work_kv
    x <- cohere_ln@norm x
    return x, work_kv
  new_length <- past_length + S
  new_kv <- Cache.finish new_kv new_length
  new_kv <- use_cache ? new_kv : null
  logits <- HAS_LM_HEAD ? (NN.linear@lm_head x dim=VOCAB_SIZE) : (NN.linear@model.embed_tokens x dim=VOCAB_SIZE)
  logits <- logits * LOGIT_SCALE
  return logits, new_kv
