{-# CHECKPOINTS ["CohereLabs/aya-expanse-8b", "CohereLabs/aya-expanse-32b", "test/Cohere-Test"] #-}
{-# TASK "causal_lm" #-}

import Activations (silu)
import Attention (attention, merge_heads, reshape_heads)
import Masking (causal_mask_for_input)
import Math (mul, sqrt)
import Params (has_root)
import Positions (position_ids, rope_pair_base)
import Cache
import Config
import NN
import Tensor



MODEL_DIM <- Config.int @@hidden_size default=4096
VOCAB_SIZE <- Config.int @@vocab_size default=256000
NUM_LAYERS <- Config.int @@num_hidden_layers default=40
NUM_HEADS <- Config.int @@num_attention_heads default=32
KVH <- Config.int @@num_key_value_heads default=8
HAS_HEAD_DIM <- Config.has_value @@head_dim
MODEL_HEAD_DIM <- HAS_HEAD_DIM ? (Config.int @@head_dim default=128) : (MODEL_DIM / NUM_HEADS)
QD = NUM_HEADS * MODEL_HEAD_DIM
KVD = KVH * MODEL_HEAD_DIM
FFN <- Config.int @@intermediate_size default=14336
EPS <- Config.float @@layer_norm_eps default=1e-05
THETA <- Config.float @@rope_theta default=10000.0
MAX_POSITIONS <- Config.int @@max_position_embeddings default=8192
LOGIT_SCALE <- Config.float @@logit_scale default=1.0
ATTN_SCALE = 1.0 / sqrt MODEL_HEAD_DIM
HAS_LM_HEAD = has_root "lm_head"

cohere_ln :: Path -> Tensor[B,S,D] -> Tensor[B,S,D]
cohere_ln@path x = NN.layernorm@path x eps=EPS bias=false

cohere_block :: Tensor[B,S,D] -> Tensor[B,S] -> Tensor[B,1,S,K] -> ?CacheLayer[B,KVH,P,DH] -> (Tensor[B,S,D], ?CacheLayer[B,KVH,K,DH])
cohere_block x pos_ids mask past_kv = do
  xn <- cohere_ln@input_layernorm x
  a, new_kv <- scope@self_attn do
    q <- NN.linear@q_proj xn dim=(NUM_HEADS * MODEL_HEAD_DIM) bias=false |> reshape_heads heads=NUM_HEADS
    k <- NN.linear@k_proj xn dim=(KVH * MODEL_HEAD_DIM) bias=false |> reshape_heads heads=KVH
    v <- NN.linear@v_proj xn dim=(KVH * MODEL_HEAD_DIM) bias=false |> reshape_heads heads=KVH
    q, k <- rope_pair_base q k pos_ids theta=THETA interleaved=true
    k, v, new_kv <- Cache.update past_kv k v
    k <- Tensor.repeat k repeats=(NUM_HEADS / KVH)
    v <- Tensor.repeat v repeats=(NUM_HEADS / KVH)
    a <- attention q k v mask |> merge_heads |> NN.linear@o_proj dim=MODEL_DIM bias=false
    return a, new_kv
  m <- scope@mlp do
    g <- NN.linear@gate_proj xn dim=FFN bias=false
    u <- NN.linear@up_proj xn dim=FFN bias=false
    return g |> silu |> mul u |> NN.linear@down_proj dim=MODEL_DIM bias=false
  return x + a + m, new_kv

cohere :: TokenIds[B,S] -> ?Tensor[B,K] -> ?Cache[B,KVH,P,DH] -> ?Bool -> (Tensor[B,S,V], ?Cache[B,KVH,K,DH])
cohere input_ids attn_mask past_kv use_cache = do
  past_length <- Cache.past_length past_kv
  pos_ids <- position_ids input_ids past_length=past_length
  key_len <- past_length + S
  mask <- causal_mask_for_input input_ids key_len padding_mask=attn_mask window=MAX_POSITIONS
  x, new_kv <- scope@model do
    x <- NN.embedding@embed_tokens input_ids dim=MODEL_DIM
    new_kv <- use_cache ? Cache.init : null
    x, new_kv <- for@layers i <- [0..NUM_LAYERS) carry (x, new_kv) do
      past_i <- Cache.index past_kv i
      x, new_i <- cohere_block x pos_ids mask past_i
      new_kv <- Cache.append new_kv new_i
      yield x, new_kv
    x <- cohere_ln@norm x
    return x, new_kv
  logits <- HAS_LM_HEAD ? (NN.linear@lm_head x dim=VOCAB_SIZE) : (NN.linear@model.embed_tokens x dim=VOCAB_SIZE)
  logits <- logits * LOGIT_SCALE
  return logits, new_kv
