{-# CHECKPOINTS "ai21labs/AI21-Jamba-Reasoning-3B" #-}

{-# TASK "causal_lm" #-}

{-# PADDING_SIDE "right" #-}

{-# MAIN "jamba_3b" #-}

import Activations (silu)

import Attention (attention, merge_heads, reshape_heads)

import Masking (causal_mask)

import Math (mul, sqrt)

import SSM (causal_conv1d, mamba_scan)

import Config

import NN

import Tensor

MODEL_DIM = 2560

VOCAB_SIZE = 65536

NUM_LAYERS = 28

NUM_HEADS = 20

KVH = 1

MODEL_HEAD_DIM = 128

SCALE = 1.0 / sqrt MODEL_HEAD_DIM

FF = 8192

I = MODEL_DIM * (2)

N = 16

R = 160

ATTN_PERIOD = 14

ATTN_OFFSET = 7

EPS = 1e-06

rms :: Path -> Tensor[B,S,D] -> Tensor[B,S,D]
rms@path x = NN.rmsnorm@path x eps=EPS cast_float=true

dense_ffn :: Tensor[B,S,D] -> Tensor[B,S,D]
dense_ffn x = do
  gate <- NN.linear@feed_forward.gate_proj x dim=FF
  up <- NN.linear@feed_forward.up_proj x dim=FF
  return gate |> silu |> mul up |> NN.linear@feed_forward.down_proj dim=MODEL_DIM

attn_core :: Tensor[B,S,D] -> ?Tensor[B,S] -> Tensor[B,S,D]
attn_core x attn_mask = do
  x_norm <- rms@input_layernorm x
  q <- NN.linear@self_attn.q_proj x_norm dim=(NUM_HEADS * MODEL_HEAD_DIM) |> reshape_heads heads=NUM_HEADS
  k <- NN.linear@self_attn.k_proj x_norm dim=(KVH * MODEL_HEAD_DIM) |> reshape_heads heads=KVH
  k <- Tensor.repeat k repeats=(NUM_HEADS / KVH)
  v <- NN.linear@self_attn.v_proj x_norm dim=(KVH * MODEL_HEAD_DIM) |> reshape_heads heads=KVH
  v <- Tensor.repeat v repeats=(NUM_HEADS / KVH)
  keep <- causal_mask q k padding_mask=attn_mask
  a <- attention q k v keep scale=SCALE |> merge_heads
  a <- NN.linear@self_attn.o_proj a dim=MODEL_DIM
  return x + a

mamba_core :: Tensor[B,S,D] -> ?Tensor[B,S] -> Tensor[B,S,D]
mamba_core x attn_mask = do
  x_norm <- rms@input_layernorm x
  in_proj <- NN.linear@mamba.in_proj x_norm dim=(2 * I)
  u, gate <- Tensor.split in_proj sizes=[I, I]
  u_conv <- causal_conv1d@mamba.conv1d u activation="silu" weight_path=@mamba.conv1d.weight bias_path=@mamba.conv1d.bias attention_mask=attn_mask
  params <- NN.linear@mamba.x_proj u_conv dim=(R + 2 * N)
  dt, b, c <- Tensor.split params sizes=[R, N, N]
  dt <- NN.rmsnorm@mamba.dt_layernorm dt eps=EPS cast_float=true
  b <- NN.rmsnorm@mamba.b_layernorm b eps=EPS cast_float=true
  c <- NN.rmsnorm@mamba.c_layernorm c eps=EPS cast_float=true
  delta <- NN.linear@mamba.dt_proj dt dim=I bias=true
  y_scan <- mamba_scan u_conv delta b c A=@mamba.A_log D=@mamba.D a_is_log=true
  y <- y_scan |> mul (silu gate) |> NN.linear@mamba.out_proj dim=MODEL_DIM
  return x + y

jamba_3b :: TokenIds[B,S] -> ?Tensor[B,S] -> Tensor[B,S,V]
jamba_3b input_ids attn_mask = do
  x <- NN.embedding@model.embed_tokens input_ids dim=MODEL_DIM
  x <- for@model.layers i <- [0..NUM_LAYERS) carry (x) do
    x <- ((i % ATTN_PERIOD) == ATTN_OFFSET) ? attn_core x attn_mask : mamba_core x attn_mask
    x_ff <- rms@pre_ff_layernorm x
    m <- dense_ffn x_ff
    x <- x + m
    yield x
  x <- rms@model.final_layernorm x
  logits <- NN.linear@lm_head x dim=VOCAB_SIZE
  return logits
