{-# CHECKPOINTS "ai21labs/AI21-Jamba-Reasoning-3B" #-}
{-# TASK "causal_lm" #-}
{-# PADDING_SIDE "right" #-}

import Activations
import Activations (silu)
import Attention
import Attention (attention, merge_heads, reshape_heads)
import Masking
import Masking (causal_mask)
import Math
import Math (mul)
import SSM
import SSM (causal_conv1d, mamba_scan)
import NN
import Tensor

rms :: Path -> Tensor[B,S,D] -> Tensor[B,S,D]
rms@path x = NN.rmsnorm@path x eps=1e-06 cast_float=true

dense_ffn :: Tensor[B,S,D] -> Tensor[B,S,D]
dense_ffn x = do
  gate <- NN.linear@feed_forward.gate_proj x dim=8192
  up <- NN.linear@feed_forward.up_proj x dim=8192
  return gate |> silu |> mul up |> NN.linear@feed_forward.down_proj dim=2560

attn_core :: Tensor[B,S,D] -> ?Tensor[B,S] -> Tensor[B,S,D]
attn_core x attn_mask = do
  x_norm <- rms@input_layernorm x
  q <- NN.linear@self_attn.q_proj x_norm dim=2560 |> reshape_heads heads=20
  k <- NN.linear@self_attn.k_proj x_norm dim=128 |> reshape_heads heads=1
  k <- Tensor.repeat k repeats=20
  v <- NN.linear@self_attn.v_proj x_norm dim=128 |> reshape_heads heads=1
  v <- Tensor.repeat v repeats=20
  keep <- causal_mask q k padding_mask=attn_mask
  a <- attention q k v keep scale=0.08838834764831843 |> merge_heads
  a <- NN.linear@self_attn.o_proj a dim=2560
  return x + a

mamba_core :: Tensor[B,S,D] -> ?Tensor[B,S] -> Tensor[B,S,D]
mamba_core x attn_mask = do
  x_norm <- rms@input_layernorm x
  in_proj <- NN.linear@mamba.in_proj x_norm dim=10240
  u, gate <- Tensor.split in_proj sizes=[5120, 5120]
  u_conv <- causal_conv1d@mamba.conv1d u activation="silu" weight_path=@mamba.conv1d.weight bias_path=@mamba.conv1d.bias attention_mask=attn_mask
  params <- NN.linear@mamba.x_proj u_conv dim=192
  dt, b, c <- Tensor.split params sizes=[160, 16, 16]
  dt <- NN.rmsnorm@mamba.dt_layernorm dt eps=1e-06 cast_float=true
  b <- NN.rmsnorm@mamba.b_layernorm b eps=1e-06 cast_float=true
  c <- NN.rmsnorm@mamba.c_layernorm c eps=1e-06 cast_float=true
  delta <- NN.linear@mamba.dt_proj dt dim=5120 bias=true
  y_scan <- mamba_scan u_conv delta b c A=@mamba.A_log D=@mamba.D a_is_log=true
  y <- y_scan |> mul (silu gate) |> NN.linear@mamba.out_proj dim=2560
  return x + y

jamba_3b :: TokenIds[B,S] -> ?Tensor[B,S] -> Tensor[B,S,V]
jamba_3b input_ids attn_mask = do
  x <- NN.embedding@model.embed_tokens input_ids dim=2560
  for@model.layers i <- [0..28) do
    x <- ((i % 14) == 7) ? attn_core x attn_mask : mamba_core x attn_mask
    x_ff <- rms@pre_ff_layernorm x
    m <- dense_ffn x_ff
    x <- x + m
    yield x
  x <- rms@model.final_layernorm x
  logits <- NN.linear@lm_head x dim=65536
  return logits
