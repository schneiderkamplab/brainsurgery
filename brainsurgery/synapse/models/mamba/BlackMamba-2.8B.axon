{-# CHECKPOINTS "Zyphra/BlackMamba-2.8B" #-}
{-# TASK "causal_lm" #-}
{-# TOKENIZER "EleutherAI/gpt-neox-20b" #-}
{-# PADDING_SIDE "right" #-}

import Activations
import Activations (silu)
import Math
import Math (mul)
import MoE
import MoE (scatter_add, select)
import SSM
import SSM (causal_conv1d, mamba_scan)
import NN
import Tensor

rms :: Path -> Tensor[B,S,D] -> Tensor[B,S,D]
rms@path x = NN.rmsnorm@path x eps=1e-05 cast_float=true

expert_ffn :: Tensor[Nt,D] -> Tensor[Nt,D]
expert_ffn x = do
  in_proj <- NN.linear@linear_fc1 x dim=7744
  gate, up <- Tensor.split in_proj sizes=[3872, 3872]
  return gate |> silu |> mul up |> NN.linear@linear_fc2 dim=1472

moe_ffn :: Tensor[B,S,D] -> Tensor[B,S,D]
moe_ffn x = do
  x_norm <- rms@norm x
  router_logits <- NN.linear@mixer.router x_norm dim=8 bias=true
  router_probs <- Tensor.softmax router_logits dim=-1 dtype="float32"
  topk_scores, topk_indices <- Tensor.topk router_probs k=2 dim=-1
  m <- Tensor.zeros_like x_norm
  x_upd <- scope@mixer do
    for@local_experts e <- [0..8) do
      x_sel, token_idx, topk_pos, sel_scores <- select x_norm topk_scores topk_indices e
      x_expert <- expert_ffn x_sel
      m <- scatter_add m token_idx x_expert sel_scores
      yield m
    return m
  return x + x_upd

mamba_mixer :: Tensor[B,S,D] -> Tensor[B,S,D]
mamba_mixer x = do
  x_norm <- rms@norm x
  y <- do
    in_proj <- NN.linear@mixer.in_proj x_norm dim=5888
    u, gate <- Tensor.split in_proj sizes=[2944, 2944]
    u_conv <- causal_conv1d@mixer.conv1d u activation=silu weight_path=@mixer.conv1d.weight bias_path=@mixer.conv1d.bias
    params <- NN.linear@mixer.x_proj u_conv dim=124
    dt, b, c <- Tensor.split params sizes=[92, 16, 16]
    delta <- NN.linear@mixer.dt_proj dt dim=2944 bias=true
    y_scan <- mamba_scan u_conv delta b c A=@mixer.A_log D=@mixer.D a_is_log=true
    return y_scan |> mul (silu gate) |> NN.linear@mixer.out_proj dim=1472
  return x + y

black_mamba :: TokenIds[B,S] -> Tensor[B,S,V]
black_mamba input_ids = do
  x <- NN.embedding@embedding.word_embeddings input_ids dim=1472
  for@decoder.layers i <- [0..36) do
    x <- ((i % 2) == 0) ? mamba_mixer x : moe_ffn x
    yield x
  x <- rms@decoder.final_layernorm x
  logits <- NN.linear@embedding.word_embeddings x dim=50304
  return logits
