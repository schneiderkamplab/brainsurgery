{-# CHECKPOINTS ["state-spaces/mamba-2.8b-hf"] #-}
{-# TASK "causal_lm" #-}
{-# PADDING_SIDE "right" #-}
import Activations (silu)
import Math (mul)
import SSM (causal_conv1d, mamba_scan)
import Config
import NN
import Tensor



-- Mamba-2.8B architecture constants.
MODEL_DIM = Config.int@@hidden_size default=2560                          -- residual hidden size
I = Config.int@@intermediate_size default=5120                    -- mixer inner width
N = Config.int@@state_size default=16                             -- state-space width
R = Config.int@@time_step_rank default=160                        -- delta rank
NUM_LAYERS = Config.int@@n_layer default=64                                -- mixer block count
VOCAB_SIZE = Config.int@@vocab_size default=50280                          -- tokenizer vocabulary size
EPS = Config.float@@layer_norm_epsilon default=1e-5               -- RMSNorm epsilon

rms :: Path -> Tensor[B,S,D] -> Tensor[B,S,D]
rms@path x = NN.rmsnorm@path x eps=EPS cast_float=true

mamba_mixer :: Tensor[B,S,D] -> ?Tensor[B,S] -> Tensor[B,S,D]
mamba_mixer x attn_mask = do
  in_proj <- NN.linear@in_proj x dim=2*I
  u, gate <- Tensor.split in_proj sizes=[I, I]
  u_conv <- causal_conv1d@conv1d u activation="silu" weight_path=@conv1d.weight bias_path=@conv1d.bias attention_mask=attn_mask
  params <- NN.linear@x_proj u_conv dim=R + 2*N
  dt, b, c <- Tensor.split params sizes=[R, N, N]
  delta <- NN.linear@dt_proj dt dim=I bias=true
  y_scan <- mamba_scan u_conv delta b c A=@A_log D=@D a_is_log=true
  return y_scan |> mul (silu gate) |> NN.linear@out_proj dim=MODEL_DIM

mamba_block :: Tensor[B,S,D] -> ?Tensor[B,S] -> Tensor[B,S,D]
mamba_block x attn_mask = do
  x_norm <- rms@norm x
  y <- scope@mixer do
    return mamba_mixer x_norm attn_mask
  return x + y

mamba_2_8b :: TokenIds[B,S] -> ?Tensor[B,S] -> Tensor[B,S,V]
mamba_2_8b input_ids attn_mask = do
  logits <- scope@backbone do
    x <- NN.embedding@embeddings input_ids dim=MODEL_DIM
    x <- for@layers i <- [0..NUM_LAYERS) carry (x) do
      x <- mamba_block x attn_mask
      yield x
    x <- rms@norm_f x
    return NN.linear@embeddings x dim=VOCAB_SIZE
  return logits
