{-# CHECKPOINTS ["mistralai/Mistral-7B-v0.1", "mistralai/Mistral-7B-Instruct-v0.1", "mistralai/Mistral-7B-Instruct-v0.2", "mistralai/Mistral-7B-v0.3", "mistralai/Mistral-7B-Instruct-v0.3", "mistralai/Mistral-Nemo-Base-2407", "mistralai/Codestral-22B-v0.1", "mistralai/Mathstral-7B-v0.1", "mistralai/Devstral-Small-2507", "mistralai/Ministral-8B-Instruct-2410", "test/Mistral-Test"] #-}
{-# TASK "causal_lm" #-}
{-# TOKENIZER ["mistralai/Mistral-7B-v0.1", "mistralai/Mistral-7B-v0.1"] #-}
{-# TOKENIZER ["mistralai/Mistral-7B-Instruct-v0.1", "mistralai/Mistral-7B-Instruct-v0.1"] #-}
{-# TOKENIZER ["mistralai/Mistral-7B-Instruct-v0.2", "mistralai/Mistral-7B-Instruct-v0.2"] #-}
{-# TOKENIZER ["mistralai/Mistral-7B-v0.3", "mistralai/Mistral-7B-v0.3"] #-}
{-# TOKENIZER ["mistralai/Mistral-7B-Instruct-v0.3", "mistralai/Mistral-7B-Instruct-v0.3"] #-}
{-# TOKENIZER ["mistralai/Mistral-Nemo-Base-2407", "mistralai/Mistral-Nemo-Base-2407"] #-}
{-# TOKENIZER ["mistralai/Codestral-22B-v0.1", "mistralai/Codestral-22B-v0.1"] #-}
{-# TOKENIZER ["mistralai/Mathstral-7B-v0.1", "mistralai/Mathstral-7B-v0.1"] #-}
{-# TOKENIZER ["mistralai/Devstral-Small-2507", "mistralai/Devstral-Small-2507"] #-}
{-# TOKENIZER ["mistralai/Ministral-8B-Instruct-2410", "mistralai/Ministral-8B-Instruct-2410"] #-}

import Activations (silu)
import Attention (attention, merge_heads, reshape_heads)
import Masking (causal_mask_for_input)
import Math (mul)
import Positions (position_ids, rope_base_factors, rope_pair_base_factors)
import Cache
import Config
import NN
import Tensor



MODEL_DIM <- do
  return ((Config.dim@@hidden_size default=4096) :: Dim)

VOCAB_SIZE <- do
  return ((Config.dim@@vocab_size default=32000) :: Dim)

NUM_LAYERS <- do
  return ((Config.dim@@num_hidden_layers default=32) :: Dim)

NUM_HEADS <- do
  return ((Config.dim@@num_attention_heads default=32) :: Dim)

KVH <- do
  return ((Config.dim@@num_key_value_heads default=8) :: Dim)

HAS_HEAD_DIM <- do
  return (Config.has_value@@head_dim)

MODEL_HEAD_DIM <- do
  return (HAS_HEAD_DIM ? (Config.dim@@head_dim default=128) : (MODEL_DIM / NUM_HEADS) :: Dim)

QD <- do
  return (NUM_HEADS * MODEL_HEAD_DIM :: Dim)

KVD <- do
  return (KVH * MODEL_HEAD_DIM :: Dim)

FFN <- do
  return ((Config.dim@@intermediate_size default=14336) :: Dim)

EPS <- do
  return (Config.float@@rms_norm_eps default=1e-05)

THETA <- do
  return (Config.float@@rope_theta default=10000.0)

HAS_SLIDING_WINDOW <- do
  return (Config.has_value@@sliding_window)

MAX_POSITIONS <- do
  return (HAS_SLIDING_WINDOW ? (Config.dim@@sliding_window default=4096) : (4096 :: Dim) :: Dim)

rms :: Path -> Tensor[B,S,D] -> Tensor[B,S,D]
rms@path x = NN.rmsnorm@path x eps=EPS

mistral_block :: Tensor[B,S,D] -> Tensor[B,1,S,R] -> Tensor[B,1,S,R] -> Tensor[B,1,S,K] -> ?CacheLayer[B,KVH,P,DH] -> (Tensor[B,S,D], ?CacheLayer[B,KVH,K,DH])
mistral_block x rope_sin rope_cos mask past_kv = do
  xn <- rms@input_layernorm x
  a, new_kv <- scope@self_attn do
    q <- NN.linear@q_proj xn dim=QD |> reshape_heads heads=NUM_HEADS
    k <- NN.linear@k_proj xn dim=KVD |> reshape_heads heads=KVH
    v <- NN.linear@v_proj xn dim=KVD |> reshape_heads heads=KVH
    q, k <- rope_pair_base_factors q k rope_sin rope_cos
    k, v, new_kv <- Cache.update past_kv k v
    k <- Tensor.repeat k repeats=(NUM_HEADS / KVH)
    v <- Tensor.repeat v repeats=(NUM_HEADS / KVH)
    a <- attention q k v mask |> merge_heads |> NN.linear@o_proj dim=MODEL_DIM
    return a, new_kv
  x <- x + a
  xn <- rms@post_attention_layernorm x
  m <- scope@mlp do
    g <- NN.linear@gate_proj xn dim=FFN
    u <- NN.linear@up_proj xn dim=FFN
    return g |> silu |> mul u |> NN.linear@down_proj dim=MODEL_DIM
  return x + m, new_kv

mistral :: TokenIds[B,S] -> ?Tensor[B,K] -> ?Cache[B,KVH,P,DH] -> ?Bool -> (Tensor[B,S,V], ?Cache[B,KVH,K,DH])
mistral input_ids attn_mask past_kv use_cache = do
  past_length <- Cache.past_length past_kv
  pos_ids <- position_ids input_ids attn_mask=attn_mask past_length=past_length
  rope_sin, rope_cos <- ((rope_base_factors pos_ids MODEL_HEAD_DIM THETA) :: (Tensor[B,1,S,MODEL_HEAD_DIM], Tensor[B,1,S,MODEL_HEAD_DIM]))
  key_len <- past_length + S
  mask <- causal_mask_for_input input_ids key_len padding_mask=attn_mask window=MAX_POSITIONS
  x, new_kv <- scope@model do
    x <- NN.embedding@embed_tokens input_ids dim=MODEL_DIM
    new_kv <- use_cache ? Cache.init : null
    x, new_kv <- for@layers i <- [0..NUM_LAYERS) carry (x, new_kv) do
      past_i <- Cache.index past_kv i
      x, new_i <- mistral_block x rope_sin rope_cos mask past_i
      new_kv <- Cache.append new_kv new_i
      yield x, new_kv
    x <- rms@norm x
    return x, new_kv
  logits <- NN.linear@lm_head x dim=VOCAB_SIZE
  return logits, new_kv
