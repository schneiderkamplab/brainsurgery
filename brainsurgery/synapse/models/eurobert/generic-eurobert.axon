{-# CHECKPOINTS ["EuroBERT/EuroBERT-210m"] #-}
{-# TASK "masked_lm" #-}

import Activations (silu)
import Attention (attention, merge_heads, reshape_heads)
import Masking (Mask, bidirectional_mask_for_input, mask_for_input)
import Positions (position_ids, rope_pair_base)
import Config
import NN


MODEL_DIM <- Config.int @@hidden_size default=768
VOCAB_SIZE <- Config.int @@vocab_size default=128256
NUM_LAYERS <- Config.int @@num_hidden_layers default=12
NUM_HEADS <- Config.int @@num_attention_heads default=12
NUM_KV_HEADS <- Config.int @@num_key_value_heads default=12
HEAD_DIM <- Config.int @@head_dim default=64
FFN <- Config.int @@intermediate_size default=3072
EPS <- Config.float @@rms_norm_eps default=1e-5
ROPE_THETA <- Config.float @@rope_theta default=250000.0

eurobert_block :: Tensor[B,S,D] -> Tensor[B,S] -> Tensor[B,1,S,S] -> Tensor[B,S,D]
eurobert_block x pos_ids keep = do
  h <- NN.rmsnorm@input_layernorm x eps=EPS
  a <- scope@self_attn do
    q <- NN.linear@q_proj h dim=(NUM_HEADS * HEAD_DIM) bias=false |> reshape_heads heads=NUM_HEADS
    k <- NN.linear@k_proj h dim=(NUM_KV_HEADS * HEAD_DIM) bias=false |> reshape_heads heads=NUM_KV_HEADS
    v <- NN.linear@v_proj h dim=(NUM_KV_HEADS * HEAD_DIM) bias=false |> reshape_heads heads=NUM_KV_HEADS
    q, k <- rope_pair_base q k pos_ids theta=ROPE_THETA interleaved=false
    return attention q k v keep |> merge_heads |> NN.linear@o_proj dim=MODEL_DIM bias=false
  x <- x + a
  h <- NN.rmsnorm@post_attention_layernorm x eps=EPS
  gate <- NN.linear@mlp.gate_proj h dim=FFN bias=false |> silu
  up <- NN.linear@mlp.up_proj h dim=FFN bias=false
  m <- gate * up
  m <- NN.linear@mlp.down_proj m dim=MODEL_DIM bias=false
  return x + m

eurobert :: TokenIds[B,S] -> ?Mask[B,S,S] -> Tensor[B,S,VOCAB_SIZE]
eurobert input_ids attn_mask = do
  attn_mask <- mask_for_input input_ids attn_mask S
  pos_ids <- position_ids input_ids
  keep <- bidirectional_mask_for_input input_ids S padding_mask=attn_mask
  x <- NN.embedding@model.embed_tokens input_ids dim=MODEL_DIM
  x <- for@model.layers i <- [0..NUM_LAYERS) carry (x) do
    x <- eurobert_block x pos_ids keep
    yield x
  x <- NN.rmsnorm@model.norm x eps=EPS
  return NN.linear@lm_head x dim=VOCAB_SIZE bias=false
