{-# CHECKPOINTS ["ibm-granite/granite-3.1-2b-base", "ibm-granite/granite-3.1-2b-instruct", "ibm-granite/granite-3.1-8b-base", "ibm-granite/granite-3.1-8b-instruct", "ibm-granite/granite-3.2-2b-instruct", "ibm-granite/granite-3.2-8b-instruct", "ibm-granite/granite-3.3-2b-base", "ibm-granite/granite-3.3-2b-instruct", "ibm-granite/granite-3.3-8b-base", "ibm-granite/granite-3.3-8b-instruct"] #-}
{-# TASK "causal_lm" #-}

import Activations (silu)
import Attention (attention, merge_heads, reshape_heads)
import Masking (Mask, causal_mask_for_input, mask_for_input, mask_length_for_input)
import Math (mul, sqrt)
import Params (has_root)
import Positions (position_ids, rope_base_factors, rope_pair_base_factors)
import Cache
import Config
import NN
import Tensor



MODEL_DIM <- Config.int @@hidden_size default=2048
VOCAB_SIZE <- Config.int @@vocab_size default=49152
NUM_LAYERS <- Config.int @@num_hidden_layers default=40
NUM_HEADS <- Config.int @@num_attention_heads default=32
KVH <- Config.int @@num_key_value_heads default=8
HAS_HEAD_DIM <- Config.has_value @@head_dim
MODEL_HEAD_DIM <- HAS_HEAD_DIM ? (Config.int @@head_dim default=64) : (MODEL_DIM / NUM_HEADS)
QD = NUM_HEADS * MODEL_HEAD_DIM
KVD = KVH * MODEL_HEAD_DIM
FFN <- Config.int @@intermediate_size default=8192
EPS <- Config.float @@rms_norm_eps default=1e-05
THETA <- Config.float @@rope_theta default=10000.0
MAX_POSITIONS <- Config.int @@max_position_embeddings default=4096
EMBED_SCALE <- Config.float @@embedding_multiplier default=1.0
RESIDUAL_SCALE <- Config.float @@residual_multiplier default=1.0
ATTN_SCALE <- Config.float @@attention_multiplier default=(1.0 / sqrt MODEL_HEAD_DIM)
LOGITS_SCALE <- Config.float @@logits_scaling default=1.0
HAS_LM_HEAD = has_root "lm_head"

granite_norm :: Path -> Tensor[B,S,D] -> Tensor[B,S,D]
granite_norm@path x = NN.rmsnorm@path x eps=EPS

granite_block :: Tensor[B,S,D] -> Tensor[B,1,S,R] -> Tensor[B,1,S,R] -> Tensor[B,1,S,K] -> ?CacheLayer[B,KVH,P,MAX_POSITIONS,DH] -> (Tensor[B,S,D], ?CacheLayer[B,KVH,K,MAX_POSITIONS,DH])
granite_block x rope_sin rope_cos mask past_kv = do
  xn <- granite_norm@input_layernorm x
  a, new_kv <- scope@self_attn do
    q <- NN.linear@q_proj xn dim=QD bias=false |> reshape_heads heads=NUM_HEADS
    k <- NN.linear@k_proj xn dim=KVD bias=false |> reshape_heads heads=KVH
    v <- NN.linear@v_proj xn dim=KVD bias=false |> reshape_heads heads=KVH
    q, k <- rope_pair_base_factors q k rope_sin rope_cos
    k, v, new_kv <- Cache.update past_kv k v
    k <- Tensor.repeat k repeats=(NUM_HEADS / KVH)
    v <- Tensor.repeat v repeats=(NUM_HEADS / KVH)
    a <- attention q k v mask scale=ATTN_SCALE |> merge_heads |> NN.linear@o_proj dim=MODEL_DIM bias=false
    return a, new_kv
  x <- x + (a * RESIDUAL_SCALE)
  xn <- granite_norm@post_attention_layernorm x
  m <- scope@mlp do
    g <- NN.linear@gate_proj xn dim=FFN bias=false
    u <- NN.linear@up_proj xn dim=FFN bias=false
    return g |> silu |> mul u |> NN.linear@down_proj dim=MODEL_DIM bias=false
  x <- x + (m * RESIDUAL_SCALE)
  return x, new_kv

granite :: TokenIds[B,S] -> ?Mask[B,K,MAX_POSITIONS] -> ?Cache[B,KVH,P,MAX_POSITIONS,DH] -> ?Bool -> (Tensor[B,S,V], ?Cache[B,KVH,K,MAX_POSITIONS,DH])
granite input_ids attn_mask past_kv use_cache = do
  past_length <- Cache.past_length past_kv
  attn_mask <- mask_for_input input_ids attn_mask MAX_POSITIONS
  pos_ids <- position_ids input_ids attn_mask=attn_mask past_length=past_length
  rope_sin, rope_cos <- ((rope_base_factors pos_ids MODEL_HEAD_DIM THETA) :: (Tensor[B,1,S,MODEL_HEAD_DIM], Tensor[B,1,S,MODEL_HEAD_DIM]))
  key_len <- mask_length_for_input input_ids attn_mask past_length
  mask <- causal_mask_for_input input_ids key_len padding_mask=attn_mask window=MAX_POSITIONS
  work_kv <- Cache.prepare past_kv use_cache MAX_POSITIONS
  read_kv <- Cache.read past_kv work_kv
  x, work_kv <- scope@model do
    x <- NN.embedding@embed_tokens input_ids dim=MODEL_DIM
    x <- x * EMBED_SCALE
    x, work_kv <- for@layers i <- [0..NUM_LAYERS) carry (x, work_kv) do
      past_i <- Cache.index read_kv i
      x, new_i <- granite_block x rope_sin rope_cos mask past_i
      work_kv <- Cache.append work_kv new_i
      yield x, work_kv
    x <- granite_norm@norm x
    return x, work_kv
  logits <- HAS_LM_HEAD ? (NN.linear@lm_head x dim=VOCAB_SIZE) : (NN.linear@model.embed_tokens x dim=VOCAB_SIZE)
  logits <- logits / LOGITS_SCALE
  new_length <- past_length + S
  new_kv <- Cache.finish work_kv new_length
  new_kv <- use_cache ? new_kv : null
  return logits, new_kv
