import Math
{-# CHECKPOINTS ["ibm-granite/granite-3.1-2b-base", "ibm-granite/granite-3.1-2b-instruct", "ibm-granite/granite-3.1-8b-base", "ibm-granite/granite-3.1-8b-instruct", "ibm-granite/granite-3.2-2b-instruct", "ibm-granite/granite-3.2-8b-instruct", "ibm-granite/granite-3.3-2b-base", "ibm-granite/granite-3.3-2b-instruct", "ibm-granite/granite-3.3-8b-base", "ibm-granite/granite-3.3-8b-instruct"] #-}
{-# TASK "causal_lm" #-}

import Config
import Params
import Activations silu
import Cache
import Cache past_length

CFG = (Config.has "text_config") ? "text_config" : ""

D = Config.int "hidden_size" root=CFG default=2048
V = Config.int "vocab_size" root=CFG default=49152
L = Config.int "num_hidden_layers" root=CFG default=40
H = Config.int "num_attention_heads" root=CFG default=32
KVH = Config.int "num_key_value_heads" root=CFG default=8
HD_RAW = Config.value "head_dim" root=CFG default=null
HD = (HD_RAW == null) ? (D / H) : (Config.int "head_dim" root=CFG default=64)
QD = H * HD
KVD = KVH * HD
FFN = Config.int "intermediate_size" root=CFG default=8192
EPS = Config.float "rms_norm_eps" root=CFG default=1e-05
THETA = Config.float "rope_theta" root=CFG default=10000.0
C = Config.int "max_position_embeddings" root=CFG default=4096
EMBED_SCALE = Config.float "embedding_multiplier" root=CFG default=1.0
RESIDUAL_SCALE = Config.float "residual_multiplier" root=CFG default=1.0
ATTN_SCALE = Config.float "attention_multiplier" root=CFG default=(1.0 / Math.sqrt HD)
LOGITS_SCALE = Config.float "logits_scaling" root=CFG default=1.0
HAS_LM_HEAD = Params.has_root "lm_head"

granite_norm :: @Path -> Tensor -> Tensor
granite_norm@path x = rmsnorm@path x eps=EPS

granite_block :: Tensor -> IdxTensor -> ?Tensor -> ?CacheLayer -> (Tensor, ?CacheLayer)
granite_block x pos_ids attn_mask past_kv = do
  xn <- granite_norm@input_layernorm x
  a, new_kv <- scope@self_attn do
    q <- linear@q_proj xn dim=QD bias=false |> reshape_heads heads=H
    k <- linear@k_proj xn dim=KVD bias=false |> reshape_heads heads=KVH
    v <- linear@v_proj xn dim=KVD bias=false |> reshape_heads heads=KVH
    q, k <- rope_pair_base q k pos_ids THETA
    k, v, new_kv <- Cache.update past_kv k v
    k <- repeat k repeats=(H / KVH)
    v <- repeat v repeats=(H / KVH)
    mask <- causal_mask q k window=C padding_mask=attn_mask
    a <- attention q k v mask=mask scale=ATTN_SCALE |> merge_heads |> linear@o_proj dim=D bias=false
    return a, new_kv
  x <- x + (a * RESIDUAL_SCALE)
  xn <- granite_norm@post_attention_layernorm x
  m <- scope@mlp do
    g <- linear@gate_proj xn dim=FFN bias=false
    u <- linear@up_proj xn dim=FFN bias=false
    return g |> silu |> Math.mul u |> linear@down_proj dim=D bias=false
  x <- x + (m * RESIDUAL_SCALE)
  return x, new_kv

granite :: TokenIds[B,S] -> ?Tensor[B,S] -> ?Cache -> ?Bool -> (Tensor[B,S,V], ?Cache)
granite input_ids attn_mask past_kv use_cache = do
  pos_ids <- position_ids input_ids attn_mask=attn_mask past_length=(past_length past_kv)
  x, new_kv <- scope@model do
    x <- embedding@embed_tokens input_ids dim=D
    x <- x * EMBED_SCALE
    new_kv <- use_cache ? Cache.init : null
    for@layers i <- [0..L) do
      past_i <- Cache.index past_kv i
      x, new_i <- granite_block x pos_ids attn_mask past_i
      new_kv <- Cache.append new_kv new_i
    x <- granite_norm@norm x
    return x, new_kv
  logits <- HAS_LM_HEAD ? (linear@lm_head x dim=V) : (linear@model.embed_tokens x dim=V)
  logits <- logits / LOGITS_SCALE
  return logits, new_kv
