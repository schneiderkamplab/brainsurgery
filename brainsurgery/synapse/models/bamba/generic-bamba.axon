{-# CHECKPOINTS ["test/Bamba-Test", "ibm-ai-platform/Bamba-9B-v1", "ibm-ai-platform/Bamba-9B-v2"] #-}
{-# TASK "causal_lm" #-}

import Activations (silu)
import Attention (attention, merge_heads, reshape_heads)
import Config
import List
import Masking (causal_mask_for_input, mask_for_input)
import Math (mul)
import NN
import Params (param)
import Positions (position_ids, rope_base_factors, rope_pair_base_factors)
import SSM (causal_conv1d_full, mamba2_scan)
import Tensor

MODEL_DIM <- Config.dim @@hidden_size default=4096
VOCAB_SIZE <- Config.dim @@vocab_size default=128000
NUM_LAYERS <- Config.dim @@num_hidden_layers default=32
FFN <- Config.dim @@intermediate_size default=14336
NUM_HEADS <- Config.dim @@num_attention_heads default=32
KV_HEADS <- Config.dim @@num_key_value_heads default=8
HEAD_DIM = MODEL_DIM / NUM_HEADS
MAX_POSITIONS <- Config.dim @@max_position_embeddings default=262144
THETA <- Config.float @@'rope_parameters.rope_theta' default=10000.0
EPS <- Config.float @@rms_norm_eps default=1e-5
ATTN_BIAS <- Config.bool @@attention_bias default=false
MLP_BIAS <- Config.bool @@mlp_bias default=false
ATTN_LAYERS <- ((Config.list @@attn_layer_indices default=[]) :: List[Int])
MAMBA_HEADS <- Config.dim @@mamba_n_heads default=128
MAMBA_HEAD_DIM <- Config.dim @@mamba_d_head default=64
MAMBA_GROUPS <- Config.dim @@mamba_n_groups default=1
STATE_DIM <- Config.dim @@mamba_d_state default=256
CONV_KERNEL <- Config.dim @@mamba_d_conv default=4
EXPAND <- Config.dim @@mamba_expand default=2
INNER = EXPAND * MODEL_DIM
CONV_DIM = INNER + (2 * MAMBA_GROUPS * STATE_DIM)
PROJECTION_DIM = INNER + CONV_DIM + MAMBA_HEADS
CONV_BIAS <- Config.bool @@mamba_conv_bias default=true
PROJ_BIAS <- Config.bool @@mamba_proj_bias default=false

is_attention_layer :: Int -> Bool
is_attention_layer layer = do
  found <- false
  found <- for j <- [0..List.length ATTN_LAYERS) carry (found) do
    candidate <- List.index ATTN_LAYERS j
    yield found or (candidate == layer)
  return found

sequence_mask :: Tensor[B,S,D] -> ?Tensor[B,S] -> Tensor[B,S,D]
sequence_mask x mask = (mask == null) ? x : (x * (Tensor.unsqueeze mask dim=-1))

bamba_mamba :: Tensor[B,S,D] -> ?Tensor[B,S] -> Tensor[B,S,D]
bamba_mamba x attn_mask = do
  x <- sequence_mask x attn_mask
  projected <- NN.linear@in_proj x dim=PROJECTION_DIM bias=PROJ_BIAS
  gate, hidden_bc, dt <- Tensor.split projected sizes=[INNER,CONV_DIM,MAMBA_HEADS]
  w <- ((param @conv1d.weight) :: Tensor[CONV_DIM,1,CONV_KERNEL])
  bias <- CONV_BIAS
    ? ((param @conv1d.bias) :: Tensor[CONV_DIM])
    : ((Tensor.zeros hidden_bc shape=[CONV_DIM]) :: Tensor[CONV_DIM])
  hidden_bc <- causal_conv1d_full hidden_bc w bias "silu"
  hidden_bc <- sequence_mask hidden_bc attn_mask
  hidden, b_state, c_state <- Tensor.split hidden_bc sizes=[INNER,MAMBA_GROUPS * STATE_DIM,MAMBA_GROUPS * STATE_DIM]
  y <- mamba2_scan hidden gate dt b_state c_state @A_log @D @dt_bias @norm.weight MAMBA_GROUPS MAMBA_HEAD_DIM time_step_min=0.0 time_step_max=1e30
  return NN.linear@out_proj y dim=MODEL_DIM bias=PROJ_BIAS

bamba_attention :: Tensor[B,S,D] -> Tensor[B,1,S,R] -> Tensor[B,1,S,R] -> Tensor[B,1,S,S] -> Tensor[B,S,D]
bamba_attention x rope_sin rope_cos mask = do
  q <- NN.linear@q_proj x dim=(NUM_HEADS * HEAD_DIM) bias=ATTN_BIAS |> reshape_heads heads=NUM_HEADS
  k <- NN.linear@k_proj x dim=(KV_HEADS * HEAD_DIM) bias=ATTN_BIAS |> reshape_heads heads=KV_HEADS
  v <- NN.linear@v_proj x dim=(KV_HEADS * HEAD_DIM) bias=ATTN_BIAS |> reshape_heads heads=KV_HEADS
  q, k <- rope_pair_base_factors q k rope_sin rope_cos
  k <- Tensor.repeat k repeats=(NUM_HEADS / KV_HEADS)
  v <- Tensor.repeat v repeats=(NUM_HEADS / KV_HEADS)
  return attention q k v mask |> merge_heads |> NN.linear@o_proj dim=MODEL_DIM bias=ATTN_BIAS

bamba_ffn :: Tensor[B,S,D] -> Tensor[B,S,D]
bamba_ffn x = do
  gate <- NN.linear@gate_proj x dim=FFN bias=MLP_BIAS |> silu
  up <- NN.linear@up_proj x dim=FFN bias=MLP_BIAS
  return gate |> mul up |> NN.linear@down_proj dim=MODEL_DIM bias=MLP_BIAS

bamba_layer :: Tensor[B,S,D] -> Int -> Tensor[B,1,S,R] -> Tensor[B,1,S,R] -> Tensor[B,1,S,S] -> ?Tensor[B,S] -> Tensor[B,S,D]
bamba_layer x layer rope_sin rope_cos mask attn_mask = do
  residual <- x
  xn <- NN.rmsnorm@input_layernorm x eps=EPS cast_float=true
  attn_layer <- is_attention_layer layer
  y <- attn_layer
    ? do
      y <- scope@self_attn do
        return bamba_attention xn rope_sin rope_cos mask
      return y
    : do
      y <- scope@mamba do
        return bamba_mamba xn attn_mask
      return y
  x <- residual + y
  residual <- x
  xn <- NN.rmsnorm@pre_ff_layernorm x eps=EPS cast_float=true
  m <- scope@feed_forward do
    return bamba_ffn xn
  return residual + m

bamba :: TokenIds[B,S] -> ?Tensor[B,S] -> ?Any -> ?Bool -> (Tensor[B,S,V], ?Any)
bamba input_ids attn_mask past_kv use_cache = do
  attn_mask <- mask_for_input input_ids attn_mask MAX_POSITIONS
  pos_ids <- position_ids input_ids attn_mask=attn_mask past_length=0
  rope_sin, rope_cos <- rope_base_factors pos_ids HEAD_DIM THETA
  mask <- causal_mask_for_input input_ids S padding_mask=attn_mask window=MAX_POSITIONS
  x <- scope@model do
    x <- NN.embedding@embed_tokens input_ids dim=MODEL_DIM
    x <- for@layers i <- [0..NUM_LAYERS) carry (x) do
      yield bamba_layer x i rope_sin rope_cos mask attn_mask
    return NN.rmsnorm@final_layernorm x eps=EPS cast_float=true
  logits <- NN.linear@lm_head x dim=VOCAB_SIZE bias=false
  return logits, null
