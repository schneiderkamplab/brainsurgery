{-# CHECKPOINTS ["bigcode/starcoder2-3b", "bigcode/starcoder2-7b", "bigcode/starcoder2-15b"] #-}
{-# TASK "causal_lm" #-}

import Config
import Params
import Activations (gelu, gelu_pytorch_tanh)
import Cache
import Cache past_length

D = Config.int "hidden_size" default=4608
V = Config.int "vocab_size" default=49152
L = Config.int "num_hidden_layers" default=32
H = Config.int "num_attention_heads" default=36
KVH = Config.int "num_key_value_heads" default=4
HD = D / H
KVD = KVH * HD
FFN = Config.int "intermediate_size" default=18432
EPS = Config.float "norm_epsilon" default=1e-05
C = Config.int "max_position_embeddings" default=16384
SW_RAW = Config.value "sliding_window" default=null
SW = (SW_RAW == null) ? C : (Config.int "sliding_window" default=4096)
THETA_RAW = Config.value "rope_theta" default=null
THETA = (THETA_RAW == null) ? 10000.0 : (Config.float "rope_theta" default=10000.0)
ACT = Config.value "hidden_act" default="gelu_pytorch_tanh"
HAS_LM_HEAD = Params.has_root "lm_head"
HAS_LM_HEAD_BIAS = Params.has_root "lm_head.bias"

starcoder2_ln :: @Path -> Tensor[B,S,D] -> Tensor[B,S,D]
starcoder2_ln@path x = layernorm@path x eps=EPS

starcoder2_mlp_act :: Tensor[B,S,FFN] -> Tensor[B,S,FFN]
starcoder2_mlp_act x = (ACT == "gelu_pytorch_tanh") ? (gelu_pytorch_tanh x) : (gelu x)

starcoder2_block :: Tensor[B,S,D] -> Tensor[B,S] -> ?Tensor[B,S] -> ?CacheLayer -> (Tensor[B,S,D], ?CacheLayer)
starcoder2_block x pos_ids attn_mask past_kv = do
  xn <- starcoder2_ln@input_layernorm x
  a, new_kv <- scope@self_attn do
    q <- linear@q_proj xn dim=D bias=true |> reshape_heads heads=H
    k <- linear@k_proj xn dim=KVD bias=true |> reshape_heads heads=KVH
    v <- linear@v_proj xn dim=KVD bias=true |> reshape_heads heads=KVH
    q, k <- rope_pair q k position_ids=pos_ids theta=THETA
    k, v, new_kv <- Cache.update past_kv k v
    k <- repeat k repeats=(H / KVH)
    v <- repeat v repeats=(H / KVH)
    mask <- causal_mask q k window=SW padding_mask=attn_mask
    a <- attention q k v mask=mask eager=false |> merge_heads |> linear@o_proj dim=D bias=true
    return a, new_kv
  x <- x + a
  xn2 <- starcoder2_ln@post_attention_layernorm x
  m <- scope@mlp do
    h <- linear@c_fc xn2 dim=FFN bias=true
    return starcoder2_mlp_act h |> linear@c_proj dim=D bias=true
  return x + m, new_kv

starcoder2 :: TokenIds[B,S] -> ?Tensor[B,S] -> ?Cache -> ?Bool -> (Tensor[B,S,V], ?Cache)
starcoder2 input_ids attn_mask past_kv use_cache = do
  pos_ids <- position_ids input_ids null past_length=(past_length past_kv)
  x, new_kv <- scope@model do
    x <- embedding@embed_tokens input_ids dim=D
    new_kv <- use_cache ? Cache.init : null
    for@layers i <- [0..L) do
      past_i <- Cache.index past_kv i
      x, new_i <- starcoder2_block x pos_ids attn_mask past_i
      new_kv <- Cache.append new_kv new_i
    x <- starcoder2_ln@norm x
    return x, new_kv
  logits <- HAS_LM_HEAD ? (linear@lm_head x dim=V bias=HAS_LM_HEAD_BIAS) : (linear@model.embed_tokens x dim=V)
  return logits, new_kv
