{-# CHECKPOINTS "bigcode/starcoder2-15b" #-}
{-# TASK "causal_lm" #-}

import Activations
import Activations (gelu_pytorch_tanh)
import Attention
import Attention (attention, merge_heads, reshape_heads)
import Masking
import Masking (causal_mask)
import Params
import Params (has_root)
import Positions
import Positions (position_ids, rope_pair_base)
import Cache
import NN
import Tensor

HAS_LM_HEAD = has_root "lm_head"
HAS_LM_HEAD_BIAS = has_root "lm_head.bias"

starcoder2_ln :: Path -> Tensor[B,S,D] -> Tensor[B,S,D]
starcoder2_ln@path x = NN.layernorm@path x eps=1e-05

starcoder2_mlp_act :: Tensor[B,S,FFN] -> Tensor[B,S,FFN]
starcoder2_mlp_act x = (gelu_pytorch_tanh x)

starcoder2_block :: Tensor[B,S,D] -> Tensor[B,S] -> ?Tensor[B,S] -> ?CacheLayer -> (Tensor[B,S,D], ?CacheLayer)
starcoder2_block x pos_ids attn_mask past_kv = do
  xn <- starcoder2_ln@input_layernorm x
  a, new_kv <- scope@self_attn do
    q <- NN.linear@q_proj xn dim=6144 bias=true |> reshape_heads heads=48
    k <- NN.linear@k_proj xn dim=512 bias=true |> reshape_heads heads=4
    v <- NN.linear@v_proj xn dim=512 bias=true |> reshape_heads heads=4
    q, k <- rope_pair_base q k pos_ids 100000.0
    k, v, new_kv <- Cache.update past_kv k v
    k <- Tensor.repeat k repeats=12
    v <- Tensor.repeat v repeats=12
    mask <- causal_mask q k window=4096 padding_mask=attn_mask
    a <- attention q k v mask |> merge_heads |> NN.linear@o_proj dim=6144 bias=true
    return a, new_kv
  x <- x + a
  xn2 <- starcoder2_ln@post_attention_layernorm x
  m <- scope@mlp do
    h <- NN.linear@c_fc xn2 dim=24576 bias=true
    return starcoder2_mlp_act h |> NN.linear@c_proj dim=6144 bias=true
  return x + m, new_kv

starcoder2 :: TokenIds[B,S] -> ?Tensor[B,S] -> ?Cache -> ?Bool -> (Tensor[B,S,V], ?Cache)
starcoder2 input_ids attn_mask past_kv use_cache = do
  pos_ids <- position_ids input_ids past_length=(Cache.past_length past_kv)
  x, new_kv <- scope@model do
    x <- NN.embedding@embed_tokens input_ids dim=6144
    new_kv <- use_cache ? Cache.init : null
    for@layers i <- [0..40) do
      past_i <- Cache.index past_kv i
      x, new_i <- starcoder2_block x pos_ids attn_mask past_i
      new_kv <- Cache.append new_kv new_i
      yield x, new_kv
    x <- starcoder2_ln@norm x
    return x, new_kv
  logits <- HAS_LM_HEAD ? (NN.linear@lm_head x dim=49152 bias=HAS_LM_HEAD_BIAS) : (NN.linear@model.embed_tokens x dim=49152)
  return logits, new_kv
