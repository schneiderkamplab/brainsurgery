{-# CHECKPOINTS ["mistralai/Ministral-3-8B-Base-2512", "mistralai/Ministral-3-14B-Base-2512", "test/Mistral3-Test"] #-}
{-# TASK "causal_lm" #-}

import Activations (silu)
import Attention (attention, merge_heads, reshape_heads)
import Masking (causal_mask_for_input)
import Math (floor, log, mul)
import Positions (position_ids, rope_pair_yarn)
import Cache
import Config
import NN
import Tensor



HAS_TEXT_CONFIG = Config.has_key @@text_config
MODEL_DIM = HAS_TEXT_CONFIG ? (Config.int @@'text_config.hidden_size' default=4096) : (Config.int @@hidden_size default=4096)
VOCAB_SIZE = HAS_TEXT_CONFIG ? (Config.int @@'text_config.vocab_size' default=131072) : (Config.int @@vocab_size default=131072)
NUM_LAYERS = HAS_TEXT_CONFIG ? (Config.int @@'text_config.num_hidden_layers' default=34) : (Config.int @@num_hidden_layers default=34)
NUM_HEADS = HAS_TEXT_CONFIG ? (Config.int @@'text_config.num_attention_heads' default=32) : (Config.int @@num_attention_heads default=32)
KVH = HAS_TEXT_CONFIG ? (Config.int @@'text_config.num_key_value_heads' default=8) : (Config.int @@num_key_value_heads default=8)
HAS_HEAD_DIM = HAS_TEXT_CONFIG ? (Config.has_value @@'text_config.head_dim') : (Config.has_value @@head_dim)
MODEL_HEAD_DIM = HAS_HEAD_DIM ? (HAS_TEXT_CONFIG ? (Config.int @@'text_config.head_dim' default=128) : (Config.int @@head_dim default=128)) : (MODEL_DIM / NUM_HEADS)
KVD = KVH * MODEL_HEAD_DIM
FFN = HAS_TEXT_CONFIG ? (Config.int @@'text_config.intermediate_size' default=14336) : (Config.int @@intermediate_size default=14336)
EPS = HAS_TEXT_CONFIG ? (Config.float @@'text_config.rms_norm_eps' default=1e-05) : (Config.float @@rms_norm_eps default=1e-05)

THETA = HAS_TEXT_CONFIG ? (Config.float @@'text_config.rope_parameters.rope_theta' default=1000000.0) : (Config.float @@'rope_parameters.rope_theta' default=1000000.0)
ROPE_FACTOR = HAS_TEXT_CONFIG ? (Config.float @@'text_config.rope_parameters.factor' default=16.0) : (Config.float @@'rope_parameters.factor' default=16.0)
ROPE_CONTEXT = HAS_TEXT_CONFIG ? (Config.int @@'text_config.rope_parameters.original_max_position_embeddings' default=16384) : (Config.int @@'rope_parameters.original_max_position_embeddings' default=16384)
ROPE_BETA_FAST = HAS_TEXT_CONFIG ? (Config.float @@'text_config.rope_parameters.beta_fast' default=32.0) : (Config.float @@'rope_parameters.beta_fast' default=32.0)
ROPE_BETA_SLOW = HAS_TEXT_CONFIG ? (Config.float @@'text_config.rope_parameters.beta_slow' default=1.0) : (Config.float @@'rope_parameters.beta_slow' default=1.0)
ROPE_MSCALE = HAS_TEXT_CONFIG ? (Config.float @@'text_config.rope_parameters.mscale' default=1.0) : (Config.float @@'rope_parameters.mscale' default=1.0)
ROPE_MSCALE_ALL_DIM = HAS_TEXT_CONFIG ? (Config.float @@'text_config.rope_parameters.mscale_all_dim' default=1.0) : (Config.float @@'rope_parameters.mscale_all_dim' default=1.0)
Q_SCALE_BETA = HAS_TEXT_CONFIG ? (Config.float @@'text_config.rope_parameters.llama_4_scaling_beta' default=0.1) : (Config.float @@'rope_parameters.llama_4_scaling_beta' default=0.1)

mistral3_norm :: Path -> Tensor[B,S,D] -> Tensor[B,S,D]
mistral3_norm@path x = NN.rmsnorm@path x eps=EPS

mistral3_query_scale :: Tensor[B,S] -> Tensor[B,1,S,1]
mistral3_query_scale pos_ids = do
  scaled <- pos_ids / ROPE_CONTEXT
  bucket <- floor scaled
  shifted <- bucket + 1.0
  logged <- log shifted
  beta_scaled <- logged * Q_SCALE_BETA
  gain <- beta_scaled + 1.0
  gain3 <- Tensor.unsqueeze gain dim=1
  gain4 <- Tensor.unsqueeze gain3 dim=3
  return gain4

mistral3_block :: Tensor[B,S,D] -> Tensor[B,S] -> Tensor[B,1,S,1] -> Tensor[B,1,S,K] -> ?CacheLayer[B,KVH,P,DH] -> (Tensor[B,S,D], ?CacheLayer[B,KVH,K,DH])
mistral3_block x pos_ids q_scale mask past_kv = do
  xn <- mistral3_norm@input_layernorm x
  a, new_kv <- scope@self_attn do
    q <- NN.linear@q_proj xn dim=MODEL_DIM |> reshape_heads heads=NUM_HEADS
    k <- NN.linear@k_proj xn dim=KVD |> reshape_heads heads=KVH
    v <- NN.linear@v_proj xn dim=KVD |> reshape_heads heads=KVH
    q, k <- rope_pair_yarn q k pos_ids THETA ROPE_FACTOR ROPE_BETA_FAST ROPE_BETA_SLOW ROPE_CONTEXT mscale=ROPE_MSCALE mscale_all_dim=ROPE_MSCALE_ALL_DIM
    q <- q * q_scale
    k, v, new_kv <- Cache.update past_kv k v
    k <- Tensor.repeat k repeats=(NUM_HEADS / KVH)
    v <- Tensor.repeat v repeats=(NUM_HEADS / KVH)
    a <- attention q k v mask |> merge_heads |> NN.linear@o_proj dim=MODEL_DIM
    return a, new_kv
  x <- x + a
  xn <- mistral3_norm@post_attention_layernorm x
  m <- scope@mlp do
    g <- NN.linear@gate_proj xn dim=FFN
    u <- NN.linear@up_proj xn dim=FFN
    return g |> silu |> mul u |> NN.linear@down_proj dim=MODEL_DIM
  return x + m, new_kv

mistral3 :: TokenIds[B,S] -> ?Tensor[B,K] -> ?Cache[B,KVH,P,DH] -> ?Bool -> (Tensor[B,S,V], ?Cache[B,KVH,K,DH])
mistral3 input_ids attn_mask past_kv use_cache = do
  past_length <- Cache.past_length past_kv
  pos_ids <- position_ids input_ids attn_mask=attn_mask past_length=past_length
  q_scale <- mistral3_query_scale pos_ids
  key_len <- past_length + S
  mask <- causal_mask_for_input input_ids key_len padding_mask=attn_mask
  x, new_kv <- scope@language_model.model do
    x <- NN.embedding@embed_tokens input_ids dim=MODEL_DIM
    new_kv <- use_cache ? Cache.init : null
    x, new_kv <- for@layers i <- [0..NUM_LAYERS) carry (x, new_kv) do
      past_i <- Cache.index past_kv i
      x, new_i <- mistral3_block x pos_ids q_scale mask past_i
      new_kv <- Cache.append new_kv new_i
      yield x, new_kv
    x <- mistral3_norm@norm x
    return x, new_kv
  logits <- scope@language_model do
    logits <- NN.linear@lm_head x dim=VOCAB_SIZE
    return logits
  return logits, new_kv
