{-# CHECKPOINTS ["mistralai/Ministral-3-8B-Base-2512", "mistralai/Ministral-3-14B-Base-2512"] #-}
{-# TASK "causal_lm" #-}

import Config
import Params
import Activations silu
import Cache past_length
import Cache

CFG = (Config.has "text_config") ? "text_config" : ""
ROPE_CFG = (CFG == "") ? "rope_parameters" : "text_config.rope_parameters"
TEXT_PARAM_ROOT = (Params.has_root "language_model") ? "language_model" : ""

D = Config.int "hidden_size" root=CFG default=4096
V = Config.int "vocab_size" root=CFG default=131072
L = Config.int "num_hidden_layers" root=CFG default=34
H = Config.int "num_attention_heads" root=CFG default=32
KVH = Config.int "num_key_value_heads" root=CFG default=8
HD_RAW = Config.value "head_dim" root=CFG default=null
HD = (HD_RAW == null) ? (D / H) : (Config.int "head_dim" root=CFG default=128)
KVD = KVH * HD
FFN = Config.int "intermediate_size" root=CFG default=14336
EPS = Config.float "rms_norm_eps" root=CFG default=1e-05

THETA = Config.float "rope_theta" root=ROPE_CFG default=1000000.0
ROPE_FACTOR = Config.float "factor" root=ROPE_CFG default=16.0
ROPE_CONTEXT = Config.int "original_max_position_embeddings" root=ROPE_CFG default=16384
ROPE_BETA_FAST = Config.float "beta_fast" root=ROPE_CFG default=32.0
ROPE_BETA_SLOW = Config.float "beta_slow" root=ROPE_CFG default=1.0
ROPE_MSCALE = Config.float "mscale" root=ROPE_CFG default=1.0
ROPE_MSCALE_ALL_DIM = Config.float "mscale_all_dim" root=ROPE_CFG default=1.0
Q_SCALE_BETA = Config.float "llama_4_scaling_beta" root=ROPE_CFG default=0.1

mistral3_norm :: @Path -> Tensor[B,S,D] -> Tensor[B,S,D]
mistral3_norm@path x = rmsnorm@path x eps=EPS

mistral3_query_scale :: Tensor[B,S] -> Tensor[B,1,S,1]
mistral3_query_scale pos_ids = do
  scaled <- pos_ids / ROPE_CONTEXT
  bucket <- floor scaled
  shifted <- bucket + 1.0
  logged <- log shifted
  beta_scaled <- logged * Q_SCALE_BETA
  gain <- beta_scaled + 1.0
  gain3 <- unsqueeze gain dim=1
  gain4 <- unsqueeze gain3 dim=3
  return gain4

mistral3_block :: Tensor[B,S,D] -> Tensor[B,S] -> ?Tensor[B,S] -> ?CacheLayer -> (Tensor[B,S,D], ?CacheLayer)
mistral3_block x pos_ids attn_mask past_kv = do
  xn <- mistral3_norm@input_layernorm x
  a, new_kv <- scope@self_attn do
    q <- linear@q_proj xn dim=D |> reshape_heads heads=H
    k <- linear@k_proj xn dim=KVD |> reshape_heads heads=KVH
    v <- linear@v_proj xn dim=KVD |> reshape_heads heads=KVH
    q, k <- rope_pair_yarn q k pos_ids THETA ROPE_FACTOR ROPE_BETA_FAST ROPE_BETA_SLOW ROPE_CONTEXT mscale=ROPE_MSCALE mscale_all_dim=ROPE_MSCALE_ALL_DIM
    q_scale <- mistral3_query_scale pos_ids
    q <- q * q_scale
    k, v, new_kv <- Cache.update past_kv k v
    k <- repeat k repeats=(H / KVH)
    v <- repeat v repeats=(H / KVH)
    mask <- causal_mask q k padding_mask=attn_mask
    a <- attention q k v mask=mask |> merge_heads |> linear@o_proj dim=D
    return a, new_kv
  x <- x + a
  xn <- mistral3_norm@post_attention_layernorm x
  m <- scope@mlp do
    g <- linear@gate_proj xn dim=FFN
    u <- linear@up_proj xn dim=FFN
    return g |> silu |> mul u |> linear@down_proj dim=D
  return x + m, new_kv

mistral3 :: TokenIds[B,S] -> ?Tensor[B,S] -> ?Cache -> ?Bool -> (Tensor[B,S,V], ?Cache)
mistral3 input_ids attn_mask past_kv use_cache = do
  pos_ids <- position_ids input_ids attn_mask=attn_mask past_length=(past_length past_kv)
  x, new_kv <- scope@model root=TEXT_PARAM_ROOT do
    x <- embedding@embed_tokens input_ids dim=D
    new_kv <- use_cache ? Cache.init : null
    for@layers i <- [0..L) do
      past_i <- Cache.index past_kv i
      x, new_i <- mistral3_block x pos_ids attn_mask past_i
      new_kv <- Cache.append new_kv new_i
    x <- mistral3_norm@norm x
    return x, new_kv
  logits <- scope@language_model do
    logits <- linear@lm_head x dim=V
    return logits
  return logits, new_kv
