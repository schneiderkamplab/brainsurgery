{-# CHECKPOINTS "mistralai/Magistral-Small-2509" #-}
{-# TASK "causal_lm" #-}
{-# TOKENIZER "mistralai/Magistral-Small-2509" #-}

import Activations (silu)
import Attention (attention, merge_heads, reshape_heads)
import Masking (causal_mask)
import Math (mul)
import Positions (position_ids, rope_pair_base)
import Cache
import Config
import NN
import Tensor



CFG = "text_config"

MODEL_DIM = Config.int @'{CFG}.hidden_size' default=5120
VOCAB_SIZE = Config.int @'{CFG}.vocab_size' default=131072
NUM_LAYERS = Config.int @'{CFG}.num_hidden_layers' default=40
NUM_HEADS = Config.int @'{CFG}.num_attention_heads' default=32
KVH = Config.int @'{CFG}.num_key_value_heads' default=8
MODEL_HEAD_DIM = Config.int @'{CFG}.head_dim' default=(MODEL_DIM / NUM_HEADS)
KVD = KVH * MODEL_HEAD_DIM
FFN = Config.int @'{CFG}.intermediate_size' default=32768
EPS = Config.float @'{CFG}.rms_norm_eps' default=1e-05
THETA = Config.float @'{CFG}.rope_theta' default=1000000000.0
HAS_WINDOW = Config.has_value @'{CFG}.sliding_window'
MAX_POSITIONS = HAS_WINDOW ? (Config.int @'{CFG}.sliding_window' default=4096) : 0

magistral_norm :: Path -> Tensor[B,S,D] -> Tensor[B,S,D]
magistral_norm@path x = NN.rmsnorm@path x eps=EPS

magistral_block :: Tensor[B,S,D] -> Tensor[B,S] -> ?Tensor[B,S] -> ?CacheLayer -> (Tensor[B,S,D], ?CacheLayer)
magistral_block x pos_ids attn_mask past_kv = do
  xn <- magistral_norm@input_layernorm x
  a, new_kv <- scope@self_attn do
    q <- NN.linear@q_proj xn dim=MODEL_DIM |> reshape_heads heads=NUM_HEADS
    k <- NN.linear@k_proj xn dim=KVD |> reshape_heads heads=KVH
    v <- NN.linear@v_proj xn dim=KVD |> reshape_heads heads=KVH
    q, k <- rope_pair_base q k pos_ids THETA
    k, v, new_kv <- Cache.update past_kv k v
    k <- Tensor.repeat k repeats=(NUM_HEADS / KVH)
    v <- Tensor.repeat v repeats=(NUM_HEADS / KVH)
    mask <- HAS_WINDOW ? (causal_mask q k window=MAX_POSITIONS padding_mask=attn_mask) : (causal_mask q k padding_mask=attn_mask)
    a <- attention q k v mask |> merge_heads |> NN.linear@o_proj dim=MODEL_DIM
    return a, new_kv
  x <- x + a
  xn <- magistral_norm@post_attention_layernorm x
  m <- scope@mlp do
    g <- NN.linear@gate_proj xn dim=FFN
    u <- NN.linear@up_proj xn dim=FFN
    return g |> silu |> mul u |> NN.linear@down_proj dim=MODEL_DIM
  return x + m, new_kv

magistral :: TokenIds[B,S] -> ?Tensor[B,S] -> ?Cache -> ?Bool -> (Tensor[B,S,V], ?Cache)
magistral input_ids attn_mask past_kv use_cache = do
  pos_ids <- position_ids input_ids attn_mask=attn_mask past_length=(Cache.past_length past_kv)
  x, new_kv <- scope@language_model.model do
    x <- NN.embedding@embed_tokens input_ids dim=MODEL_DIM
    new_kv <- use_cache ? Cache.init : null
    x, new_kv <- for@layers i <- [0..NUM_LAYERS) carry (x, new_kv) do
      past_i <- Cache.index past_kv i
      x, new_i <- magistral_block x pos_ids attn_mask past_i
      new_kv <- Cache.append new_kv new_i
      yield x, new_kv
    x <- magistral_norm@norm x
    return x, new_kv
  logits <- NN.linear@language_model.lm_head x dim=VOCAB_SIZE
  return logits, new_kv
