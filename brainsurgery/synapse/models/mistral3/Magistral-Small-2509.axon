{-# CHECKPOINTS "mistralai/Magistral-Small-2509" #-}

{-# TASK "causal_lm" #-}

{-# TOKENIZER "mistralai/Magistral-Small-2509" #-}

{-# MAIN "magistral" #-}

import Activations (silu)

import Attention (attention_gqa_with_additive_mask, mask_to_additive_for_input, merge_heads, reshape_heads)

import Masking (causal_mask_for_input)

import Math (mul)

import Positions (position_ids, rope_base_factors, rope_pair_base_factors)

import Cache

import Config

import NN

import Tensor

CFG = "text_config"

MODEL_DIM = 5120

VOCAB_SIZE = 131072

NUM_LAYERS = 40

NUM_HEADS = 32

KVH = 8

MODEL_HEAD_DIM = 128

QD = NUM_HEADS * MODEL_HEAD_DIM

KVD = KVH * MODEL_HEAD_DIM

FFN = 32768

EPS = 1e-05

THETA = 1000000000.0

HAS_WINDOW = false

MAX_POSITIONS <- HAS_WINDOW ? (Config.int @@'{CFG}.sliding_window' default=4096) : 0

magistral_norm :: Path -> Tensor[B,S,D] -> Tensor[B,S,D]
magistral_norm@path x = NN.rmsnorm@path x eps=EPS

magistral_block :: Tensor[B,S,D] -> Tensor[B,1,S,R] -> Tensor[B,1,S,R] -> Tensor[B,1,S,K] -> Tensor[B,NUM_HEADS,S,K] -> ?CacheLayer[B,KVH,P,DH] -> (Tensor[B,S,D], ?CacheLayer[B,KVH,K,DH])
magistral_block x rope_sin rope_cos mask additive_mask past_kv = do
  xn <- magistral_norm@input_layernorm x
  a, new_kv <- scope@self_attn do
    q <- NN.linear@q_proj xn dim=QD |> reshape_heads heads=NUM_HEADS
    k <- NN.linear@k_proj xn dim=KVD |> reshape_heads heads=KVH
    v <- NN.linear@v_proj xn dim=KVD |> reshape_heads heads=KVH
    q, k <- rope_pair_base_factors q k rope_sin rope_cos
    k, v, new_kv <- Cache.update past_kv k v
    a <- attention_gqa_with_additive_mask q k v additive_mask mask |> merge_heads |> NN.linear@o_proj dim=MODEL_DIM
    return a, new_kv
  x <- x + a
  xn <- magistral_norm@post_attention_layernorm x
  m <- scope@mlp do
    g <- NN.linear@gate_proj xn dim=FFN
    u <- NN.linear@up_proj xn dim=FFN
    return g |> silu |> mul u |> NN.linear@down_proj dim=MODEL_DIM
  return x + m, new_kv

magistral :: TokenIds[B,S] -> ?Tensor[B,K] -> ?Cache[B,KVH,P,DH] -> ?Bool -> (Tensor[B,S,V], ?Cache[B,KVH,K,DH])
magistral input_ids attn_mask past_kv use_cache = do
  past_length <- Cache.past_length past_kv
  pos_ids <- position_ids input_ids attn_mask=attn_mask past_length=past_length
  rope_sin, rope_cos <- ((rope_base_factors pos_ids MODEL_HEAD_DIM THETA) :: (Tensor[B,1,S,MODEL_HEAD_DIM], Tensor[B,1,S,MODEL_HEAD_DIM]))
  key_len <- past_length + S
  mask <- HAS_WINDOW ? (causal_mask_for_input input_ids key_len padding_mask=attn_mask window=MAX_POSITIONS) : (causal_mask_for_input input_ids key_len padding_mask=attn_mask)
  additive_mask <- mask_to_additive_for_input input_ids mask NUM_HEADS
  x, new_kv <- scope@language_model.model do
    x <- NN.embedding@embed_tokens input_ids dim=MODEL_DIM
    new_kv <- use_cache ? Cache.init : null
    x, new_kv <- for@layers i <- [0..NUM_LAYERS) carry (x, new_kv) do
      past_i <- Cache.index past_kv i
      x, new_i <- magistral_block x rope_sin rope_cos mask additive_mask past_i
      new_kv <- Cache.append new_kv new_i
      yield x, new_kv
    x <- magistral_norm@norm x
    return x, new_kv
  logits <- NN.linear@language_model.lm_head x dim=VOCAB_SIZE
  return logits, new_kv
