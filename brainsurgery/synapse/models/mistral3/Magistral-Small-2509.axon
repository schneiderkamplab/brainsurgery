{-# CHECKPOINTS "mistralai/Magistral-Small-2509" #-}
{-# TASK "causal_lm" #-}
{-# TOKENIZER "mistralai/Magistral-Small-2509" #-}

import Activations
import Activations (silu)
import Cache
import Cache (past_length)

D = 5120
V = 131072
L = 40
H = 32
KVH = 8
KVD = 1024
FFN = 32768
EPS = 1e-05
THETA = 1000000000.0
HAS_WINDOW = false
C = 0

magistral_norm :: @Path -> Tensor[B,S,D] -> Tensor[B,S,D]
magistral_norm@path x = rmsnorm@path x eps=EPS

magistral_block :: Tensor[B,S,D] -> Tensor[B,S] -> ?Tensor[B,S] -> ?CacheLayer -> (Tensor[B,S,D], ?CacheLayer)
magistral_block x pos_ids attn_mask past_kv = do
  xn <- magistral_norm@input_layernorm x
  a, new_kv <- scope@self_attn do
    q <- linear@q_proj xn dim=D |> reshape_heads heads=H
    k <- linear@k_proj xn dim=KVD |> reshape_heads heads=KVH
    v <- linear@v_proj xn dim=KVD |> reshape_heads heads=KVH
    q, k <- rope_pair_base q k pos_ids THETA
    k, v, new_kv <- Cache.update past_kv k v
    k <- repeat k repeats=(H / KVH)
    v <- repeat v repeats=(H / KVH)
    mask <- HAS_WINDOW ? (causal_mask q k window=C padding_mask=attn_mask) : (causal_mask q k padding_mask=attn_mask)
    a <- attention q k v mask=mask |> merge_heads |> linear@o_proj dim=D
    return a, new_kv
  x <- x + a
  xn <- magistral_norm@post_attention_layernorm x
  m <- scope@mlp do
    g <- linear@gate_proj xn dim=FFN
    u <- linear@up_proj xn dim=FFN
    return g |> silu |> mul u |> linear@down_proj dim=D
  return x + m, new_kv

magistral :: TokenIds[B,S] -> ?Tensor[B,S] -> ?Cache -> ?Bool -> (Tensor[B,S,V], ?Cache)
magistral input_ids attn_mask past_kv use_cache = do
  pos_ids <- position_ids input_ids attn_mask=attn_mask past_length=(past_length past_kv)
  x, new_kv <- scope@model root="language_model" do
    x <- embedding@embed_tokens input_ids dim=D
    new_kv <- use_cache ? Cache.init : null
    for@layers i <- [0..L) do
      past_i <- Cache.index past_kv i
      x, new_i <- magistral_block x pos_ids attn_mask past_i
      new_kv <- Cache.append new_kv new_i
    x <- magistral_norm@norm x
    return x, new_kv
  logits <- linear@language_model.lm_head x dim=V
  return logits, new_kv
