{-# CHECKPOINTS "mistralai/Magistral-Small-2509" #-}
{-# TASK "causal_lm" #-}
{-# TOKENIZER "mistralai/Magistral-Small-2509" #-}

import Activations
import Activations (silu)
import Attention
import Attention (attention, merge_heads, reshape_heads)
import Masking
import Masking (causal_mask)
import Math
import Math (mul)
import Positions
import Positions (position_ids, rope_pair_base)
import Cache
import NN
import Tensor

magistral_norm :: Path -> Tensor[B,S,D] -> Tensor[B,S,D]
magistral_norm@path x = NN.rmsnorm@path x eps=1e-05

magistral_block :: Tensor[B,S,D] -> Tensor[B,S] -> ?Tensor[B,S] -> ?CacheLayer -> (Tensor[B,S,D], ?CacheLayer)
magistral_block x pos_ids attn_mask past_kv = do
  xn <- magistral_norm@input_layernorm x
  a, new_kv <- scope@self_attn do
    q <- NN.linear@q_proj xn dim=5120 |> reshape_heads heads=32
    k <- NN.linear@k_proj xn dim=1024 |> reshape_heads heads=8
    v <- NN.linear@v_proj xn dim=1024 |> reshape_heads heads=8
    q, k <- rope_pair_base q k pos_ids 1000000000.0
    k, v, new_kv <- Cache.update past_kv k v
    k <- Tensor.repeat k repeats=4
    v <- Tensor.repeat v repeats=4
    mask <- (causal_mask q k padding_mask=attn_mask)
    a <- attention q k v mask |> merge_heads |> NN.linear@o_proj dim=5120
    return a, new_kv
  x <- x + a
  xn <- magistral_norm@post_attention_layernorm x
  m <- scope@mlp do
    g <- NN.linear@gate_proj xn dim=32768
    u <- NN.linear@up_proj xn dim=32768
    return g |> silu |> mul u |> NN.linear@down_proj dim=5120
  return x + m, new_kv

magistral :: TokenIds[B,S] -> ?Tensor[B,S] -> ?Cache -> ?Bool -> (Tensor[B,S,V], ?Cache)
magistral input_ids attn_mask past_kv use_cache = do
  pos_ids <- position_ids input_ids attn_mask=attn_mask past_length=(Cache.past_length past_kv)
  x, new_kv <- scope@language_model.model do
    x <- NN.embedding@embed_tokens input_ids dim=5120
    new_kv <- use_cache ? Cache.init : null
    for@layers i <- [0..40) do
      past_i <- Cache.index past_kv i
      x, new_i <- magistral_block x pos_ids attn_mask past_i
      new_kv <- Cache.append new_kv new_i
      yield x, new_kv
    x <- magistral_norm@norm x
    return x, new_kv
  logits <- NN.linear@language_model.lm_head x dim=131072
  return logits, new_kv
