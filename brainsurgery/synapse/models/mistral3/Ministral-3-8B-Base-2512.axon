{-# CHECKPOINTS "mistralai/Ministral-3-8B-Base-2512" #-}
{-# TASK "causal_lm" #-}

import Activations
import Activations (silu)
import Cache
import Cache
import Attention (reshape_heads, merge_heads)
import Attention (attention_masked)
import Masking (causal_mask)
import Positions (position_ids, rope_pair_yarn)
import Math (floor, log, mul)

TEXT_PARAM_ROOT = "language_model"
D = 4096
V = 131072
L = 34
H = 32
KVH = 8
KVD = 1024
FFN = 14336
EPS = 1e-05
THETA = 1000000.0
ROPE_FACTOR = 16.0
ROPE_CONTEXT = 16384
ROPE_BETA_FAST = 32.0
ROPE_BETA_SLOW = 1.0
ROPE_MSCALE = 1.0
ROPE_MSCALE_ALL_DIM = 1.0
Q_SCALE_BETA = 0.1

mistral3_norm :: @Path -> Tensor[B,S,D] -> Tensor[B,S,D]
mistral3_norm@path x = NN.rmsnorm@path x eps=EPS

mistral3_query_scale :: Tensor[B,S] -> Tensor[B,1,S,1]
mistral3_query_scale pos_ids = do
  scaled <- pos_ids / ROPE_CONTEXT
  bucket <- Math.floor scaled
  shifted <- bucket + 1.0
  logged <- Math.log shifted
  beta_scaled <- logged * Q_SCALE_BETA
  gain <- beta_scaled + 1.0
  gain3 <- Tensor.unsqueeze gain dim=1
  gain4 <- Tensor.unsqueeze gain3 dim=3
  return gain4

mistral3_block :: Tensor[B,S,D] -> Tensor[B,S] -> ?Tensor[B,S] -> ?CacheLayer -> (Tensor[B,S,D], ?CacheLayer)
mistral3_block x pos_ids attn_mask past_kv = do
  xn <- mistral3_norm@input_layernorm x
  a, new_kv <- scope@self_attn do
    q <- NN.linear@q_proj xn dim=D |> reshape_heads heads=H
    k <- NN.linear@k_proj xn dim=KVD |> reshape_heads heads=KVH
    v <- NN.linear@v_proj xn dim=KVD |> reshape_heads heads=KVH
    q, k <- rope_pair_yarn q k pos_ids THETA ROPE_FACTOR ROPE_BETA_FAST ROPE_BETA_SLOW ROPE_CONTEXT mscale=ROPE_MSCALE mscale_all_dim=ROPE_MSCALE_ALL_DIM
    q_scale <- mistral3_query_scale pos_ids
    q <- q * q_scale
    k, v, new_kv <- Cache.update past_kv k v
    k <- Tensor.repeat k repeats=(H / KVH)
    v <- Tensor.repeat v repeats=(H / KVH)
    mask <- causal_mask q k padding_mask=attn_mask
    a <- attention_masked q k v mask=mask |> merge_heads |> NN.linear@o_proj dim=D
    return a, new_kv
  x <- x + a
  xn <- mistral3_norm@post_attention_layernorm x
  m <- scope@mlp do
    g <- NN.linear@gate_proj xn dim=FFN
    u <- NN.linear@up_proj xn dim=FFN
    return g |> silu |> mul u |> NN.linear@down_proj dim=D
  return x + m, new_kv

mistral3 :: TokenIds[B,S] -> ?Tensor[B,S] -> ?Cache -> ?Bool -> (Tensor[B,S,V], ?Cache)
mistral3 input_ids attn_mask past_kv use_cache = do
  pos_ids <- position_ids input_ids attn_mask=attn_mask past_length=(Cache.past_length past_kv)
  x, new_kv <- scope@model root=TEXT_PARAM_ROOT do
    x <- NN.embedding@embed_tokens input_ids dim=D
    new_kv <- use_cache ? Cache.init : null
    for@layers i <- [0..L) do
      past_i <- Cache.index past_kv i
      x, new_i <- mistral3_block x pos_ids attn_mask past_i
      new_kv <- Cache.append new_kv new_i
    x <- mistral3_norm@norm x
    return x, new_kv
  logits <- scope@language_model do
    logits <- NN.linear@lm_head x dim=V
    return logits
  return logits, new_kv
