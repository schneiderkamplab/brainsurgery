{-# CHECKPOINTS "test/Mistral3-Test" #-}

{-# TASK "causal_lm" #-}

{-# MAIN "mistral3" #-}

import Activations (silu)

import Attention (attention, merge_heads, reshape_heads)

import Masking (Mask, causal_mask_for_input, mask_for_input, mask_length_for_input)

import Math (floor, log, mul)

import Positions (position_ids, rope_pair_yarn)

import Cache

import Config

import NN

import Tensor

HAS_TEXT_CONFIG <- true

MODEL_DIM <- HAS_TEXT_CONFIG ? (128) : (4096)

VOCAB_SIZE <- HAS_TEXT_CONFIG ? (150000) : (131072)

NUM_LAYERS <- HAS_TEXT_CONFIG ? (4) : (34)

NUM_HEADS <- HAS_TEXT_CONFIG ? (4) : (32)

KVH <- HAS_TEXT_CONFIG ? (2) : (8)

HAS_HEAD_DIM <- HAS_TEXT_CONFIG ? (true) : (false)

MODEL_HEAD_DIM <- HAS_HEAD_DIM ? (HAS_TEXT_CONFIG ? (32) : (128)) : (MODEL_DIM / NUM_HEADS)

FFN <- HAS_TEXT_CONFIG ? (256) : (14336)

EPS <- HAS_TEXT_CONFIG ? (1e-05) : (1e-05)

THETA <- HAS_TEXT_CONFIG ? (1000000.0) : (1000000.0)

ROPE_FACTOR <- HAS_TEXT_CONFIG ? (16.0) : (16.0)

ROPE_CONTEXT <- HAS_TEXT_CONFIG ? (256) : (16384)

ROPE_BETA_FAST <- HAS_TEXT_CONFIG ? (32.0) : (32.0)

ROPE_BETA_SLOW <- HAS_TEXT_CONFIG ? (1.0) : (1.0)

ROPE_MSCALE <- HAS_TEXT_CONFIG ? (1.0) : (1.0)

ROPE_MSCALE_ALL_DIM <- HAS_TEXT_CONFIG ? (1.0) : (1.0)

Q_SCALE_BETA <- HAS_TEXT_CONFIG ? (0.1) : (0.1)

QD = NUM_HEADS * MODEL_HEAD_DIM

KVD = KVH * MODEL_HEAD_DIM

MAX_POSITIONS = ROPE_CONTEXT

mistral3_norm :: Path -> Tensor[B,S,D] -> Tensor[B,S,D]
mistral3_norm@path x = NN.rmsnorm@path x eps=EPS

mistral3_query_scale :: Tensor[B,S] -> Tensor[B,1,S,1]
mistral3_query_scale pos_ids = do
  scaled <- pos_ids / ROPE_CONTEXT
  bucket <- floor scaled
  shifted <- bucket + 1.0
  logged <- log shifted
  beta_scaled <- logged * Q_SCALE_BETA
  gain <- beta_scaled + 1.0
  gain3 <- Tensor.unsqueeze gain dim=1
  gain4 <- Tensor.unsqueeze gain3 dim=3
  return gain4

mistral3_block :: Tensor[B,S,D] -> Tensor[B,S] -> Tensor[B,1,S,1] -> Tensor[B,1,S,K] -> ?CacheLayer[B,KVH,P,ROPE_CONTEXT,DH] -> (Tensor[B,S,D], ?CacheLayer[B,KVH,K,ROPE_CONTEXT,DH])
mistral3_block x pos_ids q_scale mask past_kv = do
  xn <- mistral3_norm@input_layernorm x
  a, new_kv <- scope@self_attn do
    q <- NN.linear@q_proj xn dim=QD |> reshape_heads heads=NUM_HEADS
    k <- NN.linear@k_proj xn dim=KVD |> reshape_heads heads=KVH
    v <- NN.linear@v_proj xn dim=KVD |> reshape_heads heads=KVH
    q, k <- rope_pair_yarn q k pos_ids THETA ROPE_FACTOR ROPE_BETA_FAST ROPE_BETA_SLOW ROPE_CONTEXT mscale=ROPE_MSCALE mscale_all_dim=ROPE_MSCALE_ALL_DIM
    q <- q * q_scale
    k, v, new_kv <- Cache.update past_kv k v
    k <- Tensor.repeat k repeats=(NUM_HEADS / KVH)
    v <- Tensor.repeat v repeats=(NUM_HEADS / KVH)
    a <- attention q k v mask |> merge_heads |> NN.linear@o_proj dim=MODEL_DIM
    return a, new_kv
  x <- x + a
  xn <- mistral3_norm@post_attention_layernorm x
  m <- scope@mlp do
    g <- NN.linear@gate_proj xn dim=FFN
    u <- NN.linear@up_proj xn dim=FFN
    return g |> silu |> mul u |> NN.linear@down_proj dim=MODEL_DIM
  return x + m, new_kv

mistral3 :: TokenIds[B,S] -> ?Mask[B,K,MAX_POSITIONS] -> ?Cache[B,KVH,P,ROPE_CONTEXT,DH] -> ?Bool -> (Tensor[B,S,V], ?Cache[B,KVH,K,ROPE_CONTEXT,DH])
mistral3 input_ids attn_mask past_kv use_cache = do
  past_length <- Cache.past_length past_kv
  attn_mask <- mask_for_input input_ids attn_mask MAX_POSITIONS
  pos_ids <- position_ids input_ids attn_mask=attn_mask past_length=past_length
  q_scale <- mistral3_query_scale pos_ids
  key_len <- mask_length_for_input input_ids attn_mask past_length
  mask <- causal_mask_for_input input_ids key_len padding_mask=attn_mask
  work_kv <- Cache.prepare past_kv use_cache MAX_POSITIONS
  read_kv <- Cache.read past_kv work_kv
  x, new_kv <- scope@language_model.model do
    x <- NN.embedding@embed_tokens input_ids dim=MODEL_DIM
    x, work_kv <- for@layers i <- [0..NUM_LAYERS) carry (x, work_kv) do
      past_i <- Cache.index read_kv i
      x, new_i <- mistral3_block x pos_ids q_scale mask past_i
      work_kv <- Cache.append work_kv new_i
      yield x, work_kv
    x <- mistral3_norm@norm x
    return x, work_kv
  new_length <- past_length + S
  new_kv <- Cache.finish new_kv new_length
  new_kv <- use_cache ? new_kv : null
  logits <- scope@language_model do
    logits <- NN.linear@lm_head x dim=VOCAB_SIZE
    return logits
  return logits, new_kv
