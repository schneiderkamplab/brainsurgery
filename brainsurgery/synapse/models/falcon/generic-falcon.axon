{-# CHECKPOINTS ["falcon_rw_1b"] #-}
{-# TASK "causal_lm" #-}

import Config
import Activations (gelu)
import NN
import Tensor
import Attention
import Attention (mask_to_additive, merge_heads, split_qkv_heads)
import Cache
import Compat attention
import Positions (linear_position_bias)
import Masking
import Masking (causal_mask)

D   = Config.int "hidden_size" default=2048
V   = Config.int "vocab_size" default=50304
L   = Config.int "num_hidden_layers" default=24
H   = Config.int "num_attention_heads" default=32
HAS_N_INNER = Config.has_value "n_inner"
FFN_INT = Config.int "n_inner" default=0
FFN = HAS_N_INNER ? ((FFN_INT == 0) ? (4 * D) : FFN_INT) : (4 * D)
C   = Config.int "max_position_embeddings" default=2048
falcon_block :: Tensor[B,S,D] -> Tensor[B,S] -> ?CacheLayer -> (Tensor[B,S,D], ?CacheLayer)
falcon_block x attn_mask past_kv = do
  xn <- NN.layernorm@input_layernorm x dim=D

  a, new_kv <- scope@self_attention do
    qkv <- NN.linear@query_key_value xn dim=(3 * D) bias=true
    q, k, v <- split_qkv_heads qkv heads=H layout="interleaved"
    k, v, new_kv <- Cache.update past_kv k v
    keep <- causal_mask q k window=C padding_mask=attn_mask
    pos_bias <- linear_position_bias attn_mask heads=H scale=0.125
    scores_ref <- Tensor.matmul q (Tensor.transpose k dim1=2 dim2=3)
    causal_bias <- mask_to_additive scores_ref keep
    mask <- causal_bias + pos_bias
    a <- attention q k v mask=mask |> merge_heads
    a <- NN.linear@dense a dim=D bias=true
    return a, new_kv

  x <- x + a
  x_mlp <- NN.layernorm@post_attention_layernorm x dim=D
  m <- scope@mlp do
    h <- NN.linear@dense_h_to_4h x_mlp dim=FFN bias=true
    return gelu h |> NN.linear@dense_4h_to_h dim=D bias=true
  x <- x + m
  return x, new_kv

falcon :: TokenIds[B,S] -> Tensor[B,S] -> ?Cache -> ?Bool -> (Tensor[B,S,V], ?Cache)
falcon input_ids attn_mask past_kv use_cache = do
  x <- NN.embedding@transformer.word_embeddings input_ids dim=D
  new_kv <- use_cache ? Cache.init : null
  for@transformer.h i <- [0..L) do
    past_i <- Cache.index past_kv i
    x, new_i <- falcon_block x attn_mask past_i
    new_kv <- Cache.append new_kv new_i
  logits <- NN.layernorm@transformer.ln_f x dim=D |> NN.linear@lm_head dim=V
  return logits, new_kv
