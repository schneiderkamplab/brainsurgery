{-# CHECKPOINTS ["falcon_rw_1b"] #-}
{-# TASK "causal_lm" #-}

import Activations (gelu)
import Attention (attention, merge_heads, split_qkv_heads)
import Masking (Mask, causal_mask_for_input, mask_for_input, mask_length_for_input)
import NN (embedding, layernorm, linear)
import Positions (linear_position_bias_for_input)
import Cache
import Config



MODEL_DIM <- Config.int@hidden_size default=2048

VOCAB_SIZE <- Config.int@vocab_size default=50304

NUM_LAYERS <- Config.int@num_hidden_layers default=24

NUM_HEADS <- Config.int@num_attention_heads default=32

HAS_N_INNER <- Config.has_value@n_inner

FFN_INT <- Config.int@n_inner default=0

FFN <- do
  return HAS_N_INNER ? ((FFN_INT == 0) ? (4 * MODEL_DIM) : FFN_INT) : (4 * MODEL_DIM)

MAX_POSITIONS <- Config.int@max_position_embeddings default=2048

falcon_block :: Tensor[B,S,D] -> Tensor[B,1,S,K] -> Tensor[B,NUM_HEADS,1,K] -> ?CacheLayer[B,NUM_HEADS,P,MAX_POSITIONS,DH] -> (Tensor[B,S,D], ?CacheLayer[B,NUM_HEADS,K,MAX_POSITIONS,DH])
falcon_block x keep pos_bias past_kv = do
  xn <- layernorm@input_layernorm x dim=MODEL_DIM

  a, new_kv <- scope@self_attention do
    qkv <- linear@query_key_value xn dim=(3 * MODEL_DIM) bias=true
    qkv_heads <- split_qkv_heads qkv heads=NUM_HEADS layout="interleaved"
    q, k, v <- (qkv_heads :: (Tensor[B,NUM_HEADS,S,MODEL_DIM / NUM_HEADS], Tensor[B,NUM_HEADS,S,MODEL_DIM / NUM_HEADS], Tensor[B,NUM_HEADS,S,MODEL_DIM / NUM_HEADS]))
    k, v, new_kv <- Cache.update past_kv k v
    a <- attention q k v keep=keep rel_bias=pos_bias scale=0.125 |> merge_heads
    a <- linear@dense a dim=MODEL_DIM bias=true
    return a, new_kv

  x <- x + a
  x_mlp <- layernorm@post_attention_layernorm x dim=MODEL_DIM
  m <- scope@mlp do
    h <- linear@dense_h_to_4h x_mlp dim=FFN bias=true
    return gelu h |> linear@dense_4h_to_h dim=MODEL_DIM bias=true
  x <- x + m
  return x, new_kv

falcon :: TokenIds[B,S] -> ?Mask[B,K,MAX_POSITIONS] -> ?Cache[B,NUM_HEADS,P,MAX_POSITIONS,DH] -> ?Bool -> (Tensor[B,S,V], ?Cache[B,NUM_HEADS,K,MAX_POSITIONS,DH])
falcon input_ids attn_mask past_kv use_cache = do
  x <- embedding@transformer.word_embeddings input_ids dim=MODEL_DIM
  past_length <- Cache.past_length past_kv
  attn_mask <- mask_for_input input_ids attn_mask MAX_POSITIONS
  work_kv <- Cache.prepare past_kv use_cache MAX_POSITIONS
  read_kv <- Cache.read past_kv work_kv
  key_len <- mask_length_for_input input_ids attn_mask past_length
  keep <- causal_mask_for_input input_ids key_len padding_mask=attn_mask window=MAX_POSITIONS
  pos_bias <- linear_position_bias_for_input attn_mask heads=NUM_HEADS scale=0.125
  x, work_kv <- for@transformer.h i <- [0..NUM_LAYERS) carry (x, work_kv) do
    past_i <- Cache.index read_kv i
    x, new_i <- falcon_block x keep pos_bias past_i
    work_kv <- Cache.append work_kv new_i
    yield x, work_kv
  logits <- layernorm@transformer.ln_f x dim=MODEL_DIM |> linear@lm_head dim=VOCAB_SIZE
  new_length <- past_length + S
  new_kv <- Cache.finish work_kv new_length
  new_kv <- use_cache ? new_kv : null
  return logits, new_kv
