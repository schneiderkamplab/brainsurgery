{-# CHECKPOINTS "microsoft/Phi-4-mini-reasoning" #-}
{-# TASK "causal_lm" #-}

import Activations
import Activations (silu)
import Cache
import Cache (past_length)

PARAM_ROOT = ""
D = 3072
V = 200064
L = 32
H = 24
KVH = 8
QD = 3072
KVD = 1024
FFN = 8192
EPS = 1e-05
THETA = 10000.0
PARTIAL_ROTARY_FACTOR = 0.75
ROPE_MODE = "longrope"
ROPE_ORIGINAL_CONTEXT = 4096
ROPE_MAX_CONTEXT = 131072
ROPE_LONG_FACTOR = [1, 1.118320672, 1.250641126, 1.398617824, 1.564103225, 1.74916897, 1.956131817, 2.187582649, 2.446418898, 2.735880826, 3.059592084, 3.421605075, 3.826451687, 4.279200023, 4.785517845, 5.351743533, 5.984965424, 6.693110555, 7.485043894, 8.370679318, 9.36110372, 10.4687158, 11.70738129, 13.09260651, 14.64173252, 16.37415215, 18.31155283, 20.47818807, 22.90118105, 25.61086418, 28.64115884, 32.03, 32.1, 32.13, 32.23, 32.6, 32.61, 32.64, 32.66, 32.7, 32.71, 32.93, 32.97, 33.28, 33.49, 33.5, 44.16, 47.77]
ROPE_SHORT_FACTOR = [1, 1.118320672, 1.250641126, 1.398617824, 1.564103225, 1.74916897, 1.956131817, 2.187582649, 2.446418898, 2.735880826, 3.059592084, 3.421605075, 3.826451687, 4.279200023, 4.785517845, 5.351743533, 5.984965424, 6.693110555, 7.485043894, 8.370679318, 9.36110372, 10.4687158, 11.70738129, 13.09260651, 14.64173252, 16.37415215, 18.31155283, 20.47818807, 22.90118105, 25.61086418, 28.64115884, 32.03, 32.1, 32.13, 32.23, 32.6, 32.61, 32.64, 32.66, 32.7, 32.71, 32.93, 32.97, 33.28, 33.49, 33.5, 44.16, 47.77]
HAS_LONGROPE = true
ROPE_ATTENTION_FACTOR = 1.1902380714238083
WINDOW_LOCAL = 262144
HAS_LM_HEAD = false

phi4_norm :: @Path -> Tensor -> Tensor
phi4_norm@path x = rmsnorm@path x eps=EPS

phi4_block :: Tensor -> IdxTensor -> ?Tensor -> ?CacheLayer -> (Tensor, ?CacheLayer)
phi4_block x pos_ids attn_mask past_kv = do
  xn <- phi4_norm@input_layernorm x
  a, new_kv <- scope@self_attn do
    qkv <- linear@qkv_proj xn dim=(QD + KVD + KVD) bias=false
    q, k, v <- split qkv sizes=[QD, KVD, KVD]
    q <- reshape_heads q heads=H
    k <- reshape_heads k heads=KVH
    v <- reshape_heads v heads=KVH
    q, k <- HAS_LONGROPE ? (rope_pair q k position_ids=pos_ids theta=THETA partial_rotary_factor=PARTIAL_ROTARY_FACTOR rope_mode=ROPE_MODE original_context=ROPE_ORIGINAL_CONTEXT max_context=ROPE_MAX_CONTEXT long_factor=ROPE_LONG_FACTOR short_factor=ROPE_SHORT_FACTOR attention_factor=ROPE_ATTENTION_FACTOR) : (rope_pair q k position_ids=pos_ids theta=THETA partial_rotary_factor=PARTIAL_ROTARY_FACTOR)
    k, v, new_kv <- Cache.update past_kv k v
    k <- repeat k (H / KVH)
    v <- repeat v (H / KVH)
    mask <- causal_mask q k window=WINDOW_LOCAL padding_mask=attn_mask
    a <- attention q k v mask=mask eager=true |> merge_heads |> linear@o_proj dim=D bias=false
    return a, new_kv
  x <- x + a
  xn <- phi4_norm@post_attention_layernorm x
  m <- scope@mlp do
    gate_up <- linear@gate_up_proj xn dim=(2 * FFN)
    g, u <- split gate_up sizes=[FFN, FFN]
    return g |> silu |> mul u |> linear@down_proj dim=D
  return x + m, new_kv

phi4 :: TokenIds[B,S] -> ?Tensor[B,S] -> ?Cache -> ?Bool -> (Tensor[B,S,V], ?Cache)
phi4 input_ids attn_mask past_kv use_cache = do
  pos_ids <- position_ids input_ids attn_mask past_length=(past_length past_kv)
  x, new_kv <- scope@model root=PARAM_ROOT do
    x <- embedding@embed_tokens input_ids dim=D
    new_kv <- use_cache ? Cache.init : null
    for@layers i <- [0..L) do
      past_i <- Cache.index past_kv i
      x, new_i <- phi4_block x pos_ids attn_mask past_i
      new_kv <- Cache.append new_kv new_i
    x <- phi4_norm@norm x
    return x, new_kv
  logits <- HAS_LM_HEAD ? (linear@lm_head x dim=V) : (linear@model.embed_tokens x dim=V)
  return logits, new_kv
