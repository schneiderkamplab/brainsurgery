{-# CHECKPOINTS ["microsoft/Phi-4-mini-instruct", "microsoft/Phi-4-mini-reasoning"] #-}
{-# TASK "causal_lm" #-}

import Activations (silu)
import Attention (attention, merge_heads, reshape_heads)
import Masking (causal_mask_for_input)
import Math (floor, mul)
import Params (has_root)
import Positions (position_ids, rope_longrope_factors, rope_pair_base_prefix_factors)
import Cache
import Config
import NN
import Tensor



MODEL_DIM = Config.int @@hidden_size default=3072
VOCAB_SIZE = Config.int @@vocab_size default=200064
NUM_LAYERS = Config.int @@num_hidden_layers default=32
NUM_HEADS = Config.int @@num_attention_heads default=24
KVH = Config.int @@num_key_value_heads default=8
MODEL_HEAD_DIM = (Config.has_key @@head_dim) ? (Config.int @@head_dim default=128) : 128
QD = NUM_HEADS * MODEL_HEAD_DIM
KVD = KVH * MODEL_HEAD_DIM
FFN = Config.int @@intermediate_size default=8192
EPS = Config.float @@rms_norm_eps default=1e-05
THETA = Config.float @@rope_theta default=10000.0
PARTIAL_ROTARY_FACTOR <- Config.float @@partial_rotary_factor default=0.75
ROTARY_DIM <- floor (MODEL_HEAD_DIM * PARTIAL_ROTARY_FACTOR)
ROPE_MODE = Config.str @@'rope_scaling.type' default=(Config.str @@'rope_scaling.rope_type' default="default")
ROPE_ORIGINAL_CONTEXT = Config.int @@'rope_scaling.original_max_position_embeddings' default=(Config.int @@original_max_position_embeddings default=4096)
ROPE_MAX_CONTEXT = Config.int @@max_position_embeddings default=131072
ROPE_LONG_FACTOR = Config.list @@'rope_scaling.long_factor' default=[]
ROPE_SHORT_FACTOR = Config.list @@'rope_scaling.short_factor' default=[]
HAS_LONGROPE = Config.has_key @@'rope_scaling.long_factor'
ROPE_ATTENTION_FACTOR = (ROPE_MAX_CONTEXT > ROPE_ORIGINAL_CONTEXT) ? 1.1902380714238083 : 1.0
WINDOW_LOCAL = Config.int @@sliding_window default=262144
HAS_LM_HEAD = has_root "lm_head"

phi4_norm :: Path -> Tensor[B,S,D] -> Tensor[B,S,D]
phi4_norm@path x = NN.rmsnorm@path x eps=EPS

phi4_block :: Tensor[B,S,D] -> Tensor[B,1,S,R] -> Tensor[B,1,S,R] -> Tensor[B,1,S,K] -> ?CacheLayer[B,KVH,P,DH] -> (Tensor[B,S,D], ?CacheLayer[B,KVH,K,DH])
phi4_block x rope_sin rope_cos mask past_kv = do
  xn <- phi4_norm@input_layernorm x
  a, new_kv <- scope@self_attn do
    qkv <- NN.linear@qkv_proj xn dim=(QD + KVD + KVD) bias=false
    q, k, v <- Tensor.split qkv sizes=[QD, KVD, KVD]
    q <- reshape_heads q heads=NUM_HEADS
    k <- reshape_heads k heads=KVH
    v <- reshape_heads v heads=KVH
    q, k <- rope_pair_base_prefix_factors q k rope_sin rope_cos ROTARY_DIM
    k, v, new_kv <- Cache.update past_kv k v
    k <- Tensor.repeat k repeats=(NUM_HEADS / KVH)
    v <- Tensor.repeat v repeats=(NUM_HEADS / KVH)
    a <- attention q k v mask |> merge_heads |> NN.linear@o_proj dim=MODEL_DIM bias=false
    return a, new_kv
  x <- x + a
  xn <- phi4_norm@post_attention_layernorm x
  m <- scope@mlp do
    gate_up <- NN.linear@gate_up_proj xn dim=(2 * FFN)
    g, u <- Tensor.split gate_up sizes=[FFN, FFN]
    return g |> silu |> mul u |> NN.linear@down_proj dim=MODEL_DIM
  return x + m, new_kv

phi4 :: TokenIds[B,S] -> ?Tensor[B,K] -> ?Cache[B,KVH,P,DH] -> ?Bool -> (Tensor[B,S,V], ?Cache[B,KVH,K,DH])
phi4 input_ids attn_mask past_kv use_cache = do
  past_length <- Cache.past_length past_kv
  pos_ids <- position_ids input_ids attn_mask=attn_mask past_length=past_length
  rope_sin, rope_cos <- rope_longrope_factors pos_ids ROTARY_DIM THETA ROPE_ORIGINAL_CONTEXT ROPE_LONG_FACTOR ROPE_SHORT_FACTOR attention_factor=ROPE_ATTENTION_FACTOR
  key_len <- past_length + S
  mask <- causal_mask_for_input input_ids key_len padding_mask=attn_mask window=WINDOW_LOCAL
  x, new_kv <- scope@model do
    x <- NN.embedding@embed_tokens input_ids dim=MODEL_DIM
    new_kv <- use_cache ? Cache.init : null
    x, new_kv <- for@layers i <- [0..NUM_LAYERS) carry (x, new_kv) do
      past_i <- Cache.index past_kv i
      x, new_i <- phi4_block x rope_sin rope_cos mask past_i
      new_kv <- Cache.append new_kv new_i
      yield x, new_kv
    x <- phi4_norm@norm x
    return x, new_kv
  logits <- HAS_LM_HEAD ? (NN.linear@lm_head x dim=VOCAB_SIZE) : (NN.linear@model.embed_tokens x dim=VOCAB_SIZE)
  return logits, new_kv
