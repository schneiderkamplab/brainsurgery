{-# CHECKPOINTS ["microsoft/Phi-4-mini-instruct", "microsoft/Phi-4-mini-reasoning"] #-}
{-# TASK "causal_lm" #-}

import Config
import Params
import Activations (silu)
import Cache
import Positions (position_ids, rope_pair_base, rope_pair_longrope)
import Attention (reshape_heads, merge_heads)
import Attention (attention_masked)
import Masking (causal_mask)
import Math (mul)

CFG = (Config.has_key "text_config") ? "text_config" : ""
PARAM_ROOT = (Params.has_root "language_model") ? "language_model" : ""

D = Config.int "hidden_size" root=CFG default=3072
V = Config.int "vocab_size" root=CFG default=200064
L = Config.int "num_hidden_layers" root=CFG default=32
H = Config.int "num_attention_heads" root=CFG default=24
KVH = Config.int "num_key_value_heads" root=CFG default=8
HD = (Config.has_key "head_dim" root=CFG) ? (Config.int "head_dim" root=CFG default=128) : 128
QD = H * HD
KVD = KVH * HD
FFN = Config.int "intermediate_size" root=CFG default=8192
EPS = Config.float "rms_norm_eps" root=CFG default=1e-05
THETA = Config.float "rope_theta" root=CFG default=10000.0
PARTIAL_ROTARY_FACTOR = Config.float "partial_rotary_factor" root=CFG default=0.75
ROPE_MODE = Config.str "type" root="rope_scaling" default=(Config.str "rope_type" root="rope_scaling" default="default")
ROPE_ORIGINAL_CONTEXT = Config.int "original_max_position_embeddings" root="rope_scaling" default=(Config.int "original_max_position_embeddings" root=CFG default=4096)
ROPE_MAX_CONTEXT = Config.int "max_position_embeddings" root=CFG default=131072
ROPE_LONG_FACTOR = Config.list "long_factor" root="rope_scaling" default=[]
ROPE_SHORT_FACTOR = Config.list "short_factor" root="rope_scaling" default=[]
HAS_LONGROPE = Config.has_key "long_factor" root="rope_scaling"
ROPE_ATTENTION_FACTOR = (ROPE_MAX_CONTEXT > ROPE_ORIGINAL_CONTEXT) ? 1.1902380714238083 : 1.0
WINDOW_LOCAL = Config.int "sliding_window" root=CFG default=262144
HAS_LM_HEAD = Params.has_root "lm_head"

phi4_norm :: @Path -> Tensor -> Tensor
phi4_norm@path x = NN.rmsnorm@path x eps=EPS

phi4_block :: Tensor -> IdxTensor -> ?Tensor -> ?CacheLayer -> (Tensor, ?CacheLayer)
phi4_block x pos_ids attn_mask past_kv = do
  xn <- phi4_norm@input_layernorm x
  a, new_kv <- scope@self_attn do
    qkv <- NN.linear@qkv_proj xn dim=(QD + KVD + KVD) bias=false
    q, k, v <- Tensor.split qkv sizes=[QD, KVD, KVD]
    q <- reshape_heads q heads=H
    k <- reshape_heads k heads=KVH
    v <- reshape_heads v heads=KVH
    q, k <- HAS_LONGROPE ? (rope_pair_longrope q k pos_ids THETA ROPE_ORIGINAL_CONTEXT ROPE_MAX_CONTEXT ROPE_LONG_FACTOR ROPE_SHORT_FACTOR attention_factor=ROPE_ATTENTION_FACTOR partial_rotary_factor=PARTIAL_ROTARY_FACTOR) : (rope_pair_base q k pos_ids theta=THETA partial_rotary_factor=PARTIAL_ROTARY_FACTOR)
    k, v, new_kv <- Cache.update past_kv k v
    k <- Tensor.repeat k repeats=(H / KVH)
    v <- Tensor.repeat v repeats=(H / KVH)
    mask <- causal_mask q k window=WINDOW_LOCAL padding_mask=attn_mask
    a <- attention_masked q k v mask=mask eager=true |> merge_heads |> NN.linear@o_proj dim=D bias=false
    return a, new_kv
  x <- x + a
  xn <- phi4_norm@post_attention_layernorm x
  m <- scope@mlp do
    gate_up <- NN.linear@gate_up_proj xn dim=(2 * FFN)
    g, u <- Tensor.split gate_up sizes=[FFN, FFN]
    return g |> silu |> mul u |> NN.linear@down_proj dim=D
  return x + m, new_kv

phi4 :: TokenIds[B,S] -> ?Tensor[B,S] -> ?Cache -> ?Bool -> (Tensor[B,S,V], ?Cache)
phi4 input_ids attn_mask past_kv use_cache = do
  pos_ids <- position_ids input_ids attn_mask=attn_mask past_length=(Cache.past_length past_kv)
  x, new_kv <- scope@model root=PARAM_ROOT do
    x <- NN.embedding@embed_tokens input_ids dim=D
    new_kv <- use_cache ? Cache.init : null
    for@layers i <- [0..L) do
      past_i <- Cache.index past_kv i
      x, new_i <- phi4_block x pos_ids attn_mask past_i
      new_kv <- Cache.append new_kv new_i
    x <- phi4_norm@norm x
    return x, new_kv
  logits <- HAS_LM_HEAD ? (NN.linear@lm_head x dim=V) : (NN.linear@model.embed_tokens x dim=V)
  return logits, new_kv
