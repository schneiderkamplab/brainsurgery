{-# CHECKPOINTS "EleutherAI/gpt-neo-2.7B" #-}

{-# TASK "causal_lm" #-}

{-# MAIN "gpt_neo" #-}

import Activations (gelu_new)

import Attention (attention, merge_heads, reshape_heads)

import Cache

import Config

import List

import Masking (Mask, causal_mask_for_input, mask_for_input, mask_length_for_input)

import NN

import Positions (position_ids)

MODEL_DIM <- (2560 :: Dim)

VOCAB_SIZE <- (50257 :: Dim)

NUM_LAYERS <- (32 :: Dim)

NUM_HEADS <- (20 :: Dim)

FFN <- Config.dim @@intermediate_size default=(4 * MODEL_DIM)

MAX_POSITIONS <- (2048 :: Dim)

WINDOW_SIZE <- (256 :: Dim)

EPS <- 1e-05

ATTENTION_LAYERS <- ((["global", "local", "global", "local", "global", "local", "global", "local", "global", "local", "global", "local", "global", "local", "global", "local", "global", "local", "global", "local", "global", "local", "global", "local", "global", "local", "global", "local", "global", "local", "global", "local"]) :: List[String])

gpt_neo_block :: Tensor[B,S,D] -> Tensor[B,1,S,K] -> ?CacheLayer[B,NUM_HEADS,P,MAX_POSITIONS,DH] -> (Tensor[B,S,D], ?CacheLayer[B,NUM_HEADS,K,MAX_POSITIONS,DH])
gpt_neo_block x mask past_kv = do
  residual <- x
  xn <- NN.layernorm@ln_1 x eps=EPS
  q <- NN.linear@attn.attention.q_proj xn dim=MODEL_DIM bias=false |> reshape_heads heads=NUM_HEADS
  k <- NN.linear@attn.attention.k_proj xn dim=MODEL_DIM bias=false |> reshape_heads heads=NUM_HEADS
  v <- NN.linear@attn.attention.v_proj xn dim=MODEL_DIM bias=false |> reshape_heads heads=NUM_HEADS
  k, v, new_kv <- Cache.update past_kv k v
  a <- attention q k v mask scale=1.0 fp32_compute=true |> merge_heads |> NN.linear@attn.attention.out_proj dim=MODEL_DIM bias=true
  x <- residual + a
  residual <- x
  x <- NN.layernorm@ln_2 x eps=EPS
  x <- NN.linear@mlp.c_fc x dim=FFN bias=true |> gelu_new |> NN.linear@mlp.c_proj dim=MODEL_DIM bias=true
  return residual + x, new_kv

gpt_neo :: TokenIds[B,S] -> ?Mask[B,K,MAX_POSITIONS] -> ?Cache[B,NUM_HEADS,P,MAX_POSITIONS,DH] -> ?Bool -> (Tensor[B,S,V], ?Cache[B,NUM_HEADS,K,MAX_POSITIONS,DH])
gpt_neo input_ids attn_mask past_kv use_cache = do
  past_length <- Cache.past_length past_kv
  attn_mask <- mask_for_input input_ids attn_mask MAX_POSITIONS
  pos_ids <- position_ids input_ids attn_mask=attn_mask past_length=past_length
  tok <- NN.embedding@transformer.wte input_ids dim=MODEL_DIM
  pos <- NN.embedding@transformer.wpe pos_ids dim=MODEL_DIM
  x <- tok + pos
  key_len <- mask_length_for_input input_ids attn_mask past_length
  global_mask <- causal_mask_for_input input_ids key_len padding_mask=attn_mask window=MAX_POSITIONS
  local_mask <- causal_mask_for_input input_ids key_len padding_mask=attn_mask window=WINDOW_SIZE
  work_kv <- Cache.prepare past_kv use_cache MAX_POSITIONS
  read_kv <- Cache.read past_kv work_kv
  x, work_kv <- for@transformer.h i <- [0..NUM_LAYERS) carry (x, work_kv) do
    attention_type <- List.index ATTENTION_LAYERS i
    mask <- attention_type == "local" ? local_mask : global_mask
    past_i <- Cache.index read_kv i
    x, new_i <- gpt_neo_block x mask past_i
    work_kv <- Cache.append work_kv new_i
    yield x, work_kv
  x <- NN.layernorm@transformer.ln_f x eps=EPS
  new_kv <- Cache.finish work_kv key_len
  new_kv <- use_cache ? new_kv : null
  logits <- NN.linear@transformer.wte x dim=VOCAB_SIZE bias=false
  return logits, new_kv
