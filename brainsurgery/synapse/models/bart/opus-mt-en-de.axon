{-# CHECKPOINTS "Helsinki-NLP/opus-mt-en-de" #-}
{-# TASK "seq2seq_lm" #-}
{-# TOKENIZER "Helsinki-NLP/opus-mt-en-de" #-}

import Activations
import Activations (silu)
import Attention
import Attention (attention, merge_heads, reshape_heads)
import Masking
import Masking (bidirectional_mask, causal_mask)
import Positions
import Positions (position_ids)
import NN

marian_encoder_layer :: Tensor[B,S,D] -> ?Tensor[B,S] -> Tensor[B,S,D]
marian_encoder_layer x attention_mask = do
  a <- scope@self_attn do
    q <- NN.linear@q_proj x dim=512 bias=true |> reshape_heads heads=8
    k <- NN.linear@k_proj x dim=512 bias=true |> reshape_heads heads=8
    v <- NN.linear@v_proj x dim=512 bias=true |> reshape_heads heads=8
    keep <- bidirectional_mask q k padding_mask=attention_mask
    return attention q k v keep |> merge_heads |> NN.linear@out_proj dim=512 bias=true
  x <- x + a
  x <- NN.layernorm@self_attn_layer_norm x eps=1e-05
  h <- NN.linear@fc1 x dim=2048 bias=true |> silu
  m <- NN.linear@fc2 h dim=512 bias=true
  x <- x + m
  x <- NN.layernorm@final_layer_norm x eps=1e-05
  return x

marian_decoder_layer :: Tensor[B,SDEC,D] -> Tensor[B,SENC,D] -> ?Tensor[B,SENC] -> ?Tensor[B,SDEC] -> Tensor[B,SDEC,D]
marian_decoder_layer x enc_hidden encoder_attention_mask decoder_attention_mask = do
  a <- scope@self_attn do
    q <- NN.linear@q_proj x dim=512 bias=true |> reshape_heads heads=8
    k <- NN.linear@k_proj x dim=512 bias=true |> reshape_heads heads=8
    v <- NN.linear@v_proj x dim=512 bias=true |> reshape_heads heads=8
    mask <- causal_mask q k window=1048576 padding_mask=decoder_attention_mask
    return attention q k v mask |> merge_heads |> NN.linear@out_proj dim=512 bias=true
  x <- x + a
  x <- NN.layernorm@self_attn_layer_norm x eps=1e-05
  a <- scope@encoder_attn do
    q <- NN.linear@q_proj x dim=512 bias=true |> reshape_heads heads=8
    k <- NN.linear@k_proj enc_hidden dim=512 bias=true |> reshape_heads heads=8
    v <- NN.linear@v_proj enc_hidden dim=512 bias=true |> reshape_heads heads=8
    keep <- bidirectional_mask q k padding_mask=encoder_attention_mask
    return attention q k v keep |> merge_heads |> NN.linear@out_proj dim=512 bias=true
  x <- x + a
  x <- NN.layernorm@encoder_attn_layer_norm x eps=1e-05
  h <- NN.linear@fc1 x dim=2048 bias=true |> silu
  m <- NN.linear@fc2 h dim=512 bias=true
  x <- x + m
  x <- NN.layernorm@final_layer_norm x eps=1e-05
  return x

marian :: TokenIds[B,SENC] -> ?Tensor[B,SENC] -> TokenIds[B,SDEC] -> ?Tensor[B,SDEC] -> Tensor[B,SDEC,V]
marian input_ids attention_mask decoder_input_ids decoder_attention_mask = do
  enc_pos_ids <- position_ids input_ids
  enc_tok <- NN.embedding@model.shared input_ids dim=512 scale=22.627416997969522
  enc_pos <- NN.embedding@model.encoder.embed_positions enc_pos_ids dim=512
  enc_hidden <- enc_tok + enc_pos
  for@model.encoder.layers i <- [0..6) do
    enc_hidden <- marian_encoder_layer enc_hidden attention_mask
    yield enc_hidden
  dec_pos_ids <- position_ids decoder_input_ids
  dec_tok <- NN.embedding@model.shared decoder_input_ids dim=512 scale=22.627416997969522
  dec_pos <- NN.embedding@model.decoder.embed_positions dec_pos_ids dim=512
  dec_hidden <- dec_tok + dec_pos
  for@model.decoder.layers i <- [0..6) do
    dec_hidden <- marian_decoder_layer dec_hidden enc_hidden attention_mask decoder_attention_mask
    yield dec_hidden
  logits <- NN.linear@model.shared dec_hidden dim=58101 bias=true bias_path=@@final_logits_bias_flat
  return logits
