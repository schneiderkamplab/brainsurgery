{-# CHECKPOINTS "Helsinki-NLP/opus-mt-en-de" #-}
{-# TASK "seq2seq_lm" #-}
{-# TOKENIZER "Helsinki-NLP/opus-mt-en-de" #-}

import Activations
import Activations (silu)

D = 512
V = 58101
L_ENC = 6
L_DEC = 6
H_ENC = 8
H_DEC = 8
FFN_ENC = 2048
FFN_DEC = 2048
EPS = 1e-05
EMB_SCALE = 22.627416997969522

marian_encoder_layer :: Tensor[B,S,D] -> ?Tensor[B,S] -> Tensor[B,S,D]
marian_encoder_layer x attention_mask = do
  a <- scope@self_attn do
    q <- linear@q_proj x dim=D bias=true |> reshape_heads heads=H_ENC
    k <- linear@k_proj x dim=D bias=true |> reshape_heads heads=H_ENC
    v <- linear@v_proj x dim=D bias=true |> reshape_heads heads=H_ENC
    return attention q k v mask=attention_mask padding_mask=true causal=false |> merge_heads |> linear@out_proj dim=D bias=true
  x <- x + a
  x <- layernorm@self_attn_layer_norm x eps=EPS
  h <- linear@fc1 x dim=FFN_ENC bias=true |> silu
  m <- linear@fc2 h dim=D bias=true
  x <- x + m
  x <- layernorm@final_layer_norm x eps=EPS
  return x

marian_decoder_layer :: Tensor[B,SDEC,D] -> Tensor[B,SENC,D] -> ?Tensor[B,SENC] -> ?Tensor[B,SDEC] -> Tensor[B,SDEC,D]
marian_decoder_layer x enc_hidden encoder_attention_mask decoder_attention_mask = do
  a <- scope@self_attn do
    q <- linear@q_proj x dim=D bias=true |> reshape_heads heads=H_DEC
    k <- linear@k_proj x dim=D bias=true |> reshape_heads heads=H_DEC
    v <- linear@v_proj x dim=D bias=true |> reshape_heads heads=H_DEC
    mask <- causal_mask q k window=1048576 padding_mask=decoder_attention_mask
    return attention q k v mask=mask causal=false |> merge_heads |> linear@out_proj dim=D bias=true
  x <- x + a
  x <- layernorm@self_attn_layer_norm x eps=EPS
  a <- scope@encoder_attn do
    q <- linear@q_proj x dim=D bias=true |> reshape_heads heads=H_DEC
    k <- linear@k_proj enc_hidden dim=D bias=true |> reshape_heads heads=H_DEC
    v <- linear@v_proj enc_hidden dim=D bias=true |> reshape_heads heads=H_DEC
    return attention q k v mask=encoder_attention_mask padding_mask=true causal=false |> merge_heads |> linear@out_proj dim=D bias=true
  x <- x + a
  x <- layernorm@encoder_attn_layer_norm x eps=EPS
  h <- linear@fc1 x dim=FFN_DEC bias=true |> silu
  m <- linear@fc2 h dim=D bias=true
  x <- x + m
  x <- layernorm@final_layer_norm x eps=EPS
  return x

marian :: TokenIds[B,SENC] -> ?Tensor[B,SENC] -> TokenIds[B,SDEC] -> ?Tensor[B,SDEC] -> Tensor[B,SDEC,V]
marian input_ids attention_mask decoder_input_ids decoder_attention_mask = do
  enc_pos_ids <- position_ids input_ids null
  enc_tok <- embedding@model.shared input_ids dim=D scale=EMB_SCALE
  enc_pos <- embedding@model.encoder.embed_positions enc_pos_ids dim=D
  enc_hidden <- enc_tok + enc_pos
  for@model.encoder.layers i <- [0..L_ENC) do
    enc_hidden <- marian_encoder_layer enc_hidden attention_mask
  dec_pos_ids <- position_ids decoder_input_ids null
  dec_tok <- embedding@model.shared decoder_input_ids dim=D scale=EMB_SCALE
  dec_pos <- embedding@model.decoder.embed_positions dec_pos_ids dim=D
  dec_hidden <- dec_tok + dec_pos
  for@model.decoder.layers i <- [0..L_DEC) do
    dec_hidden <- marian_decoder_layer dec_hidden enc_hidden attention_mask decoder_attention_mask
  logits <- linear@model.shared dec_hidden dim=V bias=true bias_path="final_logits_bias_flat"
  return logits
