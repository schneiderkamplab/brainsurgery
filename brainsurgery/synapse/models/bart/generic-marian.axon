{-# CHECKPOINTS ["Helsinki-NLP/opus-mt-en-de"] #-}
{-# TASK "seq2seq_lm" #-}
{-# TOKENIZER "Helsinki-NLP/opus-mt-en-de" #-}

import Activations (silu)
import Attention (attention, merge_heads, reshape_heads)
import Masking (bidirectional_mask_for_input, causal_mask_for_input)
import Math (sqrt)
import Config
import NN
import Tensor



MODEL_DIM <- Config.int@d_model default=512
VOCAB_SIZE <- Config.int@vocab_size default=58101
L_ENC <- Config.int@encoder_layers default=6
L_DEC <- Config.int@decoder_layers default=6
H_ENC <- Config.int@encoder_attention_heads default=8
H_DEC <- Config.int@decoder_attention_heads default=8
FFN_ENC <- Config.int@encoder_ffn_dim default=2048
FFN_DEC <- Config.int@decoder_ffn_dim default=2048
EPS <- Config.float@layernorm_embedding_eps default=1e-05
EMB_SCALE = sqrt MODEL_DIM

marian_encoder_layer :: Tensor[B,S,D] -> Tensor[B,1,S,S] -> Tensor[B,S,D]
marian_encoder_layer x keep = do
  a <- scope@self_attn do
    q <- NN.linear@q_proj x dim=MODEL_DIM bias=true |> reshape_heads heads=H_ENC
    k <- NN.linear@k_proj x dim=MODEL_DIM bias=true |> reshape_heads heads=H_ENC
    v <- NN.linear@v_proj x dim=MODEL_DIM bias=true |> reshape_heads heads=H_ENC
    return attention q k v keep |> merge_heads |> NN.linear@out_proj dim=MODEL_DIM bias=true
  x <- x + a
  x <- NN.layernorm@self_attn_layer_norm x eps=EPS
  h <- NN.linear@fc1 x dim=FFN_ENC bias=true |> silu
  m <- NN.linear@fc2 h dim=MODEL_DIM bias=true
  x <- x + m
  x <- NN.layernorm@final_layer_norm x eps=EPS
  return x

marian_decoder_layer :: Tensor[B,SDEC,D] -> Tensor[B,SENC,D] -> Tensor[B,1,SDEC,SDEC] -> Tensor[B,1,SDEC,SENC] -> Tensor[B,SDEC,D]
marian_decoder_layer x enc_hidden decoder_keep cross_keep = do
  a <- scope@self_attn do
    q <- NN.linear@q_proj x dim=MODEL_DIM bias=true |> reshape_heads heads=H_DEC
    k <- NN.linear@k_proj x dim=MODEL_DIM bias=true |> reshape_heads heads=H_DEC
    v <- NN.linear@v_proj x dim=MODEL_DIM bias=true |> reshape_heads heads=H_DEC
    return attention q k v decoder_keep |> merge_heads |> NN.linear@out_proj dim=MODEL_DIM bias=true
  x <- x + a
  x <- NN.layernorm@self_attn_layer_norm x eps=EPS

  a <- scope@encoder_attn do
    q <- NN.linear@q_proj x dim=MODEL_DIM bias=true |> reshape_heads heads=H_DEC
    k <- NN.linear@k_proj enc_hidden dim=MODEL_DIM bias=true |> reshape_heads heads=H_DEC
    v <- NN.linear@v_proj enc_hidden dim=MODEL_DIM bias=true |> reshape_heads heads=H_DEC
    return attention q k v cross_keep |> merge_heads |> NN.linear@out_proj dim=MODEL_DIM bias=true
  x <- x + a
  x <- NN.layernorm@encoder_attn_layer_norm x eps=EPS

  h <- NN.linear@fc1 x dim=FFN_DEC bias=true |> silu
  m <- NN.linear@fc2 h dim=MODEL_DIM bias=true
  x <- x + m
  x <- NN.layernorm@final_layer_norm x eps=EPS
  return x

marian :: TokenIds[B,SENC] -> ?Tensor[B,SENC] -> TokenIds[B,SDEC] -> ?Tensor[B,SDEC] -> Tensor[B,SDEC,V]
marian input_ids attention_mask decoder_input_ids decoder_attention_mask = do
  encoder_keep <- bidirectional_mask_for_input input_ids SENC padding_mask=attention_mask
  decoder_keep <- causal_mask_for_input decoder_input_ids SDEC padding_mask=decoder_attention_mask window=1048576
  cross_keep <- bidirectional_mask_for_input decoder_input_ids SENC padding_mask=attention_mask
  enc_pos_ids <- Tensor.arange input_ids start=0 end=SENC |> Tensor.reshape shape=[1, SENC] |> Tensor.expand shape=[B, SENC]
  enc_tok <- NN.embedding@model.shared input_ids dim=MODEL_DIM scale=EMB_SCALE
  enc_pos <- NN.embedding@model.encoder.embed_positions enc_pos_ids dim=MODEL_DIM
  enc_hidden <- enc_tok + enc_pos
  enc_hidden <- for@model.encoder.layers i <- [0..L_ENC) carry (enc_hidden) do
    enc_hidden <- marian_encoder_layer enc_hidden encoder_keep

    yield enc_hidden
  dec_pos_ids <- Tensor.arange decoder_input_ids start=0 end=SDEC |> Tensor.reshape shape=[1, SDEC] |> Tensor.expand shape=[B, SDEC]
  dec_tok <- NN.embedding@model.shared decoder_input_ids dim=MODEL_DIM scale=EMB_SCALE
  dec_pos <- NN.embedding@model.decoder.embed_positions dec_pos_ids dim=MODEL_DIM
  dec_hidden <- dec_tok + dec_pos
  dec_hidden <- for@model.decoder.layers i <- [0..L_DEC) carry (dec_hidden) do
    dec_hidden <- marian_decoder_layer dec_hidden enc_hidden decoder_keep cross_keep

    yield dec_hidden
  logits <- NN.linear@model.shared dec_hidden dim=VOCAB_SIZE bias=true bias_path=@@final_logits_bias_flat
  return logits
