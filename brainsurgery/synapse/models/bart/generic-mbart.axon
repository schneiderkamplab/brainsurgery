{-# CHECKPOINTS ["facebook/mbart-large-50-many-to-many-mmt"] #-}
{-# TASK "seq2seq_lm" #-}

import Config
import Activations (relu)
import Attention (reshape_heads, merge_heads)
import Compat (attention)
import Masking (causal_mask)
import Positions (position_ids)
import Math (sqrt)

D = Config.int "d_model" default=1024
V = Config.int "vocab_size" default=250054
L_ENC = Config.int "encoder_layers" default=12
L_DEC = Config.int "decoder_layers" default=12
H_ENC = Config.int "encoder_attention_heads" default=16
H_DEC = Config.int "decoder_attention_heads" default=16
FFN_ENC = Config.int "encoder_ffn_dim" default=4096
FFN_DEC = Config.int "decoder_ffn_dim" default=4096
EPS = Config.float "layernorm_embedding_eps" default=1e-05
POS_OFFSET = Config.int "learned_pos_offset" default=2
EMB_SCALE_DERIVED = sqrt D
EMB_SCALE = Config.float "embed_scale" default=EMB_SCALE_DERIVED

mbart_encoder_layer :: Tensor[B,S,D] -> ?Tensor[B,S] -> Tensor[B,S,D]
mbart_encoder_layer x attention_mask = do
  x_norm <- NN.layernorm@self_attn_layer_norm x eps=EPS
  a <- scope@self_attn do
    q <- NN.linear@q_proj x_norm dim=D bias=true |> reshape_heads heads=H_ENC
    k <- NN.linear@k_proj x_norm dim=D bias=true |> reshape_heads heads=H_ENC
    v <- NN.linear@v_proj x_norm dim=D bias=true |> reshape_heads heads=H_ENC
    return attention q k v mask=attention_mask padding_mask=true causal=false |> merge_heads |> NN.linear@out_proj dim=D bias=true
  x <- x + a
  x_norm <- NN.layernorm@final_layer_norm x eps=EPS
  h <- NN.linear@fc1 x_norm dim=FFN_ENC bias=true |> relu
  m <- NN.linear@fc2 h dim=D bias=true
  x <- x + m
  return x

mbart_decoder_layer :: Tensor[B,SDEC,D] -> Tensor[B,SENC,D] -> ?Tensor[B,SENC] -> ?Tensor[B,SDEC] -> Tensor[B,SDEC,D]
mbart_decoder_layer x enc_hidden encoder_attention_mask decoder_attention_mask = do
  x_norm <- NN.layernorm@self_attn_layer_norm x eps=EPS
  a <- scope@self_attn do
    q <- NN.linear@q_proj x_norm dim=D bias=true |> reshape_heads heads=H_DEC
    k <- NN.linear@k_proj x_norm dim=D bias=true |> reshape_heads heads=H_DEC
    v <- NN.linear@v_proj x_norm dim=D bias=true |> reshape_heads heads=H_DEC
    mask <- causal_mask q k window=1048576 padding_mask=decoder_attention_mask
    return attention q k v mask=mask causal=false |> merge_heads |> NN.linear@out_proj dim=D bias=true
  x <- x + a

  x_norm <- NN.layernorm@encoder_attn_layer_norm x eps=EPS
  a <- scope@encoder_attn do
    q <- NN.linear@q_proj x_norm dim=D bias=true |> reshape_heads heads=H_DEC
    k <- NN.linear@k_proj enc_hidden dim=D bias=true |> reshape_heads heads=H_DEC
    v <- NN.linear@v_proj enc_hidden dim=D bias=true |> reshape_heads heads=H_DEC
    return attention q k v mask=encoder_attention_mask padding_mask=true causal=false |> merge_heads |> NN.linear@out_proj dim=D bias=true
  x <- x + a

  x_norm <- NN.layernorm@final_layer_norm x eps=EPS
  h <- NN.linear@fc1 x_norm dim=FFN_DEC bias=true |> relu
  m <- NN.linear@fc2 h dim=D bias=true
  x <- x + m
  return x

mbart :: TokenIds[B,SENC] -> ?Tensor[B,SENC] -> TokenIds[B,SDEC] -> ?Tensor[B,SDEC] -> Tensor[B,SDEC,V]
mbart input_ids attention_mask decoder_input_ids decoder_attention_mask = do
  enc_pos_ids <- position_ids input_ids
  enc_pos_ids <- enc_pos_ids + POS_OFFSET
  enc_tok <- NN.embedding@model.shared input_ids dim=D scale=EMB_SCALE
  enc_pos <- NN.embedding@model.encoder.embed_positions enc_pos_ids dim=D
  enc_hidden <- enc_tok + enc_pos
  enc_hidden <- NN.layernorm@model.encoder.layernorm_embedding enc_hidden eps=EPS
  for@model.encoder.layers i <- [0..L_ENC) do
    enc_hidden <- mbart_encoder_layer enc_hidden attention_mask
  enc_hidden <- NN.layernorm@model.encoder.layer_norm enc_hidden eps=EPS

  dec_pos_ids <- position_ids decoder_input_ids
  dec_pos_ids <- dec_pos_ids + POS_OFFSET
  dec_tok <- NN.embedding@model.shared decoder_input_ids dim=D scale=EMB_SCALE
  dec_pos <- NN.embedding@model.decoder.embed_positions dec_pos_ids dim=D
  dec_hidden <- dec_tok + dec_pos
  dec_hidden <- NN.layernorm@model.decoder.layernorm_embedding dec_hidden eps=EPS
  for@model.decoder.layers i <- [0..L_DEC) do
    dec_hidden <- mbart_decoder_layer dec_hidden enc_hidden attention_mask decoder_attention_mask
  dec_hidden <- NN.layernorm@model.decoder.layer_norm dec_hidden eps=EPS

  logits <- NN.linear@model.shared dec_hidden dim=V bias=false
  return logits
