{-# CHECKPOINTS "facebook/bart-base" #-}

{-# TASK "seq2seq_lm" #-}

{-# MAIN "bart" #-}

import Activations (gelu)

import Attention (attention, merge_heads, reshape_heads)

import Masking (bidirectional_mask, causal_mask)

import Positions (position_ids)

import Config

import NN

MODEL_DIM = 768

VOCAB_SIZE = 50265

L_ENC = 6

L_DEC = 6

H_ENC = 12

H_DEC = 12

FFN_ENC = 3072

FFN_DEC = 3072

EPS = 1e-05

POS_OFFSET = 2

EMB_SCALE = 1.0

bart_encoder_layer :: Tensor[B,S,D] -> ?Tensor[B,S] -> Tensor[B,S,D]
bart_encoder_layer x attention_mask = do
  a <- scope@self_attn do
    q <- NN.linear@q_proj x dim=MODEL_DIM bias=true |> reshape_heads heads=H_ENC
    k <- NN.linear@k_proj x dim=MODEL_DIM bias=true |> reshape_heads heads=H_ENC
    v <- NN.linear@v_proj x dim=MODEL_DIM bias=true |> reshape_heads heads=H_ENC
    keep <- bidirectional_mask q k padding_mask=attention_mask
    return attention q k v keep |> merge_heads |> NN.linear@out_proj dim=MODEL_DIM bias=true
  x <- x + a
  x <- NN.layernorm@self_attn_layer_norm x eps=EPS
  h <- NN.linear@fc1 x dim=FFN_ENC bias=true |> gelu
  m <- NN.linear@fc2 h dim=MODEL_DIM bias=true
  x <- x + m
  x <- NN.layernorm@final_layer_norm x eps=EPS
  return x

bart_decoder_layer :: Tensor[B,SDEC,D] -> Tensor[B,SENC,D] -> ?Tensor[B,SENC] -> ?Tensor[B,SDEC] -> Tensor[B,SDEC,D]
bart_decoder_layer x enc_hidden encoder_attention_mask decoder_attention_mask = do
  a <- scope@self_attn do
    q <- NN.linear@q_proj x dim=MODEL_DIM bias=true |> reshape_heads heads=H_DEC
    k <- NN.linear@k_proj x dim=MODEL_DIM bias=true |> reshape_heads heads=H_DEC
    v <- NN.linear@v_proj x dim=MODEL_DIM bias=true |> reshape_heads heads=H_DEC
    mask <- causal_mask q k window=1048576 padding_mask=decoder_attention_mask
    return attention q k v mask |> merge_heads |> NN.linear@out_proj dim=MODEL_DIM bias=true
  x <- x + a
  x <- NN.layernorm@self_attn_layer_norm x eps=EPS
  a <- scope@encoder_attn do
    q <- NN.linear@q_proj x dim=MODEL_DIM bias=true |> reshape_heads heads=H_DEC
    k <- NN.linear@k_proj enc_hidden dim=MODEL_DIM bias=true |> reshape_heads heads=H_DEC
    v <- NN.linear@v_proj enc_hidden dim=MODEL_DIM bias=true |> reshape_heads heads=H_DEC
    keep <- bidirectional_mask q k padding_mask=encoder_attention_mask
    return attention q k v keep |> merge_heads |> NN.linear@out_proj dim=MODEL_DIM bias=true
  x <- x + a
  x <- NN.layernorm@encoder_attn_layer_norm x eps=EPS
  h <- NN.linear@fc1 x dim=FFN_DEC bias=true |> gelu
  m <- NN.linear@fc2 h dim=MODEL_DIM bias=true
  x <- x + m
  x <- NN.layernorm@final_layer_norm x eps=EPS
  return x

bart :: TokenIds[B,SENC] -> ?Tensor[B,SENC] -> TokenIds[B,SDEC] -> ?Tensor[B,SDEC] -> Tensor[B,SDEC,V]
bart input_ids attention_mask decoder_input_ids decoder_attention_mask = do
  enc_pos_ids <- position_ids input_ids
  enc_pos_ids <- enc_pos_ids + POS_OFFSET
  enc_tok <- NN.embedding@shared input_ids dim=MODEL_DIM scale=EMB_SCALE
  enc_pos <- NN.embedding@encoder.embed_positions enc_pos_ids dim=MODEL_DIM
  enc_hidden <- enc_tok + enc_pos
  enc_hidden <- NN.layernorm@encoder.layernorm_embedding enc_hidden eps=EPS
  enc_hidden <- for@encoder.layers i <- [0..L_ENC) carry (enc_hidden) do
    enc_hidden <- bart_encoder_layer enc_hidden attention_mask
    yield enc_hidden
  dec_pos_ids <- position_ids decoder_input_ids
  dec_pos_ids <- dec_pos_ids + POS_OFFSET
  dec_tok <- NN.embedding@shared decoder_input_ids dim=MODEL_DIM scale=EMB_SCALE
  dec_pos <- NN.embedding@decoder.embed_positions dec_pos_ids dim=MODEL_DIM
  dec_hidden <- dec_tok + dec_pos
  dec_hidden <- NN.layernorm@decoder.layernorm_embedding dec_hidden eps=EPS
  dec_hidden <- for@decoder.layers i <- [0..L_DEC) carry (dec_hidden) do
    dec_hidden <- bart_decoder_layer dec_hidden enc_hidden attention_mask decoder_attention_mask
    yield dec_hidden
  logits <- NN.linear@shared dec_hidden dim=VOCAB_SIZE bias=false
  return logits
