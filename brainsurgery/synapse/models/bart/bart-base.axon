{-# CHECKPOINTS "facebook/bart-base" #-}
{-# TASK "seq2seq_lm" #-}

import Activations
import Activations (gelu)
import Attention
import Attention (attention, merge_heads, reshape_heads)
import Masking
import Masking (bidirectional_mask, causal_mask)
import Positions
import Positions (position_ids)
import NN

bart_encoder_layer :: Tensor[B,S,D] -> ?Tensor[B,S] -> Tensor[B,S,D]
bart_encoder_layer x attention_mask = do
  a <- scope@self_attn do
    q <- NN.linear@q_proj x dim=768 bias=true |> reshape_heads heads=12
    k <- NN.linear@k_proj x dim=768 bias=true |> reshape_heads heads=12
    v <- NN.linear@v_proj x dim=768 bias=true |> reshape_heads heads=12
    keep <- bidirectional_mask q k padding_mask=attention_mask
    return attention q k v keep |> merge_heads |> NN.linear@out_proj dim=768 bias=true
  x <- x + a
  x <- NN.layernorm@self_attn_layer_norm x eps=1e-05
  h <- NN.linear@fc1 x dim=3072 bias=true |> gelu
  m <- NN.linear@fc2 h dim=768 bias=true
  x <- x + m
  x <- NN.layernorm@final_layer_norm x eps=1e-05
  return x

bart_decoder_layer :: Tensor[B,SDEC,D] -> Tensor[B,SENC,D] -> ?Tensor[B,SENC] -> ?Tensor[B,SDEC] -> Tensor[B,SDEC,D]
bart_decoder_layer x enc_hidden encoder_attention_mask decoder_attention_mask = do
  a <- scope@self_attn do
    q <- NN.linear@q_proj x dim=768 bias=true |> reshape_heads heads=12
    k <- NN.linear@k_proj x dim=768 bias=true |> reshape_heads heads=12
    v <- NN.linear@v_proj x dim=768 bias=true |> reshape_heads heads=12
    mask <- causal_mask q k window=1048576 padding_mask=decoder_attention_mask
    return attention q k v mask |> merge_heads |> NN.linear@out_proj dim=768 bias=true
  x <- x + a
  x <- NN.layernorm@self_attn_layer_norm x eps=1e-05
  a <- scope@encoder_attn do
    q <- NN.linear@q_proj x dim=768 bias=true |> reshape_heads heads=12
    k <- NN.linear@k_proj enc_hidden dim=768 bias=true |> reshape_heads heads=12
    v <- NN.linear@v_proj enc_hidden dim=768 bias=true |> reshape_heads heads=12
    keep <- bidirectional_mask q k padding_mask=encoder_attention_mask
    return attention q k v keep |> merge_heads |> NN.linear@out_proj dim=768 bias=true
  x <- x + a
  x <- NN.layernorm@encoder_attn_layer_norm x eps=1e-05
  h <- NN.linear@fc1 x dim=3072 bias=true |> gelu
  m <- NN.linear@fc2 h dim=768 bias=true
  x <- x + m
  x <- NN.layernorm@final_layer_norm x eps=1e-05
  return x

bart :: TokenIds[B,SENC] -> ?Tensor[B,SENC] -> TokenIds[B,SDEC] -> ?Tensor[B,SDEC] -> Tensor[B,SDEC,V]
bart input_ids attention_mask decoder_input_ids decoder_attention_mask = do
  enc_pos_ids <- position_ids input_ids
  enc_pos_ids <- enc_pos_ids + 2
  enc_tok <- NN.embedding@shared input_ids dim=768 scale=1.0
  enc_pos <- NN.embedding@encoder.embed_positions enc_pos_ids dim=768
  enc_hidden <- enc_tok + enc_pos
  enc_hidden <- NN.layernorm@encoder.layernorm_embedding enc_hidden eps=1e-05
  for@encoder.layers i <- [0..6) do
    enc_hidden <- bart_encoder_layer enc_hidden attention_mask
    yield enc_hidden
  dec_pos_ids <- position_ids decoder_input_ids
  dec_pos_ids <- dec_pos_ids + 2
  dec_tok <- NN.embedding@shared decoder_input_ids dim=768 scale=1.0
  dec_pos <- NN.embedding@decoder.embed_positions dec_pos_ids dim=768
  dec_hidden <- dec_tok + dec_pos
  dec_hidden <- NN.layernorm@decoder.layernorm_embedding dec_hidden eps=1e-05
  for@decoder.layers i <- [0..6) do
    dec_hidden <- bart_decoder_layer dec_hidden enc_hidden attention_mask decoder_attention_mask
    yield dec_hidden
  logits <- NN.linear@shared dec_hidden dim=50265 bias=false
  return logits
