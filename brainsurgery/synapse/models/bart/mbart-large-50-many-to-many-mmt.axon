{-# CHECKPOINTS "facebook/mbart-large-50-many-to-many-mmt" #-}
{-# TASK "seq2seq_lm" #-}

import Activations
import Activations (relu)
import Attention
import Attention (attention, merge_heads, reshape_heads)
import Masking
import Masking (bidirectional_mask, causal_mask)
import Positions
import Positions (position_ids)
import NN

mbart_encoder_layer :: Tensor[B,S,D] -> ?Tensor[B,S] -> Tensor[B,S,D]
mbart_encoder_layer x attention_mask = do
  x_norm <- NN.layernorm@self_attn_layer_norm x eps=1e-05
  a <- scope@self_attn do
    q <- NN.linear@q_proj x_norm dim=1024 bias=true |> reshape_heads heads=16
    k <- NN.linear@k_proj x_norm dim=1024 bias=true |> reshape_heads heads=16
    v <- NN.linear@v_proj x_norm dim=1024 bias=true |> reshape_heads heads=16
    keep <- bidirectional_mask q k padding_mask=attention_mask
    return attention q k v keep |> merge_heads |> NN.linear@out_proj dim=1024 bias=true
  x <- x + a
  x_norm <- NN.layernorm@final_layer_norm x eps=1e-05
  h <- NN.linear@fc1 x_norm dim=4096 bias=true |> relu
  m <- NN.linear@fc2 h dim=1024 bias=true
  x <- x + m
  return x

mbart_decoder_layer :: Tensor[B,SDEC,D] -> Tensor[B,SENC,D] -> ?Tensor[B,SENC] -> ?Tensor[B,SDEC] -> Tensor[B,SDEC,D]
mbart_decoder_layer x enc_hidden encoder_attention_mask decoder_attention_mask = do
  x_norm <- NN.layernorm@self_attn_layer_norm x eps=1e-05
  a <- scope@self_attn do
    q <- NN.linear@q_proj x_norm dim=1024 bias=true |> reshape_heads heads=16
    k <- NN.linear@k_proj x_norm dim=1024 bias=true |> reshape_heads heads=16
    v <- NN.linear@v_proj x_norm dim=1024 bias=true |> reshape_heads heads=16
    mask <- causal_mask q k window=1048576 padding_mask=decoder_attention_mask
    return attention q k v mask |> merge_heads |> NN.linear@out_proj dim=1024 bias=true
  x <- x + a
  x_norm <- NN.layernorm@encoder_attn_layer_norm x eps=1e-05
  a <- scope@encoder_attn do
    q <- NN.linear@q_proj x_norm dim=1024 bias=true |> reshape_heads heads=16
    k <- NN.linear@k_proj enc_hidden dim=1024 bias=true |> reshape_heads heads=16
    v <- NN.linear@v_proj enc_hidden dim=1024 bias=true |> reshape_heads heads=16
    keep <- bidirectional_mask q k padding_mask=encoder_attention_mask
    return attention q k v keep |> merge_heads |> NN.linear@out_proj dim=1024 bias=true
  x <- x + a
  x_norm <- NN.layernorm@final_layer_norm x eps=1e-05
  h <- NN.linear@fc1 x_norm dim=4096 bias=true |> relu
  m <- NN.linear@fc2 h dim=1024 bias=true
  x <- x + m
  return x

mbart :: TokenIds[B,SENC] -> ?Tensor[B,SENC] -> TokenIds[B,SDEC] -> ?Tensor[B,SDEC] -> Tensor[B,SDEC,V]
mbart input_ids attention_mask decoder_input_ids decoder_attention_mask = do
  enc_pos_ids <- position_ids input_ids
  enc_pos_ids <- enc_pos_ids + 2
  enc_tok <- NN.embedding@model.shared input_ids dim=1024 scale=32.0
  enc_pos <- NN.embedding@model.encoder.embed_positions enc_pos_ids dim=1024
  enc_hidden <- enc_tok + enc_pos
  enc_hidden <- NN.layernorm@model.encoder.layernorm_embedding enc_hidden eps=1e-05
  for@model.encoder.layers i <- [0..12) do
    enc_hidden <- mbart_encoder_layer enc_hidden attention_mask
    yield enc_hidden
  enc_hidden <- NN.layernorm@model.encoder.layer_norm enc_hidden eps=1e-05
  dec_pos_ids <- position_ids decoder_input_ids
  dec_pos_ids <- dec_pos_ids + 2
  dec_tok <- NN.embedding@model.shared decoder_input_ids dim=1024 scale=32.0
  dec_pos <- NN.embedding@model.decoder.embed_positions dec_pos_ids dim=1024
  dec_hidden <- dec_tok + dec_pos
  dec_hidden <- NN.layernorm@model.decoder.layernorm_embedding dec_hidden eps=1e-05
  for@model.decoder.layers i <- [0..12) do
    dec_hidden <- mbart_decoder_layer dec_hidden enc_hidden attention_mask decoder_attention_mask
    yield dec_hidden
  dec_hidden <- NN.layernorm@model.decoder.layer_norm dec_hidden eps=1e-05
  logits <- NN.linear@model.shared dec_hidden dim=250054 bias=false
  return logits
