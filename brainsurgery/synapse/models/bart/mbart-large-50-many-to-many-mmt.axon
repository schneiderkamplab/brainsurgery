{-# CHECKPOINTS "facebook/mbart-large-50-many-to-many-mmt" #-}
{-# TASK "seq2seq_lm" #-}

import Activations
import Activations (relu)

D = 1024
V = 250054
L_ENC = 12
L_DEC = 12
H_ENC = 16
H_DEC = 16
FFN_ENC = 4096
FFN_DEC = 4096
EPS = 1e-05
POS_OFFSET = 2
EMB_SCALE = 32.0

mbart_encoder_layer :: Tensor[B,S,D] -> ?Tensor[B,S] -> Tensor[B,S,D]
mbart_encoder_layer x attention_mask = do
  x_norm <- layernorm@self_attn_layer_norm x eps=EPS
  a <- scope@self_attn do
    q <- linear@q_proj x_norm dim=D bias=true |> reshape_heads heads=H_ENC
    k <- linear@k_proj x_norm dim=D bias=true |> reshape_heads heads=H_ENC
    v <- linear@v_proj x_norm dim=D bias=true |> reshape_heads heads=H_ENC
    return attention q k v mask=attention_mask padding_mask=true causal=false |> merge_heads |> linear@out_proj dim=D bias=true
  x <- x + a
  x_norm <- layernorm@final_layer_norm x eps=EPS
  h <- linear@fc1 x_norm dim=FFN_ENC bias=true |> relu
  m <- linear@fc2 h dim=D bias=true
  x <- x + m
  return x

mbart_decoder_layer :: Tensor[B,SDEC,D] -> Tensor[B,SENC,D] -> ?Tensor[B,SENC] -> ?Tensor[B,SDEC] -> Tensor[B,SDEC,D]
mbart_decoder_layer x enc_hidden encoder_attention_mask decoder_attention_mask = do
  x_norm <- layernorm@self_attn_layer_norm x eps=EPS
  a <- scope@self_attn do
    q <- linear@q_proj x_norm dim=D bias=true |> reshape_heads heads=H_DEC
    k <- linear@k_proj x_norm dim=D bias=true |> reshape_heads heads=H_DEC
    v <- linear@v_proj x_norm dim=D bias=true |> reshape_heads heads=H_DEC
    mask <- causal_mask q k window=1048576 padding_mask=decoder_attention_mask
    return attention q k v mask=mask causal=false |> merge_heads |> linear@out_proj dim=D bias=true
  x <- x + a
  x_norm <- layernorm@encoder_attn_layer_norm x eps=EPS
  a <- scope@encoder_attn do
    q <- linear@q_proj x_norm dim=D bias=true |> reshape_heads heads=H_DEC
    k <- linear@k_proj enc_hidden dim=D bias=true |> reshape_heads heads=H_DEC
    v <- linear@v_proj enc_hidden dim=D bias=true |> reshape_heads heads=H_DEC
    return attention q k v mask=encoder_attention_mask padding_mask=true causal=false |> merge_heads |> linear@out_proj dim=D bias=true
  x <- x + a
  x_norm <- layernorm@final_layer_norm x eps=EPS
  h <- linear@fc1 x_norm dim=FFN_DEC bias=true |> relu
  m <- linear@fc2 h dim=D bias=true
  x <- x + m
  return x

mbart :: TokenIds[B,SENC] -> ?Tensor[B,SENC] -> TokenIds[B,SDEC] -> ?Tensor[B,SDEC] -> Tensor[B,SDEC,V]
mbart input_ids attention_mask decoder_input_ids decoder_attention_mask = do
  enc_pos_ids <- position_ids input_ids
  enc_pos_ids <- enc_pos_ids + POS_OFFSET
  enc_tok <- embedding@model.shared input_ids dim=D scale=EMB_SCALE
  enc_pos <- embedding@model.encoder.embed_positions enc_pos_ids dim=D
  enc_hidden <- enc_tok + enc_pos
  enc_hidden <- layernorm@model.encoder.layernorm_embedding enc_hidden eps=EPS
  for@model.encoder.layers i <- [0..L_ENC) do
    enc_hidden <- mbart_encoder_layer enc_hidden attention_mask
  enc_hidden <- layernorm@model.encoder.layer_norm enc_hidden eps=EPS
  dec_pos_ids <- position_ids decoder_input_ids
  dec_pos_ids <- dec_pos_ids + POS_OFFSET
  dec_tok <- embedding@model.shared decoder_input_ids dim=D scale=EMB_SCALE
  dec_pos <- embedding@model.decoder.embed_positions dec_pos_ids dim=D
  dec_hidden <- dec_tok + dec_pos
  dec_hidden <- layernorm@model.decoder.layernorm_embedding dec_hidden eps=EPS
  for@model.decoder.layers i <- [0..L_DEC) do
    dec_hidden <- mbart_decoder_layer dec_hidden enc_hidden attention_mask decoder_attention_mask
  dec_hidden <- layernorm@model.decoder.layer_norm dec_hidden eps=EPS
  logits <- linear@model.shared dec_hidden dim=V bias=false
  return logits
