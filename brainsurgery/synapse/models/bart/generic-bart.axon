{-# CHECKPOINTS ["facebook/bart-base"] #-}
{-# TASK "seq2seq_lm" #-}

import Config
import Activations gelu

D = Config.int "d_model" default=768
V = Config.int "vocab_size" default=50265
L_ENC = Config.int "encoder_layers" default=6
L_DEC = Config.int "decoder_layers" default=6
H_ENC = Config.int "encoder_attention_heads" default=12
H_DEC = Config.int "decoder_attention_heads" default=12
FFN_ENC = Config.int "encoder_ffn_dim" default=3072
FFN_DEC = Config.int "decoder_ffn_dim" default=3072
EPS = Config.float "layernorm_embedding_eps" default=1e-05
POS_OFFSET = Config.int "learned_pos_offset" default=2
EMB_SCALE = Config.float "embed_scale" default=1.0

bart_encoder_layer :: Tensor[B,S,D] -> ?Tensor[B,S] -> Tensor[B,S,D]
bart_encoder_layer x attention_mask = do
  a <- scope@self_attn do
    q <- linear@q_proj x dim=D bias=true |> reshape_heads heads=H_ENC
    k <- linear@k_proj x dim=D bias=true |> reshape_heads heads=H_ENC
    v <- linear@v_proj x dim=D bias=true |> reshape_heads heads=H_ENC
    return attention q k v mask=attention_mask padding_mask=true causal=false |> merge_heads |> linear@out_proj dim=D bias=true
  x <- x + a
  x <- layernorm@self_attn_layer_norm x eps=EPS
  h <- linear@fc1 x dim=FFN_ENC bias=true |> gelu
  m <- linear@fc2 h dim=D bias=true
  x <- x + m
  x <- layernorm@final_layer_norm x eps=EPS
  return x

bart_decoder_layer :: Tensor[B,SDEC,D] -> Tensor[B,SENC,D] -> ?Tensor[B,SENC] -> ?Tensor[B,SDEC] -> Tensor[B,SDEC,D]
bart_decoder_layer x enc_hidden encoder_attention_mask decoder_attention_mask = do
  a <- scope@self_attn do
    q <- linear@q_proj x dim=D bias=true |> reshape_heads heads=H_DEC
    k <- linear@k_proj x dim=D bias=true |> reshape_heads heads=H_DEC
    v <- linear@v_proj x dim=D bias=true |> reshape_heads heads=H_DEC
    mask <- causal_mask q k window=1048576 padding_mask=decoder_attention_mask
    return attention q k v mask=mask causal=false |> merge_heads |> linear@out_proj dim=D bias=true
  x <- x + a
  x <- layernorm@self_attn_layer_norm x eps=EPS

  a <- scope@encoder_attn do
    q <- linear@q_proj x dim=D bias=true |> reshape_heads heads=H_DEC
    k <- linear@k_proj enc_hidden dim=D bias=true |> reshape_heads heads=H_DEC
    v <- linear@v_proj enc_hidden dim=D bias=true |> reshape_heads heads=H_DEC
    return attention q k v mask=encoder_attention_mask padding_mask=true causal=false |> merge_heads |> linear@out_proj dim=D bias=true
  x <- x + a
  x <- layernorm@encoder_attn_layer_norm x eps=EPS

  h <- linear@fc1 x dim=FFN_DEC bias=true |> gelu
  m <- linear@fc2 h dim=D bias=true
  x <- x + m
  x <- layernorm@final_layer_norm x eps=EPS
  return x

bart :: TokenIds[B,SENC] -> ?Tensor[B,SENC] -> TokenIds[B,SDEC] -> ?Tensor[B,SDEC] -> Tensor[B,SDEC,V]
bart input_ids attention_mask decoder_input_ids decoder_attention_mask = do
  enc_pos_ids <- position_ids input_ids
  enc_pos_ids <- enc_pos_ids + POS_OFFSET
  enc_tok <- embedding@shared input_ids dim=D scale=EMB_SCALE
  enc_pos <- embedding@encoder.embed_positions enc_pos_ids dim=D
  enc_hidden <- enc_tok + enc_pos
  enc_hidden <- layernorm@encoder.layernorm_embedding enc_hidden eps=EPS
  for@encoder.layers i <- [0..L_ENC) do
    enc_hidden <- bart_encoder_layer enc_hidden attention_mask

  dec_pos_ids <- position_ids decoder_input_ids
  dec_pos_ids <- dec_pos_ids + POS_OFFSET
  dec_tok <- embedding@shared decoder_input_ids dim=D scale=EMB_SCALE
  dec_pos <- embedding@decoder.embed_positions dec_pos_ids dim=D
  dec_hidden <- dec_tok + dec_pos
  dec_hidden <- layernorm@decoder.layernorm_embedding dec_hidden eps=EPS
  for@decoder.layers i <- [0..L_DEC) do
    dec_hidden <- bart_decoder_layer dec_hidden enc_hidden attention_mask decoder_attention_mask

  logits <- linear@shared dec_hidden dim=V bias=false
  return logits
