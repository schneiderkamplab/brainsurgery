{-# CHECKPOINTS "microsoft/Phi-3.5-MoE-instruct" #-}
{-# TASK "causal_lm" #-}

import Activations
import Activations (silu)
import Attention
import Attention (attention, merge_heads, reshape_heads)
import Masking
import Masking (causal_mask)
import Math
import Math (mul)
import MoE
import MoE (scatter_add, select, sparsemixer_router)
import Params
import Params (has_root)
import Positions
import Positions (position_ids, rope_pair_longrope)
import Cache
import NN
import Tensor

HAS_LM_HEAD = has_root "lm_head"
HAS_LM_HEAD_BIAS = has_root "lm_head.bias"

phimoe_block :: Tensor[B,S,D] -> IdxTensor[B,S] -> ?Tensor[B,S] -> ?CacheLayer -> (Tensor[B,S,D], ?CacheLayer)
phimoe_block x pos_ids attn_mask past_kv = do
  xn <- NN.layernorm@input_layernorm x eps=1e-05 bias=true
  a, new_kv <- scope@self_attn do
    q <- NN.linear@q_proj xn dim=4096 bias=true |> reshape_heads heads=32
    k <- NN.linear@k_proj xn dim=1024 bias=true |> reshape_heads heads=8
    v <- NN.linear@v_proj xn dim=1024 bias=true |> reshape_heads heads=8
    q, k <- (rope_pair_longrope q k pos_ids 10000.0 4096 131072 [1.0199999809265137, 1.0299999713897705, 1.0399999618530273, 1.0499999523162842, 1.0499999523162842, 1.0499999523162842, 1.059999942779541, 1.059999942779541, 1.059999942779541, 1.059999942779541, 1.059999942779541, 1.059999942779541, 1.0999999046325684, 1.1799999475479126, 1.1799999475479126, 1.3700000047683716, 1.4899998903274536, 2.109999895095825, 2.8899998664855957, 3.9499998092651367, 4.299999713897705, 6.429999828338623, 8.09000015258789, 10.690000534057617, 12.050000190734863, 18.229999542236328, 18.84000015258789, 19.899999618530273, 21.420000076293945, 26.200000762939453, 34.28000259399414, 34.590003967285156, 38.730003356933594, 40.22000503540039, 42.54000473022461, 44.000003814697266, 47.590003967285156, 54.750003814697266, 56.19000244140625, 57.44000244140625, 57.4900016784668, 61.20000076293945, 61.540000915527344, 61.75, 61.779998779296875, 62.06999969482422, 63.11000061035156, 63.43000030517578, 63.560001373291016, 63.71000289916992, 63.92000198364258, 63.94000244140625, 63.94000244140625, 63.96000289916992, 63.980003356933594, 64.0300064086914, 64.0300064086914, 64.0300064086914, 64.04000854492188, 64.10000610351562, 64.19000244140625, 64.20999908447266, 64.75, 64.95999908447266] [1.0, 1.0399999618530273, 1.0399999618530273, 1.0399999618530273, 1.0499999523162842, 1.0499999523162842, 1.0499999523162842, 1.0499999523162842, 1.0499999523162842, 1.0499999523162842, 1.0499999523162842, 1.0499999523162842, 1.0499999523162842, 1.0499999523162842, 1.059999942779541, 1.059999942779541, 1.0699999332427979, 1.0699999332427979, 1.0699999332427979, 1.0699999332427979, 1.1399999856948853, 1.159999966621399, 1.159999966621399, 1.159999966621399, 1.159999966621399, 1.1799999475479126, 1.1999999284744263, 1.3199999332427979, 1.3399999141693115, 1.3499999046325684, 1.3999998569488525, 1.4799998998641968, 1.4999998807907104, 1.589999794960022, 1.6499998569488525, 1.71999990940094, 1.8999998569488525, 1.9099998474121094, 1.9099998474121094, 1.9899998903274536, 1.9999998807907104, 1.9999998807907104, 2.009999990463257, 2.009999990463257, 2.009999990463257, 2.009999990463257, 2.009999990463257, 2.009999990463257, 2.009999990463257, 2.009999990463257, 2.009999990463257, 2.009999990463257, 2.009999990463257, 2.009999990463257, 2.009999990463257, 2.009999990463257, 2.009999990463257, 2.009999990463257, 2.009999990463257, 2.0999999046325684, 2.319999933242798, 2.419999837875366, 2.5899999141693115, 2.7899999618530273] attention_factor=1.243163121016122)
    k, v, new_kv <- Cache.update past_kv k v
    k <- Tensor.repeat k repeats=4
    v <- Tensor.repeat v repeats=4
    mask <- causal_mask q k window=131072 padding_mask=attn_mask
    a <- attention q k v mask scale=0.08838834764831843 |> merge_heads |> NN.linear@o_proj dim=4096 bias=true
    return a, new_kv
  x <- x + a
  xn <- NN.layernorm@post_attention_layernorm x eps=1e-05 bias=true
  m <- scope@block_sparse_moe do
    topk_scores, topk_indices <- sparsemixer_router xn 16 0.01
    m <- xn * 0.0
    for@experts e <- [0..16) do
      x_sel, token_idx, topk_pos, sel_scores <- select xn topk_scores topk_indices e
      x_upd <- NN.linear@w1 x_sel dim=6400 |> silu |> mul (NN.linear@w3 x_sel dim=6400) |> NN.linear@w2 dim=4096 bias=false
      m <- scatter_add m token_idx x_upd sel_scores
      yield m
    return m
  return x + m, new_kv

phimoe :: TokenIds[B,S] -> ?Tensor[B,S] -> ?Cache -> ?Bool -> (Tensor[B,S,V], ?Cache)
phimoe input_ids attn_mask past_kv use_cache = do
  pos_ids <- position_ids input_ids attn_mask=attn_mask past_length=(Cache.past_length past_kv)
  x, new_kv <- scope@model do
    x <- NN.embedding@embed_tokens input_ids dim=4096
    new_kv <- use_cache ? Cache.init : null
    for@layers i <- [0..32) do
      past_i <- Cache.index past_kv i
      x, new_i <- phimoe_block x pos_ids attn_mask past_i
      new_kv <- Cache.append new_kv new_i
      yield x, new_kv
    x <- NN.layernorm@norm x eps=1e-05 bias=true
    return x, new_kv
  logits <- HAS_LM_HEAD ? (NN.linear@lm_head x dim=32064 bias=HAS_LM_HEAD_BIAS) : (NN.linear@model.embed_tokens x dim=32064 bias=false)
  return logits, new_kv
