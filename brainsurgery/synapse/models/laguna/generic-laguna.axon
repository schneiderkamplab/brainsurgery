{-# CHECKPOINTS ["test/Laguna-Test", "poolside/Laguna-XS.2", "poolside/Laguna-S-2.1"] #-}
{-# TASK "causal_lm" #-}

import Activations (sigmoid, silu, softplus, tanh)
import Attention (attention, merge_heads, reshape_heads)
import Cache
import Config
import List
import Masking (Mask, causal_mask_for_input, mask_for_input, mask_length_for_input)
import Math (mul)
import MoE (grouped_swiglu_ffn_separate)
import NN
import Params (param)
import Positions (position_ids, rope_pair_proportional_factors, rope_proportional_factors)
import Tensor

MODEL_DIM <- Config.dim @@hidden_size default=32
FFN <- Config.dim @@intermediate_size default=64
MOE_FFN <- Config.dim @@moe_intermediate_size default=16
SHARED_FFN <- Config.dim @@shared_expert_intermediate_size default=16
NUM_LAYERS <- Config.dim @@num_hidden_layers default=2
NUM_HEADS <- Config.dim @@num_attention_heads default=4
KV_HEADS <- Config.dim @@num_key_value_heads default=2
HEAD_DIM <- Config.dim @@head_dim default=(MODEL_DIM / NUM_HEADS)
KVD <- KV_HEADS * HEAD_DIM
VOCAB_SIZE <- Config.dim @@vocab_size default=50264
MAX_POSITIONS <- Config.dim @@max_position_embeddings default=128
SLIDING_WINDOW <- Config.dim @@sliding_window default=32
EPS <- Config.float @@rms_norm_eps default=1e-6
ATTENTION_BIAS <- Config.bool @@attention_bias default=false
NUM_EXPERTS <- Config.dim @@num_experts default=4
TOP_K <- Config.dim @@num_experts_per_tok default=2
ROUTED_SCALE <- Config.float @@moe_routed_scaling_factor default=1.0
ROUTER_CAP <- Config.float @@moe_router_logit_softcapping default=0.0
TIE <- Config.bool @@tie_word_embeddings default=false
THETA_FULL <- Config.float @@'rope_parameters.full_attention.rope_theta' default=500000.0
PARTIAL_FULL <- Config.float @@'rope_parameters.full_attention.partial_rotary_factor' default=0.5
THETA_SLIDING <- Config.float @@'rope_parameters.sliding_attention.rope_theta' default=10000.0
PARTIAL_SLIDING <- Config.float @@'rope_parameters.sliding_attention.partial_rotary_factor' default=1.0
LAYER_TYPES <- ((Config.list @@layer_types default=["full_attention", "sliding_attention"]) :: List[String])
MLP_TYPES <- ((Config.list @@mlp_layer_types default=["dense", "sparse"]) :: List[String])
HEADS_PER_LAYER <- ((Config.list @@num_attention_heads_per_layer default=[4, 4]) :: List[Dim])

laguna_dense :: Path -> Tensor[B,S,D] -> Dim -> Tensor[B,S,D]
laguna_dense@path x ffn = do
  gate <- NN.linear@gate_proj x dim=ffn bias=false |> silu
  up <- NN.linear@up_proj x dim=ffn bias=false
  return gate |> mul up |> NN.linear@down_proj dim=MODEL_DIM bias=false

laguna_sparse :: Tensor[B,S,D] -> Tensor[B,S,D]
laguna_sparse x = do
  logits <- NN.linear@gate x dim=NUM_EXPERTS bias=false
  logits <- (ROUTER_CAP > 0.0) ? ((tanh (logits / ROUTER_CAP)) * ROUTER_CAP) : logits
  scores <- logits |> sigmoid
  choice <- scores + (param @experts.e_score_correction_bias)
  _, indices <- Tensor.topk choice k=TOP_K dim=-1 largest=true sorted=true
  scores <- Tensor.gather scores indices dim=-1
  scores <- Tensor.cast_like (scores / (Tensor.sum scores dim=-1 keepdim=true)) x
  routed <- grouped_swiglu_ffn_separate x scores indices NUM_EXPERTS MOE_FFN gate_weight=@experts.gate_proj.weight up_weight=@experts.up_proj.weight out_weight=@experts.down_proj.weight
  routed <- routed * ROUTED_SCALE
  shared <- laguna_dense@shared_expert x ffn=SHARED_FFN
  return routed + shared

laguna_block :: Tensor[B,S,D] -> Int -> Tensor[B,1,S,HEAD_DIM] -> Tensor[B,1,S,HEAD_DIM] -> Tensor[B,1,S,HEAD_DIM] -> Tensor[B,1,S,HEAD_DIM] -> Tensor[B,1,S,K] -> Tensor[B,1,S,K] -> ?CacheLayer[B,KV_HEADS,P,MAX_POSITIONS,HEAD_DIM] -> (Tensor[B,S,D], ?CacheLayer[B,KV_HEADS,K,MAX_POSITIONS,HEAD_DIM])
laguna_block x layer rope_sin_full rope_cos_full rope_sin_sliding rope_cos_sliding sliding_mask full_mask past_kv = do
  layer_type <- List.index LAYER_TYPES layer
  mlp_type <- List.index MLP_TYPES layer
  heads <- List.index HEADS_PER_LAYER layer
  sliding <- layer_type == "sliding_attention"
  sparse <- mlp_type == "sparse"
  mask <- sliding ? sliding_mask : full_mask
  rope_sin <- sliding ? rope_sin_sliding : rope_sin_full
  rope_cos <- sliding ? rope_cos_sliding : rope_cos_full
  xn <- NN.rmsnorm@input_layernorm x eps=EPS cast_float=true
  a, new_kv <- scope@self_attn do
    q <- NN.linear@q_proj xn dim=(heads * HEAD_DIM) bias=ATTENTION_BIAS |> reshape_heads heads=heads
    k <- NN.linear@k_proj xn dim=KVD bias=ATTENTION_BIAS |> reshape_heads heads=KV_HEADS
    v <- NN.linear@v_proj xn dim=KVD bias=ATTENTION_BIAS |> reshape_heads heads=KV_HEADS
    q <- NN.rmsnorm@q_norm q eps=EPS dim=HEAD_DIM cast_float=true
    k <- NN.rmsnorm@k_norm k eps=EPS dim=HEAD_DIM cast_float=true
    q, k <- rope_pair_proportional_factors q k rope_sin rope_cos prefix_only=true
    k, v, new_kv <- Cache.update past_kv k v
    k <- Tensor.repeat k repeats=(heads / KV_HEADS)
    v <- Tensor.repeat v repeats=(heads / KV_HEADS)
    a <- attention q k v mask
    gate <- NN.linear@g_proj xn dim=heads bias=false |> softplus
    gate <- Tensor.reshape gate shape=[B, S, heads, 1]
    gate <- Tensor.permute gate dims=[0, 2, 1, 3]
    a <- a * gate
    a <- merge_heads a |> NN.linear@o_proj dim=MODEL_DIM bias=ATTENTION_BIAS
    return a, new_kv
  x <- x + a
  xn <- NN.rmsnorm@post_attention_layernorm x eps=EPS cast_float=true
  m <- scope@mlp do
    return sparse ? (laguna_sparse xn) : do
      gate <- NN.linear@gate_proj xn dim=FFN bias=false |> silu
      up <- NN.linear@up_proj xn dim=FFN bias=false
      return gate |> mul up |> NN.linear@down_proj dim=MODEL_DIM bias=false
  return x + m, new_kv

laguna :: TokenIds[B,S] -> ?Mask[B,K,MAX_POSITIONS] -> ?Cache[B,KV_HEADS,P,MAX_POSITIONS,HEAD_DIM] -> ?Bool -> (Tensor[B,S,V], ?Cache[B,KV_HEADS,K,MAX_POSITIONS,HEAD_DIM])
laguna input_ids attn_mask past_kv use_cache = do
  past_length <- Cache.past_length past_kv
  attn_mask <- mask_for_input input_ids attn_mask MAX_POSITIONS
  pos_ids <- position_ids input_ids attn_mask=attn_mask past_length=past_length pad_fill=1
  rope_sin_full, rope_cos_full <- rope_proportional_factors pos_ids HEAD_DIM theta=THETA_FULL partial_rotary_factor=PARTIAL_FULL prefix_only=true
  rope_sin_sliding, rope_cos_sliding <- rope_proportional_factors pos_ids HEAD_DIM theta=THETA_SLIDING partial_rotary_factor=PARTIAL_SLIDING prefix_only=true
  key_len <- mask_length_for_input input_ids attn_mask past_length
  sliding_mask <- causal_mask_for_input input_ids key_len padding_mask=attn_mask window=SLIDING_WINDOW
  full_mask <- causal_mask_for_input input_ids key_len padding_mask=attn_mask window=MAX_POSITIONS
  work_kv <- Cache.prepare past_kv use_cache MAX_POSITIONS
  read_kv <- Cache.read past_kv work_kv
  x, work_kv <- scope@model do
    x <- NN.embedding@embed_tokens input_ids dim=MODEL_DIM
    x, work_kv <- for@layers i <- [0..NUM_LAYERS) carry (x, work_kv) do
      past_i <- Cache.index read_kv i
      x, new_i <- laguna_block x i rope_sin_full rope_cos_full rope_sin_sliding rope_cos_sliding sliding_mask full_mask past_i
      work_kv <- Cache.append work_kv new_i
      yield x, work_kv
    x <- NN.rmsnorm@norm x eps=EPS cast_float=true
    return x, work_kv
  new_kv <- Cache.finish work_kv key_len
  new_kv <- use_cache ? new_kv : null
  logits <- TIE
    ? (NN.linear@model.embed_tokens x dim=VOCAB_SIZE bias=false)
    : (NN.linear@@lm_head x dim=VOCAB_SIZE bias=false)
  return logits, new_kv
