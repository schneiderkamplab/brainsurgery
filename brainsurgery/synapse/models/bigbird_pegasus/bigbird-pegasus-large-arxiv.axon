{-# CHECKPOINTS "google/bigbird-pegasus-large-arxiv" #-}

{-# TASK "seq2seq_lm" #-}

{-# MAIN "bigbird_pegasus" #-}

import Activations (gelu_new)

import Attention (attention, merge_heads, reshape_heads)

import Masking (Mask, bidirectional_mask_for_input, causal_mask_for_input, mask_for_input)

import Math (log, sqrt)

import Config

import NN

import Tensor

MODEL_DIM <- 1024

VOCAB_SIZE <- 96103

L_ENC <- 16

L_DEC <- 16

H_ENC <- 16

H_DEC <- 16

FFN_ENC <- 4096

FFN_DEC <- 4096

EPS <- 1e-05

BLOCK <- 64

RANDOM_BLOCKS <- 3

EMB_SCALE = sqrt MODEL_DIM

bigbird_eval_attention_inputs :: TokenIds[B,S] -> Tensor[B,S] -> (Tensor[B,1,S,S], Tensor[1,1,S,S])
bigbird_eval_attention_inputs input_ids padding_mask = do
  full_keep <- bidirectional_mask_for_input input_ids S padding_mask=padding_mask
  pos <- Tensor.arange input_ids 0 S
  blocks <- Tensor.cast (pos / BLOCK) "long"
  q_blocks <- Tensor.reshape blocks shape=[S, 1]
  k_blocks <- Tensor.reshape blocks shape=[1, S]
  block_delta <- q_blocks - k_blocks
  block_delta <- Tensor.where (Tensor.le block_delta 0) (0 - block_delta) block_delta
  local <- Tensor.le block_delta 1
  last_block <- ((S - 1) / BLOCK)
  global_keys <- (Tensor.eq k_blocks 0) or (Tensor.eq k_blocks last_block)
  global_queries <- (Tensor.eq q_blocks 0) or (Tensor.eq q_blocks last_block)
  sparse <- local or global_keys
  sparse <- sparse or global_queries
  sparse <- Tensor.reshape sparse shape=[1, 1, S, S]
  sparse <- Tensor.expand sparse shape=[B, 1, S, S]
  sparse <- sparse and full_keep
  full_threshold <- (5 + (2 * RANDOM_BLOCKS)) * BLOCK
  use_full <- S <= full_threshold
  duplicate_first_block <- (Tensor.eq global_queries false) and (Tensor.eq k_blocks 0)
  sparse_bias <- Tensor.cast duplicate_first_block "float32"
  sparse_bias <- sparse_bias * log (1.0 + RANDOM_BLOCKS)
  sparse_bias <- Tensor.reshape sparse_bias shape=[1, 1, S, S]
  zero_bias <- Tensor.zeros input_ids shape=[1, 1, S, S] dtype="float32"
  return (use_full ? full_keep : sparse), (use_full ? zero_bias : sparse_bias)

bigbird_encoder_layer :: Tensor[B,S,D] -> Tensor[B,1,S,S] -> Tensor[1,1,S,S] -> Tensor[B,S,D]
bigbird_encoder_layer x keep rel_bias = do
  x_norm <- NN.layernorm@self_attn_layer_norm x eps=EPS
  q <- NN.linear@self_attn.self.query x_norm dim=MODEL_DIM bias=false |> reshape_heads heads=H_ENC
  k <- NN.linear@self_attn.self.key x_norm dim=MODEL_DIM bias=false |> reshape_heads heads=H_ENC
  v <- NN.linear@self_attn.self.value x_norm dim=MODEL_DIM bias=false |> reshape_heads heads=H_ENC
  a <- attention q k v keep rel_bias=rel_bias |> merge_heads |> NN.linear@self_attn.output dim=MODEL_DIM bias=false
  x <- x + a
  x_norm <- NN.layernorm@final_layer_norm x eps=EPS
  m <- NN.linear@fc1 x_norm dim=FFN_ENC bias=true |> gelu_new |> NN.linear@fc2 dim=MODEL_DIM bias=true
  return x + m

bigbird_decoder_layer :: Tensor[B,SDEC,D] -> Tensor[B,SENC,D] -> Tensor[B,1,SDEC,SDEC] -> Tensor[B,1,SDEC,SENC] -> Tensor[B,SDEC,D]
bigbird_decoder_layer x enc_hidden decoder_keep cross_keep = do
  x_norm <- NN.layernorm@self_attn_layer_norm x eps=EPS
  a <- scope@self_attn do
    q <- NN.linear@q_proj x_norm dim=MODEL_DIM bias=false |> reshape_heads heads=H_DEC
    k <- NN.linear@k_proj x_norm dim=MODEL_DIM bias=false |> reshape_heads heads=H_DEC
    v <- NN.linear@v_proj x_norm dim=MODEL_DIM bias=false |> reshape_heads heads=H_DEC
    return attention q k v decoder_keep |> merge_heads |> NN.linear@out_proj dim=MODEL_DIM bias=false
  x <- x + a
  x_norm <- NN.layernorm@encoder_attn_layer_norm x eps=EPS
  a <- scope@encoder_attn do
    q <- NN.linear@q_proj x_norm dim=MODEL_DIM bias=false |> reshape_heads heads=H_DEC
    k <- NN.linear@k_proj enc_hidden dim=MODEL_DIM bias=false |> reshape_heads heads=H_DEC
    v <- NN.linear@v_proj enc_hidden dim=MODEL_DIM bias=false |> reshape_heads heads=H_DEC
    return attention q k v cross_keep |> merge_heads |> NN.linear@out_proj dim=MODEL_DIM bias=false
  x <- x + a
  x_norm <- NN.layernorm@final_layer_norm x eps=EPS
  m <- NN.linear@fc1 x_norm dim=FFN_DEC bias=true |> gelu_new |> NN.linear@fc2 dim=MODEL_DIM bias=true
  return x + m

bigbird_pegasus :: TokenIds[B,SENC] -> ?Mask[B,SENC,SENC] -> TokenIds[B,SDEC] -> ?Mask[B,SDEC,SDEC] -> Tensor[B,SDEC,V]
bigbird_pegasus input_ids attention_mask decoder_input_ids decoder_attention_mask = do
  attention_mask <- mask_for_input input_ids attention_mask SENC
  decoder_attention_mask <- mask_for_input decoder_input_ids decoder_attention_mask SDEC
  encoder_keep, encoder_bias <- bigbird_eval_attention_inputs input_ids attention_mask
  decoder_keep <- causal_mask_for_input decoder_input_ids SDEC padding_mask=decoder_attention_mask window=1048576
  cross_keep <- bidirectional_mask_for_input decoder_input_ids SENC padding_mask=attention_mask
  enc_pos_ids <- Tensor.arange input_ids 0 SENC |> Tensor.reshape shape=[1, SENC] |> Tensor.expand shape=[B, SENC]
  enc_hidden <- NN.embedding@model.shared input_ids dim=MODEL_DIM scale=EMB_SCALE
  enc_hidden <- enc_hidden + NN.embedding@model.encoder.embed_positions enc_pos_ids dim=MODEL_DIM
  enc_hidden <- for@model.encoder.layers i <- [0..L_ENC) carry (enc_hidden) do
    enc_hidden <- bigbird_encoder_layer enc_hidden encoder_keep encoder_bias
    yield enc_hidden
  enc_hidden <- NN.layernorm@model.encoder.layernorm_embedding enc_hidden eps=EPS
  dec_pos_ids <- Tensor.arange decoder_input_ids 0 SDEC |> Tensor.reshape shape=[1, SDEC] |> Tensor.expand shape=[B, SDEC]
  dec_hidden <- NN.embedding@model.shared decoder_input_ids dim=MODEL_DIM scale=EMB_SCALE
  dec_hidden <- dec_hidden + NN.embedding@model.decoder.embed_positions dec_pos_ids dim=MODEL_DIM
  dec_hidden <- for@model.decoder.layers i <- [0..L_DEC) carry (dec_hidden) do
    dec_hidden <- bigbird_decoder_layer dec_hidden enc_hidden decoder_keep cross_keep
    yield dec_hidden
  dec_hidden <- NN.layernorm@model.decoder.layernorm_embedding dec_hidden eps=EPS
  return NN.linear@lm_head dec_hidden dim=VOCAB_SIZE bias=true transpose=false weight_path=@@model.shared.weight bias_path=@@final_logits_bias
