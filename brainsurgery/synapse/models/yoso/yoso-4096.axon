{-# CHECKPOINTS "uw-madison/yoso-4096" #-}

{-# TASK "masked_lm" #-}

{-# MAIN "yoso" #-}

import Activations (gelu)

import Config

import Masking (Mask, mask_for_input)

import Math (PI, acos, clamp, pow)

import NN

import Positions (position_ids)

import Tensor

MODEL_DIM <- (768 :: Dim)

VOCAB_SIZE <- (50265 :: Dim)

NUM_LAYERS <- (12 :: Dim)

NUM_HEADS <- (12 :: Dim)

HEAD_DIM <- MODEL_DIM / NUM_HEADS

FFN <- (3072 :: Dim)

HASH_CODE_LEN <- 9

EPS <- 1e-12

unit_norm :: Tensor[..S] -> Tensor[..S]
unit_norm x = do
  norm_squared <- Tensor.sum (x * x) dim=-1 keepdim=true
  inverse_norm <- pow (clamp norm_squared min=1e-24 max=null) -0.5
  return x * inverse_norm

yoso_attention :: Path -> Tensor[B,S,D] -> Tensor[B,S,D]
yoso_attention@path x = do
  q <- NN.linear@query x dim=MODEL_DIM bias=true |> Tensor.reshape shape=[B, S, NUM_HEADS, HEAD_DIM] |> Tensor.permute dims=[0, 2, 1, 3]
  k <- NN.linear@key x dim=MODEL_DIM bias=true |> Tensor.reshape shape=[B, S, NUM_HEADS, HEAD_DIM] |> Tensor.permute dims=[0, 2, 1, 3]
  v <- NN.linear@value x dim=MODEL_DIM bias=true |> Tensor.reshape shape=[B, S, NUM_HEADS, HEAD_DIM] |> Tensor.permute dims=[0, 2, 1, 3]
  q <- unit_norm q
  k <- unit_norm k
  similarity <- Tensor.matmul q (Tensor.transpose k -2 -1)
  angle <- acos similarity
  probability <- pow (1.0 - (angle / PI)) HASH_CODE_LEN
  context <- Tensor.matmul probability v |> unit_norm
  return Tensor.permute context dims=[0, 2, 1, 3] |> Tensor.reshape shape=[B, S, MODEL_DIM]

yoso_block :: Tensor[B,S,D] -> Tensor[B,S,D]
yoso_block x = do
  a <- scope@attention do
    a <- yoso_attention@self x
    return NN.linear@output.dense a dim=MODEL_DIM bias=true
  x <- NN.layernorm@attention.output.LayerNorm (x + a) eps=EPS
  m <- NN.linear@intermediate.dense x dim=FFN bias=true |> gelu
  m <- NN.linear@output.dense m dim=MODEL_DIM bias=true
  return NN.layernorm@output.LayerNorm (x + m) eps=EPS

yoso :: TokenIds[B,S] -> ?Mask[B,S,S] -> Tensor[B,S,VOCAB_SIZE]
yoso input_ids attn_mask = do
  attn_mask <- mask_for_input input_ids attn_mask S
  pos_ids <- position_ids input_ids
  pos_ids <- pos_ids + 2
  token_type_ids <- input_ids - input_ids
  tok <- NN.embedding@yoso.embeddings.word_embeddings input_ids dim=MODEL_DIM
  pos <- NN.embedding@yoso.embeddings.position_embeddings pos_ids dim=MODEL_DIM
  typ <- NN.embedding@yoso.embeddings.token_type_embeddings token_type_ids dim=MODEL_DIM
  x <- NN.layernorm@yoso.embeddings.LayerNorm (tok + pos + typ) eps=EPS
  x <- for@yoso.encoder.layer i <- [0..NUM_LAYERS) carry (x) do
    x <- yoso_block x
    yield x
  x <- NN.linear@cls.predictions.transform.dense x dim=MODEL_DIM bias=true |> gelu
  x <- NN.layernorm@cls.predictions.transform.LayerNorm x eps=EPS
  return NN.linear@cls.predictions.decoder x dim=VOCAB_SIZE bias=true weight_path=@@yoso.embeddings.word_embeddings.weight bias_path=@@cls.predictions.bias
