{-# CHECKPOINTS ["glm_4_5_air", "test/GLM4-MoE-Test"] #-}
{-# TASK "causal_lm" #-}

import Activations (silu)
import Attention (attention, merge_heads, reshape_heads)
import Masking (causal_mask)
import Math (mul)
import MoE (grouped_sigmoid_router, scatter_add, select)
import Positions (position_ids, rope_pair_base)
import Cache
import Config
import NN
import Tensor



MODEL_DIM    = Config.int @@hidden_size default=4096
VOCAB_SIZE    = Config.int @@vocab_size default=151552
NUM_LAYERS    = Config.int @@num_hidden_layers default=46
NUM_HEADS    = Config.int @@num_attention_heads default=96
KVH  = Config.int @@num_key_value_heads default=8
MODEL_HEAD_DIM   = Config.int @@head_dim default=128
QD   = NUM_HEADS * MODEL_HEAD_DIM
KVD  = KVH * MODEL_HEAD_DIM
FFN  = Config.int @@intermediate_size default=10944
E    = Config.int @@n_routed_experts default=128
EPT  = Config.int @@num_experts_per_tok default=8
EM   = Config.int @@moe_intermediate_size default=1408
NG   = Config.int @@n_group default=1
TKG  = Config.int @@topk_group default=1
EPS  = Config.float @@rms_norm_eps default=1e-05
THETA = Config.float @@rope_theta default=1000000.0
MAX_POSITIONS    = Config.int @@max_position_embeddings default=131072
FIRST_DENSE = Config.int @@first_k_dense_replace default=1
RSC  = Config.float @@routed_scaling_factor default=1.0

rms :: Path -> Tensor[B,S,D] -> Tensor[B,S,D]
rms@path x = NN.rmsnorm@path x eps=EPS

routed_expert_ffn :: Tensor[N,D] -> Tensor[N,D]
routed_expert_ffn x = do
  gate <- NN.linear@gate_proj x dim=EM bias=false
  up <- NN.linear@up_proj x dim=EM bias=false
  return gate |> silu |> mul up |> NN.linear@down_proj dim=MODEL_DIM bias=false

dense_ffn :: Tensor[B,S,D] -> Tensor[B,S,D]
dense_ffn x = do
  gate <- NN.linear@gate_proj x dim=FFN bias=false
  up <- NN.linear@up_proj x dim=FFN bias=false
  return gate |> silu |> mul up |> NN.linear@down_proj dim=MODEL_DIM bias=false

shared_expert_ffn :: Tensor[B,S,D] -> Tensor[B,S,D]
shared_expert_ffn x = do
  gate <- NN.linear@gate_proj x dim=EM bias=false
  up <- NN.linear@up_proj x dim=EM bias=false
  return gate |> silu |> mul up |> NN.linear@down_proj dim=MODEL_DIM bias=false

glm4_moe_attn :: Tensor[B,S,D] -> Tensor[B,S] -> ?Tensor[B,K] -> ?CacheLayer[B,KVH,P,DH] -> (Tensor[B,S,D], ?CacheLayer[B,KVH,K,DH])
glm4_moe_attn x pos_ids attn_mask past_kv = do
  xn <- rms@input_layernorm x
  a, new_kv <- scope@self_attn do
    q <- NN.linear@q_proj xn dim=QD bias=true |> reshape_heads heads=NUM_HEADS
    k <- NN.linear@k_proj xn dim=KVD bias=true |> reshape_heads heads=KVH
    v <- NN.linear@v_proj xn dim=KVD bias=true |> reshape_heads heads=KVH
    q, k <- rope_pair_base q k pos_ids theta=THETA partial_rotary_factor=0.5
    k, v, new_kv <- Cache.update past_kv k v
    k <- Tensor.repeat k repeats=(NUM_HEADS / KVH)
    v <- Tensor.repeat v repeats=(NUM_HEADS / KVH)
    mask <- causal_mask q k window=MAX_POSITIONS padding_mask=attn_mask
    a <- attention q k v mask |> merge_heads |> NN.linear@o_proj dim=MODEL_DIM bias=false
    return a, new_kv
  return x + a, new_kv

glm4_moe_dense_block :: Tensor[B,S,D] -> Tensor[B,S] -> ?Tensor[B,K] -> ?CacheLayer[B,KVH,P,DH] -> (Tensor[B,S,D], ?CacheLayer[B,KVH,K,DH])
glm4_moe_dense_block x pos_ids attn_mask past_kv = do
  x, new_kv <- glm4_moe_attn x pos_ids attn_mask past_kv
  xn <- rms@post_attention_layernorm x
  m <- scope@mlp do
    return dense_ffn xn
  return x + m, new_kv

glm4_moe_sparse_block :: Tensor[B,S,D] -> Tensor[B,S] -> ?Tensor[B,K] -> ?CacheLayer[B,KVH,P,DH] -> (Tensor[B,S,D], ?CacheLayer[B,KVH,K,DH])
glm4_moe_sparse_block x pos_ids attn_mask past_kv = do
  x, new_kv <- glm4_moe_attn x pos_ids attn_mask past_kv
  xn <- rms@post_attention_layernorm x
  m <- scope@mlp do
    shared <- scope@shared_experts do
      return shared_expert_ffn xn
    topk_weights, topk_indices <- grouped_sigmoid_router@gate xn top_k=EPT n_group=NG topk_group=TKG norm_topk_prob=true routed_scaling_factor=RSC
    routed <- Tensor.zeros_like xn
    routed <- for@experts e <- [0..E) carry (routed) do
      x_sel, token_idx, topk_pos, sel_scores <- select xn topk_weights topk_indices e
      x_upd <- routed_expert_ffn x_sel
      routed <- scatter_add routed token_idx x_upd sel_scores
      yield routed
    return shared + routed
  return x + m, new_kv

glm4_moe :: TokenIds[B,S] -> ?Tensor[B,K] -> ?Cache[B,KVH,P,DH] -> ?Bool -> (Tensor[B,S,V], ?Cache[B,KVH,K,DH])
glm4_moe input_ids attn_mask past_kv use_cache = do
  pos_ids <- position_ids input_ids attn_mask=attn_mask past_length=(Cache.past_length past_kv)
  x, new_kv <- scope@model do
    x <- NN.embedding@embed_tokens input_ids dim=MODEL_DIM
    new_kv <- use_cache ? Cache.init : null
    x, new_kv <- for@layers i <- [0..FIRST_DENSE) carry (x, new_kv) do
      past_i <- Cache.index past_kv i
      x, new_i <- glm4_moe_dense_block x pos_ids attn_mask past_i
      new_kv <- Cache.append new_kv new_i
      yield x, new_kv
    x, new_kv <- for@layers i <- [FIRST_DENSE..NUM_LAYERS) carry (x, new_kv) do
      past_i <- Cache.index past_kv i
      x, new_i <- glm4_moe_sparse_block x pos_ids attn_mask past_i
      new_kv <- Cache.append new_kv new_i
      yield x, new_kv
    x <- rms@norm x
    return x, new_kv
  logits <- NN.linear@lm_head x dim=VOCAB_SIZE bias=false
  return logits, new_kv
