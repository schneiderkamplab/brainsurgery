{-# CHECKPOINTS ["zai-org/GLM-4-9B-0414", "zai-org/GLM-Z1-9B-0414"] #-}
{-# TASK "causal_lm" #-}

import Activations
import Activations (silu)
import Attention
import Attention (attention, merge_heads, reshape_heads)
import Masking
import Masking (causal_mask)
import Math
import Math (mul)
import Positions
import Positions (position_ids, rope_pair_base)
import Cache
import NN
import Tensor

rms :: Path -> Tensor[B,S,D] -> Tensor[B,S,D]
rms@path x = NN.rmsnorm@path x eps=1e-05

glm4_dense_attn :: Tensor[B,S,D] -> Tensor[B,S] -> ?Tensor[B,S] -> ?CacheLayer -> (Tensor[B,S,D], ?CacheLayer)
glm4_dense_attn x pos_ids attn_mask past_kv = do
  xn <- rms@input_layernorm x
  a, new_kv <- scope@self_attn do
    q <- (NN.linear@q_proj xn dim=4096 bias=true)
    q <- reshape_heads q heads=32
    k <- (NN.linear@k_proj xn dim=256 bias=true)
    k <- reshape_heads k heads=2
    v <- (NN.linear@v_proj xn dim=256 bias=true)
    v <- reshape_heads v heads=2
    q, k <- rope_pair_base q k pos_ids theta=10000.0 partial_rotary_factor=0.5 interleaved=true
    k, v, new_kv <- Cache.update past_kv k v
    k <- Tensor.repeat k repeats=16
    v <- Tensor.repeat v repeats=16
    mask <- causal_mask q k window=32768 padding_mask=attn_mask
    a <- attention q k v mask |> merge_heads |> NN.linear@o_proj dim=4096 bias=false
    return a, new_kv
  a <- rms@post_self_attn_layernorm a
  return x + a, new_kv

glm4_dense_ffn :: Tensor[B,S,D] -> Tensor[B,S,D]
glm4_dense_ffn x = do
  gu <- NN.linear@gate_up_proj x dim=27392 bias=false
  g, u <- Tensor.split gu sizes=[13696, 13696]
  return g |> silu |> mul u |> NN.linear@down_proj dim=4096 bias=false

glm4_dense_block :: Tensor[B,S,D] -> Tensor[B,S] -> ?Tensor[B,S] -> ?CacheLayer -> (Tensor[B,S,D], ?CacheLayer)
glm4_dense_block x pos_ids attn_mask past_kv = do
  x, new_kv <- glm4_dense_attn x pos_ids attn_mask past_kv
  residual <- x
  xn <- rms@post_attention_layernorm residual
  m <- scope@mlp do
    return glm4_dense_ffn xn
  m <- rms@post_mlp_layernorm m
  x <- residual + m
  return x, new_kv

glm4_dense :: TokenIds[B,S] -> ?Tensor[B,S] -> ?Cache -> ?Bool -> (Tensor[B,S,V], ?Cache)
glm4_dense input_ids attn_mask past_kv use_cache = do
  pos_ids <- position_ids input_ids past_length=(Cache.past_length past_kv)
  x, new_kv <- scope@model do
    x <- NN.embedding@embed_tokens input_ids dim=4096
    new_kv <- use_cache ? Cache.init : null
    for@layers i <- [0..40) do
      past_i <- Cache.index past_kv i
      x, new_i <- glm4_dense_block x pos_ids attn_mask past_i
      new_kv <- Cache.append new_kv new_i
      yield x, new_kv
    x <- rms@norm x
    return x, new_kv
  logits <- NN.linear@lm_head x dim=151552 bias=false
  return logits, new_kv
