{-# CHECKPOINTS "glm_4_5_air" #-}
{-# TASK "causal_lm" #-}

import Activations
import Activations (silu)
import Attention
import Attention (attention, merge_heads, reshape_heads)
import Masking
import Masking (causal_mask)
import Math
import Math (mul)
import MoE
import MoE (grouped_sigmoid_router, scatter_add, select)
import Positions
import Positions (position_ids, rope_pair_base)

rms :: Path -> Tensor[B,S,D] -> Tensor[B,S,D]
rms@path x = NN.rmsnorm@path x eps=1e-05

routed_expert_ffn :: Tensor[N,D] -> Tensor[N,D]
routed_expert_ffn x = do
  gate <- NN.linear@gate_proj x dim=1408 bias=false
  up <- NN.linear@up_proj x dim=1408 bias=false
  return gate |> silu |> mul up |> NN.linear@down_proj dim=4096 bias=false

dense_ffn :: Tensor[B,S,D] -> Tensor[B,S,D]
dense_ffn x = do
  gate <- NN.linear@gate_proj x dim=10944 bias=false
  up <- NN.linear@up_proj x dim=10944 bias=false
  return gate |> silu |> mul up |> NN.linear@down_proj dim=4096 bias=false

shared_expert_ffn :: Tensor[B,S,D] -> Tensor[B,S,D]
shared_expert_ffn x = do
  gate <- NN.linear@gate_proj x dim=1408 bias=false
  up <- NN.linear@up_proj x dim=1408 bias=false
  return gate |> silu |> mul up |> NN.linear@down_proj dim=4096 bias=false

glm4_moe_attn :: Tensor[B,S,D] -> Tensor[B,S] -> ?Tensor[B,S] -> ?CacheLayer -> (Tensor[B,S,D], ?CacheLayer)
glm4_moe_attn x pos_ids attn_mask past_kv = do
  xn <- rms@input_layernorm x
  a, new_kv <- scope@self_attn do
    q <- NN.linear@q_proj xn dim=12288 bias=true |> reshape_heads heads=96
    k <- NN.linear@k_proj xn dim=1024 bias=true |> reshape_heads heads=8
    v <- NN.linear@v_proj xn dim=1024 bias=true |> reshape_heads heads=8
    q, k <- rope_pair_base q k pos_ids theta=1000000.0 partial_rotary_factor=0.5
    k, v, new_kv <- Cache.update past_kv k v
    k <- Tensor.repeat k repeats=12
    v <- Tensor.repeat v repeats=12
    mask <- causal_mask q k window=131072 padding_mask=attn_mask
    a <- attention q k v mask |> merge_heads |> NN.linear@o_proj dim=4096 bias=false
    return a, new_kv
  return x + a, new_kv

glm4_moe_dense_block :: Tensor[B,S,D] -> Tensor[B,S] -> ?Tensor[B,S] -> ?CacheLayer -> (Tensor[B,S,D], ?CacheLayer)
glm4_moe_dense_block x pos_ids attn_mask past_kv = do
  x, new_kv <- glm4_moe_attn x pos_ids attn_mask past_kv
  xn <- rms@post_attention_layernorm x
  m <- scope@mlp do
    return dense_ffn xn
  return x + m, new_kv

glm4_moe_sparse_block :: Tensor[B,S,D] -> Tensor[B,S] -> ?Tensor[B,S] -> ?CacheLayer -> (Tensor[B,S,D], ?CacheLayer)
glm4_moe_sparse_block x pos_ids attn_mask past_kv = do
  x, new_kv <- glm4_moe_attn x pos_ids attn_mask past_kv
  xn <- rms@post_attention_layernorm x
  m <- scope@mlp do
    shared <- scope@shared_experts do
      return shared_expert_ffn xn
    topk_weights, topk_indices <- grouped_sigmoid_router@gate xn top_k=8 n_group=1 topk_group=1 norm_topk_prob=true routed_scaling_factor=1.0
    routed <- Tensor.zeros_like xn
    for@experts e <- [0..128) do
      x_sel, token_idx, topk_pos, sel_scores <- select xn topk_weights topk_indices e
      x_upd <- routed_expert_ffn x_sel
      routed <- scatter_add routed token_idx x_upd sel_scores
      yield routed
    return shared + routed
  return x + m, new_kv

glm4_moe :: TokenIds[B,S] -> ?Tensor[B,S] -> ?Cache -> ?Bool -> (Tensor[B,S,V], ?Cache)
glm4_moe input_ids attn_mask past_kv use_cache = do
  pos_ids <- position_ids input_ids attn_mask=attn_mask past_length=(Cache.past_length past_kv)
  x, new_kv <- scope@model do
    x <- NN.embedding@embed_tokens input_ids dim=4096
    new_kv <- use_cache ? Cache.init : null
    for@layers i <- [0..1) do
      past_i <- Cache.index past_kv i
      x, new_i <- glm4_moe_dense_block x pos_ids attn_mask past_i
      new_kv <- Cache.append new_kv new_i
      yield x, new_kv
    for@layers i <- [1..46) do
      past_i <- Cache.index past_kv i
      x, new_i <- glm4_moe_sparse_block x pos_ids attn_mask past_i
      new_kv <- Cache.append new_kv new_i
      yield x, new_kv
    x <- rms@norm x
    return x, new_kv
  logits <- NN.linear@lm_head x dim=151552 bias=false
  return logits, new_kv
