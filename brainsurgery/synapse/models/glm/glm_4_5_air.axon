{-# CHECKPOINTS "glm_4_5_air" #-}
{-# TASK "causal_lm" #-}

import Activations
import Activations (silu)
import Cache
import Cache
import MoE
import Attention (reshape_heads, merge_heads)
import Attention (attention_masked)
import Masking (causal_mask)
import Positions (position_ids, rope_pair_base)
import Math (mul)

D = 4096
V = 151552
L = 46
H = 96
KVH = 8
QD = 12288
KVD = 1024
FFN = 10944
E = 128
EPT = 8
EM = 1408
NG = 1
TKG = 1
EPS = 1e-05
THETA = 1000000.0
C = 131072
FIRST_DENSE = 1
RSC = 1.0

rms :: @Path -> Tensor[B,S,D] -> Tensor[B,S,D]
rms@path x = NN.rmsnorm@path x eps=EPS

routed_expert_ffn :: Tensor[N,D] -> Tensor[N,D]
routed_expert_ffn x = do
  gate <- NN.linear@gate_proj x dim=EM bias=false
  up <- NN.linear@up_proj x dim=EM bias=false
  return gate |> silu |> mul up |> NN.linear@down_proj dim=D bias=false

dense_ffn :: Tensor[B,S,D] -> Tensor[B,S,D]
dense_ffn x = do
  gate <- NN.linear@gate_proj x dim=FFN bias=false
  up <- NN.linear@up_proj x dim=FFN bias=false
  return gate |> silu |> mul up |> NN.linear@down_proj dim=D bias=false

shared_expert_ffn :: Tensor[B,S,D] -> Tensor[B,S,D]
shared_expert_ffn x = do
  gate <- NN.linear@gate_proj x dim=EM bias=false
  up <- NN.linear@up_proj x dim=EM bias=false
  return gate |> silu |> mul up |> NN.linear@down_proj dim=D bias=false

glm4_moe_attn :: Tensor[B,S,D] -> Tensor[B,S] -> ?Tensor[B,S] -> ?CacheLayer -> (Tensor[B,S,D], ?CacheLayer)
glm4_moe_attn x pos_ids attn_mask past_kv = do
  xn <- rms@input_layernorm x
  a, new_kv <- scope@self_attn do
    q <- NN.linear@q_proj xn dim=QD bias=true |> reshape_heads heads=H
    k <- NN.linear@k_proj xn dim=KVD bias=true |> reshape_heads heads=KVH
    v <- NN.linear@v_proj xn dim=KVD bias=true |> reshape_heads heads=KVH
    q, k <- rope_pair_base q k pos_ids theta=THETA partial_rotary_factor=0.5
    k, v, new_kv <- Cache.update past_kv k v
    k <- Tensor.repeat k repeats=(H / KVH)
    v <- Tensor.repeat v repeats=(H / KVH)
    mask <- causal_mask q k window=C padding_mask=attn_mask
    a <- attention_masked q k v mask=mask |> merge_heads |> NN.linear@o_proj dim=D bias=false
    return a, new_kv
  return x + a, new_kv

glm4_moe_dense_block :: Tensor[B,S,D] -> Tensor[B,S] -> ?Tensor[B,S] -> ?CacheLayer -> (Tensor[B,S,D], ?CacheLayer)
glm4_moe_dense_block x pos_ids attn_mask past_kv = do
  x, new_kv <- glm4_moe_attn x pos_ids attn_mask past_kv
  xn <- rms@post_attention_layernorm x
  m <- scope@mlp do
    return dense_ffn xn
  return x + m, new_kv

glm4_moe_sparse_block :: Tensor[B,S,D] -> Tensor[B,S] -> ?Tensor[B,S] -> ?CacheLayer -> (Tensor[B,S,D], ?CacheLayer)
glm4_moe_sparse_block x pos_ids attn_mask past_kv = do
  x, new_kv <- glm4_moe_attn x pos_ids attn_mask past_kv
  xn <- rms@post_attention_layernorm x
  m <- scope@mlp do
    shared <- scope@shared_experts do
      return shared_expert_ffn xn
    topk_weights, topk_indices <- MoE.grouped_sigmoid_router@gate xn top_k=EPT n_group=NG topk_group=TKG norm_topk_prob=true routed_scaling_factor=RSC
    routed <- Tensor.zeros_like xn
    for@experts e <- [0..E) do
      x_sel, token_idx, topk_pos, sel_scores <- MoE.select xn topk_weights topk_indices e
      x_upd <- routed_expert_ffn x_sel
      routed <- MoE.scatter_add routed token_idx x_upd sel_scores
    return shared + routed
  return x + m, new_kv

glm4_moe :: TokenIds[B,S] -> ?Tensor[B,S] -> ?Cache -> ?Bool -> (Tensor[B,S,V], ?Cache)
glm4_moe input_ids attn_mask past_kv use_cache = do
  pos_ids <- position_ids input_ids attn_mask=attn_mask past_length=(Cache.past_length past_kv)
  x, new_kv <- scope@model do
    x <- NN.embedding@embed_tokens input_ids dim=D
    new_kv <- use_cache ? Cache.init : null
    for@layers i <- [0..FIRST_DENSE) do
      past_i <- Cache.index past_kv i
      x, new_i <- glm4_moe_dense_block x pos_ids attn_mask past_i
      new_kv <- Cache.append new_kv new_i
    for@layers i <- [FIRST_DENSE..L) do
      past_i <- Cache.index past_kv i
      x, new_i <- glm4_moe_sparse_block x pos_ids attn_mask past_i
      new_kv <- Cache.append new_kv new_i
    x <- rms@norm x
    return x, new_kv
  logits <- NN.linear@lm_head x dim=V bias=false
  return logits, new_kv
