{-# CHECKPOINTS "zai-org/glm-edge-4b-chat" #-}
{-# TASK "causal_lm" #-}

import Activations
import Activations (silu)
import Attention
import Attention (attention, merge_heads, reshape_heads)
import Masking
import Masking (causal_mask)
import Math
import Math (mul)
import Params
import Params (has_root)
import Positions
import Positions (position_ids, rope_pair_base)

HAS_LM_HEAD = has_root "lm_head"

rms :: Path -> Tensor[B,S,D] -> Tensor[B,S,D]
rms@path x = NN.rmsnorm@path x eps=1e-05

glm_edge_attn :: Tensor[B,S,D] -> Tensor[B,S] -> ?Tensor[B,S] -> ?CacheLayer -> (Tensor[B,S,D], ?CacheLayer)
glm_edge_attn x pos_ids attn_mask past_kv = do
  xn <- rms@input_layernorm x
  a, new_kv <- scope@self_attn do
    q <- (NN.linear@q_proj xn dim=3072 bias=false)
    q <- reshape_heads q heads=24
    k <- (NN.linear@k_proj xn dim=768 bias=false)
    k <- reshape_heads k heads=6
    v <- (NN.linear@v_proj xn dim=768 bias=false)
    v <- reshape_heads v heads=6
    q, k <- rope_pair_base q k pos_ids theta=10000.0 partial_rotary_factor=1.0 interleaved=true
    k, v, new_kv <- Cache.update past_kv k v
    k <- Tensor.repeat k repeats=4
    v <- Tensor.repeat v repeats=4
    mask <- causal_mask q k window=8192 padding_mask=attn_mask
    a <- attention q k v mask |> merge_heads |> NN.linear@o_proj dim=3072 bias=false
    return a, new_kv
  return x + a, new_kv

glm_edge_ffn :: Tensor[B,S,D] -> Tensor[B,S,D]
glm_edge_ffn x = do
  gu <- NN.linear@gate_up_proj x dim=16384 bias=false
  g, u <- Tensor.split gu sizes=[8192, 8192]
  return g |> silu |> mul u |> NN.linear@down_proj dim=3072 bias=false

glm_edge_block :: Tensor[B,S,D] -> Tensor[B,S] -> ?Tensor[B,S] -> ?CacheLayer -> (Tensor[B,S,D], ?CacheLayer)
glm_edge_block x pos_ids attn_mask past_kv = do
  x, new_kv <- glm_edge_attn x pos_ids attn_mask past_kv
  residual <- x
  xn <- rms@post_attention_layernorm residual
  m <- scope@mlp do
    return glm_edge_ffn xn
  x <- residual + m
  return x, new_kv

glm_edge :: TokenIds[B,S] -> ?Tensor[B,S] -> ?Cache -> ?Bool -> (Tensor[B,S,V], ?Cache)
glm_edge input_ids attn_mask past_kv use_cache = do
  pos_ids <- position_ids input_ids past_length=(Cache.past_length past_kv)
  x, new_kv <- scope@model do
    x <- NN.embedding@embed_tokens input_ids dim=3072
    new_kv <- use_cache ? Cache.init : null
    for@layers i <- [0..40) do
      past_i <- Cache.index past_kv i
      x, new_i <- glm_edge_block x pos_ids attn_mask past_i
      new_kv <- Cache.append new_kv new_i
      yield x, new_kv
    x <- rms@norm x
    return x, new_kv
  logits <- HAS_LM_HEAD ? ((NN.linear@lm_head x dim=59264 bias=false)) : (NN.linear@model.embed_tokens x dim=59264)
  return logits, new_kv
