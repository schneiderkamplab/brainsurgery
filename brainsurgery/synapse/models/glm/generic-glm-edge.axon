import Math
{-# CHECKPOINTS ["zai-org/glm-edge-1.5b-chat", "zai-org/glm-edge-4b-chat"] #-}
{-# TASK "causal_lm" #-}

import Config
import Params
import Activations silu
import Cache past_length
import Cache

D    = Config.int "hidden_size" default=3072
V    = Config.int "vocab_size" default=59264
L    = Config.int "num_hidden_layers" default=40
H    = Config.int "num_attention_heads" default=24
KVH  = Config.int "num_key_value_heads" default=6
HD   = Config.int "head_dim" default=128
QD   = H * HD
KVD  = KVH * HD
FFN  = Config.int "intermediate_size" default=8192
EPS  = Config.float "rms_norm_eps" default=1e-05
THETA = Config.float "rope_theta" default=10000.0
C    = Config.int "max_position_embeddings" default=8192
PROPE = Config.float "partial_rotary_factor" default=1.0
ATTN_BIAS = Config.bool "attention_bias" default=false
HAS_LM_HEAD = Params.has_root "lm_head"
TIE = Config.bool "tie_word_embeddings" default=false

rms :: @Path -> Tensor[B,S,D] -> Tensor[B,S,D]
rms@path x = rmsnorm@path x eps=EPS

glm_edge_attn :: Tensor[B,S,D] -> Tensor[B,S] -> ?Tensor[B,S] -> ?CacheLayer -> (Tensor[B,S,D], ?CacheLayer)
glm_edge_attn x pos_ids attn_mask past_kv = do
  xn <- rms@input_layernorm x
  a, new_kv <- scope@self_attn do
    q <- ATTN_BIAS ? (linear@q_proj xn dim=QD bias=true) : (linear@q_proj xn dim=QD bias=false)
    q <- reshape_heads q heads=H
    k <- ATTN_BIAS ? (linear@k_proj xn dim=KVD bias=true) : (linear@k_proj xn dim=KVD bias=false)
    k <- reshape_heads k heads=KVH
    v <- ATTN_BIAS ? (linear@v_proj xn dim=KVD bias=true) : (linear@v_proj xn dim=KVD bias=false)
    v <- reshape_heads v heads=KVH
    q, k <- rope_pair_base q k pos_ids theta=THETA partial_rotary_factor=PROPE interleaved=true
    k, v, new_kv <- Cache.update past_kv k v
    k <- repeat k repeats=(H / KVH)
    v <- repeat v repeats=(H / KVH)
    mask <- causal_mask q k window=C padding_mask=attn_mask
    a <- attention q k v mask=mask |> merge_heads |> linear@o_proj dim=D bias=false
    return a, new_kv
  return x + a, new_kv

glm_edge_ffn :: Tensor[B,S,D] -> Tensor[B,S,D]
glm_edge_ffn x = do
  gu <- linear@gate_up_proj x dim=(2 * FFN) bias=false
  g, u <- split gu sizes=[FFN, FFN]
  return g |> silu |> Math.mul u |> linear@down_proj dim=D bias=false

glm_edge_block :: Tensor[B,S,D] -> Tensor[B,S] -> ?Tensor[B,S] -> ?CacheLayer -> (Tensor[B,S,D], ?CacheLayer)
glm_edge_block x pos_ids attn_mask past_kv = do
  x, new_kv <- glm_edge_attn x pos_ids attn_mask past_kv
  residual <- x
  xn <- rms@post_attention_layernorm residual
  m <- scope@mlp do
    return glm_edge_ffn xn
  x <- residual + m
  return x, new_kv

glm_edge :: TokenIds[B,S] -> ?Tensor[B,S] -> ?Cache -> ?Bool -> (Tensor[B,S,V], ?Cache)
glm_edge input_ids attn_mask past_kv use_cache = do
  pos_ids <- position_ids input_ids past_length=(past_length past_kv)
  x, new_kv <- scope@model do
    x <- embedding@embed_tokens input_ids dim=D
    new_kv <- use_cache ? Cache.init : null
    for@layers i <- [0..L) do
      past_i <- Cache.index past_kv i
      x, new_i <- glm_edge_block x pos_ids attn_mask past_i
      new_kv <- Cache.append new_kv new_i
    x <- rms@norm x
    return x, new_kv
  logits <- HAS_LM_HEAD ? ((TIE == false) ? (linear@lm_head x dim=V bias=false) : (linear@model.embed_tokens x dim=V)) : (linear@model.embed_tokens x dim=V)
  return logits, new_kv
