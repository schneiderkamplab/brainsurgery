{-# CHECKPOINTS ["FacebookAI/roberta-base", "FacebookAI/roberta-large", "distilbert/distilroberta-base", "almanach/camembert-base", "almanach/camembert-large", "FacebookAI/xlm-roberta-base", "FacebookAI/xlm-roberta-large"] #-}
{-# TASK "masked_lm" #-}

import Activations (gelu)
import Attention (attention, merge_heads, reshape_heads)
import Masking (bidirectional_mask)
import Positions (position_ids)



D   = Config.int@hidden_size default=768
V   = Config.int@vocab_size default=50265
L   = Config.int@num_hidden_layers default=12
H   = Config.int@num_attention_heads default=12
FFN = Config.int@intermediate_size default=3072
EPS = Config.float@layer_norm_eps default=1e-05
PAD = Config.int@pad_token_id default=1

roberta_block :: Tensor[B,S,D] -> ?Tensor[B,S] -> Tensor[B,S,D]
roberta_block x attn_mask = do
  a <- scope@attention do
    q <- NN.linear@self.query x dim=D bias=true |> reshape_heads heads=H
    k <- NN.linear@self.key x dim=D bias=true |> reshape_heads heads=H
    v <- NN.linear@self.value x dim=D bias=true |> reshape_heads heads=H
    keep <- bidirectional_mask q k padding_mask=attn_mask
    return attention q k v keep |> merge_heads |> NN.linear@output.dense dim=D bias=true
  x <- x + a
  x <- NN.layernorm@attention.output.LayerNorm x eps=EPS
  m <- NN.linear@intermediate.dense x dim=FFN bias=true |> gelu
  m <- NN.linear@output.dense m dim=D bias=true
  y <- x + m
  y <- NN.layernorm@output.LayerNorm y eps=EPS
  return y

roberta :: TokenIds[B,S] -> ?Tensor[B,S] -> Tensor[B,S,V]
roberta input_ids attn_mask = do
  pos_base <- position_ids input_ids attn_mask=attn_mask pad_fill=-1
  pos_shift <- PAD + 1
  pos_ids <- pos_base + pos_shift
  tok_type_ids <- input_ids - input_ids
  tok <- NN.embedding@roberta.embeddings.word_embeddings input_ids dim=D
  pos <- NN.embedding@roberta.embeddings.position_embeddings pos_ids dim=D
  typ <- NN.embedding@roberta.embeddings.token_type_embeddings tok_type_ids dim=D
  x <- tok + pos
  x <- x + typ
  x <- NN.layernorm@roberta.embeddings.LayerNorm x eps=EPS
  x <- for@roberta.encoder.layer i <- [0..L) carry (x) do
    x <- roberta_block x attn_mask
    yield x
  logits <- scope@lm_head do
    x <- NN.linear@dense x dim=D bias=true |> gelu
    x <- NN.layernorm@layer_norm x eps=EPS
    return NN.linear@decoder x dim=V bias=true weight_path=@@roberta.embeddings.word_embeddings.weight bias_path=@@lm_head.bias
  return logits
