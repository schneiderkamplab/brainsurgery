import Math
{-# CHECKPOINTS ["FacebookAI/roberta-base", "FacebookAI/roberta-large", "distilbert/distilroberta-base", "almanach/camembert-base", "almanach/camembert-large", "FacebookAI/xlm-roberta-base", "FacebookAI/xlm-roberta-large"] #-}
{-# TASK "masked_lm" #-}

import Config
import Activations gelu

D   = Config.int "hidden_size" default=768
V   = Config.int "vocab_size" default=50265
L   = Config.int "num_hidden_layers" default=12
H   = Config.int "num_attention_heads" default=12
FFN = Config.int "intermediate_size" default=3072
EPS = Config.float "layer_norm_eps" default=1e-05
PAD = Config.int "pad_token_id" default=1

roberta_block :: Tensor[B,S,D] -> ?Tensor[B,S] -> Tensor[B,S,D]
roberta_block x attn_mask = do
  a <- scope@attention do
    q <- linear@self.query x dim=D bias=true |> reshape_heads heads=H
    k <- linear@self.key x dim=D bias=true |> reshape_heads heads=H
    v <- linear@self.value x dim=D bias=true |> reshape_heads heads=H
    return attention q k v mask=attn_mask padding_mask=true causal=false |> merge_heads |> linear@output.dense dim=D bias=true
  x <- x + a
  x <- layernorm@attention.output.LayerNorm x eps=EPS
  m <- linear@intermediate.dense x dim=FFN bias=true |> gelu
  m <- linear@output.dense m dim=D bias=true
  y <- x + m
  y <- layernorm@output.LayerNorm y eps=EPS
  return y

roberta :: TokenIds[B,S] -> ?Tensor[B,S] -> Tensor[B,S,V]
roberta input_ids attn_mask = do
  pos_base <- position_ids input_ids attn_mask=attn_mask pad_fill=-1
  pos_shift <- PAD + 1
  pos_ids <- Math.add pos_base pos_shift
  tok_type_ids <- zeros_like input_ids
  tok <- embedding@roberta.embeddings.word_embeddings input_ids dim=D
  pos <- embedding@roberta.embeddings.position_embeddings pos_ids dim=D
  typ <- embedding@roberta.embeddings.token_type_embeddings tok_type_ids dim=D
  x <- tok + pos
  x <- x + typ
  x <- layernorm@roberta.embeddings.LayerNorm x eps=EPS
  for@roberta.encoder.layer i <- [0..L) do
    x <- roberta_block x attn_mask
  logits <- scope@lm_head do
    x <- linear@dense x dim=D bias=true |> gelu
    x <- layernorm@layer_norm x eps=EPS
    return linear@decoder x dim=V bias=true weight_path=@@roberta.embeddings.word_embeddings.weight bias_path=@@lm_head.bias
  return logits
