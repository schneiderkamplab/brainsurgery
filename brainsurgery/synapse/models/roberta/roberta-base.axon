{-# CHECKPOINTS "FacebookAI/roberta-base" #-}
{-# TASK "masked_lm" #-}

import Activations
import Activations (gelu)
import Attention
import Attention (attention, merge_heads, reshape_heads)
import Masking
import Masking (bidirectional_mask)
import Positions
import Positions (position_ids)
import NN

roberta_block :: Tensor[B,S,D] -> ?Tensor[B,S] -> Tensor[B,S,D]
roberta_block x attn_mask = do
  a <- scope@attention do
    q <- NN.linear@self.query x dim=768 bias=true |> reshape_heads heads=12
    k <- NN.linear@self.key x dim=768 bias=true |> reshape_heads heads=12
    v <- NN.linear@self.value x dim=768 bias=true |> reshape_heads heads=12
    keep <- bidirectional_mask q k padding_mask=attn_mask
    return attention q k v keep |> merge_heads |> NN.linear@output.dense dim=768 bias=true
  x <- x + a
  x <- NN.layernorm@attention.output.LayerNorm x eps=1e-05
  m <- NN.linear@intermediate.dense x dim=3072 bias=true |> gelu
  m <- NN.linear@output.dense m dim=768 bias=true
  y <- x + m
  y <- NN.layernorm@output.LayerNorm y eps=1e-05
  return y

roberta :: TokenIds[B,S] -> ?Tensor[B,S] -> Tensor[B,S,V]
roberta input_ids attn_mask = do
  pos_base <- position_ids input_ids attn_mask=attn_mask pad_fill=-1
  pos_shift <- 2
  pos_ids <- pos_base + pos_shift
  tok_type_ids <- input_ids - input_ids
  tok <- NN.embedding@roberta.embeddings.word_embeddings input_ids dim=768
  pos <- NN.embedding@roberta.embeddings.position_embeddings pos_ids dim=768
  typ <- NN.embedding@roberta.embeddings.token_type_embeddings tok_type_ids dim=768
  x <- tok + pos
  x <- x + typ
  x <- NN.layernorm@roberta.embeddings.LayerNorm x eps=1e-05
  for@roberta.encoder.layer i <- [0..12) do
    x <- roberta_block x attn_mask
    yield x
  logits <- scope@lm_head do
    x <- NN.linear@dense x dim=768 bias=true |> gelu
    x <- NN.layernorm@layer_norm x eps=1e-05
    return NN.linear@decoder x dim=50265 bias=true weight_path=@@roberta.embeddings.word_embeddings.weight bias_path=@@lm_head.bias
  return logits
