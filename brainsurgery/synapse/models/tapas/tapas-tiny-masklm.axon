{-# CHECKPOINTS "google/tapas-tiny-masklm" #-}

{-# TASK "masked_lm" #-}

{-# MAIN "tapas" #-}

import Activations (gelu)

import Attention (attention, merge_heads, reshape_heads)

import Masking (Mask, bidirectional_mask_for_input, mask_for_input)

import Positions (position_ids)

import Config

import NN

MODEL_DIM <- 128

VOCAB_SIZE <- 30522

NUM_LAYERS <- 2

NUM_HEADS <- 2

FFN <- 512

EPS <- 1e-12

tapas_block :: Tensor[B,S,D] -> Tensor[B,1,S,S] -> Tensor[B,S,D]
tapas_block x keep = do
  a <- scope@attention do
    q <- NN.linear@self.query x dim=MODEL_DIM bias=true |> reshape_heads heads=NUM_HEADS
    k <- NN.linear@self.key x dim=MODEL_DIM bias=true |> reshape_heads heads=NUM_HEADS
    v <- NN.linear@self.value x dim=MODEL_DIM bias=true |> reshape_heads heads=NUM_HEADS
    return attention q k v keep |> merge_heads |> NN.linear@output.dense dim=MODEL_DIM bias=true
  x <- x + a
  x <- NN.layernorm@attention.output.LayerNorm x eps=EPS
  m <- NN.linear@intermediate.dense x dim=FFN bias=true |> gelu
  m <- NN.linear@output.dense m dim=MODEL_DIM bias=true
  y <- x + m
  y <- NN.layernorm@output.LayerNorm y eps=EPS
  return y

tapas :: TokenIds[B,S] -> ?Mask[B,S,S] -> Tensor[B,S,V]
tapas input_ids attn_mask = do
  attn_mask <- mask_for_input input_ids attn_mask S
  pos_ids <- position_ids input_ids
  keep <- bidirectional_mask_for_input input_ids S padding_mask=attn_mask
  token_type_ids <- input_ids - input_ids
  x <- NN.embedding@tapas.embeddings.word_embeddings input_ids dim=MODEL_DIM
  x <- x + NN.embedding@tapas.embeddings.position_embeddings pos_ids dim=MODEL_DIM
  x <- x + NN.embedding@tapas.embeddings.token_type_embeddings_0 token_type_ids dim=MODEL_DIM
  x <- x + NN.embedding@tapas.embeddings.token_type_embeddings_1 token_type_ids dim=MODEL_DIM
  x <- x + NN.embedding@tapas.embeddings.token_type_embeddings_2 token_type_ids dim=MODEL_DIM
  x <- x + NN.embedding@tapas.embeddings.token_type_embeddings_3 token_type_ids dim=MODEL_DIM
  x <- x + NN.embedding@tapas.embeddings.token_type_embeddings_4 token_type_ids dim=MODEL_DIM
  x <- x + NN.embedding@tapas.embeddings.token_type_embeddings_5 token_type_ids dim=MODEL_DIM
  x <- x + NN.embedding@tapas.embeddings.token_type_embeddings_6 token_type_ids dim=MODEL_DIM
  x <- NN.layernorm@tapas.embeddings.LayerNorm x eps=EPS
  x <- for@tapas.encoder.layer i <- [0..NUM_LAYERS) carry (x) do
    x <- tapas_block x keep
    yield x
  logits <- scope@cls.predictions do
    x <- NN.linear@transform.dense x dim=MODEL_DIM bias=true |> gelu
    x <- NN.layernorm@transform.LayerNorm x eps=EPS
    return NN.linear@decoder x dim=VOCAB_SIZE bias=true weight_path=@@tapas.embeddings.word_embeddings.weight bias_path=@@cls.predictions.bias
  return logits
