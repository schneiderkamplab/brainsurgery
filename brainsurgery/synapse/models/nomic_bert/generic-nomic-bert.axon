{-# CHECKPOINTS ["nomic-ai/nomic-bert-2048"] #-}
{-# TASK "masked_lm" #-}

import Activations (silu)
import Attention (attention, merge_heads, split_qkv_heads)
import Masking (Mask, bidirectional_mask_for_input, mask_for_input)
import Positions (position_ids, rope_pair_base)
import Config
import NN


MODEL_DIM <- Config.int @@n_embd default=768
VOCAB_SIZE <- Config.int @@vocab_size default=30528
NUM_LAYERS <- Config.int @@n_layer default=12
NUM_HEADS <- Config.int @@n_head default=12
FFN <- Config.int @@n_inner default=3072
EPS <- Config.float @@layer_norm_epsilon default=1e-12
ROPE_THETA <- Config.float @@rotary_emb_base default=1000.0

nomic_bert_block :: Tensor[B,S,D] -> Tensor[B,S] -> Tensor[B,1,S,S] -> Tensor[B,S,D]
nomic_bert_block x pos_ids keep = do
  a <- scope@attn do
    qkv <- NN.linear@Wqkv x dim=(3 * MODEL_DIM) bias=false
    q, k, v <- split_qkv_heads qkv heads=NUM_HEADS
    q, k <- rope_pair_base q k pos_ids theta=ROPE_THETA interleaved=false
    return attention q k v keep |> merge_heads |> NN.linear@out_proj dim=MODEL_DIM bias=false
  x <- x + a
  x <- NN.layernorm@norm1 x eps=EPS
  left <- NN.linear@mlp.fc11 x dim=FFN bias=false
  gate <- NN.linear@mlp.fc12 x dim=FFN bias=false |> silu
  m <- left * gate
  m <- NN.linear@mlp.fc2 m dim=MODEL_DIM bias=false
  y <- x + m
  return NN.layernorm@norm2 y eps=EPS

nomic_bert :: TokenIds[B,S] -> ?Mask[B,S,S] -> Tensor[B,S,VOCAB_SIZE]
nomic_bert input_ids attn_mask = do
  attn_mask <- mask_for_input input_ids attn_mask S
  pos_ids <- position_ids input_ids
  keep <- bidirectional_mask_for_input input_ids S padding_mask=attn_mask
  tok_type_ids <- input_ids - input_ids
  tok <- NN.embedding@bert.embeddings.word_embeddings input_ids dim=MODEL_DIM
  typ <- NN.embedding@bert.embeddings.token_type_embeddings tok_type_ids dim=MODEL_DIM
  x <- tok + typ
  x <- NN.layernorm@bert.emb_ln x eps=EPS
  x <- for@bert.encoder.layers i <- [0..NUM_LAYERS) carry (x) do
    x <- nomic_bert_block x pos_ids keep
    yield x
  logits <- scope@cls.predictions do
    x <- NN.linear@transform.dense x dim=MODEL_DIM bias=false |> silu
    x <- NN.layernorm@transform.layer_norm x eps=EPS
    return NN.linear@decoder x dim=VOCAB_SIZE bias=false weight_path=@@bert.embeddings.word_embeddings.weight
  return logits
