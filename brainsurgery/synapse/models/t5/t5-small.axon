{-# CHECKPOINTS "google-t5/t5-small" #-}

{-# TASK "seq2seq_lm" #-}

{-# MAIN "t5" #-}

import Activations (relu)

import Attention (attention, merge_heads, reshape_heads)

import Masking (bidirectional_mask, causal_mask)

import Math (sqrt)

import Positions (relative_position_bias)

import Config

import NN

MODEL_DIM = 512

VOCAB_SIZE = 32128

L_ENC = 6

L_DEC_OVERRIDE = -1

L_DEC = (L_DEC_OVERRIDE > 0) ? L_DEC_OVERRIDE : L_ENC

NUM_HEADS = 8

FFN = 2048

EPS = 1e-06

NUM_BUCKETS = 32

MAX_DISTANCE = 128

LM_SCALE_DERIVED = 1.0 / sqrt MODEL_DIM

LM_SCALE_OVERRIDE = -1.0

LM_SCALE = (LM_SCALE_OVERRIDE > 0.0) ? LM_SCALE_OVERRIDE : LM_SCALE_DERIVED

t5_encoder_block :: Tensor[B,S,D] -> ?Tensor[B,S] -> Tensor[B,S,D]
t5_encoder_block x attention_mask = do
  self_attn <- scope@layer.0 do
    x_norm <- NN.rmsnorm@layer_norm x eps=EPS
    q <- NN.linear@SelfAttention.q x_norm dim=MODEL_DIM bias=false |> reshape_heads heads=NUM_HEADS
    k <- NN.linear@SelfAttention.k x_norm dim=MODEL_DIM bias=false |> reshape_heads heads=NUM_HEADS
    v <- NN.linear@SelfAttention.v x_norm dim=MODEL_DIM bias=false |> reshape_heads heads=NUM_HEADS
    rel_bias <- relative_position_bias@@encoder.block.0.layer.0.SelfAttention.relative_attention_bias q k num_buckets=NUM_BUCKETS max_distance=MAX_DISTANCE bidirectional=true
    keep <- bidirectional_mask q k padding_mask=attention_mask
    return attention q k v keep rel_bias=rel_bias scale=1.0 |> merge_heads |> NN.linear@SelfAttention.o dim=MODEL_DIM bias=false
  x <- x + self_attn
  ffn <- scope@layer.1 do
    x_norm <- NN.rmsnorm@layer_norm x eps=EPS
    x_ffn <- NN.linear@DenseReluDense.wi x_norm dim=FFN bias=false |> relu
    return NN.linear@DenseReluDense.wo x_ffn dim=MODEL_DIM bias=false
  y <- x + ffn
  return y

t5_decoder_block :: Tensor[B,SDEC,D] -> Tensor[B,SENC,D] -> ?Tensor[B,SENC] -> ?Tensor[B,SDEC] -> Tensor[B,SDEC,D]
t5_decoder_block x enc_hidden encoder_attention_mask decoder_attention_mask = do
  self_attn <- scope@layer.0 do
    x_norm <- NN.rmsnorm@layer_norm x eps=EPS
    q <- NN.linear@SelfAttention.q x_norm dim=MODEL_DIM bias=false |> reshape_heads heads=NUM_HEADS
    k <- NN.linear@SelfAttention.k x_norm dim=MODEL_DIM bias=false |> reshape_heads heads=NUM_HEADS
    v <- NN.linear@SelfAttention.v x_norm dim=MODEL_DIM bias=false |> reshape_heads heads=NUM_HEADS
    rel_bias <- relative_position_bias@@decoder.block.0.layer.0.SelfAttention.relative_attention_bias q k num_buckets=NUM_BUCKETS max_distance=MAX_DISTANCE bidirectional=false
    keep <- causal_mask q k window=1048576 padding_mask=decoder_attention_mask
    return attention q k v keep rel_bias=rel_bias scale=1.0 |> merge_heads |> NN.linear@SelfAttention.o dim=MODEL_DIM bias=false
  x <- x + self_attn
  cross_attn <- scope@layer.1 do
    x_norm <- NN.rmsnorm@layer_norm x eps=EPS
    q <- NN.linear@EncDecAttention.q x_norm dim=MODEL_DIM bias=false |> reshape_heads heads=NUM_HEADS
    k <- NN.linear@EncDecAttention.k enc_hidden dim=MODEL_DIM bias=false |> reshape_heads heads=NUM_HEADS
    v <- NN.linear@EncDecAttention.v enc_hidden dim=MODEL_DIM bias=false |> reshape_heads heads=NUM_HEADS
    keep <- bidirectional_mask q k padding_mask=encoder_attention_mask
    return attention q k v keep scale=1.0 |> merge_heads |> NN.linear@EncDecAttention.o dim=MODEL_DIM bias=false
  x <- x + cross_attn
  ffn <- scope@layer.2 do
    x_norm <- NN.rmsnorm@layer_norm x eps=EPS
    x_ffn <- NN.linear@DenseReluDense.wi x_norm dim=FFN bias=false |> relu
    return NN.linear@DenseReluDense.wo x_ffn dim=MODEL_DIM bias=false
  y <- x + ffn
  return y

t5 :: TokenIds[B,SENC] -> ?Tensor[B,SENC] -> TokenIds[B,SDEC] -> ?Tensor[B,SDEC] -> Tensor[B,SDEC,V]
t5 input_ids attention_mask decoder_input_ids decoder_attention_mask = do
  enc_hidden <- NN.embedding@shared input_ids dim=MODEL_DIM
  enc_hidden <- for@encoder.block i <- [0..L_ENC) carry (enc_hidden) do
    self_attn <- scope@layer.0 do
      x_norm <- NN.rmsnorm@layer_norm enc_hidden eps=EPS
      q <- NN.linear@SelfAttention.q x_norm dim=MODEL_DIM bias=false |> reshape_heads heads=NUM_HEADS
      k <- NN.linear@SelfAttention.k x_norm dim=MODEL_DIM bias=false |> reshape_heads heads=NUM_HEADS
      v <- NN.linear@SelfAttention.v x_norm dim=MODEL_DIM bias=false |> reshape_heads heads=NUM_HEADS
      rel_bias <- relative_position_bias@@encoder.block.0.layer.0.SelfAttention.relative_attention_bias q k num_buckets=NUM_BUCKETS max_distance=MAX_DISTANCE bidirectional=true
      keep <- bidirectional_mask q k padding_mask=attention_mask
      return attention q k v keep rel_bias=rel_bias scale=1.0 |> merge_heads |> NN.linear@SelfAttention.o dim=MODEL_DIM bias=false
    enc_hidden <- enc_hidden + self_attn
    ffn <- scope@layer.1 do
      x_norm <- NN.rmsnorm@layer_norm enc_hidden eps=EPS
      x_ffn <- NN.linear@DenseReluDense.wi x_norm dim=FFN bias=false |> relu
      return NN.linear@DenseReluDense.wo x_ffn dim=MODEL_DIM bias=false
    enc_hidden <- enc_hidden + ffn
    yield enc_hidden
  enc_hidden <- NN.rmsnorm@encoder.final_layer_norm enc_hidden eps=EPS
  dec_hidden <- NN.embedding@shared decoder_input_ids dim=MODEL_DIM
  dec_hidden <- for@decoder.block i <- [0..L_DEC) carry (dec_hidden) do
    self_attn <- scope@layer.0 do
      x_norm <- NN.rmsnorm@layer_norm dec_hidden eps=EPS
      q <- NN.linear@SelfAttention.q x_norm dim=MODEL_DIM bias=false |> reshape_heads heads=NUM_HEADS
      k <- NN.linear@SelfAttention.k x_norm dim=MODEL_DIM bias=false |> reshape_heads heads=NUM_HEADS
      v <- NN.linear@SelfAttention.v x_norm dim=MODEL_DIM bias=false |> reshape_heads heads=NUM_HEADS
      rel_bias <- relative_position_bias@@decoder.block.0.layer.0.SelfAttention.relative_attention_bias q k num_buckets=NUM_BUCKETS max_distance=MAX_DISTANCE bidirectional=false
      keep <- causal_mask q k window=1048576 padding_mask=decoder_attention_mask
      return attention q k v keep rel_bias=rel_bias scale=1.0 |> merge_heads |> NN.linear@SelfAttention.o dim=MODEL_DIM bias=false
    dec_hidden <- dec_hidden + self_attn
    cross_attn <- scope@layer.1 do
      x_norm <- NN.rmsnorm@layer_norm dec_hidden eps=EPS
      q <- NN.linear@EncDecAttention.q x_norm dim=MODEL_DIM bias=false |> reshape_heads heads=NUM_HEADS
      k <- NN.linear@EncDecAttention.k enc_hidden dim=MODEL_DIM bias=false |> reshape_heads heads=NUM_HEADS
      v <- NN.linear@EncDecAttention.v enc_hidden dim=MODEL_DIM bias=false |> reshape_heads heads=NUM_HEADS
      keep <- bidirectional_mask q k padding_mask=attention_mask
      return attention q k v keep scale=1.0 |> merge_heads |> NN.linear@EncDecAttention.o dim=MODEL_DIM bias=false
    dec_hidden <- dec_hidden + cross_attn
    ffn <- scope@layer.2 do
      x_norm <- NN.rmsnorm@layer_norm dec_hidden eps=EPS
      x_ffn <- NN.linear@DenseReluDense.wi x_norm dim=FFN bias=false |> relu
      return NN.linear@DenseReluDense.wo x_ffn dim=MODEL_DIM bias=false
    dec_hidden <- dec_hidden + ffn
    yield dec_hidden
  dec_hidden <- NN.rmsnorm@decoder.final_layer_norm dec_hidden eps=EPS
  dec_hidden <- dec_hidden * LM_SCALE
  logits <- NN.linear@shared dec_hidden dim=VOCAB_SIZE bias=false
  return logits
