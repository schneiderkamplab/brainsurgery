{-# CHECKPOINTS "google-t5/t5-large" #-}
{-# TASK "seq2seq_lm" #-}

import Activations
import Activations (relu)
import Attention
import Attention (attention, merge_heads, reshape_heads)
import Masking
import Masking (bidirectional_mask, causal_mask)
import Math
import Math (sqrt)
import Positions
import Positions (relative_position_bias)

t5_encoder_block :: Tensor[B,S,D] -> ?Tensor[B,S] -> Tensor[B,S,D]
t5_encoder_block x attention_mask = do
  self_attn <- scope@layer.0 do
    x_norm <- NN.rmsnorm@layer_norm x eps=1e-06
    q <- NN.linear@SelfAttention.q x_norm dim=1024 bias=false |> reshape_heads heads=16
    k <- NN.linear@SelfAttention.k x_norm dim=1024 bias=false |> reshape_heads heads=16
    v <- NN.linear@SelfAttention.v x_norm dim=1024 bias=false |> reshape_heads heads=16
    rel_bias <- relative_position_bias@@encoder.block.0.layer.0.SelfAttention.relative_attention_bias q k 32 128 true
    keep <- bidirectional_mask q k attention_mask
    return attention q k v keep rel_bias=rel_bias scale=1.0 |> merge_heads |> NN.linear@SelfAttention.o dim=1024 bias=false
  x <- x + self_attn
  ffn <- scope@layer.1 do
    x_norm <- NN.rmsnorm@layer_norm x eps=1e-06
    x_ffn <- NN.linear@DenseReluDense.wi x_norm dim=4096 bias=false |> relu
    return NN.linear@DenseReluDense.wo x_ffn dim=1024 bias=false
  y <- x + ffn
  return y

t5_decoder_block :: Tensor[B,SDEC,D] -> Tensor[B,SENC,D] -> ?Tensor[B,SENC] -> ?Tensor[B,SDEC] -> Tensor[B,SDEC,D]
t5_decoder_block x enc_hidden encoder_attention_mask decoder_attention_mask = do
  self_attn <- scope@layer.0 do
    x_norm <- NN.rmsnorm@layer_norm x eps=1e-06
    q <- NN.linear@SelfAttention.q x_norm dim=1024 bias=false |> reshape_heads heads=16
    k <- NN.linear@SelfAttention.k x_norm dim=1024 bias=false |> reshape_heads heads=16
    v <- NN.linear@SelfAttention.v x_norm dim=1024 bias=false |> reshape_heads heads=16
    rel_bias <- relative_position_bias@@decoder.block.0.layer.0.SelfAttention.relative_attention_bias q k 32 128 false
    keep <- causal_mask q k decoder_attention_mask
    return attention q k v keep rel_bias=rel_bias scale=1.0 |> merge_heads |> NN.linear@SelfAttention.o dim=1024 bias=false
  x <- x + self_attn
  cross_attn <- scope@layer.1 do
    x_norm <- NN.rmsnorm@layer_norm x eps=1e-06
    q <- NN.linear@EncDecAttention.q x_norm dim=1024 bias=false |> reshape_heads heads=16
    k <- NN.linear@EncDecAttention.k enc_hidden dim=1024 bias=false |> reshape_heads heads=16
    v <- NN.linear@EncDecAttention.v enc_hidden dim=1024 bias=false |> reshape_heads heads=16
    keep <- bidirectional_mask q k encoder_attention_mask
    return attention q k v keep scale=1.0 |> merge_heads |> NN.linear@EncDecAttention.o dim=1024 bias=false
  x <- x + cross_attn
  ffn <- scope@layer.2 do
    x_norm <- NN.rmsnorm@layer_norm x eps=1e-06
    x_ffn <- NN.linear@DenseReluDense.wi x_norm dim=4096 bias=false |> relu
    return NN.linear@DenseReluDense.wo x_ffn dim=1024 bias=false
  y <- x + ffn
  return y

t5 :: TokenIds[B,SENC] -> ?Tensor[B,SENC] -> TokenIds[B,SDEC] -> ?Tensor[B,SDEC] -> Tensor[B,SDEC,V]
t5 input_ids attention_mask decoder_input_ids decoder_attention_mask = do
  enc_hidden <- NN.embedding@shared input_ids dim=1024
  for@encoder.block i <- [0..24) do
    self_attn <- scope@layer.0 do
      x_norm <- NN.rmsnorm@layer_norm enc_hidden eps=1e-06
      q <- NN.linear@SelfAttention.q x_norm dim=1024 bias=false |> reshape_heads heads=16
      k <- NN.linear@SelfAttention.k x_norm dim=1024 bias=false |> reshape_heads heads=16
      v <- NN.linear@SelfAttention.v x_norm dim=1024 bias=false |> reshape_heads heads=16
      rel_bias <- relative_position_bias@@encoder.block.0.layer.0.SelfAttention.relative_attention_bias q k 32 128 true
      keep <- bidirectional_mask q k attention_mask
      return attention q k v keep rel_bias=rel_bias scale=1.0 |> merge_heads |> NN.linear@SelfAttention.o dim=1024 bias=false
    enc_hidden <- enc_hidden + self_attn
    ffn <- scope@layer.1 do
      x_norm <- NN.rmsnorm@layer_norm enc_hidden eps=1e-06
      x_ffn <- NN.linear@DenseReluDense.wi x_norm dim=4096 bias=false |> relu
      return NN.linear@DenseReluDense.wo x_ffn dim=1024 bias=false
    enc_hidden <- enc_hidden + ffn
    yield enc_hidden
  enc_hidden <- NN.rmsnorm@encoder.final_layer_norm enc_hidden eps=1e-06
  dec_hidden <- NN.embedding@shared decoder_input_ids dim=1024
  for@decoder.block i <- [0..24) do
    self_attn <- scope@layer.0 do
      x_norm <- NN.rmsnorm@layer_norm dec_hidden eps=1e-06
      q <- NN.linear@SelfAttention.q x_norm dim=1024 bias=false |> reshape_heads heads=16
      k <- NN.linear@SelfAttention.k x_norm dim=1024 bias=false |> reshape_heads heads=16
      v <- NN.linear@SelfAttention.v x_norm dim=1024 bias=false |> reshape_heads heads=16
      rel_bias <- relative_position_bias@@decoder.block.0.layer.0.SelfAttention.relative_attention_bias q k 32 128 false
      keep <- causal_mask q k decoder_attention_mask
      return attention q k v keep rel_bias=rel_bias scale=1.0 |> merge_heads |> NN.linear@SelfAttention.o dim=1024 bias=false
    dec_hidden <- dec_hidden + self_attn
    cross_attn <- scope@layer.1 do
      x_norm <- NN.rmsnorm@layer_norm dec_hidden eps=1e-06
      q <- NN.linear@EncDecAttention.q x_norm dim=1024 bias=false |> reshape_heads heads=16
      k <- NN.linear@EncDecAttention.k enc_hidden dim=1024 bias=false |> reshape_heads heads=16
      v <- NN.linear@EncDecAttention.v enc_hidden dim=1024 bias=false |> reshape_heads heads=16
      keep <- bidirectional_mask q k attention_mask
      return attention q k v keep scale=1.0 |> merge_heads |> NN.linear@EncDecAttention.o dim=1024 bias=false
    dec_hidden <- dec_hidden + cross_attn
    ffn <- scope@layer.2 do
      x_norm <- NN.rmsnorm@layer_norm dec_hidden eps=1e-06
      x_ffn <- NN.linear@DenseReluDense.wi x_norm dim=4096 bias=false |> relu
      return NN.linear@DenseReluDense.wo x_ffn dim=1024 bias=false
    dec_hidden <- dec_hidden + ffn
    yield dec_hidden
  dec_hidden <- NN.rmsnorm@decoder.final_layer_norm dec_hidden eps=1e-06
  dec_hidden <- dec_hidden * 0.03125
  logits <- NN.linear@shared dec_hidden dim=32128 bias=false
  return logits
