{-# CHECKPOINTS ["EleutherAI/gpt-neox-20b", "EleutherAI/pythia-6.9b", "EleutherAI/pythia-12b"] #-}
{-# TASK "causal_lm" #-}
import Activations (gelu, gelu_new)
import Attention (attention, merge_heads, split_qkv_heads)
import Masking (causal_mask)
import Positions (position_ids, rope_pair_base)
import Cache
import Config
import NN



MODEL_DIM = Config.int@hidden_size default=6144
VOCAB_SIZE = Config.int@vocab_size default=50432
NUM_LAYERS = Config.int@num_hidden_layers default=44
NUM_HEADS = Config.int@num_attention_heads default=64
MODEL_HEAD_DIM = MODEL_DIM / NUM_HEADS
FFN = Config.int@intermediate_size default=24576
EPS = Config.float@layer_norm_eps default=1e-05
THETA = Config.float@rope_theta default=10000.0
ROTARY_PCT = Config.float@rotary_pct default=0.25
MAX_POSITIONS = Config.int@max_position_embeddings default=2048
PAR = Config.bool@use_parallel_residual default=true
ACT = Config.str@hidden_act default="gelu"

neox_ln :: Path -> Tensor[B,S,D] -> Tensor[B,S,D]
neox_ln@path x = NN.layernorm@path x eps=EPS

gpt_neox_block :: Tensor[B,S,D] -> Tensor[B,S] -> ?Tensor[B,S] -> ?CacheLayer -> (Tensor[B,S,D], ?CacheLayer)
gpt_neox_block x pos_ids attn_mask past_kv = do
  xn <- neox_ln@input_layernorm x
  a, new_kv <- scope@attention do
    qkv <- NN.linear@query_key_value xn dim=(3 * MODEL_DIM) bias=true
    q, k, v <- split_qkv_heads qkv heads=NUM_HEADS layout="interleaved"
    q, k <- rope_pair_base q k pos_ids theta=THETA partial_rotary_factor=ROTARY_PCT
    k, v, new_kv <- Cache.update past_kv k v
    mask <- causal_mask q k window=MAX_POSITIONS padding_mask=attn_mask
    a <- attention q k v mask |> merge_heads |> NN.linear@dense dim=MODEL_DIM bias=true
    return a, new_kv
  x_attn <- x + a
  xn2 <- neox_ln@post_attention_layernorm (PAR ? x : x_attn)
  m <- scope@mlp do
    h <- NN.linear@dense_h_to_4h xn2 dim=FFN bias=true
    h_act <- (ACT == "gelu_fast") ? (gelu_new h) : (gelu h)
    return h_act |> NN.linear@dense_4h_to_h dim=MODEL_DIM bias=true
  x <- PAR ? (x + a + m) : (x_attn + m)
  return x, new_kv

gpt_neox :: TokenIds[B,S] -> ?Tensor[B,S] -> ?Cache -> ?Bool -> (Tensor[B,S,V], ?Cache)
gpt_neox input_ids attn_mask past_kv use_cache = do
  pos_ids <- position_ids input_ids past_length=(Cache.past_length past_kv)
  x, new_kv <- scope@gpt_neox do
    x <- NN.embedding@embed_in input_ids dim=MODEL_DIM
    new_kv <- use_cache ? Cache.init : null
    x, new_kv <- for@layers i <- [0..NUM_LAYERS) carry (x, new_kv) do
      past_i <- Cache.index past_kv i
      x, new_i <- gpt_neox_block x pos_ids attn_mask past_i
      new_kv <- Cache.append new_kv new_i
      yield x, new_kv
    x <- neox_ln@final_layer_norm x
    return x, new_kv
  logits <- NN.linear@embed_out x dim=VOCAB_SIZE bias=false
  return logits, new_kv
