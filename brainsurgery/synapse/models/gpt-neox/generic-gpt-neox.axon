{-# CHECKPOINTS ["EleutherAI/gpt-neox-20b", "EleutherAI/pythia-6.9b", "EleutherAI/pythia-12b"] #-}
{-# TASK "causal_lm" #-}
import Config
import Activations (gelu, gelu_fast)
import Cache past_length
import Cache

D = Config.int "hidden_size" default=6144
V = Config.int "vocab_size" default=50432
L = Config.int "num_hidden_layers" default=44
H = Config.int "num_attention_heads" default=64
HD = D / H
FFN = Config.int "intermediate_size" default=24576
EPS = Config.float "layer_norm_eps" default=1e-05
THETA = Config.float "rope_theta" default=10000.0
ROTARY_PCT = Config.float "rotary_pct" default=0.25
C = Config.int "max_position_embeddings" default=2048
PAR = Config.value "use_parallel_residual" default=true
ACT = Config.value "hidden_act" default="gelu"

neox_ln :: @Path -> Tensor[B,S,D] -> Tensor[B,S,D]
neox_ln@path x = layernorm@path x eps=EPS

gpt_neox_block :: Tensor[B,S,D] -> Tensor[B,S] -> ?Tensor[B,S] -> ?CacheLayer -> (Tensor[B,S,D], ?CacheLayer)
gpt_neox_block x pos_ids attn_mask past_kv = do
  xn <- neox_ln@input_layernorm x
  a, new_kv <- scope@attention do
    qkv <- linear@query_key_value xn dim=(3 * D) bias=true
    q, k, v <- split_qkv_heads qkv heads=H layout=interleaved
    q, k <- rope_pair q k position_ids=pos_ids theta=THETA partial_rotary_factor=ROTARY_PCT
    k, v, new_kv <- Cache.update past_kv k v
    mask <- causal_mask q k window=C padding_mask=attn_mask
    a <- attention q k v mask=mask |> merge_heads |> linear@dense dim=D bias=true
    return a, new_kv
  x_attn <- x + a
  xn2 <- neox_ln@post_attention_layernorm (PAR ? x : x_attn)
  m <- scope@mlp do
    h <- linear@dense_h_to_4h xn2 dim=FFN bias=true
    h_act <- (ACT == "gelu_fast") ? (gelu_fast h) : (gelu h)
    return h_act |> linear@dense_4h_to_h dim=D bias=true
  x <- PAR ? (x + a + m) : (x_attn + m)
  return x, new_kv

gpt_neox :: TokenIds[B,S] -> ?Tensor[B,S] -> ?Cache -> ?Bool -> (Tensor[B,S,V], ?Cache)
gpt_neox input_ids attn_mask past_kv use_cache = do
  pos_ids <- position_ids input_ids null past_length=(past_length past_kv)
  x, new_kv <- scope@gpt_neox do
    x <- embedding@embed_in input_ids dim=D
    new_kv <- use_cache ? Cache.init : null
    for@layers i <- [0..L) do
      past_i <- Cache.index past_kv i
      x, new_i <- gpt_neox_block x pos_ids attn_mask past_i
      new_kv <- Cache.append new_kv new_i
    x <- neox_ln@final_layer_norm x
    return x, new_kv
  logits <- linear@embed_out x dim=V bias=false
  return logits, new_kv
