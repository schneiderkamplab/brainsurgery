{-# CHECKPOINTS "EleutherAI/pythia-12b" #-}
{-# TASK "causal_lm" #-}

import Activations
import Activations (gelu)
import Cache
import Cache (past_length)

D = 5120
V = 50688
L = 36
H = 40
FFN = 20480
EPS = 1e-05
THETA = 10000.0
ROTARY_PCT = 0.25
C = 2048
PAR = true

neox_ln :: @Path -> Tensor[B,S,D] -> Tensor[B,S,D]
neox_ln@path x = layernorm@path x eps=EPS

gpt_neox_block :: Tensor[B,S,D] -> Tensor[B,S] -> ?Tensor[B,S] -> ?CacheLayer -> (Tensor[B,S,D], ?CacheLayer)
gpt_neox_block x pos_ids attn_mask past_kv = do
  xn <- neox_ln@input_layernorm x
  a, new_kv <- scope@attention do
    qkv <- linear@query_key_value xn dim=(3 * D) bias=true
    q, k, v <- split_qkv_heads qkv heads=H layout=interleaved
    q, k <- rope_pair q k position_ids=pos_ids theta=THETA partial_rotary_factor=ROTARY_PCT
    k, v, new_kv <- Cache.update past_kv k v
    mask <- causal_mask q k window=C padding_mask=attn_mask
    a <- attention q k v mask=mask |> merge_heads |> linear@dense dim=D bias=true
    return a, new_kv
  x_attn <- x + a
  xn2 <- neox_ln@post_attention_layernorm (PAR ? x : x_attn)
  m <- scope@mlp do
    h <- linear@dense_h_to_4h xn2 dim=FFN bias=true
    return gelu h |> linear@dense_4h_to_h dim=D bias=true
  x <- PAR ? (x + a + m) : (x_attn + m)
  return x, new_kv

gpt_neox :: TokenIds[B,S] -> ?Tensor[B,S] -> ?Cache -> ?Bool -> (Tensor[B,S,V], ?Cache)
gpt_neox input_ids attn_mask past_kv use_cache = do
  pos_ids <- position_ids input_ids past_length=(past_length past_kv)
  x, new_kv <- scope@gpt_neox do
    x <- embedding@embed_in input_ids dim=D
    new_kv <- use_cache ? Cache.init : null
    for@layers i <- [0..L) do
      past_i <- Cache.index past_kv i
      x, new_i <- gpt_neox_block x pos_ids attn_mask past_i
      new_kv <- Cache.append new_kv new_i
    x <- neox_ln@final_layer_norm x
    return x, new_kv
  logits <- linear@embed_out x dim=V bias=false
  return logits, new_kv
