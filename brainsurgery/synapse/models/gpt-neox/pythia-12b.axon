{-# CHECKPOINTS "EleutherAI/pythia-12b" #-}
{-# TASK "causal_lm" #-}

import Activations
import Activations (gelu)
import Attention
import Attention (attention, merge_heads, split_qkv_heads)
import Masking
import Masking (causal_mask)
import Positions
import Positions (position_ids, rope_pair_base)
import Cache
import NN

neox_ln :: Path -> Tensor[B,S,D] -> Tensor[B,S,D]
neox_ln@path x = NN.layernorm@path x eps=1e-05

gpt_neox_block :: Tensor[B,S,D] -> Tensor[B,S] -> ?Tensor[B,S] -> ?CacheLayer -> (Tensor[B,S,D], ?CacheLayer)
gpt_neox_block x pos_ids attn_mask past_kv = do
  xn <- neox_ln@input_layernorm x
  a, new_kv <- scope@attention do
    qkv <- NN.linear@query_key_value xn dim=15360 bias=true
    q, k, v <- split_qkv_heads qkv heads=40 layout="interleaved"
    q, k <- rope_pair_base q k pos_ids theta=10000.0 partial_rotary_factor=0.25
    k, v, new_kv <- Cache.update past_kv k v
    mask <- causal_mask q k window=2048 padding_mask=attn_mask
    a <- attention q k v mask |> merge_heads |> NN.linear@dense dim=5120 bias=true
    return a, new_kv
  x_attn <- x + a
  xn2 <- neox_ln@post_attention_layernorm (x)
  m <- scope@mlp do
    h <- NN.linear@dense_h_to_4h xn2 dim=20480 bias=true
    h_act <- (gelu h)
    return h_act |> NN.linear@dense_4h_to_h dim=5120 bias=true
  x <- (x + a + m)
  return x, new_kv

gpt_neox :: TokenIds[B,S] -> ?Tensor[B,S] -> ?Cache -> ?Bool -> (Tensor[B,S,V], ?Cache)
gpt_neox input_ids attn_mask past_kv use_cache = do
  pos_ids <- position_ids input_ids past_length=(Cache.past_length past_kv)
  x, new_kv <- scope@gpt_neox do
    x <- NN.embedding@embed_in input_ids dim=5120
    new_kv <- use_cache ? Cache.init : null
    for@layers i <- [0..36) do
      past_i <- Cache.index past_kv i
      x, new_i <- gpt_neox_block x pos_ids attn_mask past_i
      new_kv <- Cache.append new_kv new_i
      yield x, new_kv
    x <- neox_ln@final_layer_norm x
    return x, new_kv
  logits <- NN.linear@embed_out x dim=50688 bias=false
  return logits, new_kv
