{-# CHECKPOINTS ["Qwen/Qwen3-30B-A3B"] #-}
{-# TASK "causal_lm" #-}

import Config
import Activations silu
import Cache past_length
import Cache
import MoE

D    = Config.int "hidden_size" default=2048
V    = Config.int "vocab_size" default=151936
L    = Config.int "num_hidden_layers" default=48
H    = Config.int "num_attention_heads" default=32
KVH  = Config.int "num_key_value_heads" default=4
HD   = Config.int "head_dim" default=128
KVD  = KVH * HD
QD   = H * HD
FFN  = Config.int "intermediate_size" default=6144
ME   = Config.int "num_experts" default=128
MK   = Config.int "num_experts_per_tok" default=8
MFFN = Config.int "moe_intermediate_size" default=768
SPARSE_STEP = Config.int "decoder_sparse_step" default=1
EPS  = Config.float "rms_norm_eps" default=1e-06
THETA = Config.float "rope_theta" default=1000000.0
C    = Config.int "max_position_embeddings" default=40960
TIE  = Config.value "tie_word_embeddings" default=false

rms :: @Path -> Tensor[B,S,D] -> Tensor[B,S,D]
rms@path x = rmsnorm@path x eps=EPS cast_float=true

head_rms :: @Path -> Tensor[B,H,S,HD] -> Tensor[B,H,S,HD]
head_rms@path x = rmsnorm@path x eps=EPS cast_float=true

output_tied :: Tensor[B,S,D] -> Tensor[B,S,V]
output_tied x = do
  logits <- scope@model do
    return linear@embed_tokens x dim=V
  return logits

output_untied :: Tensor[B,S,D] -> Tensor[B,S,V]
output_untied x = linear@lm_head x dim=V

dense_ffn :: Tensor[B,S,D] -> Tensor[B,S,D]
dense_ffn x = do
  g <- linear@gate_proj x dim=FFN
  u <- linear@up_proj x dim=FFN
  return g |> silu |> mul u |> linear@down_proj dim=D

sparse_ffn :: Tensor[B,S,D] -> Tensor[B,S,D]
sparse_ffn x = do
  scores, indices <- softmax_topk_router@gate x top_k=MK norm_topk_prob=true
  out <- x * 0.0
  for@experts e <- [0..ME) do
    x_sel, token_idx, topk_pos, sel_scores <- MoE.select x scores indices e
    x_upd <- qwen3_moe_expert_ffn x_sel
    out <- MoE.scatter_add out token_idx x_upd sel_scores
  return out

qwen3_moe_expert_ffn :: Tensor[N,D] -> Tensor[N,D]
qwen3_moe_expert_ffn x = do
  g <- linear@gate_proj x dim=MFFN
  u <- linear@up_proj x dim=MFFN
  return g |> silu |> mul u |> linear@down_proj dim=D bias=false

qwen3_moe_block :: Tensor[B,S,D] -> Tensor[B,S] -> ?Tensor[B,S] -> ?CacheLayer -> Int -> (Tensor[B,S,D], ?CacheLayer)
qwen3_moe_block x pos_ids attn_mask past_kv layer_idx = do
  xn <- rms@input_layernorm x
  a, new_kv <- scope@self_attn do
    q <- linear@q_proj xn dim=QD bias=false |> reshape_heads heads=H |> head_rms@q_norm
    k <- linear@k_proj xn dim=KVD bias=false |> reshape_heads heads=KVH |> head_rms@k_norm
    v <- linear@v_proj xn dim=KVD bias=false |> reshape_heads heads=KVH
    q, k <- rope_pair q k position_ids=pos_ids theta=THETA
    k, v, new_kv <- Cache.update past_kv k v
    k <- repeat k repeats=(H / KVH)
    v <- repeat v repeats=(H / KVH)
    mask <- causal_mask q k window=C padding_mask=attn_mask
    a <- attention q k v mask=mask |> merge_heads |> linear@o_proj dim=D bias=false
    return a, new_kv
  x <- x + a
  xn <- rms@post_attention_layernorm x
  m <- scope@mlp do
    return (((layer_idx + 1) % SPARSE_STEP) == 0) ? sparse_ffn xn : dense_ffn xn
  return x + m, new_kv

qwen3_moe :: TokenIds[B,S] -> ?Tensor[B,S] -> ?Cache -> ?Bool -> (Tensor[B,S,V], ?Cache)
qwen3_moe input_ids attn_mask past_kv use_cache = do
  pos_ids <- position_ids input_ids attn_mask=attn_mask past_length=(past_length past_kv)
  x, new_kv <- scope@model do
    x <- embedding@embed_tokens input_ids dim=D
    new_kv <- use_cache ? Cache.init : null
    for@layers i <- [0..L) do
      past_i <- Cache.index past_kv i
      x, new_i <- qwen3_moe_block x pos_ids attn_mask past_i i
      new_kv <- Cache.append new_kv new_i
    x <- rms@norm x
    return x, new_kv
  logits <- TIE ? output_tied x : output_untied x
  return logits, new_kv
