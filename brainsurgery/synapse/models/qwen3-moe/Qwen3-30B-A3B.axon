{-# CHECKPOINTS "Qwen/Qwen3-30B-A3B" #-}

{-# TASK "causal_lm" #-}

{-# MAIN "qwen3_moe" #-}

import Activations (silu)

import Attention (attention, merge_heads, reshape_heads)

import Masking (causal_mask)

import Math (mul)

import MoE (scatter_add, select, softmax_topk_router)

import Positions (position_ids, rope_pair_base)

import Cache

import Config

import NN

import Tensor

MODEL_DIM = 2048

VOCAB_SIZE = 151936

NUM_LAYERS = 48

NUM_HEADS = 32

KVH = 4

MODEL_HEAD_DIM = 128

KVD = KVH * MODEL_HEAD_DIM

QD = NUM_HEADS * MODEL_HEAD_DIM

FFN = 6144

ME = 128

MK = 8

MFFN = 768

SPARSE_STEP = 1

EPS = 1e-06

THETA = 1000000.0

MAX_POSITIONS = 40960

TIE = false

rms :: Path -> Tensor[B,S,D] -> Tensor[B,S,D]
rms@path x = NN.rmsnorm@path x eps=EPS cast_float=true

head_rms :: Path -> Tensor[B,H,S,HD] -> Tensor[B,H,S,HD]
head_rms@path x = NN.rmsnorm@path x eps=EPS cast_float=true

output_tied :: Tensor[B,S,D] -> Tensor[B,S,V]
output_tied x = do
  logits <- scope@model do
    return NN.linear@embed_tokens x dim=VOCAB_SIZE
  return logits

output_untied :: Tensor[B,S,D] -> Tensor[B,S,V]
output_untied x = NN.linear@lm_head x dim=VOCAB_SIZE

dense_ffn :: Tensor[B,S,D] -> Tensor[B,S,D]
dense_ffn x = do
  g <- NN.linear@gate_proj x dim=FFN
  u <- NN.linear@up_proj x dim=FFN
  return g |> silu |> mul u |> NN.linear@down_proj dim=MODEL_DIM

sparse_ffn :: Tensor[B,S,D] -> Tensor[B,S,D]
sparse_ffn x = do
  scores, indices <- softmax_topk_router@gate x top_k=MK
  out <- x * 0.0
  out <- for@experts e <- [0..ME) carry (out) do
    x_sel, token_idx, topk_pos, sel_scores <- select x scores indices e
    x_upd <- qwen3_moe_expert_ffn x_sel
    out <- scatter_add out token_idx x_upd sel_scores
    yield out
  return out

qwen3_moe_expert_ffn :: Tensor[N,D] -> Tensor[N,D]
qwen3_moe_expert_ffn x = do
  g <- NN.linear@gate_proj x dim=MFFN
  u <- NN.linear@up_proj x dim=MFFN
  return g |> silu |> mul u |> NN.linear@down_proj dim=MODEL_DIM bias=false

qwen3_moe_block :: Tensor[B,S,D] -> Tensor[B,S] -> ?Tensor[B,K] -> ?CacheLayer[B,KVH,P,DH] -> Int -> (Tensor[B,S,D], ?CacheLayer[B,KVH,K,DH])
qwen3_moe_block x pos_ids attn_mask past_kv layer_idx = do
  xn <- rms@input_layernorm x
  a, new_kv <- scope@self_attn do
    q <- NN.linear@q_proj xn dim=QD bias=false |> reshape_heads heads=NUM_HEADS |> head_rms@q_norm
    k <- NN.linear@k_proj xn dim=KVD bias=false |> reshape_heads heads=KVH |> head_rms@k_norm
    v <- NN.linear@v_proj xn dim=KVD bias=false |> reshape_heads heads=KVH
    q, k <- rope_pair_base q k pos_ids THETA
    k, v, new_kv <- Cache.update past_kv k v
    k <- Tensor.repeat k repeats=(NUM_HEADS / KVH)
    v <- Tensor.repeat v repeats=(NUM_HEADS / KVH)
    mask <- causal_mask q k window=MAX_POSITIONS padding_mask=attn_mask
    a <- attention q k v mask |> merge_heads |> NN.linear@o_proj dim=MODEL_DIM bias=false
    return a, new_kv
  x <- x + a
  xn <- rms@post_attention_layernorm x
  m <- scope@mlp do
    return (((layer_idx + 1) % SPARSE_STEP) == 0) ? sparse_ffn xn : dense_ffn xn
  return x + m, new_kv

qwen3_moe :: TokenIds[B,S] -> ?Tensor[B,K] -> ?Cache[B,KVH,P,DH] -> ?Bool -> (Tensor[B,S,V], ?Cache[B,KVH,K,DH])
qwen3_moe input_ids attn_mask past_kv use_cache = do
  pos_ids <- position_ids input_ids attn_mask=attn_mask past_length=(Cache.past_length past_kv)
  x, new_kv <- scope@model do
    x <- NN.embedding@embed_tokens input_ids dim=MODEL_DIM
    new_kv <- use_cache ? Cache.init : null
    x, new_kv <- for@layers i <- [0..NUM_LAYERS) carry (x, new_kv) do
      past_i <- Cache.index past_kv i
      x, new_i <- qwen3_moe_block x pos_ids attn_mask past_i i
      new_kv <- Cache.append new_kv new_i
      yield x, new_kv
    x <- rms@norm x
    return x, new_kv
  logits <- TIE ? output_tied x : output_untied x
  return logits, new_kv
