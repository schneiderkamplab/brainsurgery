{-# CHECKPOINTS "test/DeepSeek-V3-Test" #-}

{-# TASK "causal_lm" #-}

{-# MAIN "deepseek_v3" #-}

import Activations (silu)

import Attention (attention, merge_heads, reshape_heads)

import Masking (Mask, causal_mask_for_input, mask_for_input, mask_length_for_input)

import Math (log, mul, sqrt)

import MoE (grouped_sigmoid_router, grouped_swiglu_ffn_basic)

import Positions (position_ids, rope_base_factors, rope_pair_base_split_interleaved_factors, rope_pair_yarn_split_interleaved_factors, rope_yarn_factors_for_position_ids)

import Cache

import Config

import NN

import Tensor

MODEL_DIM = 128

VOCAB_SIZE = 128815

NUM_LAYERS = 4

NUM_HEADS = 4

QKNOPE = 24

QKROPE = 8

VHD = 32

QHD = QKNOPE + QKROPE

QLR = 32

KVR = 32

KVPROJ = NUM_HEADS * (QKNOPE + VHD)

FFN = 256

E = 4

EPT = 2

EM = 64

SE = 1

NG = 2

TKG = 1

NTP = true

RSC = 2.5

EPS = 1e-06

THETA = 10000.0

MAX_POSITIONS = 512

FIRST_DENSE = 2

HAS_ROPE_SCALING = (false) or (true)

ROPE_SCALE = 40.0

ROPE_BETA_FAST = 32.0

ROPE_BETA_SLOW = 1.0

ROPE_MSCALE = 1.0

ROPE_MSCALE_ALL_DIM = 1.0

ROPE_CONTEXT = 256

ROPE_SOFTMAX_MSCALE = (HAS_ROPE_SCALING and (ROPE_MSCALE_ALL_DIM != 0.0)) ? ((0.1 * ROPE_MSCALE_ALL_DIM * log ROPE_SCALE) + 1.0) : 1.0

ATTN_SCALE = (1.0 / sqrt QHD) * ROPE_SOFTMAX_MSCALE * ROPE_SOFTMAX_MSCALE

rms :: Path -> Tensor[B,S,D] -> Tensor[B,S,D]
rms@path x = NN.rmsnorm@path x eps=EPS cast_float=true

deepseek_v3_attn :: Tensor[B,S,D] -> Tensor[B,1,S,K] -> Tensor[B,1,S,QKROPE] -> Tensor[B,1,S,QKROPE] -> Tensor[B,1,S,QKROPE] -> Tensor[B,1,S,QKROPE] -> ?CacheLayerKV[B,NUM_HEADS,P,MAX_POSITIONS,QHD,VHD] -> (Tensor[B,S,D], ?CacheLayerKV[B,NUM_HEADS,K,MAX_POSITIONS,QHD,VHD])
deepseek_v3_attn x mask base_sin base_cos yarn_sin yarn_cos past_kv = do
  a, new_kv <- scope@self_attn do
    q <- NN.linear@q_a_proj x dim=QLR bias=false |> rms@q_a_layernorm |> NN.linear@q_b_proj dim=(NUM_HEADS * QHD) bias=false |> reshape_heads heads=NUM_HEADS
    q_nope, q_pe <- Tensor.split q sizes=[QKNOPE, QKROPE]
    kv_comp <- NN.linear@kv_a_proj_with_mqa x dim=(KVR + QKROPE) bias=false
    kv_latent, k_pe_base <- Tensor.split kv_comp sizes=[KVR, QKROPE]
    kv_latent <- rms@kv_a_layernorm kv_latent
    kv <- NN.linear@kv_b_proj kv_latent dim=KVPROJ bias=false |> reshape_heads heads=NUM_HEADS
    k_nope, v <- Tensor.split kv sizes=[QKNOPE, VHD]
    k_pe <- reshape_heads k_pe_base heads=1 |> Tensor.repeat repeats=NUM_HEADS
    q_pe, k_pe <- HAS_ROPE_SCALING ? (rope_pair_yarn_split_interleaved_factors q_pe k_pe yarn_sin yarn_cos) : (rope_pair_base_split_interleaved_factors q_pe k_pe base_sin base_cos)
    q_full <- Tensor.concat q_nope q_pe dim=-1
    k_full <- Tensor.concat k_nope k_pe dim=-1
    k_all, v_all, new_kv <- Cache.update_kv past_kv k_full v
    a <- attention q_full k_all v_all mask scale=ATTN_SCALE |> merge_heads
    a <- NN.linear@o_proj a dim=MODEL_DIM bias=false
    return a, new_kv
  return a, new_kv

deepseek_v3_dense_block :: Tensor[B,S,D] -> Tensor[B,1,S,K] -> Tensor[B,1,S,QKROPE] -> Tensor[B,1,S,QKROPE] -> Tensor[B,1,S,QKROPE] -> Tensor[B,1,S,QKROPE] -> ?CacheLayerKV[B,NUM_HEADS,P,MAX_POSITIONS,QHD,VHD] -> (Tensor[B,S,D], ?CacheLayerKV[B,NUM_HEADS,K,MAX_POSITIONS,QHD,VHD])
deepseek_v3_dense_block x mask base_sin base_cos yarn_sin yarn_cos past_kv = do
  xn <- rms@input_layernorm x
  a, new_kv <- deepseek_v3_attn xn mask base_sin base_cos yarn_sin yarn_cos past_kv
  x <- x + a
  xn <- rms@post_attention_layernorm x
  m <- scope@mlp do
    gate <- NN.linear@gate_proj xn dim=FFN bias=false
    up <- NN.linear@up_proj xn dim=FFN bias=false
    return gate |> silu |> mul up |> NN.linear@down_proj dim=MODEL_DIM bias=false
  return x + m, new_kv

deepseek_v3_moe_block :: Tensor[B,S,D] -> Tensor[B,1,S,K] -> Tensor[B,1,S,QKROPE] -> Tensor[B,1,S,QKROPE] -> Tensor[B,1,S,QKROPE] -> Tensor[B,1,S,QKROPE] -> ?CacheLayerKV[B,NUM_HEADS,P,MAX_POSITIONS,QHD,VHD] -> (Tensor[B,S,D], ?CacheLayerKV[B,NUM_HEADS,K,MAX_POSITIONS,QHD,VHD])
deepseek_v3_moe_block x mask base_sin base_cos yarn_sin yarn_cos past_kv = do
  xn <- rms@input_layernorm x
  a, new_kv <- deepseek_v3_attn xn mask base_sin base_cos yarn_sin yarn_cos past_kv
  x <- x + a
  xn <- rms@post_attention_layernorm x
  m <- scope@mlp do
    shared <- scope@shared_experts do
      gate <- NN.linear@gate_proj xn dim=(EM * SE) bias=false
      up <- NN.linear@up_proj xn dim=(EM * SE) bias=false
      return gate |> silu |> mul up |> NN.linear@down_proj dim=MODEL_DIM bias=false
    topk_scores, topk_indices <- grouped_sigmoid_router@gate xn E EPT n_group=NG topk_group=TKG norm_topk_prob=(NTP == true) routed_scaling_factor=RSC
    routed <- grouped_swiglu_ffn_basic xn topk_scores topk_indices E gate_up_weight=@experts.gate_up_proj.weight out_weight=@experts.down_proj.weight
    return shared + routed
  return x + m, new_kv

deepseek_v3 :: TokenIds[B,S] -> ?Mask[B,K,MAX_POSITIONS] -> ?CacheKV[B,NUM_HEADS,P,MAX_POSITIONS,QHD,VHD] -> ?Bool -> (Tensor[B,S,VOCAB_SIZE], ?CacheKV[B,NUM_HEADS,K,MAX_POSITIONS,QHD,VHD])
deepseek_v3 input_ids attn_mask past_kv use_cache = do
  past_length <- Cache.past_length_kv past_kv
  attn_mask <- mask_for_input input_ids attn_mask MAX_POSITIONS
  pos_ids <- position_ids input_ids attn_mask=attn_mask past_length=past_length
  key_len <- mask_length_for_input input_ids attn_mask past_length
  mask <- causal_mask_for_input input_ids key_len padding_mask=attn_mask window=MAX_POSITIONS
  base_sin, base_cos <- rope_base_factors pos_ids QKROPE theta=THETA interleaved=false
  yarn_sin, yarn_cos <- rope_yarn_factors_for_position_ids pos_ids QKROPE THETA ROPE_SCALE ROPE_BETA_FAST ROPE_BETA_SLOW ROPE_CONTEXT mscale=ROPE_MSCALE mscale_all_dim=ROPE_MSCALE_ALL_DIM interleaved=false
  work_kv <- Cache.prepare_kv past_kv use_cache MAX_POSITIONS
  read_kv <- Cache.read_kv past_kv work_kv
  x, new_kv <- scope@model do
    x <- NN.embedding@embed_tokens input_ids dim=MODEL_DIM
    x, work_kv <- for@layers i <- [0..FIRST_DENSE) carry (x, work_kv) do
      past_i <- Cache.index_kv read_kv i
      x, new_i <- deepseek_v3_dense_block x mask base_sin base_cos yarn_sin yarn_cos past_i
      work_kv <- Cache.append_kv work_kv new_i
      yield x, work_kv
    x, work_kv <- for@layers i <- [FIRST_DENSE..NUM_LAYERS) carry (x, work_kv) do
      past_i <- Cache.index_kv read_kv i
      x, new_i <- deepseek_v3_moe_block x mask base_sin base_cos yarn_sin yarn_cos past_i
      work_kv <- Cache.append_kv work_kv new_i
      yield x, work_kv
    x <- rms@norm x
    return x, work_kv
  new_length <- past_length + S
  new_kv <- Cache.finish_kv new_kv new_length
  new_kv <- use_cache ? new_kv : null
  logits <- NN.linear@lm_head x dim=VOCAB_SIZE bias=false
  return logits, new_kv
