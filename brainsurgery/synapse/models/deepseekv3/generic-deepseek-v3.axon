{-# CHECKPOINTS ["deepseek-ai/DeepSeek-V3-Base", "deepseek-ai/DeepSeek-V3", "deepseek-ai/DeepSeek-V3-0324"] #-}
{-# TASK "causal_lm" #-}

import Activations (silu)
import Attention (attention, merge_heads, reshape_heads)
import Masking (causal_mask)
import Math (mul, sqrt)
import MoE (grouped_sigmoid_router, scatter_add, select)
import Positions (position_ids, rope_pair_yarn)



D      = Config.int@hidden_size default=7168
V      = Config.int@vocab_size default=129280
L      = Config.int@num_hidden_layers default=61
H      = Config.int@num_attention_heads default=128
QKNOPE = Config.int@qk_nope_head_dim default=128
QKROPE = Config.int@qk_rope_head_dim default=64
VHD    = Config.int@v_head_dim default=128
QHD    = QKNOPE + QKROPE
QLR    = Config.int@q_lora_rank default=1536
KVR    = Config.int@kv_lora_rank default=512
KVPROJ = H * (QKNOPE + VHD)
FFN    = Config.int@intermediate_size default=18432
E      = Config.int@n_routed_experts default=256
EPT    = Config.int@num_experts_per_tok default=8
EM     = Config.int@moe_intermediate_size default=2048
SE     = Config.int@n_shared_experts default=1
NG     = Config.int@n_group default=8
TKG    = Config.int@topk_group default=4
NTP    = Config.bool@norm_topk_prob default=true
RSC    = Config.float@routed_scaling_factor default=2.5
EPS    = Config.float@rms_norm_eps default=1e-06
THETA  = Config.float@rope_theta default=10000.0
C      = Config.int@max_position_embeddings default=163840
FIRST_DENSE = Config.int@first_k_dense_replace default=3
ROPE_SCALE = Config.float @'rope_scaling.factor' default=40.0
ROPE_BETA_FAST = Config.float @'rope_scaling.beta_fast' default=32.0
ROPE_BETA_SLOW = Config.float @'rope_scaling.beta_slow' default=1.0
ROPE_MSCALE = Config.float @'rope_scaling.mscale' default=1.0
ROPE_MSCALE_ALL_DIM = Config.float @'rope_scaling.mscale_all_dim' default=1.0
ROPE_CONTEXT = Config.int @'rope_scaling.original_max_position_embeddings' default=4096
ATTN_SCALE = 1.0 / sqrt QHD

rms :: Path -> Tensor[B,S,D] -> Tensor[B,S,D]
rms@path x = NN.rmsnorm@path x eps=EPS cast_float=true

deepseek_v3_attn :: Tensor[B,S,D] -> Tensor[B,S] -> ?Tensor[B,S] -> ?CacheLayer -> (Tensor[B,S,D], ?CacheLayer)
deepseek_v3_attn x pos_ids attn_mask past_kv = do
  a, new_kv <- scope@self_attn do
    q <- NN.linear@q_a_proj x dim=QLR bias=false |> rms@q_a_layernorm |> NN.linear@q_b_proj dim=(H * QHD) bias=false |> reshape_heads heads=H
    q_nope, q_pe <- Tensor.split q sizes=[QKNOPE, QKROPE]

    kv_comp <- NN.linear@kv_a_proj_with_mqa x dim=(KVR + QKROPE) bias=false
    kv_latent, k_pe_base <- Tensor.split kv_comp sizes=[KVR, QKROPE]
    kv_latent <- rms@kv_a_layernorm kv_latent
    kv <- NN.linear@kv_b_proj kv_latent dim=KVPROJ bias=false |> reshape_heads heads=H
    k_nope, v <- Tensor.split kv sizes=[QKNOPE, VHD]

    k_pe <- reshape_heads k_pe_base heads=1 |> Tensor.repeat repeats=H
    q_pe, k_pe <- rope_pair_yarn q_pe k_pe pos_ids THETA ROPE_SCALE ROPE_BETA_FAST ROPE_BETA_SLOW ROPE_CONTEXT mscale=ROPE_MSCALE mscale_all_dim=ROPE_MSCALE_ALL_DIM interleaved=true
    q_full <- Tensor.concat q_nope q_pe dim=-1
    k_full <- Tensor.concat k_nope k_pe dim=-1

    k_all, v_all, new_kv <- Cache.update past_kv k_full v
    mask <- causal_mask q_full k_all window=C padding_mask=attn_mask
    a <- attention q_full k_all v_all mask scale=ATTN_SCALE |> merge_heads
    a <- NN.linear@o_proj a dim=D bias=false
    return a, new_kv
  return a, new_kv

deepseek_v3_dense_block :: Tensor[B,S,D] -> Tensor[B,S] -> ?Tensor[B,S] -> ?CacheLayer -> (Tensor[B,S,D], ?CacheLayer)
deepseek_v3_dense_block x pos_ids attn_mask past_kv = do
  xn <- rms@input_layernorm x
  a, new_kv <- deepseek_v3_attn xn pos_ids attn_mask past_kv
  x <- x + a
  xn <- rms@post_attention_layernorm x
  m <- scope@mlp do
    gate <- NN.linear@gate_proj xn dim=FFN bias=false
    up <- NN.linear@up_proj xn dim=FFN bias=false
    return gate |> silu |> mul up |> NN.linear@down_proj dim=D bias=false
  return x + m, new_kv

deepseek_v3_moe_block :: Tensor[B,S,D] -> Tensor[B,S] -> ?Tensor[B,S] -> ?CacheLayer -> (Tensor[B,S,D], ?CacheLayer)
deepseek_v3_moe_block x pos_ids attn_mask past_kv = do
  xn <- rms@input_layernorm x
  a, new_kv <- deepseek_v3_attn xn pos_ids attn_mask past_kv
  x <- x + a
  xn <- rms@post_attention_layernorm x
  m <- scope@mlp do
    shared <- scope@shared_experts do
      gate <- NN.linear@gate_proj xn dim=(EM * SE) bias=false
      up <- NN.linear@up_proj xn dim=(EM * SE) bias=false
      return gate |> silu |> mul up |> NN.linear@down_proj dim=D bias=false
    topk_scores, topk_indices <- grouped_sigmoid_router@gate xn top_k=EPT n_group=NG topk_group=TKG norm_topk_prob=(NTP == true) routed_scaling_factor=RSC
    routed <- Tensor.zeros_like xn
    routed <- for@experts e <- [0..E) carry (routed) do
      x_sel, token_idx, topk_pos, sel_scores <- select xn topk_scores topk_indices e
      gate <- NN.linear@gate_proj x_sel dim=EM bias=false
      up <- NN.linear@up_proj x_sel dim=EM bias=false
      x_upd <- gate |> silu |> mul up |> NN.linear@down_proj dim=D bias=false
      routed <- scatter_add routed token_idx x_upd sel_scores
      yield routed
    return shared + routed
  return x + m, new_kv

deepseek_v3 :: TokenIds[B,S] -> ?Tensor[B,S] -> ?Cache -> ?Bool -> (Tensor[B,S,V], ?Cache)
deepseek_v3 input_ids attn_mask past_kv use_cache = do
  pos_ids <- position_ids input_ids attn_mask=attn_mask past_length=(Cache.past_length past_kv)
  x, new_kv <- scope@model do
    x <- NN.embedding@embed_tokens input_ids dim=D
    new_kv <- use_cache ? Cache.init : null
    x, new_kv <- for@layers i <- [0..FIRST_DENSE) carry (x, new_kv) do
      past_i <- Cache.index past_kv i
      x, new_i <- deepseek_v3_dense_block x pos_ids attn_mask past_i
      new_kv <- Cache.append new_kv new_i
      yield x, new_kv
    x, new_kv <- for@layers i <- [FIRST_DENSE..L) carry (x, new_kv) do
      past_i <- Cache.index past_kv i
      x, new_i <- deepseek_v3_moe_block x pos_ids attn_mask past_i
      new_kv <- Cache.append new_kv new_i
      yield x, new_kv
    x <- rms@norm x
    return x, new_kv
  logits <- NN.linear@lm_head x dim=V bias=false
  return logits, new_kv
