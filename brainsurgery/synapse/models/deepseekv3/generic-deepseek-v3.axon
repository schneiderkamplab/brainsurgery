{-# CHECKPOINTS ["deepseek-ai/DeepSeek-V3-Base", "deepseek-ai/DeepSeek-V3", "deepseek-ai/DeepSeek-V3-0324"] #-}
{-# TASK "causal_lm" #-}

import Config
import Activations silu
import Cache past_length
import Cache
import MoE

D      = Config.int "hidden_size" default=7168
V      = Config.int "vocab_size" default=129280
L      = Config.int "num_hidden_layers" default=61
H      = Config.int "num_attention_heads" default=128
QKNOPE = Config.int "qk_nope_head_dim" default=128
QKROPE = Config.int "qk_rope_head_dim" default=64
VHD    = Config.int "v_head_dim" default=128
QHD    = QKNOPE + QKROPE
QLR    = Config.int "q_lora_rank" default=1536
KVR    = Config.int "kv_lora_rank" default=512
KVPROJ = H * (QKNOPE + VHD)
FFN    = Config.int "intermediate_size" default=18432
E      = Config.int "n_routed_experts" default=256
EPT    = Config.int "num_experts_per_tok" default=8
EM     = Config.int "moe_intermediate_size" default=2048
SE     = Config.int "n_shared_experts" default=1
NG     = Config.int "n_group" default=8
TKG    = Config.int "topk_group" default=4
NTP    = Config.value "norm_topk_prob" default=true
RSC    = Config.float "routed_scaling_factor" default=2.5
EPS    = Config.float "rms_norm_eps" default=1e-06
THETA  = Config.float "rope_theta" default=10000.0
C      = Config.int "max_position_embeddings" default=163840
FIRST_DENSE = Config.int "first_k_dense_replace" default=3
ROPE_SCALE = Config.float "factor" root="rope_scaling" default=40.0
ROPE_BETA_FAST = Config.float "beta_fast" root="rope_scaling" default=32.0
ROPE_BETA_SLOW = Config.float "beta_slow" root="rope_scaling" default=1.0
ROPE_MSCALE = Config.float "mscale" root="rope_scaling" default=1.0
ROPE_MSCALE_ALL_DIM = Config.float "mscale_all_dim" root="rope_scaling" default=1.0
ROPE_CONTEXT = Config.int "original_max_position_embeddings" root="rope_scaling" default=4096
ATTN_SCALE = 1.0 / sqrt QHD

rms :: @Path -> Tensor[B,S,D] -> Tensor[B,S,D]
rms@path x = rmsnorm@path x eps=EPS cast_float=true

deepseek_v3_attn :: Tensor[B,S,D] -> Tensor[B,S] -> ?Tensor[B,S] -> ?CacheLayer -> (Tensor[B,S,D], ?CacheLayer)
deepseek_v3_attn x pos_ids attn_mask past_kv = do
  a, new_kv <- scope@self_attn do
    q <- linear@q_a_proj x dim=QLR bias=false |> rms@q_a_layernorm |> linear@q_b_proj dim=(H * QHD) bias=false |> reshape_heads heads=H
    q_nope, q_pe <- split q sizes=[QKNOPE, QKROPE]

    kv_comp <- linear@kv_a_proj_with_mqa x dim=(KVR + QKROPE) bias=false
    kv_latent, k_pe_base <- split kv_comp sizes=[KVR, QKROPE]
    kv_latent <- rms@kv_a_layernorm kv_latent
    kv <- linear@kv_b_proj kv_latent dim=KVPROJ bias=false |> reshape_heads heads=H
    k_nope, v <- split kv sizes=[QKNOPE, VHD]

    k_pe <- reshape_heads k_pe_base heads=1 |> repeat repeats=H
    q_pe, k_pe <- rope_pair q_pe k_pe position_ids=pos_ids theta=THETA interleaved=true scale_factor=ROPE_SCALE beta_fast=ROPE_BETA_FAST beta_slow=ROPE_BETA_SLOW mscale=ROPE_MSCALE mscale_all_dim=ROPE_MSCALE_ALL_DIM original_context=ROPE_CONTEXT
    q_full <- concat q_nope q_pe dim=-1
    k_full <- concat k_nope k_pe dim=-1

    k_all, v_all, new_kv <- Cache.update past_kv k_full v
    mask <- causal_mask q_full k_all window=C padding_mask=attn_mask
    a <- attention q_full k_all v_all mask=mask scale=ATTN_SCALE eager=true |> merge_heads
    a <- linear@o_proj a dim=D bias=false
    return a, new_kv
  return a, new_kv

deepseek_v3_dense_block :: Tensor[B,S,D] -> Tensor[B,S] -> ?Tensor[B,S] -> ?CacheLayer -> (Tensor[B,S,D], ?CacheLayer)
deepseek_v3_dense_block x pos_ids attn_mask past_kv = do
  xn <- rms@input_layernorm x
  a, new_kv <- deepseek_v3_attn xn pos_ids attn_mask past_kv
  x <- x + a
  xn <- rms@post_attention_layernorm x
  m <- scope@mlp do
    gate <- linear@gate_proj xn dim=FFN bias=false
    up <- linear@up_proj xn dim=FFN bias=false
    return gate |> silu |> mul up |> linear@down_proj dim=D bias=false
  return x + m, new_kv

deepseek_v3_moe_block :: Tensor[B,S,D] -> Tensor[B,S] -> ?Tensor[B,S] -> ?CacheLayer -> (Tensor[B,S,D], ?CacheLayer)
deepseek_v3_moe_block x pos_ids attn_mask past_kv = do
  xn <- rms@input_layernorm x
  a, new_kv <- deepseek_v3_attn xn pos_ids attn_mask past_kv
  x <- x + a
  xn <- rms@post_attention_layernorm x
  m <- scope@mlp do
    shared <- scope@shared_experts do
      gate <- linear@gate_proj xn dim=(EM * SE) bias=false
      up <- linear@up_proj xn dim=(EM * SE) bias=false
      return gate |> silu |> mul up |> linear@down_proj dim=D bias=false
    topk_scores, topk_indices <- glm4_router@gate xn top_k=EPT n_group=NG topk_group=TKG norm_topk_prob=(NTP == true) routed_scaling_factor=RSC
    routed <- zeros_like xn
    for@experts e <- [0..E) do
      x_sel, token_idx, topk_pos, sel_scores <- MoE.select xn topk_scores topk_indices e
      gate <- _linear@gate_proj x_sel dim=EM bias=false
      up <- _linear@up_proj x_sel dim=EM bias=false
      x_upd <- gate |> silu |> mul up |> _linear@down_proj dim=D bias=false
      routed <- MoE.scatter_add routed token_idx x_upd sel_scores
    return shared + routed
  return x + m, new_kv

deepseek_v3 :: TokenIds[B,S] -> ?Tensor[B,S] -> ?Cache -> ?Bool -> (Tensor[B,S,V], ?Cache)
deepseek_v3 input_ids attn_mask past_kv use_cache = do
  pos_ids <- position_ids input_ids attn_mask past_length=(past_length past_kv)
  x, new_kv <- scope@model do
    x <- embedding@embed_tokens input_ids dim=D
    new_kv <- use_cache ? Cache.init : null
    for@layers i <- [0..FIRST_DENSE) do
      past_i <- Cache.index past_kv i
      x, new_i <- deepseek_v3_dense_block x pos_ids attn_mask past_i
      new_kv <- Cache.append new_kv new_i
    for@layers i <- [FIRST_DENSE..L) do
      past_i <- Cache.index past_kv i
      x, new_i <- deepseek_v3_moe_block x pos_ids attn_mask past_i
      new_kv <- Cache.append new_kv new_i
    x <- rms@norm x
    return x, new_kv
  logits <- linear@lm_head x dim=V bias=false
  return logits, new_kv
