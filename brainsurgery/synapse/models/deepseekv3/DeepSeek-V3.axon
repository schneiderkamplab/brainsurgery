{-# CHECKPOINTS ["deepseek-ai/DeepSeek-V3-Base", "deepseek-ai/DeepSeek-V3", "deepseek-ai/DeepSeek-V3-0324"] #-}
{-# TASK "causal_lm" #-}

import Activations
import Activations (silu)
import Attention
import Attention (attention, merge_heads, reshape_heads)
import Masking
import Masking (causal_mask)
import Math
import Math (mul, sqrt)
import MoE
import MoE (grouped_sigmoid_router, scatter_add, select)
import Positions
import Positions (position_ids, rope_pair_yarn)

rms :: Path -> Tensor[B,S,D] -> Tensor[B,S,D]
rms@path x = NN.rmsnorm@path x eps=1e-06 cast_float=true

deepseek_v3_attn :: Tensor[B,S,D] -> Tensor[B,S] -> ?Tensor[B,S] -> ?CacheLayer -> (Tensor[B,S,D], ?CacheLayer)
deepseek_v3_attn x pos_ids attn_mask past_kv = do
  a, new_kv <- scope@self_attn do
    q <- NN.linear@q_a_proj x dim=1536 bias=false |> rms@q_a_layernorm |> NN.linear@q_b_proj dim=24576 bias=false |> reshape_heads heads=128
    q_nope, q_pe <- Tensor.split q sizes=[128, 64]
    kv_comp <- NN.linear@kv_a_proj_with_mqa x dim=576 bias=false
    kv_latent, k_pe_base <- Tensor.split kv_comp sizes=[512, 64]
    kv_latent <- rms@kv_a_layernorm kv_latent
    kv <- NN.linear@kv_b_proj kv_latent dim=32768 bias=false |> reshape_heads heads=128
    k_nope, v <- Tensor.split kv sizes=[128, 128]
    k_pe <- reshape_heads k_pe_base heads=1 |> Tensor.repeat repeats=128
    q_pe, k_pe <- rope_pair_yarn q_pe k_pe pos_ids 10000.0 40.0 32.0 1.0 4096 mscale=1.0 mscale_all_dim=1.0 interleaved=true
    q_full <- Tensor.concat q_nope q_pe dim=-1
    k_full <- Tensor.concat k_nope k_pe dim=-1
    k_all, v_all, new_kv <- Cache.update past_kv k_full v
    mask <- causal_mask q_full k_all window=163840 padding_mask=attn_mask
    a <- attention q_full k_all v_all mask scale=0.07216878364870323 |> merge_heads
    a <- NN.linear@o_proj a dim=7168 bias=false
    return a, new_kv
  return a, new_kv

deepseek_v3_dense_block :: Tensor[B,S,D] -> Tensor[B,S] -> ?Tensor[B,S] -> ?CacheLayer -> (Tensor[B,S,D], ?CacheLayer)
deepseek_v3_dense_block x pos_ids attn_mask past_kv = do
  xn <- rms@input_layernorm x
  a, new_kv <- deepseek_v3_attn xn pos_ids attn_mask past_kv
  x <- x + a
  xn <- rms@post_attention_layernorm x
  m <- scope@mlp do
    gate <- NN.linear@gate_proj xn dim=18432 bias=false
    up <- NN.linear@up_proj xn dim=18432 bias=false
    return gate |> silu |> mul up |> NN.linear@down_proj dim=7168 bias=false
  return x + m, new_kv

deepseek_v3_moe_block :: Tensor[B,S,D] -> Tensor[B,S] -> ?Tensor[B,S] -> ?CacheLayer -> (Tensor[B,S,D], ?CacheLayer)
deepseek_v3_moe_block x pos_ids attn_mask past_kv = do
  xn <- rms@input_layernorm x
  a, new_kv <- deepseek_v3_attn xn pos_ids attn_mask past_kv
  x <- x + a
  xn <- rms@post_attention_layernorm x
  m <- scope@mlp do
    shared <- scope@shared_experts do
      gate <- NN.linear@gate_proj xn dim=2048 bias=false
      up <- NN.linear@up_proj xn dim=2048 bias=false
      return gate |> silu |> mul up |> NN.linear@down_proj dim=7168 bias=false
    topk_scores, topk_indices <- grouped_sigmoid_router@gate xn top_k=8 n_group=8 topk_group=4 norm_topk_prob=true routed_scaling_factor=2.5
    routed <- Tensor.zeros_like xn
    for@experts e <- [0..256) do
      x_sel, token_idx, topk_pos, sel_scores <- select xn topk_scores topk_indices e
      gate <- NN.linear@gate_proj x_sel dim=2048 bias=false
      up <- NN.linear@up_proj x_sel dim=2048 bias=false
      x_upd <- gate |> silu |> mul up |> NN.linear@down_proj dim=7168 bias=false
      routed <- scatter_add routed token_idx x_upd sel_scores
      yield routed
    return shared + routed
  return x + m, new_kv

deepseek_v3 :: TokenIds[B,S] -> ?Tensor[B,S] -> ?Cache -> ?Bool -> (Tensor[B,S,V], ?Cache)
deepseek_v3 input_ids attn_mask past_kv use_cache = do
  pos_ids <- position_ids input_ids attn_mask=attn_mask past_length=(Cache.past_length past_kv)
  x, new_kv <- scope@model do
    x <- NN.embedding@embed_tokens input_ids dim=7168
    new_kv <- use_cache ? Cache.init : null
    for@layers i <- [0..3) do
      past_i <- Cache.index past_kv i
      x, new_i <- deepseek_v3_dense_block x pos_ids attn_mask past_i
      new_kv <- Cache.append new_kv new_i
      yield x, new_kv
    for@layers i <- [3..61) do
      past_i <- Cache.index past_kv i
      x, new_i <- deepseek_v3_moe_block x pos_ids attn_mask past_i
      new_kv <- Cache.append new_kv new_i
      yield x, new_kv
    x <- rms@norm x
    return x, new_kv
  logits <- NN.linear@lm_head x dim=129280 bias=false
  return logits, new_kv
