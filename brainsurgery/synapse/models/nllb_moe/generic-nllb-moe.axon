{-# CHECKPOINTS ["test/NLLB-MoE-Test"] #-}
{-# TASK "seq2seq_lm" #-}

import Activations (relu)
import Attention (attention, merge_heads, reshape_heads)
import Masking (Mask, bidirectional_mask_for_input, causal_mask_for_input, mask_for_input)
import Math (sqrt)
import MoE (scatter_add, select, softmax_topk_router)
import Positions (sinusoidal_positions)
import Config
import NN
import Tensor

MODEL_DIM <- Config.int @@d_model default=64
VOCAB_SIZE <- Config.int @@vocab_size default=128112
L_ENC <- Config.int @@encoder_layers default=2
L_DEC <- Config.int @@decoder_layers default=2
H_ENC <- Config.int @@encoder_attention_heads default=4
H_DEC <- Config.int @@decoder_attention_heads default=4
FFN_ENC <- Config.int @@encoder_ffn_dim default=128
FFN_DEC <- Config.int @@decoder_ffn_dim default=128
EXPERTS <- Config.int @@num_experts default=4
ENC_SPARSE_STEP <- Config.int @@encoder_sparse_step default=1
DEC_SPARSE_STEP <- Config.int @@decoder_sparse_step default=1
EPS <- Config.float @@layer_norm_eps default=1e-05
PAD_ID <- Config.int @@pad_token_id default=1
MOE_EVAL_SCALE = 0.8
EMB_SCALE = sqrt MODEL_DIM

nllb_moe_dense_ffn :: Path -> Tensor[B,S,D] -> Dim -> Tensor[B,S,D]
nllb_moe_dense_ffn@path x ffn_dim = do
  return NN.linear@fc1 x dim=ffn_dim bias=true |> relu |> NN.linear@fc2 dim=MODEL_DIM bias=true

nllb_moe_sparse_ffn :: Path -> Tensor[B,S,D] -> Dim -> Tensor[B,S,D]
nllb_moe_sparse_ffn@path x ffn_dim = do
  scores, selected <- softmax_topk_router@router.classifier x top_k=2 routed_scaling_factor=MOE_EVAL_SCALE
  out <- Tensor.zeros_like x
  out <- for e <- [0..EXPERTS) carry (out) do
    selected_x, token_idx, _, selected_scores <- select x scores selected e
    expert_path <- @'experts.expert_{e}'
    expert <- NN.linear expert_path selected_x dim=ffn_dim bias=true weight_path=@@'{path}.experts.expert_{e}.fc1.weight' bias_path=@@'{path}.experts.expert_{e}.fc1.bias' |> relu
    expert <- NN.linear expert_path expert dim=MODEL_DIM bias=true weight_path=@@'{path}.experts.expert_{e}.fc2.weight' bias_path=@@'{path}.experts.expert_{e}.fc2.bias'
    out <- scatter_add out token_idx expert selected_scores
    yield out
  return out

nllb_moe_encoder_layer :: Tensor[B,S,D] -> Tensor[B,1,S,S] -> Int -> Tensor[B,S,D]
nllb_moe_encoder_layer x keep i = do
  x_norm <- NN.layernorm@self_attn_layer_norm x eps=EPS
  a <- scope@self_attn do
    q <- NN.linear@q_proj x_norm dim=MODEL_DIM bias=true |> reshape_heads heads=H_ENC
    k <- NN.linear@k_proj x_norm dim=MODEL_DIM bias=true |> reshape_heads heads=H_ENC
    v <- NN.linear@v_proj x_norm dim=MODEL_DIM bias=true |> reshape_heads heads=H_ENC
    return attention q k v keep |> merge_heads |> NN.linear@out_proj dim=MODEL_DIM bias=true
  x <- x + a
  x_norm <- NN.layernorm@ff_layer_norm x eps=EPS
  sparse <- (ENC_SPARSE_STEP == 1) or (((i + 1) % ENC_SPARSE_STEP) == 0)
  m <- sparse ? nllb_moe_sparse_ffn@ffn x_norm FFN_ENC : nllb_moe_dense_ffn@ffn x_norm FFN_ENC
  return x + m

nllb_moe_decoder_layer :: Tensor[B,SDEC,D] -> Tensor[B,SENC,D] -> Tensor[B,1,SDEC,SDEC] -> Tensor[B,1,SDEC,SENC] -> Int -> Tensor[B,SDEC,D]
nllb_moe_decoder_layer x enc_hidden decoder_keep cross_keep i = do
  x_norm <- NN.layernorm@self_attn_layer_norm x eps=EPS
  a <- scope@self_attn do
    q <- NN.linear@q_proj x_norm dim=MODEL_DIM bias=true |> reshape_heads heads=H_DEC
    k <- NN.linear@k_proj x_norm dim=MODEL_DIM bias=true |> reshape_heads heads=H_DEC
    v <- NN.linear@v_proj x_norm dim=MODEL_DIM bias=true |> reshape_heads heads=H_DEC
    return attention q k v decoder_keep |> merge_heads |> NN.linear@out_proj dim=MODEL_DIM bias=true
  x <- x + a
  x_norm <- NN.layernorm@cross_attention_layer_norm x eps=EPS
  a <- scope@cross_attention do
    q <- NN.linear@q_proj x_norm dim=MODEL_DIM bias=true |> reshape_heads heads=H_DEC
    k <- NN.linear@k_proj enc_hidden dim=MODEL_DIM bias=true |> reshape_heads heads=H_DEC
    v <- NN.linear@v_proj enc_hidden dim=MODEL_DIM bias=true |> reshape_heads heads=H_DEC
    return attention q k v cross_keep |> merge_heads |> NN.linear@out_proj dim=MODEL_DIM bias=true
  x <- x + a
  x_norm <- NN.layernorm@ff_layer_norm x eps=EPS
  sparse <- (DEC_SPARSE_STEP == 1) or (((i + 1) % DEC_SPARSE_STEP) == 0)
  m <- sparse ? nllb_moe_sparse_ffn@ffn x_norm FFN_DEC : nllb_moe_dense_ffn@ffn x_norm FFN_DEC
  return x + m

nllb_moe :: TokenIds[B,SENC] -> ?Mask[B,SENC,SENC] -> TokenIds[B,SDEC] -> ?Mask[B,SDEC,SDEC] -> Tensor[B,SDEC,V]
nllb_moe input_ids attention_mask decoder_input_ids decoder_attention_mask = do
  attention_mask <- mask_for_input input_ids attention_mask SENC
  decoder_attention_mask <- mask_for_input decoder_input_ids decoder_attention_mask SDEC
  encoder_keep <- bidirectional_mask_for_input input_ids SENC padding_mask=attention_mask
  decoder_keep <- causal_mask_for_input decoder_input_ids SDEC padding_mask=decoder_attention_mask window=128
  cross_keep <- bidirectional_mask_for_input decoder_input_ids SENC padding_mask=attention_mask

  enc_nonpad <- Tensor.where (Tensor.eq input_ids PAD_ID) 0 1
  enc_pos_ids <- Tensor.cumsum enc_nonpad dim=-1
  enc_pos_ids <- Tensor.where (Tensor.cast enc_nonpad "bool") (enc_pos_ids + PAD_ID) PAD_ID
  enc_tok <- NN.embedding@model.shared input_ids dim=MODEL_DIM scale=EMB_SCALE
  enc_hidden <- enc_tok + sinusoidal_positions enc_tok enc_pos_ids offset=0 padding_idx=PAD_ID
  enc_hidden <- for@model.encoder.layers i <- [0..L_ENC) carry (enc_hidden) do
    enc_hidden <- nllb_moe_encoder_layer enc_hidden encoder_keep i
    yield enc_hidden
  enc_hidden <- NN.layernorm@model.encoder.layer_norm enc_hidden eps=EPS

  dec_nonpad <- Tensor.where (Tensor.eq decoder_input_ids PAD_ID) 0 1
  dec_pos_ids <- Tensor.cumsum dec_nonpad dim=-1
  dec_pos_ids <- Tensor.where (Tensor.cast dec_nonpad "bool") (dec_pos_ids + PAD_ID) PAD_ID
  dec_tok <- NN.embedding@model.shared decoder_input_ids dim=MODEL_DIM scale=EMB_SCALE
  dec_hidden <- dec_tok + sinusoidal_positions dec_tok dec_pos_ids offset=0 padding_idx=PAD_ID
  dec_hidden <- for@model.decoder.layers i <- [0..L_DEC) carry (dec_hidden) do
    dec_hidden <- nllb_moe_decoder_layer dec_hidden enc_hidden decoder_keep cross_keep i
    yield dec_hidden
  dec_hidden <- NN.layernorm@model.decoder.layer_norm dec_hidden eps=EPS
  return NN.linear@model.shared dec_hidden dim=VOCAB_SIZE bias=false
