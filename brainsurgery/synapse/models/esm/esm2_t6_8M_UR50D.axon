{-# CHECKPOINTS "facebook/esm2_t6_8M_UR50D" #-}

{-# TASK "masked_lm" #-}

{-# MAIN "esm" #-}

import Activations (gelu)

import Attention (attention, merge_heads, reshape_heads)

import Masking (Mask, bidirectional_mask_for_input, mask_for_input)

import Math (sqrt)

import Positions (position_ids, rope_pair_base)

import Config

import NN

import Tensor

MODEL_DIM <- 320

VOCAB_SIZE <- 33

NUM_LAYERS <- 6

NUM_HEADS <- 20

FFN <- 1280

EPS <- 1e-05

MASK_TOKEN <- 32

ROPE_THETA <- 10000.0

HEAD_SCALE <- 1.0 / sqrt (MODEL_DIM / NUM_HEADS)

esm_block :: Tensor[B,S,D] -> Tensor[B,S] -> Tensor[B,1,S,S] -> Tensor[B,S,D]
esm_block x pos_ids keep = do
  xn <- NN.layernorm@attention.LayerNorm x eps=EPS
  a <- scope@attention.self do
    q <- NN.linear@query xn dim=MODEL_DIM bias=true |> reshape_heads heads=NUM_HEADS
    k <- NN.linear@key xn dim=MODEL_DIM bias=true |> reshape_heads heads=NUM_HEADS
    v <- NN.linear@value xn dim=MODEL_DIM bias=true |> reshape_heads heads=NUM_HEADS
    q <- q * HEAD_SCALE
    q, k <- rope_pair_base q k pos_ids theta=ROPE_THETA
    return attention q k v keep scale=1.0 |> merge_heads
  a <- NN.linear@attention.output.dense a dim=MODEL_DIM bias=true
  x <- x + a
  xn <- NN.layernorm@LayerNorm x eps=EPS
  m <- NN.linear@intermediate.dense xn dim=FFN bias=true |> gelu
  m <- NN.linear@output.dense m dim=MODEL_DIM bias=true
  return x + m

esm :: TokenIds[B,S] -> ?Mask[B,S,S] -> Tensor[B,S,V]
esm input_ids attn_mask = do
  attn_mask <- mask_for_input input_ids attn_mask S
  pos_ids <- position_ids input_ids
  keep <- bidirectional_mask_for_input input_ids S padding_mask=attn_mask
  tok <- NN.embedding@esm.embeddings.word_embeddings input_ids dim=MODEL_DIM
  masked <- Tensor.eq input_ids MASK_TOKEN
  masked_f <- Tensor.cast masked dtype="float32"
  active_f <- Tensor.cast attn_mask dtype="float32"
  masked_count <- Tensor.sum masked_f dim=-1
  active_count <- Tensor.sum active_f dim=-1
  observed <- masked_count / active_count
  scale <- 0.88 / (1.0 - observed)
  scale <- Tensor.unsqueeze scale dim=-1 |> Tensor.unsqueeze dim=-1
  masked <- Tensor.unsqueeze masked dim=-1
  x <- Tensor.where masked 0.0 tok
  x <- x * scale
  active <- Tensor.unsqueeze attn_mask dim=-1 |> Tensor.cast_like x
  x <- x * active
  x <- for@esm.encoder.layer i <- [0..NUM_LAYERS) carry (x) do
    x <- esm_block x pos_ids keep
    yield x
  x <- NN.layernorm@esm.encoder.emb_layer_norm_after x eps=EPS
  logits <- scope@lm_head do
    x <- NN.linear@dense x dim=MODEL_DIM bias=true |> gelu
    x <- NN.layernorm@layer_norm x eps=EPS
    return NN.linear@decoder x dim=VOCAB_SIZE bias=true weight_path=@@esm.embeddings.word_embeddings.weight bias_path=@@lm_head.bias
  return logits
