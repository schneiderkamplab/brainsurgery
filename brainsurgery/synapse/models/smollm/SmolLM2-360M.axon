{-# CHECKPOINTS ["HuggingFaceTB/SmolLM2-360M", "HuggingFaceTB/SmolLM2-360M-Instruct"] #-}

{-# TASK "causal_lm" #-}

{-# MAIN "smollm" #-}

import Activations (silu)

import Attention (attention, merge_heads, reshape_heads)

import Masking (causal_mask)

import Math (mul)

import Params (has_root)

import Positions (position_ids, rope_pair_base)

import Cache

import Config

import NN

import Tensor

HAS_TEXT_CONFIG = false

HAS_LANGUAGE_MODEL = has_root "language_model"

MODEL_DIM = HAS_TEXT_CONFIG ? 576 : 960

VOCAB_SIZE = HAS_TEXT_CONFIG ? 49152 : 49152

NUM_LAYERS = HAS_TEXT_CONFIG ? 30 : 32

NUM_HEADS = HAS_TEXT_CONFIG ? 9 : 15

KVH = HAS_TEXT_CONFIG ? 3 : 5

HAS_HEAD_DIM = HAS_TEXT_CONFIG ? false : false

MODEL_HEAD_DIM = HAS_HEAD_DIM ? HAS_TEXT_CONFIG ? 64 : 64 : MODEL_DIM / NUM_HEADS

KVD = KVH * MODEL_HEAD_DIM

FFN = HAS_TEXT_CONFIG ? 1536 : 2560

EPS = HAS_TEXT_CONFIG ? 1e-05 : 1e-05

THETA = HAS_TEXT_CONFIG ? 10000.0 : 100000.0

MAX_POSITIONS = HAS_TEXT_CONFIG ? 2048 : 8192

rms :: Path -> Tensor[B,S,D] -> Tensor[B,S,D]
rms@path x = NN.rmsnorm@path x eps=EPS

smollm_block :: Tensor[B,S,D] -> Tensor[B,S] -> ?Tensor[B,K] -> ?CacheLayer[B,KVH,P,DH] -> (Tensor[B,S,D], ?CacheLayer[B,KVH,K,DH])
smollm_block x pos_ids attn_mask past_kv = do
  xn <- rms@input_layernorm x
  a, new_kv <- scope@self_attn do
    q <- NN.linear@q_proj xn dim=MODEL_DIM |> reshape_heads heads=NUM_HEADS
    k <- NN.linear@k_proj xn dim=KVD |> reshape_heads heads=KVH
    v <- NN.linear@v_proj xn dim=KVD |> reshape_heads heads=KVH
    q, k <- rope_pair_base q k pos_ids THETA
    k, v, new_kv <- Cache.update past_kv k v
    k <- Tensor.repeat k repeats=(NUM_HEADS / KVH)
    v <- Tensor.repeat v repeats=(NUM_HEADS / KVH)
    mask <- causal_mask q k window=MAX_POSITIONS padding_mask=attn_mask
    a <- attention q k v mask |> merge_heads |> NN.linear@o_proj dim=MODEL_DIM
    return a, new_kv
  x <- x + a
  xn <- rms@post_attention_layernorm x
  m <- scope@mlp do
    g <- NN.linear@gate_proj xn dim=FFN
    u <- NN.linear@up_proj xn dim=FFN
    return g |> silu |> mul u |> NN.linear@down_proj dim=MODEL_DIM
  return x + m, new_kv

smollm_model :: Path -> TokenIds[B,S] -> ?Tensor[B,K] -> ?Cache[B,KVH,P,DH] -> ?Bool -> Tensor[B,S] -> (Tensor[B,S,V], ?Cache[B,KVH,K,DH])
smollm_model@root input_ids attn_mask past_kv use_cache pos_ids = do
  x <- NN.embedding@embed_tokens input_ids dim=MODEL_DIM
  new_kv <- use_cache ? Cache.init : null
  x, new_kv <- for@layers i <- [0..NUM_LAYERS) carry (x, new_kv) do
    past_i <- Cache.index past_kv i
    x, new_i <- smollm_block x pos_ids attn_mask past_i
    new_kv <- Cache.append new_kv new_i
    yield x, new_kv
  logits <- rms@norm x |> NN.linear@embed_tokens dim=VOCAB_SIZE
  return logits, new_kv

smollm :: TokenIds[B,S] -> ?Tensor[B,K] -> ?Cache[B,KVH,P,DH] -> ?Bool -> (Tensor[B,S,V], ?Cache[B,KVH,K,DH])
smollm input_ids attn_mask past_kv use_cache = do
  pos_ids <- position_ids input_ids attn_mask=attn_mask past_length=(Cache.past_length past_kv)
  logits, new_kv <- HAS_LANGUAGE_MODEL ? smollm_model@language_model.model input_ids attn_mask past_kv use_cache pos_ids : smollm_model@model input_ids attn_mask past_kv use_cache pos_ids
  return logits, new_kv
