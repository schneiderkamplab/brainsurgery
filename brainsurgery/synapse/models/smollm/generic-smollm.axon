{-# CHECKPOINTS ["HuggingFaceTB/SmolLM-135M", "HuggingFaceTB/SmolLM-135M-Instruct", "HuggingFaceTB/SmolLM-360M", "HuggingFaceTB/SmolLM-360M-Instruct", "HuggingFaceTB/SmolLM-1.7B", "HuggingFaceTB/SmolLM-1.7B-Instruct", "HuggingFaceTB/SmolLM2-135M", "HuggingFaceTB/SmolLM2-135M-Instruct", "HuggingFaceTB/SmolLM2-360M", "HuggingFaceTB/SmolLM2-360M-Instruct", "HuggingFaceTB/SmolLM2-1.7B", "HuggingFaceTB/SmolLM2-1.7B-Instruct"] #-}
{-# TASK "causal_lm" #-}

import Config
import Params
import Activations (silu)
import Cache
import Cache
import Attention (reshape_heads, merge_heads)
import Attention (attention_masked)
import Masking (causal_mask)
import Positions (position_ids, rope_pair_base)
import Math (mul)

CFG = (Config.has_key "text_config") ? "text_config" : ""
PARAM_ROOT = (Params.has_root "language_model") ? "language_model" : ""

D = Config.int "hidden_size" root=CFG default=576
V = Config.int "vocab_size" root=CFG default=49152
L = Config.int "num_hidden_layers" root=CFG default=30
H = Config.int "num_attention_heads" root=CFG default=9
KVH = Config.int "num_key_value_heads" root=CFG default=3
HD = (Config.has_key "head_dim" root=CFG) ? Config.int "head_dim" root=CFG default=64 : (D / H)
KVD = KVH * HD
FFN = Config.int "intermediate_size" root=CFG default=1536
EPS = Config.float "rms_norm_eps" root=CFG default=1e-05
THETA = Config.float "rope_theta" root=CFG default=10000.0
C = Config.int "max_position_embeddings" root=CFG default=2048

rms :: @Path -> Tensor[B,S,D] -> Tensor[B,S,D]
rms@path x = NN.rmsnorm@path x eps=EPS

smollm_block :: Tensor[B,S,D] -> Tensor[B,S] -> ?Tensor[B,S] -> ?CacheLayer -> (Tensor[B,S,D], ?CacheLayer)
smollm_block x pos_ids attn_mask past_kv = do
  xn <- rms@input_layernorm x
  a, new_kv <- scope@self_attn do
    q <- NN.linear@q_proj xn dim=D |> reshape_heads heads=H
    k <- NN.linear@k_proj xn dim=KVD |> reshape_heads heads=KVH
    v <- NN.linear@v_proj xn dim=KVD |> reshape_heads heads=KVH
    q, k <- rope_pair_base q k pos_ids THETA
    k, v, new_kv <- Cache.update past_kv k v
    k <- Tensor.repeat k repeats=(H / KVH)
    v <- Tensor.repeat v repeats=(H / KVH)
    mask <- causal_mask q k window=C padding_mask=attn_mask
    a <- attention_masked q k v mask=mask |> merge_heads |> NN.linear@o_proj dim=D
    return a, new_kv
  x <- x + a
  xn <- rms@post_attention_layernorm x
  m <- scope@mlp do
    g <- NN.linear@gate_proj xn dim=FFN
    u <- NN.linear@up_proj xn dim=FFN
    return g |> silu |> mul u |> NN.linear@down_proj dim=D
  return x + m, new_kv

smollm :: TokenIds[B,S] -> ?Tensor[B,S] -> ?Cache -> ?Bool -> (Tensor[B,S,V], ?Cache)
smollm input_ids attn_mask past_kv use_cache = do
  pos_ids <- position_ids input_ids attn_mask=attn_mask past_length=(Cache.past_length past_kv)
  logits, new_kv <- scope@model root=PARAM_ROOT do
    x <- NN.embedding@embed_tokens input_ids dim=D
    new_kv <- use_cache ? Cache.init : null
    for@layers i <- [0..L) do
      past_i <- Cache.index past_kv i
      x, new_i <- smollm_block x pos_ids attn_mask past_i
      new_kv <- Cache.append new_kv new_i
    logits <- rms@norm x |> NN.linear@embed_tokens dim=V
    return logits, new_kv
  return logits, new_kv
