{-# CHECKPOINTS ["test/LayoutLM-Test"] #-}
{-# TASK "masked_lm" #-}

import Activations (gelu)
import Attention (attention, merge_heads, reshape_heads)
import Masking (Mask, bidirectional_mask_for_input, mask_for_input)
import Positions (position_ids)
import Config
import NN
import Tensor



MODEL_DIM <- Config.int @@hidden_size default=768
VOCAB_SIZE <- Config.int @@vocab_size default=30522
NUM_LAYERS <- Config.int @@num_hidden_layers default=12
NUM_HEADS <- Config.int @@num_attention_heads default=12
FFN <- Config.int @@intermediate_size default=3072
EPS <- Config.float @@layer_norm_eps default=1e-12

layoutlm_block :: Tensor[B,S,D] -> Tensor[B,1,S,S] -> Tensor[B,S,D]
layoutlm_block x keep = do
  a <- scope@attention do
    q <- NN.linear@self.query x dim=MODEL_DIM bias=true |> reshape_heads heads=NUM_HEADS
    k <- NN.linear@self.key x dim=MODEL_DIM bias=true |> reshape_heads heads=NUM_HEADS
    v <- NN.linear@self.value x dim=MODEL_DIM bias=true |> reshape_heads heads=NUM_HEADS
    return attention q k v keep |> merge_heads |> NN.linear@output.dense dim=MODEL_DIM bias=true
  x <- x + a
  x <- NN.layernorm@attention.output.LayerNorm x eps=EPS
  m <- NN.linear@intermediate.dense x dim=FFN bias=true |> gelu
  m <- NN.linear@output.dense m dim=MODEL_DIM bias=true
  y <- x + m
  y <- NN.layernorm@output.LayerNorm y eps=EPS
  return y

layoutlm :: TokenIds[B,S] -> ?Mask[B,S,S] -> ?Tensor[B,S,4] -> ?TokenIds[B,S] -> Tensor[B,S,V]
layoutlm input_ids attn_mask bbox token_type_ids = do
  attn_mask <- mask_for_input input_ids attn_mask S
  pos_ids <- position_ids input_ids
  keep <- bidirectional_mask_for_input input_ids S padding_mask=attn_mask
  zeros <- input_ids - input_ids
  bbox <- (bbox == null) ? Tensor.zeros input_ids shape=[B, S, 4] dtype="long" : bbox
  token_type_ids <- (token_type_ids == null) ? zeros : token_type_ids
  left <- Tensor.slice bbox dim=-1 start=0 end=1 |> Tensor.reshape shape=[B, S]
  upper <- Tensor.slice bbox dim=-1 start=1 end=2 |> Tensor.reshape shape=[B, S]
  right <- Tensor.slice bbox dim=-1 start=2 end=3 |> Tensor.reshape shape=[B, S]
  lower <- Tensor.slice bbox dim=-1 start=3 end=4 |> Tensor.reshape shape=[B, S]
  height <- lower - upper
  width <- right - left
  x <- NN.embedding@layoutlm.embeddings.word_embeddings input_ids dim=MODEL_DIM
  x <- x + NN.embedding@layoutlm.embeddings.position_embeddings pos_ids dim=MODEL_DIM
  x <- x + NN.embedding@layoutlm.embeddings.x_position_embeddings left dim=MODEL_DIM
  x <- x + NN.embedding@layoutlm.embeddings.y_position_embeddings upper dim=MODEL_DIM
  x <- x + NN.embedding@layoutlm.embeddings.x_position_embeddings right dim=MODEL_DIM
  x <- x + NN.embedding@layoutlm.embeddings.y_position_embeddings lower dim=MODEL_DIM
  x <- x + NN.embedding@layoutlm.embeddings.h_position_embeddings height dim=MODEL_DIM
  x <- x + NN.embedding@layoutlm.embeddings.w_position_embeddings width dim=MODEL_DIM
  x <- x + NN.embedding@layoutlm.embeddings.token_type_embeddings token_type_ids dim=MODEL_DIM
  x <- NN.layernorm@layoutlm.embeddings.LayerNorm x eps=EPS
  x <- for@layoutlm.encoder.layer i <- [0..NUM_LAYERS) carry (x) do
    x <- layoutlm_block x keep
    yield x
  logits <- scope@cls.predictions do
    x <- NN.linear@transform.dense x dim=MODEL_DIM bias=true |> gelu
    x <- NN.layernorm@transform.LayerNorm x eps=EPS
    return NN.linear@decoder x dim=VOCAB_SIZE bias=true weight_path=@@layoutlm.embeddings.word_embeddings.weight bias_path=@@cls.predictions.bias
  return logits
