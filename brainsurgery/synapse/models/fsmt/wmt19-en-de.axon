{-# CHECKPOINTS "facebook/wmt19-en-de" #-}

{-# TASK "seq2seq_lm" #-}

{-# MAIN "fsmt" #-}

import Activations (relu)

import Attention (attention, merge_heads, reshape_heads)

import Masking (Mask, bidirectional_mask_for_input, causal_mask_for_input, mask_for_input)

import Math (sqrt)

import Positions (sinusoidal_positions)

import Config

import NN

import Tensor

MODEL_DIM <- 1024

SRC_VOCAB <- 42024

TGT_VOCAB <- 42024

L_ENC <- 6

L_DEC <- 6

H_ENC <- 16

H_DEC <- 16

FFN_ENC <- 8192

FFN_DEC <- 4096

EPS <- 1e-05

PAD_ID <- 1

EMB_SCALE = sqrt MODEL_DIM

fsmt_encoder_layer :: Tensor[B,S,D] -> Tensor[B,1,S,S] -> Tensor[B,S,D]
fsmt_encoder_layer x keep = do
  a <- scope@self_attn do
    q <- NN.linear@q_proj x dim=MODEL_DIM bias=true |> reshape_heads heads=H_ENC
    k <- NN.linear@k_proj x dim=MODEL_DIM bias=true |> reshape_heads heads=H_ENC
    v <- NN.linear@v_proj x dim=MODEL_DIM bias=true |> reshape_heads heads=H_ENC
    return attention q k v keep |> merge_heads |> NN.linear@out_proj dim=MODEL_DIM bias=true
  x <- NN.layernorm@self_attn_layer_norm (x + a) eps=EPS
  m <- NN.linear@fc1 x dim=FFN_ENC bias=true |> relu |> NN.linear@fc2 dim=MODEL_DIM bias=true
  return NN.layernorm@final_layer_norm (x + m) eps=EPS

fsmt_decoder_layer :: Tensor[B,SDEC,D] -> Tensor[B,SENC,D] -> Tensor[B,1,SDEC,SDEC] -> Tensor[B,1,SDEC,SENC] -> Tensor[B,SDEC,D]
fsmt_decoder_layer x enc_hidden decoder_keep cross_keep = do
  a <- scope@self_attn do
    q <- NN.linear@q_proj x dim=MODEL_DIM bias=true |> reshape_heads heads=H_DEC
    k <- NN.linear@k_proj x dim=MODEL_DIM bias=true |> reshape_heads heads=H_DEC
    v <- NN.linear@v_proj x dim=MODEL_DIM bias=true |> reshape_heads heads=H_DEC
    return attention q k v decoder_keep |> merge_heads |> NN.linear@out_proj dim=MODEL_DIM bias=true
  x <- NN.layernorm@self_attn_layer_norm (x + a) eps=EPS
  a <- scope@encoder_attn do
    q <- NN.linear@q_proj x dim=MODEL_DIM bias=true |> reshape_heads heads=H_DEC
    k <- NN.linear@k_proj enc_hidden dim=MODEL_DIM bias=true |> reshape_heads heads=H_DEC
    v <- NN.linear@v_proj enc_hidden dim=MODEL_DIM bias=true |> reshape_heads heads=H_DEC
    return attention q k v cross_keep |> merge_heads |> NN.linear@out_proj dim=MODEL_DIM bias=true
  x <- NN.layernorm@encoder_attn_layer_norm (x + a) eps=EPS
  m <- NN.linear@fc1 x dim=FFN_DEC bias=true |> relu |> NN.linear@fc2 dim=MODEL_DIM bias=true
  return NN.layernorm@final_layer_norm (x + m) eps=EPS

fsmt :: TokenIds[B,SENC] -> ?Mask[B,SENC,SENC] -> TokenIds[B,SDEC] -> ?Mask[B,SDEC,SDEC] -> Tensor[B,SDEC,V]
fsmt input_ids attention_mask decoder_input_ids decoder_attention_mask = do
  attention_mask <- mask_for_input input_ids attention_mask SENC
  decoder_attention_mask <- mask_for_input decoder_input_ids decoder_attention_mask SDEC
  encoder_keep <- bidirectional_mask_for_input input_ids SENC padding_mask=attention_mask
  decoder_keep <- causal_mask_for_input decoder_input_ids SDEC padding_mask=decoder_attention_mask window=1048576
  cross_keep <- bidirectional_mask_for_input decoder_input_ids SENC padding_mask=attention_mask
  enc_nonpad <- Tensor.where (Tensor.eq input_ids PAD_ID) 0 1
  enc_pos_ids <- Tensor.cumsum enc_nonpad dim=-1
  enc_pos_ids <- Tensor.where (Tensor.cast enc_nonpad "bool") (enc_pos_ids + PAD_ID) PAD_ID
  enc_hidden <- NN.embedding@model.encoder.embed_tokens input_ids dim=MODEL_DIM scale=EMB_SCALE
  enc_hidden <- enc_hidden + sinusoidal_positions enc_hidden enc_pos_ids offset=0 padding_idx=PAD_ID
  enc_hidden <- for@model.encoder.layers i <- [0..L_ENC) carry (enc_hidden) do
    enc_hidden <- fsmt_encoder_layer enc_hidden encoder_keep
    yield enc_hidden
  dec_nonpad <- Tensor.where (Tensor.eq decoder_input_ids PAD_ID) 0 1
  dec_pos_ids <- Tensor.cumsum dec_nonpad dim=-1
  dec_pos_ids <- Tensor.where (Tensor.cast dec_nonpad "bool") (dec_pos_ids + PAD_ID) PAD_ID
  dec_hidden <- NN.embedding@model.encoder.embed_tokens decoder_input_ids dim=MODEL_DIM scale=EMB_SCALE
  dec_hidden <- dec_hidden + sinusoidal_positions dec_hidden dec_pos_ids offset=0 padding_idx=PAD_ID
  dec_hidden <- for@model.decoder.layers i <- [0..L_DEC) carry (dec_hidden) do
    dec_hidden <- fsmt_decoder_layer dec_hidden enc_hidden decoder_keep cross_keep
    yield dec_hidden
  return NN.linear@model.encoder.embed_tokens dec_hidden dim=TGT_VOCAB bias=false
