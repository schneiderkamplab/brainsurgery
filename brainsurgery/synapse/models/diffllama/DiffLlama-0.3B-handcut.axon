{-# CHECKPOINTS "kajuma/DiffLlama-0.3B-handcut" #-}

{-# TASK "causal_lm" #-}

{-# MAIN "diffllama" #-}

import Activations (silu)

import Attention (mask_to_additive, reshape_heads)

import Cache

import Config

import Masking (Mask, causal_mask_for_input, mask_for_input, mask_length_for_input)

import Math (exp, mul, sqrt)

import NN

import Params (has_root, param)

import Positions (position_ids, rope_freq_scale_factors_for_position_ids, rope_pair_base_factors)

import Tensor

MODEL_DIM <- (2048 :: Dim)

FFN <- (8192 :: Dim)

NUM_LAYERS <- (16 :: Dim)

NUM_HEADS <- (32 :: Dim)

KV_HEADS <- Config.dim @@num_key_value_heads default=NUM_HEADS

HEAD_DIM <- Config.dim @@head_dim default=(MODEL_DIM / NUM_HEADS)

QD <- NUM_HEADS * HEAD_DIM

KVD <- KV_HEADS * HEAD_DIM

VOCAB_SIZE <- (128256 :: Dim)

MAX_POSITIONS <- (131072 :: Dim)

EPS <- 1e-05

THETA <- 500000.0

ROPE_SCALE <- 32.0

ROPE_LOW_FREQ <- 1.0

ROPE_HIGH_FREQ <- 4.0

ROPE_CONTEXT <- Config.dim @@rope_scaling.original_max_position_embeddings default=MAX_POSITIONS

ATTENTION_BIAS <- false

HAS_LM_HEAD <- has_root "lm_head"

diffllama_attention :: Tensor[B,NUM_HEADS,S,HEAD_DIM] -> Tensor[B,KV_HEADS,K,HEAD_DIM] -> Tensor[B,KV_HEADS,K,HEAD_DIM] -> Tensor[B,1,S,K] -> Int -> Tensor[B,S,MODEL_DIM]
diffllama_attention q k v mask layer = do
  k <- Tensor.repeat k repeats=(NUM_HEADS / KV_HEADS)
  v <- Tensor.repeat v repeats=(NUM_HEADS / KV_HEADS)
  v1, v2 <- Tensor.chunk v dim=1 parts=2
  v <- Tensor.concat v1 v2 dim=-1
  v <- Tensor.concat v v dim=1
  scores <- Tensor.matmul q (Tensor.transpose k dim1=2 dim2=3)
  scores <- scores / (sqrt HEAD_DIM)
  scores <- scores + (mask_to_additive scores mask)
  probs <- Tensor.softmax scores dim=-1 dtype="float32"
  y <- Tensor.matmul probs v
  y1, y2 <- Tensor.chunk y dim=1 parts=2
  lambda_q1 <- ((param @lambda_q1) :: Tensor[HEAD_DIM])
  lambda_k1 <- ((param @lambda_k1) :: Tensor[HEAD_DIM])
  lambda_q2 <- ((param @lambda_q2) :: Tensor[HEAD_DIM])
  lambda_k2 <- ((param @lambda_k2) :: Tensor[HEAD_DIM])
  lambda_1 <- exp (Tensor.sum (lambda_q1 * lambda_k1) dim=-1)
  lambda_2 <- exp (Tensor.sum (lambda_q2 * lambda_k2) dim=-1)
  lambda_init <- 0.8 - (0.6 * exp (-0.3 * layer))
  y <- y1 - ((lambda_1 - lambda_2 + lambda_init) * y2)
  y <- NN.rmsnorm_noscale y eps=EPS dim=(2 * HEAD_DIM) cast_float=true
  y <- y * (1.0 - lambda_init)
  y <- Tensor.permute y dims=[0, 2, 1, 3]
  return Tensor.reshape y shape=[B, S, MODEL_DIM]

diffllama_block :: Tensor[B,S,D] -> Int -> Tensor[B,1,S,R] -> Tensor[B,1,S,R] -> Tensor[B,1,S,K] -> ?CacheLayer[B,KV_HEADS,P,MAX_POSITIONS,HEAD_DIM] -> (Tensor[B,S,D], ?CacheLayer[B,KV_HEADS,K,MAX_POSITIONS,HEAD_DIM])
diffllama_block x layer rope_sin rope_cos mask past_kv = do
  xn <- NN.rmsnorm@input_layernorm x eps=EPS cast_float=true
  a, new_kv <- scope@self_attn do
    q <- NN.linear@q_proj xn dim=QD bias=ATTENTION_BIAS |> reshape_heads heads=NUM_HEADS
    k <- NN.linear@k_proj xn dim=KVD bias=ATTENTION_BIAS |> reshape_heads heads=KV_HEADS
    v <- NN.linear@v_proj xn dim=KVD bias=ATTENTION_BIAS |> reshape_heads heads=KV_HEADS
    q, k <- rope_pair_base_factors q k rope_sin rope_cos
    k, v, new_kv <- Cache.update past_kv k v
    a <- diffllama_attention q k v mask layer
    return NN.linear@o_proj a dim=MODEL_DIM bias=ATTENTION_BIAS, new_kv
  x <- x + a
  xn <- NN.rmsnorm@post_attention_layernorm x eps=EPS cast_float=true
  m <- scope@mlp do
    gate <- NN.linear@gate_proj xn dim=FFN bias=false |> silu
    up <- NN.linear@up_proj xn dim=FFN bias=false
    return gate |> mul up |> NN.linear@down_proj dim=MODEL_DIM bias=false
  return x + m, new_kv

diffllama :: TokenIds[B,S] -> ?Mask[B,K,MAX_POSITIONS] -> ?Cache[B,KV_HEADS,P,MAX_POSITIONS,HEAD_DIM] -> ?Bool -> (Tensor[B,S,V], ?Cache[B,KV_HEADS,K,MAX_POSITIONS,HEAD_DIM])
diffllama input_ids attn_mask past_kv use_cache = do
  past_length <- Cache.past_length past_kv
  attn_mask <- mask_for_input input_ids attn_mask MAX_POSITIONS
  pos_ids <- position_ids input_ids attn_mask=attn_mask past_length=past_length pad_fill=1
  rope_sin, rope_cos <- rope_freq_scale_factors_for_position_ids pos_ids HEAD_DIM THETA ROPE_SCALE ROPE_LOW_FREQ ROPE_HIGH_FREQ ROPE_CONTEXT
  key_len <- mask_length_for_input input_ids attn_mask past_length
  mask <- causal_mask_for_input input_ids key_len padding_mask=attn_mask window=MAX_POSITIONS
  work_kv <- Cache.prepare past_kv use_cache MAX_POSITIONS
  read_kv <- Cache.read past_kv work_kv
  x, work_kv <- scope@model do
    x <- NN.embedding@embed_tokens input_ids dim=MODEL_DIM
    x, work_kv <- for@layers i <- [0..NUM_LAYERS) carry (x, work_kv) do
      past_i <- Cache.index read_kv i
      x, new_i <- diffllama_block x i rope_sin rope_cos mask past_i
      work_kv <- Cache.append work_kv new_i
      yield x, work_kv
    x <- NN.rmsnorm@norm x eps=EPS cast_float=true
    return x, work_kv
  new_kv <- Cache.finish work_kv key_len
  new_kv <- use_cache ? new_kv : null
  logits <- HAS_LM_HEAD ? (NN.linear@@lm_head x dim=VOCAB_SIZE bias=false) : (NN.linear@model.embed_tokens x dim=VOCAB_SIZE bias=false)
  return logits, new_kv
