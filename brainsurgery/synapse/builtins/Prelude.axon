attention :: Tensor[B,H,T,HD] -> Tensor[B,H,TK,HD] -> Tensor[B,H,TK,HD] -> Tensor[B,H,T,HD]
attention = _attention

attention_causal_scaled :: Tensor[B,H,T,HD] -> Tensor[B,H,TK,HD] -> Tensor[B,H,TK,HD] -> Float -> ?Bool -> Tensor[B,H,T,HD]
attention_causal_scaled q k v scale ?eager=false = _attention q k v scale=scale causal=true eager=eager

unsqueeze :: Tensor -> ?Int -> Tensor
