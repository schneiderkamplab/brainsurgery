mamba_scan :: Tensor -> Tensor -> Tensor -> Tensor -> ?Path -> ?Path -> ?Bool -> Tensor
mamba_scan u delta b c ?A="@A_log" ?D="@D" ?a_is_log=true = _mamba_scan u delta b c A=A D=D a_is_log=a_is_log

gemma4_per_layer_inputs :: Any -> Any -> ?Any -> ?Any -> ?Any -> ?Any -> ?Any -> ?Any -> Tensor
gemma4_per_layer_inputs input_ids hidden ?num_layers=null ?per_layer_dim=null ?embed_scale=null ?projection_scale=null ?combine_scale=null ?rms_eps=null = _gemma4_per_layer_inputs input_ids hidden num_layers=num_layers per_layer_dim=per_layer_dim embed_scale=embed_scale projection_scale=projection_scale combine_scale=combine_scale rms_eps=rms_eps

gemma4_per_layer_input_at :: Tensor -> Int -> Tensor
gemma4_per_layer_input_at x i = _gemma4_per_layer_input_at x i

position_ids :: TokenIds[B,T] -> ?Tensor[B,SM] -> ?Int -> ?Int -> Tensor[B,T]
position_ids x ?attn_mask=null ?past_length=0 ?pad_fill=0 = Positions.position_ids x attn_mask past_length pad_fill

rope_pair_base :: Tensor[B,HQ,T,HD] -> Tensor[B,HK,T,HD] -> Tensor[B,SM] -> ?Float -> ?Float -> ?Float -> ?Bool -> (Tensor[B,HQ,T,HD], Tensor[B,HK,T,HD])
rope_pair_base q k position_ids ?theta=10000.0 ?scale_factor=null ?partial_rotary_factor=null ?interleaved=false = Positions.rope_pair_base_basic q k position_ids theta scale_factor partial_rotary_factor interleaved

rope_pair_proportional :: Tensor[B,HQ,T,HD] -> Tensor[B,HK,T,HD] -> Tensor[B,SM] -> ?Float -> ?Float -> ?Float -> (Tensor[B,HQ,T,HD], Tensor[B,HK,T,HD])
rope_pair_proportional q k position_ids ?theta=10000.0 ?scale_factor=null ?partial_rotary_factor=1.0 = Positions.rope_pair_proportional_basic q k position_ids theta scale_factor partial_rotary_factor

rope_pair_freq_scale :: Tensor[B,H,T,HD] -> Tensor[B,H,T,HD] -> Tensor[B,SM] -> Float -> Float -> Float -> Float -> Int -> ?Bool -> (Tensor[B,H,T,HD], Tensor[B,H,T,HD])
rope_pair_freq_scale q k position_ids theta scale_factor low_freq_factor high_freq_factor original_context ?interleaved=false = Positions.rope_pair_freq_scale_basic q k position_ids theta scale_factor low_freq_factor high_freq_factor original_context interleaved

rope_pair_longrope :: Tensor[B,H,T,HD] -> Tensor[B,H,T,HD] -> Tensor[B,SM] -> Float -> Int -> Int -> Any -> Any -> ?Float -> ?Float -> ?Float -> ?Float -> ?Bool -> (Tensor[B,H,T,HD], Tensor[B,H,T,HD])
rope_pair_longrope q k position_ids theta original_context max_context long_factor short_factor ?attention_factor=null ?long_mscale=null ?short_mscale=null ?partial_rotary_factor=null ?interleaved=false = Positions.rope_pair_longrope_basic q k position_ids theta original_context max_context long_factor short_factor attention_factor long_mscale short_mscale partial_rotary_factor interleaved

rope_pair_yarn :: Tensor[B,H,T,HD] -> Tensor[B,H,T,HD] -> Tensor[B,SM] -> Float -> Float -> Float -> Float -> Int -> ?Float -> ?Float -> ?Bool -> (Tensor[B,H,T,HD], Tensor[B,H,T,HD])
rope_pair_yarn q k position_ids theta scale_factor beta_fast beta_slow original_context ?mscale=null ?mscale_all_dim=null ?interleaved=false = Positions.rope_pair_yarn_basic q k position_ids theta scale_factor beta_fast beta_slow original_context mscale mscale_all_dim interleaved

rope_pair_hf_yarn :: Tensor[B,H,T,HD] -> Tensor[B,H,T,HD] -> Tensor[B,SM] -> Float -> Float -> Float -> Float -> Int -> ?Float -> ?Bool -> ?Bool -> (Tensor[B,H,T,HD], Tensor[B,H,T,HD])
rope_pair_hf_yarn q k position_ids theta scale_factor low_freq_factor high_freq_factor original_context ?attention_factor=1.0 ?truncate=true ?interleaved=false = Positions.rope_pair_hf_yarn_basic q k position_ids theta scale_factor low_freq_factor high_freq_factor original_context attention_factor truncate interleaved

