import Derived (
  merge_heads_basic,
  position_ids_basic,
  rope_pair_base_basic,
  reshape_head_basic
)

linear :: @Path -> Tensor -> ?Int -> ?Bool -> ?Bool -> ?Int -> ?Path -> ?Path -> Tensor
linear@path x ?dim=null ?bias=false ?transpose=false ?expert=null ?weight_path=null ?bias_path=null = _linear@path x dim bias transpose expert weight_path bias_path

embedding :: @Path -> Tensor -> ?Int -> ?Float -> Tensor
embedding@path x ?dim=null ?scale=null = _embedding@path x dim scale

layernorm :: @Path -> Tensor -> ?Float -> ?Int -> ?Path -> ?Bool -> ?Path -> Tensor
layernorm@path x ?eps=1e-5 ?dim=null ?weight_path=null ?bias=true ?bias_path=null = _layernorm@path x eps dim weight_path bias bias_path

rmsnorm :: @Path -> Tensor -> ?Float -> ?Int -> ?Bool -> ?Bool -> ?Bool -> Tensor
rmsnorm@path x ?eps=1e-6 ?dim=null ?unit_offset=false ?cast_float=false ?with_scale=true = _rmsnorm@path x eps dim unit_offset cast_float with_scale

split :: Tensor[..S] -> ?Int -> ?List[Dim] -> List[Tensor[..S]]
split x ?dim=-1 ?sizes=null = _split x dim sizes

chunk :: Tensor[..S] -> ?Int -> ?Int -> List[Tensor[..S]]
chunk x ?dim=-1 ?parts=null = _chunk x dim parts

split_qkv_heads :: Tensor[B,T,D] -> (Tensor[B,H,T,HD], Tensor[B,H,T,HD], Tensor[B,H,T,HD])
split_qkv_heads = _split_qkv_heads

split_qkv_grouped :: Tensor[B,T,D] -> (Tensor[B,H,T,HD], Tensor[B,KVH,T,HD], Tensor[B,KVH,T,HD])
split_qkv_grouped = _split_qkv_grouped

reshape_heads :: Tensor[B,T,D] -> Int -> Tensor[B,H,T,HD]
reshape_heads x heads = reshape_head_basic x heads

merge_heads :: Tensor[B,H,T,HD] -> Tensor[B,T,D]
merge_heads = merge_heads_basic

permute :: Tensor -> ?Any -> Tensor
permute x ?dims=null = _permute x dims

transpose :: Tensor -> ?Int -> ?Int -> Tensor
transpose x ?dim1=1 ?dim2=2 = _transpose x dim1 dim2

reshape :: Any -> ?Any -> Tensor
reshape x ?shape=null = _reshape x shape

expand :: Tensor -> ?List[Dim] -> Tensor
expand x ?shape=null = _expand x shape

arange :: Tensor -> ?Int -> ?Int -> IdxTensor
arange x ?start=0 ?end=null = _arange x start end

sinusoidal_positions :: Tensor -> Tensor -> ?Float -> ?Int -> ?Int -> ?String -> Tensor
sinusoidal_positions ref position_ids ?theta=10000.0 ?offset=2 ?padding_idx=null ?mode=null = _sinusoidal_positions ref position_ids theta offset padding_idx mode

cast :: Tensor -> ?String -> Tensor
cast x ?dtype=null = _cast x dtype

cumsum :: Tensor -> ?Int -> Tensor
cumsum x ?dim=-1 = _cumsum x dim

causal_mask :: Tensor[B,H,T,HD] -> Tensor[B,H,TK,HD] -> Tensor[B,1,T,TK]
causal_mask = _causal_mask

blocksparse_mask :: Tensor[B,H,T,HD] -> Tensor[B,H,TK,HD] -> Tensor[B,H,T,TK]
blocksparse_mask = _blocksparse_mask

bidirectional_mask :: Tensor[B,H,T,HD] -> Tensor[B,H,TK,HD] -> Tensor[B,1,T,TK]
bidirectional_mask = _bidirectional_mask

attention :: Tensor[B,H,T,HD] -> Tensor[B,H,TK,HD] -> Tensor[B,H,TK,HD] -> Tensor[B,H,T,HD]
attention = _attention

position_ids :: TokenIds[B,T] -> ?Tensor[B,SM] -> ?Int -> ?Int -> Tensor[B,T]
position_ids x ?attn_mask=null ?past_length=0 ?pad_fill=0 = position_ids_basic x attn_mask=attn_mask past_length=past_length pad_fill=pad_fill

rope_pair :: Tensor[B,H,T,HD] -> Tensor[B,H,T,HD] -> (Tensor[B,H,T,HD], Tensor[B,H,T,HD])
rope_pair = _rope_pair

rope_pair_base :: Tensor[B,HQ,T,HD] -> Tensor[B,HK,T,HD] -> Tensor[B,SM] -> ?Float -> (Tensor[B,HQ,T,HD], Tensor[B,HK,T,HD])
rope_pair_base q k position_ids ?theta=10000.0 = rope_pair_base_basic q k position_ids theta

linear_position_bias :: Tensor[B,T] -> Tensor[B,H,1,T]
linear_position_bias = _linear_position_bias

repeat :: Tensor[B,KVH,T,HD] -> ?Int -> ?Int -> Tensor[B,H,T,HD]
repeat x ?repeats=2 ?dim=1 = _repeat x repeats dim

mul :: Tensor[B,T,D] -> Tensor[B,T,D] -> Tensor[B,T,D]
mul = _mul

concat :: Tensor -> Tensor -> ?Int -> Tensor
concat x y ?dim=-1 = _concat x y dim=dim

matmul :: Tensor -> Tensor -> Tensor
matmul = _matmul

eq :: Tensor -> Tensor -> Tensor
eq = _eq

le :: Tensor -> Tensor -> Tensor
le = _le

and :: Tensor -> Tensor -> Tensor
and = _and

where :: Tensor -> Any -> Any -> Tensor
where = _where

masked_fill :: Tensor -> Tensor -> Tensor -> Tensor
masked_fill x mask value = where mask value x

slice :: Tensor -> ?Int -> ?Int -> ?Int -> Tensor
slice x ?dim=null ?start=null ?end=null = _slice x dim start end

sqrt :: Float -> Float
sqrt = _sqrt

softmax :: Tensor -> ?Int -> ?String -> Tensor
softmax x ?dim=-1 ?dtype=null = _softmax x dim dtype

topk :: Tensor[B,T,D] -> Int -> ?Int -> ?Bool -> ?Bool -> (Tensor[B,T,K], Tensor[B,T,K])
topk x k ?dim=-1 ?largest=true ?sorted=true = _topk x k dim largest sorted

dtype_value :: Tensor -> String -> Float
dtype_value x kind = _dtype_value x kind

empty_like :: Tensor -> ?String -> Tensor
empty_like x ?dtype=null = _empty_like x dtype

fill :: Tensor -> Any -> ?String -> Tensor
fill x value ?dtype=null = _fill x value dtype

gather :: Tensor -> IdxTensor -> ?Int -> Tensor
gather x index ?dim=-1 = _gather x index dim

scatter :: Tensor -> IdxTensor -> Any -> ?Int -> Tensor
scatter x index src ?dim=-1 = _scatter x index src dim

zeros_like :: Tensor[B,T,D] -> Tensor[B,T,D]
zeros_like = _zeros_like

min_like :: Tensor[B,T,D] -> Tensor[B,T,D]
min_like x = do
  min_val <- dtype_value x "min"
  return fill (empty_like x) min_val
