import Derived (
  merge_heads_basic,
  reshape_head_basic,
)
import List
import Params
import Positions
import Tensor

linear :: @Path -> Tensor -> ?Int -> ?Bool -> ?Bool -> ?Int -> ?Path -> ?Path -> Tensor
linear@path x ?dim=null ?bias=false ?transpose=false ?expert=null ?weight_path=@weight ?bias_path=@bias = _linear@path x dim bias transpose expert weight_path bias_path

param_scale :: Tensor -> ?Path -> Tensor
param_scale x ?scale_path=@layer_scalar = Params.param_scale x scale_path=scale_path

embedding :: @Path -> Tensor -> ?Int -> ?Float -> Tensor
embedding@path x ?dim=null ?scale=null = do
  y <- _embedding@path x dim
  return (scale == null) ? y : (y * scale)

layernorm :: @Path -> Tensor -> ?Float -> ?Int -> ?Path -> ?Bool -> ?Path -> Tensor
layernorm@path x ?eps=1e-5 ?dim=null ?weight_path=@weight ?bias=true ?bias_path=@bias = _layernorm@path x eps dim weight_path bias bias_path

rmsnorm :: @Path -> Tensor -> ?Float -> ?Int -> ?Bool -> ?Bool -> ?Bool -> ?Path -> Tensor
rmsnorm@path x ?eps=1e-6 ?dim=null ?unit_offset=false ?cast_float=false ?with_scale=true ?scale_path=@weight = do
  y0 <- _rmsnorm@path x eps dim cast_float
  y <- with_scale ? (Params.param_scale y0 scale_path=scale_path) : y0
  return ((unit_offset and with_scale) == false) ? y : (y + y0)

split :: Tensor[..S] -> ?Int -> ?List[Dim] -> List[Tensor[..S]]
split x ?dim=-1 ?sizes=null = Tensor.split x dim sizes

chunk :: Tensor[..S] -> ?Int -> ?Int -> List[Tensor[..S]]
chunk x ?dim=-1 ?parts=null = Tensor.chunk x dim parts

split_qkv_heads :: Tensor[B,T,D] -> (Tensor[B,H,T,HD], Tensor[B,H,T,HD], Tensor[B,H,T,HD])
split_qkv_heads = _split_qkv_heads

split_qkv_grouped :: Tensor[B,T,D] -> (Tensor[B,H,T,HD], Tensor[B,KVH,T,HD], Tensor[B,KVH,T,HD])
split_qkv_grouped = _split_qkv_grouped

reshape_heads :: Tensor[B,T,D] -> Int -> Tensor[B,H,T,HD]
reshape_heads x heads = reshape_head_basic x heads

merge_heads :: Tensor[B,H,T,HD] -> Tensor[B,T,D]
merge_heads = merge_heads_basic

permute :: Tensor -> ?Any -> Tensor
permute x ?dims=null = Tensor.permute x dims

transpose :: Tensor -> ?Int -> ?Int -> Tensor
transpose x ?dim1=1 ?dim2=2 = Tensor.transpose x dim1 dim2

reshape :: Any -> ?Any -> Tensor
reshape x ?shape=null = Tensor.reshape x shape

shape :: Tensor -> List[Int]
shape x = Tensor.shape x

size :: Tensor -> Int -> Int
size x dim = Tensor.size x dim

expand :: Tensor -> ?List[Dim] -> Tensor
expand x ?shape=null = Tensor.expand x shape

arange :: Tensor -> ?Int -> ?Int -> IdxTensor
arange x ?start=0 ?end=null = Tensor.arange x start end

sinusoidal_positions :: Tensor -> Tensor -> ?Float -> ?Int -> ?Int -> ?String -> Tensor
sinusoidal_positions ref position_ids ?theta=10000.0 ?offset=2 ?padding_idx=null ?mode=null = _sinusoidal_positions ref position_ids theta offset padding_idx mode

cast :: Tensor -> ?String -> Tensor
cast x ?dtype=null = Tensor.cast x dtype

cast_like :: Tensor -> Tensor -> Tensor
cast_like x ref = Tensor.cast_like x ref

tensor_like :: Any -> Tensor -> ?String -> Tensor
tensor_like value ref ?dtype=null = Tensor.tensor_like value ref dtype

cumsum :: Tensor -> ?Int -> Tensor
cumsum x ?dim=-1 = Tensor.cumsum x dim

causal_mask :: Tensor[B,H,T,HD] -> Tensor[B,H,TK,HD] -> Tensor[B,1,T,TK]
causal_mask = _causal_mask

