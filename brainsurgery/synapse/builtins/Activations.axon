gelu :: Tensor[B,T,D] -> Tensor[B,T,D]
gelu = _activations_gelu

gelu_new :: Tensor[B,T,D] -> Tensor[B,T,D]
gelu_new = _activations_gelu_new

gelu_fast :: Tensor[B,T,D] -> Tensor[B,T,D]
gelu_fast = _activations_gelu_new

gelu_pytorch_tanh :: Tensor[B,T,D] -> Tensor[B,T,D]
gelu_pytorch_tanh = _activations_gelu_pytorch_tanh

gegelu :: Tensor[B,T,D] -> Tensor[B,T,D]
gegelu = _activations_gegelu

gegelu_limit :: Tensor[B,T,D] -> Float -> Tensor[B,T,D]
gegelu_limit x limit = _activations_gegelu x limit=limit

relu :: Tensor[B,T,D] -> Tensor[B,T,D]
relu = _activations_relu

relu2 :: Tensor[B,T,D] -> Tensor[B,T,D]
relu2 = _activations_relu2

sigmoid :: Tensor[B,T,D] -> Tensor[B,T,D]
sigmoid = _activations_sigmoid

tanh :: Tensor[B,T,D] -> Tensor[B,T,D]
tanh = _activations_tanh

silu :: Tensor[B,T,D] -> Tensor[B,T,D]
silu = _activations_silu

swiglu :: Tensor[B,T,D] -> Tensor[B,T,D]
swiglu = _activations_swiglu

xielu :: @Path -> Tensor[B,T,D] -> Tensor[B,T,D]
xielu@path x = _activations_xielu@path x
