import Params (param)
export (gegelu, gelu, gelu_new, gelu_pytorch_tanh, relu, relu2, sigmoid, silu, tanh, xielu)

gelu :: Tensor[B,T,D] -> Tensor[B,T,D]
gelu = _activations_gelu

gelu_new :: Tensor[B,T,D] -> Tensor[B,T,D]
gelu_new = _activations_gelu_new

gelu_pytorch_tanh :: Tensor[B,T,D] -> Tensor[B,T,D]
gelu_pytorch_tanh = _activations_gelu_pytorch_tanh

gegelu :: Tensor[B,T,D] -> ?Float -> Tensor[B,T,D]
gegelu x ?limit=null = _activations_gegelu x limit

relu :: Tensor[B,T,D] -> Tensor[B,T,D]
relu = _activations_relu

relu2 :: Tensor[B,T,D] -> Tensor[B,T,D]
relu2 = _activations_relu2

sigmoid :: Tensor[B,T,D] -> Tensor[B,T,D]
sigmoid = _activations_sigmoid

tanh :: Tensor[B,T,D] -> Tensor[B,T,D]
tanh = _activations_tanh

silu :: Tensor[B,T,D] -> Tensor[B,T,D]
silu = _activations_silu

swiglu :: Tensor[B,T,D] -> Tensor[B,T,D]
swiglu = _activations_swiglu

xielu :: @Path -> Tensor[B,T,D] -> ?Path -> ?Path -> ?Path -> ?Path -> ?Path -> Tensor[B,T,D]
xielu@path x ?alpha_p_path="alpha_p" ?alpha_n_path="alpha_n" ?beta_path="beta" ?eps_path="eps" ?prefix_path=null = do
  prefix <- (prefix_path == null) ? path : prefix_path
  alpha_p <- param alpha_p_path prefix_path=prefix
  alpha_n <- param alpha_n_path prefix_path=prefix
  beta <- param beta_path prefix_path=prefix
  eps <- param eps_path prefix_path=prefix
  return _activations_xielu x alpha_p alpha_n beta eps
