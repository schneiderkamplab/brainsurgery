import Masking (
  StaticMask,
  static_causal_mask_for_input_active,
  static_mask_for_input,
  static_mask_length,
)
import Tensor

export (
  Mask,
  causal_mask_for_input,
  mask_for_input,
  mask_length_for_input,
)

type Mask[B,K,C] = StaticMask[B,C]

mask_for_input :: Tensor[B,Q] -> ?Mask[B,K,C] -> Dim -> Mask[B,K,C]
mask_for_input x mask capacity = static_mask_for_input x mask capacity

mask_length_for_input :: Tensor[B,Q] -> ?Mask[B,K,C] -> Dim -> Dim
mask_length_for_input x mask past_length = static_mask_length mask

causal_mask_for_input :: Tensor[B,Q] -> Dim -> ?Mask[B,K,C] -> ?Dim -> Tensor[B,1,Q,K]
causal_mask_for_input x key_length ?padding_mask=null ?window=null = static_causal_mask_for_input_active x padding_mask window=window
