import List
import Tensor
export (
  append,
  index,
  init,
  past_length,
  update,
)

type CacheLayer = (Tensor[B,H,T,DH], Tensor[B,H,T,DH])
type Cache = List[CacheLayer]

update :: ?CacheLayer -> Tensor[B,H,T,DH] -> Tensor[B,H,T,DH] -> (Tensor[B,H,T,DH], Tensor[B,H,T,DH], ?CacheLayer)
update past k v = (past == null)
  ? do
    return k, v, (k, v)
  : do
    k_past, v_past <- past
    k_all <- Tensor.concat k_past k dim=-2
    v_all <- Tensor.concat v_past v dim=-2
    return k_all, v_all, (k_all, v_all)

init :: Cache
init = List.init

index :: ?Cache -> Int -> ?CacheLayer
index values i = (values == null) ? null : List.index values i

append :: ?Cache -> ?CacheLayer -> ?Cache
append values value = (values == null) ? null : ((value == null) ? values : List.append values value)

past_length :: ?Cache -> Int
past_length cache = (cache == null) ? 0 : do k, _ <- List.index cache 0; return Tensor.size k -2
