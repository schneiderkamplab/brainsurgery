import Math (clamp, floor)
import Tensor (
  and,
  arange,
  cast,
  dtype_value,
  eq,
  expand,
  gather,
  le,
  reshape,
  size,
  slice,
  where,
)

export (
  Mask,
  banded_mask_for_input,
  banded_positions_for_input,
  bidirectional_mask_for_input,
  blocksparse_mask,
  causal_mask_for_input,
  mask_for_input,
  mask_length_for_input,
)

type Mask[B,K,C] = (Tensor[B,C], Dim)

mask_values :: Tensor[B,Q] -> Dim -> Tensor[B,C]
mask_values x capacity = do
  ids <- arange x start=0 end=capacity
  values <- le ids capacity
  values <- reshape values shape=[1, capacity]
  return expand values shape=[B, capacity]

mask_for_input :: Tensor[B,Q] -> ?Mask[B,K,C] -> Dim -> Mask[B,K,C]
mask_for_input x mask capacity = (mask == null)
  ? do
    values <- mask_values x capacity
    return ((values, Q) :: Mask[B,K,C])
  : (mask :: Mask[B,K,C])

mask_length_for_input :: Tensor[B,Q] -> ?Mask[B,K,C] -> Dim -> Dim
mask_length_for_input x mask past_length = (mask == null) ? 0 : do
  _, length <- mask
  return length

causal_mask_for_input_keep :: Tensor[B,Q] -> Mask[B,K,C] -> ?Dim -> Tensor[B,1,Q,C]
causal_mask_for_input_keep x mask ?window=null = do
  _, length <- mask
  row_ids <- arange x start=0 end=Q |> reshape shape=[Q, 1]
  col_ids <- arange x start=0 end=C |> reshape shape=[1, C]
  aligned <- row_ids + (length - Q)
  upper <- le col_ids aligned
  valid <- le col_ids (length - 1)
  causal <- and upper valid
  keep_window <- (window == null) ? causal : (and causal (le (aligned - window + 1) col_ids))
  keep <- reshape keep_window shape=[1, 1, Q, C]
  return expand keep shape=[B, 1, Q, C]

causal_mask_for_input_masked :: Tensor[B,Q] -> Mask[B,K,C] -> ?Dim -> Tensor[B,1,Q,C]
causal_mask_for_input_masked x mask ?window=null = do
  values, length <- mask
  keep <- causal_mask_for_input_keep x mask window=window
  pad_keep <- cast values dtype="bool" |> reshape shape=[B, 1, 1, C]
  masked_keep <- and keep pad_keep
  query_keep <- slice values dim=-1 start=(length - Q) end=length |> cast dtype="bool" |> reshape shape=[B, 1, Q, 1]
  col_ids <- arange x start=0 end=C |> reshape shape=[1, 1, 1, C]
  dummy_keep <- and (eq col_ids 0) (eq query_keep false)
  return where dummy_keep true masked_keep

causal_mask_for_input :: Tensor[B,Q] -> Dim -> ?Mask[B,K,C] -> ?Dim -> Tensor[B,1,Q,C]
causal_mask_for_input x key_length ?padding_mask=null ?window=null = (padding_mask == null)
  ? do
    values <- mask_values x C
    mask <- ((values, key_length) :: Mask[B,K,C])
    return causal_mask_for_input_keep x mask window=window
  : causal_mask_for_input_masked x padding_mask window=window

bidirectional_mask_for_input_keep :: Tensor[B,Q] -> Mask[B,K,C] -> ?Dim -> Tensor[B,1,Q,C]
bidirectional_mask_for_input_keep x mask ?window=null = do
  _, length <- mask
  row_ids <- arange x start=0 end=Q |> reshape shape=[Q, 1]
  col_ids <- arange x start=0 end=C |> reshape shape=[1, C]
  valid <- le col_ids (length - 1)
  keep_window <- (window == null)
    ? (expand valid shape=[Q, C])
    : do
      aligned <- row_ids + (length - Q)
      return and valid (and (le col_ids (aligned + window)) (le (aligned - window) col_ids))
  keep <- reshape keep_window shape=[1, 1, Q, C]
  return expand keep shape=[B, 1, Q, C]

bidirectional_mask_for_input_masked :: Tensor[B,Q] -> Mask[B,K,C] -> ?Dim -> Tensor[B,1,Q,C]
bidirectional_mask_for_input_masked x mask ?window=null = do
  values, _ <- mask
  keep <- bidirectional_mask_for_input_keep x mask window=window
  pad_keep <- cast values dtype="bool" |> reshape shape=[B, 1, 1, C]
  return and keep pad_keep

bidirectional_mask_for_input :: Tensor[B,Q] -> Dim -> ?Mask[B,K,C] -> ?Dim -> Tensor[B,1,Q,C]
bidirectional_mask_for_input x key_length ?padding_mask=null ?window=null = (padding_mask == null)
  ? do
    values <- mask_values x C
    mask <- ((values, key_length) :: Mask[B,K,C])
    return bidirectional_mask_for_input_keep x mask window=window
  : bidirectional_mask_for_input_masked x padding_mask window=window

-- Band position for query row t, slot w: pos[t, w] = t + w - left, with
-- w in [0, left + right + 1). Out-of-range slots are clamped into [0, S); the
-- paired validity mask kills the clamped duplicates.
banded_positions_for_input :: Tensor[B,Q] -> Dim -> Dim -> Dim -> (IdxTensor[S,W], Tensor[S,W])
banded_positions_for_input x S left right = do
  w <- ((left + right + 1) :: Dim)
  row_ids <- arange x start=0 end=S |> reshape shape=[S, 1]
  offsets <- arange x start=0 end=w |> reshape shape=[1, w]
  pos <- (row_ids + offsets) - left
  valid <- and (le 0 pos) (le pos (S - 1))
  pos_c <- clamp pos min=0 max=(S - 1)
  return (pos_c, valid)

-- Clamped band positions plus the combined keep mask: geometric validity ∧
-- key-side padding validity gathered at the clamped positions (queries are
-- never masked).
banded_mask_for_input :: Tensor[B,Q] -> Dim -> Dim -> Dim -> ?Mask[B,K,C] -> (IdxTensor[S,W], Tensor[B,S,W])
banded_mask_for_input x S left right ?padding_mask=null = do
  pos_c, valid <- banded_positions_for_input x S left right
  w <- ((left + right + 1) :: Dim)
  geo <- reshape valid shape=[1, S, w]
  keep <- (padding_mask == null)
    ? (expand geo shape=[B, S, w])
    : do
      values, _ <- padding_mask
      sw <- ((S * w) :: Dim)
      idx <- reshape pos_c shape=[1, sw] |> expand shape=[B, sw]
      pad_keep <- cast values dtype="bool"
      pad_win <- gather pad_keep idx -1 |> reshape shape=[B, S, w]
      return and geo pad_win
  return (pos_c, keep)

blocksparse_mask :: Tensor[B,H,Q,HD] -> Tensor[B,H,K,HD] -> ?Mask[B,KM,K] -> ?Dim -> ?Dim -> ?Dim -> ?Bool -> Tensor[B,H,Q,K]
blocksparse_mask q k ?padding_mask=null ?block_size=64 ?local_blocks=16 ?vert_stride=8 ?homo_head=false = do
  q_len <- size q dim=2
  k_len <- size k dim=2
  shift <- ((k_len - q_len) > 0) ? (k_len - q_len) : 0
  q_pos <- arange q start=0 end=q_len |> reshape shape=[q_len, 1]
  q_pos <- q_pos + shift
  k_pos <- arange k start=0 end=k_len |> reshape shape=[1, k_len]
  q_block <- floor (q_pos / block_size)
  k_block <- floor (k_pos / block_size)
  causal_token <- le k_pos q_pos
  causal_block <- le k_block q_block
  local_block <- le (q_block - (local_blocks - 1)) k_block
  keep <- homo_head
    ? do
      strided <- eq ((k_block + 1) % vert_stride) 0 |> expand shape=[q_len, k_len]
      local_or <- where local_block true strided
      keep_homo <- and causal_block local_or
      return reshape keep_homo shape=[1, 1, q_len, k_len]
    : do
      head_step_raw <- floor (vert_stride / (((H > 0) ? H : 1)))
      head_step <- (head_step_raw > 0) ? head_step_raw : 1
      head_idx <- arange q start=0 end=H |> reshape shape=[H, 1, 1]
      k_block_h <- reshape k_block shape=[1, 1, k_len]
      strided <- eq ((k_block_h + (head_idx * head_step) + 1) % vert_stride) 0 |> expand shape=[H, q_len, k_len]
      local_h <- reshape local_block shape=[1, q_len, k_len] |> expand shape=[H, q_len, k_len]
      causal_h <- reshape causal_block shape=[1, q_len, k_len] |> expand shape=[H, q_len, k_len]
      local_or <- where local_h true strided
      keep_h <- and causal_h local_or
      return reshape keep_h shape=[1, H, q_len, k_len]
  keep <- and keep (reshape causal_token shape=[1, 1, q_len, k_len])
  keep <- expand keep shape=[B, H, q_len, k_len]
  keep <- (padding_mask == null)
    ? keep
    : do
      values, _ <- padding_mask
      pad_keep <- cast values dtype="bool" |> reshape shape=[B, 1, 1, k_len]
      return and keep pad_keep
  return where keep 0.0 (dtype_value q "min")
