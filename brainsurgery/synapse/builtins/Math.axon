export (
  PI,
  add,
  clamp,
  cos,
  div,
  exp,
  floor,
  log,
  mul,
  pow,
  sin,
  sqrt,
)

PI = 3.141592653589793

add :: Any -> Any -> Any
add = _add

div :: Any -> Any -> Any
div = _div

mul :: Any -> Any -> Any
mul = _mul

pow :: Any -> Any -> Any
pow = _pow

exp :: T -> T
exp = _exp

log :: T -> T
log = _log

floor :: T -> T
floor = _floor

sin :: T -> T
sin = _sin

cos :: T -> T
cos = _cos

sqrt :: Float -> Float
sqrt = _sqrt

clamp :: Tensor -> ?Float -> ?Float -> Tensor
clamp x ?min=null ?max=null = _clamp x min max
