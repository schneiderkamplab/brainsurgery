import Activations (sigmoid, silu)
import Math (clamp, log, mul)
import NN linear
import Params param
import Tensor (
  cast,
  cast_like,
  chunk,
  concat,
  cumsum,
  deinterleave_last2,
  dtype_value,
  eq,
  expand,
  gather,
  index_add,
  le,
  reshape,
  scatter,
  size,
  slice,
  softmax,
  topk,
  transpose,
  unsqueeze,
  where,
  where_indices,
  zeros_like,
)
export (
  grouped_sigmoid_router,
  grouped_swiglu_ffn_basic,
  scatter_add,
  select,
  sigmoid_topk_router,
  softmax_topk_router,
  sparsemixer_router,
)

grouped_sigmoid_router :: Path -> Tensor[B,S,D] -> Dim -> ?Dim -> ?Dim -> ?Bool -> ?Float -> ?Path -> ?Path -> (Tensor[B,S,TOPK], IdxTensor[B,S,TOPK])
grouped_sigmoid_router@path x top_k ?n_group=1 ?topk_group=1 ?norm_topk_prob=true ?routed_scaling_factor=1.0 ?weight=@weight ?e_score_correction_bias=@e_score_correction_bias = do
  x32 <- cast x dtype="float32"
  logits <- linear@path x32 dim=null bias=false weight_path=weight
  probs <- sigmoid logits
  b <- size probs 0
  s <- size probs 1
  e <- size probs 2
  eps <- e / n_group
  corr <- param path=e_score_correction_bias |> cast_like probs
  corr <- reshape corr shape=[1, 1, e] |> expand shape=[b, s, e]
  scores <- probs + corr

  group_scores <- (eps == 1)
    ? (reshape scores shape=[b, s, n_group])
    : (do
      top2, _ <- reshape scores shape=[b, s, n_group, eps] |> topk 2 -1 true false
      a, b2 <- chunk top2 parts=2
      a <- reshape a shape=[b, s, n_group]
      b2 <- reshape b2 shape=[b, s, n_group]
      return a + b2
    )
  _, group_idx <- topk group_scores topk_group -1 true false
  one <- 1.0
  group_keep <- zeros_like group_scores |> scatter group_idx one -1
  score_mask <- unsqueeze group_keep -1 |> expand shape=[b, s, n_group, eps] |> reshape shape=[b, s, e]
  masked <- where (eq score_mask 1.0) scores (zeros_like scores)
  _, topk_indices <- topk masked top_k -1 true false
  topk_weights <- gather probs topk_indices -1
  topk_weights <- norm_topk_prob
    ? (topk_weights |> log |> softmax dim=-1 dtype="float32")
    : topk_weights
  topk_weights <- (topk_weights * routed_scaling_factor) |> cast_like x
  return topk_weights, topk_indices

select :: Tensor[B,T,D] -> Tensor[B,T,K] -> Tensor[B,T,K] -> Int -> (Tensor[N,D], Tensor[N], Tensor[N], Tensor[N])
select hidden topk_scores topk_indices expert = do
  bt <- B * T
  hidden_flat <- reshape hidden shape=[bt, D]
  topk_scores_flat <- reshape topk_scores shape=[bt, K]
  topk_indices_flat <- reshape topk_indices shape=[bt, K]
  mask <- eq topk_indices_flat expert
  topk_pos, token_idx <- mask |> transpose 0 1 |> where_indices
  n <- size token_idx 0
  token_idx_col <- unsqueeze token_idx 1
  token_idx_d <- expand token_idx_col shape=[n, D]
  token_idx_k <- expand token_idx_col shape=[n, K]
  selected_hidden <- gather hidden_flat token_idx_d 0
  selected_scores_all <- gather topk_scores_flat token_idx_k 0
  selected_scores <- gather selected_scores_all (unsqueeze topk_pos 1) 1 |> reshape shape=[n]
  return selected_hidden, token_idx, topk_pos, selected_scores

scatter_add :: Tensor[B,T,D] -> Tensor[N] -> Tensor[N,D] -> Tensor[N] -> Tensor[B,T,D]
scatter_add accum token_idx updates scores = do
  b <- size accum 0
  t <- size accum 1
  d <- size accum 2
  btd <- b * t
  accum_flat <- reshape accum shape=[btd, d]
  weighted <- unsqueeze scores 1 |> mul updates
  accum_flat <- index_add accum_flat token_idx weighted 0
  return reshape accum_flat shape=[b, t, d]

softmax_topk_router :: Path -> Tensor[B,S,D] -> Dim -> ?Float -> ?Path -> (Tensor[B,S,top_k], IdxTensor[B,S,top_k])
softmax_topk_router@path x top_k ?routed_scaling_factor=1.0 ?weight=@weight = do
  x32 <- cast x dtype="float32"
  logits <- linear@path x32 dim=null bias=false weight_path=weight
  probs <- softmax logits -1 "float32"
  topk_weights, topk_indices <- topk probs top_k -1 true false
  denom <- cumsum topk_weights dim=-1 |> slice dim=-1 start=(top_k - 1) end=top_k
  topk_weights <- topk_weights / denom
  topk_weights <- cast_like topk_weights x
  return (topk_weights * routed_scaling_factor), topk_indices

sigmoid_topk_router :: Path -> Tensor[B,S,D] -> Dim -> ?Path -> (Tensor[B,S,top_k], IdxTensor[B,S,top_k])
sigmoid_topk_router@path x top_k ?weight=@weight = do
  x32 <- cast x dtype="float32"
  logits <- linear@path x32 dim=null bias=false weight_path=weight
  topk_logits, topk_indices <- topk logits top_k -1 true false
  topk_weights <- sigmoid topk_logits |> cast_like x
  return topk_weights, topk_indices

grouped_swiglu_ffn_basic :: Tensor[B,T,D] -> Tensor[B,T,K] -> Tensor[B,T,K] -> Dim -> ?Path -> ?Path -> ?Bool -> ?Bool -> Tensor[B,T,D]
grouped_swiglu_ffn_basic hidden topk_scores topk_indices experts ?gate_up_weight=@experts.gate_up_proj ?out_weight=@experts.down_proj ?transpose=false ?pre_scale_input=false = do
  routed <- hidden * 0.0
  routed <- for e <- [0..experts) carry (routed) do
    x_sel, token_idx, topk_pos, sel_scores <- select hidden topk_scores topk_indices e
    sel_scale <- unsqueeze sel_scores 1
    x_in <- pre_scale_input ? (x_sel * sel_scale) : x_sel
    gate_up <- linear@w1 x_in dim=null bias=false transpose=transpose expert=e weight_path=gate_up_weight
    gate, up <- chunk gate_up parts=2
    x_upd <- gate |> silu |> mul up |> linear@w2 dim=null bias=false transpose=transpose expert=e weight_path=out_weight
    out_scores <- pre_scale_input ? ((sel_scores * 0.0) + 1.0) : sel_scores
    routed <- scatter_add routed token_idx x_upd out_scores
    yield routed
  return routed

sparsemixer_router :: Tensor[B,S,D] -> Dim -> ?Float -> (Tensor[B,S,2], IdxTensor[B,S,2])
sparsemixer_router x experts ?jitter_eps=0.01 = do
  logits <- linear@gate x dim=experts bias=false
  neg_inf <- dtype_value logits "min"
  max1, _ <- topk logits 1 -1 true false
  abs_logits <- where (le logits 0.0) (logits * -1.0) logits
  factor1 <- where (le abs_logits max1) max1 abs_logits
  ratio1 <- (max1 - logits) / factor1
  keep1 <- le ratio1 (2.0 * jitter_eps)
  masked1 <- where keep1 logits neg_inf
  probs_1 <- softmax masked1 -1 "float32"
  _, top1_idx <- topk masked1 1 -1 true false
  top1_scores <- gather probs_1 top1_idx -1
  masked_scores <- scatter logits top1_idx neg_inf -1
  max2, top2_idx <- topk masked_scores 1 -1 true false
  factor2 <- where (le abs_logits max2) max2 abs_logits
  ratio2 <- (max2 - logits) / factor2
  keep2 <- le ratio2 (2.0 * jitter_eps)
  masked2 <- where keep2 masked_scores neg_inf
  probs_2 <- softmax masked2 -1 "float32"
  top2_scores <- gather probs_2 top2_idx -1
  topk_scores <- concat top1_scores top2_scores dim=-1
  topk_indices <- concat top1_idx top2_idx dim=-1
  return topk_scores, topk_indices
