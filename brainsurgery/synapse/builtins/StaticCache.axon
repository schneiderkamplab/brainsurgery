import List
import Tensor
export (
  append,
  append_kv,
  finish,
  finish_kv,
  index,
  index_kv,
  init,
  init_kv,
  past_length,
  past_length_kv,
  prepare,
  prepare_kv,
  read,
  read_kv,
  update,
  update_kv,
)

type CacheEntries = List[?Any]
type CacheLayer[B,H,T,C,DH] = (?Tensor[B,H,C,DH], ?Tensor[B,H,C,DH], Dim, Dim)
type Cache[B,H,T,C,DH] = (CacheEntries, CacheEntries, Dim, Dim)
type CacheLayerKV[B,H,T,DK,DV] = (?Tensor[B,H,T,DK], ?Tensor[B,H,T,DV], Dim, Dim)
type CacheKV[B,H,T,DK,DV] = (CacheEntries, CacheEntries, Dim, Dim)

init :: Dim -> Cache[B,H,T,C,DH]
init capacity = (List.init, List.init, 0, capacity)

init_kv :: Dim -> CacheKV[B,H,T,DK,DV]
init_kv capacity = (List.init, List.init, 0, capacity)

prepare :: ?Cache[B,H,P,C,DH] -> ?Bool -> Dim -> ?Cache[B,H,K,C,DH]
prepare past use_cache capacity = (use_cache == null or use_cache == false) ? null : ((past == null) ? ((List.init, List.init, 0, capacity) :: Cache[B,H,K,C,DH]) : do
  read_layers, _, length, old_capacity <- past
  return (read_layers, List.init, length, old_capacity)
)

prepare_kv :: ?CacheKV[B,H,T,DK,DV] -> ?Bool -> Dim -> CacheKV[B,H,T,DK,DV]
prepare_kv past use_cache capacity = (past == null) ? ((List.init, List.init, 0, capacity) :: CacheKV[B,H,T,DK,DV]) : do
  read_layers, _, length, old_capacity <- past
  return (read_layers, List.init, length, old_capacity)

read :: ?Cache[B,H,P,C,DH] -> ?Cache[B,H,K,C,DH] -> ?Cache[B,H,P,C,DH]
read past work = work

read_kv :: ?CacheKV[B,H,T,DK,DV] -> CacheKV[B,H,T,DK,DV] -> CacheKV[B,H,T,DK,DV]
read_kv past work = work

past_length :: ?Cache[B,H,T,C,DH] -> Dim
past_length cache = (cache == null) ? 0 : do
  _, _, length, _ <- cache
  return length

past_length_kv :: ?CacheKV[B,H,T,DK,DV] -> Dim
past_length_kv cache = (cache == null) ? 0 : do
  _, _, length, _ <- cache
  return length

index_nonnull :: Cache[B,H,T,C,DH] -> Int -> ?CacheLayer[B,H,T,C,DH]
index_nonnull cache i = do
  read_layers, _, length, capacity <- cache
  n <- List.length read_layers
  return ((i >= n)
    ? ((null, null, length, capacity) :: CacheLayer[B,H,T,C,DH])
    : ((List.index read_layers i) :: CacheLayer[B,H,T,C,DH]))

index :: ?Cache[B,H,T,C,DH] -> Int -> ?CacheLayer[B,H,T,C,DH]
index cache i = (cache == null)
  ? (null :: ?CacheLayer[B,H,T,C,DH])
  : ((index_nonnull cache i) :: ?CacheLayer[B,H,T,C,DH])

index_kv :: CacheKV[B,H,T,DK,DV] -> Int -> CacheLayerKV[B,H,T,DK,DV]
index_kv cache i = do
  read_layers, _, length, capacity <- cache
  n <- List.length read_layers
  return ((i >= n) ? ((null, null, length, capacity) :: CacheLayerKV[B,H,T,DK,DV]) : ((List.index read_layers i) :: CacheLayerKV[B,H,T,DK,DV]))

update_init :: Dim -> Tensor[B,H,S,DH] -> Tensor[B,H,S,DH] -> (Tensor[B,H,S,DH], Tensor[B,H,S,DH], CacheLayer[B,H,S,C,DH])
update_init capacity k v = do
  k_store <- Tensor.zeros k shape=[B, H, capacity, DH]
  v_store <- Tensor.zeros v shape=[B, H, capacity, DH]
  k_store <- Tensor.assign_slice k_store k -2 0 S
  v_store <- Tensor.assign_slice v_store v -2 0 S
  return k, v, (k_store, v_store, S, capacity)

update_existing :: Tensor[B,H,C,DH] -> Tensor[B,H,C,DH] -> Dim -> Dim -> Tensor[B,H,S,DH] -> Tensor[B,H,S,DH] -> (Tensor[B,H,K,DH], Tensor[B,H,K,DH], CacheLayer[B,H,K,C,DH])
update_existing k_past v_past length capacity k v = do
  new_length <- length + S
  k_store <- Tensor.assign_slice k_past k -2 length new_length
  v_store <- Tensor.assign_slice v_past v -2 length new_length
  k_active <- Tensor.slice k_store dim=-2 start=0 end=new_length
  v_active <- Tensor.slice v_store dim=-2 start=0 end=new_length
  return k_active, v_active, (k_store, v_store, new_length, capacity)

update_nonnull :: CacheLayer[B,H,P,C,DH] -> Tensor[B,H,S,DH] -> Tensor[B,H,S,DH] -> (Tensor[B,H,K,DH], Tensor[B,H,K,DH], CacheLayer[B,H,K,C,DH])
update_nonnull past k v = do
  k_past, v_past, length, capacity <- past
  k_out, v_out, new_layer <- (k_past == null)
    ? update_init capacity k v
    : update_existing (Tensor.require k_past) (Tensor.require v_past) length capacity k v
  return k_out, v_out, new_layer

update :: ?CacheLayer[B,H,P,C,DH] -> Tensor[B,H,S,DH] -> Tensor[B,H,S,DH] -> (Tensor[B,H,K,DH], Tensor[B,H,K,DH], ?CacheLayer[B,H,K,C,DH])
update past k v = (past == null)
  ? (((k, v, null) :: (Tensor[B,H,S,DH], Tensor[B,H,S,DH], ?CacheLayer[B,H,S,C,DH])))
  : ((update_nonnull past k v) :: (Tensor[B,H,K,DH], Tensor[B,H,K,DH], CacheLayer[B,H,K,C,DH]))

update_kv :: CacheLayerKV[B,H,C,DK,DV] -> Tensor[B,H,S,DK] -> Tensor[B,H,S,DV] -> (Tensor[B,H,K,DK], Tensor[B,H,K,DV], CacheLayerKV[B,H,C,DK,DV])
update_kv past k v = do
  k_past, v_past, length, capacity <- past
  k_out, v_out, new_layer <- (k_past == null)
    ? do
      k_all <- Tensor.zeros k shape=[B, H, capacity, DK]
      v_all <- Tensor.zeros v shape=[B, H, capacity, DV]
      k_all <- Tensor.assign_slice k_all k -2 0 S
      v_all <- Tensor.assign_slice v_all v -2 0 S
      return k, v, (k_all, v_all, S, capacity)
    : do
      new_length <- length + S
      k_all <- Tensor.assign_slice (Tensor.require k_past) k -2 length new_length
      v_all <- Tensor.assign_slice (Tensor.require v_past) v -2 length new_length
      k_active <- Tensor.slice k_all dim=-2 start=0 end=new_length
      v_active <- Tensor.slice v_all dim=-2 start=0 end=new_length
      return k_active, v_active, (k_all, v_all, new_length, capacity)
  return k_out, v_out, new_layer

append :: ?Cache[B,H,K,C,DH] -> ?CacheLayer[B,H,K,C,DH] -> ?Cache[B,H,K,C,DH]
append cache layer = (cache == null) ? null : do
  read_layers, write_layers, length, capacity <- (cache :: Cache[B,H,K,C,DH])
  layer <- ((layer == null) ? ((null, null, length, capacity) :: CacheLayer[B,H,K,C,DH]) : (layer :: CacheLayer[B,H,K,C,DH]))
  write_layers <- List.append write_layers ((layer :: ?Any))
  return (read_layers, write_layers, length, capacity)

append_kv :: CacheKV[B,H,T,DK,DV] -> ?CacheLayerKV[B,H,T,DK,DV] -> CacheKV[B,H,T,DK,DV]
append_kv cache layer = do
  read_layers, write_layers, length, capacity <- (cache :: CacheKV[B,H,T,DK,DV])
  layer <- ((layer == null) ? ((null, null, length, capacity) :: CacheLayerKV[B,H,T,DK,DV]) : (layer :: CacheLayerKV[B,H,T,DK,DV]))
  write_layers <- List.append write_layers ((layer :: ?Any))
  return (read_layers, write_layers, length, capacity)

finish :: ?Cache[B,H,K,C,DH] -> Dim -> ?Cache[B,H,K,C,DH]
finish cache length = (cache == null) ? null : do
  _, write_layers, _, capacity <- cache
  return (write_layers, List.init, length, capacity)

finish_kv :: CacheKV[B,H,T,DK,DV] -> Dim -> CacheKV[B,H,T,DK,DV]
finish_kv cache length = do
  _, write_layers, _, capacity <- cache
  return (write_layers, List.init, length, capacity)
