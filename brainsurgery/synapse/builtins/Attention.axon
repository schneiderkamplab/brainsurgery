import Math (
  add,
  sqrt,
)
import Activations tanh
import Masking (
  bidirectional_mask,
  causal_mask,
)
import Tensor (
  cast,
  chunk,
  concat,
  matmul,
  permute,
  reshape,
  slice,
  softmax,
  transpose,
  where,
  zeros_like,
  min_like,
)
export (attention, attention_gemma2, attention_with_sinks, mask_to_additive, merge_heads, reshape_heads)
export (split_qkv_grouped, split_qkv_heads)
export (attention_masked, attention_causal_scaled)


mask_to_additive :: Tensor -> Tensor -> Tensor
mask_to_additive ref keep = Tensor.where keep (Tensor.zeros_like ref) (Tensor.min_like ref)


-- === HEAD LAYOUT ===
reshape_heads :: Tensor[B,S,D] -> Int -> Tensor
reshape_heads x heads = do
  return Tensor.reshape x shape=[B, S, heads, (D / heads)] |> Tensor.permute dims=[0, 2, 1, 3]


merge_heads :: Tensor[B,H,S,HD] -> Tensor
merge_heads x = do
  return Tensor.permute x dims=[0, 2, 1, 3] |> Tensor.reshape shape=[B, S, (H * HD)]


split_qkv_heads :: Tensor[B,T,D] -> ?Int -> ?String -> (Tensor[B,H,T,HD], Tensor[B,H,T,HD], Tensor[B,H,T,HD])
split_qkv_heads x ?heads=1 ?layout="packed" = do
  hd <- D / (3 * heads)
  return (layout == "interleaved")
    ? do
      qkv <- Tensor.reshape x shape=[B, T, heads, 3, hd]
      q <- Tensor.slice qkv dim=3 start=0 end=1 |> Tensor.reshape shape=[B, T, heads, hd] |> Tensor.permute dims=[0, 2, 1, 3]
      k <- Tensor.slice qkv dim=3 start=1 end=2 |> Tensor.reshape shape=[B, T, heads, hd] |> Tensor.permute dims=[0, 2, 1, 3]
      v <- Tensor.slice qkv dim=3 start=2 end=3 |> Tensor.reshape shape=[B, T, heads, hd] |> Tensor.permute dims=[0, 2, 1, 3]
      return q, k, v
    : do
      q_lin, k_lin, v_lin <- Tensor.chunk x parts=3
      q <- reshape_heads q_lin heads
      k <- reshape_heads k_lin heads
      v <- reshape_heads v_lin heads
      return q, k, v


split_qkv_grouped :: Tensor[B,T,D] -> ?Int -> ?Int -> ?Int -> (Tensor[B,H,T,HD], Tensor[B,KVH,T,HD], Tensor[B,KVH,T,HD])
split_qkv_grouped x ?heads=1 ?kv_heads=1 ?head_dim=null = do
  q_per_kv <- heads / kv_heads
  hd <- (head_dim == null) ? (D / (kv_heads * (q_per_kv + 2))) : head_dim
  grouped <- Tensor.reshape x shape=[B, T, kv_heads, (q_per_kv + 2), hd]
  q <- Tensor.slice grouped dim=3 start=0 end=q_per_kv |> Tensor.reshape shape=[B, T, heads, hd] |> Tensor.permute dims=[0, 2, 1, 3]
  k <- Tensor.slice grouped dim=3 start=q_per_kv end=(q_per_kv + 1) |> Tensor.reshape shape=[B, T, kv_heads, hd] |> Tensor.permute dims=[0, 2, 1, 3]
  v <- Tensor.slice grouped dim=3 start=(q_per_kv + 1) end=(q_per_kv + 2) |> Tensor.reshape shape=[B, T, kv_heads, hd] |> Tensor.permute dims=[0, 2, 1, 3]
  return q, k, v


-- === ATTENTION ===
attention_core :: Tensor[B,H,Q,HD] -> Tensor[B,H,K,HD] -> Tensor[B,H,K,HD] -> Tensor[B,1,Q,K] -> ?Tensor -> ?Float -> ?Tensor[B,H,Q,1] -> ?Float -> ?Bool -> ?Bool -> Tensor[B,H,Q,HD]
attention_core q k v keep ?rel_bias=null ?scale=(1.0 / sqrt HD) ?sink_logits=null ?softcap=null ?zero_masked_after_softmax=true ?fp32_compute=false = do
  scores <- Tensor.matmul q (Tensor.transpose k dim1=2 dim2=3)
  scores <- scores * scale
  softcap_val <- (softcap == null) ? 0.0 : softcap
  scores <- ((softcap == null) or (softcap_val == 0.0)) ? scores : do
    scaled <- scores / softcap_val
    squashed <- tanh scaled
    return squashed * softcap_val
  mask <- mask_to_additive scores keep
  probs_in <- add scores mask
  probs_in <- (rel_bias == null) ? probs_in : add probs_in rel_bias
  probs_in <- (sink_logits == null) ? probs_in : concat probs_in sink_logits dim=-1
  probs <- fp32_compute ? (softmax probs_in dim=-1 dtype="float32") : (softmax probs_in dim=-1)
  probs <- (sink_logits == null) ? probs : slice probs dim=-1 start=0 end=K
  probs <- zero_masked_after_softmax ? (Tensor.where keep probs 0) : probs
  v_work <- fp32_compute ? (Tensor.cast v dtype="float32") : v
  out <- Tensor.matmul probs v_work
  return fp32_compute ? (Tensor.cast out dtype="float32") : out


attention :: Tensor[B,H,Q,HD] -> Tensor[B,H,K,HD] -> Tensor[B,H,K,HD] -> Tensor[B,1,Q,K] -> ?Tensor -> ?Float -> Tensor[B,H,Q,HD]
attention q k v keep ?rel_bias=null ?scale=(1.0 / sqrt HD) = do
  return attention_core q k v keep rel_bias scale

attention_gemma2 :: Tensor[B,H,Q,HD] -> Tensor[B,H,K,HD] -> Tensor[B,H,K,HD] -> Tensor[B,1,Q,K] -> ?Float -> ?Tensor -> ?Float -> Tensor[B,H,Q,HD]
attention_gemma2 q k v keep ?softcap=null ?rel_bias=null ?scale=(1.0 / sqrt HD) = do
  return attention_core q k v keep rel_bias scale null softcap false true


attention_hf :: Tensor[B,H,Q,HD] -> Tensor[B,H,K,HD] -> Tensor[B,H,K,HD] -> Tensor[B,1,Q,K] -> ?Tensor -> ?Float -> Tensor[B,H,Q,HD]
attention_hf q k v keep ?rel_bias=null ?scale=(1.0 / sqrt HD) = do
  return attention_core q k v keep rel_bias scale null null true true


attention_with_sinks :: Tensor[B,H,Q,HD] -> Tensor[B,H,K,HD] -> Tensor[B,H,K,HD] -> Tensor[B,1,Q,K] -> Tensor[H] -> ?Tensor -> ?Float -> Tensor[B,H,Q,HD]
attention_with_sinks q k v keep sink ?rel_bias=null ?scale=(1.0 / sqrt HD) = do
  sink_base <- reshape sink shape=[1, H, 1, 1]
  sink_ref <- slice q dim=-1 start=0 end=1
  sink_logits <- add (sink_ref * 0.0) sink_base
  return attention_core q k v keep rel_bias scale sink_logits


-- DEPRECATED-SHAPE BRIDGE
attention_masked :: Tensor[B,H,Q,HD] -> Tensor[B,H,K,HD] -> Tensor[B,H,K,HD] -> ?Tensor -> ?Bool -> ?Bool -> ?Float -> ?Bool -> ?Float -> ?Bool -> ?Tensor -> ?Path -> Tensor[B,H,Q,HD]
attention_masked q k v ?mask=null ?padding_mask=false ?causal=false ?scale=null ?eager=false ?softcap=null ?top_left_mask=false ?sink=null ?sink_path=null = do
  keep <- (mask == null)
    ? (causal ? (causal_mask q k) : (bidirectional_mask q k))
    : (
      padding_mask
        ? (causal ? (causal_mask q k padding_mask=mask) : (bidirectional_mask q k padding_mask=mask))
        : mask
    )
  scale_eff <- (scale == null) ? (1.0 / sqrt HD) : scale
  sink_logits <- (sink == null)
    ? null
    : do
      sink_base <- reshape sink shape=[1, H, 1, 1]
      sink_ref <- slice q dim=-1 start=0 end=1
      return add (sink_ref * 0.0) sink_base
  return attention_core q k v keep null scale_eff sink_logits softcap true false


attention_causal_scaled :: Tensor[B,H,Q,HD] -> Tensor[B,H,K,HD] -> Tensor[B,H,K,HD] -> Float -> ?Bool -> Tensor[B,H,Q,HD]
attention_causal_scaled q k v scale ?eager=false = attention_masked q k v causal=true scale=scale eager=eager
