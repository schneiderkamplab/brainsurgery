import Math
import Params (param)
import Tensor

export (gegelu, gelu, gelu_new, gelu_pytorch_tanh, relu, relu2, sigmoid, silu, swiglu, tanh, xielu)


sigmoid :: Tensor -> Tensor
sigmoid x = 1.0 / (1.0 + (Math.exp (0.0 - x)))


tanh :: Tensor -> Tensor
tanh x = (2.0 * (sigmoid (2.0 * x))) - 1.0


relu :: Tensor -> Tensor
relu x = Tensor.where (Tensor.le x 0.0) 0.0 x


relu2 :: Tensor -> Tensor
relu2 x = do
  y <- relu x
  return y * y


silu :: Tensor -> Tensor
silu x = x * (sigmoid x)


swiglu :: Tensor -> Tensor
swiglu x = (silu x) * x


gelu_new :: Tensor -> Tensor
gelu_new x = 0.5 * x * (1.0 + (tanh (0.7978845608028654 * (x + (0.044715 * x * x * x)))))


gelu_pytorch_tanh :: Tensor -> Tensor
gelu_pytorch_tanh x = gelu_new x


-- Derived approximation; uses the tanh form.
gelu :: Tensor -> Tensor
gelu x = gelu_new x


gegelu :: Tensor -> ?Float -> Tensor
gegelu x ?limit=null = do
  d <- Tensor.size x -1
  pair <- Tensor.reshape x shape=[-1, (d / 2), 2]
  x_gelu <- Tensor.slice pair dim=-1 start=0 end=1 |> Tensor.reshape shape=[-1, (d / 2)]
  x_linear <- Tensor.slice pair dim=-1 start=1 end=2 |> Tensor.reshape shape=[-1, (d / 2)]
  x_gelu <- (limit == null) ? x_gelu : (Math.clamp x_gelu max=limit)
  x_linear <- (limit == null) ? x_linear : (Math.clamp x_linear min=(0.0 - limit) max=limit)
  return x_gelu * (sigmoid (1.702 * x_gelu)) * (x_linear + 1.0)


xielu_basic :: Tensor -> Tensor -> Tensor -> Tensor -> Tensor -> Tensor
xielu_basic x alpha_p_raw alpha_n_raw beta eps = do
  alpha_p <- Math.log ((Math.exp alpha_p_raw) + 1.0)
  alpha_n <- beta + (Math.log ((Math.exp alpha_n_raw) + 1.0))
  pos <- (alpha_p * x * x) + (beta * x)
  x_cap <- Tensor.where (Tensor.le x eps) x eps
  neg <- ((Math.exp x_cap - 1.0) - x) * alpha_n + (beta * x)
  return Tensor.where (Tensor.le x 0.0) neg pos


xielu :: @Path -> Tensor -> ?Path -> ?Path -> ?Path -> ?Path -> ?Path -> Tensor
xielu@path x ?alpha_p_path=@alpha_p ?alpha_n_path=@alpha_n ?beta_path=@beta ?eps_path=@eps ?prefix_path=null = do
  prefix <- (prefix_path == null) ? path : prefix_path
  alpha_p <- param alpha_p_path prefix_path=prefix
  alpha_n <- param alpha_n_path prefix_path=prefix
  beta <- param beta_path prefix_path=prefix
  eps <- param eps_path prefix_path=prefix
  return xielu_basic x alpha_p alpha_n beta eps
