reshape_head_basic :: Tensor[B,S,D] -> Int -> Tensor
reshape_head_basic x heads = do
  x4 <- reshape x shape=[B, S, heads, (D / heads)]
  return permute x4 dims=[0, 2, 1, 3]

merge_heads_basic :: Tensor[B,H,S,HD] -> Int -> Tensor
merge_heads_basic x heads = do
  x4 <- permute x dims=[0, 2, 1, 3]
  return reshape x4 shape=[B, S, (heads * HD)]

mask_to_additive_basic :: Tensor -> Tensor -> Tensor
mask_to_additive_basic ref keep = where keep (zeros_like ref) (min_like ref)

position_ids_basic_masked :: TokenIds[B,S] -> Tensor[B,SM] -> Int -> Tensor[B,S]
position_ids_basic_masked x attn_mask pad_fill = do
  m1 <- cast attn_mask dtype="long"
  pos1 <- cumsum m1 dim=-1
  pos2 <- pos1 - 1
  pad <- eq attn_mask 0
  pos3 <- where pad pad_fill pos42
  return slice pos3 dim=-1 start=(SM - S) end=SM

position_ids_basic_nomask :: TokenIds[B,S] -> Int -> Tensor[B,S]
position_ids_basic_nomask x past_length = do
  pos1 <- arange x start=past_length end=(past_length + S)
  pos2 <- reshape pos1 shape=[1, S]
  return expand pos2 shape=[B, S]

position_ids_basic :: TokenIds[B,S] -> ?Tensor[B,S] -> Int -> Int -> Tensor[B,S]
position_ids_basic x attn_mask past_length pad_fill = (attn_mask == null) ? (position_ids_basic_nomask x past_length) : (position_ids_basic_masked x attn_mask pad_fill)

causal_mask_basic_nomask :: Tensor[B,H,Q,HD] -> Tensor[B,H,K,HD] -> Tensor[B,1,Q,K]
causal_mask_basic_nomask q k = do
  i1 <- arange q start=0 end=Q
  j1 <- arange k start=0 end=K
  i2 <- reshape i1 shape=[Q, 1]
  j2 <- reshape j1 shape=[1, K]
  upper <- le j2 (i2 + (K - Q))
  keep <- reshape upper shape=[1, 1, Q, K]
  return expand keep shape=[B, 1, Q, K]

causal_mask_basic_masked :: Tensor[B,H,Q,HD] -> Tensor[B,H,K,HD] -> Tensor[B,K] -> Tensor[B,1,Q,K]
causal_mask_basic_masked q k attn_mask = do
  keep <- causal_mask_basic_nomask q k
  pad <- cast attn_mask dtype="bool"
  pad4 <- reshape pad shape=[B, 1, 1, K]
  return and keep pad4

causal_mask_basic :: Tensor[B,H,Q,HD] -> Tensor[B,H,K,HD] -> ?Tensor[B,K] -> Tensor
causal_mask_basic q k attn_mask = (attn_mask == null) ? (causal_mask_basic_nomask q k) : (causal_mask_basic_masked q k attn_mask)

attention_basic :: Tensor[B,H,Q,HD] -> Tensor[B,H,K,HD] -> Tensor[B,H,K,HD] -> Tensor[B,1,Q,K] -> Float -> Tensor[B,H,Q,HD]
attention_basic q k v keep scale = do
  kt <- transpose k dim1=2 dim2=3
  scores0 <- matmul q kt
  scores1 <- scores0 * scale
  mask <- mask_to_additive_basic scores1 keep
  probs <- add scores1 mask |> softmax dim=-1
  return matmul probs v
