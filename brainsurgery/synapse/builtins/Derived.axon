import Math (
  add,
  sqrt,
)
import Masking
import Positions


-- === HEAD LAYOUT ===
reshape_head_basic :: Tensor[B,S,D] -> Int -> Tensor
reshape_head_basic x heads = do
  return reshape x shape=[B, S, heads, (D / heads)] |> permute dims=[0, 2, 1, 3]


merge_heads_basic :: Tensor[B,H,S,HD] -> Tensor
merge_heads_basic x = do
  return permute x dims=[0, 2, 1, 3] |> reshape shape=[B, S, (H * HD)]


-- === ATTENTION ===
attention_basic :: Tensor[B,H,Q,HD] -> Tensor[B,H,K,HD] -> Tensor[B,H,K,HD] -> Tensor[B,1,Q,K] -> ?Tensor[1,H,Q,K] -> ?Float -> Tensor[B,H,Q,HD]
attention_basic q k v keep ?rel_bias=null ?scale=(1.0 / sqrt HD) = do
  scores <- matmul q (transpose k dim1=2 dim2=3)
  scores <- scores * scale
  mask <- Masking.mask_to_additive_basic scores keep
  probs_in <- add scores mask
  probs_in <- (rel_bias == null) ? probs_in : add probs_in rel_bias
  probs <- softmax probs_in dim=-1
  probs <- where keep probs 0
  return matmul probs v


attention_basic_hf :: Tensor[B,H,Q,HD] -> Tensor[B,H,K,HD] -> Tensor[B,H,K,HD] -> Tensor[B,1,Q,K] -> ?Tensor[1,H,Q,K] -> ?Float -> Tensor[B,H,Q,HD]
attention_basic_hf q k v keep ?rel_bias=null ?scale=(1.0 / sqrt HD) = do
  scores <- matmul q (transpose k dim1=2 dim2=3)
  scores <- scores * scale
  mask <- Masking.mask_to_additive_basic scores keep
  probs_in <- add scores mask
  probs_in <- (rel_bias == null) ? probs_in : add probs_in rel_bias
  probs <- softmax probs_in dim=-1 dtype="float32"
  probs <- where keep probs 0
  out <- matmul probs (cast v dtype="float32")
  return cast out dtype="float32"


-- === COMPAT FORWARDS ===
mask_to_additive_basic :: Tensor -> Tensor -> Tensor
mask_to_additive_basic ref keep = Masking.mask_to_additive_basic ref keep


causal_mask_basic_nomask :: Tensor[B,H,Q,HD] -> Tensor[B,H,K,HD] -> Tensor[B,1,Q,K]
causal_mask_basic_nomask q k = Masking.causal_mask_basic_nomask q k


causal_mask_basic_masked :: Tensor[B,H,Q,HD] -> Tensor[B,H,K,HD] -> Tensor[B,K] -> Tensor[B,1,Q,K]
causal_mask_basic_masked q k attn_mask = Masking.causal_mask_basic_masked q k attn_mask


causal_mask_basic :: Tensor[B,H,Q,HD] -> Tensor[B,H,K,HD] -> ?Tensor[B,K] -> Tensor
causal_mask_basic q k attn_mask = Masking.causal_mask_basic q k attn_mask


bidirectional_mask_basic_nomask :: Tensor[B,H,Q,HD] -> Tensor[B,H,K,HD] -> Tensor[B,1,Q,K]
bidirectional_mask_basic_nomask q k = Masking.bidirectional_mask_basic_nomask q k


bidirectional_mask_basic_masked :: Tensor[B,H,Q,HD] -> Tensor[B,H,K,HD] -> Tensor[B,SM] -> Tensor[B,1,Q,K]
bidirectional_mask_basic_masked q k attn_mask = Masking.bidirectional_mask_basic_masked q k attn_mask


bidirectional_mask_basic :: Tensor[B,H,Q,HD] -> Tensor[B,H,K,HD] -> ?Tensor[B,SM] -> Tensor[B,1,Q,K]
bidirectional_mask_basic q k attn_mask = Masking.bidirectional_mask_basic q k attn_mask


position_ids_basic_masked :: TokenIds[B,S] -> Tensor[B,SM] -> Int -> Tensor[B,S]
position_ids_basic_masked x attn_mask pad_fill = Positions.position_ids_basic_masked x attn_mask pad_fill


position_ids_basic_nomask :: TokenIds[B,S] -> Int -> Tensor[B,S]
position_ids_basic_nomask x past_length = Positions.position_ids_basic_nomask x past_length


position_ids_basic :: TokenIds[B,S] -> ?Tensor[B,SM] -> Int -> Int -> Tensor[B,S]
position_ids_basic x attn_mask past_length pad_fill = Positions.position_ids_basic x attn_mask past_length pad_fill


position_ids_scale_basic :: Tensor[B,SM] -> Float -> Tensor[B,SM]
position_ids_scale_basic position_ids scale_factor = Positions.position_ids_scale_basic position_ids scale_factor


rope_pair_base_basic :: Tensor[B,HQ,S,HD] -> Tensor[B,HK,S,HD] -> Tensor[B,SM] -> ?Float -> ?Float -> ?Float -> ?Bool -> (Tensor[B,HQ,S,HD], Tensor[B,HK,S,HD])
rope_pair_base_basic q k position_ids ?theta=10000.0 ?scale_factor=null ?partial_rotary_factor=null ?interleaved=false = Positions.rope_pair_base_basic q k position_ids theta scale_factor partial_rotary_factor interleaved


rope_pair_proportional_basic :: Tensor[B,HQ,S,HD] -> Tensor[B,HK,S,HD] -> Tensor[B,SM] -> ?Float -> ?Float -> ?Float -> (Tensor[B,HQ,S,HD], Tensor[B,HK,S,HD])
rope_pair_proportional_basic q k position_ids ?theta=10000.0 ?scale_factor=null ?partial_rotary_factor=1.0 = Positions.rope_pair_proportional_basic q k position_ids theta scale_factor partial_rotary_factor


rope_pair_freq_scale_basic :: Tensor[B,H,S,HD] -> Tensor[B,H,S,HD] -> Tensor[B,SM] -> Float -> Float -> Float -> Float -> Int -> ?Bool -> (Tensor[B,H,S,HD], Tensor[B,H,S,HD])
rope_pair_freq_scale_basic q k pos_ids theta scale_factor low_freq_factor high_freq_factor original_context ?interleaved=false = Positions.rope_pair_freq_scale_basic q k pos_ids theta scale_factor low_freq_factor high_freq_factor original_context interleaved


rope_pair_longrope_basic :: Tensor[B,H,S,HD] -> Tensor[B,H,S,HD] -> Tensor[B,SM] -> Float -> Int -> Int -> Any -> Any -> ?Float -> ?Float -> ?Float -> ?Float -> ?Bool -> (Tensor[B,H,S,HD], Tensor[B,H,S,HD])
rope_pair_longrope_basic q k pos_ids theta original_context max_context long_factor short_factor ?attention_factor=null ?long_mscale=null ?short_mscale=null ?partial_rotary_factor=null ?interleaved=false = Positions.rope_pair_longrope_basic q k pos_ids theta original_context max_context long_factor short_factor attention_factor long_mscale short_mscale partial_rotary_factor interleaved


rope_pair_yarn_basic :: Tensor[B,H,S,HD] -> Tensor[B,H,S,HD] -> Tensor[B,SM] -> Float -> Float -> Float -> Float -> Int -> ?Float -> ?Float -> ?Bool -> (Tensor[B,H,S,HD], Tensor[B,H,S,HD])
rope_pair_yarn_basic q k pos_ids theta scale_factor beta_fast beta_slow original_context ?mscale=null ?mscale_all_dim=null ?interleaved=false = Positions.rope_pair_yarn_basic q k pos_ids theta scale_factor beta_fast beta_slow original_context mscale mscale_all_dim interleaved


rope_pair_hf_yarn_basic :: Tensor[B,H,S,HD] -> Tensor[B,H,S,HD] -> Tensor[B,SM] -> Float -> Float -> Float -> Float -> Int -> ?Float -> ?Bool -> ?Bool -> (Tensor[B,H,S,HD], Tensor[B,H,S,HD])
rope_pair_hf_yarn_basic q k pos_ids theta scale_factor low_freq_factor high_freq_factor original_context ?attention_factor=1.0 ?truncate=true ?interleaved=false = Positions.rope_pair_hf_yarn_basic q k pos_ids theta scale_factor low_freq_factor high_freq_factor original_context attention_factor truncate interleaved


relative_position_buckets_basic :: Tensor[Q,K] -> Int -> Int -> Bool -> Tensor[Q,K]
relative_position_buckets_basic relative_position num_buckets max_distance bidirectional = Positions.relative_position_buckets_basic relative_position num_buckets max_distance bidirectional


relative_position_bias_basic :: @Path -> Tensor[B,H,Q,HD] -> Tensor[B,H,K,HD] -> Int -> Int -> Bool -> Tensor[1,H,Q,K]
relative_position_bias_basic@path q k num_buckets max_distance bidirectional = Positions.relative_position_bias_basic@path q k num_buckets max_distance bidirectional
