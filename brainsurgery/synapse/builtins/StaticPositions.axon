import Positions
import StaticMasking (Mask)
import Tensor

export (
  position_ids,
)

position_ids :: Tensor.TokenIds[B,S] -> ?Mask[B,K,C] -> ?Dim -> ?Int -> Tensor[B,S]
position_ids x ?attn_mask=null ?past_length=0 ?pad_fill=0 = Positions.position_ids_static x attn_mask=attn_mask past_length=past_length pad_fill=pad_fill
