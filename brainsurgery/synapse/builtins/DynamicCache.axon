import List
import Tensor

export (
  Cache,
  CacheLayer,
  append,
  finish,
  index,
  past_length,
  prepare,
  read,
  update,
)

type CacheLayer[B,H,T,C,DH] = ?(Tensor[B,H,T,DH], Tensor[B,H,T,DH])
type Cache[B,H,T,C,DH] = List[(Tensor[B,H,T,DH], Tensor[B,H,T,DH])]

update :: CacheLayer[B,H,P,C,DH] -> Tensor[B,H,S,DH] -> Tensor[B,H,S,DH] -> (Tensor[B,H,K,DH], Tensor[B,H,K,DH], CacheLayer[B,H,K,C,DH])
update past k v = (past == null)
  ? do
    return k, v, (k, v)
  : do
    k_past, v_past <- past
    k_all <- Tensor.concat k_past k dim=-2
    v_all <- Tensor.concat v_past v dim=-2
    return k_all, v_all, (k_all, v_all)

prepare :: ?Cache[B,H,P,C,DH] -> ?Bool -> ?Dim -> ?Cache[B,H,K,C,DH]
prepare past use_cache capacity = use_cache ? List.init : null

read :: ?Cache[B,H,P,C,DH] -> ?Cache[B,H,K,C,DH] -> ?Cache[B,H,P,C,DH]
read past work = past

index :: ?Cache[B,H,T,C,DH] -> Int -> CacheLayer[B,H,T,C,DH]
index values i = (values == null) ? null : (((List.length (values :: Cache[B,H,T,C,DH])) == 0) ? null : List.index (values :: Cache[B,H,T,C,DH]) i)

append :: ?Cache[B,H,K,C,DH] -> CacheLayer[B,H,K,C,DH] -> ?Cache[B,H,K,C,DH]
append values value = (values == null) ? null : ((value == null) ? values : List.append values value)

past_length :: ?Cache[B,H,T,C,DH] -> Dim
past_length cache = (cache == null) ? 0 : (((List.length (cache :: Cache[B,H,T,C,DH])) == 0) ? 0 : do
  k, _ <- List.index (cache :: Cache[B,H,T,C,DH]) 0
  return Tensor.size k -2
)

finish :: ?Cache[B,H,K,C,DH] -> Dim -> ?Cache[B,H,K,C,DH]
finish cache length = cache
