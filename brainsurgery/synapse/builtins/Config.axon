import List
export (bool, float, has_key, has_value, int, list, str, value)

has_key :: String -> ?String -> Bool
has_key key ?root="" = _config_has key root

has_value :: String -> ?String -> Bool
has_value key ?root="" = (Config.value key root=root default=null) != null

int :: String -> ?String -> ?Int -> Int
int key ?root="" ?default=null = _config_int key root default

float :: String -> ?String -> ?Float -> Float
float key ?root="" ?default=null = _config_float key root default

str :: String -> ?String -> ?String -> String
str key ?root="" ?default=null = _config_str key root default

bool :: String -> ?String -> ?Bool -> Bool
bool key ?root="" ?default=null = _config_bool key root default

list :: String -> ?String -> ?List[_T] -> List[_T]
list key ?root="" ?default=List.init = _config_list key root default

value :: String -> ?String -> ?Any -> Any
value key ?root="" ?default=null = _config_value key root default
