has :: String -> ?String -> Bool
has key ?root="" = _config_has key root

int :: String -> ?String -> ?Int -> Int
int key ?root="" ?default=null = _config_int key root default

float :: String -> ?String -> ?Float -> Float
float key ?root="" ?default=null = _config_float key root default

str :: String -> ?String -> ?String -> String
str key ?root="" ?default=null = _config_str key root default

value :: String -> ?String -> ?Any -> Any
value key ?root="" ?default=null = _config_value key root default
