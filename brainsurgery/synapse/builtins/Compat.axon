import Attention (
  attention_masked,
)

export (
  attention,
  attention_causal_scaled,
)

-- DEPRECATED
attention :: Tensor[B,H,T,HD] -> Tensor[B,H,TK,HD] -> Tensor[B,H,TK,HD] -> ?Tensor -> ?Bool -> ?Bool -> ?Float -> ?Bool -> ?Float -> ?Bool -> ?Tensor -> ?Path -> Tensor[B,H,T,HD]
attention q k v ?mask=null ?padding_mask=false ?causal=false ?scale=null ?eager=false ?softcap=null ?top_left_mask=false ?sink=null ?sink_path=null = do
  return attention_masked q k v mask=mask padding_mask=padding_mask causal=causal scale=scale eager=eager softcap=softcap top_left_mask=top_left_mask sink=sink sink_path=sink_path

-- DEPRECATED
attention_causal_scaled :: Tensor[B,H,T,HD] -> Tensor[B,H,TK,HD] -> Tensor[B,H,TK,HD] -> Float -> ?Bool -> Tensor[B,H,T,HD]
attention_causal_scaled q k v scale ?eager=false = attention_masked q k v causal=true scale=scale eager=eager
