import Config
import Activations gelu_new
import Cache (Cache, CacheLayer, past_length)
import NN (embedding, layernorm, linear)
import Attention (attention, merge_heads, reshape_heads)
import Masking (causal_mask_masked)
import Positions (position_ids)
import Tensor (chunk)

T   = Config.int @n_positions default=1024   -- max sequence length
D   = Config.int @n_embd default=768         -- hidden dimensions
L   = Config.int @n_layer default=12         -- number of layers
H   = Config.int @n_head default=12          -- number of attention heads
V   = Config.int @vocab_size default=520257  -- vocab size

lin :: @Path -> Tensor[B,S,Din] -> Int -> Tensor[B,S,dim]
lin@path x dim = linear@path x dim=dim bias=true transpose=true

gpt2_block :: Tensor[B,S,D] -> ?Tensor[B,S] -> ?CacheLayer[B,H,P,DH] -> (Tensor[B,S,D], ?CacheLayer[B,H,K,DH])
gpt2_block x attn_mask past_kv = do
  x1 <- layernorm@ln_1 x
  a, new_kv <- scope@attn do
    q_lin, k_lin, v_lin <- lin@c_attn x1 3*D |> chunk parts=3
    q <- reshape_heads q_lin heads=H
    k <- reshape_heads k_lin heads=H
    v <- reshape_heads v_lin heads=H
    k, v, new_kv <- Cache.update past_kv k v
    mask <- causal_mask_masked q k attn_mask window=T
    a <- attention q k v mask |> merge_heads |> lin@c_proj D
    return a, new_kv
  x <- x + a
  x3 <- layernorm@ln_2 x
  m <- scope@mlp do
    return lin@c_fc x3 4*D |> gelu_new fp32_accum=true |> lin@c_proj D
  return x + m, new_kv

gpt2 :: Tensor.TokenIds[B,S] -> ?Tensor[B,K] -> ?Cache[B,H,P,DH] -> ?Bool -> (Tensor[B,S,V], ?Cache[B,H,K,DH])
gpt2 input_ids attn_mask past_kv use_cache = do
  tok <- embedding@wte input_ids dim=D
  pos <- position_ids input_ids attn_mask past_length=(past_length past_kv) pad_fill=1 |> embedding@wpe
  x <- tok + pos
  new_kv <- use_cache ? Cache.init : null
  for@h i <- [0..L) do
    past_i <- Cache.index past_kv i
    x, new_i <- gpt2_block x attn_mask past_i
    new_kv <- Cache.append new_kv new_i
  logits <- layernorm@ln_f x |> linear@wte
  return logits, new_kv
