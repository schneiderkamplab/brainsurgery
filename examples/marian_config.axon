import Config

-- MarianMT defaults (opus-mt-en-de style).
D = Config.int "d_model" default=512                             -- hidden size
V = Config.int "vocab_size" default=58101                        -- vocab size
L_ENC = Config.int "encoder_layers" default=6                    -- encoder layers
L_DEC = Config.int "decoder_layers" default=6                    -- decoder layers
H_ENC = Config.int "encoder_attention_heads" default=8           -- encoder heads
H_DEC = Config.int "decoder_attention_heads" default=8           -- decoder heads
FFN_ENC = Config.int "encoder_ffn_dim" default=2048              -- encoder MLP width
FFN_DEC = Config.int "decoder_ffn_dim" default=2048              -- decoder MLP width
EPS = Config.float "layernorm_embedding_eps" default=1e-05       -- layernorm epsilon
EMB_SCALE = sqrt D                                                 -- scale_embedding=true
