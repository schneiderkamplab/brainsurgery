import Config
import Activations gelu_pytorch_tanh
import Cache
import Cache past_length

-- Gemma-3 270M constants (derived from model config).
D   = Config.int "hidden_size" default=640                         -- residual hidden size
V   = Config.int "vocab_size" default=262208                       -- tokenizer vocabulary size
L   = Config.int "num_hidden_layers" default=18                    -- number of decoder layers
H   = Config.int "num_attention_heads" default=4                   -- query heads
KVH = Config.int "num_key_value_heads" default=1                   -- key/value heads
HD  = Config.int "head_dim" default=256                            -- per-head size
QD  = H * HD                                                       -- query projection width
KVD = KVH * HD                                                     -- key/value projection width
FFN = Config.int "intermediate_size" default=2048                 -- MLP hidden width
ROPE_PERIOD = Config.int "_sliding_window_pattern" default=6       -- long-window cadence
THETA_BASE = Config.float "rope_local_base_freq" default=10000.0   -- local RoPE theta
THETA_LONG = Config.float "rope_theta" default=1000000.0           -- long-context RoPE theta
WIN_LOCAL = Config.int "sliding_window" default=512                -- local attention window
WIN_LONG = Config.int "max_position_embeddings" default=32768      -- long attention window
ATTN_SCALE = 1.0 / sqrt (Config.float "query_pre_attn_scalar" default=256.0) -- qk scaling
EMB_SCALE = sqrt D                                                 -- embedding scale

rms :: @Path -> Tensor[B,S,D] -> Tensor[B,S,D]
rms@path x = rmsnorm@path x cast_float=true unit_offset=true

rms4 :: @Path -> Tensor[B,H,S,D] -> Tensor[B,H,S,D]
rms4@path x = rmsnorm@path x cast_float=true unit_offset=true

gemma3_block :: Tensor[B,S,D] -> Int -> Tensor[B,S] -> ?Tensor[B,S] -> ?CacheLayer -> (Tensor[B,S,D], ?CacheLayer)
gemma3_block x i pos_ids attn_mask past_kv = do
  xn <- rms@input_layernorm x
  a, new_kv <- scope@self_attn do
    q <- linear@q_proj xn dim=QD |> reshape_heads heads=H |> rms4@q_norm
    k <- linear@k_proj xn dim=KVD |> reshape_heads heads=KVH |> rms4@k_norm
    v <- linear@v_proj xn dim=KVD |> reshape_heads heads=KVH
    theta <- ((i + 1) % ROPE_PERIOD) == 0 ? THETA_LONG : THETA_BASE
    q, k <- rope_pair q k position_ids=pos_ids theta=theta
    k, v, new_kv <- Cache.update past_kv k v
    k <- repeat k (H / KVH)
    v <- repeat v (H / KVH)
    window <- ((i + 1) % ROPE_PERIOD) == 0 ? WIN_LONG : WIN_LOCAL
    mask <- causal_mask q k window=window padding_mask=attn_mask
    a <- attention q k v mask=mask scale=ATTN_SCALE |> merge_heads |> linear@o_proj dim=D
    return a, new_kv
  a <- rms@post_attention_layernorm a
  x <- x + a
  xn <- rms@pre_feedforward_layernorm x
  m <- scope@mlp do
    g <- linear@gate_proj xn dim=FFN
    u <- linear@up_proj xn dim=FFN
    return gelu_pytorch_tanh g |> mul u |> linear@down_proj dim=D
  m <- rms@post_feedforward_layernorm m
  return x + m, new_kv

gemma3 :: TokenIds[B,S] -> ?Tensor[B,S] -> ?Cache -> ?Bool -> (Tensor[B,S,V], ?Cache)
gemma3 input_ids attn_mask past_kv use_cache = do
  pos_ids <- position_ids input_ids attn_mask past_length=(past_length past_kv)
  logits, new_kv <- scope@model do
    x <- embedding@embed_tokens input_ids dim=D scale=EMB_SCALE
    new_kv <- use_cache ? Cache.init : null
    for@layers i <- [0..L) do
      past_i <- Cache.index past_kv i
      x, new_i <- gemma3_block x i pos_ids attn_mask past_i
      new_kv <- Cache.append new_kv new_i
    logits <- rms@norm x |>
      linear@embed_tokens
    return logits, new_kv
  return logits, new_kv
