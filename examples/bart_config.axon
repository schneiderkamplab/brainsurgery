import Config

-- BART-family defaults (bart-base style).
D = Config.int "d_model" default=768                            -- hidden size
V = Config.int "vocab_size" default=50265                       -- vocab size
L_ENC = Config.int "encoder_layers" default=6                   -- encoder layers
L_DEC = Config.int "decoder_layers" default=6                   -- decoder layers
H_ENC = Config.int "encoder_attention_heads" default=12         -- encoder heads
H_DEC = Config.int "decoder_attention_heads" default=12         -- decoder heads
FFN_ENC = Config.int "encoder_ffn_dim" default=3072             -- encoder MLP width
FFN_DEC = Config.int "decoder_ffn_dim" default=3072             -- decoder MLP width
EPS = Config.float "layernorm_embedding_eps" default=1e-05      -- layernorm epsilon
POS_OFFSET = Config.int "learned_pos_offset" default=2          -- learned position embedding offset
EMB_SCALE = Config.float "embed_scale" default=1.0              -- token embedding scale
