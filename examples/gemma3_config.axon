import Config
import Params

-- `CFG` selects where textual model settings live in config.json:
-- - Gemma 3 text-only configs: root keys (CFG = "")
-- - Gemma 3 multimodal-ish layouts: under `text_config` (CFG = "text_config")
CFG = (Config.has "text_config") ? "text_config" : ""              -- config namespace root: top-level ("") or nested ("text_config")

-- Parameter root for checkpoint key lookup.
-- Some checkpoints namespace everything under `language_model.*`.
PARAM_ROOT = (Params.has_root "language_model") ? "language_model" : "" -- checkpoint parameter prefix for scope@... root=...

-- Gemma 3 uses either `_sliding_window_pattern` or `sliding_window_pattern`
-- depending on checkpoint/config exporter version.
ROPE_PERIOD_KEY = (Config.has "_sliding_window_pattern" root=CFG) ? "_sliding_window_pattern" : "sliding_window_pattern" -- schema switch: old vs new period key name

D = Config.int "hidden_size" root=CFG default=640                  -- D from config key `hidden_size`, fallback 640
V = Config.int "vocab_size" root=CFG default=262208                -- V from `vocab_size`, fallback 262208
L = Config.int "num_hidden_layers" root=CFG default=18             -- L from `num_hidden_layers`, fallback 18
H = Config.int "num_attention_heads" root=CFG default=8            -- H from `num_attention_heads`, fallback 8
KVH = Config.int "num_key_value_heads" root=CFG default=4          -- KVH from `num_key_value_heads`, fallback 4
HD = Config.int "head_dim" root=CFG default=256                    -- HD from `head_dim`, fallback 256
FFN = Config.int "intermediate_size" root=CFG default=2048         -- FFN from `intermediate_size`, fallback 2048
ROPE_PERIOD = Config.int ROPE_PERIOD_KEY root=CFG default=6        -- long-window period from selected key, fallback 6
THETA_BASE = Config.float "rope_local_base_freq" root=CFG default=10000.0 -- local theta from `rope_local_base_freq`, fallback 1e4
THETA_LONG = Config.float "rope_theta" root=CFG default=1000000.0  -- long theta from `rope_theta`, fallback 1e6
ROPE_LONG_SCALE = Config.float "rope_scaling.factor" root=CFG default=1.0 -- optional long-scale from `rope_scaling.factor`, fallback 1.0
WIN_LOCAL = Config.int "sliding_window" root=CFG default=512       -- local window from `sliding_window`, fallback 512
WIN_LONG = Config.int "max_position_embeddings" root=CFG default=131072 -- long window from `max_position_embeddings`, fallback 131072
ATTN_SCALE = 1.0 / sqrt (Config.float "query_pre_attn_scalar" root=CFG default=256.0) -- qk scale from `query_pre_attn_scalar`, fallback 1/sqrt(256)
EMB_SCALE = sqrt D                                                  -- embedding multiplier as sqrt(D)
