import Activations silu
import Cache
import Cache past_length
import Config

-- OLMo-2-0425-1B defaults (resolved from config.json).
D = Config.int "hidden_size" default=2048                        -- hidden dimension
V = Config.int "vocab_size" default=100352                       -- vocabulary size
L = Config.int "num_hidden_layers" default=16                    -- number of decoder layers
H = Config.int "num_attention_heads" default=16                  -- number of query heads
KVH = Config.int "num_key_value_heads" default=16                -- number of key/value heads
HD = Config.int "head_dim" default=128                           -- per-head dimension
FFN = Config.int "intermediate_size" default=8192                -- MLP intermediate dimension
C = Config.int "max_position_embeddings" default=4096            -- attention window
EPS = Config.float "rms_norm_eps" default=1e-06                  -- RMSNorm epsilon
THETA = Config.float "rope_theta" default=500000.0               -- RoPE base theta
ATTN_SCALE = 1.0 / sqrt HD                                       -- qk scaling

rms :: @Path -> Tensor[B,S,D] -> Tensor[B,S,D]
rms@path x = rmsnorm@path x eps=EPS

olmo_2_block :: Tensor[B,S,D] -> Tensor[B,S] -> ?Tensor[B,S] -> ?CacheLayer -> (Tensor[B,S,D], ?CacheLayer)
olmo_2_block x pos_ids attn_mask past_kv = do
  a, new_kv <- scope@self_attn do
    q <- x |> linear@q_proj dim=(H * HD) |> rms@q_norm |> reshape_heads heads=H
    k <- x |> linear@k_proj dim=(KVH * HD) |> rms@k_norm |> reshape_heads heads=KVH
    v <- x |> linear@v_proj dim=(KVH * HD) |> reshape_heads heads=KVH
    q, k <- rope_pair q k position_ids=pos_ids theta=THETA
    k, v, new_kv <- Cache.update past_kv k v
    k <- repeat k (H / KVH)
    v <- repeat v (H / KVH)
    mask <- causal_mask q k window=C padding_mask=attn_mask
    a <- attention q k v mask=mask scale=ATTN_SCALE |> merge_heads
    a <- linear@o_proj a dim=D
    return a, new_kv
  a <- rms@post_attention_layernorm a
  x <- x + a
  m <- scope@mlp do
    g <- linear@gate_proj x dim=FFN
    u <- linear@up_proj x dim=FFN
    return g |> silu |> mul u |> linear@down_proj dim=D
  m <- rms@post_feedforward_layernorm m
  return x + m, new_kv

olmo_2_1b :: TokenIds[B,S] -> ?Tensor[B,S] -> ?Cache -> ?Bool -> (Tensor[B,S,V], ?Cache)
olmo_2_1b input_ids attn_mask past_kv use_cache = do
  pos_ids <- position_ids input_ids attn_mask past_length=(past_length past_kv)
  x, new_kv <- scope@model do
    x <- embedding@embed_tokens input_ids dim=D
    new_kv <- use_cache ? Cache.init : null
    for@layers i <- [0..L) do
      past_i <- Cache.index past_kv i
      x, new_i <- olmo_2_block x pos_ids attn_mask past_i
      new_kv <- Cache.append new_kv new_i
    x <- rms@norm x
    return x, new_kv
  logits <- linear@lm_head x dim=V
  return logits, new_kv
