import Activations gegelu_limit
import Activations silu
import Cache
import Cache past_length
import phi3_config (PARAM_ROOT, IS_SMALL, D, V, L, H, KVH, QD, KVD, FFN, EPS, THETA, HAS_LONGROPE, ROPE_ORIGINAL_CONTEXT, ROPE_MAX_CONTEXT, ROPE_LONG_FACTOR, ROPE_SHORT_FACTOR, BS_LOCAL_BLOCKS, BS_BLOCK_SIZE, BS_VERT_STRIDE, BS_HOMO_HEAD, WINDOW_LOCAL, WINDOW_GLOBAL, DENSE_EVERY, HAS_LM_HEAD, ATTN_SCALE, MUP_EMBED_MULT, MUP_WIDTH_MULT, GEGELU_LIMIT)

phi3_norm :: @Path -> Tensor -> Tensor
phi3_norm@path x = IS_SMALL ? (layernorm@path x eps=EPS) : (rmsnorm@path x eps=EPS)

phi3_attn :: Tensor -> IdxTensor -> ?Tensor -> ?CacheLayer -> (Tensor, ?CacheLayer)
phi3_attn xn pos_ids attn_mask past_kv = do
  qkv <- linear@qkv_proj xn dim=(QD + KVD + KVD) bias=false
  q, k, v <- split qkv sizes=[QD, KVD, KVD]
  q <- reshape_heads q heads=H
  k <- reshape_heads k heads=KVH
  v <- reshape_heads v heads=KVH
  q, k <- HAS_LONGROPE ? (rope_pair q k position_ids=pos_ids theta=THETA rope_mode="longrope" original_context=ROPE_ORIGINAL_CONTEXT max_context=ROPE_MAX_CONTEXT long_factor=ROPE_LONG_FACTOR short_factor=ROPE_SHORT_FACTOR inv_freq_dtype="bfloat16") : (rope_pair q k position_ids=pos_ids theta=THETA inv_freq_dtype="bfloat16")
  k, v, new_kv <- Cache.update past_kv k v
  k <- repeat k (H / KVH)
  v <- repeat v (H / KVH)
  mask <- causal_mask q k window=WINDOW_LOCAL padding_mask=attn_mask
  a <- attention q k v mask=mask |> merge_heads |> linear@o_proj dim=D bias=false
  return a, new_kv

phi3small_attn :: Tensor -> Int -> IdxTensor -> ?Tensor -> ?CacheLayer -> (Tensor, ?CacheLayer)
phi3small_attn xn i pos_ids attn_mask past_kv = do
  qkv <- linear@query_key_value xn dim=(QD + KVD + KVD) bias=true
  q, k, v <- split_qkv_grouped qkv heads=H kv_heads=KVH
  q, k <- HAS_LONGROPE ? (rope_pair q k position_ids=pos_ids theta=THETA rope_mode="longrope" original_context=ROPE_ORIGINAL_CONTEXT max_context=ROPE_MAX_CONTEXT long_factor=ROPE_LONG_FACTOR short_factor=ROPE_SHORT_FACTOR) : (rope_pair q k position_ids=pos_ids theta=THETA)
  k, v, new_kv <- Cache.update past_kv k v
  k <- repeat k (H / KVH)
  v <- repeat v (H / KVH)
  dense <- (DENSE_EVERY > 0) and (((i + 1) % DENSE_EVERY) == 0)
  mask <- dense ? (causal_mask q k window=WINDOW_GLOBAL padding_mask=attn_mask) : (blocksparse_mask q k padding_mask=attn_mask block_size=BS_BLOCK_SIZE local_blocks=BS_LOCAL_BLOCKS vert_stride=BS_VERT_STRIDE homo_head=false)
  a <- attention q k v mask=mask scale=ATTN_SCALE eager=true |> merge_heads |> linear@dense dim=D bias=true
  return a, new_kv

phi3_mlp :: Tensor -> Tensor
phi3_mlp xn = do
  gate_up <- linear@gate_up_proj xn dim=(2 * FFN)
  g, u <- split gate_up sizes=[FFN, FFN]
  return g |> silu |> mul u |> linear@down_proj dim=D

phi3small_mlp :: Tensor -> Tensor
phi3small_mlp xn = linear@up_proj xn dim=(2 * FFN) bias=true |> gegelu_limit limit=GEGELU_LIMIT |> linear@down_proj dim=D bias=true

phi3_block :: Tensor -> Int -> IdxTensor -> ?Tensor -> ?CacheLayer -> (Tensor, ?CacheLayer)
phi3_block x i pos_ids attn_mask past_kv = do
  xn <- phi3_norm@input_layernorm x
  a, new_kv <- scope@self_attn do
    a, new_kv <- IS_SMALL ? (phi3small_attn xn i pos_ids attn_mask past_kv) : (phi3_attn xn pos_ids attn_mask past_kv)
    return a, new_kv
  x <- x + a
  xn <- phi3_norm@post_attention_layernorm x
  m <- scope@mlp do
    return IS_SMALL ? (phi3small_mlp xn) : (phi3_mlp xn)
  return x + m, new_kv

phi3 :: TokenIds[B,S] -> ?Tensor[B,S] -> ?Cache -> ?Bool -> (Tensor[B,S,V], ?Cache)
phi3 input_ids attn_mask past_kv use_cache = do
  pos_ids <- IS_SMALL ? (position_ids input_ids null past_length=(past_length past_kv)) : (position_ids input_ids attn_mask past_length=(past_length past_kv) pad_fill=1)
  x, new_kv <- scope@model root=PARAM_ROOT do
    x <- embedding@embed_tokens input_ids dim=D
    x <- IS_SMALL ? ((MUP_EMBED_MULT > 0.0) ? (x * MUP_EMBED_MULT) : x) : x
    new_kv <- use_cache ? Cache.init : null
    for@layers i <- [0..L) do
      past_i <- Cache.index past_kv i
      x, new_i <- phi3_block x i pos_ids attn_mask past_i
      new_kv <- Cache.append new_kv new_i
    x <- IS_SMALL ? (phi3_norm@final_layernorm x) : (phi3_norm@norm x)
    return x, new_kv
  logits <- HAS_LM_HEAD ? (linear@lm_head x dim=V) : (linear@model.embed_tokens x dim=V)
  logits <- IS_SMALL ? ((MUP_WIDTH_MULT > 0.0) ? (logits / MUP_WIDTH_MULT) : logits) : logits
  return logits, new_kv
