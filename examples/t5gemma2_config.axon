import Config

-- Shared T5Gemma2 text settings (text path only).
D = Config.int "hidden_size" root="decoder" default=640                     -- residual hidden size
V = Config.int "vocab_size" default=262144                            -- tokenizer vocabulary size
L_ENC = Config.int "num_hidden_layers" root="encoder.text_config" default=18            -- encoder layer count
L_DEC = Config.int "num_hidden_layers" root="decoder" default=18            -- decoder layer count
H = Config.int "num_attention_heads" root="decoder" default=4               -- query head count
KVH = Config.int "num_key_value_heads" root="decoder" default=1             -- key/value head count
HD = Config.int "head_dim" root="decoder" default=256                       -- per-head dimension
QD = H * HD                                                             -- q projection width
KVD = KVH * HD                                                          -- k/v projection width
FFN_ENC = Config.int "intermediate_size" root="encoder.text_config" default=2048        -- encoder MLP width
FFN_DEC = Config.int "intermediate_size" root="decoder" default=2048        -- decoder MLP width
EPS = Config.float "rms_norm_eps" root="decoder" default=1e-06              -- RMSNorm epsilon

ROPE_PERIOD_ENC = Config.int "_sliding_window_pattern" root="encoder.text_config" default=6 -- encoder full-attn cadence
ROPE_PERIOD_DEC = Config.int "_sliding_window_pattern" root="decoder" default=6 -- decoder full-attn cadence
WIN_SLIDE_ENC = Config.int "sliding_window" root="encoder.text_config" default=512      -- encoder sliding window
WIN_SLIDE_DEC = Config.int "sliding_window" root="decoder" default=512      -- decoder sliding window
WIN_FULL_ENC = Config.int "max_position_embeddings" root="encoder.text_config" default=32768 -- encoder full window
WIN_FULL_DEC = Config.int "max_position_embeddings" root="decoder" default=32768 -- decoder full window

THETA_SLIDE_ENC = Config.float "rope_parameters.sliding_attention.rope_theta" root="encoder.text_config" default=10000.0 -- encoder sliding theta
THETA_FULL_ENC = Config.float "rope_parameters.full_attention.rope_theta" root="encoder.text_config" default=1000000.0  -- encoder full theta
THETA_SLIDE_DEC = Config.float "rope_parameters.sliding_attention.rope_theta" root="decoder" default=10000.0 -- decoder sliding theta
THETA_FULL_DEC = Config.float "rope_parameters.full_attention.rope_theta" root="decoder" default=1000000.0  -- decoder full theta
ROPE_SCALE_FULL_ENC = Config.float "rope_parameters.full_attention.factor" root="encoder.text_config" default=8.0       -- encoder full linear scale
ROPE_SCALE_FULL_DEC = Config.float "rope_parameters.full_attention.factor" root="decoder" default=8.0       -- decoder full linear scale

ATTN_SCALE = 1.0 / sqrt (Config.float "query_pre_attn_scalar" root="decoder" default=256.0) -- qk scaling
EMB_SCALE_ENC = Config.float "embed_scale_encoder" default=25.25            -- HF encoder embed_scale (bf16-rounded sqrt(D) for 270m)
EMB_SCALE_DEC_OVERRIDE = Config.float "embed_scale_decoder" default=-1.0    -- optional decoder override (uses sqrt(D) when unset)
EMB_SCALE_DEC = (EMB_SCALE_DEC_OVERRIDE > 0.0) ? EMB_SCALE_DEC_OVERRIDE : sqrt D -- HF decoder embed_scale
