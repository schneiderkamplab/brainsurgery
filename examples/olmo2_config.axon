import Config

-- OLMo 2 shared architecture settings (1B/7B/13B and derivatives).
D = Config.int "hidden_size" default=2048                         -- residual hidden size
V = Config.int "vocab_size" default=100352                        -- tokenizer vocabulary size
L = Config.int "num_hidden_layers" default=16                     -- number of decoder layers
H = Config.int "num_attention_heads" default=16                   -- query head count
KVH = Config.int "num_key_value_heads" default=16                 -- key/value head count
HD = Config.int "head_dim" default=128                            -- per-head hidden size
FFN = Config.int "intermediate_size" default=8192                 -- MLP expansion size
C = Config.int "max_position_embeddings" default=4096             -- context window
EPS = Config.float "rms_norm_eps" default=1e-06                   -- RMSNorm epsilon
THETA = Config.float "rope_theta" default=500000.0                -- RoPE theta
ROPE_SCALE = Config.float "rope_scaling.factor" default=1.0       -- optional RoPE scale factor
ATTN_SCALE = 1.0 / sqrt HD                                        -- qk scaling factor
