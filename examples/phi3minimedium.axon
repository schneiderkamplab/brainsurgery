import Activations silu
import Cache
import Cache past_length
import phi3minimedium_config (PARAM_ROOT, D, V, L, H, KVH, QD, KVD, FFN, EPS, THETA, HAS_LONGROPE, ROPE_ORIGINAL_CONTEXT, ROPE_MAX_CONTEXT, ROPE_LONG_FACTOR, ROPE_SHORT_FACTOR, WINDOW_LOCAL, HAS_LM_HEAD)

phi3minimedium_norm :: @Path -> Tensor -> Tensor
phi3minimedium_norm@path x = rmsnorm@path x eps=EPS

phi3minimedium_block :: Tensor -> IdxTensor -> ?Tensor -> ?CacheLayer -> (Tensor, ?CacheLayer)
phi3minimedium_block x pos_ids attn_mask past_kv = do
  xn <- phi3minimedium_norm@input_layernorm x
  a, new_kv <- scope@self_attn do
    qkv <- linear@qkv_proj xn dim=(QD + KVD + KVD) bias=false
    q, k, v <- split qkv sizes=[QD, KVD, KVD]
    q <- reshape_heads q heads=H
    k <- reshape_heads k heads=KVH
    v <- reshape_heads v heads=KVH
    q, k <- HAS_LONGROPE ? (rope_pair q k position_ids=pos_ids theta=THETA rope_mode="longrope" original_context=ROPE_ORIGINAL_CONTEXT max_context=ROPE_MAX_CONTEXT long_factor=ROPE_LONG_FACTOR short_factor=ROPE_SHORT_FACTOR) : (rope_pair q k position_ids=pos_ids theta=THETA)
    k, v, new_kv <- Cache.update past_kv k v
    k <- repeat k (H / KVH)
    v <- repeat v (H / KVH)
    mask <- causal_mask q k window=WINDOW_LOCAL padding_mask=attn_mask
    a <- attention q k v mask=mask |> merge_heads |> linear@o_proj dim=D bias=false
    return a, new_kv
  x <- x + a
  xn <- phi3minimedium_norm@post_attention_layernorm x
  m <- scope@mlp do
    gate_up <- linear@gate_up_proj xn dim=(2 * FFN)
    g, u <- split gate_up sizes=[FFN, FFN]
    return g |> silu |> mul u |> linear@down_proj dim=D
  return x + m, new_kv

phi3minimedium :: TokenIds[B,S] -> ?Tensor[B,S] -> ?Cache -> ?Bool -> (Tensor[B,S,V], ?Cache)
phi3minimedium input_ids attn_mask past_kv use_cache = do
  pos_ids <- position_ids input_ids attn_mask past_length=(past_length past_kv)
  x, new_kv <- scope@model root=PARAM_ROOT do
    x <- embedding@embed_tokens input_ids dim=D
    new_kv <- use_cache ? Cache.init : null
    for@layers i <- [0..L) do
      past_i <- Cache.index past_kv i
      x, new_i <- phi3minimedium_block x pos_ids attn_mask past_i
      new_kv <- Cache.append new_kv new_i
    x <- phi3minimedium_norm@norm x
    return x, new_kv
  logits <- HAS_LM_HEAD ? (linear@lm_head x dim=V) : (linear@model.embed_tokens x dim=V)
  return logits, new_kv
