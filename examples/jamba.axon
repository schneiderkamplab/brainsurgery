{-# PADDING_SIDE "right" #-}
import Config
import Activations silu
import MoE

-- Jamba tiny architecture constants.
D = Config.int "hidden_size" default=128                           -- residual hidden size
V = Config.int "vocab_size" default=65536                          -- tokenizer vocabulary size
L = Config.int "num_hidden_layers" default=8                       -- decoder depth
H = Config.int "num_attention_heads" default=2                     -- query heads
KVH = Config.int "num_key_value_heads" default=1                   -- key/value heads
HD = D / H                                                         -- per-head dimension
SCALE = 1.0 / sqrt HD                                              -- qk scaling
FF = Config.int "intermediate_size" default=14336                  -- FFN width
E = Config.int "num_experts" default=4                             -- routed experts
K = Config.int "num_experts_per_tok" default=2                     -- top-k experts per token
I = D * (Config.int "mamba_expand" default=2)                      -- mamba inner width
N = Config.int "mamba_d_state" default=16                          -- state-space width
R = Config.int "mamba_dt_rank" default=8                           -- delta rank
ATTN_PERIOD = Config.int "attn_layer_period" default=4             -- attention cadence
ATTN_OFFSET = Config.int "attn_layer_offset" default=2             -- attention phase offset
EPS = Config.float "rms_norm_eps" default=1e-6                     -- RMSNorm epsilon

rms :: @Path -> Tensor[B,S,D] -> Tensor[B,S,D]
rms@path x = rmsnorm@path x eps=EPS cast_float=true

dense_ffn :: Tensor[B,S,D] -> Tensor[B,S,D]
dense_ffn x = do
  gate <- linear@feed_forward.gate_proj x dim=FF
  up <- linear@feed_forward.up_proj x dim=FF
  return gate |> silu |> mul up |> linear@feed_forward.down_proj dim=D

expert_ffn :: Tensor[Nt,D] -> Tensor[Nt,D]
expert_ffn x = do
  gate <- linear@gate_proj x dim=FF
  up <- linear@up_proj x dim=FF
  return gate |> silu |> mul up |> linear@down_proj dim=D

moe_ffn :: Tensor[B,S,D] -> Tensor[B,S,D]
moe_ffn x = do
  topk_scores, topk_indices <- linear@feed_forward.router x dim=E |>
    softmax dim=-1 dtype=float32 |> topk k=K dim=-1
  m <- zeros_like x
  x_upd <- scope@feed_forward do
    for@experts e <- [0..E) do
      x_sel, token_idx, topk_pos, sel_scores <- MoE.select x topk_scores topk_indices e
      x_expert <- expert_ffn x_sel
      m <- MoE.scatter_add m token_idx x_expert sel_scores
    return m
  return x_upd

attn_core :: Tensor[B,S,D] -> Tensor[B,S,D]
attn_core x = do
  x_norm <- rms@input_layernorm x
  q <- linear@self_attn.q_proj x_norm dim=(H * HD) |> reshape_heads heads=H
  k <- linear@self_attn.k_proj x_norm dim=(KVH * HD) |> reshape_heads heads=KVH |>
    repeat repeats=(H / KVH)
  v <- linear@self_attn.v_proj x_norm dim=(KVH * HD) |> reshape_heads heads=KVH |>
    repeat repeats=(H / KVH)
  a <- attention q k v scale=SCALE causal=true eager=true |> merge_heads |>
    linear@self_attn.o_proj dim=D
  return x + a

mamba_core :: Tensor[B,S,D] -> Tensor[B,S,D]
mamba_core x = do
  x_norm <- rms@input_layernorm x
  y <- scope@mamba do
    in_proj <- linear@in_proj x_norm dim=2*I
    u, gate <- split in_proj sizes=[I, I]
    u_conv <- causal_conv1d@conv1d u activation=silu
    params <- linear@x_proj u_conv dim=R + 2*N
    dt, b, c <- split params sizes=[R, N, N]
    dt <- rmsnorm@dt_layernorm dt eps=EPS cast_float=true
    b <- rmsnorm@b_layernorm b eps=EPS cast_float=true
    c <- rmsnorm@c_layernorm c eps=EPS cast_float=true
    delta <- linear@dt_proj dt dim=I bias=true
    y_scan <- mamba_scan u_conv delta b c A=A_log D=D a_is_log=true
    return y_scan |> mul (silu gate) |> linear@out_proj dim=D
  return x + y

jamba :: TokenIds[B,S] -> Tensor[B,S,V]
jamba input_ids = do
  x <- embedding@model.embed_tokens input_ids dim=D
  for@model.layers i <- [0..L) do
    x <- ((i % ATTN_PERIOD) == ATTN_OFFSET) ? attn_core x : mamba_core x
    x_ff <- rms@pre_ff_layernorm x
    m <- ((i % 2) == 1) ? moe_ffn x_ff : dense_ffn x_ff
    x <- x + m
  x <- rms@model.final_layernorm x
  logits <- linear@lm_head x dim=V
  return logits
