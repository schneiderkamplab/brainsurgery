import Config
import Params

-- Config namespace root.
-- SmolLM/SmolLM2 use top-level keys today; keep `text_config` fallback for
-- future schema variants.
CFG = (Config.has "text_config") ? "text_config" : ""

-- Parameter root for checkpoint key lookup.
-- Some exporters may namespace all tensors under `language_model.*`.
PARAM_ROOT = (Params.has_root "language_model") ? "language_model" : ""

D = Config.int "hidden_size" root=CFG default=576                  -- residual hidden size
V = Config.int "vocab_size" root=CFG default=49152                 -- vocabulary size
L = Config.int "num_hidden_layers" root=CFG default=30             -- number of decoder layers
H = Config.int "num_attention_heads" root=CFG default=9            -- query attention heads
KVH = Config.int "num_key_value_heads" root=CFG default=3          -- key/value attention heads
HD = (Config.has "head_dim" root=CFG) ? Config.int "head_dim" root=CFG default=64 : (D / H) -- per-head hidden size
KVD = KVH * HD                                                     -- key/value projection width
FFN = Config.int "intermediate_size" root=CFG default=1536         -- MLP hidden width
EPS = Config.float "rms_norm_eps" root=CFG default=1e-05          -- RMSNorm epsilon
THETA = Config.float "rope_theta" root=CFG default=10000.0        -- RoPE base theta
C = Config.int "max_position_embeddings" root=CFG default=2048    -- max context window
